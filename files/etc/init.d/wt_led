#!/bin/sh /etc/rc.common
START=96
STOP=10
USE_PROCD=1

start_service() {
    [ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "wirelesstag,zx7981pd" ] || return 0

    procd_open_instance
    procd_set_param command /usr/bin/wt_led_sync.sh daemon
    procd_set_param respawn 3600 5 0
    procd_close_instance
}

stop_service() {
    killall wt_led_sync.sh 2>/dev/null
}
