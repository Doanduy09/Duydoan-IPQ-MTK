#!/bin/sh
# Padavanonly & Duydoan Multi-Core RPS Steering for 5G WWAN (usb*, wwan*, rmnet*, mhi*, eth2)
NPROCS="$(grep -c "^processor.*:" /proc/cpuinfo 2>/dev/null || echo 1)"
[ "$NPROCS" -gt 1 ] || exit 0

for IFACE in /sys/class/net/*; do
    INTERFACE=$(basename "$IFACE")
    IFNAME_PREFIX="${INTERFACE%%[0-9]*}"
    if [ "$INTERFACE" != "eth0" ] && [ "$INTERFACE" != "eth1" ] && \
       { [ "$IFNAME_PREFIX" = "usb" ] || [ "$IFNAME_PREFIX" = "wwan" ] || [ "$IFNAME_PREFIX" = "rmnet" ] || [ "$IFNAME_PREFIX" = "mhi" ] || [ "$INTERFACE" = "eth2" ]; }; then
        if [ "$NPROCS" -gt 2 ]; then
            for q in /sys/class/net/${INTERFACE}/queues/rx-*/rps_cpus; do
                [ -f "$q" ] && echo c > "$q" 2>/dev/null || true
            done
        else
            for q in /sys/class/net/${INTERFACE}/queues/rx-*/rps_cpus; do
                [ -f "$q" ] && echo 2 > "$q" 2>/dev/null || true
            done
        fi
    fi
done
[ -f /etc/init.d/mtk_smp ] && /etc/init.d/mtk_smp restart >/dev/null 2>&1 || true
