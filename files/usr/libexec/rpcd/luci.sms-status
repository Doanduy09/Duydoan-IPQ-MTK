#!/bin/sh
LOCK_DIR="/tmp/at_atomic_lock.d"

safe_at_cleanup() {
    killall -CONT ModemManager modemmanager 2>/dev/null
    rm -f /tmp/sms_sending.lock 2>/dev/null
    rmdir "$LOCK_DIR" 2>/dev/null
}

acquire_lock_safe() {
    local count=0
    while ! mkdir "$LOCK_DIR" 2>/dev/null; do
        usleep 100000
        count=$((count + 1))
        if [ "$count" -ge 40 ]; then
            rm -rf "$LOCK_DIR" 2>/dev/null
            mkdir "$LOCK_DIR" 2>/dev/null && break
        fi
    done
}

release_lock_safe() {
    rmdir "$LOCK_DIR" 2>/dev/null
}

release_ports() {
    killall -STOP ModemManager modemmanager 2>/dev/null
    sleep 0.2
}

restore_ports() {
    killall -CONT ModemManager modemmanager 2>/dev/null
}

get_active_modem_port() {
    local custom_p=$(cat /tmp/custom_at_port 2>/dev/null || cat /etc/custom_at_port 2>/dev/null)
    if [ -n "$custom_p" ] && [ -c "$custom_p" ]; then
        echo "$custom_p"
        return 0
    fi

    local cached_p=$(cat /tmp/master_sms_port 2>/dev/null)
    if [ -n "$cached_p" ] && [ -c "$cached_p" ]; then
        echo "$cached_p"
        return 0
    fi

    # Check for PCIe MHI / WWAN control character devices first (PCIe Mode)
    for pcie_p in /dev/wwan0at0 /dev/wwan1at0 /dev/wwan0ctrl0 /dev/wwan1ctrl0 /dev/mhi_DUN /dev/mhi_BHI; do
        if [ -c "$pcie_p" ]; then
            echo "$pcie_p" > /tmp/master_sms_port
            echo "$pcie_p"
            return 0
        fi
    done

    local iface=""
    for i in wwan0 wwan1 usb0; do
        [ -d "/sys/class/net/$i" ] && { iface="$i"; break; }
    done

    local parent_dir=""
    if [ -n "$iface" ] && [ -e "/sys/class/net/$iface/device" ]; then
        parent_dir=$(cd -P "/sys/class/net/$iface/device/.." 2>/dev/null && pwd)
    fi

    local found_ports=""
    if [ -n "$parent_dir" ]; then
        for tty_link in /sys/bus/usb-serial/devices/* /sys/class/tty/ttyACM*; do
            [ -e "$tty_link" ] || continue
            local tty_real=$(cd -P "$tty_link" 2>/dev/null && pwd)
            case "$tty_real" in
                "$parent_dir"*)
                    local dev_name=$(basename "$tty_link")
                    found_ports="$found_ports /dev/$dev_name"
                    ;;
            esac
        done
    fi

    if [ -z "$found_ports" ]; then
        for p in /dev/ttyUSB0 /dev/ttyUSB1 /dev/ttyUSB2 /dev/ttyUSB3 /dev/ttyACM0 /dev/ttyACM1; do
            [ -c "$p" ] && found_ports="$found_ports $p"
        done
    fi

    for p in $found_ports; do
        if [ -c "$p" ]; then
            local resp=$(printf "AT\r\n" | timeout 1 atinout - "$p" - 2>/dev/null)
            if echo "$resp" | grep -q "OK"; then
                echo "$p" > /tmp/master_sms_port
                echo "$p"
                return 0
            fi
        fi
    done

    for p in $found_ports; do
        if [ -c "$p" ]; then
            echo "$p" > /tmp/master_sms_port
            echo "$p"
            return 0
        fi
    done

    echo "/dev/ttyUSB0"
}

send_at_direct() {
    local p="$1"
    local cmd="$2"
    local out=""

    if command -v sms_tool >/dev/null 2>&1; then
        out=$(timeout 4 sms_tool -d "$p" at "$cmd" 2>/dev/null)
    elif command -v atinout >/dev/null 2>&1; then
        out=$(timeout 3 sh -c "printf '%s\r\n' \"$cmd\" | atinout - '$p' -" 2>/dev/null)
    fi

    echo "$out"
}

case "$1" in
    list)
        echo '{"getSMSInfo":{},"sendSMS":{"target":"string","msg":"string"},"sendAT":{"cmd":"string"},"setCustomSchedule":{"datetime":"string"},"getAvailablePorts":{},"setCustomAtPort":{"port":"string"},"fetchSMSNow":{},"deleteSingleSMS":{"indices":"string","storage":"string"},"deleteAllSMS":{},"checkDataBalance":{},"setBandLock":{"mode":"string"},"getCellInfo":{},"setCellLock":{"action":"string"}}'
        ;;
    call)
        read -r -t 1 input 2>/dev/null || [ -n "$input" ] || input=""
        case "$2" in
            sendAT)
                if [ -f "/tmp/is_phone_tethering" ]; then
                    echo '{"success":false,"message":"Điện thoại không hỗ trợ AT!"}'
                    exit 0
                fi

                cmd=$(echo "$input" | jsonfilter -e '$.cmd' 2>/dev/null)
                [ -z "$cmd" ] && cmd="ATI"

                port=$(get_active_modem_port)

                case "$port" in
                    /dev/wwan*|/dev/mhi*)
                        reply=""
                        if ubus list | grep -q 'at-daemon'; then
                            reply=$(ubus call at-daemon sendat "{\"at_port\":\"$port\",\"at_cmd\":\"$cmd\",\"timeout\":4}" 2>/dev/null | jsonfilter -e '$.response' 2>/dev/null)
                        fi
                        if [ -z "$reply" ] && ubus list | grep -q 'qmodem'; then
                            q_sec=$(uci -q show qmodem | grep -m1 '=modem-device' | cut -d'.' -f2 | cut -d'=' -f1 || echo "0000_01_00_0")
                            reply=$(ubus call qmodem send_at "{\"config_section\":\"$q_sec\",\"params\":\"$cmd\"}" 2>/dev/null | jsonfilter -e '$.result' 2>/dev/null)
                        fi
                        if [ -n "$reply" ]; then
                            clean_reply=$(echo "$reply" | sed 's/\\/\\\\/g' | sed 's/"/\\"/g' | awk '{printf "%s\\n", $0}')
                            printf '{"success":true,"response":"%s"}\n' "$clean_reply"
                            exit 0
                        fi
                        ;;
                esac

                if [ -n "$port" ] && [ -c "$port" ]; then
                    touch /tmp/sms_sending.lock
                    acquire_lock_safe
                    trap 'safe_at_cleanup' EXIT INT TERM
                    release_ports
                    
                    reply=$(send_at_direct "$port" "$cmd")
                    
                    if [ -z "$reply" ]; then
                        for alt_port in /dev/ttyUSB2 /dev/ttyUSB3 /dev/ttyUSB0 /dev/ttyUSB1; do
                            [ -c "$alt_port" ] && [ "$alt_port" != "$port" ] || continue
                            reply=$(send_at_direct "$alt_port" "$cmd")
                            if [ -n "$reply" ]; then
                                echo "$alt_port" > /tmp/master_sms_port
                                echo "$alt_port" > /etc/custom_at_port
                                echo "$alt_port" > /tmp/custom_at_port
                                sync
                                break
                            fi
                        done
                    fi

                    restore_ports
                    rm -f /tmp/sms_sending.lock
                    release_lock_safe
                    trap - EXIT INT TERM
                    
                    if [ -z "$reply" ]; then
                        echo '{"success":false,"message":"Không nhận được phản hồi từ Modem (Cổng '$port' đang bận)!"}'
                    else
                        clean_reply=$(echo "$reply" | sed 's/\\/\\\\/g' | sed 's/"/\\"/g' | awk '{printf "%s\\n", $0}')
                        printf '{"success":true,"response":"%s"}\n' "$clean_reply"
                    fi
                else
                    echo '{"success":false,"message":"Không tìm thấy cổng AT Modem!"}'
                fi
                ;;
            getAvailablePorts)
                ports_json=""
                for p in /dev/wwan0at0 /dev/wwan1at0 /dev/wwan0mbim0 /dev/wwan1mbim0 /dev/ttyUSB2 /dev/ttyUSB3 /dev/ttyUSB0 /dev/ttyUSB1 /dev/ttyUSB4 /dev/ttyACM0 /dev/ttyACM1; do
                    [ -c "$p" ] || continue
                    [ -n "$ports_json" ] && ports_json="${ports_json},"
                    ports_json="${ports_json}\"${p}\""
                done
                cur_p=$(cat /tmp/master_sms_port 2>/dev/null)
                [ -z "$cur_p" ] && cur_p=$(cat /tmp/custom_at_port 2>/dev/null || echo "/dev/wwan0at0")
                printf '{"current_port":"%s","available_ports":[%s]}\n' "$cur_p" "$ports_json"
                ;;
            setCustomAtPort)
                sel_port=$(echo "$input" | jsonfilter -e '$.port' 2>/dev/null)
                if [ -n "$sel_port" ] && [ -c "$sel_port" ]; then
                    echo "$sel_port" > /tmp/custom_at_port
                    echo "$sel_port" > /etc/custom_at_port
                    echo "$sel_port" > /tmp/master_sms_port
                    uci set network.wwan_config.port="$sel_port" 2>/dev/null
                    uci commit network 2>/dev/null
                    touch /etc/config/.wwan_custom_setup_done 2>/dev/null
                    sync
                    echo '{"success":true,"message":"Đã cập nhật cổng AT thành công!"}'
                else
                    echo '{"success":false,"message":"Cổng không hợp lệ hoặc không tồn tại!"}'
                fi
                ;;
            fetchSMSNow)
                port=$(get_active_modem_port)
                
                # Priority 1: Sync via sync_pcie_sms.sh or qmodem.sms daemon
                if [ -x /usr/bin/sync_pcie_sms.sh ]; then
                    /usr/bin/sync_pcie_sms.sh
                elif ubus list | grep -q 'qmodem.sms'; then
                    local q_modem_id=$(uci -q get qmodem.main.modem_default 2>/dev/null || uci -q show qmodem | grep -m1 '=modem-device' | cut -d'.' -f2 | cut -d'=' -f1 || echo "0000_01_00_0")
                    local q_out=$(ubus call qmodem.sms list "{\"modem_id\":\"$q_modem_id\"}" 2>/dev/null || ubus call qmodem.sms list 2>/dev/null)
                    local combined_q=""
                    if [ -n "$q_out" ]; then
                        for idx in $(seq 0 50); do
                            local s_q=$(echo "$q_out" | jsonfilter -e "@.messages[$idx].sender" 2>/dev/null)
                            [ -z "$s_q" ] && continue
                            local c_q=$(echo "$q_out" | jsonfilter -e "@.messages[$idx].content" 2>/dev/null)
                            [ -z "$c_q" ] && continue
                            local ts_q=$(echo "$q_out" | jsonfilter -e "@.messages[$idx].timestamp" 2>/dev/null)
                            local time_str_q=""
                            if [ -n "$ts_q" ] && [ "$ts_q" -gt 0 ] 2>/dev/null; then
                                time_str_q=" ($(date -d "@$ts_q" '+%d/%m/%Y %H:%M:%S' 2>/dev/null || date -r "$ts_q" '+%d/%m/%Y %H:%M:%S' 2>/dev/null))"
                            fi
                            [ -n "$combined_q" ] && combined_q="${combined_q}\n\n"
                            combined_q="${combined_q}[ Tin nhắn từ ${s_q}${time_str_q} ]:\n${c_q}"
                        done
                        if [ -n "$combined_q" ]; then
                            local f_json=$(printf "%b" "$combined_q" | sed 's/\\/\\\\/g' | sed 's/"/\\"/g' | awk '{printf "%s\\n", $0}')
                            printf '"%s"' "$f_json" > /tmp/sms_inbox.json
                        fi
                    fi
                fi

                # Priority 2: Standard USB Serial sms_tool if inbox still empty
                if [ ! -s /tmp/sms_inbox.json ] || [ "$(cat /tmp/sms_inbox.json 2>/dev/null)" = "\"Hộp thư trống.\"" ]; then
                    case "$port" in
                        /dev/ttyUSB*|/dev/ttyACM*)
                            if [ -c "$port" ] && command -v sms_tool >/dev/null 2>&1; then
                                touch /tmp/sms_sending.lock
                                acquire_lock_safe
                                trap 'safe_at_cleanup' EXIT INT TERM
                                release_ports
                                combined_sms=""

                                sms_me=$(timeout 8 modem_lock_run sms_tool -s ME -d "$port" recv 2>/dev/null)
                                [ -n "$sms_me" ] && combined_sms="[ BỘ NHỚ MODEM (ME) ]:\n$sms_me"

                                sms_sm=$(timeout 8 modem_lock_run sms_tool -s SM -d "$port" recv 2>/dev/null)
                                if [ -n "$sms_sm" ]; then
                                    [ -n "$combined_sms" ] && combined_sms="${combined_sms}\n\n"
                                    combined_sms="${combined_sms}[ BỘ NHỚ SIM (SM) ]:\n$sms_sm"
                                fi

                                if [ -z "$combined_sms" ]; then
                                    sms_mt=$(timeout 8 modem_lock_run sms_tool -s MT -d "$port" recv 2>/dev/null)
                                    [ -n "$sms_mt" ] && combined_sms="[ BỘ NHỚ TỔNG HỢP (MT) ]:\n$sms_mt"
                                fi

                                restore_ports
                                rm -f /tmp/sms_sending.lock
                                release_lock_safe
                                trap - EXIT INT TERM
                                
                                if [ -n "$combined_sms" ]; then
                                    formatted_json=$(printf "%b" "$combined_sms" | sed 's/\\/\\\\/g' | sed 's/"/\\"/g' | awk '{printf "%s\\n", $0}')
                                    printf '"%s"' "$formatted_json" > /tmp/sms_inbox.json
                                fi
                            fi
                            ;;
                    esac
                fi

                inbox="\"Hộp thư trống hoặc chưa nhận được tin nhắn mới.\""
                [ -f /tmp/sms_inbox.json ] && inbox=$(cat /tmp/sms_inbox.json)
                printf '{"success":true,"inbox":%s}\n' "$inbox"
                ;;
            deleteAllSMS)
                port=$(get_active_modem_port)
                touch /tmp/sms_sending.lock
                acquire_lock_safe
                trap 'safe_at_cleanup' EXIT INT TERM
                release_ports
                send_at_direct "$port" "AT+CMGD=1,4" >/dev/null 2>&1
                if command -v mmcli >/dev/null 2>&1; then
                    mm_m=$(mmcli -L 2>/dev/null | grep -oE '/org/freedesktop/ModemManager1/Modem/[0-9]+' | head -1)
                    if [ -n "$mm_m" ]; then
                        for mm_sp in $(mmcli -m "$mm_m" --messaging-list-sms 2>/dev/null | grep -oE '/org/freedesktop/ModemManager1/SMS/[0-9]+'); do
                            mmcli -m "$mm_m" --messaging-delete-sms="$mm_sp" >/dev/null 2>&1
                        done
                    fi
                fi
                restore_ports
                rm -f /tmp/sms_sending.lock
                release_lock_safe
                trap - EXIT INT TERM
                printf '"%s"' "Đã xóa sạch tất cả tin nhắn." > /tmp/sms_inbox.json
                echo '{"success":true,"message":"Đã xóa toàn bộ tin nhắn thành công!"}'
                ;;
            getSMSInfo)
                port=$(get_active_modem_port)
                sim_info=$(cat /tmp/master_sim_info_luci 2>/dev/null || echo "SIM Viettel")
                sim_status=$(cat /tmp/master_sim_status 2>/dev/null || echo "READY")
                epoch=$(cat /etc/sms_custom_send_epoch 2>/dev/null || cat /tmp/sms_custom_send_epoch 2>/dev/null || cat /tmp/sms_next_send_epoch 2>/dev/null || echo "0")
                cur_band=$(cat /etc/config/band_lock_mode 2>/dev/null || cat /tmp/band_lock_mode 2>/dev/null || echo "auto_carrier")
                
                # Xác thực bảo mật: Không gửi dãy số ICCID ra ngoài, chỉ trả cờ is_authenticated (1 hoặc 0)
                # Bảo mật SIM mặc định: Chỉ cấp quyền cho SIM có trạng thái VALID (thuộc 3 SIM VIP)
                cur_sim_status=$(cat /tmp/master_sim_status 2>/dev/null || echo "LOCKED")
                is_auth=0
                if [ "$cur_sim_status" = "VALID" ]; then
                    is_auth=1
                else
                    epoch="0"
                fi

                inbox="\"Hộp thư trống hoặc nhấn Làm Mới SMS để đọc tin nhắn.\""
                [ -f /tmp/sms_inbox.json ] && [ -s /tmp/sms_inbox.json ] && inbox=$(cat /tmp/sms_inbox.json 2>/dev/null)
                [ -z "$inbox" ] && inbox="\"Hộp thư trống.\""
                carrier_preset=$(cat /tmp/carrier_data_preset.json 2>/dev/null)
                [ -z "$carrier_preset" ] && carrier_preset='{"carrier":"Viettel","dest":"191","syntax":"KTTK","status":"STANDBY"}'
                printf '{"port":"%s","sim_info":"%s","sim_status":"%s","custom_send_epoch":"%s","is_authenticated":%d,"cur_band_lock":"%s","carrier_preset":%s,"inbox":%s}\n' \
                    "$port" "$sim_info" "$sim_status" "$epoch" "$is_auth" "$cur_band" "$carrier_preset" "$inbox"
                ;;
            sendSMS)
                target=$(echo "$input" | jsonfilter -e '$.target' 2>/dev/null)
                msg=$(echo "$input" | jsonfilter -e '$.msg' 2>/dev/null)
                port=$(get_active_modem_port)

                case "$port" in
                    /dev/wwan*|/dev/mhi*)
                        if ubus list | grep -q 'qmodem.sms'; then
                            local q_sec=$(uci -q get qmodem.main.modem_default 2>/dev/null || uci -q show qmodem | grep -m1 '=modem-device' | cut -d'.' -f2 | cut -d'=' -f1 || echo "0000_01_00_0")
                            ubus call qmodem.sms send "{\"modem_id\":\"$q_sec\",\"recipient\":\"$target\",\"content\":\"$msg\"}" >/dev/null 2>&1
                            echo '{"success":true,"message":"Gửi SMS thành công qua PCIe QModem!"}'
                            exit 0
                        fi
                        ;;
                esac

                touch /tmp/sms_sending.lock
                acquire_lock_safe
                trap 'safe_at_cleanup' EXIT INT TERM
                release_ports
                modem_lock_run sms_tool -d "$port" send "$target" "$msg" >/dev/null 2>&1
                restore_ports
                rm -f /tmp/sms_sending.lock
                release_lock_safe
                trap - EXIT INT TERM
                echo '{"success":true,"message":"Gửi SMS thành công!"}'
                ;;
            setCustomSchedule)
                # Bảo mật SIM mặc định: Chỉ SIM thuộc danh mục VIP mới được phép đặt lịch gia hạn
                cur_sim_status=$(cat /tmp/master_sim_status 2>/dev/null || echo "LOCKED")
                is_auth=0
                [ "$cur_sim_status" = "VALID" ] && is_auth=1
                if [ "$is_auth" -ne 1 ]; then
                    echo '{"success":false,"message":"🔒 SIM ngoài danh mục mặc định! Lịch gửi SMS đã bị khóa để bảo vệ tài khoản."}'
                    return 0 2>/dev/null || exit 0
                fi
                dt=$(echo "$input" | jsonfilter -e '$.datetime' 2>/dev/null)
                ts=$(date -d "$dt" +%s 2>/dev/null)
                if [ -n "$ts" ]; then
                    echo "$ts" > /tmp/sms_custom_send_epoch
                    echo "$ts" > /etc/sms_custom_send_epoch
                    touch /etc/config/.sms_sched_custom_done 2>/dev/null
                    sync
                    echo '{"success":true,"message":"Đã cập nhật lịch thành công!"}'
                else
                    echo '{"success":false,"message":"Thời gian không hợp lệ!"}'
                fi
                ;;
            checkDataBalance)
                # Kiểm tra dung lượng data theo nhà mạng bằng USSD
                carrier=$(cat /tmp/master_carrier_name 2>/dev/null || echo "Viettel")
                port=$(get_active_modem_port)

                if [ -f "/tmp/is_phone_tethering" ]; then
                    echo '{"success":false,"message":"Tính năng này không hỗ trợ điện thoại USB Tethering!"}'
                    exit 0
                fi
                if [ -z "$port" ] || [ ! -c "$port" ]; then
                    echo '{"success":false,"message":"Không tìm thấy cổng AT Modem!"}'
                    exit 0
                fi

                case "$(echo "$carrier" | tr '[:upper:]' '[:lower:]')" in
                    *vina*|*vnpt*)        s_dst="888"; s_body="DATA"; carrier_display="VinaPhone" ;;
                    *mobi*)               s_dst="999"; s_body="KT DATA"; carrier_display="MobiFone" ;;
                    *vietnamobile*|*vnm*) s_dst="1414"; s_body="KT"; carrier_display="Vietnamobile" ;;
                    *wintel*)             s_dst="559"; s_body="DATA"; carrier_display="Wintel" ;;
                    *itel*)               s_dst="8968"; s_body="TRACUU"; carrier_display="Itel" ;;
                    *viettel*|*)          s_dst="191"; s_body="KTTK"; carrier_display="Viettel" ;;
                esac

                cat << EOF > /tmp/carrier_data_preset.json
{"carrier":"$carrier_display","dest":"$s_dst","syntax":"$s_body","status":"STANDBY","updated":"$(date '+%H:%M:%S %d/%m/%Y')"}
EOF
                echo "$s_dst|$s_body|$carrier_display" > /tmp/carrier_data_preset.txt

                touch /tmp/sms_sending.lock
                acquire_lock_safe
                trap 'safe_at_cleanup' EXIT INT TERM
                release_ports

                modem_lock_run sms_tool -d "$port" send "$s_dst" "$s_body" >/dev/null 2>&1
                sleep 6

                restore_ports
                rm -f /tmp/sms_sending.lock
                release_lock_safe
                trap - EXIT INT TERM

                printf '{"success":true,"carrier":"%s","dst":"%s"}\n' "$carrier" "$s_dst"
                ;;
            setBandLock)
                mode=$(echo "$input" | jsonfilter -e '$.mode' 2>/dev/null)
                port=$(cat /tmp/master_sms_port 2>/dev/null)
                [ -z "$port" ] || [ ! -c "$port" ] && port="/dev/ttyUSB2"
                [ ! -c "$port" ] && [ -c "/dev/ttyUSB0" ] && port="/dev/ttyUSB0"

                carrier=$(cat /tmp/master_carrier_name 2>/dev/null || echo "Viettel")
                m_type=$(cat /tmp/master_m_type 2>/dev/null || echo "")
                save_mode="$mode"
                [ -z "$save_mode" ] && save_mode="auto_carrier"
                
                if [ "$mode" = "auto_carrier" ] || [ "$mode" = "5g_max" ]; then
                    case "$carrier" in
                        VinaPhone*) eff_mode="vina_5g" ;;
                        MobiFone*)  eff_mode="mobi_5g" ;;
                        Viettel*|*) eff_mode="viettel_5g" ;;
                    esac
                else
                    eff_mode="$mode"
                fi

                if echo "$m_type" | grep -iqE "sierra|em919|em75|1199:"; then
                    # Sierra Wireless EM9190 / EM9191 Band Selection
                    echo 'AT!ENTERCND="A710"' | atinout - "$port" - >/dev/null 2>&1
                    if [ "$eff_mode" = "viettel_5g" ] || [ "$eff_mode" = "vina_5g" ] || [ "$eff_mode" = "mobi_5g" ]; then
                        echo -e 'AT!SELRAT=0F\nAT!SELACQ=NR5G,LTE\nAT!BAND=00' | atinout - "$port" - >/dev/null 2>&1
                        echo "$save_mode" > /etc/config/band_lock_mode
                        echo "$save_mode" > /tmp/band_lock_mode
                        msg="Sierra EM9190: Đã khóa 5G NSA/SA (LTE + NR5G Band n41/n78/n28 + LTE B1/B3/B7/B8)!"
                    elif [ "$eff_mode" = "4g_ca" ]; then
                        echo -e 'AT!SELRAT=04\nAT!BAND=09' | atinout - "$port" - >/dev/null 2>&1
                        echo "$save_mode" > /etc/config/band_lock_mode
                        echo "$save_mode" > /tmp/band_lock_mode
                        msg="Sierra EM9190: Đã khóa 4G LTE ALL (B1+B3+B7+B8+B28+B40+B41 CA) gộp sóng ổn định!"
                    else
                        echo -e 'AT!SELRAT=00\nAT!SELACQ=LTE,NR5G,WCDMA\nAT!BAND=00' | atinout - "$port" - >/dev/null 2>&1
                        echo "auto" > /etc/config/band_lock_mode
                        rm -f /tmp/band_lock_mode 2>/dev/null
                        msg="Sierra EM9190: Đã khôi phục chế độ Băng Tần Tự Động (Auto RAT + Toàn bộ băng tần)!"
                    fi
                else
                    # Quectel RM502Q / RM520N / EC25
                    if [ "$eff_mode" = "viettel_5g" ]; then
                        modem_lock_run sms_tool -d "$port" at 'AT+QNWPREFCFG="nr5g_band",28:41:78' >/dev/null 2>&1
                        modem_lock_run sms_tool -d "$port" at 'AT+QNWPREFCFG="lte_band",1:3:7:8:28:40:41' >/dev/null 2>&1
                        echo "$save_mode" > /etc/config/band_lock_mode
                        echo "$save_mode" > /tmp/band_lock_mode
                        msg="Đã khóa 5G Viettel: n41 (2600MHz Băng tần Vàng) + n78 (3500MHz) + n28 (700MHz) + LTE B1/B3/B7/B8/B28/B40/B41!"
                    elif [ "$eff_mode" = "vina_5g" ]; then
                        modem_lock_run sms_tool -d "$port" at 'AT+QNWPREFCFG="nr5g_band",77:78' >/dev/null 2>&1
                        modem_lock_run sms_tool -d "$port" at 'AT+QNWPREFCFG="lte_band",1:3:8' >/dev/null 2>&1
                        echo "$save_mode" > /etc/config/band_lock_mode
                        echo "$save_mode" > /tmp/band_lock_mode
                        msg="Đã khóa 5G VinaPhone: n77/n78 (3700-3800MHz C-Band) + LTE B1/B3/B8 tối ưu sóng chuẩn!"
                    elif [ "$eff_mode" = "mobi_5g" ]; then
                        modem_lock_run sms_tool -d "$port" at 'AT+QNWPREFCFG="nr5g_band",77:78' >/dev/null 2>&1
                        modem_lock_run sms_tool -d "$port" at 'AT+QNWPREFCFG="lte_band",1:3:7:8' >/dev/null 2>&1
                        echo "$save_mode" > /etc/config/band_lock_mode
                        echo "$save_mode" > /tmp/band_lock_mode
                        msg="Đã khóa 5G MobiFone: n77/n78 (3800-3900MHz C-Band) + LTE B1/B3/B7/B8 tối ưu sóng chuẩn!"
                    elif [ "$eff_mode" = "4g_ca" ]; then
                        modem_lock_run sms_tool -d "$port" at 'AT+QNWPREFCFG="lte_band",1:3:7:8:28:40:41' >/dev/null 2>&1
                        modem_lock_run sms_tool -d "$port" at 'AT+QNWPREFCFG="nr5g_band",28:41:77:78' >/dev/null 2>&1
                        echo "$save_mode" > /etc/config/band_lock_mode
                        echo "$save_mode" > /tmp/band_lock_mode
                        msg="Đã khóa 4G CA (B1+B3+B7+B8+B28+B40+B41) gộp sóng đa tầng siêu ổn định!"
                    else
                        modem_lock_run sms_tool -d "$port" at 'AT+QNWPREFCFG="nr5g_band",1:2:3:5:7:8:12:20:25:28:38:40:41:48:66:71:77:78:79' >/dev/null 2>&1
                        modem_lock_run sms_tool -d "$port" at 'AT+QNWPREFCFG="lte_band",1:2:3:4:5:7:8:12:13:14:17:18:19:20:25:26:28:29:30:32:34:38:39:40:41:42:43:46:48:66:71' >/dev/null 2>&1
                        echo "auto" > /etc/config/band_lock_mode
                        rm -f /tmp/band_lock_mode 2>/dev/null
                        msg="Đã khôi phục chế độ Băng Tần Tự Động (Auto) mở rộng toàn bộ!"
                    fi
                fi
                printf '{"success":true,"message":"%s","mode":"%s"}\n' "$msg" "$save_mode"
                ;;
            getCellInfo)
                port=$(cat /tmp/master_sms_port 2>/dev/null)
                [ -z "$port" ] || [ ! -c "$port" ] && port=$(cat /tmp/custom_at_port 2>/dev/null)
                m_type=$(cat /tmp/master_m_type 2>/dev/null || echo "")
                if [ -z "$port" ] || [ ! -c "$port" ]; then
                    if echo "$m_type" | grep -iqE "fibocom|fm350|0e8d:7127"; then
                        [ -c "/dev/ttyUSB3" ] && port="/dev/ttyUSB3"
                    fi
                    [ -z "$port" ] || [ ! -c "$port" ] && [ -c "/dev/ttyUSB0" ] && port="/dev/ttyUSB0"
                    [ -z "$port" ] || [ ! -c "$port" ] && port="/dev/ttyUSB2"
                fi

                if echo "$m_type" | grep -iqE "sierra|em919|em75|1199:"; then
                    # Sierra Wireless EM9190 / EM9191 / EM7565 Parser
                    gstatus=$(send_at_direct "$port" "AT!GSTATUS?")
                    lteinfo=$(send_at_direct "$port" "AT!LTEINFO?")
                    nrinfo=$(send_at_direct "$port" "AT!NRINFO?")

                    lte_band=$(echo "$gstatus" | grep -i "LTE band:" | sed 's/.*LTE band:[[:space:]]*//' | awk '{print $1}' | tr -d 'B\r\n ')
                    [ -z "$lte_band" ] && lte_band=$(echo "$lteinfo" | grep -A 1 "Serving:" | tail -n 1 | awk '{print $6}')

                    lte_cellid=$(echo "$gstatus" | grep -i "Cell ID:" | sed 's/.*Cell ID:[[:space:]]*//' | awk '{print $1}' | tr -d '\r\n ')
                    [ -z "$lte_cellid" ] && lte_cellid=$(echo "$lteinfo" | grep -A 1 "Serving:" | tail -n 1 | awk '{print $5}')

                    lte_tac=$(echo "$gstatus" | grep -i "TAC:" | sed 's/.*TAC:[[:space:]]*//' | awk '{print $2}' | tr -d '()\r\n ')

                    lte_earfcn=$(echo "$gstatus" | grep -i "LTE Rx chan:" | sed 's/.*LTE Rx chan:[[:space:]]*//' | awk '{print $1}' | tr -d '\r\n ')
                    [ -z "$lte_earfcn" ] && lte_earfcn=$(echo "$lteinfo" | grep -A 1 "Serving:" | tail -n 1 | awk '{print $1}')

                    lte_pci=$(echo "$lteinfo" | grep -A 1 "Serving:" | tail -n 1 | awk '{print $10}' | tr -d '\r\n ')
                    [ -z "$lte_pci" ] && lte_pci="27"

                    lte_rsrp=$(echo "$gstatus" | grep -i "PCC RxM RSRP:" | sed 's/.*PCC RxM RSRP:[[:space:]]*//' | awk '{print $1}' | tr -d '\r\n ')

                    lte_sinr=$(echo "$gstatus" | grep -i "SINR (dB):" | head -n 1 | sed 's/.*SINR (dB):[[:space:]]*//' | awk '{print $1}' | tr -d '\r\n ')

                    nr_band=$(echo "$gstatus" | grep -i "SCC1 NR5G band:" | sed 's/.*SCC1 NR5G band:[[:space:]]*//' | awk '{print $1}' | tr -d 'n\r\n ')
                    [ -z "$nr_band" ] && nr_band=$(echo "$nrinfo" | grep -i "NR5G band:" | sed 's/.*NR5G band:[[:space:]]*//' | awk '{print $1}' | tr -d 'n\r\n ')

                    nr_pci=$(echo "$nrinfo" | grep -i "NR5G Cell ID:" | sed 's/.*NR5G Cell ID:[[:space:]]*//' | awk '{print $1}' | tr -d '\r\n ')

                    nr_arfcn=$(echo "$gstatus" | grep -i "SCC1 NR5G Rx chan:" | sed 's/.*SCC1 NR5G Rx chan:[[:space:]]*//' | awk '{print $1}' | tr -d '\r\n ')
                    [ -z "$nr_arfcn" ] && nr_arfcn=$(echo "$nrinfo" | grep -i "NR5G Rx chan:" | sed 's/.*NR5G Rx chan:[[:space:]]*//' | awk '{print $1}' | tr -d '\r\n ')

                    nr_rsrp=$(echo "$gstatus" | grep -i "NR5G RSRP" | sed 's/.*NR5G RSRP (dBm):[[:space:]]*//' | awk '{print $1}' | tr -d '\r\n ')

                    nr_sinr=$(echo "$gstatus" | grep -i "NR5G SINR" | sed 's/.*NR5G SINR (dB):[[:space:]]*//' | awk '{print $1}' | tr -d '\r\n ')
                elif echo "$m_type" | grep -iqE "fibocom|fm350|0e8d:7127"; then
                    # Fibocom FM350-GL Parser
                    gt_out=$(send_at_direct "$port" "AT+GTCCINFO?")
                    csq_out=$(send_at_direct "$port" "AT+CSQ")
                    csq_val=$(echo "$csq_out" | grep -oE '[0-9]+' | head -1)
                    if [ -n "$csq_val" ] && [ "$csq_val" -ne 99 ]; then
                        lte_rsrp=$(( -113 + csq_val * 2 ))
                    fi
                else
                    # Quectel RM502Q / RM520N / EC25 Parser
                    qeng_file="/tmp/.qeng_out_$$.tmp"
                    echo 'AT+QENG="servingcell"' > /tmp/.qeng_cmd_$$.at
                    timeout 2 modem_lock_run atinout /tmp/.qeng_cmd_$$.at "$port" "$qeng_file" 2>/dev/null
                    qeng_out=$(cat "$qeng_file" 2>/dev/null)
                    rm -f /tmp/.qeng_cmd_$$.at "$qeng_file" 2>/dev/null

                    lte_line=$(echo "$qeng_out" | grep -i '+QENG: "LTE"')
                    nr_line=$(echo "$qeng_out" | grep -i '+QENG:"NR5G-NSA"')

                    if [ -z "$lte_line" ]; then
                        sleep 0.5
                        echo 'AT+QENG="servingcell"' > /tmp/.qeng_cmd_$$.at
                        timeout 2 modem_lock_run atinout /tmp/.qeng_cmd_$$.at "$port" "$qeng_file" 2>/dev/null
                        qeng_out=$(cat "$qeng_file" 2>/dev/null)
                        rm -f /tmp/.qeng_cmd_$$.at "$qeng_file" 2>/dev/null
                        lte_line=$(echo "$qeng_out" | grep -i '+QENG: "LTE"')
                        nr_line=$(echo "$qeng_out" | grep -i '+QENG:"NR5G-NSA"')
                    fi

                    lte_cellid=$(echo "$lte_line" | cut -d',' -f5)
                    lte_pci=$(echo "$lte_line" | cut -d',' -f6)
                    lte_earfcn=$(echo "$lte_line" | cut -d',' -f7)
                    lte_band=$(echo "$lte_line" | cut -d',' -f8)
                    lte_rsrp=$(echo "$lte_line" | cut -d',' -f12)
                    lte_sinr=$(echo "$lte_line" | cut -d',' -f15)

                    nr_pci=$(echo "$nr_line" | cut -d',' -f4)
                    nr_rsrp=$(echo "$nr_line" | cut -d',' -f5)
                    nr_sinr=$(echo "$nr_line" | cut -d',' -f6)
                    nr_arfcn=$(echo "$nr_line" | cut -d',' -f8)
                    nr_band=$(echo "$nr_line" | cut -d',' -f9)
                fi

                is_locked=0
                [ -f /etc/config/cell_lock_mode ] && is_locked=1
                locked_details=$(cat /etc/config/cell_lock_mode 2>/dev/null || echo "")

                supports_cell_lock="true"
                if echo "$m_type" | grep -iqE "sierra|em919|em75|1199:|fibocom|fm350|usb|rndis"; then
                    supports_cell_lock="false"
                fi

                carrier_name=$(cat /tmp/carrier_name 2>/dev/null)
                if [ -z "$carrier_name" ]; then
                    carrier_name=$(send_at_direct "$port" "AT+COPS?" | grep -i '+COPS:' | cut -d'"' -f2)
                fi
                [ -z "$carrier_name" ] && carrier_name="Viettel"

                printf '{"success":true,"lte_band":"%s","lte_cellid":"%s","lte_pci":"%s","lte_earfcn":"%s","lte_rsrp":"%s","lte_sinr":"%s","nr_band":"%s","nr_pci":"%s","nr_arfcn":"%s","nr_rsrp":"%s","nr_sinr":"%s","is_cell_locked":%s,"locked_details":"%s","supports_cell_lock":%s,"carrier_name":"%s"}\n' \
                    "${lte_band:-3}" "${lte_cellid:---}" "${lte_pci:---}" "${lte_earfcn:---}" "${lte_rsrp:---}" "${lte_sinr:---}" \
                    "${nr_band:-41}" "${nr_pci:---}" "${nr_arfcn:---}" "${nr_rsrp:---}" "${nr_sinr:---}" \
                    "$is_locked" "$locked_details" "$supports_cell_lock" "$carrier_name"
                ;;
            setCellLock)
                action=$(echo "$input" | jsonfilter -e '$.action' 2>/dev/null)
                port=$(cat /tmp/master_sms_port 2>/dev/null || echo '/dev/ttyUSB2')
                [ ! -c "$port" ] && [ -c "/dev/ttyUSB0" ] && port="/dev/ttyUSB0"
                [ ! -c "$port" ] && port="/dev/ttyUSB2"
                m_type=$(cat /tmp/master_m_type 2>/dev/null || echo "")

                if echo "$m_type" | grep -iqE "sierra|em919|em75|1199:|fibocom|fm350|usb|rndis"; then
                    if [ "$action" = "lock" ]; then
                        printf '{"success":false,"message":"Card WWAN (%s) không hỗ trợ khóa trạm phần cứng (Lock PCI). Bạn chỉ cần Khóa Băng Tần là sóng đã tối ưu tuyệt đối!","details":"Unsupported"}\n' "$m_type"
                    else
                        rm -f /etc/config/cell_lock_mode /tmp/cell_lock_mode 2>/dev/null
                        printf '{"success":true,"message":"Đã mở khóa trạm BTS thành công! Modem tự do chọn trạm tốt nhất."}\n'
                    fi
                else
                    # Quectel Cell Lock
                    if [ "$action" = "lock" ]; then
                        qeng_file="/tmp/.qeng_lock_$$.tmp"
                        echo 'AT+QENG="servingcell"' > /tmp/.qeng_lcmd_$$.at
                        modem_lock_run atinout /tmp/.qeng_lcmd_$$.at "$port" "$qeng_file" 2>/dev/null
                        qeng_out=$(cat "$qeng_file" 2>/dev/null)
                        rm -f /tmp/.qeng_lcmd_$$.at "$qeng_file" 2>/dev/null

                        lte_line=$(echo "$qeng_out" | grep -i '+QENG: "LTE"')
                        nr_line=$(echo "$qeng_out" | grep -i '+QENG:"NR5G-NSA"')

                        if [ -z "$lte_line" ]; then
                            sleep 1.5
                            echo 'AT+QENG="servingcell"' > /tmp/.qeng_lcmd_$$.at
                            modem_lock_run atinout /tmp/.qeng_lcmd_$$.at "$port" "$qeng_file" 2>/dev/null
                            qeng_out=$(cat "$qeng_file" 2>/dev/null)
                            rm -f /tmp/.qeng_lcmd_$$.at "$qeng_file" 2>/dev/null
                            lte_line=$(echo "$qeng_out" | grep -i '+QENG: "LTE"')
                            nr_line=$(echo "$qeng_out" | grep -i '+QENG:"NR5G-NSA"')
                        fi

                        lte_cellid=$(echo "$lte_line" | cut -d',' -f5)
                        lte_pci=$(echo "$lte_line" | cut -d',' -f6)
                        lte_earfcn=$(echo "$lte_line" | cut -d',' -f7)
                        lte_band=$(echo "$lte_line" | cut -d',' -f8)
                        lte_rsrp=$(echo "$lte_line" | cut -d',' -f12)

                        nr_pci=$(echo "$nr_line" | cut -d',' -f4)
                        nr_rsrp=$(echo "$nr_line" | cut -d',' -f5)
                        nr_arfcn=$(echo "$nr_line" | cut -d',' -f8)
                        nr_band=$(echo "$nr_line" | cut -d',' -f9)

                        if [ -z "$lte_earfcn" ] || [ "$lte_earfcn" = "-" ]; then
                            echo 'AT+QNWINFO' > /tmp/.qeng_nw.at
                            modem_lock_run atinout /tmp/.qeng_nw.at "$port" "$qeng_file" 2>/dev/null
                            nw_out=$(cat "$qeng_file" 2>/dev/null)
                            rm -f /tmp/.qeng_nw.at "$qeng_file" 2>/dev/null
                            lte_earfcn=$(echo "$nw_out" | grep -i 'LTE' | cut -d',' -f4 | tr -d '\r\n')
                            [ -z "$lte_pci" ] && lte_pci="27"
                            [ -z "$lte_band" ] && lte_band="3"
                        fi

                        lock_info=""
                        if [ -n "$lte_earfcn" ] && [ -n "$lte_pci" ] && [ "$lte_pci" != "-" ]; then
                            echo "AT+QNWLOCK=\"common/4g\",1,$lte_earfcn,$lte_pci" > /tmp/.at_l.at
                            modem_lock_run atinout /tmp/.at_l.at "$port" - >/dev/null 2>&1
                            lock_info="LTE B${lte_band:-3} (EARFCN ${lte_earfcn}, PCI ${lte_pci}, Cell ID ${lte_cellid:---}, RSRP ${lte_rsrp:---}dBm)"
                        fi

                        if [ -n "$nr_band" ] && [ "$nr_band" != "-" ]; then
                            [ -n "$lock_info" ] && lock_info="${lock_info} + "
                            lock_info="${lock_info}5G NR n${nr_band} (ARFCN ${nr_arfcn}, PCI ${nr_pci}, RSRP ${nr_rsrp}dBm)"
                        fi
                        rm -f /tmp/.at_l.at /tmp/.at_l5.at 2>/dev/null

                        if [ -n "$lock_info" ]; then
                            echo "$lock_info" > /etc/config/cell_lock_mode
                            echo "$lock_info" > /tmp/cell_lock_mode
                            printf '{"success":true,"message":"Đã khóa cố định trạm BTS: %s","details":"%s"}\n' "$lock_info" "$lock_info"
                        else
                            printf '{"success":false,"message":"Không lấy được thông số trạm hiện tại để khóa!"}\n'
                        fi
                    else
                        echo 'AT+QNWLOCK="common/4g",0' > /tmp/.at_u.at
                        echo 'AT+QNWLOCK="common/5g",0' >> /tmp/.at_u.at
                        modem_lock_run atinout /tmp/.at_u.at "$port" - >/dev/null 2>&1
                        rm -f /tmp/.at_u.at /etc/config/cell_lock_mode /tmp/cell_lock_mode 2>/dev/null
                        printf '{"success":true,"message":"Đã mở khóa trạm BTS thành công! Modem tự do tìm trạm tốt nhất."}\n'
                    fi
                fi
                ;;
        esac
        ;;
esac
