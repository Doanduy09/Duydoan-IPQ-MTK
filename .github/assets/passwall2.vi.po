msgstr "Node dự phòng (Fallback)"

msgid "Use Custom Probe URL"
msgstr "Sử dụng URL kiểm tra tùy chỉnh"

msgid "By default the built-in probe URL will be used, enable this option to use a custom probe URL."
msgstr "Theo mặc định, URL kiểm tra tích hợp sẽ được sử dụng, hãy bật tùy chọn này để sử dụng URL kiểm tra tùy chỉnh."

msgid "Probe URL"
msgstr "URL kiểm tra"

msgid "The URL used to detect the connection status."
msgstr "URL được sử dụng để phát hiện trạng thái kết nối."

msgid "Probe Interval"
msgstr "Khoảng thời gian kiểm tra"

msgid "The interval between initiating probes."
msgstr "Khoảng thời gian giữa các lần khởi tạo kiểm tra."

msgid "The time format is numbers + units, such as '10s', '2h45m', and the supported time units are <code>s</code>, <code>m</code>, <code>h</code>, which correspond to seconds, minutes, and hours, respectively."
msgstr "Định dạng thời gian là số + đơn vị, chẳng hạn như '10s', '2h45m' và các đơn vị thời gian được hỗ trợ là <code>s</code>, <code>m</code>, <code>h</code>, tương ứng với giây, phút và giờ."

msgid "When the unit is not filled in, it defaults to seconds."
msgstr "Khi không điền đơn vị, mặc định là giây."

msgid "Preferred Node Count"
msgstr "Số lượng node ưu tiên"

msgid "The load balancer selects the optimal number of nodes, and traffic is randomly distributed among them."
msgstr "Bộ cân bằng tải chọn số lượng node tối ưu và lưu lượng truy cập được phân phối ngẫu nhiên giữa chúng."

msgid "Failure Tolerance (%)"
msgstr "Dung sai lỗi (%)"

msgid "The maximum acceptable speed test failure rate. For example, 1 means allowing a 1% failure rate."
msgstr "Tỷ lệ thất bại kiểm tra tốc độ tối đa có thể chấp nhận được. Ví dụ, 1 có nghĩa là cho phép tỷ lệ thất bại 1%."

msgid "Shunt"
msgstr "Phân luồng"

msgid "Preproxy"
msgstr "Tiền proxy (Preproxy)"

msgid "Preproxy Node"
msgstr "Node tiền proxy"

msgid "Set the node to be used as a pre-proxy."
msgstr "Đặt node được sử dụng làm tiền proxy."

msgid "Each rule has a separate switch that controls whether this rule uses the pre-proxy or not."
msgstr "Mỗi quy tắc có một công tắc riêng kiểm soát xem quy tắc này có sử dụng tiền proxy hay không."

