msgstr "Không có node khả dụng, vui lòng thêm hoặc đăng ký sub node trước."

msgid "No shunt rules? Click me to go to add."
msgstr "Không có quy tắc phân luồng? Bấm vào đây để thêm."

msgid "When using, localhost will connect this node first and then use this node to connect the default node."
msgstr "Khi sử dụng, localhost sẽ kết nối node này trước rồi mới sử dụng node này để kết nối node mặc định."

msgid "Domain Strategy"
msgstr "Chiến lược tên miền"

msgid "Domain matcher"
msgstr "Bộ khớp tên miền"

msgid "'AsIs': Only use domain for routing. Default value."
msgstr "'AsIs': Chỉ sử dụng tên miền để định tuyến. Giá trị mặc định."

msgid "'IPIfNonMatch': When no rule matches current domain, resolves it into IP addresses (A or AAAA records) and try all rules again."
msgstr "'IPIfNonMatch': Khi không có quy tắc nào khớp với tên miền hiện tại, phân giải nó thành địa chỉ IP (bản ghi A hoặc AAAA) và thử lại tất cả các quy tắc."

msgid "'IPOnDemand': As long as there is a IP-based rule, resolves the domain into IP immediately."
msgstr "'IPOnDemand': Miễn là có quy tắc dựa trên IP, hãy phân giải tên miền thành IP ngay lập tức."

