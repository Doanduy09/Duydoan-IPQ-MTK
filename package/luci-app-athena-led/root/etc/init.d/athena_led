#!/bin/sh /etc/rc.common
# [VERIFIED-GOLDEN: athena-led-pro-init | 2026-11-27 | DO NOT MODIFY UNLESS TARGETED]

START=99
STOP=99
USE_PROCD=1

PROG=/usr/sbin/athena-led
COLLECTOR=/usr/bin/athena-led-collector

is_athena_board() {
	local force_b="${1:-0}"
	[ "$force_b" = "1" ] && return 0
	local bname
	bname="$(cat /tmp/sysinfo/board_name 2>/dev/null)"
	case "$bname" in
		*re-cs-02*) return 0 ;;
	esac
	return 1
}

start_service() {
	config_load 'athena_led'
	local cfg='config'

	local enabled forceBoard
	config_get_bool enabled "$cfg" 'enable' '0'
	config_get_bool forceBoard "$cfg" 'forceBoard' '0'

	if ! is_athena_board "$forceBoard"; then
		return 0
	fi

	if [ "$enabled" -eq 0 ]; then
		logger -t athena-led -p daemon.info "Athena LED service is disabled"
		return 0
	fi

	if [ ! -x "$PROG" ]; then
		logger -t athena-led -p daemon.err "Binary $PROG not found or not executable"
		return 1
	fi

	local status seconds lightLevel option value url tempFlag autoIcons rgbMode nightMode nightStart nightEnd nightLevel city
	config_get status "$cfg" 'status' ''
	config_get seconds "$cfg" 'seconds' '5'
	config_get lightLevel "$cfg" 'lightLevel' '5'
	config_get option "$cfg" 'option' 'timeBlink date lunar netSpeed string'
	config_get value "$cfg" 'value' 'DOAN DUY'
	config_get url "$cfg" 'url' ''
	config_get tempFlag "$cfg" 'tempFlag' '4'
	config_get_bool autoIcons "$cfg" 'autoIcons' '1'
	config_get rgbMode "$cfg" 'rgbMode' 'auto'
	config_get_bool nightMode "$cfg" 'nightMode' '0'
	config_get nightStart "$cfg" 'nightStart' '23:00'
	config_get nightEnd "$cfg" 'nightEnd' '06:00'
	config_get nightLevel "$cfg" 'nightLevel' '-1'
	config_get city "$cfg" 'city' 'HoChiMinh'

	# Instance 1: Real-time C Matrix & RGB Controller
	procd_open_instance "matrix"
	procd_set_param command "$PROG" \
		-status "${status}" \
		-seconds "${seconds}" \
		-lightLevel "${lightLevel}" \
		-option "${option}" \
		-value "${value}" \
		-url "${url}" \
		-tempFlag "${tempFlag}" \
		-autoIcons "${autoIcons}" \
		-rgbMode "${rgbMode}" \
		-nightMode "${nightMode}" \
		-nightStart "${nightStart}" \
		-nightEnd "${nightEnd}" \
		-nightLevel "${nightLevel}" \
		-forceBoard "${forceBoard}"
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance

	# Instance 2: Non-blocking Background Telemetry Collector (only if async modes enabled)
	case " ${option} " in
		*" modem5g "*|*" weatherVN "*|*" getByUrl "*)
			if [ -x "$COLLECTOR" ]; then
				procd_open_instance "collector"
				procd_set_param command "$COLLECTOR" daemon
				procd_set_param respawn
				procd_close_instance
			fi
			;;
	esac

	logger -t athena-led -p daemon.info "Athena LED Pro started (modes: ${option})"
}

service_triggers() {
	procd_add_reload_trigger "athena_led"
}

reload_service() {
	stop
	start
}
# [/VERIFIED-GOLDEN]
