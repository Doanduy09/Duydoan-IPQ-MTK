#!/bin/sh
board="$(cat /tmp/sysinfo/board_name 2>/dev/null || cat /proc/device-tree/model 2>/dev/null)"
case "$board" in
    *s10sky*|*hh500v*|*aw1000*)
        uci -q get qmodem.main >/dev/null || uci -q set qmodem.main=main
        uci -q set qmodem.main.enable_pcie_scan=1
        uci -q set qmodem.main.try_preset_pcie=1
        uci -q get qmodem.pcie0 >/dev/null || uci -q set qmodem.pcie0=modem-slot
        uci -q set qmodem.pcie0.type=pcie
        uci -q set qmodem.pcie0.slot='0000:01:00.0'
        uci -q set qmodem.pcie0.alias='5G_PCIe'
        uci -q set qmodem.pcie0.net_led='5gblue'
        uci -q set qmodem.pcie0.sim_led='5gblue'
        uci -q set qmodem.pcie0.default_metric=10
        uci -q commit qmodem
        ;;
esac
exit 0
