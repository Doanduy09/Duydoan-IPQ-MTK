                        '</div>';
                    }

                    var headerTitleHtml = d.mesh_active ?
                        '<div><h3 style="margin: 0; font-size: 18px; font-weight: 800; color: #000000;">📡 Bảng Điều Khiển Cụm Wi-Fi Mesh Tự Động (Live 3s)</h3><div style="color: #000000; font-size: 13px; margin-top: 2px;">Chuẩn Fast Roaming 802.11r/k/v chuyển vùng sóng tức thì không gián đoạn Game / Video Call</div></div>' :
                        '<div><h3 style="margin: 0; font-size: 18px; font-weight: 800; color: #000000;">📡 Bảng Quản Lý Wi-Fi Mesh (Hiện Đang Tắt - Chế Độ Độc Lập)</h3><div style="color: #000000; font-size: 13px; margin-top: 2px;">Router đang hoạt động độc lập (Standalone), dành trọn 2402 Mbps băng thông Wi-Fi 6 cho thiết bị</div></div>';

