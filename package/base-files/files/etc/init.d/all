    cat << 'SSH_ALERT_EOF' > /etc/profile.d/ssh_login_alert.sh
#!/bin/sh
# ==============================================================================
# INSTANT SSH LOGIN INTRUSION ALERT VIA TELEGRAM
# Alerts owner whenever an SSH connection is established to the router
# Sourced safely by /etc/profile - MUST USE return 0, NEVER exit 0!
# ==============================================================================

[ -z "$SSH_CLIENT" ] && [ -z "$SSH_CONNECTION" ] && return 0 2>/dev/null

ssh_ip=$(echo "${SSH_CLIENT:-$SSH_CONNECTION}" | awk '{print $1}')
[ -z "$ssh_ip" ] && return 0 2>/dev/null

# Debounce: Bo qua neu cung mot IP ket noi lai trong vong 60 giay
now_ts=$(date +%s)
last_ts=0
last_ip=""
if [ -f /tmp/.last_ssh_alert ]; then
    last_ip=$(awk '{print $1}' /tmp/.last_ssh_alert 2>/dev/null)
    last_ts=$(awk '{print $2}' /tmp/.last_ssh_alert 2>/dev/null)
fi

if [ "$last_ip" = "$ssh_ip" ] && [ $((now_ts - ${last_ts:-0})) -lt 60 ]; then
    return 0 2>/dev/null
fi
echo "$ssh_ip $now_ts" > /tmp/.last_ssh_alert

# Doc cau hinh telegram
BOT_TOKEN=""
ADMIN_CHAT_ID=""
OWNER_NAME="Admin"

if [ -f /etc/config/telegram_bot.conf ]; then
    . /etc/config/telegram_bot.conf 2>/dev/null
    [ -n "$TG_BOT_TOKEN" ] && BOT_TOKEN="$TG_BOT_TOKEN"
    [ -n "$TG_ADMIN_ID" ] && ADMIN_CHAT_ID="$TG_ADMIN_ID"
    [ -n "$TG_OWNER_NAME" ] && OWNER_NAME="$TG_OWNER_NAME"
fi

if [ -z "$BOT_TOKEN" ] || [ -z "$ADMIN_CHAT_ID" ]; then
    return 0 2>/dev/null
fi

log_time=$(date '+%H:%M:%S ngày %d/%m/%Y')
msg="🔐 <b>CẢNH BÁO ĐĂNG NHẬP SSH ROUTER:</b>
━━━━━━━━━━━━━━━━━━━
👤 <b>Tài khoản:</b> <code>root</code>
🌐 <b>Địa chỉ IP:</b> <code>${ssh_ip}</code>
🕒 <b>Thời gian:</b> <code>${log_time}</code>

⚠️ <i>Nếu không phải ${OWNER_NAME} truy cập, hãy kiểm tra bảo mật ngay lập tức!</i>"

if [ -x /usr/bin/send_telegram ]; then
    /usr/bin/send_telegram "$msg" >/dev/null 2>&1 &
else
    pfile="/tmp/.ssh_alert_$$.txt"
    lua - "$ADMIN_CHAT_ID" "$msg" "$pfile" << 'LUAPOST' 2>/dev/null
local cid, text, outpath = arg[1], arg[2], arg[3]
text = string.gsub(text or '', '\\n', '\n')
local enc = (string.gsub(text, '([^%w_.~-])', function(c) return string.format('%%%02X', string.byte(c)) end))
local post_data = 'chat_id=' .. cid .. '&parse_mode=HTML&text=' .. enc
local f = io.open(outpath, 'w')
if f then f:write(post_data); f:close() end
LUAPOST

    if [ -f "$pfile" ]; then
        curl -4 --http1.1 -s -m 5 -d @"$pfile" "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" >/dev/null 2>&1 &
        rm -f "$pfile" 2>/dev/null
    fi
fi
return 0 2>/dev/null
SSH_ALERT_EOF
