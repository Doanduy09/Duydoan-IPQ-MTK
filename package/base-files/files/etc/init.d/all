#!/bin/sh
_terminal_auto_interceptor() {
    local raw_arg="$_"
    local last_arg=$(echo "$raw_arg" | tr -d '\r\n ')

    if [ -f /tmp/.last_tg_set ]; then
        local just_set=$(cat /tmp/.last_tg_set 2>/dev/null | tr -d '\r\n ')
        rm -f /tmp/.last_tg_set 2>/dev/null
        if [ "$just_set" = "$last_arg" ]; then
            _LAST_AUTO_INTERCEPTED="$last_arg"
            return 0
        fi
    fi

    if [ -f /tmp/.last_imei_set ]; then
        local just_imei=$(cat /tmp/.last_imei_set 2>/dev/null | tr -d '\r\n ')
        rm -f /tmp/.last_imei_set 2>/dev/null
        if [ "$just_imei" = "$last_arg" ]; then
            _LAST_AUTO_INTERCEPTED="$last_arg"
            return 0
        fi
    fi

    if [ -f /tmp/.last_iccid_set ]; then
        local just_iccid=$(cat /tmp/.last_iccid_set 2>/dev/null | tr -d '\r\n ')
        rm -f /tmp/.last_iccid_set 2>/dev/null
        if [ "$just_iccid" = "$last_arg" ]; then
            _LAST_AUTO_INTERCEPTED="$last_arg"
            return 0
        fi
    fi

    if [ -n "$last_arg" ] && [ "$last_arg" != "$_LAST_AUTO_INTERCEPTED" ]; then
        if echo "$last_arg" | grep -qE '^[0-9]{8,12}:[a-zA-Z0-9_-]{30,45}$'; then
            _LAST_AUTO_INTERCEPTED="$last_arg"
            echo ""
            echo "âš¡ [Tá»° Äá»˜NG NHáº¬N DIá»†N TOKEN TELEGRAM]"
            echo "ðŸ‘‰ Äang kÃ­ch hoáº¡t vÃ  lÆ°u cáº¥u hÃ¬nh bot..."
            /usr/bin/set_telegram "$last_arg"
        elif echo "$last_arg" | grep -qE '^[0-9]{15}$'; then
            _LAST_AUTO_INTERCEPTED="$last_arg"
            echo ""
