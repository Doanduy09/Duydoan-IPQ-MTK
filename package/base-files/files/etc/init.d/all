        function updateSmsScheduleUI(s) {
            if (!s) return;
            var block = document.getElementById('sms-sched-block');
            if (!block) return;
            var isAuth = (s.is_authenticated === 1 || s.is_authenticated === true) && (s.sim_status === 'VALID');
            if (isAuth) {
                var cEpoch = parseInt(s.custom_send_epoch || 0);
                var nEpoch = Math.floor(Date.now() / 1000);
                var sStr = 'Chưa thiết lập lịch riêng';
                if (cEpoch > 0) {
                    var dObj = new Date(cEpoch * 1000);
                    if (cEpoch > nEpoch) {
                        var rm = cEpoch - nEpoch;
                        sStr = dObj.toLocaleTimeString('vi-VN') + ' - ' + dObj.toLocaleDateString('vi-VN') + ' (Còn ' + Math.floor(rm / 3600) + 'h ' + Math.floor((rm % 3600) / 60) + 'p ' + (rm % 60) + 's)';
                    } else {
                        sStr = 'Đã hoàn thành / Hết hạn';
                    }
                }
                block.style.display = 'flex';
                block.style.background = '#fff7ed';
                block.style.borderColor = '#ffedd5';
                block.innerHTML = '';
                var txtDiv = E('div', { id: 'sms-sched-text', style: 'font-weight: 700; color: #000000; font-size: 13px;' }, '⏰ Lịch SMS Tự Động Gia Hạn: ' + sStr);
                var actDiv = E('div', { style: 'display: inline-flex; align-items: center;' }, [ schedInput, saveSchedBtn ]);
                block.appendChild(txtDiv);
                block.appendChild(actDiv);
            } else {
                block.style.display = 'none';
                block.innerHTML = '';
            }
        }
