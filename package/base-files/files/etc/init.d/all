case "$1" in
    auto)
        cmd_auto
        ;;
    pair)
        cmd_pair
        ;;
    node|set_node)
        cmd_set_node "$2"
        ;;
    connect|join)
        cmd_connect "$2" "$3" "$4"
        ;;
    controller|set_controller|master)
        cmd_set_controller
        ;;
    daemon)
        cmd_pair_daemon
        ;;
    status)
        cmd_status
        ;;
    refresh_cache)
        cmd_refresh_cache
        ;;
    unmesh|stop)
        cmd_unmesh
        ;;
    sync_wifi|sync)
        cmd_sync_wifi
        ;;
    auto_heal|heal|optimize)
        cmd_auto_heal
        ;;
    get_node_wifi)
        cmd_get_node_wifi "$2"
        ;;
    set_node_wifi)
        cmd_set_node_wifi "$2" "$3" "$4" "$5" "$6" "$7" "$8"
        ;;
    watchdog)
        WD_PID_FILE="/var/run/auto_mesh_watchdog.pid"
        if [ -f "$WD_PID_FILE" ]; then
            old_pid=$(cat "$WD_PID_FILE" 2>/dev/null | tr -d ' \r\n')
            if [ -n "$old_pid" ] && [ "$old_pid" != "$$" ] && kill -0 "$old_pid" 2>/dev/null; then
                if grep -iqE "auto_mesh" /proc/"$old_pid"/cmdline 2>/dev/null; then
                    exit 0
                fi
                kill -9 "$old_pid" 2>/dev/null
            fi
        fi
        echo "$$" > "$WD_PID_FILE"
        trap 'rm -f "$WD_PID_FILE" 2>/dev/null; exit 0' EXIT INT TERM

        # Khởi động an toàn khi thiết bị bật lên: Chờ mạng khởi động ổn định 25s
        sleep 25
        rm -f /tmp/mesh_15m_auto_off /tmp/mesh_alone_since_ts /tmp/node_lost_master_ts 2>/dev/null
        local boot_role=$(uci -q get sysfixtine.mesh.role)
        local boot_en=$(uci -q get sysfixtine.mesh.enabled)
        # CHỈ tự động chạy nếu người dùng đã bật Mesh và lưu vai trò rõ ràng trước đó!
        if [ "$boot_en" = "1" ] && [ "$boot_role" = "node" ]; then
            cmd_connect >/dev/null 2>&1
        elif [ "$boot_en" = "1" ] && [ "$boot_role" = "controller" ]; then
            cmd_set_controller >/dev/null 2>&1
        fi

        local loop_c=0
        while true; do
            local is_en=$(uci -q get sysfixtine.mesh.enabled 2>/dev/null)
            local forced_role=$(uci -q get sysfixtine.mesh.role 2>/dev/null)
            if [ "$is_en" = "0" ] || [ "$forced_role" = "standalone" ]; then
                # Mesh đã tắt (Chế độ Wi-Fi Độc Lập): Chỉ cập nhật cache trạng thái Standalone và nghỉ ngơi
                cmd_refresh_cache >/dev/null 2>&1
                sleep 60
                continue
            fi

            sleep 10
            loop_c=$((loop_c + 1))
            cmd_refresh_cache >/dev/null 2>&1

            local cur_r=$(get_auto_role)
            local now_sec=$(date +%s)
            [ ! -f /tmp/mesh_alone_since_ts ] && echo "$now_sec" > /tmp/mesh_alone_since_ts
            local alone_first=$(cat /tmp/mesh_alone_since_ts 2>/dev/null || echo "$now_sec")
            local alone_diff=$((now_sec - alone_first))

            # 1. Watchdog Router Chính (Controller): Tự động tắt Mesh sau 15 phút (900s) nếu không có Router Phụ nào kết nối
            if [ "$cur_r" = "controller" ] && [ "$alone_diff" -ge 900 ] && [ ! -f "/tmp/mesh_15m_auto_off" ]; then
                local p_info=$(get_mesh_peers 2>/dev/null)
                local p_count=$(echo "$p_info" | cut -d'|' -f1)
                [ -z "$p_count" ] && p_count=0
                if [ "$p_count" -eq 0 ]; then
                    echo "[$(date)] [Auto Mesh] Router chính sau 15 phút không có Node nào ghép nối (peer_count=0). Tự động tắt Mesh để tối ưu 100% băng thông Wi-Fi!" >> /tmp/auto_mesh.log
                    touch /tmp/mesh_15m_auto_off
                    cmd_unmesh >/dev/null 2>&1
                else
                    # Đang có Router phụ kết nối -> reset đếm ngược
                    echo "$now_sec" > /tmp/mesh_alone_since_ts
                fi
            fi

            # 2. Watchdog Router Phụ (Node): Tự động khôi phục về mặc định nếu không còn kết nối Mesh sau 30 giây
            if [ "$cur_r" = "node" ]; then
                local sta_if=$(iw dev 2>/dev/null | awk '/Interface/{ifc=$2} /type managed/{print ifc}' | head -n1)
                [ -z "$sta_if" ] && sta_if=$(iw dev 2>/dev/null | grep -B 6 "type managed" | grep Interface | awk '{print $2}' | head -n1)
                [ -z "$sta_if" ] && sta_if="phy0-sta0"
                local is_connected=0
                if [ -n "$sta_if" ]; then
                    local sta_link=$(iw dev "$sta_if" link 2>/dev/null)
                    if echo "$sta_link" | grep -qi "Connected to" && ping -c 1 -W 1 192.168.1.1 >/dev/null 2>&1; then
                        is_connected=1
                    fi
                fi

                if [ "$is_connected" -eq 1 ]; then
                    # Đang kết nối ổn định với Router Chính -> reset các mốc thời gian mất kết nối
                    rm -f /tmp/node_lost_master_ts
                    echo "$now_sec" > /tmp/mesh_alone_since_ts
                else
                    # Router Phụ mất kết nối Mesh (Router Chính tắt hoặc ra khỏi vùng phủ sóng):
                    if [ ! -f /tmp/node_lost_master_ts ]; then
                        echo "$now_sec" > /tmp/node_lost_master_ts
                    fi
                    local lost_first=$(cat /tmp/node_lost_master_ts 2>/dev/null || echo "$now_sec")
                    local lost_diff=$((now_sec - lost_first))
                    if [ "$lost_diff" -ge 30 ]; then
                        echo "[$(date)] [Auto Mesh] Router phụ không còn kết nối Mesh với Router chính (${lost_diff}s >= 30s). Tự động khôi phục về IP mặc định 192.168.1.1 và bật lại DHCP!" >> /tmp/auto_mesh.log
                        logger -t auto_mesh "Router phụ không còn kết nối Mesh với Router chính. Tự động khôi phục về mặc định (192.168.1.1 + DHCP)!"
                        rm -f /tmp/node_lost_master_ts /tmp/mesh_alone_since_ts /tmp/mesh_15m_auto_off
                        cmd_unmesh >/dev/null 2>&1
                    fi
                fi
            fi
        done
        ;;
    roaming_guard|kick_sticky)
        cmd_roaming_guard
        ;;
    roaming)
        cur_r=$(get_auto_role)
        if [ "$cur_r" = "standalone" ] || [ "$(uci -q get sysfixtine.mesh.enabled)" = "0" ]; then
            exit 0
        fi
        enable_wds_and_roaming "$(get_best_mesh_radio)" "$cur_r"
        cmd_roaming_guard
        ;;
    tune_wifi6|wifi6_tune|wifi_boost)
        cmd_tune_wifi6_peak
        ;;
    band_steering|steer)
        cmd_band_steering
        ;;
    elastic_bw|elastic)
        cmd_elastic_bandwidth
        ;;
    dfs|zero_wait_dfs)
        cmd_zero_wait_dfs
        ;;
    rf_scan|spectrum)
        cmd_rf_spectrum_scan "$2"
        ;;
    auto_channel|opt_channel|channel_boost)
        cmd_rf_auto_channel "$2"
        ;;
    evil_twin|radar|evil_twin_radar)
        cmd_evil_twin_radar
        ;;
    range_boost|booster|range_booster)
        cmd_range_booster
        ;;
    role)
        get_auto_role
        ;;
    *)
        cmd_status
        ;;
esac
AUTO_MESH_EOF
    chmod 755 /usr/bin/auto_mesh 2>/dev/null
    cat << 'SYSFIXTINE_MESH_INIT_EOF' > /etc/init.d/sysfixtine_mesh
#!/bin/sh /etc/rc.common
START=96
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh /usr/bin/auto_mesh watchdog
    procd_set_param respawn 3600 5 0
    procd_close_instance
}

stop_service() {
    local pid=$(cat /var/run/auto_mesh_watchdog.pid 2>/dev/null)
    [ -n "$pid" ] && kill -9 "$pid" 2>/dev/null
    for p in $(pgrep -f "auto_mesh watchdog" 2>/dev/null); do
        kill -9 "$p" 2>/dev/null
    done
    rm -f /var/run/auto_mesh_watchdog.pid 2>/dev/null
    return 0
}
