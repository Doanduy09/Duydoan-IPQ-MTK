      // Fetch Phone NAS Node Status
      try {
        const pRes = await fetch('/cgi-bin/airdrop?action=get_nas', { cache: 'no-store' });
        if (pRes.ok) {
          const pData = await pRes.json();
          if (pData.phones && pData.phones.length > 0) {
