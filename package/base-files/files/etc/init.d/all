            click: function(e) {
                var isAct = e.target.getAttribute('data-active') === '1';
                var targetAction = isAct ? 'off' : 'on';
                e.target.textContent = '⏳ Đang xử lý...';
                callToggleGameMode(targetAction).then(function(r) {
