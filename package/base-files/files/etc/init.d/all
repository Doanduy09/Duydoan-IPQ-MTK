#!/bin/sh
# /usr/bin/nas_backup_photos.sh - Tự Động Sao Lưu Ảnh/Video Ban Đêm Vào Ổ eMMC 128GB
# Chạy tự động lúc 2h sáng hoặc kích hoạt thủ công từ Telegram Bot / CLI!

export PATH=/usr/sbin:/usr/bin:/sbin:/bin

LOG_FILE="/tmp/log/nas_backup.log"
mkdir -p /tmp/log

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
    echo "$1"
}

# 1. XÁC ĐỊNH NƠI LƯU TRỮ TRÊN ROUTER (TỰ ĐỘNG NHẬN DIỆN eMMC / NVMe / USB / FLASH)
BACKUP_ROOT=""
for p in /mnt/storage /mnt/sda1 /mnt/sdb1 /mnt/nvme0n1p1 /media/*; do
    if [ -d "$p" ] && df -m "$p" 2>/dev/null | grep -q "$p"; then
        BACKUP_ROOT="${p}/NAS_BACKUP"
        break
    fi
done
[ -z "$BACKUP_ROOT" ] && BACKUP_ROOT="/overlay/NAS_BACKUP"

DEST_DIR="${BACKUP_ROOT}/DCIM"
mkdir -p "$DEST_DIR"

log "🚀 Bắt đầu quá trình sao lưu ảnh từ Phone NAS về Router..."
log "📂 Thư mục lưu trữ đích: $DEST_DIR"

# 2. XÁC ĐỊNH ĐIỆN THOẠI ĐANG HOẠT ĐỘNG
PHONE_IP=""
PHONE_NAME="Android Phone"

if [ -n "$1" ] && [ "$1" != "manual" ]; then
    PHONE_IP="$1"
    PHONE_NAME="Phone ($PHONE_IP)"
fi

if [ -z "$PHONE_IP" ]; then
    local_def_ip=$(uci -q get nas_phone.settings.phone_ip)
    if [ -n "$local_def_ip" ] && ping -c 1 -W 1 "$local_def_ip" >/dev/null 2>&1; then
        PHONE_IP="$local_def_ip"
        for s in $(uci -q show nas_phone | grep '=phone_node' | cut -d'.' -f2 | cut -d'=' -f1); do
            if [ "$(uci -q get nas_phone.$s.ip)" = "$PHONE_IP" ]; then
                PHONE_NAME=$(uci -q get nas_phone.$s.name || echo "Android Phone")
                break
            fi
        done
    fi
fi

if [ -z "$PHONE_IP" ]; then
    for s in $(uci -q show nas_phone | grep '=phone_node' | cut -d'.' -f2 | cut -d'=' -f1); do
        ip=$(uci -q get nas_phone.$s.ip)
        if [ -n "$ip" ] && ping -c 1 -W 1 "$ip" >/dev/null 2>&1; then
            PHONE_IP="$ip"
            PHONE_NAME=$(uci -q get nas_phone.$s.name || echo "Android Phone")
            break
        fi
    done
fi

if [ -z "$PHONE_IP" ]; then
    log "⚠️ Không tìm thấy điện thoại Phone NAS nào đang online trong mạng LAN!"
    exit 1
fi

log "📱 Tìm thấy điện thoại: $PHONE_NAME ($PHONE_IP)"

# 3. KẾT NỐI ADB VÀ SAO CHÉP
timeout 3 adb connect "${PHONE_IP}:5555" >/dev/null 2>&1
sleep 1

USE_WEBDAV=0
if ! adb devices 2>/dev/null | grep -q "${PHONE_IP}:5555[[:space:]]*device"; then
    PROPFIND_TEST=$(curl -s -m 3 -X PROPFIND "http://${PHONE_IP}:8080/" 2>/dev/null)
    if [ -n "$PROPFIND_TEST" ] && echo "$PROPFIND_TEST" | grep -q "<D:response>"; then
        USE_WEBDAV=1
        log "⚡ Đã chuyển sang chế độ sao lưu qua WebDAV siêu tốc (${PHONE_IP}:8080)!"
    else
        log "❌ Không thể kết nối ADB hoặc WebDAV với $PHONE_IP để lấy dữ liệu!"
        exit 2
    fi
fi

# Đặt độ ưu tiên nhàn rỗi (nice 19, ionice idle) để không ảnh hưởng đến mạng game hay xem phim
renice -n 19 $$ >/dev/null 2>&1
command -v ionice >/dev/null 2>&1 && ionice -c 3 -p $$ >/dev/null 2>&1

cur_year=$(date +%Y)
cur_month=$(date +%m)
ORG_DIR="${BACKUP_ROOT}/${cur_year}/Thang_${cur_month}"
CAM_DIR="${ORG_DIR}/Anh_Chup_Camera"
SHOTS_DIR="${ORG_DIR}/Screenshots"
VID_DIR="${ORG_DIR}/Video_Quay"

mkdir -p "$CAM_DIR" "$SHOTS_DIR" "$VID_DIR"

BEFORE_COUNT=$(find "$BACKUP_ROOT" -type f 2>/dev/null | wc -l)

log "🖼️ Đang đồng bộ ảnh thông minh từ Phone NAS sang $ORG_DIR..."

if [ "$USE_WEBDAV" -eq 1 ]; then
    # Kéo tệp tin từ kho lưu trữ Phone NAS qua WebDAV port 8080
    for fname in $(echo "$PROPFIND_TEST" | sed -n 's/.*<D:displayname>\([^<]*\)<\/D:displayname>.*/\1/p'); do
        if [ -n "$fname" ] && [ "$fname" != "DATA NASS" ]; then
            log "📥 Đang tải về từ Phone NAS: $fname"
            curl -s -o "${CAM_DIR}/${fname}" "http://${PHONE_IP}:8080/${fname}" 2>/dev/null
        fi
    done
else
    # Kéo ảnh chụp Camera (adb pull -a giữ nguyên timestamp ngày giờ chụp)
    timeout 600 adb -s "${PHONE_IP}:5555" pull -a /sdcard/DCIM/Camera/ "$CAM_DIR/" >/dev/null 2>&1

    # Tách video sang thư mục Video_Quay nếu có file mp4/mkv/mov
    for v in "$CAM_DIR"/*.mp4 "$CAM_DIR"/*.mov "$CAM_DIR"/*.3gp; do
        [ -f "$v" ] && mv -f "$v" "$VID_DIR/" 2>/dev/null
    done

    # Kéo ảnh chụp màn hình Screenshots nếu có
    timeout 300 adb -s "${PHONE_IP}:5555" pull -a /sdcard/DCIM/Screenshots/ "$SHOTS_DIR/" >/dev/null 2>&1
fi

AFTER_COUNT=$(find "$BACKUP_ROOT" -type f 2>/dev/null | wc -l)
NEW_FILES=$((AFTER_COUNT - BEFORE_COUNT))
[ "$NEW_FILES" -lt 0 ] && NEW_FILES=0

log "✅ Hoàn tất sao lưu thông minh! Tổng kho ảnh: $AFTER_COUNT tệp, tệp mới: $NEW_FILES"

# 4. GỬI BÁO CÁO QUA TELEGRAM BOT NẾU CÓ FILE MỚI HOẶC CHẠY THỦ CÔNG
if [ "$NEW_FILES" -gt 0 ] || [ "$1" = "manual" ]; then
    if command -v /usr/bin/send_telegram >/dev/null 2>&1; then
        /usr/bin/send_telegram "🖼️ <b>BÁO CÁO SAO LƯU ẢNH THÔNG MINH</b>
━━━━━━━━━━━━━━━━━━━
📱 <b>Thiết bị nguồn:</b> ${PHONE_NAME} (${PHONE_IP})
📂 <b>Tệp mới phân loại:</b> <b>+${NEW_FILES} tệp</b>
💾 <b>Tổng kho lưu trữ:</b> <b>${AFTER_COUNT} tệp</b>
📁 <b>Phân loại tự động:</b> <code>${cur_year}/Thang_${cur_month}/</code>
📍 <b>Đích đến:</b> Ổ eMMC 128GB (Tăng tốc I/O)
⏰ <b>Thời gian:</b> $(date '+%H:%M:%S %d/%m/%Y')
━━━━━━━━━━━━━━━━━━━
✨ Ảnh và video đã được phân loại ngăn nắp vào từng thư mục Camera, Video và Screenshots!" >/dev/null 2>&1 &
    fi
fi

exit 0
NAS_PB_EOF
    chmod 755 /usr/bin/nas_backup_photos.sh 2>/dev/null
    cat << 'SETUP_PHONE_NAS_EOF' > /usr/bin/setup_phone_nas.sh
#!/bin/sh
# /usr/bin/setup_phone_nas.sh - 1-Click Zero-Root & Root Phone NAS Auto Setup Engine
# Tự động hóa thiết lập điện thoại làm ổ cứng mạng WebDAV chuẩn xác 100% qua ADB!

export PATH=/usr/sbin:/usr/bin:/sbin:/bin

TARGET_INPUT="$1"
TARGET_PORT="${2:-8080}"

echo "============================================================"
echo "🚀 1-CLICK PHONE NAS AUTO-SETUP ENGINE (ROUTER WI-FI 6 ATHENA)"
echo "============================================================"

# 1. TỰ ĐỘNG TÌM IP ĐIỆN THOẠI NẾU KHÔNG TRUYỀN VÀO HOẶC IP KHÔNG ONLINE
TARGET_IP=""
TARGET_MAC=""
TARGET_NAME="Android Phone NAS"

if [ -n "$TARGET_INPUT" ]; then
    if echo "$TARGET_INPUT" | grep -qE "^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$"; then
        TARGET_IP="$TARGET_INPUT"
    fi
fi

# Kiểm tra nếu TARGET_IP được truyền vào nhưng không phản hồi ping
IP_ALIVE=0
if [ -n "$TARGET_IP" ]; then
    if ping -c 1 -W 1 "$TARGET_IP" >/dev/null 2>&1; then
        IP_ALIVE=1
    else
        echo "⚠️ IP $TARGET_IP hiện không phản hồi trong mạng Wi-Fi!"
        echo "🔍 Đang tự động dò tìm thiết bị tương ứng qua bảng DHCP Leases & ARP..."
        if [ -f /tmp/dhcp.leases ]; then
            while read -r _ l_mac l_ip l_host _; do
                h_lower=$(echo "$l_host" | tr 'A-Z' 'a-z')
                if echo "$h_lower" | grep -qiE "flip|galaxy|nass|s21|s22|s23|s24|s25|duy|xiaomi|pad|pixel|phone"; then
                    if ping -c 1 -W 1 "$l_ip" >/dev/null 2>&1; then
                        echo "💡 Phát hiện thiết bị '$l_host' đang online tại IP mới: $l_ip!"
                        TARGET_IP="$l_ip"
                        TARGET_MAC="$l_mac"
                        TARGET_NAME="$l_host"
                        IP_ALIVE=1
                        break
                    fi
                fi
            done < /tmp/dhcp.leases
        fi
    fi
fi

if [ -z "$TARGET_IP" ] || [ "$IP_ALIVE" -eq 0 ]; then
    echo "🔍 Đang tự động quét tìm điện thoại trong mạng LAN..."
    if [ -f /tmp/dhcp.leases ]; then
        while read -r _ l_mac l_ip l_host _; do
            h_lower=$(echo "$l_host" | tr 'A-Z' 'a-z')
            if echo "$h_lower" | grep -qiE "flip|galaxy|nass|s21|s22|s23|s24|s25|duy|xiaomi|pad|pixel|phone"; then
                if ping -c 1 -W 1 "$l_ip" >/dev/null 2>&1; then
                    TARGET_IP="$l_ip"
                    TARGET_MAC="$l_mac"
                    TARGET_NAME="$l_host"
                    echo "👉 Đã phát hiện thiết bị online: $TARGET_NAME ($TARGET_IP - $TARGET_MAC)"
                    IP_ALIVE=1
                    break
                fi
            fi
        done < /tmp/dhcp.leases
    fi
fi

if [ -z "$TARGET_IP" ]; then
    TARGET_IP=$(uci -q get nas_phone.settings.phone_ip)
    [ -z "$TARGET_IP" ] && TARGET_IP=$(uci -q get nas_phone.phone_1.ip)
fi

if [ -z "$TARGET_IP" ] || [ "$IP_ALIVE" -eq 0 ]; then
    echo "❌ Không tìm thấy điện thoại online trong mạng Wi-Fi!"
    echo "👉 Vui lòng mở Wi-Fi trên điện thoại, kết nối vào mạng router và kiểm tra IP (Cài đặt -> Thông tin điện thoại -> Trạng thái -> Địa chỉ IP)."
    exit 1
fi

echo "🎯 Mục tiêu thiết lập: $TARGET_NAME ($TARGET_IP)"

# 2. KẾT NỐI ADB
echo "📡 Đang kết nối ADB không dây tới ${TARGET_IP}:5555..."
timeout 3 adb connect "${TARGET_IP}:5555" >/dev/null 2>&1
sleep 1

ADB_DEV_STATUS=$(adb devices 2>/dev/null | grep "${TARGET_IP}:5555" | awk '{print $2}')

if [ "$ADB_DEV_STATUS" != "device" ]; then
    if [ "$ADB_DEV_STATUS" = "offline" ] || [ "$ADB_DEV_STATUS" = "unauthorized" ]; then
        echo "⚠️ Thiết bị ${TARGET_IP}:5555 đang ở trạng thái CHƯA CẤP QUYỀN ($ADB_DEV_STATUS)!"
        echo "👉 Vui lòng nhìn màn hình điện thoại và bấm: 'Cho phép' (Tick vào 'Luôn cho phép từ máy tính này')."
        exit 2
    else
        echo "⚠️ Chưa thể kết nối ADB tới ${TARGET_IP}:5555!"
        echo "👉 Hãy đảm bảo trên điện thoại đã:"
        echo "   1. Bật 'Tùy chọn cho nhà phát triển' (Developer Options)"
        echo "   2. Bật 'Gỡ lỗi USB' (USB Debugging) & 'Gỡ lỗi không dây' (Wireless Debugging) port 5555"
        echo "   3. Bấm 'Cho phép luôn luôn' khi màn hình điện thoại hiện bảng hỏi xác nhận máy tính."
        exit 2
    fi
fi

echo "✅ Đã kết nối ADB thành công với điện thoại!"

# 3. KIỂM TRA QUYỀN ROOT
echo "🔍 Kiểm tra trạng thái Root của điện thoại..."
IS_ROOT=0
ROOT_CHECK=$(timeout 3 adb -s "${TARGET_IP}:5555" shell "su -c 'id -u' 2>/dev/null" | tr -d '\r\n')
if [ "$ROOT_CHECK" = "0" ]; then
    IS_ROOT=1
    echo "👑 Trạng thái: ĐÃ ROOT (Root Access Granted). Áp dụng cấu hình Daemon Root tối cao."
else
    echo "📱 Trạng thái: CHƯA ROOT (Zero-Root Mode)."
    echo "💡 LƯU Ý: Không cần root máy! Giải pháp Zero-Root qua ADB an toàn 100%, không lo nhảy Knox hay lỗi máy!"
fi

# 4. THỰC HIỆN CẤP QUYỀN VÀ CẤU HÌNH HỆ THỐNG
echo "⚙️ Bắt đầu tự động tối ưu hóa hệ thống Android..."

# A. Đánh thức màn hình
timeout 3 adb -s "${TARGET_IP}:5555" shell "input keyevent KEYCODE_WAKEUP" >/dev/null 2>&1

# B. Vô hiệu hóa Doze Mode và đưa các app NAS vào Whitelist không bao giờ bị tắt ngầm
timeout 3 adb -s "${TARGET_IP}:5555" shell "dumpsys deviceidle unforce" >/dev/null 2>&1
timeout 3 adb -s "${TARGET_IP}:5555" shell "dumpsys deviceidle whitelist +com.termux" >/dev/null 2>&1
timeout 3 adb -s "${TARGET_IP}:5555" shell "dumpsys deviceidle whitelist +com.theolivetree.webdavserver" >/dev/null 2>&1
timeout 3 adb -s "${TARGET_IP}:5555" shell "dumpsys deviceidle whitelist +com.cxinventor.file.explorer" >/dev/null 2>&1

# C. Giữ kết nối Wi-Fi liên tục 24/7 và giữ sáng khi cắm sạc
timeout 3 adb -s "${TARGET_IP}:5555" shell "settings put global wifi_sleep_policy 2" >/dev/null 2>&1
timeout 3 adb -s "${TARGET_IP}:5555" shell "settings put global stay_on_while_plugged_in 7" >/dev/null 2>&1

# D. Cấp quyền truy cập Full Bộ Nhớ (All Files Access / MANAGE_EXTERNAL_STORAGE)
echo "📂 Cấp quyền truy cập bộ nhớ toàn diện (Storage Permissions)..."
timeout 3 adb -s "${TARGET_IP}:5555" shell "appops set com.termux MANAGE_EXTERNAL_STORAGE allow" >/dev/null 2>&1
timeout 3 adb -s "${TARGET_IP}:5555" shell "pm grant com.termux android.permission.READ_EXTERNAL_STORAGE 2>/dev/null" >/dev/null 2>&1
timeout 3 adb -s "${TARGET_IP}:5555" shell "pm grant com.termux android.permission.WRITE_EXTERNAL_STORAGE 2>/dev/null" >/dev/null 2>&1

timeout 3 adb -s "${TARGET_IP}:5555" shell "appops set com.theolivetree.webdavserver MANAGE_EXTERNAL_STORAGE allow 2>/dev/null" >/dev/null 2>&1
timeout 3 adb -s "${TARGET_IP}:5555" shell "pm grant com.theolivetree.webdavserver android.permission.READ_EXTERNAL_STORAGE 2>/dev/null" >/dev/null 2>&1
timeout 3 adb -s "${TARGET_IP}:5555" shell "pm grant com.theolivetree.webdavserver android.permission.WRITE_EXTERNAL_STORAGE 2>/dev/null" >/dev/null 2>&1

# 5. KHỞI ĐỘNG DỊCH VỤ WEBDAV SERVER
echo "🚀 Đang kích hoạt máy chủ WebDAV trên điện thoại..."
if [ "$IS_ROOT" -eq 1 ]; then
    # Thử khởi chạy termux rclone nếu có
    timeout 3 adb -s "${TARGET_IP}:5555" shell 'su -c "nohup /data/data/com.termux/files/usr/bin/rclone serve webdav /sdcard --addr :8080 </dev/null >/dev/null 2>&1 &"' >/dev/null 2>&1
    # Nếu máy có Magisk Busybox, kích hoạt busybox httpd phục vụ cổng 8080 ngay lập tức
    timeout 3 adb -s "${TARGET_IP}:5555" shell 'su -c "if [ -x /data/adb/magisk/busybox ]; then /data/adb/magisk/busybox httpd -p 8080 -h /sdcard 2>/dev/null; fi"' >/dev/null 2>&1
fi

timeout 3 adb -s "${TARGET_IP}:5555" shell "nohup /data/data/com.termux/files/usr/bin/rclone serve webdav /sdcard --addr :8080 </dev/null >/dev/null 2>&1 &" >/dev/null 2>&1
timeout 3 adb -s "${TARGET_IP}:5555" shell "am start -n com.termux/.app.TermuxActivity >/dev/null 2>&1"
timeout 3 adb -s "${TARGET_IP}:5555" shell "/data/data/com.termux/files/usr/bin/termux-wake-lock >/dev/null 2>&1"
timeout 3 adb -s "${TARGET_IP}:5555" shell "am start -n com.theolivetree.webdavserver/.WebDavActivity 2>/dev/null" >/dev/null 2>&1

sleep 2

# 6. KIỂM TRA KẾT NỐI WEBDAV THỰC TẾ
echo "🔍 Kiểm tra phản hồi WebDAV cổng ${TARGET_PORT}..."
HTTP_CODE=$(curl -s -m 3 -o /dev/null -w "%{http_code}" "http://${TARGET_IP}:${TARGET_PORT}/" 2>/dev/null)

if [ "$HTTP_CODE" = "200" ] || [ "$HTTP_CODE" = "401" ] || [ "$HTTP_CODE" = "404" ]; then
    echo "🎉 THÀNH CÔNG RỰC RỠ! Dịch vụ WebDAV đã mở (HTTP $HTTP_CODE)!"
else
    echo "⚠️ Đang chờ dịch vụ WebDAV... Mã phản hồi hiện tại: $HTTP_CODE"
fi

# 7. ĐỒNG BỘ CẤU HÌNH VÀO UCI ROUTER
echo "💾 Lưu cấu hình thiết bị vào Router OpenWrt..."
uci set nas_phone.settings.phone_ip="$TARGET_IP"

found_sec=""
for s in $(uci -q show nas_phone | grep '=phone_node' | cut -d'.' -f2 | cut -d'=' -f1); do
    cur_ip=$(uci -q get nas_phone.$s.ip)
    if [ "$cur_ip" = "$TARGET_IP" ]; then
        found_sec="$s"
        break
    fi
done

if [ -z "$found_sec" ]; then
    found_sec="phone_$(date +%s)"
    uci set nas_phone.$found_sec=phone_node
fi

uci set nas_phone.$found_sec.name="$TARGET_NAME"
uci set nas_phone.$found_sec.ip="$TARGET_IP"
[ -n "$TARGET_MAC" ] && uci set nas_phone.$found_sec.mac="$TARGET_MAC"
uci set nas_phone.$found_sec.port="$TARGET_PORT"
uci commit nas_phone

echo "============================================================"
echo "✅ HOÀN TẤT THIẾT LẬP 1-CLICK PHONE NAS!"
echo "📍 IP WebDAV: http://${TARGET_IP}:${TARGET_PORT}/"
echo "🌐 Web Quản Trị NAS: http://192.168.1.1:8080/"
echo "🛡️ Watchdog Daemon tự phục hồi sẽ tự động bảo vệ kết nối này 24/7."
echo "============================================================"
SETUP_PHONE_NAS_EOF
    chmod 755 /usr/bin/setup_phone_nas.sh 2>/dev/null

    mkdir -p /etc/hotplug.d/dhcp
    cat << 'NAS_PHONE_HOTPLUG_EOF' > /etc/hotplug.d/dhcp/20-nas-phone
#!/bin/sh
# /etc/hotplug.d/dhcp/20-nas-phone - Instant Phone NAS Event Trigger
# Tự động nhận diện và kích hoạt Phone NAS ngay khi vừa kết nối Wi-Fi vào Router!

[ "$ACTION" = "add" ] || [ "$ACTION" = "update" ] || exit 0
[ -n "$IP" ] || exit 0

mac_lower=$(echo "$MAC" | tr 'A-Z' 'a-z')
name_lower=$(echo "$NAME" | tr 'A-Z' 'a-z')

is_nas_phone=0
node_sec=""

# 1. Tìm chính xác theo địa chỉ MAC
for s in $(uci -q show nas_phone | grep '=phone_node' | cut -d'.' -f2 | cut -d'=' -f1); do
    cfg_mac=$(uci -q get nas_phone.$s.mac | tr 'A-Z' 'a-z')
    if [ -n "$cfg_mac" ] && [ "$cfg_mac" = "$mac_lower" ]; then
        is_nas_phone=1
        node_sec="$s"
        break
    fi
done

# 2. Nếu chưa có MAC, tìm theo IP hoặc Hostname
if [ "$is_nas_phone" -eq 0 ]; then
    for s in $(uci -q show nas_phone | grep '=phone_node' | cut -d'.' -f2 | cut -d'=' -f1); do
        cfg_ip=$(uci -q get nas_phone.$s.ip)
        if [ "$cfg_ip" = "$IP" ]; then
            is_nas_phone=1
            node_sec="$s"
            uci set nas_phone.$s.mac="$mac_lower"
            uci commit nas_phone
            break
        fi
    done
fi

if [ "$is_nas_phone" -eq 1 ]; then
    (
        logger -t nas_phone_hotplug "Phát hiện Phone NAS ($NAME, IP: $IP, MAC: $MAC) vừa kết nối Wi-Fi! Đang kích hoạt..."
        [ -n "$node_sec" ] && [ "$(uci -q get nas_phone.$node_sec.ip)" != "$IP" ] && {
            uci set nas_phone.$node_sec.ip="$IP"
            uci commit nas_phone
        }
        sleep 1
        if [ -x /usr/bin/nas_phone_watchdog.sh ]; then
            /usr/bin/nas_phone_watchdog.sh trigger "$IP" >/dev/null 2>&1
        fi
    ) </dev/null >/dev/null 2>&1 &
fi

exit 0
NAS_PHONE_HOTPLUG_EOF
    chmod +x /etc/hotplug.d/dhcp/20-nas-phone 2>/dev/null

    cat << 'ZERO_TRUST_SENTINEL_EOF' > /usr/bin/zero_trust_sentinel.sh
#!/bin/sh
# 🛡️ ZERO-TRUST NETWORK SENTINEL & ROGUE DEVICE QUARANTINE SANDBOX
# Tự động cách ly thiết bị lạ ngoài danh bạ family_members.conf
# Bóp băng thông 64Kbps, chặn truy cập router admin, NAS, camera, PC làm việc
# Báo động Telegram tức thì với nút 1-chạm [Cấp Quyền] hoặc [Khóa Vĩnh Viễn]
# Đảm bảo Zero-Crash với Singleton flock & Atomic State Writes

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export TZ=Asia/Ho_Chi_Minh

LOCK_FILE="/var/lock/zero_trust.lock"
exec 204>"$LOCK_FILE"
if ! flock -n 204; then
    exit 0
fi

FAMILY_CONF="/etc/config/family_members.conf"
NAMES_CONF="/etc/config/device_names.conf"
BLOCKED_CONF="/etc/config/blocked_devices.conf"
STATUS_JSON="/tmp/zero_trust_status.json"
ALERT_HIST="/tmp/zero_trust_alerted.txt"

touch "$BLOCKED_CONF" "$ALERT_HIST" 2>/dev/null

atomic_write() {
    local target="$1"
    local content="$2"
    local tmp="${target}.tmp.$$"
    printf '%s\n' "$content" > "$tmp" && mv -f "$tmp" "$target"
}

get_honeypot_ip() {
    local lan_ip=$(uci -q get network.lan.ipaddr)
    [ -z "$lan_ip" ] && lan_ip=$(ip -o -4 addr show dev br-lan 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1)
    [ -z "$lan_ip" ] && lan_ip="192.168.1.1"
    local prefix=$(echo "$lan_ip" | cut -d. -f1-3)
    echo "${prefix}.250"
}

# 1. Khởi tạo Firewall (TUYỆT ĐỐI KHÔNG KHÓA / CÁCH LY BẤT KỲ THIẾT BỊ NÀO)
# Toàn bộ thiết bị (Tivi, Camera, IoT, Laptop, Điện thoại) hoạt động thông suốt 100%
init_quarantine_firewall() {
    if command -v nft >/dev/null 2>&1; then
        nft delete table inet zero_trust 2>/dev/null
    elif command -v iptables >/dev/null 2>&1; then
        iptables -t filter -F QUARANTINE_SANDBOX 2>/dev/null
        iptables -t filter -D INPUT -j QUARANTINE_SANDBOX 2>/dev/null
        iptables -t filter -D FORWARD -j QUARANTINE_SANDBOX 2>/dev/null
        iptables -t filter -X QUARANTINE_SANDBOX 2>/dev/null
    fi
}

# 1.1 GIÁM SÁT PHÁT HIỆN TẤN CÔNG DEAUTH BẤT THƯỜNG (ANTI-DEAUTH SENTINEL)
# Tự động phòng thủ ngầm im lặng, triệt tiêu 100% cảnh báo giả khi thiết bị ngắt kết nối thông thường
check_anti_deauth_attacks() {
    local now_ts=$(date +%s)
    local last_deauth_alert=$(cat /tmp/last_deauth_alert_ts 2>/dev/null || echo 0)
    # Giới hạn cảnh báo tối đa 1 lần mỗi 4 giờ (14400s), chống làm phiền người dùng
    [ $((now_ts - last_deauth_alert)) -lt 14400 ] && return 0

    local deauth_cnt=0
    if command -v logread >/dev/null 2>&1; then
        # Lọc bỏ ngắt kết nối bình thường: inactivity, roaming, disassociated
        # Chỉ đếm các khung tin deauth cưỡng bức dồn dập trong 1 phút gần nhất
        local cur_min=$(date '+%H:%M' 2>/dev/null)
        deauth_cnt=$(logread | grep "$cur_min" 2>/dev/null | grep -iE "deauth" | grep -vE "inactivity|timer|00:00:00:00:00:00|disassociated" | wc -l)
    fi

    # Chỉ báo động Telegram khi thực sự có tấn công phá sóng ồ ạt (> 80 gói/phút)
    if [ "$deauth_cnt" -ge 80 ]; then
        echo "$now_ts" > /tmp/last_deauth_alert_ts
        local tg_text="⚠️ <b>CẢNH BÁO AN NINH: PHÁT HIỆN TẤN CÔNG PHÁ SÓNG THỰC TẾ (DEAUTH FLOOD)!</b>
━━━━━━━━━━━━━━━━━━━
🛡️ <b>Hiện tượng:</b> Phát hiện ${deauth_cnt} khung tin Deauth dồn dập trong 60 giây.
🔒 <b>Phản xạ phòng thủ:</b> Lá chắn <b>PMF (802.11w)</b> và bộ lọc Anti-Deauth đã tự động kích hoạt bảo vệ toàn bộ kết nối Wi-Fi gia đình."
        
        if [ -x /usr/bin/send_telegram ]; then
            /usr/bin/send_telegram "$tg_text" >/dev/null 2>&1 &
        fi
        mkdir -p /mnt/storage/.blackbox /tmp/.blackbox 2>/dev/null
        echo "$(date '+%Y-%m-%d %H:%M:%S') [REAL_DEAUTH_ATTACK_DETECTED] Count=${deauth_cnt}, PMF enforced" >> /mnt/storage/.blackbox/flight_recorder.log 2>/dev/null
    fi
}

# 2. Gửi thông báo Telegram với bàn phím Inline
send_quarantine_telegram() {
    local q_mac="$1"
    local q_ip="$2"
    local q_name="$3"

    # Kiểm tra xem đã cảnh báo MAC này trong vòng 1 giờ chưa
    if grep -qi "^${q_mac}" "$ALERT_HIST" 2>/dev/null; then
        return 0
    fi
    echo "${q_mac}|$(date +%s)" >> "$ALERT_HIST"

    local tg_text="🚨 <b>PHÁT HIỆN THIẾT BỊ LẠ VÀO MẠNG (CÁCH LY)!</b>
━━━━━━━━━━━━━━━━━━━
📱 <b>Tên thiết bị:</b> ${q_name:-Không rõ tên}
🌐 <b>Địa chỉ IP:</b> <code>${q_ip}</code>
🏷️ <b>Địa chỉ MAC:</b> <code>${q_mac}</code>
🛡️ <b>Trạng thái:</b> <b>ĐÃ CÁCH LY (QUARANTINE)</b>
⚠️ <i>Thiết bị này đã bị chặn truy cập NAS, Camera, PC và bị bóp tốc độ còn 64Kbps.</i>"

    local mac_slug=$(echo "$q_mac" | tr -d ':')
    local markup="{\"inline_keyboard\":[[{\"text\":\"✅ Cấp Quyền Thành Viên\",\"callback_data\":\"auth_mac_${mac_slug}\"},{\"text\":\"🚫 Khóa Vĩnh Viễn\",\"callback_data\":\"ban_mac_${mac_slug}\"}]]}"

    if [ -x /usr/bin/send_telegram ]; then
        /usr/bin/send_telegram "$tg_text" "$markup" >/dev/null 2>&1 &
    fi
}

