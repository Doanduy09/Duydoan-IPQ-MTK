                E('span', { id: 'game-garena-badge', style: 'padding: 3px 10px; border-radius: 6px; font-weight: 700; font-size: 13px; background: #ffffff; color: #000000; border: 1px solid #bfdbfe;' }, '🎮 Garena: ' + garenaPing + ' ms'),
                E('span', { id: 'game-riot-badge', style: 'padding: 3px 10px; border-radius: 6px; font-weight: 700; font-size: 13px; background: #ffffff; color: #000000; border: 1px solid #fbcfe8;' }, '⚔️ Riot: ' + riotPing + ' ms'),
                E('span', { id: 'game-cdn-badge', style: 'padding: 3px 10px; border-radius: 6px; font-weight: 700; font-size: 13px; background: #ffffff; color: #000000; border: 1px solid #e2e8f0;' }, '☁️ CDN Web: ' + cdnPing + ' ms'),
                E('span', { id: 'game-viettel-badge', style: 'padding: 3px 10px; border-radius: 6px; font-weight: 700; font-size: 13px; background: #ffffff; color: #000000; border: 1px solid #bbf7d0;' }, '🚀 Viettel: ' + viettelPing + ' ms')
            ]),
            E('div', { style: 'display: flex; align-items: center; gap: 8px; flex-wrap: wrap;' }, [
                E('span', { style: 'font-size: 12px; font-weight: 700; color: #000000;' }, '🎮 Tối ưu Game & Video:'),
                E('div', { id: 'active-gamers-list', style: 'display: flex; gap: 6px; align-items: center; flex-wrap: wrap;' }, gamerTags)
