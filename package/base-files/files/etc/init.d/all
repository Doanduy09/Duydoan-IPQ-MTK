local params = q or {}
local post_data = {}

if action == "save_gdrive_token" then
    print("Content-Type: application/json; charset=utf-8\r\n\r")
    local token_val = post_data and post_data.token or params.token or ""
    local email_val = post_data and post_data.email or params.email or ""
    if token_val == "" then
        print('{"success":false,"message":"Thiáº¿u dá»¯ liá»‡u Token!"}')
        return
    end
    local clean_email = email_val ~= "" and email_val or "gdrive_account"
    local cid = "cloud_" .. clean_email:gsub("[^a-zA-Z0-9_]", "_")
    local t_path = "/mnt/storage/airdrop/Cloud_Sync/Google_Drive"
    os.execute("mkdir -p /root/.config/rclone /mnt/storage/.rclone_cache " .. t_path)
    local conf_entry = string.format("\n[%s]\ntype = drive\nscope = drive\ntoken = %s\n\n[gdrive]\ntype = drive\nscope = drive\ntoken = %s\n", cid, token_val, token_val)
    local f = io.open("/root/.config/rclone/rclone.conf", "a+")
    if f then
        f:write(conf_entry)
        f:close()
    end
    os.execute(string.format("uci -q set nas_phone.%s=cloud; uci -q set nas_phone.%s.service='gdrive'; uci -q set nas_phone.%s.name='Google Drive'; uci -q set nas_phone.%s.email='%s'; uci -q set nas_phone.%s.subfolder='Cloud_Sync/Google_Drive'; uci -q set nas_phone.%s.sync_mode='2way'; uci commit nas_phone", cid, cid, cid, clean_email, cid, cid))
    print('{"success":true,"message":"ÄÃ£ liÃªn káº¿t thÃ nh cÃ´ng tÃ i khoáº£n Google Drive vÃ o Router NAS!"}')
    return
end

-- ==============================================================================
-- ðŸ“± KÃCH HOáº T GOOGLE DRIVE TRá»°C TIáº¾P TRÃŠN WEB / ÄIá»†N THOáº I (KHÃ”NG Cáº¦N PC)
-- ==============================================================================
if action == "start_gdrive_auth" then
    print("Content-Type: application/json; charset=utf-8\r\nCache-Control: no-cache\r\n\r\n")
    os.execute("mkdir -p /root/.config/rclone /mnt/storage/.rclone_cache")
    os.execute("killall -9 rclone 2>/dev/null; rm -f /tmp/rclone_auth.log; sleep 0.4")
    os.execute("nohup /usr/bin/rclone authorize 'drive' --auth-no-open-browser --config /root/.config/rclone/rclone.conf > /tmp/rclone_auth.log 2>&1 &")
    
    local state = ""
    for _ = 1, 25 do
        os.execute("sleep 0.25")
        local f = io.open("/tmp/rclone_auth.log", "r")
        if f then
            local txt = f:read("*all") or ""
            f:close()
            state = txt:match("state=([%w%-_]+)")
            if state and state ~= "" then break end
        end
    end

    if not state or state == "" then
        print('{"success":false,"message":"KhÃ´ng thá»ƒ khá»Ÿi táº¡o phiÃªn xÃ¡c thá»±c rclone trÃªn Router!"}')
        return
    end

    local p = io.popen("curl -s -i 'http://127.0.0.1:53682/auth?state=" .. state .. "' 2>/dev/null")
    local resp = p and p:read("*all") or ""
    if p then p:close() end
    
    local auth_url = resp:match("[Ll]ocation:%s*(https://[^\r\n]+)")
    if not auth_url or auth_url == "" then
        auth_url = "https://accounts.google.com/o/oauth2/auth?access_type=offline&client_id=202264815644-rt1o1c9evjaotbpbab10m83i8cnjk077.apps.googleusercontent.com&redirect_uri=http%3A%2F%2F127.0.0.1%3A53682%2F&response_type=code&scope=https%3A%2F%2Fwww.googleapis.com%2Fauth%2Fdrive&state=" .. state
    end

    print(string.format('{"success":true,"state":"%s","auth_url":"%s"}', state, auth_url:gsub('"', '\\"')))
    return
end

if action == "finish_gdrive_auth" then
    local raw_input = params.code or q.code or ""
    local email_val = params.email or q.email or ""
    local state_val = params.state or q.state or ""

    if raw_input == "" then
        print("Content-Type: application/json; charset=utf-8\r\nCache-Control: no-cache\r\n\r\n{\"success\":false,\"message\":\"Vui lÃ²ng nháº­p Ä‘Æ°á»ng link hoáº·c mÃ£ Code nháº­n Ä‘Æ°á»£c tá»« Google!\"}")
        return
    end

    local function urldecode(s)
        s = s:gsub("+", " ")
        s = s:gsub("%%(%x%x)", function(h) return string.char(tonumber(h, 16)) end)
        return s
    end

    local token_json = raw_input:match('(%{.-"access_token".-"refresh_token".-%})') or raw_input:match('(%{.-"token".-%})')

    if not token_json or token_json == "" then
        local decoded_input = urldecode(raw_input)
        local code = raw_input:match("code=([^&%s]+)") or decoded_input:match("code=([^&%s]+)") or raw_input:match("(4/[%w%-_]+)") or decoded_input:match("(4/[%w%-_]+)") or raw_input
        local state = raw_input:match("state=([^&%s]+)") or decoded_input:match("state=([^&%s]+)") or state_val

        if not code or code == "" then
            print("Content-Type: application/json; charset=utf-8\r\nCache-Control: no-cache\r\n\r\n{\"success\":false,\"message\":\"KhÃ´ng tÃ¬m tháº¥y mÃ£ Code OAuth há»£p lá»‡ trong ná»™i dung báº¡n dÃ¡n!\"}")
            return
        end

        local qs = raw_input:match("%?([^\r\n%s]+)") or decoded_input:match("%?([^\r\n%s]+)")
        if qs and qs ~= "" then
            os.execute("curl -s -m 5 'http://127.0.0.1:53682/?" .. qs .. "' >/dev/null 2>&1 &")
        end
        local query = "http://127.0.0.1:53682/?state=" .. (state or "") .. "&code=" .. code
        os.execute("curl -s -m 5 '" .. query .. "' >/dev/null 2>&1 &")

        for _ = 1, 50 do
            os.execute("sleep 0.5")
            local f = io.open("/tmp/rclone_auth.log", "r")
            if f then
                local content = f:read("*all") or ""
                f:close()
                local t = content:match('(%{.-"access_token".-"refresh_token".-%})')
                if t then
                    token_json = t
                    break
                end
            end
        end
    end

    if not token_json or token_json == "" then
        print("Content-Type: application/json; charset=utf-8\r\nCache-Control: no-cache\r\n\r\n{\"success\":false,\"message\":\"Háº¿t thá»i gian chá» Google cáº¥p Token hoáº·c mÃ£ Code khÃ´ng Ä‘Ãºng. Vui lÃ²ng thá»­ láº¡i!\"}")
        return
    end

    local clean_email = email_val ~= "" and email_val or "gdrive_account"
    local cid = "cloud_" .. clean_email:gsub("[^a-zA-Z0-9_]", "_")
    local t_path = "/mnt/storage/airdrop/Cloud_Sync/" .. clean_email:gsub("[^a-zA-Z0-9_]", "_")
    os.execute("mkdir -p /root/.config/rclone /mnt/storage/.rclone_cache " .. t_path)

    local rclone_conf_path = "/root/.config/rclone/rclone.conf"
    local conf_content = ""
    local rf = io.open(rclone_conf_path, "r")
    if rf then
        conf_content = rf:read("*all") or ""
        rf:close()
    end
    conf_content = conf_content:gsub("%[" .. cid .. "%][^%[]*", "")
    conf_content = conf_content:gsub("%[gdrive%][^%[]*", "")
    conf_content = conf_content:gsub("%s+$", "")
    
    local new_sections = string.format("\n\n[%s]\ntype = drive\nscope = drive\ntoken = %s\n\n[gdrive]\ntype = drive\nscope = drive\ntoken = %s\n", cid, token_json, token_json)
    conf_content = conf_content .. new_sections
    
    local wf = io.open(rclone_conf_path, "w")
    if wf then
        wf:write(conf_content)
        wf:close()
    end

    os.execute(string.format("touch /etc/config/nas_phone && uci -q set nas_phone.settings=settings && uci -q set nas_phone.%s=cloud_account; uci -q set nas_phone.%s.service='gdrive'; uci -q set nas_phone.%s.name='Google Drive (%s)'; uci -q set nas_phone.%s.email='%s'; uci -q set nas_phone.%s.subfolder='Cloud_Sync/%s'; uci -q set nas_phone.%s.sync_mode='2way'; uci -q set nas_phone.settings.gdrive_acc='%s'; uci commit nas_phone", cid, cid, cid, clean_email, cid, clean_email, cid, clean_email:gsub("[^a-zA-Z0-9_]", "_"), cid, clean_email))

    os.execute("killall -9 rclone 2>/dev/null")
    -- Tá»± Ä‘á»™ng kÃ­ch hoáº¡t Ä‘á»“ng bá»™ 2 chiá»u ngay láº­p tá»©c sau khi xÃ¡c thá»±c thÃ nh cÃ´ng
    os.execute(string.format("/bin/sh -c 'curl -s \"http://127.0.0.1:8080/cgi-bin/airdrop?action=sync_cloud&id=%s\" >/dev/null 2>&1' &", cid))
    print("Content-Type: application/json; charset=utf-8\r\nCache-Control: no-cache\r\n\r\n{\"success\":true,\"message\":\"KÃ­ch hoáº¡t vÃ  liÃªn káº¿t thÃ nh cÃ´ng Google Drive vÃ o Router! Äang Ä‘á»“ng bá»™ tá»‡p tin...\"}")
    return
end

-- ==============================================================================
-- ðŸ“± REMOTE PHONE SCREEN STREAMING & VIRTUAL ACTION ENGINE
-- ==============================================================================
if action == "phone_screen" then
    local p_ip = (params.ip or q.ip or ""):gsub("[^0-9.]", "")
    if p_ip == "" then
        print("Status: 400 Bad Request\r\nContent-Type: text/plain\r\n\r\nInvalid IP")
        return
    end
    print("Content-Type: image/png\r\nCache-Control: no-cache, no-store\r\n")
    local p = io.popen("timeout 2 adb -s '" .. p_ip .. ":5555' exec-out screencap -p 2>/dev/null || timeout 2 adb exec-out screencap -p 2>/dev/null")
    if p then
        local found_png = false
        while true do
            local chunk = p:read(16384)
            if not chunk or #chunk == 0 then break end
            if not found_png then
                local s = chunk:find("\137PNG")
                if s then
                    chunk = chunk:sub(s)
                    found_png = true
                end
            end
            if found_png then
                io.write(chunk)
            end
        end
        p:close()
    end
    return
end

if action == "phone_action" then
