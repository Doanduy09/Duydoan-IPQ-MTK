                    <img id="phoneRemoteScreenImg" src="" alt="Màn hình điện thoại" style="max-width:100%; max-height:440px; display:block; margin:0 auto; object-fit:contain;">
                </div>
                <div style="display:flex; gap:8px; justify-content:center; flex-wrap:wrap; margin-bottom:10px;">
                    <button class="btn-sub" style="padding:6px 12px; font-size:0.78rem;" onclick="refreshPhoneScreen()">🔄 Chụp Lại</button>
                    <button class="btn-sub" style="padding:6px 12px; font-size:0.78rem; border-color:#facc15; color:#facc15;" onclick="sendPhoneAction('wake')">🔆 Bật Màn Hình</button>
                    <button class="btn-sub" style="padding:6px 12px; font-size:0.78rem; border-color:#000000; color:#94a3b8;" onclick="sendPhoneAction('sleep')">🌙 Tắt Màn Hình</button>
                    <button class="btn-sub" style="padding:6px 12px; font-size:0.78rem; border-color:var(--primary-neon); color:var(--primary-neon);" onclick="sendPhoneAction('restart_webdav')">🚀 Kích WebDAV</button>
                    <button class="btn-sub" style="padding:6px 12px; font-size:0.78rem; border-color:#4ade80; color:#4ade80;" onclick="sendPhoneAction('protect_battery_on')">🔋 Pin 85%</button>
                    <button class="btn-sub" style="padding:6px 12px; font-size:0.78rem; border-color:#94a3b8; color:#cbd5e1;" onclick="sendPhoneAction('protect_battery_off')">⚡ Sạc 100%</button>
                </div>
                <div id="phoneRemoteStatusMsg" style="font-size:0.75rem; color:var(--text-sub); font-family:monospace;">Sẵn sàng điều khiển qua ADB không dây</div>
            </div>
            <div class="modal-footer">
                <button class="btn-sub" onclick="closeModal('phoneRemoteModal')">Đóng</button>
