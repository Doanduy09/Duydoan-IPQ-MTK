        window.meshSyncWifi = function() {
            if (!confirm('Xác nhận đồng bộ toàn bộ tên Wi-Fi (SSID), mật khẩu và chuẩn Roaming 802.11r từ Router Chính sang tất cả Router Phụ?')) return;
            ui.addNotification(null, E('p', '⏳ Đang gửi lệnh đồng bộ Wi-Fi sang Router phụ...'), 'info');
            fetch('/cgi-bin/airdrop?action=mesh_sync_wifi')
                .then(function(r) { return r.json(); })
                .then(function(res) {
                    if (res.status === 'success') {
                        ui.addNotification(null, E('p', '✅ ' + (res.message || 'Đã đồng bộ Wi-Fi thành công!')), 'info');
                    } else {
                        ui.addNotification(null, E('p', '❌ ' + (res.message || 'Lỗi đồng bộ')), 'error');
                    }
                    refreshMeshStatus(true);
                }).catch(function(err) {
                    ui.addNotification(null, E('p', '❌ Lỗi kết nối: ' + err), 'error');
                });
        };

        window.openNodeWifiModal = function(nodeIp) {
