    cat << 'SMS_GUARDIAN_EOF' > /usr/bin/sms_security_guardian
#!/bin/sh
# ==============================================================================
# MODULE 05: SMS SECURITY GUARDIAN & VIP SIM WHITELIST ENGINE
# - Bảo vệ 3 SIM VIP mặc định chính chủ:
#     1) 89840480009484443869
#     2) 89840480009578677539
#     3) 89840480009579026074
# - Khóa ngay lập tức (LOCKED, epoch = 0) nếu lắp SIM lạ
# - Chặn gửi SMS gia hạn cước trái phép, bảo vệ số dư tài khoản
# ==============================================================================

DEFAULT_VIP_ICCIDS="89840480009484443869 89840480009578677539 89840480009579026074"
ALLOWED_FILE="/etc/config/allowed_iccids.dat"
CURRENT_ICCID_FILE="/tmp/sms_current_iccid"
STATUS_FILE="/tmp/master_sim_status"
WAKE_FILE="/tmp/sms_next_wake_epoch"
NEXT_SEND_FILE="/tmp/sms_next_send_epoch"
CUSTOM_EPOCH_TMP="/tmp/sms_custom_send_epoch"
CUSTOM_EPOCH_CONF="/etc/config/sms_custom_send_epoch"

get_current_iccid() {
    local cur=""
    [ -f "$CURRENT_ICCID_FILE" ] && cur=$(cat "$CURRENT_ICCID_FILE" 2>/dev/null | tr -d '\r\n[:space:]')
    if [ -z "$cur" ] && [ -f "/etc/config/last_known_iccid" ]; then
        cur=$(cat /etc/config/last_known_iccid 2>/dev/null | tr -d '\r\n[:space:]')
    fi
    echo "$cur"
}

is_iccid_allowed() {
    local target="$1"
    [ -z "$target" ] && return 1

    # 1. Kiểm tra 3 SIM VIP mặc định
    for vip in $DEFAULT_VIP_ICCIDS; do
        [ "$target" = "$vip" ] && return 0
    done

    # 2. Kiểm tra danh sách whitelist cấu hình lưu trữ
    if [ -f "$ALLOWED_FILE" ]; then
        for allowed in $(cat "$ALLOWED_FILE" 2>/dev/null); do
            clean=$(echo "$allowed" | tr -d '\r\n[:space:]')
            [ "$target" = "$clean" ] && return 0
        done
    fi

    return 1
}

enforce_lock() {
    echo "LOCKED" > "$STATUS_FILE"
    echo "0" > "$WAKE_FILE"
    echo "0" > "$NEXT_SEND_FILE"
    rm -f "$CUSTOM_EPOCH_TMP" "$CUSTOM_EPOCH_CONF" /etc/sms_custom_send_epoch 2>/dev/null
    logger -t sms_guardian "🔒 ĐÃ KHÓA LỊCH GỬI SMS: SIM hiện tại không nằm trong danh mục VIP cho phép!"
}

enforce_valid() {
    echo "VALID" > "$STATUS_FILE"
    logger -t sms_guardian "✅ XÁC THỰC SIM VIP THÀNH CÔNG: Mở quyền lịch gửi SMS và gia hạn cước."
}

check_and_enforce() {
    local cur=$(get_current_iccid)
    if is_iccid_allowed "$cur"; then
        enforce_valid
        return 0
    else
        enforce_lock
        return 1
    fi
}

cmd_status() {
    local cur=$(get_current_iccid)
    local st="LOCKED"
    [ -f "$STATUS_FILE" ] && st=$(cat "$STATUS_FILE" 2>/dev/null | tr -d '\r\n[:space:]')
    local is_auth=0
    [ "$st" = "VALID" ] && is_auth=1

    cat <<EOF
{
  "status": "success",
  "iccid": "$cur",
  "sim_status": "$st",
  "is_authenticated": $is_auth,
  "vip_defaults": "$DEFAULT_VIP_ICCIDS"
}
EOF
}

cmd_add_iccid() {
    local new_iccid="$1"
    [ -z "$new_iccid" ] && echo "{\"status\":\"error\",\"message\":\"Thiếu ICCID cần thêm\"}" && return 1
    mkdir -p /etc/config
    touch "$ALLOWED_FILE"
    if ! grep -q "$new_iccid" "$ALLOWED_FILE" 2>/dev/null; then
        echo "$new_iccid" >> "$ALLOWED_FILE"
        sync
    fi
    check_and_enforce
    echo "{\"status\":\"success\",\"message\":\"Đã thêm ICCID $new_iccid vào danh sách cho phép!\"}"
}

cmd_del_iccid() {
    local del_iccid="$1"
    [ -z "$del_iccid" ] && echo "{\"status\":\"error\",\"message\":\"Thiếu ICCID cần xóa\"}" && return 1
    if [ -f "$ALLOWED_FILE" ]; then
        sed -i "/$del_iccid/d" "$ALLOWED_FILE" 2>/dev/null
        sync
    fi
    check_and_enforce
    echo "{\"status\":\"success\",\"message\":\"Đã xóa ICCID $del_iccid khỏi danh sách cho phép!\"}"
}

case "$1" in
    status)
        cmd_status
        ;;
    check|verify)
        check_and_enforce
        ;;
    lock)
        enforce_lock
        echo "{\"status\":\"locked\",\"message\":\"Đã khóa lịch gửi SMS thành công!\"}"
        ;;
    add)
        cmd_add_iccid "$2"
        ;;
    del|remove)
        cmd_del_iccid "$2"
        ;;
    *)
        check_and_enforce
        ;;
esac
SMS_GUARDIAN_EOF
    chmod +x /usr/bin/sms_security_guardian
    /usr/bin/sms_security_guardian check >/dev/null 2>&1

    # Gemini Live Web App & API endpoint
