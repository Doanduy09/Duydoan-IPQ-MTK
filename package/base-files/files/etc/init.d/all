        var dropNoticePath = E('span', { style: 'color: #000000; font-weight: 700;' }, currentBrowseDir);

        function loadDirectory(dirPath) {
            currentBrowseDir = dirPath.replace(/\/+$/, '') || '/';
            pathDisplayBadge.textContent = currentBrowseDir;
            if (dropNoticePath) dropNoticePath.textContent = currentBrowseDir;
            fileListTableBody.innerHTML = '<tr><td colspan="4" style="text-align: center; padding: 15px; color: #000000;">⏳ Đang đọc danh sách file...</td></tr>';
            fetch('/cgi-bin/custom_file_manager?action=list&dir=' + encodeURIComponent(currentBrowseDir)).then(function(r) { return r.json(); }).then(function(d) {
                fileListTableBody.innerHTML = '';
                (d.items || []).forEach(function(it) {
                    var isDir = it.type === 'dir';
                    var nameEl = E('span', { style: 'cursor: pointer; font-weight: 700; color: #000000;', click: function() { if (isDir) loadDirectory((currentBrowseDir === '/' ? '' : currentBrowseDir) + '/' + it.name); } }, [ (isDir ? '📁 ' : '📄 ') + it.name ]);
                    var actionBtns = [];
                    if (!isDir) {
                        actionBtns.push(E('a', { class: 'btn cbi-button cbi-button-action', href: '/cgi-bin/custom_file_manager?action=download&dir=' + encodeURIComponent(currentBrowseDir) + '&name=' + encodeURIComponent(it.name), target: '_blank', download: it.name, style: 'padding: 2px 8px; font-size: 11px; margin-right: 4px; text-decoration: none;' }, '📥'));
                    }
                    actionBtns.push(E('button', { class: 'btn cbi-button cbi-button-remove', style: 'padding: 2px 8px; font-size: 11px;', click: function(ev) { ev.stopPropagation(); if (!confirm('Xóa file: ' + it.name + ' ?')) return; fetch('/cgi-bin/custom_file_manager?action=delete&dir=' + encodeURIComponent(currentBrowseDir) + '&name=' + encodeURIComponent(it.name)).then(function() { loadDirectory(currentBrowseDir); }); } }, '🗑️'));
                    fileListTableBody.appendChild(E('tr', { class: 'tr' }, [ E('td', { class: 'td left', style: 'padding: 8px 12px;' }, nameEl), E('td', { class: 'td left', style: 'padding: 8px 12px; font-size: 12px;' }, isDir ? 'Thư mục' : it.size), E('td', { class: 'td left', style: 'padding: 8px 12px; font-size: 12px;' }, it.date), E('td', { class: 'td center', style: 'padding: 8px 12px;' }, actionBtns) ]));
                });
            });
        }

