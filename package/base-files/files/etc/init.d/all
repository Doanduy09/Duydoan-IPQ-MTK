    cat << 'RPCD_EOF' > /usr/libexec/rpcd/luci.weather-status
#!/bin/sh
input=""
read -r -t 1 input 2>/dev/null || [ -n "$input" ] || input=""
LOCK_DIR="/tmp/at_atomic_lock.d"

safe_at_cleanup() {
    killall -CONT ModemManager modemmanager 2>/dev/null
    rm -f /tmp/sms_sending.lock 2>/dev/null
    flock -u 200 2>/dev/null
    exec 200>&- 2>/dev/null
    rmdir "$LOCK_DIR" 2>/dev/null
}

acquire_lock_safe() {
    local count=0
    while ! mkdir "$LOCK_DIR" 2>/dev/null; do
        usleep 100000
        count=$((count + 1))
        if [ "$count" -ge 40 ]; then
            rm -rf "$LOCK_DIR" 2>/dev/null
            mkdir "$LOCK_DIR" 2>/dev/null && break
        fi
    done
    mkdir -p /var/lock 2>/dev/null
    exec 200>/var/lock/modem_at.lock
    flock -w 5 200 2>/dev/null
}

release_lock_safe() {
    flock -u 200 2>/dev/null
    exec 200>&- 2>/dev/null
    rmdir "$LOCK_DIR" 2>/dev/null
}

encode_sierra_imei() {
    local imei="$1"
    [ ${#imei} -eq 15 ] && imei="${imei}0"
    local c1=$(echo "$imei" | cut -c1) c2=$(echo "$imei" | cut -c2)
    local c3=$(echo "$imei" | cut -c3) c4=$(echo "$imei" | cut -c4)
    local c5=$(echo "$imei" | cut -c5) c6=$(echo "$imei" | cut -c6)
    local c7=$(echo "$imei" | cut -c7) c8=$(echo "$imei" | cut -c8)
    local c9=$(echo "$imei" | cut -c9) c10=$(echo "$imei" | cut -c10)
    local c11=$(echo "$imei" | cut -c11) c12=$(echo "$imei" | cut -c12)
    local c13=$(echo "$imei" | cut -c13) c14=$(echo "$imei" | cut -c14)
    local c15=$(echo "$imei" | cut -c15) c16=$(echo "$imei" | cut -c16)
    echo "0${c1},${c3}${c2},${c5}${c4},${c7}${c6},${c9}${c8},${c11}${c10},${c13}${c12},${c15}${c14}"
}

get_modem_imei() {
    local p="$1"
    [ ! -c "$p" ] && return 1
    local r=""
    if command -v atinout >/dev/null 2>&1; then
        r=$(timeout 2 sh -c "echo -e 'AT+CGSN\r' | atinout - $p -" 2>/dev/null)
        [ -z "$r" ] && r=$(timeout 2 sh -c "echo -e 'ATI\r' | atinout - $p -" 2>/dev/null)
    fi
    echo "$r" | grep -oE '[0-9]{15}' | head -n1
}

case "$1" in
    list) echo '{"getWeather":{},"getFastStats":{},"getRFSignal":{},"getGameLatencyStatus":{},"getSQMStatus":{},"toggleSQM":{"action":"string"},"getP2PCameraStatus":{},"toggleP2PCamera":{"action":"string"},"refreshAllData":{},"searchLocation":{"query":"string"},"setLocation":{"name":"string","lat":"string","lon":"string"},"setTTL":{"ttl":"number"},"getWifi":{},"setWifi":{"s5g":"string","p5g":"string","w5g":"string","s2g":"string","p2g":"string","w2g":"string","s5g2":"string","p5g2":"string","w5g2":"string"},"setCardMode":{"mode":"string","iface_name":"string"},"changeIMEI":{"imei":"string","brand":"string"},"getLanIP":{},"setLanIP":{"ip":"string"},"poweroff":{},"reboot":{},"healData":{},"restartWWAN":{},"getCloudConfig":{},"setTailscaleConfig":{"ip":"string","subnet":"string","hostname":"string"},"setGeminiKey":{"key":"string"},"setTelegramToken":{"token":"string","admin_id":"string","owner_name":"string"},"toggleGameMode":{"action":"string"},"getMWAN3Status":{},"toggleMWAN3":{"action":"string"},"getAdShield":{},"setAdShield":{"action":"string"},"getNASConfig":{},"setNASConfig":{"phone_ip":"string","phone_port":"string","phone_proto":"string","phone_folder":"string","phone_user":"string","phone_pass":"string","gdrive_acc":"string","onedrive_acc":"string","sync_mode":"string"},"addPhoneNode":{"name":"string","ip":"string","proto":"string","port":"string","router_port":"string","folder":"string","user":"string","pass":"string"},"deletePhoneNode":{"id":"string"},"addCloudAccount":{"service":"string","name":"string","email":"string","target_phone":"string","subfolder":"string","sync_mode":"string"},"deleteCloudAccount":{"id":"string"},"syncGoogleDrive":{},"getGoogleDriveStatus":{},"autoSetupNAS":{"target_ip":"string"},"triggerFindPhone":{},"triggerWOL":{"mac":"string"},"toggleAllScript":{"action":"string"},"getAllScriptStatus":{},"toggleHNAT":{"action":"string"}}' ;;
    call)
        case "$2" in
            toggleHNAT)
                act=$(echo "$input" | jsonfilter -e '$.action' 2>/dev/null || echo "on")
                if [ "$act" = "off" ] || [ "$act" = "0" ] || [ "$act" = "disable" ]; then
                    touch /etc/config/hnat_disabled
                    uci -q set firewall.@defaults[0].flow_offloading='0'
                    uci -q set firewall.@defaults[0].flow_offloading_hw='0'
                    uci commit firewall 2>/dev/null
                    for wed_p in /sys/module/mt76/parameters/wed_offload /sys/module/mt7915e/parameters/wed_offload; do
                        [ -w "$wed_p" ] && echo 0 > "$wed_p" 2>/dev/null
                    done
                    ( /etc/init.d/firewall reload >/dev/null 2>&1; [ -x /usr/bin/fast_stats_fetcher.sh ] && /usr/bin/fast_stats_fetcher.sh >/dev/null 2>&1 ) &
                    printf '{"success":true,"hnat_enabled":0,"message":"🛑 Đã TẮT MediaTek PPE HNAT (Chế độ CPU thuần / Tương thích 100%% VPN, PassWall & QoS)"}\n'
                else
                    rm -f /etc/config/hnat_disabled
                    uci -q set firewall.@defaults[0].flow_offloading='1'
                    uci -q set firewall.@defaults[0].flow_offloading_hw='1'
                    uci commit firewall 2>/dev/null
                    for wed_p in /sys/module/mt76/parameters/wed_offload /sys/module/mt7915e/parameters/wed_offload; do
                        [ -w "$wed_p" ] && echo 1 > "$wed_p" 2>/dev/null
                    done
                    ( /etc/init.d/firewall reload >/dev/null 2>&1; [ -x /usr/bin/fast_stats_fetcher.sh ] && /usr/bin/fast_stats_fetcher.sh >/dev/null 2>&1 ) &
                    printf '{"success":true,"hnat_enabled":1,"message":"⚡ Đã BẬT MediaTek PPE Hardware NAT + WED Turbo!"}\n'
                fi
                ;;
            toggleAllScript)
                act=$(echo "$input" | jsonfilter -e '$.action' 2>/dev/null || echo "off")
                if [ "$act" = "off" ] || [ "$act" = "disable" ]; then
                    (/usr/bin/all off >/dev/null 2>&1) &
                    printf '{"success":true,"action":"off","message":"Da tat toan bo Script ALL va khoi phuc giao dien Argon mac dinh."}\n'
                else
                    (/usr/bin/all on >/dev/null 2>&1) &
                    printf '{"success":true,"action":"on","message":"Da bat lai toan bo Script ALL."}\n'
                fi
                ;;
            getAllScriptStatus)
                if [ -f /etc/config/all_disabled ]; then
                    printf '{"enabled":false,"status":"disabled","message":"Theme Argon Mac Dinh"}\n'
                else
                    printf '{"enabled":true,"status":"enabled","message":"Giao dien Master Chuyen Sau"}\n'
                fi
                ;;
            getGameLatencyStatus)
                now_ts=$(date +%s)
                f_ts=$(cat /tmp/game_realtime_status.json 2>/dev/null | jsonfilter -e '$.timestamp' 2>/dev/null || echo 0)
                if [ $((now_ts - f_ts)) -gt 60 ] && [ -x /usr/bin/game_latency_monitor.sh ]; then
                    /usr/bin/game_latency_monitor.sh >/dev/null 2>&1 &
                fi
                cat /tmp/game_realtime_status.json 2>/dev/null || echo '{"avg_ping":15,"grade":"🌟 Siêu Mượt","grade_color":"#16a34a","garena":14,"riot":11,"cdn":12,"viettel":10,"active_gamers":[],"device_optimizations":[]}'
