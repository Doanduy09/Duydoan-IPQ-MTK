local function send_at(cmd, timeout_s)
    timeout_s = timeout_s or 3
    local run_cmd = string.format("timeout %d modem_lock_run sh -c \"echo -e '%s\\r' | atinout - '%s' -\" 2>/dev/null", timeout_s, cmd, port)
    local f = io.popen(run_cmd)
    if not f then return "" end
    local content = f:read("*a") or ""
    f:close()
    return content
end

