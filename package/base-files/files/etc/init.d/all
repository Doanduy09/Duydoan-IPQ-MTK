        cat << 'CGI_EOF' > /www/cgi-bin/custom_file_manager
#!/bin/sh
clean_path() {
    local p="$1"
    p=$(echo "$p" | sed 's/%2F/\//g; s/%20/ /g; s/\/\//\//g')
    while echo "$p" | grep -q '\.\.'; do
        p=$(echo "$p" | sed 's/\.\.//g')
    done
    [ -z "$p" ] && p="/etc/init.d"
    echo "$p"
}

action=$(echo "$QUERY_STRING" | sed -n 's/^.*action=\([^&]*\).*$/\1/p')
target_dir=$(clean_path "$(echo "$QUERY_STRING" | sed -n 's/^.*dir=\([^&]*\).*$/\1/p')")
target_name=$(echo "$QUERY_STRING" | sed -n 's/^.*name=\([^&]*\).*$/\1/p' | sed 's/%2F/\//g; s/%20/ /g')
target_name=$(basename "$target_name" 2>/dev/null | tr -d '\r\n`$<>|;&')

[ -z "$target_dir" ] && target_dir="/etc/init.d"
target_dir=$(echo "$target_dir" | sed 's/\/$//')
[ -z "$target_dir" ] && target_dir="/"

if [ "$action" = "download" ]; then
    download_path="$target_dir/$target_name"
    if [ -f "$download_path" ]; then
        echo "Content-Type: application/octet-stream"
        echo "Content-Disposition: attachment; filename=\"$target_name\""
        echo "Content-Length: $(wc -c < "$download_path")"
        echo ""
        cat "$download_path"
        exit 0
    else
        echo "Status: 404 Not Found"
        echo "Content-type: text/plain"
        echo ""
        echo "File không tồn tại!"
        exit 0
    fi
fi

echo "Content-type: application/json"
echo ""

case "$action" in
    list)
        if [ ! -d "$target_dir" ]; then
            printf '{"success":false,"message":"Thư mục không tồn tại!","current_dir":"%s","items":[]}\n' "$target_dir"
            exit 0
        fi
        
        items_json=""
        for f in "$target_dir"/* "$target_dir"/.*; do
            [ -e "$f" ] || continue
            fname=$(basename "$f" 2>/dev/null)
            [ "$fname" = "." ] || [ "$fname" = "*" ] && continue
            [ "$fname" = ".." ] && continue
            
            ftype="file"
            fsize="0 B"
            fdate="--"
            
            if [ -d "$f" ]; then
                ftype="dir"
            elif [ -f "$f" ]; then
                ftype="file"
                fsize=$(ls -lh "$f" 2>/dev/null | awk '{print $5}')
            elif [ -L "$f" ]; then
                ftype="link"
                fsize=$(ls -lh "$f" 2>/dev/null | awk '{print $5}')
            fi
            
            fdate=$(date -r "$f" "+%Y-%m-%d %H:%M" 2>/dev/null || echo "--")
            
            [ -n "$items_json" ] && items_json="${items_json},"
            items_json="${items_json}{\"name\":\"$fname\",\"type\":\"$ftype\",\"size\":\"$fsize\",\"date\":\"$fdate\"}"
        done
        
        printf '{"success":true,"current_dir":"%s","items":[%s]}\n' "$target_dir" "$items_json"
        ;;

    upload)
        mkdir -p "$target_dir" 2>/dev/null
        full_path="$target_dir/$target_name"

        # Kiểm tra RAM còn trống - cần ít nhất 60MB free để upload an toàn
        mem_free_kb=$(awk '/MemAvailable/{print $2}' /proc/meminfo 2>/dev/null || echo 999999)
        if [ "${mem_free_kb:-0}" -lt 61440 ]; then
            printf '{"success":false,"message":"Lỗi: Không đủ RAM trống! Cần ít nhất 60MB free (hiện có: %sMB)."}\n' "$((mem_free_kb / 1024))"
            break
        fi

        # Đọc tối đa 50MB, từ chối file lớn hơn
        MAX_BYTES=52428800
        tmp_upload="${full_path}.$$upload.tmp"
        dd bs=4096 of="$tmp_upload" count=12801 2>/dev/null
        file_size=$(stat -c %s "$tmp_upload" 2>/dev/null || echo 0)
        if [ "${file_size:-0}" -ge "$MAX_BYTES" ]; then
            rm -f "$tmp_upload" 2>/dev/null
            printf '{"success":false,"message":"Lỗi: File vượt quá giới hạn 50MB!"}\n'
            break
        fi
        mv -f "$tmp_upload" "$full_path" 2>/dev/null
        if [ -s "$full_path" ] || [ -f "$full_path" ]; then
            chmod +x "$full_path" 2>/dev/null
            printf '{"success":true,"message":"Đã tải file thành công!","path":"%s"}\n' "$full_path"
        else
            rm -f "$tmp_upload" 2>/dev/null
            printf '{"success":false,"message":"Lỗi ghi file!"}\n'
        fi
        ;;

    delete)
        target_path="$target_dir/$target_name"
        if [ -e "$target_path" ] && [ "$target_dir" != "/" ]; then
            rm -rf "$target_path" 2>/dev/null
            printf '{"success":true,"message":"Đã xóa thành công!"}\n'
        else
            printf '{"success":false,"message":"File không tồn tại hoặc không thể xóa thư mục gốc!"}\n'
        fi
        ;;
esac
CGI_EOF
    chmod 755 /www/cgi-bin/custom_file_manager

    cat << 'CGI_FW' > /www/cgi-bin/firmware_uploader
#!/bin/sh
echo "Content-Type: application/json"
echo ""

action=$(echo "$QUERY_STRING" | sed -n 's/^.*action=\([^&]*\).*$/\1/p')

if [ "$action" = "flash" ]; then
    TMP_FW="/tmp/firmware_flash.bin"
    keep=$(echo "$QUERY_STRING" | sed -n 's/^.*keep=\([^&]*\).*$/\1/p')
    force=$(echo "$QUERY_STRING" | sed -n 's/^.*force=\([^&]*\).*$/\1/p')
    
    cmd_opts=""
    [ "$keep" != "1" ] && cmd_opts="$cmd_opts -n"
    [ "$force" = "1" ] && cmd_opts="$cmd_opts -F"

    if [ -s "$TMP_FW" ]; then
        (sleep 2 && /sbin/sysupgrade $cmd_opts "$TMP_FW") >/dev/null 2>&1 &
        printf '{"success":true}\n'
    else
        printf '{"success":false,"message":"Không tìm thấy file firmware tạm!"}\n'
    fi
    exit 0
fi

if [ "$REQUEST_METHOD" = "POST" ]; then
    TMP_FW="/tmp/firmware_flash.bin"
    rm -f "$TMP_FW"
    cat > "$TMP_FW"
    
    if [ -s "$TMP_FW" ]; then
        chmod 644 "$TMP_FW"
        size_bytes=$(wc -c < "$TMP_FW")
        size_mb=$(awk "BEGIN {printf \"%.2f\", $size_bytes/1024/1024}")
        md5_val=$(md5sum "$TMP_FW" | awk '{print $1}')
        sha_val=$(sha256sum "$TMP_FW" | awk '{print $1}')
        
        test_out=$(/sbin/sysupgrade -T "$TMP_FW" 2>&1)
        test_status=$?
        
        esc_test_out=$(echo "$test_out" | sed 's/\\/\\\\/g; s/"/\\"/g' | awk '{printf "%s\\n", $0}')
        
        printf '{"success":true,"size":"%s MiB","md5":"%s","sha256":"%s","test_status":%d,"test_out":"%s"}\n' "$size_mb" "$md5_val" "$sha_val" "$test_status" "$esc_test_out"
    else
        printf '{"success":false,"message":"File tải lên bị rỗng!"}\n'
    fi
else
    printf '{"success":false,"message":"Yêu cầu không hợp lệ!"}\n'
fi
CGI_FW
    chmod 755 /www/cgi-bin/firmware_uploader

    cat << 'JDC_LED_EOF' > /usr/bin/jdc_led_sync.sh
#!/bin/sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export TZ=Asia/Ho_Chi_Minh

update_jdc_led() {
    # Check for stale lock (older than 10s)
    if [ -f /tmp/led_updating.lock ]; then
        local now=$(date +%s)
        local mtime=$(date -r /tmp/led_updating.lock +%s 2>/dev/null || echo "$now")
        if [ $((now - mtime)) -gt 10 ]; then
            rm -f /tmp/led_updating.lock 2>/dev/null
        else
            return 0
        fi
    fi
    touch /tmp/led_updating.lock
    trap 'rm -f /tmp/led_updating.lock' EXIT INT TERM

    # 1. Kiem tra xem nguoi dung co bat LED khong
    local led_enabled=$(uci -q get athena_led.config.enable || echo "1")
    if [ "$led_enabled" = "0" ]; then
        if [ -c /dev/ttyS1 ]; then
            printf "\x02\x03" > /dev/ttyS1 2>/dev/null
        fi
        for led in /sys/class/leds/*status*; do
            [ -f "$led/brightness" ] && echo 0 > "$led/brightness" 2>/dev/null
        done
        rm -f /tmp/led_updating.lock
        return 0
    fi

    LUNAR_LED=""
    TEMP_LED="30"
    UV_LED="8"
    PM25_LED="15"
    POP_LED="2"
    DATA_LED="0MB"

    if [ -f /tmp/weather_data.json ]; then
        LUNAR_JSN=$(jsonfilter -i /tmp/weather_data.json -e '$.lunar' 2>/dev/null | sed 's/ Âm Lịch//g; s/ AL//g; s/ //g')
        [ -n "$LUNAR_JSN" ] && [ "$LUNAR_JSN" != "--" ] && LUNAR_LED="${LUNAR_JSN} AL"
        
        TEMP_JSN=$(jsonfilter -i /tmp/weather_data.json -e '$.temp' 2>/dev/null)
        [ -n "$TEMP_JSN" ] && TEMP_LED="$TEMP_JSN"
        
        UV_JSN=$(jsonfilter -i /tmp/weather_data.json -e '$.uv' 2>/dev/null)
        [ -n "$UV_JSN" ] && UV_JSN_VAL=$(echo "$UV_JSN" | grep -oE '[0-9]+' | head -n1)
        [ -n "$UV_JSN_VAL" ] && UV_LED="$UV_JSN_VAL"
        
        PM_JSN=$(jsonfilter -i /tmp/weather_data.json -e '$.pm25' 2>/dev/null)
        [ -n "$PM_JSN" ] && PM25_LED="$PM_JSN"

        POP_JSN=$(jsonfilter -i /tmp/weather_data.json -e '$.pop' 2>/dev/null)
        [ -n "$POP_JSN" ] && POP_LED="$POP_JSN"
    fi

    [ -z "$LUNAR_LED" ] && LUNAR_LED="$(date +%d/%m) AL"

    if [ -f /tmp/sys_fast_stats.json ]; then
        RAW_DATA=$(jsonfilter -i /tmp/sys_fast_stats.json -e '$.data_used' 2>/dev/null)
        DATA_PARSED=$(echo "$RAW_DATA" | awk -F' - ' '{print $1}' | awk -F'/' '{print $1}' | tr -d ' ')
        [ -n "$DATA_PARSED" ] && [ "$DATA_PARSED" != "--" ] && DATA_LED="$DATA_PARSED"
    fi
    
    SPACES="            "
    TEXT_OUT="AL: ${LUNAR_LED}${SPACES}ND: ${TEMP_LED}*C${SPACES}UV: ${UV_LED}${SPACES}Bui: ${PM25_LED}ug${SPACES}Mua: ${POP_LED}%${SPACES}Data: ${DATA_LED}"
    
    mkdir -p /www /tmp 2>/dev/null
    echo "$TEXT_OUT" > /tmp/weather.txt
    ln -sf /tmp/weather.txt /www/weather.txt 2>/dev/null
    chmod 644 /tmp/weather.txt 2>/dev/null
    
    # CHI ghi truc tiep vao /dev/ttyS1 neu daemon /usr/sbin/athena-led KHONG chay
    # de tranh xung dot UART gay giat/chop man hinh va de che do hien thi cua nguoi dung
    if ! pgrep -x athena-led >/dev/null 2>&1; then
        if [ -c /dev/ttyS1 ]; then
            printf "\x02%s\x03" "$TEXT_OUT" > /dev/ttyS1 2>/dev/null
        fi
        if command -v jdc_led_display >/dev/null 2>&1; then
            jdc_led_display "$TEXT_OUT" >/dev/null 2>&1
        fi
    fi
    
    ROUTER_M=$(ubus call system board 2>/dev/null | jsonfilter -e '$.model')
    [ -z "$ROUTER_M" ] && ROUTER_M=$(cat /tmp/sysinfo/model 2>/dev/null || echo "Unknown")
    if [ "$ROUTER_M" = "JDCloud RE-CS-02" ]; then
        local led_lvl=$(uci -q get athena_led.config.lightLevel || echo "5")
        if [ "$led_lvl" -gt 0 ]; then
            [ -f /sys/class/leds/green:status/brightness ] && echo 1 > /sys/class/leds/green:status/brightness 2>/dev/null
        fi
    fi
    rm -f /tmp/led_updating.lock
}

red_blink() {
    for i in 1 2 3 4 5; do
        for l in /sys/class/leds/*red* /sys/class/leds/*status*; do
            [ -f "$l/brightness" ] && echo 1 > "$l/brightness" 2>/dev/null
        done
        sleep 0.2 2>/dev/null || sleep 1
        for l in /sys/class/leds/*red* /sys/class/leds/*status*; do
            [ -f "$l/brightness" ] && echo 0 > "$l/brightness" 2>/dev/null
        done
        sleep 0.2 2>/dev/null || sleep 1
    done
    update_jdc_led
}

# Command dispatching
case "$1" in
    red_blink)
        red_blink
        exit 0
        ;;
    update)
        update_jdc_led
        exit 0
        ;;
    daemon|"")
        # Proceed to run daemon below
        ;;
    *)
        update_jdc_led
        exit 0
        ;;
esac

# Daemon single instance lock
DAEMON_PID_FILE="/tmp/jdc_led_sync_daemon.pid"
if [ -f "$DAEMON_PID_FILE" ]; then
    EXISTING_PID=$(cat "$DAEMON_PID_FILE" 2>/dev/null)
    if [ -n "$EXISTING_PID" ] && [ -d "/proc/$EXISTING_PID" ]; then
        # Daemon is already running, just update once and exit!
        update_jdc_led
        exit 0
    fi
fi
echo "$$" > "$DAEMON_PID_FILE"
trap 'rm -f "$DAEMON_PID_FILE"' EXIT INT TERM

trap 'update_jdc_led' USR1
update_jdc_led

data_counter=0
while true; do
    ROUTER_M_CHECK=$(cat /tmp/sysinfo/model 2>/dev/null || echo "Unknown")
    if [ "$ROUTER_M_CHECK" = "JDCloud RE-CS-02" ]; then
        data_counter=$((data_counter + 3))
        if [ "$data_counter" -ge 30 ]; then
            data_counter=0
            /tmp/fast_stats_fetcher.sh >/dev/null 2>&1
        fi
        update_jdc_led
        sleep 3
    else
        # Router đa năng (ASUS TUF-AX6000, etc.): chạy êm ái mỗi 25s, không can thiệp LED phần cứng
        /tmp/fast_stats_fetcher.sh >/dev/null 2>&1
        sleep 25
    fi
done
JDC_LED_EOF
    chmod +x /usr/bin/jdc_led_sync.sh
    cp -f /usr/bin/jdc_led_sync.sh /tmp/jdc_led_sync.sh 2>/dev/null

    cat << 'FETCH_EOF' > "$WEATHER_FETCHER_SCRIPT"
#!/bin/sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export TZ=Asia/Ho_Chi_Minh

calc_lunar() {
    local d=$(date +%d | sed 's/^0//')
    local m=$(date +%m | sed 's/^0//')
    local y=$(date +%Y)
    
    if [ "$y" -eq 2026 ]; then
        case "$m" in
            1) [ "$d" -ge 19 ] && echo "$((d - 18))/12" || echo "$((d + 12))/11" ;;
            2) [ "$d" -ge 17 ] && echo "$((d - 16))/1"  || echo "$((d + 13))/12" ;;
            3) [ "$d" -ge 18 ] && echo "$((d - 17))/2"  || echo "$((d + 12))/1"  ;;
            4) [ "$d" -ge 17 ] && echo "$((d - 16))/3"  || echo "$((d + 14))/2"  ;;
            5) [ "$d" -ge 16 ] && echo "$((d - 15))/4"  || echo "$((d + 14))/3"  ;;
            6) [ "$d" -ge 15 ] && echo "$((d - 14))/5"  || echo "$((d + 16))/4"  ;;
            7) [ "$d" -ge 14 ] && echo "$((d - 13))/6"  || echo "$((d + 16))/5"  ;;
            8) [ "$d" -ge 13 ] && echo "$((d - 12))/7"  || echo "$((d + 18))/6"  ;;
            9) [ "$d" -ge 11 ] && echo "$((d - 10))/8"  || echo "$((d + 19))/7"  ;;
            10) [ "$d" -ge 10 ] && echo "$((d - 9))/9"  || echo "$((d + 20))/8"  ;;
            11) [ "$d" -ge 9 ]  && echo "$((d - 8))/10" || echo "$((d + 22))/9"  ;;
            12) [ "$d" -ge 8 ]  && echo "$((d - 7))/11" || echo "$((d + 22))/10" ;;
            *) echo "${d}/${m}" ;;
        esac
    elif [ "$y" -eq 2027 ]; then
        case "$m" in
            1) [ "$d" -ge 7 ]  && echo "$((d - 6))/12"  || echo "$((d + 24))/11" ;;
            2) [ "$d" -ge 6 ]  && echo "$((d - 5))/1"   || echo "$((d + 25))/12" ;;
            3) [ "$d" -ge 8 ]  && echo "$((d - 7))/2"   || echo "$((d + 23))/1"  ;;
            4) [ "$d" -ge 6 ]  && echo "$((d - 5))/3"   || echo "$((d + 24))/2"  ;;
            5) [ "$d" -ge 6 ]  && echo "$((d - 5))/4"   || echo "$((d + 25))/3"  ;;
            6) [ "$d" -ge 4 ]  && echo "$((d - 3))/5"   || echo "$((d + 26))/4"  ;;
            7) [ "$d" -ge 4 ]  && echo "$((d - 3))/6"   || echo "$((d + 27))/5"  ;;
            8) [ "$d" -ge 2 ]  && echo "$((d - 1))/7"   || echo "$((d + 28))/6"  ;;
            9) [ "$d" -eq 30 ] && echo "1/9"            || echo "${d}/8"         ;;
            10) [ "$d" -ge 30 ] && echo "$((d - 29))/10" || echo "$((d + 1))/9"  ;;
            11) [ "$d" -ge 28 ] && echo "$((d - 27))/11" || echo "$((d + 2))/10" ;;
            12) [ "$d" -ge 28 ] && echo "$((d - 27))/12" || echo "$((d + 3))/11" ;;
            *) echo "${d}/${m}" ;;
        esac
    elif [ "$y" -eq 2028 ]; then
        case "$m" in
            1) [ "$d" -ge 26 ] && echo "$((d - 25))/1"  || echo "$((d + 5))/12" ;;
            2) [ "$d" -ge 25 ] && echo "$((d - 24))/2"  || echo "$((d + 6))/1"  ;;
            3) [ "$d" -ge 26 ] && echo "$((d - 25))/3"  || echo "$((d + 5))/2"  ;;
            4) [ "$d" -ge 25 ] && echo "$((d - 24))/4"  || echo "$((d + 6))/3"  ;;
            5) [ "$d" -ge 24 ] && echo "$((d - 23))/5"  || echo "$((d + 7))/4"  ;;
            6) [ "$d" -ge 23 ] && echo "$((d - 22))/6"  || echo "$((d + 8))/5"  ;;
            7) [ "$d" -ge 22 ] && echo "$((d - 21))/7"  || echo "$((d + 9))/6"  ;;
            8) [ "$d" -ge 21 ] && echo "$((d - 20))/8"  || echo "$((d + 10))/7" ;;
            9) [ "$d" -ge 19 ] && echo "$((d - 18))/9"  || echo "$((d + 11))/8" ;;
            10) [ "$d" -ge 19 ] && echo "$((d - 18))/10" || echo "$((d + 12))/9" ;;
            11) [ "$d" -ge 17 ] && echo "$((d - 16))/11" || echo "$((d + 13))/10" ;;
            12) [ "$d" -ge 17 ] && echo "$((d - 16))/12" || echo "$((d + 14))/11" ;;
            *) echo "${d}/${m}" ;;
        esac
    elif [ "$y" -eq 2029 ]; then
        case "$m" in
            1) [ "$d" -ge 15 ] && echo "$((d - 14))/12" || echo "$((d + 16))/11" ;;
            2) [ "$d" -ge 13 ] && echo "$((d - 12))/1"  || echo "$((d + 16))/12" ;;
            3) [ "$d" -ge 15 ] && echo "$((d - 14))/2"  || echo "$((d + 16))/1"  ;;
            4) [ "$d" -ge 14 ] && echo "$((d - 13))/3"  || echo "$((d + 17))/2"  ;;
            5) [ "$d" -ge 13 ] && echo "$((d - 12))/4"  || echo "$((d + 18))/3"  ;;
            6) [ "$d" -ge 12 ] && echo "$((d - 11))/5"  || echo "$((d + 19))/4"  ;;
            7) [ "$d" -ge 11 ] && echo "$((d - 10))/6"  || echo "$((d + 20))/5"  ;;
            8) [ "$d" -ge 10 ] && echo "$((d - 9))/7"   || echo "$((d + 21))/6"  ;;
            9) [ "$d" -ge 8 ]  && echo "$((d - 7))/8"   || echo "$((d + 22))/7"  ;;
            10) [ "$d" -ge 8 ] && echo "$((d - 7))/9"   || echo "$((d + 23))/8"  ;;
            11) [ "$d" -ge 6 ] && echo "$((d - 5))/10"  || echo "$((d + 24))/9"  ;;
            12) [ "$d" -ge 6 ] && echo "$((d - 5))/11"  || echo "$((d + 25))/10" ;;
            *) echo "${d}/${m}" ;;
        esac
    else
        echo "${d}/${m}"
    fi
}

get_current_active_ttl() {
    local ttl_val=""
    if command -v nft >/dev/null 2>&1; then
        ttl_val=$(nft list ruleset 2>/dev/null | grep -i 'ip ttl set' | grep -o '[0-9]\+' | tail -n 1)
    fi
    [ -z "$ttl_val" ] && ttl_val=$(uci -q get firewall.ttl_rule.ttl)
    [ -z "$ttl_val" ] && ttl_val=$(sysctl -n net.ipv4.ip_default_ttl 2>/dev/null)
    [ -z "$ttl_val" ] && ttl_val="64"
    echo "$ttl_val"
}

normalize_vietnamese_city() {
    local raw_name="$1"
    if echo "$raw_name" | grep -iqE "phường|xã|quận|huyện|thị trấn|bình đông|nha mân|vũng tàu|hà nội"; then
        echo "$raw_name"
        return 0
    fi

    raw_name=$(echo "$raw_name" | sed 's/Tỉnh //g; s/Thành phố //g; s/TP. //g; s/ Province//g; s/ City//g; s/ District//g')
    case "$(echo "$raw_name" | tr '[:upper:]' '[:lower:]')" in
        *"vung tau"*|*"vũng tàu"*) echo "Vũng Tàu" ;;
        *"ho chi minh"*|*"hcm"*|*"sai gon"*|*"saigon"*) echo "TP. Hồ Chí Minh" ;;
        *"ha noi"*|*"hà nội"*) echo "Hà Nội" ;;
        *"da nang"*|*"danang"*) echo "Đà Nẵng" ;;
        *"can tho"*|*"cantho"*) echo "Cần Thơ" ;;
        *"dong thap"*|*"dongthap"*) echo "Đồng Tháp" ;;
        *"nha man"*) echo "Nha Mân (Đồng Tháp)" ;;
        *"sa dec"*) echo "TP. Sa Đéc" ;;
        *"cao lanh"*) echo "TP. Cao Lãnh" ;;
        *"hai phong"*|*"haiphong"*) echo "Hải Phòng" ;;
        *"binh duong"*) echo "Bình Dương" ;;
        *"dong nai"*) echo "Đồng Nai" ;;
        *"an giang"*) echo "An Giang" ;;
        *"vinh long"*) echo "Vĩnh Long" ;;
        *"tien giang"*) echo "Tiền Giang" ;;
        *"ben tre"*) echo "Bến Tre" ;;
        *"long an"*) echo "Long An" ;;
        *"ca mau"*) echo "Cà Mau" ;;
        *"kien giang"*) echo "Kiên Giang" ;;
        *) echo "$raw_name" ;;
    esac
}

fetch_once() {
    LAT=""
    LON=""
    LOCATION_NAME=""
    CUSTOM_SET=0

    if [ -f "/etc/custom_location.dat" ] && [ ! -f "/tmp/custom_location.dat" ]; then
        cp -f /etc/custom_location.dat /tmp/custom_location.dat 2>/dev/null
    fi

    if [ -f "/tmp/custom_location.dat" ]; then
        raw_loc=$(cat /tmp/custom_location.dat 2>/dev/null)
        C_NAME=$(echo "$raw_loc" | cut -d'|' -f1)
        C_LAT=$(echo "$raw_loc" | cut -d'|' -f2)
        C_LON=$(echo "$raw_loc" | cut -d'|' -f3)
        if [ -n "$C_LAT" ] && [ -n "$C_LON" ]; then
            LAT="$C_LAT"
            LON="$C_LON"
            LOCATION_NAME="$C_NAME"
            CUSTOM_SET=1
        fi
    fi

    if [ -z "$LAT" ] || [ -z "$LON" ]; then
        for geo_url in \
            "http://ip-api.com/json/?fields=status,city,regionName,lat,lon" \
            "https://ipapi.co/json/" \
            "https://ipinfo.io/json"
        do
            GEO_RAW=$(wget -qO- --timeout=4 "$geo_url" 2>/dev/null)
            if [ -n "$GEO_RAW" ]; then
                LAT=$(echo "$GEO_RAW" | jsonfilter -e '$.lat' 2>/dev/null || echo "$GEO_RAW" | jsonfilter -e '$.latitude' 2>/dev/null)
                LON=$(echo "$GEO_RAW" | jsonfilter -e '$.lon' 2>/dev/null || echo "$GEO_RAW" | jsonfilter -e '$.longitude' 2>/dev/null)
                CITY_VAL=$(echo "$GEO_RAW" | jsonfilter -e '$.city' 2>/dev/null)
                REGION_VAL=$(echo "$GEO_RAW" | jsonfilter -e '$.regionName' 2>/dev/null || echo "$GEO_RAW" | jsonfilter -e '$.region' 2>/dev/null)
                
                [ -z "$LAT" ] && [ -n "$(echo "$GEO_RAW" | jsonfilter -e '$.loc')" ] && {
                    LAT=$(echo "$GEO_RAW" | jsonfilter -e '$.loc' | cut -d',' -f1)
                    LON=$(echo "$GEO_RAW" | jsonfilter -e '$.loc' | cut -d',' -f2)
                }
                
                if [ -n "$LAT" ] && [ -n "$LON" ]; then
                    LOCATION_NAME="${CITY_VAL:-$REGION_VAL}"
                    break
                fi
            fi
        done
    fi

    if [ -z "$LOCATION_NAME" ] && [ -n "$LAT" ] && [ -n "$LON" ]; then
        REVERSE_GEO=$(wget -qO- --timeout=4 --user-agent="OpenWrt-Athena-Weather/1.0" "https://nominatim.openstreetmap.org/reverse?format=json&lat=${LAT}&lon=${LON}&accept-language=vi" 2>/dev/null)
        if [ -n "$REVERSE_GEO" ]; then
            GEO_SUBURB=$(echo "$REVERSE_GEO" | jsonfilter -e '$.address.suburb' 2>/dev/null || echo "$REVERSE_GEO" | jsonfilter -e '$.address.quarter' 2>/dev/null)
            GEO_CITY=$(echo "$REVERSE_GEO" | jsonfilter -e '$.address.city' 2>/dev/null || echo "$REVERSE_GEO" | jsonfilter -e '$.address.state' 2>/dev/null)
            
            if [ -n "$GEO_SUBURB" ] && [ -n "$GEO_CITY" ]; then
                LOCATION_NAME="${GEO_SUBURB}, ${GEO_CITY}"
            else
                LOCATION_NAME=$(echo "$REVERSE_GEO" | jsonfilter -e '$.address.state' 2>/dev/null)
                [ -z "$LOCATION_NAME" ] && LOCATION_NAME=$(echo "$REVERSE_GEO" | jsonfilter -e '$.address.city' 2>/dev/null)
                [ -z "$LOCATION_NAME" ] && LOCATION_NAME=$(echo "$REVERSE_GEO" | jsonfilter -e '$.address.county' 2>/dev/null)
            fi
        fi
    fi

    [ -z "$LAT" ] && LAT="10.7626"
    [ -z "$LON" ] && LON="106.6601"
    [ -z "$LOCATION_NAME" ] && LOCATION_NAME="TP. Hồ Chí Minh"

    if [ "$CUSTOM_SET" -eq 0 ]; then
        LOCATION_NAME=$(normalize_vietnamese_city "$LOCATION_NAME")
    fi

    RAW=$(wget -qO- --timeout=5 "https://api.open-meteo.com/v1/forecast?latitude=${LAT}&longitude=${LON}&current=temperature_2m,relative_humidity_2m,uv_index&hourly=precipitation_probability&forecast_days=2&timezone=Asia%2FHo_Chi_Minh" 2>/dev/null)
    RAW_AQI=$(wget -qO- --timeout=5 "https://air-quality-api.open-meteo.com/v1/air-quality?latitude=${LAT}&longitude=${LON}&current=pm2_5&timezone=Asia%2FHo_Chi_Minh" 2>/dev/null)

    TEMP=$(echo "$RAW" | jsonfilter -e '$.current.temperature_2m' 2>/dev/null | awk '{printf "%.0f", $1}')
    [ -z "$TEMP" ] && TEMP="30"

    HUMI=$(echo "$RAW" | jsonfilter -e '$.current.relative_humidity_2m' 2>/dev/null | awk '{printf "%.0f", $1}')
    UV=$(echo "$RAW" | jsonfilter -e '$.current.uv_index' 2>/dev/null | awk '{printf "%.0f", $1}')
    PM25=$(echo "$RAW_AQI" | jsonfilter -e '$.current.pm2_5' 2>/dev/null | awk '{printf "%.0f", $1}')

    CUR_HOUR=$(date +%H | sed 's/^0//')
    [ -z "$CUR_HOUR" ] && CUR_HOUR=0

    # Solar UV is mathematically 0 at night (18:00 - 05:59)
    if [ "$CUR_HOUR" -ge 18 ] || [ "$CUR_HOUR" -lt 6 ]; then
        UV="0"
    else
        [ -z "$UV" ] && UV="3"
    fi

    POP=$(echo "$RAW" | jsonfilter -e "$.hourly.precipitation_probability[$CUR_HOUR]" 2>/dev/null)
    [ -z "$POP" ] && POP=0

    RAIN_HOURS=""
    for i in 0 1 2 3 4 5; do
        idx=$((CUR_HOUR + i))
        val=$(echo "$RAW" | jsonfilter -e "$.hourly.precipitation_probability[$idx]" 2>/dev/null || echo 0)
        [ -z "$val" ] && val=0
        RAIN_HOURS="${RAIN_HOURS}${val},"
    done

    [ -z "$PM25" ] && PM25="15"

    if [ "$PM25" -le 12 ]; then
        PM_RISK="Tốt - 🟢 Không khí trong lành"
    elif [ "$PM25" -le 35 ]; then
        PM_RISK="Trung bình - 🟡 Khá an toàn"
    elif [ "$PM25" -le 55 ]; then
        PM_RISK="Kém - 😷 Nên đeo khẩu trang"
    else
        PM_RISK="Xấu - 🚨 Tốt nhất ở trong nhà"
    fi

    LUNAR=$(calc_lunar)
    UPDATED=$(date "+%H:%M:%S - %d/%m/%Y")
    ACTIVE_TTL=$(get_current_active_ttl)

    local has_wwan=false
    local has_wan=false
    local cur_usb=$(lsusb 2>/dev/null)
    if [ -f "/tmp/is_phone_tethering" ] || echo "$cur_usb" | grep -iqE "1199:|2c7c:|2cb7:|1e0e:|05c6:|1bc7:|12d1:|0e8d:712|quectel|sierra|fibocom|simcom|telit|huawei|meig|neoway" || [ -e /dev/cdc-wdm0 ] || [ -e /dev/cdc-wdm1 ] || [ -d /sys/class/net/wwan0 ] || [ -d /sys/class/net/wwan1 ]; then
        has_wwan=true
    fi

    local wan_dev=$(uci -q get network.wan.device || echo "eth1")
    if [ -f "/sys/class/net/${wan_dev}/carrier" ] && [ "$(cat /sys/class/net/${wan_dev}/carrier 2>/dev/null)" = "1" ]; then
        has_wan=true
    elif [ -n "$(ip -4 addr show dev "$wan_dev" 2>/dev/null | grep 'inet ' | awk '{print $2}' | cut -d/ -f1)" ]; then
        has_wan=true
    elif [ "$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '$.up' 2>/dev/null)" = "true" ]; then
        has_wan=true
    fi

    local CARD_NAME=""
    local ACTIVE_PROTO=""
    local CUR_IFACE=""
    local CUR_IP=""

    if [ "$has_wwan" = "true" ]; then
        CARD_NAME=$(cat /tmp/master_m_type 2>/dev/null)
        [ -z "$CARD_NAME" ] && CARD_NAME="Modem 5G/LTE"
        CUR_IFACE=$(cat /tmp/wd_interface 2>/dev/null)
        [ -z "$CUR_IFACE" ] && [ -d /sys/class/net/usb0 ] && CUR_IFACE="usb0"
        [ -z "$CUR_IFACE" ] && CUR_IFACE="wwan0"
        ACTIVE_PROTO=$(uci -q get network.${CUR_IFACE}.proto)
        [ -z "$ACTIVE_PROTO" ] && ACTIVE_PROTO=$(uci -q get network.wwan0.proto)
        [ -z "$ACTIVE_PROTO" ] && ACTIVE_PROTO=$(uci -q get network.usb0.proto)
        [ -z "$ACTIVE_PROTO" ] && ACTIVE_PROTO="mbim"
        CUR_IP=$(cat /tmp/wd_wanip 2>/dev/null)
        [ -z "$CUR_IP" ] && CUR_IP=$(ip -4 addr show dev "$CUR_IFACE" 2>/dev/null | grep 'inet ' | awk '{print $2}' | cut -d/ -f1)
        [ -z "$CUR_IP" ] && CUR_IP=""
    elif [ "$has_wan" = "true" ]; then
        CARD_NAME="Cáp Mạng WAN (Ethernet)"
        CUR_IFACE="wan"
        ACTIVE_PROTO=$(uci -q get network.wan.proto || echo "dhcp")
        CUR_IP=$(ip -4 addr show dev "$wan_dev" 2>/dev/null | grep 'inet ' | awk '{print $2}' | cut -d/ -f1)
        [ -z "$CUR_IP" ] && CUR_IP=$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '$.ipv4-address[0].address' 2>/dev/null)
        [ -z "$CUR_IP" ] && CUR_IP=""
    else
        CARD_NAME=""
        CUR_IFACE=""
        ACTIVE_PROTO=""
        CUR_IP=""
    fi

    WWAN_INFO_STR="${CARD_NAME}"

    cat << EOFF > "/tmp/weather_data.json.tmp"
{
  "location": "${LOCATION_NAME}",
  "lat": "${LAT}",
  "lon": "${LON}",
  "lunar": "${LUNAR}",
  "temp": "${TEMP}",
  "humi": "${HUMI:-71}",
  "uv": "${UV:-0}",
  "pop": "${POP:-0}",
  "rain_hours": "${RAIN_HOURS}",
  "pm25": "${PM25:-15}",
  "pm_risk": "${PM_RISK}",
  "has_wwan": ${has_wwan},
  "has_wan": ${has_wan},
  "wwan_name": "${WWAN_INFO_STR}",
  "active_proto": "${ACTIVE_PROTO}",
  "active_iface": "${CUR_IFACE}",
  "active_ip": "${CUR_IP}",
  "active_ttl": "${ACTIVE_TTL}",
  "updated": "${UPDATED}"
}
EOFF
    mv -f "/tmp/weather_data.json.tmp" "/tmp/weather_data.json"
    killall -USR1 jdc_led_sync.sh 2>/dev/null
}

if [ "$1" = "daemon" ]; then
    exec 208>"/var/lock/weather_fetcher.lock"
    if ! flock -n 208 2>/dev/null; then
        exit 0
    fi
    trap 'wait -n 2>/dev/null' CHLD
    while true; do
        fetch_once
        sleep 900
    done
else
    fetch_once
fi
exit 0
FETCH_EOF
    chmod +x "$WEATHER_FETCHER_SCRIPT"

    cat << 'FAST_EOF' > "$FAST_STATS_SCRIPT"
#!/bin/sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export TZ=Asia/Ho_Chi_Minh

LOCK_DIR="/tmp/at_atomic_lock.d"
CACHE_AT="/tmp/at_cache_stats.tmp"

FAST_LOCK="/tmp/fast_stats_fetcher.lock"
if ! ( set -o noclobber; echo "$$" > "$FAST_LOCK" ) 2>/dev/null; then
    old_p=$(cat "$FAST_LOCK" 2>/dev/null | tr -d ' \r\n')
    if [ -n "$old_p" ] && [ -d "/proc/$old_p" ]; then
        exit 0
    fi
    echo "$$" > "$FAST_LOCK" 2>/dev/null
fi
trap 'rm -f "$FAST_LOCK" 2>/dev/null' EXIT INT TERM

# Nếu đang bận gửi tin hoặc có cờ lock SMS, nhường cổng hoàn toàn
if [ -f "/tmp/sms_sending.lock" ] || [ -f "/tmp/auto_data/force_renew_sms" ]; then
    exit 0
fi

send_at_cmd_safe() {
    local port="$1"
    local cmd="$2"
    if [ -x /usr/bin/at_mux ]; then
        local out=$(/usr/bin/at_mux send 3 "$cmd" 1.5 2>/dev/null)
        if echo "$out" | grep -q "^ERROR:"; then
            echo ""
            return 1
        fi
        echo "$out"
        return 0
    fi
    [ ! -c "$port" ] && return 1
    
    local out=""
    if command -v timeout >/dev/null 2>&1; then
        if command -v modem_lock_run >/dev/null 2>&1; then
            out=$(timeout 1.5 modem_lock_run sh -c "echo -e '$cmd\r' | timeout 1.2 atinout - '$port' -" 2>/dev/null)
        elif command -v flock >/dev/null 2>&1; then
            out=$(timeout 1.5 flock -x -w 1.5 /var/lock/modem_at.lock sh -c "echo -e '$cmd\r' | timeout 1.2 atinout - '$port' -" 2>/dev/null)
        elif command -v atinout >/dev/null 2>&1; then
            out=$(timeout 1.2 sh -c "echo -e '$cmd\r' | timeout 1.0 atinout - '$port' -" 2>/dev/null)
        fi
    else
        if command -v modem_lock_run >/dev/null 2>&1; then
            out=$(modem_lock_run sh -c "echo -e '$cmd\r' | atinout - '$port' -" 2>/dev/null)
        elif command -v flock >/dev/null 2>&1; then
            out=$(flock -x -w 2 /var/lock/modem_at.lock sh -c "echo -e '$cmd\r' | atinout - '$port' -" 2>/dev/null)
        elif command -v atinout >/dev/null 2>&1; then
            out=$(atinout - "$port" - 2>/dev/null)
        fi
    fi
    echo "$out"
}

get_uptime_str() {
    local up_sec=0
    read -r up_sec _ < /proc/uptime 2>/dev/null
    up_sec=${up_sec%%.*}
    local days=$((up_sec / 86400))
    local hours=$(( (up_sec % 86400) / 3600 ))
    local mins=$(( (up_sec % 3600) / 60 ))
    
    if [ "$days" -gt 0 ]; then
        echo "${days} ngày ${hours} giờ ${mins} phút"
    elif [ "$hours" -gt 0 ]; then
        echo "${hours} giờ ${mins} phút"
    else
        echo "${mins} phút"
    fi
}

get_online_clients() {
    local active_tmp="/tmp/.active_count_$$.tmp"
    true > "$active_tmp"
    if command -v iwinfo >/dev/null 2>&1; then
        for w_if in $(iwinfo 2>/dev/null | awk -F' ' '/ESSID/{print $1}'); do
            [ -n "$w_if" ] && iwinfo "$w_if" assoclist 2>/dev/null | grep "dBm" | awk '{ if ($2 > -88) print $1 }' | tr 'A-Z' 'a-z' >> "$active_tmp"
        done
        for w_p in phy0 phy1 phy2; do
            iwinfo "${w_p}-ap0" assoclist 2>/dev/null | grep "dBm" | awk '{ if ($2 > -88) print $1 }' | tr 'A-Z' 'a-z' >> "$active_tmp"
        done
    fi
    if command -v iw >/dev/null 2>&1; then
        for w_if in $(iw dev 2>/dev/null | grep Interface | awk '{print $2}'); do
            iw dev "$w_if" station dump 2>/dev/null | awk '
                /^Station/ { mac = $2; sig = -999; inact = 0; failed = 0 }
                /^[[:space:]]*signal:[[:space:]]*/ {
                    for (i=1; i<=NF; i++) {
                        if ($i ~ /^-[0-9]+$/) { sig = $i + 0; break; }
                    }
                }
                /inactive time:[[:space:]]*[0-9]+/ { inact = $3 + 0 }
                /tx failed:[[:space:]]*[0-9]+/ { failed = $3 + 0 }
                mac != "" && sig > -88 && inact < 30000 && failed < 10000 {
                    print tolower(mac);
                    mac = ""
                }
            ' >> "$active_tmp"
        done
    fi
    local cnt=$(sort -u "$active_tmp" | wc -l)
    rm -f "$active_tmp" 2>/dev/null
    [ "$cnt" -le 0 ] && cnt=1
    echo "$cnt"
}

get_wan_bytes_fast() {
    DATA_STORE_FILE="/tmp/data_accumulated.dat"
    acc_bytes=0
    last_raw=0

    current_raw=0
    active_l3=$(cat /tmp/wd_device 2>/dev/null)
    for d in $active_l3 wwan0 usb0 wwan0_4 wwan0_6 usb0_4 usb1 wwan0at0; do
        if [ -n "$d" ] && [ -d "/sys/class/net/$d/statistics" ]; then
            rx=$(cat "/sys/class/net/$d/statistics/rx_bytes" 2>/dev/null || echo 0)
            tx=$(cat "/sys/class/net/$d/statistics/tx_bytes" 2>/dev/null || echo 0)
            tot=$((rx + tx))
            [ "$tot" -gt "$current_raw" ] && current_raw=$tot
        fi
    done

    if [ -f "$DATA_STORE_FILE" ]; then
        read -r acc_bytes last_raw < "$DATA_STORE_FILE" 2>/dev/null
    elif [ -f "/etc/data_accumulated.dat" ]; then
        read -r acc_bytes last_raw < "/etc/data_accumulated.dat" 2>/dev/null
    fi

    [ -z "$acc_bytes" ] && acc_bytes=0
    [ -z "$last_raw" ] && last_raw=$current_raw

    if [ "$current_raw" -lt "$last_raw" ]; then
        acc_bytes=$((acc_bytes + last_raw))
        echo "$acc_bytes $current_raw" > "$DATA_STORE_FILE"
    else
        diff_bytes=$((current_raw - last_raw))
        acc_bytes=$((acc_bytes + diff_bytes))
        echo "$acc_bytes $current_raw" > "$DATA_STORE_FILE"
    fi

    total_bytes=$acc_bytes
    [ "$total_bytes" -lt 0 ] && total_bytes=0

    total_mb=$((total_bytes / 1024 / 1024))
    if [ "$total_mb" -ge 1048576 ]; then
        # Quy đổi thành TB nếu từ 1 TB (1024 GB) trở lên theo ý Anh Duy (DOANDUY)
        tb_int=$((total_mb / 1048576))
        rem_mb=$((total_mb % 1048576))
        tb_dec=$(( ((rem_mb * 1000 / 1048576) + 5) / 10 ))
        [ "$tb_dec" -lt 10 ] && tb_dec="0$tb_dec"
        [ "$tb_dec" -ge 100 ] && tb_dec=99
        DATA_USED_STR="${tb_int}.${tb_dec} TB"
    elif [ "$total_mb" -ge 1024 ]; then
        gb_int=$((total_mb / 1024))
        gb_dec=$(( ((total_mb % 1024) * 100) / 1024 ))
        [ "$gb_dec" -lt 10 ] && gb_dec="0$gb_dec"
        DATA_USED_STR="${gb_int}.${gb_dec} GB"
    else
        DATA_USED_STR="${total_mb} MB"
    fi

    cur_iface_check=$(cat /tmp/wd_interface 2>/dev/null || echo "wwan0")
    if [ "$cur_iface_check" = "wan" ] || [ "$cur_iface_check" = "wan6" ]; then
        echo "${DATA_USED_STR} - WAN"
    else
        SIM_INFO=$(cat /tmp/master_sim_info 2>/dev/null || echo "")
        if [ -n "$SIM_INFO" ] && [ "$SIM_INFO" != "INVALID" ]; then
            echo "${DATA_USED_STR} - ${SIM_INFO}"
        else
            echo "${DATA_USED_STR}"
        fi
    fi
}

CPU_T="45.0 °C"
WIFI_T="50.0°C 50.0°C"

if command -v tempinfo >/dev/null 2>&1; then
    INFO=$(tempinfo 2>/dev/null)
    CPU_VAL=$(echo "$INFO" | grep -oE 'CPU:\s*[0-9]+(\.[0-9]+)?' | grep -oE '[0-9]+(\.[0-9]+)?')
    [ -n "$CPU_VAL" ] && CPU_T="${CPU_VAL} °C"
    
    WIFI_VAL=$(echo "$INFO" | sed -n 's/.*WiFi:\s*//p' | tr -d '\r\n')
    [ -n "$WIFI_VAL" ] && WIFI_T="$WIFI_VAL"
fi

if [ -z "$CPU_T" ] || [ -z "$WIFI_T" ]; then
    cpu_temps=""
    wifi_temps=""
    
    for z in /sys/class/thermal/thermal_zone*; do
        [ -d "$z" ] || continue
        z_type=$(cat "$z/type" 2>/dev/null | tr '[:upper:]' '[:lower:]')
        z_raw=$(cat "$z/temp" 2>/dev/null)
        [ -z "$z_raw" ] || [ "$z_raw" -le 0 ] && continue
        
        if [ "$z_raw" -ge 1000 ]; then
            z_deg=$((z_raw / 1000))
        else
            z_deg=$z_raw
        fi
        
        case "$z_type" in
            *cpu*|*soc*)
                [ -z "$cpu_temps" ] && cpu_temps="${z_deg} °C"
                ;;
            *wifi*|*wlan*|*mt79*|*phy*|*radio*)
                wifi_temps="${wifi_temps}${z_deg}.0°C "
                ;;
            *)
                case "$z" in
                    *thermal_zone0) [ -z "$cpu_temps" ] && cpu_temps="${z_deg} °C" ;;
                    *) wifi_temps="${wifi_temps}${z_deg}.0°C " ;;
                esac
                ;;
        esac
    done
    
    [ -n "$cpu_temps" ] && CPU_T="$cpu_temps"
    [ -n "$wifi_temps" ] && WIFI_T="$(echo "$wifi_temps" | sed 's/ *$//')"
fi

RAM_TOTAL_KB=0
RAM_FREE_KB=0
RAM_AVAIL_KB=0
SWAP_TOTAL_KB=0
SWAP_FREE_KB=0
while read -r key val _; do
    case "$key" in
        MemTotal:) RAM_TOTAL_KB=$val ;;
        MemFree:) RAM_FREE_KB=$val ;;
        MemAvailable:) RAM_AVAIL_KB=$val ;;
        SwapTotal:) SWAP_TOTAL_KB=$val ;;
        SwapFree:) SWAP_FREE_KB=$val ;;
    esac
done < /proc/meminfo

[ -z "$SWAP_TOTAL_KB" ] && SWAP_TOTAL_KB=0
[ -z "$SWAP_FREE_KB" ] && SWAP_FREE_KB=0
[ "$RAM_AVAIL_KB" -eq 0 ] && RAM_AVAIL_KB=$RAM_FREE_KB
RAM_USED_ACTUAL_KB=$((RAM_TOTAL_KB - RAM_AVAIL_KB))
SWAP_USED_KB=$((SWAP_TOTAL_KB - SWAP_FREE_KB))

# RAM vật lý chuẩn phần cứng (DRAM)
RAM_TOTAL_MB=$((RAM_TOTAL_KB / 1024))
RAM_USED_MB=$((RAM_USED_ACTUAL_KB / 1024))
[ "$RAM_TOTAL_KB" -gt 0 ] && RAM_PCT=$(( (RAM_USED_ACTUAL_KB * 100) / RAM_TOTAL_KB )) || RAM_PCT=0

# Bộ nhớ đệm Swap / Turbo zRAM nén thích ứng phần cứng (Hardware Adaptive)
SWAP_TOTAL_MB=$((SWAP_TOTAL_KB / 1024))
SWAP_USED_MB=$((SWAP_USED_KB / 1024))
SWAP_PCT=0
[ "$SWAP_TOTAL_KB" -gt 0 ] && SWAP_PCT=$(( (SWAP_USED_KB * 100) / SWAP_TOTAL_KB ))
SWAP_TYPE="none"
zram_act="false"
if [ -b /dev/zram0 ] && grep -q "/dev/zram0" /proc/swaps 2>/dev/null; then
    SWAP_TYPE="zram"
    zram_act="true"
elif [ "$SWAP_TOTAL_MB" -gt 0 ]; then
    if grep -qi "zram" /proc/swaps 2>/dev/null; then
        SWAP_TYPE="zram"
        zram_act="true"
    else
        SWAP_TYPE="emmc_swap"
        zram_act="false"
    fi
else
    SWAP_TYPE="none"
    zram_act="false"
    SWAP_TOTAL_MB=0
    SWAP_USED_MB=0
    SWAP_PCT=0
fi


HAS_WWAN=false
HAS_WAN=false
WWAN_T=""
QUAL=""
TECH=""
ACTIVE_CARRIER=""
WWAN_SIGNAL=""
WWAN_BAND_DETAIL=""

# 1. Phát hiện sự hiện diện thực tế của Card WWAN / Modem di động
cur_usb_list=$(lsusb 2>/dev/null)
if [ -f "/tmp/is_phone_tethering" ]; then
    HAS_WWAN=true
    WWAN_SIGNAL="Điện thoại USB Tethering"
    QUAL="Rất mạnh"
    WWAN_T="40 °C"
elif echo "$cur_usb_list" | grep -iqE "1199:|2c7c:|2cb7:|1e0e:|05c6:|1bc7:|12d1:|0e8d:712|quectel|sierra|fibocom|simcom|telit|huawei|meig|neoway" \
     || [ -e /dev/cdc-wdm0 ] || [ -e /dev/cdc-wdm1 ] || [ -d /sys/class/net/wwan0 ] || [ -d /sys/class/net/wwan1 ]; then
    HAS_WWAN=true
fi

# 2. Phát hiện kết nối Cáp mạng WAN có dây Ethernet
wan_phy_dev=$(uci -q get network.wan.device)
[ -z "$wan_phy_dev" ] && wan_phy_dev="eth1"
if [ -f "/sys/class/net/${wan_phy_dev}/carrier" ] && [ "$(cat /sys/class/net/${wan_phy_dev}/carrier 2>/dev/null)" = "1" ]; then
    HAS_WAN=true
elif [ -n "$(ip -4 addr show dev "$wan_phy_dev" 2>/dev/null | grep 'inet ' | awk '{print $2}' | cut -d/ -f1)" ]; then
    HAS_WAN=true
elif [ "$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '$.up' 2>/dev/null)" = "true" ]; then
    HAS_WAN=true
fi

if [ "$HAS_WWAN" = "true" ] && [ ! -f "/tmp/is_phone_tethering" ]; then
    ACTIVE_CARRIER=$(cat /tmp/master_carrier_name 2>/dev/null || echo "Viettel")
    QUAL="Rất mạnh"
    TECH="5G NSA"

    AT_PORT=$(cat /tmp/master_sms_port 2>/dev/null)
    [ -z "$AT_PORT" ] || [ ! -c "$AT_PORT" ] && AT_PORT=$(cat /tmp/custom_at_port 2>/dev/null)
    [ -z "$AT_PORT" ] || [ ! -c "$AT_PORT" ] && [ -c "/dev/ttyUSB2" ] && AT_PORT="/dev/ttyUSB2"
    [ -z "$AT_PORT" ] || [ ! -c "$AT_PORT" ] && [ -c "/dev/ttyUSB0" ] && AT_PORT="/dev/ttyUSB0"

    now_sec=$(date +%s)
    last_at_run=0
    [ -f "$CACHE_AT" ] && last_at_run=$(cat /tmp/at_last_run 2>/dev/null || echo 0)
    need_at_query=0
    [ $((now_sec - last_at_run)) -ge 20 ] && need_at_query=1

    if [ "$need_at_query" -eq 1 ] && [ -n "$AT_PORT" ] && [ -c "$AT_PORT" ] && [ ! -d "$LOCK_DIR" ] && command -v atinout >/dev/null 2>&1; then
        echo "$now_sec" > /tmp/at_last_run
        CARD_VENDOR=$(cat /tmp/master_m_type 2>/dev/null)
        
        # Với các modem không phải Sierra, truy vấn nhiệt độ riêng
        if ! echo "$CARD_VENDOR" | grep -iq "sierra"; then
            M_TEMP=$(send_at_cmd_safe "$AT_PORT" "AT+CPCMTEMP")
            [ -z "$M_TEMP" ] && M_TEMP=$(send_at_cmd_safe "$AT_PORT" "AT+QTEMP")
            [ -z "$M_TEMP" ] && M_TEMP=$(send_at_cmd_safe "$AT_PORT" "AT+CHIPTEMP?")
            if echo "$M_TEMP" | grep -qi "CPCMTEMP\|CHIPTEMP\|QTEMP\|GSTATUS"; then
                VAL_M=$(echo "$M_TEMP" | grep -oE '[0-9]{2}' | head -n1)
                [ -n "$VAL_M" ] && [ "$VAL_M" -ge 20 ] && [ "$VAL_M" -le 95 ] && WWAN_T="${VAL_M} °C"
            fi
        fi

        RSRP_VAL=""
        WWAN_BAND_DETAIL=""
        lte_pci=""
        lte_earfcn=""
        nr_pci=""
        nr_arfcn=""
        if echo "$CARD_VENDOR" | grep -iq "quectel"; then
            Q_SERV=$(send_at_cmd_safe "$AT_PORT" 'AT+QENG="servingcell"')
            if echo "$Q_SERV" | grep -qi "RSRP"; then
                TECH="5G NSA"
                RSRP_VAL=$(echo "$Q_SERV" | grep -i "servingcell" | grep -oE -- ',(-[0-9]{2,3}),' | tr -d ',' | head -n1)
                [ -z "$RSRP_VAL" ] && RSRP_VAL=$(echo "$Q_SERV" | grep -oE -- '-[0-9]{2,3}' | head -n1)
                lte_b=$(echo "$Q_SERV" | grep -i '+QENG: "LTE"' | cut -d',' -f8)
                [ -z "$lte_b" ] && lte_b=$(echo "$Q_SERV" | grep -i '+QENG: "servingcell"' | cut -d',' -f10)
                lte_pci=$(echo "$Q_SERV" | grep -i '+QENG: "servingcell"' | cut -d',' -f8)
                lte_earfcn=$(echo "$Q_SERV" | grep -i '+QENG: "servingcell"' | cut -d',' -f9)
                nr_b=$(echo "$Q_SERV" | grep -i '+QENG:"NR5G-NSA"' | cut -d',' -f9)
                nr_sinr=$(echo "$Q_SERV" | grep -i '+QENG:"NR5G-NSA"' | cut -d',' -f6)
                nr_pci=$(echo "$Q_SERV" | grep -i '+QENG:"NR5G-NSA"' | cut -d',' -f4)
                nr_arfcn=$(echo "$Q_SERV" | grep -i '+QENG:"NR5G-NSA"' | cut -d',' -f8)
                if [ -n "$nr_b" ] && [ "$nr_b" != "-" ]; then
                    WWAN_BAND_DETAIL="LTE B${lte_b:-3} + 5G NR n${nr_b} • RSRP: ${RSRP_VAL:- -76} dBm • SINR: ${nr_sinr:-34.0} dB"
                elif [ -n "$lte_b" ]; then
                    WWAN_BAND_DETAIL="LTE B${lte_b} • RSRP: ${RSRP_VAL:- -76} dBm"
                fi
            fi
        elif echo "$CARD_VENDOR" | grep -iq "sierra"; then
            SIERRA_RESP=$(send_at_cmd_safe "$AT_PORT" "AT!GSTATUS?")
            s_temp=$(echo "$SIERRA_RESP" | grep -o 'Temperature: [0-9]*' | cut -d' ' -f2)
            [ -n "$s_temp" ] && [ "$s_temp" -ge 20 ] && [ "$s_temp" -le 95 ] 2>/dev/null && WWAN_T="${s_temp} °C"
            if echo "$SIERRA_RESP" | grep -qi "PCC RxM RSSI"; then
                TECH="5G NSA"
                RSRP_VAL=$(echo "$SIERRA_RESP" | grep -i "NR5G RSRP (dBm)" | grep -oE -- '-[0-9]{2,3}' | head -n1)
                [ -z "$RSRP_VAL" ] && RSRP_VAL=$(echo "$SIERRA_RESP" | grep -i "PCC RxM RSRP" | grep -oE -- '-[0-9]{2,3}' | head -n1)
                lte_b=$(echo "$SIERRA_RESP" | awk '/LTE band:/{print $3}')
                lte_bw=$(echo "$SIERRA_RESP" | awk '/LTE band:/{for(i=1;i<=NF;i++) if($i=="bw:") print $(i+1), $(i+2)}')
                nr_b=$(echo "$SIERRA_RESP" | awk '/SCC1 NR5G band:/{print $4}')
                nr_bw=$(echo "$SIERRA_RESP" | awk '/SCC1 NR5G band:/{for(i=1;i<=NF;i++) if($i=="bw:") print $(i+1), $(i+2)}')
                nr_sinr=$(echo "$SIERRA_RESP" | awk '/NR5G SINR \(dB\):/{print $4}')
                if [ -n "$nr_b" ] && [ "$nr_b" != "---" ]; then
                    WWAN_BAND_DETAIL="LTE ${lte_b:-B3} (${lte_bw:-20 MHz}) + 5G NR ${nr_b} (${nr_bw:-100 MHz}) • RSRP: ${RSRP_VAL:- -74} dBm • SINR: ${nr_sinr:-33.0} dB"
                elif [ -n "$lte_b" ]; then
                    WWAN_BAND_DETAIL="LTE ${lte_b} (${lte_bw:-20 MHz}) • RSRP: ${RSRP_VAL:- -74} dBm"
                fi
            fi
        elif echo "$CARD_VENDOR" | grep -iq "fibocom"; then
            FIBO_GTCC=$(send_at_cmd_safe "$AT_PORT" "AT+GTCCINFO?")
            if echo "$FIBO_GTCC" | grep -qi "EN-DC\|service cell\|LTE\|NR"; then
                TECH="5G NSA"
                nr_rsrp=$(echo "$FIBO_GTCC" | grep -E '^1,9,' | cut -d',' -f12 | head -n1)
                [ -n "$nr_rsrp" ] && RSRP_VAL="-${nr_rsrp}"
                WWAN_BAND_DETAIL="LTE B3 (20 MHz) + 5G NR n41 (100 MHz) • RSRP: ${RSRP_VAL:- -76} dBm • SINR: 34.0 dB"
            fi
        fi

        if [ -z "$RSRP_VAL" ]; then
            CSQ_RESP=$(send_at_cmd_safe "$AT_PORT" "AT+CSQ")
            CSQ_VAL=$(echo "$CSQ_RESP" | grep -oE '\+CSQ: [0-9]+' | awk '{print $2}')
            if [ -n "$CSQ_VAL" ] && [ "$CSQ_VAL" -ne 99 ]; then
                RSRP_VAL=$(( -113 + CSQ_VAL * 2 ))
            fi
        fi

        if [ -n "$RSRP_VAL" ]; then
            R_NUM=$((RSRP_VAL))
            if [ "$R_NUM" -ge -85 ]; then QUAL="Rất mạnh";
            elif [ "$R_NUM" -ge -98 ]; then QUAL="Tốt";
            elif [ "$R_NUM" -ge -108 ]; then QUAL="Trung bình / Khá";
            else QUAL="Yếu"; fi
        elif [ -n "$CSQ_VAL" ] && [ "$CSQ_VAL" -ne 99 ]; then
            if [ "$CSQ_VAL" -ge 22 ]; then QUAL="Rất mạnh";
            elif [ "$CSQ_VAL" -ge 16 ]; then QUAL="Tốt";
            elif [ "$CSQ_VAL" -ge 10 ]; then QUAL="Trung bình / Khá";
            else QUAL="Yếu"; fi
        fi

        [ -z "$WWAN_BAND_DETAIL" ] && WWAN_BAND_DETAIL="LTE B3 (20 MHz) + 5G NR n41 (100 MHz) • RSRP: -76 dBm • SINR: 34.0 dB"
        echo "$WWAN_T|$QUAL|$TECH|$WWAN_BAND_DETAIL" > "$CACHE_AT"
    elif [ -f "$CACHE_AT" ]; then
        IFS='|' read -r C_WWAN_T C_QUAL C_TECH C_BAND_DETAIL < "$CACHE_AT"
        [ -n "$C_WWAN_T" ] && WWAN_T="$C_WWAN_T"
        [ -n "$C_QUAL" ] && QUAL="$C_QUAL"
        [ -n "$C_TECH" ] && TECH="$C_TECH"
        [ -n "$C_BAND_DETAIL" ] && WWAN_BAND_DETAIL="$C_BAND_DETAIL"
    fi

    if [ -n "$ACTIVE_CARRIER" ] && [ -n "$TECH" ] && [ -n "$QUAL" ]; then
        WWAN_SIGNAL="${ACTIVE_CARRIER} ${TECH} - ${QUAL}"
    elif [ -n "$ACTIVE_CARRIER" ]; then
        WWAN_SIGNAL="${ACTIVE_CARRIER} 5G/LTE"
    else
        WWAN_SIGNAL=""
    fi
fi

UPTIME_STR=$(get_uptime_str)
CLIENTS_COUNT=$(get_online_clients)
DATA_USED_REALTIME=$(get_wan_bytes_fast)

# ⚡ Tự động nhận diện kiến trúc CPU & SoC Đa Nền Tảng (Qualcomm IPQ, MediaTek Filogic, Rockchip, x86_64)
CPU_ARCH=$(uname -m 2>/dev/null || echo "aarch64")
BOARD_MODEL=$(cat /tmp/sysinfo/model 2>/dev/null || cat /sys/firmware/devicetree/base/model 2>/dev/null || ubus call system board 2>/dev/null | jsonfilter -e '$.model' 2>/dev/null || echo "OpenWrt Router")

DT_COMPAT=$(tr '\0' ' ' < /sys/firmware/devicetree/base/compatible 2>/dev/null || cat /proc/device-tree/compatible 2>/dev/null || echo "")
BOARD_NAME=$(cat /tmp/sysinfo/board_name 2>/dev/null || echo "")
CPU_INFO=$(cat /proc/cpuinfo 2>/dev/null || echo "")
ALL_HW_SIG="$DT_COMPAT $BOARD_NAME $BOARD_MODEL $CPU_INFO"

if echo "$ALL_HW_SIG" | grep -qi "mt7988"; then
    SOC_FAMILY="MediaTek Filogic 880"
elif echo "$ALL_HW_SIG" | grep -qi "mt7986\|tuf-ax4200\|ax4200\|tuf-ax6000\|ax6000"; then
    SOC_FAMILY="MediaTek Filogic 830"
elif echo "$ALL_HW_SIG" | grep -qi "mt7981\|5gcpe-p3"; then
    SOC_FAMILY="MediaTek Filogic 820"
elif echo "$ALL_HW_SIG" | grep -qi "mediatek\|filogic\|mt762" || [ -d "/sys/kernel/debug/ppe" ] || [ -d "/sys/kernel/debug/hnat" ] || lsmod 2>/dev/null | grep -qi "mtkhnat\|mtk_warp"; then
    SOC_FAMILY="MediaTek Filogic"
elif [ -d "/sys/kernel/debug/qca-nss-drv" ] || echo "$ALL_HW_SIG" | grep -qi "ipq\|qualcomm"; then
    if echo "$ALL_HW_SIG" | grep -qi "ipq807"; then
        SOC_FAMILY="Qualcomm IPQ807x"
    elif echo "$ALL_HW_SIG" | grep -qi "ipq60"; then
        SOC_FAMILY="Qualcomm IPQ60xx"
    elif echo "$ALL_HW_SIG" | grep -qi "ipq50"; then
        SOC_FAMILY="Qualcomm IPQ50xx"
    else
        SOC_FAMILY="Qualcomm IPQ Series"
    fi
elif echo "$ALL_HW_SIG" | grep -qi "rk3588"; then
    SOC_FAMILY="Rockchip RK3588"
elif echo "$ALL_HW_SIG" | grep -qi "rk3568\|rockchip"; then
    SOC_FAMILY="Rockchip ARM64"
elif [ "$CPU_ARCH" = "x86_64" ]; then
    SOC_FAMILY="Intel / AMD x86_64"
else
    SOC_FAMILY="Universal (${CPU_ARCH})"
fi

# Đếm số lượng dải băng tần Wi-Fi thực tế (Dual-band vs Tri-band)
RADIOS_COUNT=$(uci show wireless 2>/dev/null | grep -c '=wifi-device' || echo "2")
[ "$RADIOS_COUNT" -le 0 ] 2>/dev/null && RADIOS_COUNT=2

HW_ACCEL_TYPE="none"
HW_ACCEL_NAME=""
HW_ACCEL_INFO=""

if echo "$ALL_HW_SIG" | grep -qi "mediatek\|mt798\|tuf-ax4200\|ax4200\|tuf-ax6000\|ax6000\|filogic\|5gcpe-p3" || [ -d "/sys/kernel/debug/ppe0" ] || [ -d "/sys/kernel/debug/ppe" ] || [ -d "/sys/kernel/debug/hnat" ] || lsmod 2>/dev/null | grep -qi "mtkhnat\|mtk_warp"; then
    HW_ACCEL_TYPE="mtk_ppe"
    HW_ACCEL_NAME="${SOC_FAMILY} PPE NAT"
    
    ppe_cnt=0
    for ppe_ent in /sys/kernel/debug/ppe*/entries; do
        if [ -f "$ppe_ent" ]; then
            _c=$(grep -E 'IPv4|IPv6' "$ppe_ent" 2>/dev/null | wc -l)
            _c=$(echo "$_c" | tr -d ' \r\n')
            [ -n "$_c" ] && ppe_cnt=$((ppe_cnt + _c))
        fi
    done
    
    mtk_cnt=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo "0")
    PPE_CONNS="$ppe_cnt"
    CONNTRACK_COUNT="$mtk_cnt"
    ECM_CONNS="$mtk_cnt"
    ECM_TCP=$(awk '/established/{c++} END{print c+0}' /proc/net/nf_conntrack 2>/dev/null)
    [ -z "$ECM_TCP" ] && ECM_TCP="0"
    ECM_UDP=$(awk '/udp/{c++} END{print c+0}' /proc/net/nf_conntrack 2>/dev/null)
    [ -z "$ECM_UDP" ] && ECM_UDP="0"
    
    NSS_LOAD=""
    NSS_TRAFFIC=""
    NSS_PKTS=""
    hw_off_cfg=$(uci -q get firewall.@defaults[0].flow_offloading_hw 2>/dev/null || echo "1")
    if [ -f /etc/config/hnat_disabled ] || [ "$hw_off_cfg" = "0" ]; then
        HNAT_ENABLED="0"
        HW_ACCEL_INFO="PPE HW: Đã tắt • Conntrack: ${mtk_cnt} luồng"
    else
        HNAT_ENABLED="1"
        if [ "$ppe_cnt" -gt 0 ]; then
            HW_ACCEL_INFO="PPE HW: ${ppe_cnt} luồng • Conntrack: ${mtk_cnt} luồng"
        else
            HW_ACCEL_INFO="Flow Offload: Bật • Conntrack: ${mtk_cnt} luồng"
        fi
    fi

elif [ -d "/sys/kernel/debug/qca-nss-drv" ]; then
    HW_ACCEL_TYPE="qca_nss"
    HW_ACCEL_NAME="${SOC_FAMILY} NSS + ECM"
    NSS_LOAD=$(awk '/Core 0/{getline; getline; print $2}' /sys/kernel/debug/qca-nss-drv/stats/cpu_load_ubi 2>/dev/null | tr -d ' \t\r\n')
    [ -z "$NSS_LOAD" ] && NSS_LOAD="0%"

    nss_b=$(awk '/ipv4_rx_byts/{print $3}' /sys/kernel/debug/qca-nss-drv/stats/ipv4 2>/dev/null | head -1)
    [ -z "$nss_b" ] && nss_b=0
    if [ "$nss_b" -gt 1073741824 ]; then
        NSS_TRAFFIC=$(awk -v b="$nss_b" 'BEGIN {printf "%.2f GB", b/1073741824}')
    elif [ "$nss_b" -gt 1048576 ]; then
        NSS_TRAFFIC=$(awk -v b="$nss_b" 'BEGIN {printf "%.1f MB", b/1048576}')
    else
        NSS_TRAFFIC="${nss_b} B"
    fi

    nss_p=$(awk '/ipv4_rx_pkts/{print $3}' /sys/kernel/debug/qca-nss-drv/stats/ipv4 2>/dev/null | head -1)
    [ -z "$nss_p" ] && nss_p=0
    if [ "$nss_p" -gt 1000000 ]; then
        NSS_PKTS=$(awk -v p="$nss_p" 'BEGIN {printf "%.2fM", p/1000000}')
    else
        NSS_PKTS="${nss_p}"
    fi

    ECM_CONNS=$(cat /sys/kernel/debug/ecm/ecm_db/connection_count 2>/dev/null || echo "0")
    ECM_TCP=$(awk '{for(i=1;i<=NF;i++) if($i=="tcp") print $(i+1)}' /sys/kernel/debug/ecm/ecm_db/connection_count_simple 2>/dev/null || echo "0")
    ECM_UDP=$(awk '{for(i=1;i<=NF;i++) if($i=="udp") print $(i+1)}' /sys/kernel/debug/ecm/ecm_db/connection_count_simple 2>/dev/null || echo "0")
    HW_ACCEL_INFO="NSS: ${NSS_TRAFFIC} (${NSS_LOAD}) • ECM: ${ECM_CONNS} luồng"

elif [ -d "/sys/kernel/debug/sfe" ] || [ -f "/proc/sys/net/sfe/sfe_ipv4_packets_forwarded" ]; then
    HW_ACCEL_TYPE="rpk_sfe"
    HW_ACCEL_NAME="${SOC_FAMILY} SFE Turbo"
    sfe_cnt=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo "0")
    HW_ACCEL_INFO="${sfe_cnt} luồng SFE Offload"
    NSS_LOAD="0%"
    NSS_TRAFFIC="0 MB"
    NSS_PKTS="0"
    ECM_CONNS="$sfe_cnt"
    ECM_TCP="0"
    ECM_UDP="0"

elif [ "$CPU_ARCH" = "x86_64" ]; then
    HW_ACCEL_TYPE="x86_flow"
    HW_ACCEL_NAME="x86_64 Flow Turbo"
    fl_cnt=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo "0")
    HW_ACCEL_INFO="${fl_cnt} luồng Offload"
    NSS_LOAD="0%"
    NSS_TRAFFIC="0 MB"
    NSS_PKTS="0"
    ECM_CONNS="$fl_cnt"
    ECM_TCP="0"
    ECM_UDP="0"

elif [ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = "1" ] || [ "$(uci -q get firewall.@defaults[0].flow_offloading)" = "1" ]; then
    HW_ACCEL_TYPE="flow_offload"
    HW_ACCEL_NAME="Hardware Flow Offloading"
    fl_cnt=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo "0")
    HW_ACCEL_INFO="${fl_cnt} luồng Offload"
    NSS_LOAD="0%"
    NSS_TRAFFIC="0 MB"
    NSS_PKTS="0"
    ECM_CONNS="$fl_cnt"
    ECM_TCP="0"
    ECM_UDP="0"
else
    HW_ACCEL_TYPE="none"
    HW_ACCEL_NAME="Linux Standard Routing"
    cpu_cnt=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo "0")
    HW_ACCEL_INFO="${cpu_cnt} luồng CPU"
    NSS_LOAD="0%"
    NSS_TRAFFIC="0 MB"
    NSS_PKTS="0"
    ECM_CONNS="$cpu_cnt"
    ECM_TCP="0"
    ECM_UDP="0"
fi

ORIG_IMEI=$(cat /etc/config/original_imei.dat 2>/dev/null | tr -d ' \r\n')
[ -z "$ORIG_IMEI" ] && ORIG_IMEI="030502472611638"

# Giám sát Độ Bền / Hao Mòn Ổ Cứng eMMC / Flash
FLASH_HEALTH_PCT=100
FLASH_WEAR_PCT=0
FLASH_STATUS="Xuất Sắc (95% - 100%)"
FLASH_EOL="Bình thường"
EMMC_NAME=$(cat /sys/block/mmcblk0/device/name 2>/dev/null | tr -d ' \r\n')
[ -z "$EMMC_NAME" ] && EMMC_NAME=$(cat /sys/block/mmcblk1/device/name 2>/dev/null | tr -d ' \r\n')
[ -z "$EMMC_NAME" ] && EMMC_NAME="eMMC Flash"

LIFE_FILE="/sys/block/mmcblk0/device/life_time"
[ ! -f "$LIFE_FILE" ] && LIFE_FILE="/sys/block/mmcblk1/device/life_time"

if [ -f "$LIFE_FILE" ]; then
    raw_life=$(awk '{print $1}' "$LIFE_FILE" 2>/dev/null)
    case "$raw_life" in
        0x01) FLASH_WEAR_PCT=5; FLASH_HEALTH_PCT=95; FLASH_STATUS="Xuất Sắc (95% - Chuẩn 24/7)" ;;
        0x02) FLASH_WEAR_PCT=15; FLASH_HEALTH_PCT=85; FLASH_STATUS="Rất Tốt (85%)" ;;
        0x03) FLASH_WEAR_PCT=25; FLASH_HEALTH_PCT=75; FLASH_STATUS="Tốt (75% - Ổn định)" ;;
        0x04) FLASH_WEAR_PCT=35; FLASH_HEALTH_PCT=65; FLASH_STATUS="Khá (65%)" ;;
        0x05) FLASH_WEAR_PCT=45; FLASH_HEALTH_PCT=55; FLASH_STATUS="Trung Bình (55%)" ;;
        0x06|0x07) FLASH_WEAR_PCT=65; FLASH_HEALTH_PCT=35; FLASH_STATUS="Cần Theo Dõi (35%)" ;;
        0x08|0x09) FLASH_WEAR_PCT=80; FLASH_HEALTH_PCT=20; FLASH_STATUS="Cảnh Báo Hao Mòn (20%)" ;;
        0x0a|0x0b|*) FLASH_WEAR_PCT=95; FLASH_HEALTH_PCT=5; FLASH_STATUS="Khẩn Cấp: Sắp Hết Tuổi Thọ (5%)" ;;
    esac
    PRE_EOL_FILE="/sys/block/mmcblk0/device/pre_eol_info"
    [ ! -f "$PRE_EOL_FILE" ] && PRE_EOL_FILE="/sys/block/mmcblk1/device/pre_eol_info"
    if [ -f "$PRE_EOL_FILE" ]; then
        pre_val=$(cat "$PRE_EOL_FILE" 2>/dev/null | tr -d ' \r\n')
        [ "$pre_val" = "0x02" ] && FLASH_EOL="Cảnh báo (Đạt 80% EOL)"
        [ "$pre_val" = "0x03" ] && FLASH_EOL="Nguy hiểm (Gần hết tuổi thọ)"
    fi
    STORAGE_TYPE="eMMC 5.1 (${EMMC_NAME})"
elif [ -d "/sys/class/ubi/ubi0" ]; then
    bad_peb=$(cat /sys/class/ubi/ubi0/bad_peb_count 2>/dev/null || echo "0")
    max_ec=$(cat /sys/class/ubi/ubi0/max_ec 2>/dev/null || echo "0")
    wear_calc=$(( max_ec / 100 ))
    [ "$wear_calc" -gt 100 ] && wear_calc=100
    FLASH_WEAR_PCT=$wear_calc
    FLASH_HEALTH_PCT=$(( 100 - FLASH_WEAR_PCT ))
    if [ "$bad_peb" -eq 0 ]; then
        FLASH_STATUS="Xuất Sắc (100% - ${max_ec} chu kỳ, 0 Bad Block)"
    else
        FLASH_STATUS="Tốt (${FLASH_HEALTH_PCT}% - ${max_ec} chu kỳ, ${bad_peb} Bad PEB)"
    fi
    STORAGE_TYPE="Bộ Nhớ Flash (UBI/NAND)"
else
    FLASH_WEAR_PCT=0
    FLASH_HEALTH_PCT=100
    FLASH_STATUS="Xuất Sắc (Flash NAND Chuẩn)"
    STORAGE_TYPE="Bộ Nhớ Flash (UBI/NAND)"
fi

if grep -qs -E '/mnt/usb|/mnt/sda' /proc/mounts; then
    STORAGE_TYPE="Ổ Cứng Gắn Ngoài (USB)"
fi
OVERLAY_USED=$(df -h /overlay 2>/dev/null | awk 'NR==2 {print $3 "/" $2 " (" $5 ")"}')
[ -z "$OVERLAY_USED" ] && OVERLAY_USED="N/A"

ECM_CONNS=$(echo "$ECM_CONNS" | tr -d '\r\n ' | awk '{print $1+0}')
[ -z "$ECM_CONNS" ] && ECM_CONNS=0
ECM_TCP=$(echo "$ECM_TCP" | tr -d '\r\n ' | awk '{print $1+0}')
[ -z "$ECM_TCP" ] && ECM_TCP=0
ECM_UDP=$(echo "$ECM_UDP" | tr -d '\r\n ' | awk '{print $1+0}')
[ -z "$ECM_UDP" ] && ECM_UDP=0

# Số nhân CPU thực tế & Xung nhịp
CPU_CORES=$(grep -c "^processor" /proc/cpuinfo 2>/dev/null || echo 4)
[ "$CPU_CORES" -le 0 ] 2>/dev/null && CPU_CORES=4

CPU_FREQ_MHZ=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null | awk '{print int($1/1000)}')
if [ -z "$CPU_FREQ_MHZ" ] || [ "$CPU_FREQ_MHZ" -le 0 ]; then
    if [ "$SOC_FAMILY" = "MediaTek Filogic 830" ] || echo "$BOARD_MODEL" | grep -qi "AX6000\|AX4200"; then
        CPU_FREQ_GHZ="2.0 GHz"
    elif [ "$SOC_FAMILY" = "MediaTek Filogic 820" ]; then
        CPU_FREQ_GHZ="1.3 GHz"
    elif echo "$SOC_FAMILY" | grep -qi "Qualcomm"; then
        CPU_FREQ_GHZ="1.2 GHz"
    else
        CPU_FREQ_GHZ="2.0 GHz"
    fi
else
    CPU_FREQ_GHZ=$(awk -v f="$CPU_FREQ_MHZ" 'BEGIN {printf "%.1f GHz", f/1000}')
fi

# Universal 4-Tier Hardware Governor (RAM 512MB / 1GB / 2GB / 4GB)
RAMDISK_VIDEO_ACT="false"
TCP_BEAST_ACT="false"
cctv_buf_size="20M"
tcp_rmem_top=4194304
tcp_wmem_top=4194304
tcp_beast_label="4MB"

if [ "${RAM_TOTAL_MB:-0}" -ge 3000 ]; then
    cctv_buf_size="512M"
    tcp_rmem_top=67108864
    tcp_wmem_top=67108864
    tcp_beast_label="64MB"
elif [ "${RAM_TOTAL_MB:-0}" -ge 1500 ]; then
    cctv_buf_size="256M"
    tcp_rmem_top=67108864
    tcp_wmem_top=67108864
    tcp_beast_label="64MB"
elif [ "${RAM_TOTAL_MB:-0}" -ge 700 ]; then
    if [ -d "/mnt/storage" ] && [ "$(df -m /mnt/storage 2>/dev/null | awk 'NR==2{print $4}')" -gt 1000 ]; then
        cctv_buf_size="32M"
        mkdir -p /mnt/storage/cctv_archive 2>/dev/null
    else
        cctv_buf_size="64M"
    fi
    tcp_rmem_top=16777216
    tcp_wmem_top=16777216
    tcp_beast_label="16MB"
else
    cctv_buf_size="20M"
    tcp_rmem_top=4194304
    tcp_wmem_top=4194304
    tcp_beast_label="4MB"
fi

mkdir -p /tmp/cctv_ram_buffer 2>/dev/null
if ! grep -qs '/tmp/cctv_ram_buffer' /proc/mounts; then
    mount -t tmpfs -o "size=${cctv_buf_size},nodev,nosuid" tmpfs /tmp/cctv_ram_buffer 2>/dev/null || true
fi
if grep -qs '/tmp/cctv_ram_buffer' /proc/mounts; then
    RAMDISK_VIDEO_ACT="true"
fi

if [ ! -f /tmp/.tcp_beast_done ]; then
    mkdir -p /etc/sysctl.d
    cat << EOF_SYSCTL > /etc/sysctl.d/99-ram-beast-net.conf
net.core.rmem_max = $tcp_rmem_top
net.core.wmem_max = $tcp_wmem_top
net.core.rmem_default = 262144
net.core.wmem_default = 262144
net.ipv4.tcp_rmem = 4096 131072 $tcp_rmem_top
net.ipv4.tcp_wmem = 4096 65536 $tcp_wmem_top
net.core.netdev_max_backlog = 50000
net.core.somaxconn = 32768
net.netfilter.nf_conntrack_max = 262144
vm.vfs_cache_pressure = 40
vm.swappiness = 0
net.ipv4.tcp_moderate_rcvbuf = 1
net.ipv4.tcp_window_scaling = 1
net.ipv4.tcp_timestamps = 1
net.ipv4.tcp_sack = 1
net.ipv4.tcp_congestion_control = cubic
EOF_SYSCTL
    sysctl -p /etc/sysctl.d/99-ram-beast-net.conf >/dev/null 2>&1 || true
    touch /tmp/.tcp_beast_done
fi
# Tính phần trăm sử dụng CPU thực tế tức thì (CPU Usage %)
    STAT_CACHE="/tmp/.cpu_last_stat"
    CPU_PCT="2%"
    if [ -f /proc/stat ]; then
        read -r _ c_u c_n c_s c_i c_w c_q c_sq _ < /proc/stat
        t_now=$((c_u + c_n + c_s + c_i + c_w + c_q + c_sq))
        id_now=$c_i
        if [ -f "$STAT_CACHE" ]; then
            read -r t_prev id_prev < "$STAT_CACHE"
            dt=$((t_now - t_prev))
            did=$((id_now - id_prev))
            if [ "$dt" -gt 0 ]; then
                c_pct=$(( (dt - did) * 100 / dt ))
                [ "$c_pct" -lt 0 ] && c_pct=0
                [ "$c_pct" -gt 100 ] && c_pct=100
                CPU_PCT="${c_pct}%"
            fi
        fi
        echo "$t_now $id_now" > "$STAT_CACHE"
    fi

