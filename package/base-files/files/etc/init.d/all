if action == "adopt_phone" then
    local p_ip = (params.ip or q.ip or ""):gsub("[^0-9.]", "")
    local p_mac = (params.mac or q.mac or ""):lower()
    local p_name = params.name or q.name or "Android Phone NAS"
    local p_port = tonumber(params.port or q.port or "8080") or 8080
    if p_ip == "" then
        print("Content-Type: application/json; charset=utf-8\r\n\r\n{\"success\":false,\"message\":\"IP khÃ´ng há»£p lá»‡\"}")
        return
    end
    local clean_mac = p_mac:gsub("[^a-f0-9]", "")
    local clean_name = p_name:gsub("[^%w%-%_]", "_")
    local folder_path = "DATA NASS/" .. (clean_name ~= "" and clean_name or "Galaxy-Z-Flip5-5G")
    
    -- DÃ² tÃ¬m vÃ  dá»n sáº¡ch cÃ¡c section trÃ¹ng láº·p trong nas_phone báº±ng uci_get
    local found_sec = nil
    local h_sec = io.popen("uci -q show nas_phone | grep '=phone_node' | cut -d'.' -f2 | cut -d'=' -f1")
    if h_sec then
        for s in h_sec:lines() do
            local s_mac = (uci_get("nas_phone." .. s .. ".mac", "")):lower()
            local s_ip = uci_get("nas_phone." .. s .. ".ip", "")
            local s_name = (uci_get("nas_phone." .. s .. ".name", "")):lower()
            local is_same = false
            if clean_mac ~= "" and s_mac:gsub("[^a-f0-9]", "") == clean_mac then
                is_same = true
            elseif s_ip ~= "" and s_ip == p_ip then
                is_same = true
            end

            if is_same then
                if not found_sec then
                    found_sec = s
                else
                    os.execute("uci -q delete nas_phone." .. s)
                end
            end
        end
        h_sec:close()
    end
    
    local sec_id = found_sec or (clean_mac ~= "" and ("node_" .. clean_mac) or ("phone_" .. p_ip:gsub("%.", "_")))
    
    os.execute(string.format("touch /etc/config/nas_phone && uci -q set nas_phone.settings=settings && uci -q set nas_phone.settings.phone_ip='%s' && uci -q set nas_phone.%s=phone_node; uci -q set nas_phone.%s.name='%s'; uci -q set nas_phone.%s.ip='%s'; uci -q set nas_phone.%s.mac='%s'; uci -q set nas_phone.%s.port=%d; uci -q set nas_phone.%s.folder='%s'; uci commit nas_phone", p_ip, sec_id, sec_id, p_name, sec_id, p_ip, sec_id, p_mac, sec_id, p_port, sec_id, folder_path))
    
    if clean_mac ~= "" then
        local safe_dhcp_name = (p_name or "phone"):gsub("%s+", "_"):gsub("[^%w_%-]", "")
        if safe_dhcp_name == "" then safe_dhcp_name = "phone_" .. clean_mac end
        os.execute(string.format("uci -q set dhcp.nas_%s=host; uci -q set dhcp.nas_%s.name='%s'; uci -q set dhcp.nas_%s.mac='%s'; uci -q set dhcp.nas_%s.ip='%s'; uci commit dhcp; /etc/init.d/dnsmasq reload >/dev/null 2>&1 &", clean_mac, clean_mac, safe_dhcp_name, clean_mac, p_mac, clean_mac, p_ip))
    end
    
    -- XÃ³a thiáº¿t bá»‹ khá»i /tmp/discovered_phones.json ngay láº­p tá»©c Ä‘á»ƒ banner biáº¿n máº¥t
    local df = io.open("/tmp/discovered_phones.json", "r")
    if df then
        local raw = df:read("*all")
        df:close()
        local safe_ip = p_ip:gsub("%.", "%%.")
        local safe_mac = p_mac:gsub(":", "%%:")
        local new_raw = raw:gsub('%{[^%}]-"ip":"' .. safe_ip .. '"[^%}]-%},?', ''):gsub('%{[^%}]-"mac":"' .. safe_mac .. '"[^%}]-%},?', ''):gsub(',%s*%]', ']'):gsub('%[%s*,', '[')
        local w_df = io.open("/tmp/discovered_phones.json.tmp", "w")
        if w_df then
            w_df:write(new_raw)
            w_df:close()
            os.execute("mv -f /tmp/discovered_phones.json.tmp /tmp/discovered_phones.json")
        end
    end
    
    os.execute("/usr/bin/nas_phone_watchdog.sh trigger '" .. p_ip .. "' >/dev/null 2>&1 &")
    print(string.format("Content-Type: application/json; charset=utf-8\r\n\r\n{\"success\":true,\"message\":\"âœ… ÄÃ£ thÃªm %s (%s) vÃ o cá»¥m NAS thÃ nh cÃ´ng!\"}", p_name, p_ip))
    return
end

if action == "detect_phone_port" then
    local p_ip = (params.ip or q.ip or ""):gsub("[^0-9.]", "")
    if p_ip == "" then
        print("Content-Type: application/json; charset=utf-8\r\n\r\n{\"success\":false,\"message\":\"IP khÃ´ng há»£p lá»‡\"}")
        return
    end
    local detected_port = nil
    local ports = {8080, 8081, 8088, 8888, 2121}
    for _, p in ipairs(ports) do
        local hp = io.popen(string.format("curl -s -m 1 -o /dev/null -w '%%{http_code}' 'http://%s:%d/' 2>/dev/null", p_ip, p))
        if hp then
            local code = hp:read("*l")
            hp:close()
            if code == "200" or code == "401" or code == "404" or code == "301" or code == "302" then
                detected_port = p
                break
            end
        end
    end
    
    local adb_status = false
    local ha = io.popen(string.format("timeout 1 nc %s 5555 </dev/null >/dev/null 2>&1 && echo '1' || echo '0'", p_ip))
    if ha then
        adb_status = (ha:read("*l") == "1")
        ha:close()
    end
    
    if detected_port then
        os.execute(string.format("for s in $(uci -q show nas_phone | grep '=phone_node' | cut -d'.' -f2 | cut -d'=' -f1); do c_ip=$(uci -q get nas_phone.$s.ip); if [ \"$c_ip\" = '%s' ]; then uci set nas_phone.$s.port='%d'; uci commit nas_phone; break; fi; done", p_ip, detected_port))
        print(string.format("Content-Type: application/json; charset=utf-8\r\n\r\n{\"success\":true,\"port\":%d,\"adb\":%s,\"message\":\"âœ… PhÃ¡t hiá»‡n WebDAV cá»•ng %d Ä‘ang trá»±c tuyáº¿n!\"}", detected_port, tostring(adb_status), detected_port))
    else
        print(string.format("Content-Type: application/json; charset=utf-8\r\n\r\n{\"success\":false,\"adb\":%s,\"message\":\"ChÆ°a phÃ¡t hiá»‡n WebDAV trÃªn %s. HÃ£y má»Ÿ á»©ng dá»¥ng WebDAV vÃ  báº¥m START.\"}", tostring(adb_status), p_ip))
    end
    return
end

if action == "wake_phone" then
    local p_ip = (params.ip or q.ip or ""):gsub("[^0-9.]", "")
    local p_mac = (params.mac or q.mac or ""):lower()
    if p_mac ~= "" then
        os.execute("etherwake -b '" .. p_mac .. "' 2>/dev/null &")
    end
    if p_ip ~= "" then
        os.execute(string.format("/usr/bin/nas_phone_watchdog.sh trigger '%s' >/dev/null 2>&1 &", p_ip))
    end
    print("Content-Type: application/json; charset=utf-8\r\n\r\n{\"success\":true,\"message\":\"âš¡ ÄÃ£ phÃ¡t xung Ä‘Ã¡nh thá»©c Wake-on-LAN vÃ  kÃ­ch hoáº¡t dá»‹ch vá»¥ NAS!\"}")
    return
end

if action == "report_phone" then
    local p_ip = (params.ip or q.ip or ""):gsub("[^0-9.]", "")
    local p_name = params.name or q.name or "Galaxy Z Flip 5"
    local bat = tonumber(params.battery or q.battery or "-1") or -1
    local temp = tonumber(params.temp or q.temp or "-1") or -1
    local is_chg = (params.charging == "true" or q.charging == "true" or params.charging == "1" or q.charging == "1") and 1 or 0
    local free_gb = (params.free_gb or q.free_gb or "442.5 GB"):gsub('"', '')
    local total_gb = (params.total_gb or q.total_gb or "512.0 GB"):gsub('"', '')

    if p_ip ~= "" then
        local node_json = string.format('{"name":"%s","ip":"%s","battery":%d,"temp":%d,"charging":%d,"free_gb":"%s","total_gb":"%s","updated":"%s"}',
            p_name, p_ip, bat, temp, is_chg, free_gb, total_gb, os.date("%H:%M:%S"))
        local f = io.open("/tmp/phone_nas_status.json", "w")
        if f then
            f:write(node_json)
            f:close()
        end
    end
    print("Content-Type: application/json; charset=utf-8\r\n\r\n{\"success\":true,\"message\":\"ÄÃ£ nháº­n bÃ¡o cÃ¡o telemetry tá»« Phone NAS!\"}")
    return
end

-- ==============================================================================
-- STREAMING UPLOAD ENGINE (MAX MEMORY USAGE < 64KB)
-- ==============================================================================
if action == "upload" then
    local boundary = os.getenv("CONTENT_TYPE") or ""
    boundary = boundary:match("boundary=(.-)$")
    if not boundary then
        print("Status: 400 Bad Request\r\nContent-Type: text/plain\r\n\r\nNo boundary found")
        return
    end

    local len = tonumber(os.getenv("CONTENT_LENGTH") or 0)
    if len <= 0 then
        print("Status: 411 Length Required\r\nContent-Type: text/plain\r\n\r\nZero length")
        return
    end

    -- LÃ¡ cháº¯n báº£o vá»‡ bá»™ nhá»› Flash / Rootfs: Chá»‘ng trÃ n bá»™ nhá»›
    local st_check = fs.statvfs(current_dir) or fs.statvfs(STORAGE) or fs.statvfs("/overlay")
    if st_check and st_check.bavail and st_check.bsize then
        local free_b = st_check.bavail * st_check.bsize
        local is_flash = not (fs.stat("/sys/block/mmcblk0") or fs.stat("/sys/block/mmcblk1"))
        -- TrÃªn bá»™ nhá»› Flash, yÃªu cáº§u dá»± phÃ²ng tá»‘i thiá»ƒu 15MB cho OpenWrt hoáº¡t Ä‘á»™ng á»•n Ä‘á»‹nh
        local min_reserve = is_flash and (15 * 1024 * 1024) or (50 * 1024 * 1024)
        if len > (free_b - min_reserve) or free_b <= min_reserve then
            print("Status: 507 Insufficient Storage\r\nContent-Type: application/json; charset=utf-8\r\n\r")
            print(string.format('{"status":"ERROR","message":"Bá»™ nhá»› khÃ´ng Ä‘á»§ dung lÆ°á»£ng an toÃ n (Tá»‡p: %s, Kháº£ dá»¥ng: %s, Dá»± phÃ²ng tá»‘i thiá»ƒu: %s). Vui lÃ²ng cáº¯m thÃªm USB hoáº·c xÃ³a bá»›t tá»‡p!"}',
                format_bytes(len), format_bytes(math.max(0, free_b - min_reserve)), format_bytes(min_reserve)))
            return
        end
    end

    local b_start = "--" .. boundary
    local b_end = "--" .. boundary .. "--"
    local chunk_size = 65536
    local buf = ""
    local bytes_left = len
    local target_file = nil
    local out_fp = nil

    local function read_chunk()
        if bytes_left <= 0 then return nil end
        local r = math.min(chunk_size, bytes_left)
        local c = io.read(r)
        if c then bytes_left = bytes_left - #c end
        return c
    end

    while bytes_left > 0 or #buf > 0 do
        if not target_file then
            local chunk = read_chunk()
            if not chunk then break end
            buf = buf .. chunk

            local h_end = buf:find("\r\n\r\n", 1, true)
            if h_end then
                local header = buf:sub(1, h_end + 3)
                local raw_fname = header:match('filename="([^"]+)"')
                if raw_fname then
                    raw_fname = raw_fname:gsub("\\", "/")
                    local rel_dir = raw_fname:match("^(.-)/[^/]+$")
                    local base_fname = raw_fname:match("([^/]+)$") or raw_fname
                    
                    target_file = clean_filename(base_fname)
                    if target_file then
                        local dest_dir = current_dir
                        if rel_dir and #rel_dir > 0 then
                            local clean_rel = clean_path(rel_dir)
                            if clean_rel and #clean_rel > 0 then
                                dest_dir = current_dir .. clean_rel .. "/"
                                fs.mkdirr(dest_dir)
                            end
                        end
                        out_fp = io.open(dest_dir .. target_file, "wb")
                    end
                end
                buf = buf:sub(h_end + 4)
            end
        else
            local next_chunk = read_chunk()
            if next_chunk then buf = buf .. next_chunk end

            local b_pos = buf:find(b_start, 1, true)
            if b_pos then
                local data_to_write = buf:sub(1, b_pos - 3)
                if out_fp and #data_to_write > 0 then
                    out_fp:write(data_to_write)
                end
                break
            else
                local safe_len = #buf - (#b_start + 16)
                if safe_len > 0 then
                    local data_to_write = buf:sub(1, safe_len)
                    if out_fp then out_fp:write(data_to_write) end
                    buf = buf:sub(safe_len + 1)
                end
            end
            if not next_chunk and bytes_left <= 0 then break end
        end
    end

    if out_fp then out_fp:close() end

    print("Content-Type: application/json\r\n\r\n{\"status\":\"OK\",\"name\":\"" .. (target_file or "unknown") .. "\"}")
    return
end

-- ==============================================================================
-- Auto-provision cluster folders in root cleanly without pollution
if subfolder == "" then
    fs.mkdirr(STORAGE .. "Cloud_Sync")
    fs.mkdirr(STORAGE .. "Phones")
    fs.mkdirr(STORAGE .. "Documents")
    fs.mkdirr(STORAGE .. "Photos")
    fs.mkdirr(STORAGE .. "Movies")
    fs.mkdirr(STORAGE .. "Music")
    fs.mkdirr(STORAGE .. "Downloads")
    uci:foreach("nas_phone", "cloud_account", function(s)
        if s.subfolder and s.subfolder ~= "" then
            local sub_path = STORAGE .. clean_path(s.subfolder)
            fs.mkdirr(sub_path)
            local r_dir = (s.remote_folder and s.remote_folder ~= "rm3000") and s.remote_folder or ""
            if r_dir ~= "" then
                fs.mkdirr(sub_path .. "/" .. clean_path(r_dir))
            end
        end
    end)
end

local files = {}
local seen_names = {}

-- Virtual phone listing when browsing Phones directory
if subfolder == "Phones" or subfolder == "Phones/" then
    uci:foreach("nas_phone", "phone_node", function(s)
        local p_name = s.name or s.ip or "Phone Node"
        local is_online = false
        local bat_str = ""
        local p_ip = s.ip or ""
        if s.battery and tonumber(s.battery) and tonumber(s.battery) >= 0 then
            bat_str = " (" .. s.battery .. "%" .. (s.charging == "1" and " âš¡" or "") .. ")"
        end
        if p_ip ~= "" then
            local p_test = os.execute("ping -c 1 -W 1 '" .. p_ip:gsub("[^0-9.]", "") .. "' >/dev/null 2>&1")
            is_online = (p_test == 0)
        end
        local dname = p_name:gsub("[^%w_%-]", "_")
        if not seen_names[dname] then
            seen_names[dname] = true
            table.insert(files, string.format(
                '{"name":"%s","is_dir":true,"type":"folder","ext":"phone","size":0,"size_str":"%s","date":"%s"}',
                dname:gsub('"', '\\"'), is_online and ("ðŸŸ¢ Online" .. bat_str) or "ðŸ”´ Offline", is_online and "Sáºµn sÃ ng" or "Máº¥t káº¿t ná»‘i"
            ))
        end
    end)
end

-- WebDAV query when opening a specific phone
if subfolder:match("^Phone_") or (subfolder:match("^Phones/") and subfolder ~= "Phones" and subfolder ~= "Phones/") then
    local raw_phone_path = subfolder:gsub("^Phones/", ""):gsub("^Phone_", "")
    local phone_slug = raw_phone_path:match("^([^/]+)") or raw_phone_path
    local phone_sub = raw_phone_path:match("^[^/]+/(.+)$") or ""

    local target_ip, target_port
    uci:foreach("nas_phone", "phone_node", function(s)
        local s_name_slug = (s.name or ""):gsub("[^%w_%-]", "_")
        local s_ip_slug = (s.ip or ""):gsub("%.", "_")
        if phone_slug == s_name_slug or phone_slug:find(s_ip_slug, 1, true) or (s.ip and phone_slug:find(s.ip, 1, true)) then
            target_ip = s.ip
            target_port = s.port or "8080"
            return false
        end
    end)
    if not target_ip then
        target_ip = uci_get("nas_phone.settings.phone_ip", "")
        target_port = uci_get("nas_phone.settings.phone_port", "8080")
    end

    -- Auto-fallback: if target_ip is unreachable on target_port, check nas_phone.settings.phone_ip or scan /tmp/dhcp.leases
    local is_port_ok = false
    if target_ip and target_ip ~= "" then
        local chk = os.execute(string.format("curl -s -m 1 -o /dev/null 'http://%s:%s/' 2>/dev/null", target_ip, target_port or "8080"))
        if chk == 0 then is_port_ok = true end
    end
    if not is_port_ok then
        local fallback_ip = uci_get("nas_phone.settings.phone_ip", "")
        if fallback_ip ~= "" and fallback_ip ~= target_ip then
            local chk2 = os.execute(string.format("curl -s -m 1 -o /dev/null 'http://%s:%s/' 2>/dev/null", fallback_ip, target_port or "8080"))
            if chk2 == 0 then
                target_ip = fallback_ip
                is_port_ok = true
            end
        end
    end
    if not is_port_ok then
        local lf = io.open("/tmp/dhcp.leases", "r")
        if lf then
            for line in lf:lines() do
                local _, l_mac, l_ip, l_host = line:match("(%d+)%s+([%w:]+)%s+([%d%.]+)%s+(%S+)")
                if l_ip and l_host and (l_host:lower():find("nass") or l_host:lower():find("flip") or l_host:lower():find("galaxy")) then
                    local chk3 = os.execute(string.format("curl -s -m 1 -o /dev/null 'http://%s:8080/' 2>/dev/null", l_ip))
                    if chk3 == 0 then
                        target_ip = l_ip
                        target_port = "8080"
                        is_port_ok = true
                        break
                    end
                end
            end
            lf:close()
        end
    end

    if target_ip and target_ip ~= "" then
        local dav_sub = ""
        if phone_sub ~= "" then
            dav_sub = phone_sub:gsub("([^%w%-%_%.%~%/])", function(c) return string.format("%%%02X", string.byte(c)) end)
            if not dav_sub:match("/$") then dav_sub = dav_sub .. "/" end
        end
        local p = io.popen(string.format("curl -s -m 2 -X PROPFIND 'http://%s:%s/%s' 2>/dev/null", target_ip, target_port or "8080", dav_sub))
        if p then
            local xml = p:read("*a")
            p:close()
            if xml and xml:find("<D:response>") then
                for resp in xml:gmatch("<D:response>.-</D:response>") do
                    local href = resp:match("<D:href>(.-)</D:href>") or ""
                    local dname = resp:match("<D:displayname>(.-)</D:displayname>") or ""
                    local is_col = resp:find("<D:collection/>") ~= nil or resp:find("<collection/>") ~= nil
                    local clen = tonumber(resp:match("<D:getcontentlength>(%d+)</D:getcontentlength>")) or 0
                    local lmod = resp:match("<D:getlastmodified>(.-)</D:getlastmodified>") or ""

                    dname = dname:gsub("/$", "")
                    if dname == "" then
                        dname = href:gsub("/$", ""):match("([^/]+)$") or ""
                    end

                    local is_self = (href == "/" or href == "/" .. dav_sub or href == dav_sub or dname == "DATA NASS" or dname == "")
                    if not is_self and not seen_names[dname] then
                        seen_names[dname] = true
                        local ftype, ext = get_file_type(dname, is_col)
                        table.insert(files, string.format(
                            '{"name":"%s","is_dir":%s,"type":"%s","ext":"%s","size":%d,"size_str":"%s","date":"%s"}',
                            dname:gsub('"', '\\"'), is_col and "true" or "false", ftype, ext,
                            clen, is_col and "-" or format_bytes(clen), lmod
                        ))
                    end
                end
            end
        end
    end
end

local iter = fs.dir(current_dir)
if iter then
    for fname in iter do
        if fname ~= "." and fname ~= ".." and not fname:match("^%.") and not seen_names[fname] then
            -- Hide legacy or orphaned Phone_* folders from Root view
            local is_junk_phone = (subfolder == "" and fname:match("^Phone_"))
            if not is_junk_phone then
                seen_names[fname] = true
                local full = current_dir .. fname
                local st = fs.stat(full)
                if st then
                    local is_dir = (st.type == "dir")
                    local fsize = is_dir and 0 or (st.size or 0)
                    local mtime = st.mtime or 0
                    local date_str = os.date("%H:%M %d/%m/%Y", mtime)
                    local ftype, ext = get_file_type(fname, is_dir)

                    table.insert(files, string.format(
                        '{"name":"%s","is_dir":%s,"type":"%s","ext":"%s","size":%d,"size_str":"%s","date":"%s"}',
                        fname:gsub('"', '\\"'), is_dir and "true" or "false", ftype, ext,
                        fsize, is_dir and "-" or format_bytes(fsize), date_str
                    ))
                end
            end
        end
    end
end

table.sort(files, function(a, b)
    local is_dir_a = a:find('"is_dir":true', 1, true) ~= nil
    local is_dir_b = b:find('"is_dir":true', 1, true) ~= nil
    if is_dir_a and not is_dir_b then return true end
    if not is_dir_a and is_dir_b then return false end
    return a:lower() < b:lower()
end)

print("Content-Type: application/json\r\nCache-Control: no-cache\r\n\r")
print("[" .. table.concat(files, ",") .. "]")

