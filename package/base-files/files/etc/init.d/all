            meshStatusCard,
            E('div', { style: 'display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-top: 16px; padding: 14px; background: #ffffff; border-radius: 8px; border: 1px solid #e2e8f0;' }, [
