        var emergencyAudioCtx = null;
        var emergencyRingTimer = null;

        function stopEmergencyTelephoneRingtone() {
            if (emergencyRingTimer) {
                clearInterval(emergencyRingTimer);
                emergencyRingTimer = null;
            }
            var oldModal = document.getElementById('ai-call-emergency-modal');
            if (oldModal) oldModal.remove();
        }

        function playEmergencyTelephoneRingtone() {
            try {
                if (!window.AudioContext && !window.webkitAudioContext) return;
                if (!emergencyAudioCtx) {
                    emergencyAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
                }
                if (emergencyAudioCtx.state === 'suspended') {
                    emergencyAudioCtx.resume();
                }
                stopEmergencyTelephoneRingtone();

                function ringPulse() {
                    if (!emergencyAudioCtx || emergencyAudioCtx.state === 'closed') return;
                    var t = emergencyAudioCtx.currentTime;
                    var osc1 = emergencyAudioCtx.createOscillator();
                    var osc2 = emergencyAudioCtx.createOscillator();
                    var gain = emergencyAudioCtx.createGain();

                    osc1.type = 'sine';
                    osc1.frequency.setValueAtTime(440, t);
                    osc2.type = 'sine';
                    osc2.frequency.setValueAtTime(480, t);

                    gain.gain.setValueAtTime(0, t);
                    gain.gain.linearRampToValueAtTime(0.2, t + 0.05);
                    gain.gain.setValueAtTime(0.2, t + 1.95);
                    gain.gain.linearRampToValueAtTime(0, t + 2.0);

                    osc1.connect(gain);
                    osc2.connect(gain);
                    gain.connect(emergencyAudioCtx.destination);

                    osc1.start(t);
                    osc2.start(t);
                    osc1.stop(t + 2.0);
                    osc2.stop(t + 2.0);
                }

                ringPulse();
                emergencyRingTimer = setInterval(ringPulse, 3500);
            } catch(e) {
                console.warn('Web Audio error:', e);
            }
        }

        var aiTestCallBtn = E('button', {
            class: 'btn cbi-button',
            style: 'font-size: 11px; font-weight: 700; padding: 4px 8px; border-radius: 6px; background: #ffffff; color: #000000; border: 1px solid #7dd3fc; cursor: pointer;',
            title: 'Kích hoạt cuộc gọi khẩn cấp đa kênh: Đổ chuông trình duyệt, gọi Telegram VoIP, phát chuông Siren và gửi SMS',
            click: function(e) {
                e.preventDefault();
                var btn = this;
