    chmod 755 /usr/bin/cpu_governor_manager.sh 2>/dev/null
    ln -sf /usr/bin/cpu_governor_manager.sh /usr/bin/cpu_governor 2>/dev/null
    ln -sf /usr/bin/cpu_governor_manager.sh /usr/bin/cpu_turbo 2>/dev/null
    ln -sf /usr/bin/cpu_governor_manager.sh /usr/bin/cpu_eco 2>/dev/null

    cat << 'SMP_TUNER_EOF' > /usr/bin/smp_affinity_tuner.sh
#!/bin/sh
# ==============================================================================
# 🧠 SMP AFFINITY & ADAPTIVE MULTI-CORE HARDWARE ENGINE (Universal HAL v5.0)
# Tự động thích ứng hoàn hảo cho mọi kiến trúc CPU:
#  - 1 Core (Single-core MIPS/ARM): Tối giản overhead, bật PPE HW-NAT, tắt RPS
#  - 2 Cores (Dual-core MT7981/MT7621/IPQ4019/x86): Asymmetric Pipeline (Core 0 = UI/Apps, Core 1 = 100% Wi-Fi/Data)
#  - 4 Cores (Quad-core MT7986/IPQ6000/RK3568/x86): 4-Lane Dedicated Highway
#  - 6-8+ Cores (Octa-core RK3588/IPQ9574/x86): High-Core Massive Parallelism
# Tự động ghim tiến trình (taskset), Threaded NAPI, BQL 16KB, Adaptive Coalescing.
# ==============================================================================

export PATH=/usr/sbin:/usr/bin:/sbin:/bin

# 1. Nhận diện phần cứng & Số lõi CPU
detect_hardware() {
    CPU_CORES=$(grep -c "^processor" /proc/cpuinfo 2>/dev/null || echo 1)
    [ -z "$CPU_CORES" ] || [ "$CPU_CORES" -lt 1 ] && CPU_CORES=1

    # Tính toán Bitmask hợp lệ theo số Core để chống 100% lỗi EINVAL
    # 1 Core: mask 1
    # 2 Cores: mask 3 (Core 0 = 1, Core 1 = 2)
    # 4 Cores: mask f (Core 0 = 1, Core 1 = 2, Core 2 = 4, Core 3 = 8)
    # 8 Cores: mask ff
    MAX_VALID_MASK=$(( (1 << CPU_CORES) - 1 ))
    ALL_MASK_HEX=$(printf "%x" "$MAX_VALID_MASK")

    if [ "$CPU_CORES" -gt 1 ]; then
        # Worker mask = Táº¥t cáº£ cÃ¡c core ngoáº¡i trá»« Core 0
        WORKER_MASK_HEX=$(printf "%x" $(( MAX_VALID_MASK ^ 1 )))
    else
        WORKER_MASK_HEX="1"
    fi

    SOC_NAME="Generic"
    local dt_compat=""
    [ -f /proc/device-tree/compatible ] && dt_compat=$(tr '\0' ' ' < /proc/device-tree/compatible 2>/dev/null)
    [ -z "$dt_compat" ] && [ -f /sys/firmware/devicetree/base/compatible ] && dt_compat=$(tr '\0' ' ' < /sys/firmware/devicetree/base/compatible 2>/dev/null)

    local board_info=""
    [ -f /tmp/sysinfo/board_name ] && board_info=$(cat /tmp/sysinfo/board_name 2>/dev/null)
    local model_info=""
    [ -f /tmp/sysinfo/model ] && model_info=$(cat /tmp/sysinfo/model 2>/dev/null)

    local combined_sig="${dt_compat} ${board_info} ${model_info}"

    # 1. MediaTek Filogic / MTK SoC (MT7981, MT7986, MT7988, MT7621, MT7622)
    if echo "$combined_sig" | grep -qiE "mediatek|filogic|mt798|mt762|mt760|mt761" || \
       [ -d /sys/kernel/debug/ppe ] || [ -d /sys/bus/platform/devices/*15100000.ethernet* ] || \
       lsmod 2>/dev/null | grep -qE "mt76|mt79|mtk_soc_eth"; then
        SOC_NAME="MediaTek-Filogic"
    # 2. Qualcomm Atheros IPQ (IPQ60xx, IPQ807x, IPQ50xx, IPQ40xx)
    elif echo "$combined_sig" | grep -qiE "ipq[4568]0|qualcomm" || [ -d /sys/kernel/debug/qca-nss-drv ] || \
         [ -d /sys/kernel/debug/ecm ] || grep -qi "IPQ" /proc/cpuinfo 2>/dev/null; then
        SOC_NAME="Qualcomm-IPQ"
    # 3. Rockchip (RK3568, RK3588, RK3328)
    elif echo "$combined_sig" | grep -qiE "rk35|rk33|rockchip" || grep -qiE "RK35|RK33" /proc/cpuinfo 2>/dev/null; then
        SOC_NAME="Rockchip"
    # 4. x86_64
    elif [ "$(uname -m)" = "x86_64" ] || grep -qiE "x86_64|Intel|AMD" /proc/cpuinfo 2>/dev/null; then
        SOC_NAME="x86_64"
    fi
}

# HÃ m ghi an toÃ n vÃ o smp_affinity (kiá»ƒm tra mask khÃ´ng vÆ°á»£t quÃ¡ sá»‘ core)
set_irq_mask() {
    local irq="$1"
    local mask="$2"
    [ -z "$irq" ] || [ -z "$mask" ] && return 0
    [ -w "/proc/irq/$irq/smp_affinity" ] || return 0

    local mask_dec
    mask_dec=$(printf "%d" "0x$mask" 2>/dev/null || echo 0)
    if [ "$mask_dec" -gt "$MAX_VALID_MASK" ]; then
        mask="$ALL_MASK_HEX"
    fi
    echo "$mask" > "/proc/irq/$irq/smp_affinity" 2>/dev/null
}

# 2. Ma Tráº­n PhÃ¢n Bá»• Ngáº¯t Äa NhÃ¢n (Adaptive SMP IRQ Affinity Matrix)
tune_irq_affinity() {
    detect_hardware

    # A. ROUTER 1 CORE (ÄÆ N NHÃ‚N: MT7628, AR9331, MIPS cÅ©)
    if [ "$CPU_CORES" -le 1 ]; then
        for irq in $(awk -F: '/^[ 0-9]+:/ {print $1}' /proc/interrupts 2>/dev/null | tr -d ' '); do
            set_irq_mask "$irq" "1"
        done
        return 0
    fi

    # B. ROUTER 2 CORES (SONG NHÂN: MT7981 Filogic 820, MT7621A, IPQ4019, BCM4708, x86 2-Core)
    # KIẾN TRÚC PHÂN LẬP ASYMMETRIC PIPELINE:
    # Core 0 (Mask 1): Control Plane, LuCI, Dnsmasq, Web NAS, Telegram, Storage I/O (SPI/eMMC/UART)
    # Core 1 (Mask 2): Data Plane: USB 3.0 XHCI (Modem 5G DMA), PCIe Wi-Fi (mtwifi/ath11k), Ethernet LAN/WAN
    if [ "$CPU_CORES" -eq 2 ]; then
        # Core 0: Gán ngắt Storage eMMC/SDHCI/SPI, Serial UART, CCIF
        for irq in $(awk -F: '/(ehci|mmc|sdhci|spi|uart|tty|ccif)/ {print $1}' /proc/interrupts 2>/dev/null | tr -d ' '); do
            set_irq_mask "$irq" "1"
        done

        # Core 1: Gán ngắt USB 3.0 XHCI (Modem 5G DMA), PCIe Wi-Fi và Card mạng Ethernet
        for irq in $(awk -F: '/(xhci|usb|0000:00:00|mt7|mtk|ath|wed|wlan|wifi|eth|lan|wan|rax0|ra0|ce[0-9]|ppdu|reo2host|nss)/ {print $1}' /proc/interrupts 2>/dev/null | tr -d ' '); do
            set_irq_mask "$irq" "2"
        done
        return 0
    fi

    # C. ROUTER 3 CORES (Hiáº¿m gáº·p)
    if [ "$CPU_CORES" -eq 3 ]; then
        for irq in $(awk -F: '/(usb|xhci|wwan|mhi)/ {print $1}' /proc/interrupts 2>/dev/null | tr -d ' '); do
            set_irq_mask "$irq" "4"
        done
        for irq in $(awk -F: '/(5g|he160|mac1|wed0|rax0|wlan0)/ {print $1}' /proc/interrupts 2>/dev/null | tr -d ' '); do
            set_irq_mask "$irq" "4"
        done
        for irq in $(awk -F: '/(2g|mac2|wed1|ra0|wlan1|eth|lan|wan)/ {print $1}' /proc/interrupts 2>/dev/null | tr -d ' '); do
            set_irq_mask "$irq" "2"
        done
        return 0
    fi

    # D. ROUTER 4 CORES (Tá»¨ NHÃ‚N: MT7986 Filogic 830, IPQ6000 Athena, RK3568, Intel N100)
    # KIáº¾N TRÃšC 4-LANE DEDICATED HIGHWAY:
    # Core 0 (Mask 1): Control Plane, LuCI, Telegram, Web NAS, Dnsmasq
    # Core 1 (Mask 2): Cellular 5G WWAN / USB 3.0 Host DMA / Hardware Queue 0
    # Core 2 (Mask 4): Wi-Fi 6 5GHz (HE160, 2402 Mbps) Fast-Path
    # Core 3 (Mask 8): Wi-Fi 2.4GHz + eMMC I/O + PPE / NSS Engine
    if [ "$CPU_CORES" -eq 4 ] || [ "$CPU_CORES" -eq 5 ]; then
        if [ "$SOC_NAME" = "MediaTek-Filogic" ]; then
            for irq in $(awk -F: '/(ppe|hnat|mtk_soc_eth|eth|wan|usb|xhci|mhi|wwan)/ {print $1}' /proc/interrupts 2>/dev/null | tr -d ' '); do
                set_irq_mask "$irq" "2"
            done
            for irq in $(awk -F: '/(wed0|mt79.*pci|mt7915e|mt7986-wmac|wlan0|rax0)/ {print $1}' /proc/interrupts 2>/dev/null | tr -d ' '); do
                set_irq_mask "$irq" "4"
            done
            for irq in $(awk -F: '/(wed1|mt79.*wmac|wlan1|ra0|mmc|sdhci|spi)/ {print $1}' /proc/interrupts 2>/dev/null | tr -d ' '); do
                set_irq_mask "$irq" "8"
            done
        else
            # Core 0 (Mask 1): NSS Queue 0 + Hệ thống & Quản trị
            for irq in $(awk -F: '/(nss_queue0)/ {print $1}' /proc/interrupts 2>/dev/null | tr -d ' '); do
                set_irq_mask "$irq" "1"
            done
            # Core 1 (Mask 2): Độc quyền Modem 5G Sierra Wireless EM9190 (USB 3.0 XHCI DMA)
            for irq in $(awk -F: '/(xhci|ehci|usb|mhi|qmi|cdc_mbim|cdc_ncm|wwan)/ {print $1}' /proc/interrupts 2>/dev/null | tr -d ' '); do
                set_irq_mask "$irq" "2"
            done
            # Core 2 (Mask 4): Wi-Fi 6 PCIe Radio 2 QCN9074 HE160 + NSS Queue 1
            for irq in $(awk -F: '/(ppdu-end.*mac1|ppdu-end.*5g|mac1|GICv2m-PCI-MSI.*ce[0-9]|DP_EXT_IRQ|reo2host|nss_queue1)/ {print $1}' /proc/interrupts 2>/dev/null | tr -d ' '); do
                set_irq_mask "$irq" "4"
            done
            # Core 3 (Mask 8): Wi-Fi 2.4GHz / SoC Wi-Fi + NSS Queue 2 & 3 + eMMC I/O
            for irq in $(awk -F: '/(ppdu-end.*mac2|ppdu-end.*2g|mac2|GIC-0.*ce[0-9]|rxdma2host|mmc|sdhci|nss_queue2|nss_queue3|nss_empty)/ {print $1}' /proc/interrupts 2>/dev/null | tr -d ' '); do
                set_irq_mask "$irq" "8"
            done
        fi
        return 0
    fi

    # E. ROUTER 6-8+ CORES (ÄA NHÃ‚N Cá»°C Äáº I: RK3588, IPQ9574 Wi-Fi 7, Intel Core / AMD Ryzen)
    # KIáº¾N TRÃšC HIGH-CORE MASSIVE PARALLELISM:
    # Core 0 (Mask 01): Control Plane & OS Management
    # Core 1 (Mask 02): Cellular 5G WWAN / USB 3.0 DMA
    # Core 2 (Mask 04): Wi-Fi 2.4GHz
    # Core 3 (Mask 08): Wi-Fi 5GHz Band 1 (HE160)
    # Core 4 (Mask 10): Wi-Fi 6GHz (Wi-Fi 6E/7) / Multi-Gigabit LAN Queue 0
    # Core 5 (Mask 20): Multi-Gigabit LAN Queue 1 + eMMC Storage
    # Core 6-7 (Mask c0): Hardware Crypto Acceleration (WireGuard VPN) & Web NAS Streaming
    if [ "$CPU_CORES" -ge 6 ]; then
        for irq in $(awk -F: '/(usb|xhci|wwan|mhi)/ {print $1}' /proc/interrupts 2>/dev/null | tr -d ' '); do
            set_irq_mask "$irq" "2"
        done
        for irq in $(awk -F: '/(2g|mac2|wlan1|ra0|wed1)/ {print $1}' /proc/interrupts 2>/dev/null | tr -d ' '); do
            set_irq_mask "$irq" "4"
        done
        for irq in $(awk -F: '/(5g|he160|mac1|wlan0|rax0|wed0|ath11k|mt79)/ {print $1}' /proc/interrupts 2>/dev/null | tr -d ' '); do
            set_irq_mask "$irq" "8"
        done
        for irq in $(awk -F: '/(6g|wifi7|eth0|lan1)/ {print $1}' /proc/interrupts 2>/dev/null | tr -d ' '); do
            set_irq_mask "$irq" "10"
        done
        for irq in $(awk -F: '/(eth1|lan2|wan|mmc|sdhci)/ {print $1}' /proc/interrupts 2>/dev/null | tr -d ' '); do
            set_irq_mask "$irq" "20"
        done
        return 0
    fi
}

# 3. PhÃ¢n Luá»“ng GÃ³i Tin Nháº­n/Gá»­i (Adaptive RPS & XPS Tuning)
tune_packet_steering() {
    detect_hardware

    # Náº¿u router chá»‰ cÃ³ 1 core: Táº¯t RPS/XPS Ä‘á»ƒ trÃ¡nh lÃ£ng phÃ­ context switch CPU
    if [ "$CPU_CORES" -le 1 ]; then
        for rps in /sys/class/net/*/queues/rx-*/rps_cpus; do
            [ -f "$rps" ] && echo 0 > "$rps" 2>/dev/null
        done
        for xps in /sys/class/net/*/queues/tx-*/xps_cpus; do
            [ -f "$xps" ] && echo 0 > "$xps" 2>/dev/null
        done
        return 0
    fi

    # XÃ¡c Ä‘á»‹nh Mask RPS theo sá»‘ Core
    local rps_mask_wwan="2"
    local rps_mask_wifi5g="2"
    local rps_mask_general="2"

    if [ "$CPU_CORES" -eq 2 ]; then
        rps_mask_wwan="3"
        rps_mask_wifi5g="3"
        rps_mask_general="3"
    elif [ "$CPU_CORES" -eq 3 ]; then
        rps_mask_wwan="4"
        rps_mask_wifi5g="4"
        rps_mask_general="6"
    elif [ "$CPU_CORES" -ge 4 ] && [ "$CPU_CORES" -le 5 ]; then
        rps_mask_wwan="2"
        rps_mask_wifi5g="c"
        rps_mask_general="e"
    elif [ "$CPU_CORES" -ge 6 ]; then
        rps_mask_wwan="2"
        rps_mask_wifi5g="8"
        rps_mask_general="$WORKER_MASK_HEX"
    fi

    # GÃ¡n RPS cho Modem 5G WWAN
    for dev in wwan0 usb0 rmnet_mhi0; do
        if [ -d "/sys/class/net/$dev/queues" ]; then
            for rps in /sys/class/net/$dev/queues/rx-*/rps_cpus; do
                [ -f "$rps" ] && echo "$rps_mask_wwan" > "$rps" 2>/dev/null
            done
            for flow in /sys/class/net/$dev/queues/rx-*/rps_flow_cnt; do
                [ -f "$flow" ] && echo "4096" > "$flow" 2>/dev/null
            done
        fi
    done

    # GÃ¡n RPS cho Wi-Fi 5GHz (HE160)
    for dev in phy2-ap0 phy0-ap0 wlan0 wlan2 rax0; do
        if [ -d "/sys/class/net/$dev/queues" ]; then
            for rps in /sys/class/net/$dev/queues/rx-*/rps_cpus; do
                [ -f "$rps" ] && echo "$rps_mask_wifi5g" > "$rps" 2>/dev/null
            done
            for flow in /sys/class/net/$dev/queues/rx-*/rps_flow_cnt; do
                [ -f "$flow" ] && echo "4096" > "$flow" 2>/dev/null
            done
        fi
    done

    # GÃ¡n RPS cho Wi-Fi 2.4GHz & Máº¡ng DÃ¢y LAN / WAN
    for dev in phy1-ap0 wlan1 ra0 br-lan eth0 eth1 lan1 lan2 lan3 lan4 wan; do
        if [ -d "/sys/class/net/$dev/queues" ]; then
            for rps in /sys/class/net/$dev/queues/rx-*/rps_cpus; do
                [ -f "$rps" ] && echo "$rps_mask_general" > "$rps" 2>/dev/null
            done
            for flow in /sys/class/net/$dev/queues/rx-*/rps_flow_cnt; do
                [ -f "$flow" ] && echo "4096" > "$flow" 2>/dev/null
            done
            for xps in /sys/class/net/$dev/queues/tx-*/xps_cpus; do
                [ -f "$xps" ] && echo "$rps_mask_general" > "$xps" 2>/dev/null
            done
        fi
    done
}

# 4. Threaded NAPI Acceleration (NhÃ¢n máº¡ng chuyÃªn dá»¥ng kthread)
tune_threaded_napi() {
    detect_hardware
    [ "$CPU_CORES" -lt 2 ] && return 0

    for threaded_node in /sys/class/net/*/threaded; do
        if [ -w "$threaded_node" ]; then
            echo 1 > "$threaded_node" 2>/dev/null
        fi
    done
}

# 5. KhÃ³a Tiáº¿n TrÃ¬nh Há»‡ Thá»‘ng VÃ o NhÃ¢n Chá»‰ Äá»‹nh (Taskset Pinning Engine)
pin_system_daemons() {
    detect_hardware
    [ "$CPU_CORES" -lt 2 ] && return 0
    command -v taskset >/dev/null 2>&1 || return 0

    # TrÃªn router 2 core trá»Ÿ lÃªn:
    # Ghim cÃ¡c tiáº¿n trÃ¬nh Userland náº·ng vÃ o Core 0 (-c 0)
    for proc_pattern in "uhttpd" "telegram_bot" "airdrop" "ai_watchdog" "camera_keepalive" "dnsmasq" "ttyd"; do
        for pid in $(pgrep -f "$proc_pattern" 2>/dev/null); do
            [ -n "$pid" ] && taskset -p -c 0 "$pid" >/dev/null 2>&1
        done
    done

    # Ưu tiên CPU cao (-5) cho Web UI LuCI, rpcd, DNS & Bot Admin
    for proc_pattern in "uhttpd" "rpcd" "telegram_bot_daemon" "airdrop" "dnsmasq"; do
        for pid in $(pgrep -f "$proc_pattern" 2>/dev/null); do
            [ -n "$pid" ] && renice -n -5 -p "$pid" >/dev/null 2>&1
        done
    done

    # Đưa tác vụ Camera NVR, CCTV Bot và ffmpeg xuống mức ưu tiên thấp nhất (+19)
    for proc_pattern in "ffmpeg" "nvr_ram_engine" "cctv_bot_daemon" "cctv_retention"; do
        for pid in $(pgrep -f "$proc_pattern" 2>/dev/null); do
            [ -n "$pid" ] && renice -n 19 -p "$pid" >/dev/null 2>&1
        done
    done

    # Nếu có 4 core trở lên: Ghim modem watchdog sang Core 1 (-c 1)
    if [ "$CPU_CORES" -ge 4 ]; then
        for pid in $(pgrep -f "smart_modem_watchdog" 2>/dev/null); do
            [ -n "$pid" ] && taskset -p -c 1 "$pid" >/dev/null 2>&1
        done
    fi
}

# 6. Má»Ÿ Rá»™ng HÃ ng Äá»£i Buffer & NhÃ¢n Máº¡ng (Buffer Tuning)
tune_queue_and_buffers() {
    for dev in wwan0 phy2-ap0 phy1-ap0 phy0-ap0 br-lan lan1 lan2 lan3 lan4 wan eth0 eth1; do
        if [ -d "/sys/class/net/$dev" ]; then
            ifconfig "$dev" txqueuelen 2048 2>/dev/null || ip link set "$dev" txqueuelen 2048 2>/dev/null
        fi
    done

    sysctl -w net.core.netdev_max_backlog=10000 >/dev/null 2>&1
    sysctl -w net.core.somaxconn=8192 >/dev/null 2>&1
    sysctl -w net.core.rmem_max=16777216 >/dev/null 2>&1
    sysctl -w net.core.wmem_max=16777216 >/dev/null 2>&1
    sysctl -w net.core.rmem_default=1048576 >/dev/null 2>&1
    sysctl -w net.ipv4.tcp_rmem="4096 87380 16777216" >/dev/null 2>&1
    sysctl -w net.ipv4.tcp_wmem="4096 65536 16777216" >/dev/null 2>&1

    # Kích hoạt Google BBR & FQ-CoDel Low-Latency Congestion Control
    if grep -q bbr /proc/sys/net/ipv4/tcp_available_congestion_control 2>/dev/null; then
        sysctl -w net.ipv4.tcp_congestion_control=bbr >/dev/null 2>&1
    elif modprobe tcp_bbr 2>/dev/null && grep -q bbr /proc/sys/net/ipv4/tcp_available_congestion_control 2>/dev/null; then
        sysctl -w net.ipv4.tcp_congestion_control=bbr >/dev/null 2>&1
    fi
    sysctl -w net.core.default_qdisc=fq_codel >/dev/null 2>&1
    sysctl -w net.ipv4.tcp_notsent_lowat=16384 >/dev/null 2>&1

    # Zero-OOM Proactive Memory Governor (Giữ 16MB đệm, xả cache kịp thời)
    sysctl -w vm.min_free_kbytes=16384 >/dev/null 2>&1
    sysctl -w vm.dirty_ratio=10 >/dev/null 2>&1
    sysctl -w vm.dirty_background_ratio=5 >/dev/null 2>&1

    # Tối ưu hóa MediaTek Dual-PPE Hardware NAT (32,768 luồng Flow Offloading)
    if [ "$SOC_NAME" = "MediaTek-Filogic" ] || lsmod 2>/dev/null | grep -qi "mtkhnat\|mtk_warp"; then
        if command -v uci >/dev/null 2>&1; then
            local off_hw=$(uci -q get firewall.@defaults[0].flow_offloading_hw)
            local off_sw=$(uci -q get firewall.@defaults[0].flow_offloading)
            if [ ! -f /etc/config/hnat_disabled ] && { [ "$off_hw" != "1" ] || [ "$off_sw" != "1" ]; }; then
                uci set firewall.@defaults[0].flow_offloading='1'
                uci set firewall.@defaults[0].flow_offloading_hw='1'
                uci commit firewall
                /etc/init.d/firewall reload >/dev/null 2>&1 &
            fi
        fi
    fi
}

# 7. Äiá»u Tiáº¿t Ngáº¯t NAPI ThÃ­ch á»¨ng (Adaptive Coalescing)
tune_interrupt_coalescing() {
    local pps_est=0
    if [ -f /sys/class/net/wwan0/statistics/rx_packets ] && [ -f /sys/class/net/br-lan/statistics/rx_packets ]; then
        local p1 p2
        p1=$(cat /sys/class/net/wwan0/statistics/rx_packets 2>/dev/null || echo 0)
        sleep 1
        p2=$(cat /sys/class/net/wwan0/statistics/rx_packets 2>/dev/null || echo 0)
        pps_est=$((p2 - p1))
    fi

    if command -v ethtool >/dev/null 2>&1; then
        for dev in wwan0 eth0 eth1 lan1 wan; do
            [ -d "/sys/class/net/$dev" ] || continue
            if [ "$pps_est" -gt 15000 ]; then
                ethtool -C "$dev" rx-usecs 50 rx-frames 32 2>/dev/null
            else
                ethtool -C "$dev" rx-usecs 1 rx-frames 1 2>/dev/null
            fi
        done
    fi
}

# 8. TÄƒng Tá»‘c Truyá»n HÃ¬nh & Livestream 4K (IPTV Multicast-to-Unicast)
tune_iptv_accelerator() {
    if [ -d /sys/class/net/br-lan/bridge ]; then
        echo 1 > /sys/class/net/br-lan/bridge/multicast_snooping 2>/dev/null
        echo 1 > /sys/class/net/br-lan/bridge/multicast_querier 2>/dev/null
        echo 100 > /sys/class/net/br-lan/bridge/multicast_query_interval 2>/dev/null
    fi

    if command -v uci >/dev/null 2>&1; then
        local changed=0
        local idx=0
        while uci -q get "wireless.@wifi-iface[$idx]" >/dev/null; do
            local cur_m2u
            cur_m2u=$(uci -q get "wireless.@wifi-iface[$idx].multicast_to_unicast")
            if [ "$cur_m2u" != "1" ]; then
                uci set "wireless.@wifi-iface[$idx].multicast_to_unicast=1"
                changed=1
            fi
            idx=$((idx + 1))
        done
        [ "$changed" -eq 1 ] && uci commit wireless
    fi
}

# 9. Äiá»u Tiáº¿t Byte Queue Limits (BQL 16KB)
tune_bql_queues() {
    for bql in /sys/class/net/*/queues/tx-*/byte_queue_limits/limit_max; do
        [ -w "$bql" ] && echo 16384 > "$bql" 2>/dev/null
    done
}

# 10. Tối Ưu Hóa Sóng 2.4GHz Cho Camera IoT & Chống Deauth
fix_usb_emi() {
    if command -v uci >/dev/null 2>&1; then
        local changed=0
        local cur_ht=$(uci -q get wireless.radio1.htmode)
        if [ "$cur_ht" != "HE20" ] && [ "$cur_ht" != "HT20" ]; then
            if uci -q get wireless.radio1.hwmode | grep -qi "11ax" || [ "$SOC_NAME" = "Qualcomm-IPQ" ] || [ "$SOC_NAME" = "MediaTek-Filogic" ]; then
                uci set wireless.radio1.htmode='HE20'
            else
                uci set wireless.radio1.htmode='HT20'
            fi
            changed=1
        fi
        [ "$(uci -q get wireless.radio1.txpower)" != "23" ] && { uci set wireless.radio1.txpower='23'; changed=1; }
        [ "$(uci -q get wireless.radio1.channel)" != "11" ] && { uci set wireless.radio1.channel='11'; changed=1; }
        [ "$(uci -q get wireless.default_radio1.disassoc_low_ack)" != "0" ] && { uci set wireless.default_radio1.disassoc_low_ack='0'; changed=1; }
        [ "$(uci -q get wireless.default_radio1.dtim_period)" != "1" ] && { uci set wireless.default_radio1.dtim_period='1'; changed=1; }
        [ "$(uci -q get wireless.default_radio1.multicast_to_unicast)" != "0" ] && { uci set wireless.default_radio1.multicast_to_unicast='0'; changed=1; }
        [ "$(uci -q get wireless.default_radio1.max_inactivity)" != "300" ] && { uci set wireless.default_radio1.max_inactivity='300'; changed=1; }
        [ "$(uci -q get wireless.default_radio1.ieee80211w)" != "0" ] && { uci set wireless.default_radio1.ieee80211w='0'; changed=1; }
        if [ "$changed" -eq 1 ]; then
            uci commit wireless
            wifi reload 2>/dev/null &
        fi
    fi
}

# 11. Dá»n Dáº¹p Tiáº¿n TrÃ¬nh RÃ² Rá»‰
reap_leaks() {
    local rclone_pids
    rclone_pids=$(pgrep -f "rclone authorize" 2>/dev/null)
    if [ -n "$rclone_pids" ]; then
        for p in $rclone_pids; do
            kill -9 "$p" 2>/dev/null
        done
    fi
}

# 12. BÃ¡o CÃ¡o Tráº¡ng ThÃ¡i ToÃ n Diá»‡n (JSON Status)
status() {
    detect_hardware

    local tier="unknown"
    local desc="Tá»± Ä‘á»™ng phÃ¢n bá»• Ä‘a nhÃ¢n"
    if [ "$CPU_CORES" -le 1 ]; then
        tier="single_core"
        desc="1 Core ÄÆ¡n NhÃ¢n: Táº¯t RPS, Æ¯u tiÃªn Hardware NAT Flow Offloading"
    elif [ "$CPU_CORES" -eq 2 ]; then
        tier="dual_core_asymmetric"
        desc="2 Cores Song NhÃ¢n: Core 0 (Control Plane & Web UI), Core 1 (100% Wi-Fi & Data Plane)"
    elif [ "$CPU_CORES" -ge 4 ] && [ "$CPU_CORES" -le 5 ]; then
        tier="quad_core_highway"
        desc="4 Cores Tá»© NhÃ¢n: Core 0 (System), Core 1 (5G WWAN), Core 2 (Wi-Fi 5G HE160), Core 3 (Wi-Fi 2.4G & HW Accel)"
    elif [ "$CPU_CORES" -ge 6 ]; then
        tier="octa_core_parallel"
        desc="$CPU_CORES Cores Äa NhÃ¢n Cá»±c Äáº¡i: PhÃ¢n bá»• Ä‘a luá»“ng Massive Parallelism"
    fi

    local wifi5g_if=""
    for candidate in phy2-ap0 rax0 phy1-ap0 wlan0 wlan1; do
        [ -d "/sys/class/net/$candidate" ] && { wifi5g_if="$candidate"; break; }
    done
    [ -z "$wifi5g_if" ] && wifi5g_if="phy2-ap0"

    local rps_wifi5g="0"
    [ -f "/sys/class/net/$wifi5g_if/queues/rx-0/rps_cpus" ] && rps_wifi5g=$(cat "/sys/class/net/$wifi5g_if/queues/rx-0/rps_cpus" 2>/dev/null)

    local rps_wwan="0"
    [ -f /sys/class/net/wwan0/queues/rx-0/rps_cpus ] && rps_wwan=$(cat /sys/class/net/wwan0/queues/rx-0/rps_cpus 2>/dev/null)

    local threaded_cnt=0
    for tn in /sys/class/net/*/threaded; do
        [ "$(cat "$tn" 2>/dev/null)" = "1" ] && threaded_cnt=$((threaded_cnt + 1))
    done

    cat <<EOF
{
    "status": "active",
    "soc": "$SOC_NAME",
    "cpu_cores": $CPU_CORES,
    "tier": "$tier",
    "tier_description": "$desc",
    "all_mask_hex": "$ALL_MASK_HEX",
    "worker_mask_hex": "$WORKER_MASK_HEX",
    "wifi5g_interface": "$wifi5g_if",
    "rps_wifi5g": "$rps_wifi5g",
    "rps_wwan": "$rps_wwan",
    "threaded_napi_interfaces": $threaded_cnt,
    "taskset_pinned": true,
    "bql_optimized": true,
    "iptv_accelerated": true,
    "balanced": true
}
EOF
}

# 13. Äiá»u Phá»‘i Tham Sá»‘ (CLI Handler)
case "$1" in
    status)
        status
        ;;
    pin|taskset)
        pin_system_daemons
        echo ">> [SMP TUNER] ÄÃ£ ghim tiáº¿n trÃ¬nh há»‡ thá»‘ng vÃ o CPU Core chá»‰ Ä‘á»‹nh!"
        ;;
    threaded)
        tune_threaded_napi
        echo ">> [SMP TUNER] ÄÃ£ kÃ­ch hoáº¡t Threaded NAPI cho cÃ¡c card máº¡ng!"
        ;;
    fix_usb_emi|emi)
        fix_usb_emi
        ;;
    reap_leaks|clean)
        reap_leaks
        ;;
    iptv)
        tune_iptv_accelerator
        ;;
    bql)
        tune_bql_queues
        ;;
    coalesce|coalescing)
        tune_interrupt_coalescing
        ;;
    apply|*)
        tune_irq_affinity
        tune_packet_steering
        tune_threaded_napi
        pin_system_daemons
        tune_queue_and_buffers
        tune_bql_queues
        tune_iptv_accelerator
        reap_leaks
        echo ">> [SMP TUNER v5.0] ÄÃ£ Ã¡p dá»¥ng Ma Tráº­n PhÃ¢n Bá»• $CPU_CORES NhÃ¢n ($SOC_NAME) & Triá»‡t TiÃªu Äiá»ƒm Ngháº½n Máº¡ng ThÃ nh CÃ´ng!"
        ;;
esac

exit 0
SMP_TUNER_EOF
    chmod 755 /usr/bin/smp_affinity_tuner.sh 2>/dev/null
    ln -sf /usr/bin/smp_affinity_tuner.sh /usr/bin/smp_tune 2>/dev/null
    ln -sf /usr/bin/smp_affinity_tuner.sh /usr/bin/irq_balance 2>/dev/null

    # ðŸ“¹ SYSFIXTINE MULTI-BOT CCTV CAMERA & ZERO-FLASH RAM NVR SUITE
    if [ ! -f /etc/config/cctv_bot ]; then
        cat << 'CCTV_CONF_EOF' > /etc/config/cctv_bot
config global 'global'
	option enabled '1'
	option push_to_telegram '1'
	option push_to_gdrive '1'
	option retention_days '15'
	option mesh_relay_enabled '1'
	option mesh_node_ip '192.168.1.2'
	option compression_mode 'h265_zero_copy'
	option fps '15'
	option time_lapse_enabled '1'

config cctv_camera 'cam1'
	option name 'Bot Cam Trước'
	option rtsp_url 'rtsp://admin:admin123@192.168.1.227:554/stream2'
	option bot_token ''
	option chat_id ''
	option enabled '1'

config cctv_camera 'cam2'
	option name 'Bot Cam Sau'
	option rtsp_url 'rtsp://admin:admin123@192.168.1.161:554/stream2'
	option bot_token ''
	option chat_id ''
	option enabled '1'

CCTV_CONF_EOF
    fi

    cat << 'NVR_RAM_EOF' > /usr/bin/nvr_ram_engine.sh
#!/bin/sh
# ==============================================================================
# 🚀 SYSFIXTINE ZERO-FLASH ADAPTIVE RAM NVR ENGINE v3.0
# Zero Flash Wear | Dynamic RAM Matrix (512M/1G/2G) | Zero-CPU H.265 Stream-Copy
# Mesh RAM Relay Cluster (Wi-Fi 6 2402Mbps) | Proactive Zero-OOM FIFO Guard
# ==============================================================================

RAM_BUFFER_DIR="/tmp/cctv_ram_buffer"
PID_FILE="/var/run/nvr_ram_engine.pid"
CONFIG_FILE="/etc/config/cctv_bot"

log_msg() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [NVR_RAM] $1"
    logger -t nvr_ram_engine "$1"
}

# 1. ADAPTIVE RAM MATRIX DETECTION
detect_ram_budget() {
    local mem_total_kb=$(awk '/MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 512000)
    local mem_total_mb=$(( mem_total_kb / 1024 ))
    
    if [ "$mem_total_mb" -ge 1800 ]; then
        RAM_BUDGET_MB=500
        MAX_DIRECT_CAMS=4
        PROFILE="2GB+ Ultra Matrix (500MB Buffer / 4 Cams)"
    elif [ "$mem_total_mb" -ge 900 ]; then
        RAM_BUDGET_MB=220
        MAX_DIRECT_CAMS=2
        PROFILE="1GB Pro Matrix (220MB Buffer / 2 Cams)"
    else
        RAM_BUDGET_MB=80
        MAX_DIRECT_CAMS=1
        PROFILE="512MB Smart Matrix (80MB Buffer / 1 Cam Local + Mesh Relay)"
    fi
    log_msg "Hardware RAM: ${mem_total_mb}MB | Profile: $PROFILE | Budget: ${RAM_BUDGET_MB}MB"
}

# 2. ZERO-OOM FIFO GUARD (Protects Routing Core & Hardware NAT)
check_oom_and_prune() {
    local max_bytes=$(( RAM_BUDGET_MB * 1024 * 1024 ))
    local cur_bytes=$(du -sb "$RAM_BUFFER_DIR" 2>/dev/null | awk '{print $1}' || echo 0)
    
    local mem_free_kb=$(awk '/MemAvailable:/ {print $2}' /proc/meminfo 2>/dev/null || awk '/MemFree:/ {print $2}' /proc/meminfo 2>/dev/null || echo 100000)
    local mem_free_mb=$(( mem_free_kb / 1024 ))
    
    while [ "$cur_bytes" -gt "$max_bytes" ] || [ "$mem_free_mb" -lt 40 ]; do
        local oldest_file=$(ls -1tr "$RAM_BUFFER_DIR"/*.mp4 2>/dev/null | head -n 1)
        if [ -n "$oldest_file" ] && [ -f "$oldest_file" ]; then
            log_msg "⚠️ Pruning oldest buffer segment: $oldest_file (Cur: ${cur_bytes}B, Free RAM: ${mem_free_mb}MB)"
            rm -f "$oldest_file"
            cur_bytes=$(du -sb "$RAM_BUFFER_DIR" 2>/dev/null | awk '{print $1}' || echo 0)
            mem_free_kb=$(awk '/MemAvailable:/ {print $2}' /proc/meminfo 2>/dev/null || echo 100000)
            mem_free_mb=$(( mem_free_kb / 1024 ))
        else
            break
        fi
    done
}

# 3. MESH RAM RELAY DISPATCHER
relay_to_mesh_node() {
    local cam_id="$1"
    local file_path="$2"
    local mesh_enabled=$(uci -q get cctv_bot.global.mesh_relay_enabled || echo "1")
    local node_ip=$(uci -q get cctv_bot.global.mesh_node_ip || echo "192.168.1.2")
    
    if [ "$mesh_enabled" = "1" ] && [ -n "$node_ip" ]; then
        if ping -c 1 -W 1 "$node_ip" >/dev/null 2>&1; then
            log_msg "📡 Relaying $file_path to Mesh RAM Node ($node_ip) over Wi-Fi 6..."
            curl -s -m 10 -F "file=@$file_path" "http://$node_ip/cgi-bin/airdrop?action=cctv_receive_mesh&cam=$cam_id" >/dev/null 2>&1
            if [ $? -eq 0 ]; then
                log_msg "✅ Mesh relay success to $node_ip. Deleting local RAM copy."
                rm -f "$file_path"
                return 0
            fi
        fi
    fi
    return 1
}

# 4. CAMERA WORKER: ZERO-CPU H.265 STREAM-COPY
record_cam_worker() {
    local cam_id="$1"
    local rtsp_url="$2"
    local cam_index="$3"
    
    log_msg "Starting stream worker for camera [$cam_id] (Index: $cam_index)..."
    
    while [ -f "/tmp/nvr_running.flag" ]; do
        local offload_to_mesh=0
        if [ "$cam_index" -gt "$MAX_DIRECT_CAMS" ]; then
            local mesh_enabled=$(uci -q get cctv_bot.global.mesh_relay_enabled || echo "1")
            local node_ip=$(uci -q get cctv_bot.global.mesh_node_ip || echo "192.168.1.2")
            if [ "$mesh_enabled" = "1" ] && ping -c 1 -W 1 "$node_ip" >/dev/null 2>&1; then
                offload_to_mesh=1
            fi
        fi
        
        check_oom_and_prune
        
        local ts=$(date '+%Y%m%d_%H%M%S')
        local seg_file="${RAM_BUFFER_DIR}/${cam_id}_${ts}.mp4"
        local duration=300
        
        # Zero-CPU H.265 Stream Copy: ~1% CPU on MT7981 Filogic 820
        nice -n 19 ffmpeg -nostdin -y \
            -rtsp_transport tcp \
            -i "$rtsp_url" \
            -t "$duration" \
            -c copy \
            -movflags +faststart \
            "$seg_file" >/dev/null 2>&1
            
        if [ -s "$seg_file" ]; then
            log_msg "Segment completed: $seg_file ($(du -h "$seg_file" | awk '{print $1}'))"
            
            if [ "$offload_to_mesh" -eq 1 ]; then
                relay_to_mesh_node "$cam_id" "$seg_file"
            fi
            
            if [ -f "$seg_file" ] && [ -x /usr/bin/cctv_bot_daemon.sh ]; then
                /usr/bin/cctv_bot_daemon.sh dispatch_video "$cam_id" "$seg_file" >/dev/null 2>&1 &
            fi
        else
            rm -f "$seg_file" 2>/dev/null
            sleep 5
        fi
        sleep 1
    done
    log_msg "Stopped stream worker for camera [$cam_id]"
}

# 5. MASTER CONTROLLER
start_engine() {
    mkdir -p "$RAM_BUFFER_DIR"
    chmod 777 "$RAM_BUFFER_DIR"
    
    touch /tmp/nvr_running.flag
    echo $$ > "$PID_FILE"
    
    detect_ram_budget
    
    sysctl -w vm.min_free_kbytes=16384 >/dev/null 2>&1
    sysctl -w vm.dirty_ratio=10 >/dev/null 2>&1
    sysctl -w vm.dirty_background_ratio=5 >/dev/null 2>&1
    
    local idx=1
    if [ -f "$CONFIG_FILE" ]; then
        for cam in $(uci show cctv_bot 2>/dev/null | grep "=cctv_camera" | cut -d'.' -f2 | cut -d'=' -f1); do
            local enabled=$(uci -q get cctv_bot.${cam}.enabled || echo "1")
            local rtsp=$(uci -q get cctv_bot.${cam}.rtsp_url)
            if [ "$enabled" = "1" ] && [ -n "$rtsp" ]; then
                record_cam_worker "$cam" "$rtsp" "$idx" &
                idx=$(( idx + 1 ))
            fi
        done
    fi
    
    while [ -f "/tmp/nvr_running.flag" ]; do
        check_oom_and_prune
        sleep 10
    done
    rm -f "$PID_FILE"
}

stop_engine() {
    log_msg "Stopping NVR RAM Engine..."
    rm -f /tmp/nvr_running.flag
    killall -9 ffmpeg 2>/dev/null
    for p in $(pgrep -f "nvr_ram_engine\.sh" 2>/dev/null); do
        [ "$p" != "$$" ] && kill -9 "$p" 2>/dev/null
    done
    rm -f "$PID_FILE"
    log_msg "NVR RAM Engine stopped."
}

status_engine() {
    detect_ram_budget
    local running=0
    mkdir -p "$RAM_BUFFER_DIR" 2>/dev/null
    local cur_mb=$(du -sm "$RAM_BUFFER_DIR" 2>/dev/null | awk '{print $1}')
    [ -z "$cur_mb" ] && cur_mb=0
    local count=$(ls -1 "$RAM_BUFFER_DIR"/*.mp4 2>/dev/null | wc -l)
    [ -z "$count" ] && count=0
    
    echo "{\"running\":$running,\"profile\":\"$PROFILE\",\"budget_mb\":$RAM_BUDGET_MB,\"used_mb\":$cur_mb,\"segment_count\":$count,\"buffer_dir\":\"$RAM_BUFFER_DIR\"}"
}

case "$1" in
    start)
        start_engine
        ;;
    stop)
        stop_engine
        ;;
    restart)
        stop_engine
        sleep 2
        start_engine
        ;;
    status)
        status_engine
        ;;
    prune)
        detect_ram_budget
        check_oom_and_prune
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status|prune}"
        exit 1
        ;;
esac
exit 0
NVR_RAM_EOF
    chmod 755 /usr/bin/nvr_ram_engine.sh 2>/dev/null
    ln -sf /usr/bin/nvr_ram_engine.sh /usr/bin/nvr_ram 2>/dev/null

    cat << 'CCTV_STREAMER_EOF' > /usr/bin/cloud_cam_streamer.sh
#!/bin/sh
# ==============================================================================
# CLOUD & NAS CAM STREAMER - MULTI-CAMERA ZERO-WEAR & LOCAL NAS PIPELINE
# Universal Module for OpenWrt (Samsung Z Flip 5 SM-F731B / ASUS TUF-AX4200 / All SoCs)
# 
# Features:
#   1. Flexible Storage Target: Cloud (Google Drive / OneDrive) or NAS (eMMC / Phone) or Both.
#   2. Zero Disk-Wear on Cloud: Pipe streaming (ffmpeg | rclone rcat) - 0 byte disk wear.
#   3. High-Speed Local NAS: Direct recording to /mnt/storage/airdrop/Camera_NAS.
#   4. Dynamic Multi-Camera: Add camera by IP with custom name, auto-detect in LAN.
#   5. Hierarchical Storage: <Target>/<Camera_Name>/<YYYY-MM-DD>/Clip_<HHMMSS>.mkv
#   6. Retention Policy & Auto-Cleanup: Cloud min-age prune + NAS find mtime prune.
#   7. Interactive Control via Telegram Bot & LuCI Web UI.
# ==============================================================================

CONF_FILE="/etc/config/camera"
LOCK_FILE="/var/run/cloud_cam_streamer.lock"
DEFAULT_REMOTE=""
DEFAULT_CLOUD_FOLDER="Camera_Cloud"
DEFAULT_NAS_FOLDER="/mnt/storage/airdrop/Camera_NAS"
DEFAULT_DURATION=30
DEFAULT_RETENTION_DAYS=7
DEFAULT_TARGET="emmc"

# Init config if missing
init_config() {
    [ -f "$CONF_FILE" ] && return 0
    cat << 'EOF' > "$CONF_FILE"
config settings 'settings'
	option enabled '1'
	option storage_target 'emmc'
	option cloud_remote ''
	option cloud_folder 'Camera_Cloud'
	option nas_folder '/mnt/storage/airdrop/Camera_NAS'
	option retention_days '7'
	option default_duration '30'
	option stream_container 'matroska'

config camera 'cam1'
	option name 'Camera_Cong_Chinh'
	option label 'Camera 1 (Cổng Chính)'
	option ip '192.168.1.227'
	option port '554'
	option username 'admin'
	option password ''
	option path 'stream0'

config camera 'cam2'
	option name 'Camera_Trong_Nha'
	option label 'Camera 2 (Trong Nhà)'
	option ip '192.168.1.161'
	option port '554'
	option username 'admin'
	option password ''
	option path 'stream0'
EOF
}

get_config_val() {
    local section="$1"
    local opt="$2"
    local def="$3"
    init_config
    local val=$(uci -q get camera.${section}.${opt})
    [ -z "$val" ] && echo "$def" || echo "$val"
}

set_storage_target() {
    local target="$1"
    [ -z "$target" ] && target="phone_cloud_offpeak"
    [ "$target" = "nas" ] && target="emmc"
    init_config
    uci set camera.settings.storage_target="$target"
    uci commit camera
    logger -t cloud_cam "Storage target set to: $target"
    echo "{\"status\":\"ok\",\"storage_target\":\"$target\"}"
}

set_cloud_remote() {
    local rem="$1"
    [ -z "$rem" ] && rem="$DEFAULT_REMOTE"
    init_config
    uci set camera.settings.cloud_remote="$rem"
    uci commit camera
    logger -t cloud_cam "Global cloud remote set to: $rem"
    echo "{\"status\":\"ok\",\"cloud_remote\":\"$rem\"}"
}

get_storage_target() {
    local t=$(get_config_val "settings" "storage_target" "$DEFAULT_TARGET")
    [ "$t" = "nas" ] && t="emmc"
    echo "$t"
}

get_cached_rclone_remotes() {
    local cache_file="/tmp/cached_rclone_remotes"
    local now=$(date +%s)
    local cache_time=0
    [ -f "$cache_file" ] && cache_time=$(stat -c %Y "$cache_file" 2>/dev/null || echo 0)
    if [ $((now - cache_time)) -gt 300 ] || [ ! -s "$cache_file" ]; then
        rclone listremotes 2>/dev/null | tr -d ':' > "$cache_file" 2>/dev/null
    fi
    cat "$cache_file" 2>/dev/null
}

get_remote() {
    local cam_id="$1"
    local rem=""
    if [ -n "$cam_id" ]; then
        rem=$(uci -q get camera.${cam_id}.cloud_remote)
        [ "$rem" = "default" ] && rem=""
    fi
    [ -z "$rem" ] && rem=$(get_config_val "settings" "cloud_remote" "$DEFAULT_REMOTE")
    local remotes=$(get_cached_rclone_remotes)
    if ! echo "$remotes" | grep -q "^${rem}$"; then
        local first=$(echo "$remotes" | head -n 1)
        [ -n "$first" ] && rem="$first"
    fi
    echo "$rem"
}

get_available_remotes() {
    local all_remotes=$( {
        get_cached_rclone_remotes
        uci show nas_phone 2>/dev/null | grep "=cloud_account" | cut -d'.' -f2 | cut -d'=' -f1
    } | sed '/^$/d' | sort -u )
    printf "["
    local first=1
    for r in $all_remotes; do
        [ $first -eq 0 ] && printf ","
        first=0
        printf "\"%s\"" "$r"
    done
    printf "]"
}

get_available_phones() {
    printf "["
    local first=1
    for s in $(uci show nas_phone 2>/dev/null | grep "=phone_node" | cut -d'.' -f2 | cut -d'=' -f1); do
        local p_name=$(uci -q get nas_phone.${s}.name || echo "$s")
        local p_ip=$(uci -q get nas_phone.${s}.ip || echo "")
        [ -z "$p_ip" ] && continue
        local is_online=0
        if grep -q "^${p_ip}[[:space:]].*0x2" /proc/net/arp 2>/dev/null; then
            is_online=1
        elif ping -c 1 -W 1 "$p_ip" >/dev/null 2>&1; then
            is_online=1
        fi
        [ $first -eq 0 ] && printf ","
        first=0
        printf "{\"id\":\"%s\",\"name\":\"%s\",\"ip\":\"%s\",\"online\":%d}" \
            "$s" "$p_name" "$p_ip" "$is_online"
    done
    printf "]"
}

get_storage_info() {
    local free_gb="0"
    local total_gb="0"
    local use_pct="0%"
    local is_mounted=0
    if df -P /mnt/storage 2>/dev/null | grep -q "/mnt/storage"; then
        is_mounted=1
        free_gb=$(df -m /mnt/storage 2>/dev/null | tail -1 | awk '{printf "%.1f", $4/1024}')
        total_gb=$(df -m /mnt/storage 2>/dev/null | tail -1 | awk '{printf "%.1f", $2/1024}')
        use_pct=$(df -P /mnt/storage 2>/dev/null | tail -1 | awk '{print $5}')
    fi
    echo "{\"mounted\":$is_mounted,\"free_gb\":\"${free_gb}\",\"total_gb\":\"${total_gb}\",\"use_pct\":\"${use_pct}\"}"
}

check_offpeak_window() {
    init_config
    # 1. EMERGENCY HIGH-WATERMARK CHECK (NAS GẦN ĐẦY):
    # Nếu dung lượng lưu trữ /mnt/storage >= 80% hoặc trống < 5GB, tự chủ kích hoạt ngay!
    local storage_pct=$(df -P /mnt/storage 2>/dev/null | tail -1 | awk '{gsub("%","",$5); print $5}')
    [ -z "$storage_pct" ] && storage_pct=0
    if [ "$storage_pct" -ge 80 ]; then
        logger -t cloud_cam "STORAGE URGENT (${storage_pct}% >= 80%): Đầy bộ nhớ NAS! Tự chủ kích hoạt đẩy lên Cloud để giải phóng bộ nhớ."
        return 0
    fi

    # 2. KIỂM TRA KHUNG GIỜ VẮNG / BAN ĐÊM (Mặc định 00:00 - 05:30):
    local start_h=$(uci -q get camera.settings.offpeak_start || echo "0000")
    local end_h=$(uci -q get camera.settings.offpeak_end || echo "0530")
    start_h=$(echo "$start_h" | tr -d ':')
    end_h=$(echo "$end_h" | tr -d ':')
    [ -z "$start_h" ] && start_h="0000"
    [ -z "$end_h" ] && end_h="0530"

    local cur_h=$(date +%H%M)
    local in_time_window=0
    if [ "$start_h" -le "$end_h" ]; then
        if [ "$cur_h" -ge "$start_h" ] && [ "$cur_h" -lt "$end_h" ]; then
            in_time_window=1
        fi
    else
        if [ "$cur_h" -ge "$start_h" ] || [ "$cur_h" -lt "$end_h" ]; then
            in_time_window=1
        fi
    fi

    if [ "$in_time_window" -eq 1 ]; then
        return 0
    fi

    # 3. THUẬT TOÁN TÍNH TOÁN THỜI ĐIỂM THIẾT BỊ ÍT TRUY CẬP (HEURISTIC LOW-ACCESS WINDOW):
    # Nếu có clip chờ đẩy và bộ nhớ >= 65%:
    # Đếm số thiết bị Wi-Fi đang kết nối và đo kiểm lưu lượng mạng LAN
    if [ "$storage_pct" -ge 65 ]; then
        local active_wifi=0
        for p in /sys/class/net/phy*-ap0 /sys/class/net/rax* /sys/class/net/wlan*; do
            local ifname=$(basename "$p" 2>/dev/null)
            if [ -n "$ifname" ] && [ -d "$p" ]; then
                local wcnt=$(iwinfo "$ifname" assoclist 2>/dev/null | grep -c "dBm" || echo 0)
                active_wifi=$(( active_wifi + wcnt ))
            fi
        done

        # Đọc lưu lượng LAN qua br-lan trong 1 giây
        local rx1=$(cat /sys/class/net/br-lan/statistics/rx_bytes 2>/dev/null || echo 0)
        sleep 1
        local rx2=$(cat /sys/class/net/br-lan/statistics/rx_bytes 2>/dev/null || echo 0)
        local rate_kb=$(( (rx2 - rx1) / 1024 ))

        # Nếu chỉ có <= 2 thiết bị kết nối và lưu lượng < 80 KB/s (mạng rảnh, gia đình đang ngủ/đi vắng)
        if [ "$active_wifi" -le 2 ] && [ "$rate_kb" -lt 80 ]; then
            logger -t cloud_cam "HEURISTIC LOW-ACCESS DETECTED (Clients: $active_wifi, LAN Throughput: ${rate_kb} KB/s, Disk: ${storage_pct}%): Kích hoạt đẩy Cloud tự chủ!"
            return 0
        fi
    fi

    return 1
}

get_nas_dir() {
    local raw_target="$1"
    [ -z "$raw_target" ] && raw_target=$(get_storage_target)
    local target_mode=$(echo "$raw_target" | cut -d':' -f1)
    local target_node=$(echo "$raw_target" | cut -d':' -f2 -s)

    # ƯU TIÊN 1: PHONE NAS (Điện thoại NAS WebDAV / Folder Airdrop)
    local n_dir=""
    local phone_found=""
    if [ -d "/mnt/storage/airdrop/Phones" ]; then
        for p in /mnt/storage/airdrop/Phones/*; do
            if [ -d "$p" ]; then
                phone_found="$p/Camera_NAS"
                break
            fi
        done
    fi
    if [ -n "$phone_found" ]; then
        n_dir="$phone_found"
        logger -t cloud_cam "NAS PRIORITY 1: Đã chọn Phone NAS (${n_dir}) làm điểm lưu trữ chính!"
    elif [ -d "/mnt/phone_nas" ]; then
        n_dir="/mnt/phone_nas/Camera_NAS"
        logger -t cloud_cam "NAS PRIORITY 1: Đã chọn /mnt/phone_nas làm điểm lưu trữ chính!"
    fi

    # ƯU TIÊN 2: ROUTER STORAGE (Chỉ khi Phone NAS không có và ổ đĩa Router được MOUNT thực tế)
    if [ -z "$n_dir" ]; then
        if grep -qs ' /mnt/storage ' /proc/mounts; then
            n_dir="/mnt/storage/airdrop/Camera_NAS"
            logger -t cloud_cam "NAS PRIORITY 2: Không có Phone NAS, sử dụng Router NAS (/mnt/storage)"
        else
            # ƯU TIÊN 3: BỘ ĐỆM RAM AN TOÀN (Tuyệt đối không ghi mòn Flash UBI)
            n_dir="/tmp/Camera_NAS"
            logger -t cloud_cam "NAS PRIORITY 3: Không có Phone NAS & Ổ cứng ngoài, đệm RAM (${n_dir}) và đẩy Cloud tự chủ!"
        fi
    fi
    [ ! -d "$n_dir" ] && mkdir -p "$n_dir" 2>/dev/null

    # If target_node is specified (e.g. Samsung-SM-F711N), ensure phone folder exists and link Camera_NAS inside it
    if [ -n "$target_node" ]; then
        local p_dir="/mnt/storage/airdrop/Phones/${target_node}"
        mkdir -p "$p_dir" 2>/dev/null
        ln -sfn "$n_dir" "$p_dir/Camera_NAS" 2>/dev/null
    fi

    # Seamless mapping: link across all existing Phone folders so browsing either Phones/<Phone> or Camera_NAS shows the clips
    if [ -d "/mnt/storage/airdrop/Phones" ]; then
        for d in /mnt/storage/airdrop/Phones/*; do
            if [ -d "$d" ] && [ ! -L "$d/Camera_NAS" ]; then
                ln -sfn "$n_dir" "$d/Camera_NAS" 2>/dev/null
            fi
        done
    fi
    if [ -d "/mnt/storage/airdrop/Phone_NAS_512GB" ] && [ ! -L "/mnt/storage/airdrop/Phone_NAS_512GB/Camera_NAS" ]; then
        ln -sfn "$n_dir" "/mnt/storage/airdrop/Phone_NAS_512GB/Camera_NAS" 2>/dev/null
    fi
    echo "$n_dir"
}

find_cam_section() {
    local search="$1"
    init_config
    if [ -n "$(uci -q get camera.${search}.ip)" ]; then
        echo "$search"
        return 0
    fi
    for s in $(uci show camera 2>/dev/null | grep "=camera" | cut -d'.' -f2 | cut -d'=' -f1); do
        local c_name=$(uci -q get camera.${s}.name)
        local c_ip=$(uci -q get camera.${s}.ip)
        if [ "$c_name" = "$search" ] || [ "$c_ip" = "$search" ]; then
            echo "$s"
            return 0
        fi
    done
    return 1
}

