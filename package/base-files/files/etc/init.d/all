#!/bin/sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

while true; do
    if [ -f /etc/config/device_rules ] && command -v nft >/dev/null 2>&1; then
        now=$(date +%s)
        cur_hm=$(date +%H:%M)
        while IFS='=' read -r mac val; do
            [ -z "$mac" ] && continue
            mac=$(echo "$mac" | tr '[:upper:]' '[:lower:]')
            mode=$(echo "$val" | cut -d'|' -f1)
            st=$(echo "$val" | cut -d'|' -f2)
            et=$(echo "$val" | cut -d'|' -f3)
            exp=$(echo "$val" | cut -d'|' -f4)
            [ -z "$exp" ] && exp=0

            should_block=0
            if [ "$mode" = "block" ]; then
                should_block=1
            elif [ "$exp" -gt 0 ]; then
                rem_sec=$((exp - now))
                if [ "$rem_sec" -le 300 ] && [ "$rem_sec" -gt 0 ]; then
                    clean_m_tag=$(echo "$mac" | tr -d ':')
                    if [ ! -f "/tmp/warn_5m_${clean_m_tag}.flag" ]; then
                        touch "/tmp/warn_5m_${clean_m_tag}.flag"
                        d_name=$(grep -i "$mac" /tmp/dhcp.leases 2>/dev/null | awk '{print $4}')
                        [ -z "$d_name" ] || [ "$d_name" = "*" ] && d_name="$mac"
                        /usr/bin/send_telegram "⚠️ <b>CẢNH BÁO GẦN HẾT GIỜ TRUY CẬP:</b>
━━━━━━━━━━━━━━━━━━━
📱 Thiết bị: <b>${d_name}</b> (<code>${mac}</code>)
⏱️ Thời gian còn lại: <b>Khoảng 5 phút</b>
⛔ Hết thời gian này, router sẽ tự động ngắt kết nối Internet!" >/dev/null 2>&1 &
                    fi
                fi
                if [ "$now" -ge "$exp" ]; then
                    should_block=1
                    clean_m_tag=$(echo "$mac" | tr -d ':')
                    if [ ! -f "/tmp/blocked_${clean_m_tag}.flag" ]; then
                        touch "/tmp/blocked_${clean_m_tag}.flag"
                        d_name=$(grep -i "$mac" /tmp/dhcp.leases 2>/dev/null | awk '{print $4}')
                        [ -z "$d_name" ] || [ "$d_name" = "*" ] && d_name="$mac"
                        /usr/bin/send_telegram "⛔ <b>ĐÃ HẾT GIỜ TRUY CẬP:</b>
━━━━━━━━━━━━━━━━━━━
📱 Thiết bị: <b>${d_name}</b> (<code>${mac}</code>)
🚫 Đã tự động chặn kết nối mạng theo lịch hẹn!" >/dev/null 2>&1 &
                    fi
                fi
            elif [ "$mode" = "time" ] && [ -n "$st" ] && [ -n "$et" ]; then
                if [ "$st" \> "$et" ]; then
                    if [ "$cur_hm" \< "$st" ] && [ "$cur_hm" \> "$et" ]; then should_block=1; fi
                else
                    if [ "$cur_hm" \< "$st" ] || [ "$cur_hm" \> "$et" ]; then should_block=1; fi
                fi
            fi

            if [ "$should_block" -eq 1 ]; then
                if ! nft list set inet master_guard mac_blacklist 2>/dev/null | grep -qi "$mac"; then
                    nft add element inet master_guard mac_blacklist "{ $mac }" 2>/dev/null
                    for sock in /var/run/hostapd/*; do
                        [ -S "$sock" ] || continue
                        w=$(basename "$sock")
                        hostapd_cli -i "$w" -p /var/run/hostapd deny_mac ADD "$mac" >/dev/null 2>&1
                        hostapd_cli -i "$w" -p /var/run/hostapd disassociate "$mac" >/dev/null 2>&1
                        hostapd_cli -i "$w" -p /var/run/hostapd deauthenticate "$mac" >/dev/null 2>&1
                    done
                    if command -v iw >/dev/null 2>&1; then
                        for w_dev in $(iw dev 2>/dev/null | grep "Interface" | awk '{print $2}'); do
                            iw dev "$w_dev" station del "$mac" >/dev/null 2>&1
                        done
                    fi
                    if command -v conntrack >/dev/null 2>&1; then
                        for rip in $(grep -i "$mac" /proc/net/arp /tmp/dhcp.leases 2>/dev/null | awk '{print $1 $3}' | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$'); do
                            conntrack -D -s "$rip" >/dev/null 2>&1
                            conntrack -D -d "$rip" >/dev/null 2>&1
                        done
                    fi
                fi
            else
                if nft list set inet master_guard mac_blacklist 2>/dev/null | grep -qi "$mac"; then
                    nft delete element inet master_guard mac_blacklist "{ $mac }" 2>/dev/null
                    for sock in /var/run/hostapd/*; do
                        [ -S "$sock" ] || continue
                        w=$(basename "$sock")
                        hostapd_cli -i "$w" -p /var/run/hostapd deny_mac DEL "$mac" >/dev/null 2>&1
                    done
                fi
            fi
        done < /etc/config/device_rules
    fi

    # ⏱️ BỘ GIÁM SÁT THỜI GIAN TRUY CẬP TRẺ EM & THIẾT BỊ (30P - 45P - 60P)
    if [ -f /etc/config/monitored_devices.conf ]; then
