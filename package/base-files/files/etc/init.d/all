        function switchNasConfigTab(tab) {
            document.getElementById('tabBtnPhones').classList.toggle('active', tab === 'phones');
            document.getElementById('tabBtnClouds').classList.toggle('active', tab === 'clouds');
            document.getElementById('tabBtnRemoteAccess').classList.toggle('active', tab === 'remote_access');
            document.getElementById('nasTabPhones').style.display = (tab === 'phones') ? 'block' : 'none';
            document.getElementById('nasTabClouds').style.display = (tab === 'clouds') ? 'block' : 'none';
            document.getElementById('nasTabRemoteAccess').style.display = (tab === 'remote_access') ? 'block' : 'none';
            if (tab === 'remote_access') {
                checkFunnelStatus();
            }
        }

        async function checkFunnelStatus() {
            const badge = document.getElementById('nasFunnelStatusBadge');
            if (badge) badge.innerText = 'Đang kiểm tra...';
            try {
                const res = await fetch(`${API}?action=check_funnel&t=${Date.now()}`);
                const data = await res.json();
                if (data.tailscale_ip) {
                    const elIp = document.getElementById('nasTsIpVal');
                    if (elIp) elIp.innerText = data.tailscale_ip;
                    const elDisp = document.getElementById('nasTsIpDisplay');
                    if (elDisp) elDisp.innerText = `${data.tailscale_ip}:8080`;
                }
                if (data.domain) {
                    const elDom = document.getElementById('nasTsDomainVal');
                    if (elDom) elDom.innerText = data.domain;
                }
                const elCustomInput = document.getElementById('nasCustomPublicDomain');
                if (elCustomInput && data.custom_domain) {
                    elCustomInput.value = data.custom_domain;
                }
                const elDirect = document.getElementById('nasFunnelDirectLink');
                if (elDirect && data.funnel_url) {
                    elDirect.innerText = data.funnel_url;
                }
                const badgeDomain = document.getElementById('nasCustomDomainBadgeModal');
                if (badgeDomain) {
                    if (data.is_custom || (data.custom_domain && data.custom_domain.length > 0)) {
                        badgeDomain.innerText = '🟢 Tên Miền Riêng: ' + data.custom_domain;
                        badgeDomain.style.background = 'rgba(16,185,129,0.2)';
                        badgeDomain.style.color = '#34d399';
                        badgeDomain.style.borderColor = 'rgba(16,185,129,0.4)';
                    } else if (data.funnel_url && data.funnel_url.indexOf('trycloudflare.com') !== -1) {
                        badgeDomain.innerText = '⚡ Cloudflare Tự Động';
                        badgeDomain.style.background = 'rgba(56,189,248,0.2)';
                        badgeDomain.style.color = '#38bdf8';
                        badgeDomain.style.borderColor = 'rgba(56,189,248,0.4)';
                    } else {
                        badgeDomain.innerText = '🏠 Mạng Nội Bộ (LAN)';
                        badgeDomain.style.background = 'rgba(148,163,184,0.2)';
                        badgeDomain.style.color = '#94a3b8';
                        badgeDomain.style.borderColor = 'rgba(148,163,184,0.3)';
                    }
                }
                const elTokenInput = document.getElementById('nasCfTokenInputModal');
                if (elTokenInput && data.cf_token) {
                    elTokenInput.value = data.cf_token;
                }
                const elEmailInput = document.getElementById('nasCfAutoEmailModal');
                if (elEmailInput && data.cf_email) elEmailInput.value = data.cf_email;
                const elKeyInput = document.getElementById('nasCfAutoKeyModal');
                if (elKeyInput && data.cf_key) elKeyInput.value = data.cf_key;
                if (badge) {
                    if (data.is_custom || (data.custom_domain && data.custom_domain.length > 0)) {
                        if (data.custom_domain.indexOf('100.') !== -1 || data.custom_domain.indexOf('.ts.net') !== -1) {
                            badge.innerText = '🔒 Giải Pháp 3: Tailscale Cố Định (' + data.custom_domain + ')';
                            badge.style.background = 'rgba(139,92,246,0.2)';
                            badge.style.color = '#c4b5fd';
                            badge.style.borderColor = 'rgba(139,92,246,0.4)';
                        } else {
                            badge.innerText = '🟢 Giải Pháp 2: Tên Miền Riêng ' + data.custom_domain;
                            badge.style.background = 'rgba(16,185,129,0.2)';
                            badge.style.color = '#34d399';
                            badge.style.borderColor = 'rgba(16,185,129,0.4)';
                        }
                    } else if (data.funnel_url && data.funnel_url.indexOf('trycloudflare.com') !== -1) {
                        badge.innerText = '⚡ Giải Pháp 1: Cloudflare Tunnel Tự Động (0đ)';
                        badge.style.background = 'rgba(56,189,248,0.2)';
                        badge.style.color = '#38bdf8';
                        badge.style.borderColor = 'rgba(56,189,248,0.4)';
                    } else if (data.active) {
                        badge.innerText = '🟢 Funnel Hoạt Động (Toàn Cầu)';
                        badge.style.background = 'rgba(16,185,129,0.2)';
                        badge.style.color = '#34d399';
                        badge.style.borderColor = 'rgba(16,185,129,0.4)';
                    } else {
                        badge.innerText = '🟡 Mạng Nội Bộ / LAN';
                        badge.style.background = 'rgba(245,158,11,0.2)';
                        badge.style.color = '#fbbf24';
                    }
                }
            } catch (err) {
                if (badge) {
                    badge.innerText = '⚠️ Lỗi kiểm tra';
                    badge.style.background = 'rgba(239,68,68,0.2)';
                    badge.style.color = '#f87171';
                }
            }
        }

        async function openNasConfigModal() {
            document.getElementById('nasConfigModal').classList.add('open');
            await loadNasClusterData();
        }

        async function loadNasClusterData() {
            try {
                const res = await fetch(`${API}?action=get_nas&t=${Date.now()}`);
                currentNasData = await res.json();

                // 1. Populate LAN Wi-Fi devices dropdown
                const devSelect = document.getElementById('nasLanDeviceSelect');
                if (devSelect) {
                    devSelect.innerHTML = '<option value="">-- Chọn thiết bị Wi-Fi đang kết nối --</option>';
                    if (currentNasData.lan_devices && currentNasData.lan_devices.length > 0) {
                        currentNasData.lan_devices.forEach(d => {
                            const opt = document.createElement('option');
                            opt.value = `${d.ip}|${d.name}`;
                            opt.textContent = `📶 ${d.name} (${d.ip})`;
                            devSelect.appendChild(opt);
                        });
                    }
                }

                // 2. Render Sidebar Phones & Storage items
                renderSidebarPhones(currentNasData.phones || []);
                renderSidebarClouds(currentNasData.clouds || []);
                updateStorageTotalLabel(currentNasData.phones || [], currentNasData.clouds || []);

                // 3. Render Sidebar Menus for Phones & Clouds
                renderSidebarMenus(currentNasData.phones || [], currentNasData.clouds || []);

                // 4. Render Phone Cluster Table in Modal
                renderPhoneTable(currentNasData.phones || []);
                loadDiscoveredPhones();

                // 5. Render Cloud Accounts Table in Modal
                renderCloudTable(currentNasData.clouds || []);

                // 6. Update Network & Funnel displays
                if (currentNasData.tailscale_ip) {
                    const elIp = document.getElementById('nasTsIpVal');
                    if (elIp) elIp.innerText = currentNasData.tailscale_ip;
                    const elDisp = document.getElementById('nasTsIpDisplay');
                    if (elDisp) elDisp.innerText = `${currentNasData.tailscale_ip}:8080`;
                }
                if (currentNasData.tailscale_domain) {
                    const elDom = document.getElementById('nasTsDomainVal');
                    if (elDom) elDom.innerText = currentNasData.tailscale_domain;
                }
                const elLink = document.getElementById('nasFunnelDirectLink');
                if (elLink) {
                    elLink.innerText = currentNasData.funnel_url ? (currentNasData.funnel_url + '/') : 'Chưa kích hoạt';
                }
                const elCustom = document.getElementById('nasCustomPublicDomain');
                if (elCustom && currentNasData.public_domain !== undefined) {
                    elCustom.value = currentNasData.public_domain || '';
                }
            } catch (e) {
                console.error('Error loading NAS data:', e);
            }
        }

        function openFunnelPublicPage() {
            const url = (currentNasData && currentNasData.funnel_url) ? (currentNasData.funnel_url + '/') : (window.location.origin + '/');
            window.open(url, '_blank');
        }

        async function saveCustomPublicDomain() {
            const input = document.getElementById('nasCustomPublicDomain');
            if (!input) return;
            const domain = input.value.trim();
            showToast('⏳ Đang lưu cấu hình tên miền công khai...');
            try {
                const res = await fetch(`${API}?action=save_remote_domain&domain=${encodeURIComponent(domain)}`);
                const d = await res.json();
                showToast(d.message || '✅ Đã lưu tên miền công khai thành công!');
                await loadNasClusterData();
                checkFunnelStatus();
            } catch (e) {
                showToast('❌ Lỗi kết nối lưu tên miền');
            }
        }

        function toggleCfTokenSection() {
            const wrapper = document.getElementById('nasCfTokenWrapperModal');
            const btn = document.getElementById('btnToggleCfToken');
            if (!wrapper) return;
            const isHidden = (wrapper.style.display === 'none' || wrapper.style.display === '');
            wrapper.style.display = isHidden ? 'block' : 'none';
            if (btn) btn.innerText = isHidden ? '▲ Ẩn Cấu Hình Cloudflare' : '▼ Cấu Hình Cloudflare 1-Click / Token (Nâng Cao)';
        }

        async function runCfAutoProvision() {
            const domainInput = document.getElementById('nasCfAutoDomainModal');
            const mainDomainInput = document.getElementById('nasCustomPublicDomain');
            const emailInput = document.getElementById('nasCfAutoEmailModal');
            const keyInput = document.getElementById('nasCfAutoKeyModal');
            const statusDiv = document.getElementById('nasCfAutoStatusModal');
            const btn = document.getElementById('btnCfAutoProvision');

            const domain = (domainInput ? domainInput.value.trim() : '') || (mainDomainInput ? mainDomainInput.value.trim() : '');
            const email = emailInput ? emailInput.value.trim() : '';
            const key = keyInput ? keyInput.value.trim() : '';

            if (!domain || !key) {
                alert('⚠️ Vui lòng nhập Tên miền và Global API Key / Token!');
                return;
            }

            if (btn) {
                btn.innerText = '⏳ Đang tự động cấu hình Cloudflare...';
                btn.disabled = true;
            }
            if (statusDiv) {
                statusDiv.style.display = 'block';
                statusDiv.style.background = 'rgba(56,189,248,0.15)';
                statusDiv.style.color = '#38bdf8';
                statusDiv.style.border = '1px solid rgba(56,189,248,0.3)';
                statusDiv.innerHTML = '🔄 Đang liên hệ Cloudflare API: Xác thực tài khoản, tạo Ingress Route và DNS CNAME...';
            }

            try {
                const res = await fetch(`${API}?action=cf_auto_provision&domain=${encodeURIComponent(domain)}&email=${encodeURIComponent(email)}&key=${encodeURIComponent(key)}`);
                const data = await res.json();
                if (btn) {
                    btn.innerText = '🚀 1-Click Tự Động Thiết Lập Tất Cả Từ A-Z';
                    btn.disabled = false;
                }
                if (data.status === 'success') {
                    if (statusDiv) {
                        statusDiv.style.background = 'rgba(16,185,129,0.15)';
                        statusDiv.style.color = '#34d399';
                        statusDiv.style.border = '1px solid rgba(16,185,129,0.3)';
                        statusDiv.innerHTML = '🎉 ' + (data.message || 'Thành công 100%!') + '<br>👉 Link truy cập: <a href="' + (data.public_url || ('https://' + domain)) + '" target="_blank" style="color:#6ee7b7; font-weight:700; text-decoration:underline;">' + (data.public_url || ('https://' + domain)) + '</a>';
                    }
                    showToast('🎉 Cấu hình Cloudflare 1-Click thành công 100%!');
                    if (mainDomainInput) mainDomainInput.value = data.domain || domain;
                    await loadNasClusterData();
                    setTimeout(checkFunnelStatus, 3000);
                } else {
                    if (statusDiv) {
                        statusDiv.style.background = 'rgba(239,68,68,0.15)';
                        statusDiv.style.color = '#f87171';
                        statusDiv.style.border = '1px solid rgba(239,68,68,0.3)';
                        statusDiv.innerHTML = '❌ Lỗi: ' + (data.message || 'Không thể thiết lập Cloudflare');
                    }
                    showToast('❌ Lỗi Cloudflare: ' + (data.message || 'Thất bại'));
                }
            } catch (err) {
                if (btn) {
                    btn.innerText = '🚀 1-Click Tự Động Thiết Lập Tất Cả Từ A-Z';
                    btn.disabled = false;
                }
                if (statusDiv) {
                    statusDiv.style.background = 'rgba(239,68,68,0.15)';
                    statusDiv.style.color = '#f87171';
                    statusDiv.innerHTML = '❌ Lỗi kết nối: ' + err;
                }
                showToast('❌ Lỗi kết nối đến Router');
            }
        }

        async function saveCustomPublicToken() {
            const tokenInput = document.getElementById('nasCfTokenInputModal');
            const domainInput = document.getElementById('nasCustomPublicDomain');
            let token = tokenInput ? tokenInput.value.trim() : '';
            const m = token.match(/(eyJh[A-Za-z0-9_\-]+)/);
            if (m) {
                token = m[1];
                tokenInput.value = token;
            }
            const domain = domainInput ? domainInput.value.trim() : '';
            showToast('⏳ Đang kích hoạt Cloudflare Tunnel Token...');
            try {
                const res = await fetch(`${API}?action=save_remote_domain&domain=${encodeURIComponent(domain)}&token=${encodeURIComponent(token)}`);
                const d = await res.json();
                showToast(d.message || '✅ Đã kích hoạt Token Cloudflare Tunnel thành công!');
                await loadNasClusterData();
                setTimeout(checkFunnelStatus, 2000);
            } catch (e) {
                showToast('❌ Lỗi kết nối kích hoạt token');
            }
        }

        async function useAutoCloudflare() {
            if (!confirm('Chuyển về chế độ Cloudflare Quick Tunnel tự động (Miễn phí, không cần tên miền riêng)?')) return;
            const input = document.getElementById('nasCustomPublicDomain');
            if (input) input.value = '';
            showToast('⏳ Đang chuyển sang Cloudflare Tunnel tự động...');
            try {
                const res = await fetch(`${API}?action=save_remote_domain&domain=`);
                const d = await res.json();
                showToast('✅ Đã chuyển về Cloudflare Tunnel tự động!');
                await loadNasClusterData();
                checkFunnelStatus();
            } catch (e) {
                showToast('❌ Lỗi kết nối lưu cấu hình');
            }
        }

        async function useTailscaleFixedDomain() {
            showToast('⏳ Đang kiểm tra & tự động bật Tailscale...');
            try {
                const res = await fetch(`${API}?action=use_tailscale`);
                const d = await res.json();
                if (d.ok || d.status === 'success') {
                    showToast(d.message || '✅ Đã chuyển sang Tên Miền Cố Định Tailscale!');
                    const input = document.getElementById('nasCustomPublicDomain');
                    if (input) input.value = d.public_url || ('http://' + d.tailscale_ip + ':8080');
                    await loadNasClusterData();
                    checkFunnelStatus();
                } else if (d.status === 'need_auth') {
                    alert('⚠️ Tailscale đã bật nhưng chưa đăng nhập Router!\nVui lòng truy cập liên kết sau để xác thực:\n\n' + (d.auth_url || ''));
                    if (d.auth_url) window.open(d.auth_url, '_blank');
                } else {
                    showToast('❌ Lỗi Tailscale: ' + (d.message || 'Không thể kích hoạt'));
                }
            } catch (e) {
                showToast('❌ Lỗi kết nối kích hoạt Tailscale');
            }
        }

        function renderSidebarPhones(phones) {
            const container = document.getElementById('sidebarPhonesContainer');
            if (!container) return;
            let html = '';
            // Only show ONLINE phones to keep the interface ultra-clean and decluttered
            const onlinePhones = (phones || []).filter(p => p.online || (p.status && p.status.includes('trực tuyến')) || (p.is_alive === 1 && p.ping !== 'offline'));
            if (onlinePhones.length === 0) {
                container.innerHTML = `
                    <div class="storage-item" style="opacity:0.6; padding: 4px 0;">
                        <div class="storage-header">
                            <span class="storage-name" style="font-size:0.75rem;">📱 Cụm Phone NAS</span>
                            <span class="storage-meta" style="color:var(--text-sub); font-size:0.7rem;">Sẵn sàng kết nối</span>
                        </div>
                    </div>`;
                return;
            }
            onlinePhones.forEach(p => {
                const folderSlug = p.folder_slug || ('Phones/' + (p.name || p.ip).replace(/[^\w-]/g, '_'));
                const batLabel = (p.battery !== undefined && p.battery >= 0) ? `🔋 ${p.battery}% ${p.charging ? '⚡ ' : ''}• ` : '';
                html += `
                    <div class="storage-item" style="cursor:pointer; margin-top:6px;" onclick="switchFolder('${escapeHtml(folderSlug)}')" title="Bấm để mở thư mục ${escapeHtml(p.name)}">
                        <div class="storage-header">
                            <span class="storage-name">📱 ${escapeHtml(p.name)}</span>
                            <span class="storage-meta" style="color:#4ade80; font-weight:700;">
                                ${batLabel}🟢 ${escapeHtml(p.ping || 'Online')}
                            </span>
                        </div>
                        <div class="progress-bar-bg">
                            <div class="progress-fill-green" style="width:80%;"></div>
                        </div>
                    </div>`;
            });
            container.innerHTML = html;
        }

        function renderSidebarClouds(clouds) {
            const container = document.getElementById('sidebarCloudsContainer');
            if (!container) return;
            if (!clouds || clouds.length === 0) {
                container.innerHTML = '';
                return;
            }
            // Deduplicate clouds by email / name to eliminate cluttered duplicates
            const seen = new Set();
            const uniqueClouds = [];
            clouds.forEach(c => {
                const key = (c.email || c.name || c.remote || '').toLowerCase().trim();
                if (!seen.has(key)) {
                    seen.add(key);
                    uniqueClouds.push(c);
                }
            });

            let html = '';
            uniqueClouds.forEach(c => {
                const sub = c.subfolder || ('Cloud_Sync/' + (c.name || 'Cloud').replace(/[^\w-]/g, '_'));
                const icon = c.service === 'onedrive' ? '☁️' : (c.service === 'dropbox' ? '📦' : '☁️');
                const used = c.quota_used || '95.2 MB';
                const total = c.quota_total || '5.00 TB';
                const free = c.quota_free || '4.99 TB';
                const pct = (c.quota_pct !== undefined && c.quota_pct > 0) ? Math.max(c.quota_pct, 2) : 2;
                const cName = c.name || (c.service === 'gdrive' ? 'Google Drive' : 'Cloud Storage');

                html += `
                    <div class="storage-item" style="cursor:pointer; margin-top:8px; border-top:1px dashed rgba(56,189,248,0.25); padding-top:8px;" onclick="switchFolder('${escapeHtml(sub)}')" title="Bấm để mở thư mục ${escapeHtml(cName)} (${escapeHtml(c.email)})">
                        <div class="storage-header">
                            <span class="storage-name" style="color:var(--accent-cyan,#38bdf8); font-weight:700;">${icon} ${escapeHtml(cName)}</span>
                            <span class="storage-meta" style="color:var(--accent-cyan,#38bdf8); font-weight:700;">${escapeHtml(used)} / ${escapeHtml(total)}</span>
                        </div>
                        <div class="progress-bar-bg" style="background:rgba(56,189,248,0.15);">
                            <div style="height:100%; width:${pct}%; border-radius:4px; background:linear-gradient(90deg, #38bdf8, #06b6d4); box-shadow:0 0 8px rgba(56,189,248,0.5);"></div>
                        </div>
                        <div style="display:flex; justify-content:space-between; font-size:0.68rem; color:var(--text-muted); margin-top:3px;">
                            <span>${escapeHtml(c.email || 'Cloud')}</span>
                            <span style="color:#34d399; font-weight:600;">Trống: ${escapeHtml(free)}</span>
                        </div>
                    </div>`;
            });
            container.innerHTML = html;
        }

        function updateStorageTotalLabel(phones, clouds) {
            const totalLabel = document.getElementById('storageTotalLabel');
            if (!totalLabel) return;
            const onlinePhones = (phones || []).filter(p => p.online || (p.status && p.status.includes('trực tuyến')) || (p.is_alive === 1 && p.ping !== 'offline'));
            const pCount = onlinePhones.length;
            const pGb = pCount * 512;
            let cloudTotalTb = 0;
            if (clouds && clouds.length > 0) {
                const seen = new Set();
                clouds.forEach(c => {
                    const key = (c.email || c.name || c.remote || '').toLowerCase().trim();
                    if (!seen.has(key) && c.quota_total && c.quota_total.includes('TB')) {
                        seen.add(key);
                        cloudTotalTb += parseFloat(c.quota_total) || 5;
                    }
                });
            }
            const baseStorageName = (window._lastSysStats && window._lastSysStats.storage_type) || 'Bộ Nhớ Trong';
            const baseStorageTotal = (window._lastSysStats && window._lastSysStats.emmc_total) || 'Flash';
            if (cloudTotalTb > 0) {
                totalLabel.innerText = `${baseStorageTotal} + ${pGb > 0 ? pGb + 'GB + ' : ''}${cloudTotalTb}TB Cloud`;
            } else if (pGb > 0) {
                totalLabel.innerText = `${baseStorageTotal} + ${pGb}GB (${pCount} máy)`;
            } else {
                totalLabel.innerText = `${baseStorageTotal} (${baseStorageName})`;
            }
        }

        function renderSidebarMenus(phones, clouds) {
            const phoneMenu = document.getElementById('sidebarPhoneMenuItems');
            if (phoneMenu) {
                let pHtml = '';
                const onlinePhones = (phones || []).filter(p => p.online || (p.status && p.status.includes('trực tuyến')) || (p.is_alive === 1 && p.ping !== 'offline'));
                if (onlinePhones.length === 0) {
                    pHtml = '<div style="font-size:0.72rem; color:var(--text-muted); padding:6px 14px;">Không có thiết bị trực tuyến</div>';
                } else {
                    onlinePhones.forEach(p => {
                        const folderSlug = p.folder_slug || ('Phones/' + (p.name || p.ip).replace(/[^\w-]/g, '_'));
                        pHtml += `
                            <div class="nav-item ${currentFolder === folderSlug ? 'active' : ''}" onclick="switchFolder('${escapeHtml(folderSlug)}')" data-folder="${escapeHtml(folderSlug)}" title="${escapeHtml(p.name)} (${p.ip})">
                                <span class="nav-icon">📱</span>
                                <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:130px;">${escapeHtml(p.name)}</span>
                                <span style="font-size:0.65rem; margin-left:auto; padding:2px 6px; border-radius:10px; font-weight:700; background:rgba(16,185,129,0.2); color:#4ade80;">Online</span>
                            </div>`;
                    });
                }
                phoneMenu.innerHTML = pHtml;
            }

            const cloudMenu = document.getElementById('sidebarCloudMenuItems');
            if (cloudMenu) {
                let cHtml = '';
                if (!clouds || clouds.length === 0) {
                    cHtml = '<div style="font-size:0.72rem; color:var(--text-muted); padding:6px 14px;">Chưa liên kết tài khoản Cloud</div>';
                } else {
                    const seen = new Set();
                    clouds.forEach(c => {
                        const key = (c.email || c.name || c.remote || '').toLowerCase().trim();
                        if (seen.has(key)) return;
                        seen.add(key);
                        const sub = c.subfolder || ('Cloud_Sync/' + (c.name || 'Cloud').replace(/[^\w-]/g, '_'));
                        const icon = c.service === 'onedrive' ? '☁️' : (c.service === 'dropbox' ? '📦' : '☁️');
                        const quotaBadge = c.quota_total ? `<span style="font-size:0.65rem; margin-left:auto; padding:2px 6px; border-radius:10px; font-weight:700; background:rgba(56,189,248,0.2); color:#38bdf8;">${escapeHtml(c.quota_total)}</span>` : '';
                        cHtml += `
                            <div class="nav-item ${currentFolder === sub ? 'active' : ''}" onclick="switchFolder('${escapeHtml(sub)}')" data-folder="${escapeHtml(sub)}" title="${escapeHtml(c.name || c.email)} (${c.quota_used || '95.2 MB'} / ${c.quota_total || '5 TB'})">
                                <span class="nav-icon">${icon}</span>
                                <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:115px;">${escapeHtml(c.name || c.email)}</span>
                                ${quotaBadge}
                            </div>`;
                    });
                }
                cloudMenu.innerHTML = cHtml;
            }
        }

        function applySelectedLanDevice(val) {
            if (!val) return;
            const [ip, name] = val.split('|');
            document.getElementById('nasNewPhoneIp').value = ip || '';
            document.getElementById('nasNewPhoneName').value = name || 'Samsung Phone';
        }

        function renderPhoneTable(phones) {
            const tbody = document.getElementById('nasPhoneTableBody');
