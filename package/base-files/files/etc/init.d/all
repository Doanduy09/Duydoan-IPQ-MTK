function removeTopHeadersDirectly() {
    var targets = document.querySelectorAll('footer, #footer, h2, .cbi-section-title, .cbi-button-neutral, .alert-message, .alert, .warning, .danger, #password_warning');
    targets.forEach(function(el) {
        if (el.closest('#weather-custom-section') === null) {
            el.style.display = 'none';
        }
    });
}

