            click: function(e) {
                if (!confirm("\u26A0\uFE0F Anh c\u00F3 ch\u1EAFc ch\u1EAFn mu\u1ED1n chuy\u1EC3n v\u1EC1 THEME ARGON M\u1EB6C \u0110\u1ECANH kh\u00F4ng?\n\n- Giao di\u1EC7n Web s\u1EBD kh\u00F4i ph\u1EE5c Theme Argon g\u1ED1c nguy\u00EAn b\u1EA3n.\n- \u2705 Modem 5G Watchdog v\u00E0 l\u1EC7nh logall V\u1EAAN TI\u1EBEP T\u1EE4C CH\u1EA0Y \u0110\u1ED8C L\u1EACP 24/7 \u0111\u1EC3 b\u1EA3o v\u1EC7 m\u1EA1ng!\n\n\uD83D\uDCA1 Khi c\u1EA7n b\u1EADt l\u1EA1i Giao di\u1EC7n Master, anh ch\u1EC9 c\u1EA7n g\u00F5: all on (ho\u1EB7c v\u00E0o menu H\u1EC7 Th\u1ED1ng -> Script ALL).")) {
