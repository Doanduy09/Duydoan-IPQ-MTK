                    E('button', { class: 'btn cbi-button cbi-button-action', style: 'padding: 6px 20px; font-weight: 700; background: #ffffff; color: #000000;', click: function(ev) {
                        ev.target.textContent = '⏳ Đang flash...';
                        ev.target.disabled = true;
                        var keepVal = chkKeep.checked ? '1' : '0';
                        var forceVal = chkForce.checked ? '1' : '0';
                        fetch('/cgi-bin/firmware_uploader?action=flash&keep=' + keepVal + '&force=' + forceVal)
                            .then(function(r) { return r.json(); })
                            .then(function(d) {
                                ui.showModal('Đang Cập Nhật', [
                                    E('div', { style: 'text-align: center; padding: 20px;' }, [
