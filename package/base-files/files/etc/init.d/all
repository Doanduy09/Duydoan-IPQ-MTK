                send_tg "$from_id" "âœ… ÄÃ£ Ã¡p dá»¥ng khÃ³a bÄƒng táº§n $arg1" "$token"
                ;;
            /sms_send)
                if [ -n "$arg1" ] && [ -n "$arg2" ]; then
