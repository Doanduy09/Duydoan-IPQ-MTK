        function updateSentinelOverviewUI(st) {
            if (!st) return;
            if (st.alert_active == 1) {
                sentinelStatusBadge.style.background = '#fef2f2';
                sentinelStatusBadge.style.border = '1px solid #f87171';
                sentinelStatusBadge.style.color = '#dc2626';
                sentinelStatusBadge.textContent = '🚨 ĐANG BÁO ĐỘNG: ' + (st.alert_active_type || 'KHẨN CẤP') + ' (' + (st.alert_active_count || 1) + ' lần)';
            } else if (st.sleep_active == 1) {
                sentinelStatusBadge.style.background = '#fef9c3';
                sentinelStatusBadge.style.border = '1px solid #facc15';
                sentinelStatusBadge.style.color = '#854d0e';
                sentinelStatusBadge.textContent = '💤 ĐANG NGỦ (còn ' + (st.sleep_remaining || 0) + 'p, đến ' + (st.sleep_expire || '--') + ')';
            } else {
                sentinelStatusBadge.style.background = '#ecfdf5';
                sentinelStatusBadge.style.border = '1px solid #6ee7b7';
                sentinelStatusBadge.style.color = '#065f46';
                sentinelStatusBadge.textContent = '🟢 AI Sentinel: ĐANG BẢO VỆ 24/7';
            }
            if (st.sleep_active == 1) {
                sentinelSleepBadge.textContent = '💤 Đang ngủ';
                sentinelSleepBadge.style.background = '#fef3c7';
                sentinelSleepBadge.style.color = '#92400e';
            } else {
                sentinelSleepBadge.textContent = '☀️ Đang thức';
                sentinelSleepBadge.style.background = '#f8fafc';
                sentinelSleepBadge.style.color = '#334155';
            }
            if (st.night_guard_enabled == 1) {
                sentinelNightBadge.textContent = '🌙 Gác đêm: ' + (st.night_guard_start || '00:00') + ' - ' + (st.night_guard_end || '06:00');
            } else {
                sentinelNightBadge.textContent = '☀️ Gác đêm: TẮT';
            }
            if (st.known_faces_count !== undefined) {
                sentinelFacesBadge.textContent = '👨‍👩‍👧 Người quen: ' + st.known_faces_count + ' mặt';
            }
            if (st.emergency_phone) {
                sentinelPhoneBadge.textContent = '📞 Khẩn cấp: ' + st.emergency_phone;
            }
            if (st.cam1_name && st.cam1_ip) {
                sentinelCamBadge.textContent = '📹 ' + st.cam1_name + ' (' + st.cam1_ip + ')';
            }
        }

