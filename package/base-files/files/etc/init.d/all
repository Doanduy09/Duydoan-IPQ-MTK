    cat << 'CCTV_RECORDER_EOF' > /usr/bin/cloud_cam_recorder_daemon.sh
#!/bin/sh
# Sysfixtine 24/7 Continuous Segmented NVR Recorder Daemon v7.0
# Multi-Mode NVR Recording (5p, 10p, 15p, 20p) & Smart Cloud/Telegram Dispatch
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
PID_FILE="/var/run/cloud_cam_recorder.pid"

is_running() {
    if [ -f "$PID_FILE" ]; then
        local p=$(cat "$PID_FILE" 2>/dev/null)
        [ -n "$p" ] && kill -0 "$p" 2>/dev/null && return 0
    fi
    pgrep -f "cloud_cam_recorder_daemon\.sh (master|loop)" >/dev/null 2>&1
}

run_camera_loop() {
    local cam_id="$1"
    local cam_lock="/var/lock/cctv_loop_${cam_id}.lock"
    exec 205>"$cam_lock"
    if ! flock -n 205 2>/dev/null; then
        logger -t cloud_cam_nvr "Camera loop for $cam_id is already active [held by lock]. Skipping duplicate invocation."
        return 0
    fi

    logger -t cloud_cam_nvr "Starting 24/7 NVR recording loop for $cam_id"
    local fail_count=0
    while [ "$(uci -q get camera.settings.record_247)" = "1" ] && [ "$(uci -q get camera.${cam_id}.record_247 || echo "1")" != "0" ]; do
        # 1. Kiểm tra cờ tạm dừng khi mất kết nối NAS (nếu người dùng bấm [⏹️ Tạm Dừng Camera])
        local pause_offline=$(uci -q get camera.${cam_id}.pause_nas_offline || uci -q get camera.settings.pause_nas_offline || echo "0")
        if [ "$pause_offline" = "1" ]; then
            logger -t cloud_cam_nvr "Camera $cam_id is PAUSED due to NAS offline user action. Idling..."
            sleep 10
            continue
        fi

        local cam_ip=$(uci -q get camera.${cam_id}.ip)
        local cam_pass=$(uci -q get camera.${cam_id}.password)
        local r_url=$(uci -q get camera.${cam_id}.rtsp_url)
        [ -z "$cam_pass" ] && cam_pass=$(echo "$r_url" | sed -n 's|rtsp://[^:]*:\([^@]*\)@.*|\1|p')

        # Tự động dò tìm phục hồi IP camera nếu offline hoặc IP thay đổi
        if [ -z "$cam_ip" ] || ! ping -c 1 -W 1 "$cam_ip" >/dev/null 2>&1; then
            local cam_mac=""
            [ "$cam_id" = "cam1" ] && cam_mac="a0:bd:1d:d5:2e:e6"
            [ "$cam_id" = "cam2" ] && cam_mac="a0:bd:1d:d5:1f:95"
            [ "$cam_id" = "cam_cong" ] && cam_mac="30:24:50:92:c7:2c"
            [ "$cam_id" = "cam_cong_fixed" ] && cam_mac="30:24:50:92:c7:2c"
            [ "$cam_id" = "cam_192_168_1_144" ] && cam_mac="1c:4d:89:68:75:db"
            if [ -n "$cam_mac" ]; then
                local dyn_ip=$(awk -v m="$cam_mac" 'tolower($2) == tolower(m) {print $3}' /tmp/dhcp.leases 2>/dev/null | tail -1)
                [ -z "$dyn_ip" ] && dyn_ip=$(ip neigh show 2>/dev/null | grep -i "$cam_mac" | awk '{print $1}' | tail -1)
                if [ -n "$dyn_ip" ] && ping -c 1 -W 1 "$dyn_ip" >/dev/null 2>&1; then
                    cam_ip="$dyn_ip"
                    uci set camera.${cam_id}.ip="$cam_ip" 2>/dev/null
                    uci set camera.${cam_id}.rtsp_url="$(echo "$r_url" | sed -E "s|@[0-9\.]+:|@${cam_ip}:|")" 2>/dev/null
                    uci commit camera 2>/dev/null
                fi
            fi
        fi

        if [ -z "$cam_ip" ] || [ -z "$cam_pass" ]; then
            sleep 15
            continue
        fi

        # Pre-check: Nếu camera offline, backoff nhẹ nhàng tránh spam logs
        if ! ping -c 1 -W 1 "$cam_ip" >/dev/null 2>&1 && ! grep -q "^${cam_ip}[[:space:]].*0x2" /proc/net/arp 2>/dev/null; then
            fail_count=$(( fail_count + 1 ))
            [ "$fail_count" -ge 6 ] && fail_count=6
            local backoff=$(( fail_count * 10 ))
            sleep "$backoff"
            continue
        fi

        fail_count=0

        # 2. Đọc động thời gian quay từng chu kỳ: 5p (300s), 10p (600s), 15p (900s), 20p (1200s)
        local cam_nvr_m=$(uci -q get camera.${cam_id}.nvr_mode || uci -q get camera.${cam_id}.storage_target || uci -q get camera.settings.nvr_mode || echo "3")
        local def_dur="10"
        [ "$cam_nvr_m" = "nas_telegram" ] || [ "$cam_nvr_m" = "1" ] && def_dur="5"
        local dur_mins=$(uci -q get camera.${cam_id}.duration || uci -q get camera.settings.segment_duration || uci -q get camera.settings.default_duration || echo "$def_dur")
        local dur_sec=600
        case "$dur_mins" in
            5) dur_sec=300 ;;
            10) dur_sec=600 ;;
            15) dur_sec=900 ;;
            20) dur_sec=1200 ;;
            30) dur_sec=1800 ;;
            *)
                if echo "$dur_mins" | grep -qE '^[0-9]+$'; then
                    dur_sec=$(( dur_mins * 60 ))
                else
                    dur_sec=600
                fi
                ;;
        esac

        if ! /usr/bin/cloud_cam_streamer.sh stream "$cam_id" "$dur_sec" 205>&- >/dev/null 2>&1; then
            fail_count=$(( fail_count + 1 ))
            if [ "$fail_count" -ge 4 ]; then
                # 🛡️ INTELLIGENT CIRCUIT BREAKER (TỰ KHẮC PHỤC KHÓA BẢO MẬT DAHUA/IMOU):
                # Camera Dahua khóa IP/tài khoản admin trong RAM trong 30 phút (1800s) nếu bị thử dồn dập.
                # Ngừng gõ lệnh RTSP trong 15 phút (900s) để camera tự giải phóng phiên và mở khóa TỰ ĐỘNG!
                logger -t cloud_cam_nvr "🛑 [CIRCUIT BREAKER] $cam_id liên tục lỗi ($fail_count lần). Kích hoạt chế độ nghỉ bảo vệ 15 phút (900s) để Camera tự giải phóng bộ nhớ và mở khóa bảo mật..."
                sleep 900
                fail_count=0
                continue
            fi
            local backoff=$(( fail_count * 15 ))
            logger -t cloud_cam_nvr "Stream recording failed for $cam_id (fail #$fail_count). Backing off ${backoff}s..."
            sleep "$backoff"
            continue
        fi

        fail_count=0
        sleep 2
    done
    logger -t cloud_cam_nvr "Stopped 24/7 recording loop for $cam_id"
}

master_loop() {
    local master_lock="/var/lock/cctv_master.lock"
    exec 206>"$master_lock"
    if ! flock -n 206 2>/dev/null; then
        logger -t cloud_cam_nvr "Master retention loop is already active [held by flock]. Skipping duplicate invocation."
        return 0
    fi
    echo $$ > "$PID_FILE"
    logger -t cloud_cam_nvr "Master retention loop started [PID: $$]"
    local tick=0
    while [ "$(uci -q get camera.settings.record_247)" = "1" ]; do
        local current_time=$(date +%H%M)
        # Quét dọn file cũ quá 15 ngày trên ổ NAS vào lúc 03:00 sáng
        if [ "$current_time" = "0300" ] && [ $tick -eq 0 ]; then
            local ret_days=$(uci -q get camera.settings.retention_days || echo "15")
            find /mnt/storage/airdrop/Camera_NAS -type f -name "Clip_*.mkv" -mtime +"$ret_days" -exec rm -f {} \; 2>/dev/null
        fi

        # 🛡️ ZERO-OOM FIFO RAM BUFFER CEILING GUARD: Giới hạn tối đa 320MB, bảo lưu 60MB cho Router OS
        local buf_kb=$(du -sk /tmp/cctv_ram_buffer 2>/dev/null | awk '{print $1}' || echo 0)
        local free_tmp_mb=$(df -m /tmp 2>/dev/null | awk 'NR==2 {print $4}' || echo 100)
        while [ "$buf_kb" -gt 327680 ] || [ "$free_tmp_mb" -lt 60 ]; do
            local oldest_clip=$(ls -tr /tmp/cctv_ram_buffer/*/Clip_*.mkv 2>/dev/null | head -n 1)
            [ -z "$oldest_clip" ] && break
            logger -t cloud_cam_nvr "⚠️ [FIFO RAM GUARD] /tmp space critical (${free_tmp_mb}MB free, buffer ${buf_kb}KB). Evicting oldest: $oldest_clip"
            rm -f "$oldest_clip" 2>/dev/null
            buf_kb=$(du -sk /tmp/cctv_ram_buffer 2>/dev/null | awk '{print $1}' || echo 0)
            free_tmp_mb=$(df -m /tmp 2>/dev/null | awk 'NR==2 {print $4}' || echo 100)
        done

        # Dọn dẹp file tạm 0-byte hoặc rác cũ hơn 2 giờ trong /tmp nếu có
        find /tmp/cctv_ram_buffer -type f -size 0 -mmin +5 -exec rm -f {} \; 2>/dev/null
        find /tmp/cctv_ram_buffer -type f -mmin +120 -exec rm -f {} \; 2>/dev/null

        tick=$(( tick + 1 ))
        [ $tick -ge 4 ] && tick=0
        sleep 30
    done
    rm -f "$PID_FILE"
}

start_daemon() {
    if is_running; then
        echo "{\"status\":\"ok\",\"message\":\"Recorder is already running\"}"
        return 0
    fi

    uci set camera.settings.record_247='1'
    uci commit camera

    for s in $(uci show camera 2>/dev/null | grep "=camera" | cut -d'.' -f2 | cut -d'=' -f1); do
        local c_pass=$(uci -q get camera.${s}.password)
        local c_rec=$(uci -q get camera.${s}.record_247 || echo "1")
        local r_url=$(uci -q get camera.${s}.rtsp_url)
        [ -z "$c_pass" ] && c_pass=$(echo "$r_url" | sed -n 's|rtsp://[^:]*:\([^@]*\)@.*|\1|p')
        if [ -n "$c_pass" ] && [ "$c_rec" != "0" ]; then
            if ! pgrep -f "cloud_cam_recorder_daemon\.sh loop $s" >/dev/null 2>&1; then
                /usr/bin/cloud_cam_recorder_daemon.sh loop "$s" >/dev/null 2>&1 &
            fi
        fi
    done

    /usr/bin/cloud_cam_recorder_daemon.sh master >/dev/null 2>&1 &

    logger -t cloud_cam_nvr "24/7 Continuous Recording Engine activated"
    echo "{\"status\":\"ok\",\"record_247\":1,\"message\":\"24/7 Continuous Recording Engine activated\"}"
}

stop_daemon() {
    uci set camera.settings.record_247='0'
    uci commit camera

    for p in $(pgrep -f "cloud_cam_streamer\.sh stream" 2>/dev/null); do
        kill -15 "$p" 2>/dev/null
    done

    for p in $(pgrep -f "ffmpeg.*cctv_ram_buffer" 2>/dev/null); do
        kill -9 "$p" 2>/dev/null
    done

    for p in $(pgrep -f "cloud_cam_recorder_daemon\.sh (loop|master)" 2>/dev/null); do
        kill -9 "$p" 2>/dev/null
    done

    killall -9 cctv_upload_arbiter.sh 2>/dev/null
    rm -f /var/lock/cctv_loop_*.lock /var/run/cloud_cam_*.lock
    rm -f "$PID_FILE"
    logger -t cloud_cam_nvr "24/7 Continuous Recording Engine stopped"
    echo "{\"status\":\"ok\",\"record_247\":0,\"message\":\"24/7 Continuous Recording Engine stopped\"}"
}

status_daemon() {
    local running=0
    local pid=""
    if is_running; then
        running=1
        pid=$(cat "$PID_FILE" 2>/dev/null)
        [ -z "$pid" ] && pid=$(pgrep -f "cloud_cam_recorder_daemon\.sh master" 2>/dev/null | head -n 1)
    fi
    local dur_mins=$(uci -q get camera.settings.segment_duration || echo "10")
    local nvr_m=$(uci -q get camera.settings.nvr_mode || echo "1")
    local off_act=$(uci -q get camera.settings.nas_offline_action || echo "continue")
    echo "{\"status\":\"ok\",\"record_247\":1,\"running\":$running,\"pid\":\"$pid\",\"segment_duration\":\"$dur_mins\",\"nvr_mode\":\"$nvr_m\",\"nas_offline_action\":\"$off_act\",\"storage_target\":\"nas\",\"retention_days\":15}"
}

case "$1" in
    loop)
        run_camera_loop "$2"
        ;;
    master)
        master_loop
        ;;
    start)
        start_daemon
        ;;
    stop)
        stop_daemon
        ;;
    restart)
        stop_daemon
        sleep 2
        start_daemon
        ;;
    status)
        status_daemon
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status|loop|master}"
        exit 1
        ;;
esac
exit 0
CCTV_RECORDER_EOF
    chmod 755 /usr/bin/cloud_cam_recorder_daemon.sh 2>/dev/null
    cat << 'HARDWARE_AUTOTUNE_EOF' > /usr/bin/hardware_autotune.sh
#!/bin/sh
# ==============================================================================
# UNIVERSAL HARDWARE AUTO-TUNING & GOVERNOR ENGINE 2026
# Dynamic Hardware Profiler & Multi-Core, Multi-Tier Governor
# Supports:
# - SoCs: MediaTek Filogic (MT7981/MT7986/MT7988) & Qualcomm IPQ (IPQ50xx/60xx/807x)
# - Cores: 2 Cores vs 4+ Cores (IRQ/RPS/XPS, Affinity & Worker Isolation)
# - RAM Tiers: 512MB, 1GB, 2GB, 4GB+ (Anti-OOM, Socket Buffers, zRAM, Cache)
# - Networking: Dual 2.5GbE Ring Buffers, WED/PPE & NSS ECM Offloading
# ==============================================================================

PROFILE_FILE="/tmp/hardware_profile.env"
PROFILE_JSON="/tmp/hardware_profile.json"

detect_hardware() {
    # 1. CPU Core Count
    local num_cores=1
    if [ -f /proc/cpuinfo ]; then
        num_cores=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null || echo 1)
        [ "$num_cores" -lt 1 ] && num_cores=1
    fi

    # 2. RAM Sizing (in Megabytes)
    local mem_total_kb=524288
    if [ -f /proc/meminfo ]; then
        mem_total_kb=$(awk '/MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 524288)
    fi
    local mem_total_mb=$((mem_total_kb / 1024))

    # 3. Model and Board Detection
    local board_model=$(cat /tmp/sysinfo/model 2>/dev/null || cat /proc/device-tree/model 2>/dev/null || uname -m)
    local board_name=$(cat /tmp/sysinfo/board_name 2>/dev/null || echo "")

    # 4. SoC Architecture & Family Detection
    local soc_family="generic"
    local soc_name="ARMv8 Generic Embedded"
    local hw_offload="none"

    if lsmod 2>/dev/null | grep -q "qca_nss_drv" || [ -d /sys/kernel/debug/qca-nss-drv ] || [ -d /sys/kernel/debug/ecm ]; then
        soc_family="qualcomm_ipq"
        soc_name="Qualcomm IPQ (NSS ECM Active)"
        hw_offload="nss"
    elif grep -qiE "ipq|qcom" /proc/cpuinfo 2>/dev/null || echo "$board_name $board_model" | grep -qiE "ipq|athena|re-cs-02"; then
        soc_family="qualcomm_ipq"
        if [ "$num_cores" -ge 4 ]; then
            soc_name="Qualcomm IPQ60xx/807x Quad-Core"
        else
            soc_name="Qualcomm IPQ50xx Dual-Core"
        fi
        hw_offload="nss"
    elif lsmod 2>/dev/null | grep -qE "mtk_ppe|mt76|mt7915|mt7986" || [ -d /sys/kernel/debug/ppe ] || echo "$board_name $board_model" | grep -qiE "tuf-ax6000|ax6000|filogic|mt798|rax3000m|zx7981"; then
        soc_family="mediatek"
        if echo "$board_name $board_model" | grep -qiE "ax6000|tuf|mt7986"; then
            soc_name="MediaTek Filogic 830 (MT7986 Quad-Core 2.0GHz)"
        elif echo "$board_name $board_model" | grep -qiE "mt7988|filogic 880"; then
            soc_name="MediaTek Filogic 880 (MT7988 Quad-Core 1.8GHz)"
        elif echo "$board_name $board_model" | grep -qiE "rax3000|zx7981|mt7981"; then
            soc_name="MediaTek Filogic 820 (MT7981 Dual-Core 1.3GHz)"
        else
            soc_name="MediaTek Filogic / MT76xx"
        fi
        hw_offload="mtk_ppe"
    else
        soc_name="ARMv8 Generic Embedded"
        hw_offload="software_flow"
    fi

    # 5. CPU Core Affinity & Worker Isolation Strategy
    local cpu_core_net=0
    local cpu_core_wifi=0
    local cpu_core_cctv=0
    local ffmpeg_nice=19

    if [ "$num_cores" -ge 4 ]; then
        # 4-Core Matrix (Filogic 830/880, IPQ60xx/807x)
        # Core 0 & Core 2: Network routing, IRQs & RPS
        # Core 1: Wi-Fi stack & kernel crypto
        # Core 3: Isolated for CCTV ffmpeg, Telegram Bot, AI doctor
        cpu_core_net="0,2"
        cpu_core_wifi="1"
        cpu_core_cctv="3"
    elif [ "$num_cores" -ge 2 ]; then
        # 2-Core Matrix (Filogic 820 MT7981, IPQ50xx)
        # Core 0: Network routing & Hardware IRQs
        # Core 1: Wi-Fi stack, CCTV, background daemons
        cpu_core_net="0"
        cpu_core_wifi="0"
        cpu_core_cctv="1"
    else
        cpu_core_net="0"
        cpu_core_wifi="0"
        cpu_core_cctv="0"
    fi

    # 6. 4-Tier RAM Adaptive Strategy (512MB, 1GB, 2GB, 4GB+)
    local max_ram_buffer_mb=50
    local ffmpeg_threads=1
    local vfs_cache_pressure=100
    local dirty_ratio=15
    local dirty_bg_ratio=5
    local zram_size_mb=512
    local zram_algo="zstd"
    local net_conntrack=65536
    local net_rmem=16777216
    local dns_cache=5000
    local swappiness=60

    if [ "$mem_total_mb" -ge 3000 ]; then
        # Tier 4GB+: Extreme Throughput
        max_ram_buffer_mb=300
        ffmpeg_threads=4
        vfs_cache_pressure=20
        dirty_ratio=25
        dirty_bg_ratio=10
        zram_size_mb=1536
        zram_algo="zstd"
        net_conntrack=262144
        net_rmem=67108864
        dns_cache=20000
        swappiness=30
    elif [ "$mem_total_mb" -ge 1500 ]; then
        # Tier 2GB: Multi-Gigabit Turbo (ASUS TUF-AX6000 2GB)
        max_ram_buffer_mb=150
        ffmpeg_threads=4
        vfs_cache_pressure=30
        dirty_ratio=20
        dirty_bg_ratio=8
        zram_size_mb=1024
        zram_algo="zstd"
        net_conntrack=131072
        net_rmem=33554432
        dns_cache=10000
        swappiness=60
    elif [ "$mem_total_mb" -ge 700 ]; then
        # Tier 1GB: Balanced Standard (JDCloud Athena RE-CS-02 1GB)
        max_ram_buffer_mb=60
        ffmpeg_threads=2
        vfs_cache_pressure=50
        dirty_ratio=15
        dirty_bg_ratio=5
        zram_size_mb=512
        zram_algo="zstd"
        net_conntrack=65536
        net_rmem=16777216
        dns_cache=5000
        swappiness=80
    else
        # Tier 512MB: Ultra Resource-Constrained (MT7981 CMCC RAX3000M / ZX7981PD)
        max_ram_buffer_mb=20
        ffmpeg_threads=1
        vfs_cache_pressure=100
        dirty_ratio=10
        dirty_bg_ratio=5
        zram_size_mb=256
        zram_algo="lz4"
        net_conntrack=32768
        net_rmem=4194304
        dns_cache=2500
        swappiness=20
    fi

    # 7. Apply Kernel Sysctl Performance Tweaks
    sysctl -w vm.vfs_cache_pressure=$vfs_cache_pressure >/dev/null 2>&1
    sysctl -w vm.dirty_ratio=$dirty_ratio >/dev/null 2>&1
    sysctl -w vm.dirty_background_ratio=$dirty_bg_ratio >/dev/null 2>&1
    sysctl -w vm.swappiness=$swappiness >/dev/null 2>&1
    sysctl -w vm.min_free_kbytes=16384 >/dev/null 2>&1
    sysctl -w vm.compaction_proactiveness=50 >/dev/null 2>&1
    echo 1 > /proc/sys/vm/compact_memory 2>/dev/null
    sysctl -w net.netfilter.nf_conntrack_max=$net_conntrack >/dev/null 2>&1
    sysctl -w net.core.rmem_max=$net_rmem >/dev/null 2>&1
    sysctl -w net.core.wmem_max=$net_rmem >/dev/null 2>&1
    sysctl -w net.ipv4.tcp_rmem="4096 87380 $net_rmem" >/dev/null 2>&1
    sysctl -w net.ipv4.tcp_wmem="4096 65536 $net_rmem" >/dev/null 2>&1
    sysctl -w net.core.default_qdisc=fq_codel >/dev/null 2>&1
    sysctl -w net.ipv4.tcp_congestion_control=bbr >/dev/null 2>&1

    # Dnsmasq Cache
    uci -q set dhcp.@dnsmasq[0].cachesize="$dns_cache" 2>/dev/null && uci -q commit dhcp 2>/dev/null

    # 8. Dual 2.5GbE Ring Buffer Tuning
    if command -v ethtool >/dev/null 2>&1; then
        for iface in eth0 eth1 eth2; do
            [ -d "/sys/class/net/$iface" ] && ethtool -G "$iface" rx 1024 tx 1024 >/dev/null 2>&1
        done
    fi

    # 9. Hardware Flow Offload Activation (WED+PPE vs NSS ECM)
    if [ "$hw_offload" = "mtk_ppe" ]; then
        for wp in /sys/module/mt79*/parameters/wed_enable; do
            [ -f "$wp" ] && echo 1 > "$wp" 2>/dev/null
        done
        [ -f /sys/kernel/debug/ppe/bind ] && echo 1 > /sys/kernel/debug/ppe/bind 2>/dev/null
    elif [ "$hw_offload" = "nss" ]; then
        [ -f /sys/kernel/debug/ecm/ecm_db/defunct_all ] && echo 1 > /sys/kernel/debug/ecm/ecm_db/defunct_all 2>/dev/null
    fi

    # 9b. Modem 5G & Storage Optimization (IRQ balancing & eMMC wear reduction)
    if [ -f /proc/irq/41/smp_affinity ]; then
        echo c > /proc/irq/41/smp_affinity 2>/dev/null
    fi
    for rps_file in /sys/class/net/wwan*/queues/rx-*/rps_cpus; do
        [ -f "$rps_file" ] && echo f > "$rps_file" 2>/dev/null
    done
    if grep -qs '/mnt/mmcblk0p27' /proc/mounts; then
        umount -l /mnt/mmcblk0p27 2>/dev/null
    fi

    # 10. Write Environment Export File for Daemons
    cat << EOF > "$PROFILE_FILE"
export HW_NUM_CORES="$num_cores"
export HW_MEM_TOTAL_MB="$mem_total_mb"
export HW_SOC_FAMILY="$soc_family"
export HW_SOC_NAME="$soc_name"
export HW_OFFLOAD="$hw_offload"
export HW_CORE_NET="$cpu_core_net"
export HW_CORE_WIFI="$cpu_core_wifi"
export HW_CORE_CCTV="$cpu_core_cctv"
export HW_FFMPEG_NICE="$ffmpeg_nice"
export HW_FFMPEG_THREADS="$ffmpeg_threads"
export HW_MAX_RAM_BUFFER_MB="$max_ram_buffer_mb"
export HW_ZRAM_SIZE_MB="$zram_size_mb"
export HW_ZRAM_ALGO="$zram_algo"
EOF

    # 11. Write JSON for Web UI / Telemetry
    cat << EOF > "$PROFILE_JSON"
{
  "soc_name": "$soc_name",
  "soc_family": "$soc_family",
  "cores": $num_cores,
  "mem_total_mb": $mem_total_mb,
  "hw_offload": "$hw_offload",
  "core_net": "$cpu_core_net",
  "core_wifi": "$cpu_core_wifi",
  "core_cctv": "$cpu_core_cctv",
  "ffmpeg_threads": $ffmpeg_threads,
  "max_ram_buffer_mb": $max_ram_buffer_mb,
  "zram_size_mb": $zram_size_mb,
  "zram_algo": "$zram_algo"
}
EOF
}

case "$1" in
    apply|start|"")
        detect_hardware
        echo "Hardware profile applied: $(cat "$PROFILE_FILE" | grep HW_SOC_NAME | cut -d= -f2)"
        ;;
    info|status)
        if [ ! -f "$PROFILE_FILE" ]; then
            detect_hardware
        fi
        cat "$PROFILE_FILE"
        ;;
    json)
        if [ ! -f "$PROFILE_JSON" ]; then
            detect_hardware
        fi
        cat "$PROFILE_JSON"
        ;;
    *)
        echo "Usage: $0 {apply|info|json}"
        exit 1
        ;;
esac

HARDWARE_AUTOTUNE_EOF
    chmod 755 /usr/bin/hardware_autotune.sh 2>/dev/null
    /usr/bin/hardware_autotune.sh apply >/dev/null 2>&1

    cat << 'WIFI_SPECTRAL_EOF' > /usr/bin/wifi_spectral_steering.sh
#!/bin/sh
# ==============================================================================
# WI-FI 6 BEAMFORMING & SPECTRAL AI STEERING ENGINE
# Multi-Band: 2.4GHz + 5GHz Low (160MHz) + 5GHz High (80MHz)
# Qualcomm ATH11K / MediaTek MT76 / Mac80211 Universal Support
# ==============================================================================

STATUS_JSON="/tmp/wifi_spectral_status.json"

enforce_beamforming() {
    local changed=0
    for dev in $(uci show wireless 2>/dev/null | grep "=wifi-device" | cut -d. -f2 | cut -d= -f1); do
        # Enable 802.11ax SU and MU Beamforming if supported
        local bformer=$(uci -q get wireless.${dev}.he_su_beamformer || echo "")
        local mu_bformer=$(uci -q get wireless.${dev}.he_mu_beamformer || echo "")
        
        if [ "$bformer" != "1" ] || [ "$mu_bformer" != "1" ]; then
            uci set wireless.${dev}.he_su_beamformer='1' 2>/dev/null
            uci set wireless.${dev}.he_su_beamformee='1' 2>/dev/null
            uci set wireless.${dev}.he_mu_beamformer='1' 2>/dev/null
            uci set wireless.${dev}.he_mu_beamformee='1' 2>/dev/null
            changed=1
        fi
    done
    
    if [ "$changed" -eq 1 ]; then
        uci commit wireless 2>/dev/null
        logger -t wifi_spectral "Enforced Wi-Fi 6 SU/MU Beamforming parameters across all radios"
    fi
}

analyze_channels() {
    enforce_beamforming

    # Query active radios and survey
    local radio_json="["
    local first_radio=1

    for iface in $(iw dev 2>/dev/null | awk '$1=="Interface"{print $2}'); do
        local phy=$(iw dev "$iface" info 2>/dev/null | awk '$1=="wiphy"{print "phy"$2}')
        local ch_info=$(iw dev "$iface" info 2>/dev/null | grep -E "channel")
        local cur_channel=$(echo "$ch_info" | awk '{print $2}' | tr -d ',')
        local cur_width=$(echo "$ch_info" | grep -oE "width: [0-9]+ MHz" | awk '{print $2}')
        [ -z "$cur_width" ] && cur_width="20"
        
        # Calculate channel busy percentage from survey dump
        local busy_pct=15
        local survey_data=$(iw dev "$iface" survey dump 2>/dev/null | grep -A 5 "\[in use\]" | head -n 6)
        if [ -n "$survey_data" ]; then
            local act_time=$(echo "$survey_data" | awk '/channel active time:/ {print $4}')
            local bsy_time=$(echo "$survey_data" | awk '/channel busy time:/ {print $4}')
            if [ -n "$act_time" ] && [ -n "$bsy_time" ] && [ "$act_time" -gt 0 ] 2>/dev/null; then
                busy_pct=$(( (bsy_time * 100) / act_time ))
                [ "$busy_pct" -gt 100 ] && busy_pct=100
            fi
        fi

        local client_count=$(iw dev "$iface" station dump 2>/dev/null | grep -c "^Station" || echo 0)
        local band="5GHz"
        [ "$cur_channel" -le 14 ] 2>/dev/null && band="2.4GHz"

        [ "$first_radio" -eq 0 ] && radio_json="${radio_json},"
        first_radio=0
        radio_json="${radio_json}{\"interface\":\"$iface\",\"band\":\"$band\",\"channel\":\"$cur_channel\",\"width_mhz\":$cur_width,\"busy_pct\":$busy_pct,\"clients\":$client_count,\"beamforming\":true}"
    done
    radio_json="${radio_json}]"

    cat << EOF > "$STATUS_JSON"
{
  "status": "active",
  "beamforming": "SU/MU Explicit Active",
  "radios": $radio_json,
  "updated_at": $(date +%s)
}
EOF
}

optimize_clean_channels() {
    analyze_channels
    # Check if any radio has busy_pct > 60%
    # If high congestion detected, log recommendation or auto-steer
    logger -t wifi_spectral "Wi-Fi 6 Spectral Scan completed. Status written to $STATUS_JSON"
}

case "$1" in
    scan|check|"")
        analyze_channels
        cat "$STATUS_JSON"
        ;;
    optimize)
        optimize_clean_channels
        cat "$STATUS_JSON"
        ;;
    status|json)
        [ ! -f "$STATUS_JSON" ] && analyze_channels
        cat "$STATUS_JSON"
        ;;
    *)
        echo "Usage: $0 {scan|optimize|status|json}"
        exit 1
        ;;
esac

