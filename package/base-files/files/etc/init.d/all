        print("Content-Type: application/json\r\n\r\n" .. string.format('{"ok":true,"id":"%s","message":"âœ… ÄÃ£ lÆ°u cáº¥u hÃ¬nh tÃ i khoáº£n %s [%s] vá»›i máº­t kháº©u báº£o máº­t!"}', cid, c_service:upper(), c_email))
