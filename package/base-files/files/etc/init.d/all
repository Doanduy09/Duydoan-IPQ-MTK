            lteSinr = (rfSignal.lte && rfSignal.lte.sinr) ? rfSignal.lte.sinr : '--';
            rfBadgeBg = rfScore >= 90 ? '#ecfdf5' : (rfScore >= 70 ? '#fefce8' : '#fef2f2');
            rfBadgeBorder = rfScore >= 90 ? '#a7f3d0' : (rfScore >= 70 ? '#fef08a' : '#fecaca');
            rfBadgeColor = rfScore >= 90 ? '#047857' : (rfScore >= 70 ? '#854d0e' : '#b91c1c');
            rfAdviceBg = '#f0fdf4';
