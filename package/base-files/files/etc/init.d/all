if [ -z "$rule_cnt" ] || [ "$rule_cnt" = "0" ]; then
    if [ -f /tmp/dnsmasq.d/adblock.conf ]; then
        rule_cnt=$(grep -c '^address=/' /tmp/dnsmasq.d/adblock.conf 2>/dev/null)
    elif [ -f /tmp/hosts/adblock ]; then
        rule_cnt=$(grep -c '0.0.0.0' /tmp/hosts/adblock 2>/dev/null)
    fi
fi
[ -z "$rule_cnt" ] && rule_cnt=40000
dev_cnt=$(cat /tmp/dhcp.leases 2>/dev/null | wc -l || echo 0)

