    cat << 'NAS_PHONE_AUTO_SETUP_EOF' > /usr/bin/nas_phone_auto_setup.sh
#!/bin/sh
# /usr/bin/nas_phone_auto_setup.sh - Auto Setup & Activate Phone NAS from Router
TARGET_IP="$1"
[ -z "$TARGET_IP" ] && TARGET_IP=$(uci -q get nas_phone.settings.phone_ip)
[ -z "$TARGET_IP" ] && TARGET_IP="192.168.1.134"

# Attempt ADB TCP connection if IP provided
if [ -n "$TARGET_IP" ]; then
    adb connect "${TARGET_IP}:5555" >/dev/null 2>&1
    sleep 1
fi

TARGET_DEV=""
# 1. Check if TARGET_IP:5555 is connected and valid
if [ -n "$TARGET_IP" ] && adb devices | grep -q "${TARGET_IP}:5555[[:space:]]*device"; then
    IS_VALID=$(adb -s "${TARGET_IP}:5555" shell getprop ro.build.version.release 2>/dev/null | grep -E '^[0-9]+')
    if [ -n "$IS_VALID" ]; then
        TARGET_DEV="${TARGET_IP}:5555"
    fi
fi

# 2. If not found, scan all attached devices, excluding cellular modems (Sierra f207f28e, Quectel 6ae59394)
if [ -z "$TARGET_DEV" ]; then
    for dev in $(adb devices | grep -v "List of" | grep "device" | awk '{print $1}'); do
        if [ "$dev" != "f207f28e" ] && [ "$dev" != "6ae59394" ]; then
            IS_ANDROID=$(adb -s "$dev" shell getprop ro.build.version.release 2>/dev/null | grep -E '^[0-9]+')
            if [ -n "$IS_ANDROID" ]; then
                TARGET_DEV="$dev"
                break
            fi
        fi
    done
fi

if [ -z "$TARGET_DEV" ]; then
    echo "ERROR: Không tìm thấy điện thoại Android qua ADB (${TARGET_IP}:5555 hoặc USB). Vui lòng cắm cáp vào máy tính chạy Kich_Hoat_Phone_NAS_1Click.bat hoặc bật Gỡ lỗi qua Wi-Fi trên điện thoại!"
    exit 1
fi

# Retrieve Phone metadata
PHONE_MODEL=$(adb -s "$TARGET_DEV" shell getprop ro.product.model 2>/dev/null | tr -d '\r\n')
PHONE_BRAND=$(adb -s "$TARGET_DEV" shell getprop ro.product.brand 2>/dev/null | tr -d '\r\n')
ANDROID_VER=$(adb -s "$TARGET_DEV" shell getprop ro.build.version.release 2>/dev/null | tr -d '\r\n')

[ -z "$PHONE_MODEL" ] && PHONE_MODEL="Android_Phone"
PHONE_DISPLAY_NAME="$PHONE_MODEL"
[ -n "$PHONE_BRAND" ] && PHONE_DISPLAY_NAME="$PHONE_BRAND $PHONE_MODEL"

# Determine target IP for UCI registration
DEV_IP="$TARGET_IP"
if echo "$TARGET_DEV" | grep -q ":"; then
    DEV_IP=$(echo "$TARGET_DEV" | cut -d: -f1)
elif [ -z "$DEV_IP" ]; then
    DEV_IP=$(adb -s "$TARGET_DEV" shell ip -f inet addr show wlan0 2>/dev/null | grep -o 'inet [0-9.]*' | awk '{print $2}')
fi
[ -z "$DEV_IP" ] && DEV_IP="192.168.1.134"

# Auto-register phone in UCI config
CLEAN_IP=$(echo "$DEV_IP" | tr '.' '_')
NODE_ID="phone_${CLEAN_IP}"
uci -q delete nas_phone.$NODE_ID
uci set nas_phone.$NODE_ID=phone_node
uci set nas_phone.$NODE_ID.name="$PHONE_DISPLAY_NAME"
uci set nas_phone.$NODE_ID.ip="$DEV_IP"
uci set nas_phone.$NODE_ID.port="8080"
uci set nas_phone.$NODE_ID.router_port="8080"
uci set nas_phone.$NODE_ID.proto="webdav"
uci set nas_phone.$NODE_ID.folder="DATA NASS"
uci set nas_phone.$NODE_ID.user="admin"
uci set nas_phone.settings.phone_ip="$DEV_IP"
uci commit nas_phone

# Create local mount/mirror directory
FOLDER_SLUG="Phone_$(echo "$PHONE_DISPLAY_NAME" | sed 's/[^a-zA-Z0-9_-]/_/g')"
mkdir -p "/mnt/storage/airdrop/$FOLDER_SLUG"
mkdir -p "/overlay/airdrop/$FOLDER_SLUG"

# Prepare payload script on phone
cat << 'EONAS_PAYLOAD' > /tmp/athena_nas_payload.sh
#!/system/bin/sh
settings put global wifi_sleep_policy 2
settings put global stay_on_while_plugged_in 7
dumpsys deviceidle whitelist +com.termux 2>/dev/null
setprop service.adb.tcp.port 5555
stop adbd
start adbd

mkdir -p "/sdcard/DATA NASS/Documents" "/sdcard/DATA NASS/Photos" "/sdcard/DATA NASS/Movies" 2>/dev/null
mkdir -p "/sdcard/Athena_NAS/Documents" "/sdcard/Athena_NAS/Photos" "/sdcard/Athena_NAS/Movies" 2>/dev/null

if [ -d /data/data/com.termux/files/usr/bin ]; then
    export PREFIX=/data/data/com.termux/files/usr
    export PATH=$PREFIX/bin:/system/bin:$PATH
    pkill -f "rclone serve webdav" 2>/dev/null
    nohup $PREFIX/bin/rclone serve webdav "/sdcard/DATA NASS" --addr 0.0.0.0:8080 --dir-cache-time 1m --vfs-cache-mode writes > /sdcard/rclone_webdav.log 2>&1 &
fi
EONAS_PAYLOAD

adb -s "$TARGET_DEV" push /tmp/athena_nas_payload.sh /data/local/tmp/athena_nas.sh >/dev/null 2>&1
adb -s "$TARGET_DEV" shell "sh /data/local/tmp/athena_nas.sh" >/dev/null 2>&1

