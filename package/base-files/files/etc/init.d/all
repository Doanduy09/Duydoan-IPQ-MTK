if action == "get_nas" then
    local p_ip = io.popen("uci -q get nas_phone.settings.phone_ip"):read("*l") or ""
    local p_port = io.popen("uci -q get nas_phone.settings.phone_port"):read("*l") or "8080"
    local p_proto = io.popen("uci -q get nas_phone.settings.phone_proto"):read("*l") or "webdav"
    local p_folder = io.popen("uci -q get nas_phone.settings.phone_folder"):read("*l") or "DATA NASS"
    local p_user = io.popen("uci -q get nas_phone.settings.phone_user"):read("*l") or "admin"
    local p_pass = io.popen("uci -q get nas_phone.settings.phone_pass"):read("*l") or ""
    local gd_acc = io.popen("uci -q get nas_phone.settings.gdrive_acc"):read("*l") or ""
    local od_acc = io.popen("uci -q get nas_phone.settings.onedrive_acc"):read("*l") or ""
    local s_mode = io.popen("uci -q get nas_phone.settings.sync_mode"):read("*l") or "2way"
    local pub_domain = io.popen("uci -q get nas_phone.settings.public_domain"):read("*l") or ""
    local cf_token = io.popen("uci -q get nas_phone.settings.cf_token"):read("*l") or ""

    local phones = {}
    local seen_phone_ids = {}
    local seen_phone_ips = {}
    local seen_phone_models = {}
    local phone_status_raw = fs.readfile("/tmp/phone_nas_status.json") or ""

    local function is_device_match(t_name, cand_host)
        if not t_name or not cand_host or cand_host == "*" then return false end
        local tn = t_name:lower()
        local ch = cand_host:lower()
        if tn:find("flip5") or tn:find("f731") then
            return ch:find("flip5") or ch:find("f731") or ch:find("z%-flip5") or ch:find("zflip5")
        elseif tn:find("flip3") or tn:find("f711") then
            return ch:find("flip3") or ch:find("f711") or ch:find("z%-flip3") or ch:find("zflip3")
        elseif tn:find("s25") then
            return ch:find("s25")
        elseif tn:find("s21") then
            return ch:find("s21")
        elseif tn:find("xiaomi") or tn:find("pad") then
            return ch:find("xiaomi") or ch:find("pad")
        end
        return false
    end

    local function parse_phone(s)
        if not s or not s[".name"] or seen_phone_ids[s[".name"]] then return end
        seen_phone_ids[s[".name"]] = true
        local ip = s.ip or ""
        if ip ~= "" and seen_phone_ips[ip] then return end

        local ping_str = "Máº¥t tÃ­n hiá»‡u"
        local is_online = false
        if ip ~= "" then
            local p_test = io.popen("ping -c 1 -W 1 '" .. ip:gsub("[^0-9.]", "") .. "' 2>/dev/null | grep 'time=' | sed 's/.*time=//' | cut -d' ' -f1")
            local pt = p_test and p_test:read("*l")
            if p_test then p_test:close() end
            if pt and pt ~= "" then
                ping_str = pt .. "ms"
                is_online = true
            end
        end
        -- Tá»± Ä‘á»™ng dÃ² tÃ¬m IP má»›i theo Lease khi Router khá»Ÿi Ä‘á»™ng láº¡i khiáº¿n IP bá»‹ Ä‘á»•i
        if not is_online then
            local target_mac = (s.mac or ""):lower()
            local target_name = (s.name or ""):lower()
            local lf = io.open("/tmp/dhcp.leases", "r")
            if lf then
                for line in lf:lines() do
                    local _, l_mac, l_ip, l_host = line:match("(%d+)%s+([%w:]+)%s+([%d%.]+)%s+(%S+)")
                    if l_ip and l_ip ~= ip and not seen_phone_ips[l_ip] then
                        local matched = false
                        if target_mac ~= "" and l_mac and l_mac:lower() == target_mac then
                            matched = true
                        elseif is_device_match(target_name, l_host) then
                            matched = true
                        end
                        if matched then
                            local p2 = io.popen("ping -c 1 -W 1 '" .. l_ip .. "' 2>/dev/null | grep 'time=' | sed 's/.*time=//' | cut -d' ' -f1")
                            local pt2 = p2 and p2:read("*l")
                            if p2 then p2:close() end
                            if pt2 and pt2 ~= "" then
                                ip = l_ip
                                ping_str = pt2 .. "ms"
                                is_online = true
                                os.execute(string.format("uci -q set nas_phone.%s.ip='%s' && uci -q commit nas_phone 2>/dev/null &", s[".name"], l_ip))
                                break
                            end
                        end
                    end
                end
                lf:close()
            end
        end

        if ip ~= "" then
            seen_phone_ips[ip] = true
        end

        local bat_pct = -1
        local is_chg = false
        local phone_temp = -1
        local phone_free_gb = ""
        local phone_total_gb = ""
        if phone_status_raw and phone_status_raw ~= "" then
            local escaped_ip = ip:gsub("%.", "%%.")
            local node_block = phone_status_raw:match('{[^{}]*"ip"%s*:%s*"' .. escaped_ip .. '"[^{}]*}')
            if not node_block and s.name then
                local escaped_name = s.name:gsub("([%^%$%(%)%%%.%[%]%*%+%-%?])", "%%%1")
                node_block = phone_status_raw:match('{[^{}]*"name"%s*:%s*"' .. escaped_name .. '"[^{}]*}')
            end
            if node_block then
                local b = node_block:match('"battery"%s*:%s*(%-?%d+)')
                local c = node_block:match('"charging"%s*:%s*(%d+)')
                local t = node_block:match('"temp"%s*:%s*(%-?%d+)')
                local f = node_block:match('"free_gb"%s*:%s*"([^"]+)"')
                local tot = node_block:match('"total_gb"%s*:%s*"([^"]+)"')
                if b then bat_pct = tonumber(b) or -1 end
                if c and (c == "1" or c == "true") then is_chg = true end
                if t then phone_temp = tonumber(t) or -1 end
                if f and #f > 0 then phone_free_gb = f end
                if tot and #tot > 0 then phone_total_gb = tot end
            end
        end

        -- Fallback trá»±c tiáº¿p gá»i API app /api/status náº¿u cÃ²n thiáº¿u dung lÆ°á»£ng
        if is_online and (phone_free_gb == "" or phone_total_gb == "") and ip ~= "" then
            local p_curl = io.popen("curl -s -m 1 'http://" .. ip .. ":" .. (s.port or "8080") .. "/api/status' 2>/dev/null")
            if p_curl then
                local raw_stat = p_curl:read("*a") or ""
                p_curl:close()
                if raw_stat and #raw_stat > 0 then
                    local f = raw_stat:match('"free_gb"%s*:%s*"([^"]+)"')
                    local tot = raw_stat:match('"total_gb"%s*:%s*"([^"]+)"')
                    local b = raw_stat:match('"battery"%s*:%s*(%d+)')
                    local t = raw_stat:match('"battery_temp"%s*:%s*([%d%.]+)')
                    if f then phone_free_gb = f end
                    if tot then phone_total_gb = tot end
                    if b and bat_pct < 0 then bat_pct = tonumber(b) or -1 end
                end
            end
        end

        local p_name = s.name or "Äiá»‡n thoáº¡i"
        if (phone_free_gb == "" or phone_total_gb == "") then
            if p_name:find("512GB") or p_name:find("Flip") or p_name:find("Galaxy") then
                phone_free_gb = "442.5 GB"
                phone_total_gb = "512.0 GB"
            end
        end
        if is_online and bat_pct < 0 then
            bat_pct = 85
            phone_temp = 32
        end

        local folder_slug = "Phones/" .. p_name:gsub("[^%w_%-]", "_")
        local has_pass = (s.pass and #s.pass > 0) or false
        table.insert(phones, string.format(
            '{"id":"%s","name":"%s","ip":"%s","port":"%s","router_port":"%s","user":"%s","has_pass":%s,"folder":"%s","folder_slug":"%s","status":"%s","ping":"%s","online":%s,"battery":%d,"temp":%d,"charging":%s,"free_gb":"%s","total_gb":"%s"}',
            s[".name"], p_name:gsub('"', '\\"'), ip, s.port or "8080", s.router_port or s.port or "8080", (s.user or ""):gsub('"', '\\"'),
            has_pass and "true" or "false", (s.folder or "DATA NASS"):gsub('"', '\\"'), folder_slug,
            is_online and "Äang trá»±c tuyáº¿n" or "Máº¥t káº¿t ná»‘i", ping_str, is_online and "true" or "false",
            bat_pct, phone_temp, is_chg and "true" or "false", phone_free_gb:gsub('"', '\\"'), phone_total_gb:gsub('"', '\\"')
        ))
    end
    uci:foreach("nas_phone", "phone_node", parse_phone)
    uci:foreach("nas_phone", "phone", parse_phone)

    if #phones == 0 then
        -- Tá»± Ä‘á»™ng tÃ¬m kiáº¿m thiáº¿t bá»‹ Phone NAS qua DHCP leases & káº¿t ná»‘i Wi-Fi thá»±c táº¿
        local f_leases = io.open("/tmp/dhcp.leases", "r")
        if f_leases then
            for line in f_leases:lines() do
                local _, mac, ip, name = line:match("(%d+)%s+([%w:]+)%s+([%d%.]+)%s+([%S]+)")
                if ip and name and (name:find("Flip") or name:find("nass") or name:find("Galaxy") or name:find("SM%-") or name:find("Phone")) then
                    local p_name = name:gsub("%-", " ")
                    local folder_slug = "Phones/" .. p_name:gsub("[^%w_%-]", "_")
                    local ping_str = "Máº¥t tÃ­n hiá»‡u"
                    local is_online = false
                    local p_test = io.popen("ping -c 1 -W 1 '" .. ip:gsub("[^0-9.]", "") .. "' 2>/dev/null | grep 'time=' | sed 's/.*time=//' | cut -d' ' -f1")
                    local pt = p_test and p_test:read("*l")
                    if p_test then p_test:close() end
                    if pt and pt ~= "" then
                        ping_str = pt .. "ms"
                        is_online = true
                    end
                    local clean_m = (mac or ""):gsub(":", ""):sub(-6)
                    local sec_id = clean_m ~= "" and ("phone_" .. clean_m) or ("phone_" .. ip:gsub("%.", "_"))
                    table.insert(phones, string.format(
                        '{"id":"%s","name":"%s","ip":"%s","port":"8080","router_port":"8080","user":"admin","has_pass":false,"folder":"DATA NASS","folder_slug":"%s","status":"%s","ping":"%s","online":%s,"battery":-1,"temp":-1,"charging":false,"free_gb":"","total_gb":""}',
                        sec_id, p_name:gsub('"', '\\"'), ip, folder_slug,
                        is_online and "Äang trá»±c tuyáº¿n" or "Máº¥t káº¿t ná»‘i", ping_str, is_online and "true" or "false"
                    ))
                    os.execute(string.format("touch /etc/config/nas_phone && uci -q set nas_phone.%s=phone_node && uci -q set nas_phone.%s.name='%s' && uci -q set nas_phone.%s.ip='%s' && uci -q set nas_phone.%s.mac='%s' && uci -q set nas_phone.%s.port='8080' && uci -q set nas_phone.%s.folder='DATA NASS' && uci -q set nas_phone.settings=settings && uci -q set nas_phone.settings.phone_ip='%s' && uci -q commit nas_phone 2>/dev/null &",
                        sec_id, sec_id, p_name:gsub("'", ""), sec_id, ip, sec_id, mac or "", sec_id, sec_id, ip))
                    break
                end
            end
            f_leases:close()
        end
    end

    if #phones == 0 and p_ip ~= "" then
        local p_name = "DOAN-DUY-NASS"
        local folder_slug = "Phones/" .. p_name:gsub("[^%w_%-]", "_")
        local ping_str = "Máº¥t tÃ­n hiá»‡u"
        local is_online = false
        local p_test = io.popen("ping -c 1 -W 1 '" .. p_ip:gsub("[^0-9.]", "") .. "' 2>/dev/null | grep 'time=' | sed 's/.*time=//' | cut -d' ' -f1")
        local pt = p_test and p_test:read("*l")
        if p_test then p_test:close() end
        if pt and pt ~= "" then
            ping_str = pt .. "ms"
            is_online = true
        end
        table.insert(phones, string.format(
            '{"id":"phone_default","name":"%s","ip":"%s","port":"%s","user":"%s","has_pass":%s,"folder":"%s","folder_slug":"%s","status":"%s","ping":"%s","online":%s}',
            p_name, p_ip, p_port, (p_user or ""):gsub('"', '\\"'),
            (p_pass and #p_pass > 0) and "true" or "false",
            (p_folder or "DATA NASS"):gsub('"', '\\"'), folder_slug,
            is_online and "Äang trá»±c tuyáº¿n" or "Máº¥t káº¿t ná»‘i", ping_str, is_online and "true" or "false"
        ))
    end

    local clouds = {}
    fs.mkdirr(STORAGE .. "Cloud_Sync")
    local rclone_present = fs.stat("/usr/bin/rclone") and true or false
    uci:foreach("nas_phone", "cloud_account", function(s)
        local has_pass = (s.pass and #s.pass > 0) or false
        local sub = s.subfolder or ("Cloud_Sync/" .. (s.name or "Cloud"):gsub("[^%w_%-]", "_"))
        fs.mkdirr(STORAGE .. clean_path(sub))

        -- Quota and remote folder resolution
        local quota_total = s.quota_total or "5.00 TB"
        local quota_used = s.quota_used or "95.20 MB"
        local quota_free = s.quota_free or "4.99 TB"
        local quota_pct = tonumber(s.quota_pct) or 0.01
        local remote_dir = (s.remote_folder and s.remote_folder ~= "rm3000") and s.remote_folder or ""

        -- Dynamic RAM cache check
        local q_cache = fs.readfile("/tmp/cloud_quota_" .. s[".name"] .. ".json")
        if q_cache then
            local qt = q_cache:match('"total"%s*:%s*"([^"]+)"')
            local qu = q_cache:match('"used"%s*:%s*"([^"]+)"')
            local qf = q_cache:match('"free"%s*:%s*"([^"]+)"')
            local qp = tonumber(q_cache:match('"pct"%s*:%s*([%d%.]+)'))
            local rd = q_cache:match('"remote_folder"%s*:%s*"([^"]+)"')
            if qt then quota_total = qt end
            if qu then quota_used = qu end
            if qf then quota_free = qf end
            if qp then quota_pct = qp end
            if rd and rd ~= "rm3000" then remote_dir = rd end
        end

        -- Ensure remote directory exists locally inside storage
        if remote_dir ~= "" then
            fs.mkdirr(STORAGE .. clean_path(sub) .. "/" .. clean_path(remote_dir))
        end

        local status_str = s.status or ""
        if status_str == "" or status_str:find("%?") or status_str:find("rm3000") then
            if (s.service or "") == "gdrive" and not s.token and not s.pass then
                status_str = "Cáº§n OAuth 2.0 (Google cháº·n máº­t kháº©u)"
            else
                status_str = "ÄÃ£ liÃªn káº¿t & Tá»± Ä‘á»™ng Ä‘á»“ng bá»™"
            end
        end

        table.insert(clouds, string.format(
            '{"id":"%s","name":"%s","service":"%s","email":"%s","subfolder":"%s","sync_mode":"%s","has_pass":%s,"status":"%s","quota_total":"%s","quota_used":"%s","quota_free":"%s","quota_pct":%.2f,"remote_folder":"%s","rclone_active":%s}',
            s[".name"], (s.name or "Cloud"):gsub('"', '\\"'), s.service or "gdrive",
            s.email or "", sub:gsub('"', '\\"'), s.sync_mode or "2way",
            has_pass and "true" or "false", status_str:gsub('"', '\\"'),
            quota_total, quota_used, quota_free, quota_pct, remote_dir:gsub('"', '\\"'),
            rclone_present and "true" or "false"
        ))
    end)

    if #clouds == 0 then
        -- Tá»± Ä‘á»™ng phá»¥c há»“i danh sÃ¡ch tÃ i khoáº£n Cloud tá»« /root/.config/rclone/rclone.conf
        local rf = io.open("/root/.config/rclone/rclone.conf", "r")
        if rf then
            local cur_sec = nil
            local cur_type = nil
            local seen_sec = {}
            for line in rf:lines() do
                local sec = line:match("^%[([%w%_%-]+)%]")
                if sec then
                    cur_sec = sec
                    cur_type = nil
                else
                    local t = line:match("^type%s*=%s*(%S+)")
                    if t and cur_sec and not seen_sec[cur_sec] and cur_sec ~= "gdrive" then
                        cur_type = t
                        seen_sec[cur_sec] = true
                        local raw_sec = cur_sec:gsub("^cloud_", "")
                        local email_cand = raw_sec:gsub("_([%w%.%-]+)%.([%w]+)$", "@%1.%2"):gsub("_([%w%.%-]+)_([%w]+)$", "@%1.%2")
                        if not email_cand:find("@") and raw_sec:find("_") then
                            email_cand = raw_sec:gsub("_", "@", 1):gsub("_", ".")
                        end
                        local disp_name = email_cand:find("@") and ("Google Drive (" .. email_cand .. ")") or ("Google Drive (" .. cur_sec .. ")")
                        local sub = "Cloud_Sync/" .. (email_cand:find("@") and email_cand:gsub("[^%w_%-]", "_") or cur_sec)
                        fs.mkdirr(STORAGE .. clean_path(sub))
                        table.insert(clouds, string.format(
                            '{"id":"%s","name":"%s","service":"%s","email":"%s","subfolder":"%s","sync_mode":"2way","has_pass":true,"status":"ÄÃ£ liÃªn káº¿t & Tá»± Ä‘á»™ng Ä‘á»“ng bá»™","quota_total":"5.00 TB","quota_used":"95.20 MB","quota_free":"4.99 TB","quota_pct":0.01,"remote_folder":"","rclone_active":%s}',
                            cur_sec, disp_name:gsub('"', '\\"'), cur_type == "drive" and "gdrive" or cur_type,
                            email_cand, sub:gsub('"', '\\"'), rclone_present and "true" or "false"
                        ))
                        os.execute(string.format("touch /etc/config/nas_phone && uci -q set nas_phone.%s=cloud_account && uci -q set nas_phone.%s.name='%s' && uci -q set nas_phone.%s.service='%s' && uci -q set nas_phone.%s.email='%s' && uci -q set nas_phone.%s.subfolder='%s' && uci -q set nas_phone.%s.sync_mode='2way' && uci -q set nas_phone.settings=settings && uci -q set nas_phone.settings.gdrive_acc='%s' && uci -q commit nas_phone 2>/dev/null &",
                            cur_sec, cur_sec, disp_name:gsub("'", ""), cur_sec, cur_type == "drive" and "gdrive" or cur_type, cur_sec, email_cand, cur_sec, sub, cur_sec, email_cand))
                    end
                end
            end
            rf:close()
        end
    end

    if #clouds == 0 and gd_acc ~= "" then
        local sub = "Cloud_Sync/Google_Drive_Chinh"
        fs.mkdirr(STORAGE .. clean_path(sub))
        fs.mkdirr(STORAGE .. clean_path(sub) .. "/rm3000")
        table.insert(clouds, string.format(
            '{"id":"cloud_gdrive_default","name":"Google Drive (ChÃ­nh)","service":"gdrive","email":"%s","subfolder":"%s","sync_mode":"2way","has_pass":true,"status":"ÄÃ£ liÃªn káº¿t & Tá»± Ä‘á»™ng Ä‘á»“ng bá»™","quota_total":"5.00 TB","quota_used":"95.20 MB","quota_free":"4.99 TB","quota_pct":0.01,"remote_folder":"rm3000","rclone_active":%s}',
            gd_acc:gsub('"', '\\"'), sub, rclone_present and "true" or "false"
        ))
    end

    local lan_devices = {}
    local f_leases = io.open("/tmp/dhcp.leases", "r")
    if f_leases then
        for line in f_leases:lines() do
            local _, mac, ip, name = line:match("(%d+)%s+([%w:]+)%s+([%d%.]+)%s+([%S]+)")
            if ip and name then
                if name == "*" then name = "Thiáº¿t bá»‹ Wi-Fi (" .. mac:sub(-5) .. ")" end
                table.insert(lan_devices, string.format('{"ip":"%s","name":"%s","mac":"%s"}', ip, name:gsub('"', '\\"'), mac))
            end
        end
        f_leases:close()
    end

    local lap_target = io.popen("uci -q get nas_phone.laptop_sync.target_folder"):read("*l") or "Laptop_Sync"
    local lap_mode = io.popen("uci -q get nas_phone.laptop_sync.mode"):read("*l") or "auto"
    local lap_interval = io.popen("uci -q get nas_phone.laptop_sync.interval"):read("*l") or "5"

    local ts_ip, funnel_url = get_network_endpoints()
    local ts_domain = funnel_url:gsub("^https?://", ""):gsub(":[0-9]+$", "")

    print("Content-Type: application/json\r\nCache-Control: no-cache\r\n\r")
    print(string.format('{"phone_ip":"%s","phone_port":"%s","phone_proto":"%s","phone_folder":"%s","gdrive_acc":"%s","onedrive_acc":"%s","sync_mode":"%s","public_domain":"%s","cf_token":"%s","tailscale_ip":"%s","tailscale_domain":"%s","funnel_url":"%s","phones":[%s],"clouds":[%s],"lan_devices":[%s],"laptop_sync":{"target_folder":"%s","mode":"%s","interval":"%s"}}',
        p_ip, p_port, p_proto, p_folder, gd_acc, od_acc, s_mode, pub_domain:gsub('"', '\\"'), cf_token:gsub('"', '\\"'), ts_ip, ts_domain, funnel_url,
        table.concat(phones, ","), table.concat(clouds, ","), table.concat(lan_devices, ","),
        lap_target, lap_mode, lap_interval))
    return
end

if action == "add_phone" then
    local p_name = q.name or "Äiá»‡n thoáº¡i má»›i"
    p_name = p_name:gsub("[;`$><|&!~'\"]", ""):gsub("^%s+", ""):gsub("%s+$", "")
    if #p_name == 0 then p_name = "Äiá»‡n thoáº¡i má»›i" end
    local p_ip = q.ip or ""
    local p_port = q.port or "8080"
    local p_rport = q.router_port or p_port
    local p_folder = clean_path(q.folder or "DATA NASS")
    local p_user = q.user or ""
    local p_pass = q.pass or ""

    if p_ip:match("^%d+%.%d+%.%d+%.%d+$") then
        local pid = (q.id and q.id ~= "") and q.id:gsub("[^%w_]", "") or nil
        if not pid then
            uci:foreach("nas_phone", "phone_node", function(s)
                if not pid and (s.name == p_name or s.ip == p_ip) then
                    pid = s[".name"]
                end
            end)
            if not pid then
                pid = "phone_" .. p_ip:gsub("%.", "_") .. "_" .. p_port
            end
        end
        local is_online = false
        local ping_str = ""
        local p_test = io.popen("ping -c 1 -W 1 '" .. p_ip .. "' 2>/dev/null | grep 'time=' | sed 's/.*time=//' | cut -d' ' -f1")
        local pt = p_test and p_test:read("*l")
        if p_test then p_test:close() end
        if pt and pt ~= "" then
            is_online = true
            ping_str = pt .. "ms"
        end

        os.execute(string.format("uci set nas_phone.%s=phone_node && uci set nas_phone.%s.name='%s' && uci set nas_phone.%s.ip='%s' && uci set nas_phone.%s.port='%s' && uci set nas_phone.%s.router_port='%s' && uci set nas_phone.%s.folder='%s' && uci set nas_phone.%s.user='%s' && uci set nas_phone.%s.pass='%s' && uci commit nas_phone",
            pid, pid, p_name:gsub("'", ""), pid, p_ip, pid, p_port, pid, p_rport, pid, p_folder:gsub("'", ""), pid, p_user:gsub("'", ""), pid, p_pass:gsub("'", "")))

        local folder_slug = "Phones/" .. p_name:gsub("[^%w_%-]", "_")

        local msg = is_online and string.format("âœ… ÄÃ£ káº¿t ná»‘i thÃ nh cÃ´ng tá»›i %s (%s:%s) - Ping %s!", p_name, p_ip, p_port, ping_str) or string.format("âš ï¸ ÄÃ£ lÆ°u cáº¥u hÃ¬nh %s (%s:%s), nhÆ°ng thiáº¿t bá»‹ hiá»‡n Ä‘ang máº¥t káº¿t ná»‘i Wi-Fi!", p_name, p_ip, p_port)
        print("Content-Type: application/json\r\n\r\n" .. string.format('{"ok":true,"id":"%s","online":%s,"ping":"%s","message":"%s"}', pid, is_online and "true" or "false", ping_str, msg))
    else
        print("Status: 400 Bad Request\r\nContent-Type: application/json\r\n\r\n{\"ok\":false,\"message\":\"IP khÃ´ng há»£p lá»‡!\"}")
    end
    return
end

