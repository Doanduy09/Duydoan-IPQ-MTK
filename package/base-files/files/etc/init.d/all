            click: function(ev) {
                if (!confirm('Xác nhận chuyển thiết bị này thành ROUTER PHỤ (Slave Node)?\n- IP LAN sẽ đổi sang 192.168.1.10 (đồng thời gán 192.168.1.2)\n- Tắt DHCP LAN để không xung đột với Router Chính\n- Bật card thu sóng Wi-Fi 6 kết nối vào Router Chính.\nTrang LuCI sẽ tự động chuyển sang http://192.168.1.10 sau 4 giây.')) return;
                ev.target.disabled = true;
                ev.target.textContent = '⏳ Đang chuyển sang Router Phụ (192.168.1.10)...';
                ui.showModal('Đang chuyển Router sang vai trò Phụ...', [ E('p', { class: 'spinning' }, 'Đang đổi IP sang 192.168.1.10, tắt DHCP và kết nối vào Router Chính...') ]);
                fetch('/cgi-bin/airdrop?action=mesh_set_node&ip=192.168.1.10')
                    .then(function(r) { return r.json(); })
