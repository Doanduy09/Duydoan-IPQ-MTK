            mon_ip=$(grep -i "$mon_mac" /proc/net/arp /tmp/dhcp.leases 2>/dev/null | awk '{print $1 $3}' | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' | head -1)
            
            is_online=0
            if [ -n "$mon_ip" ] && ping -c 1 -W 1 "$mon_ip" >/dev/null 2>&1; then
                is_online=1
