                    ev.target.textContent = '⚡ 1-Chạm Kích Hoạt ADB';
                    ev.target.disabled = false;
                    ui.addNotification(null, E('p', '❌ Lỗi: ' + (err.message || err)), 'error');
                });
            }
        }, '⚡ 1-Chạm Kích Hoạt ADB');

        var nasAddPhoneBtn = E('button', {
            class: 'btn cbi-button cbi-button-action',
            style: 'font-weight: 700; font-size: 12.5px; padding: 8px 14px; background: #ffffff; color: #000000; border-radius: 6px; cursor: pointer;',
            click: function(ev) {
                var pName = nasPhoneNameInput.value.trim() || 'Điện thoại NAS';
