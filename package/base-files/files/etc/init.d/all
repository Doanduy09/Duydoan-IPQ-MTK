        function updateActiveTabNav(activeTabKey) {
            var tabs = [
                { id: 'gh-tab-main', key: 'main' },
                { id: 'gh-tab-modem', key: 'modem' },
                { id: 'gh-tab-devices', key: 'devices' },
                { id: 'gh-tab-airdrop', key: 'airdrop' },
                { id: 'gh-tab-sentinel', key: 'sentinel' },
                { id: 'gh-tab-mesh', key: 'mesh' },
                { id: 'gh-tab-sim', key: 'sim' }
            ];
            tabs.forEach(function(t) {
                var el = document.getElementById(t.id);
                if (el) {
                    if (t.key === activeTabKey) {
                        el.classList.add('active');
                    } else {
                        el.classList.remove('active');
                    }
                }
            });
        }

        function closeAllTabs() {
            currentActiveTab = 'main';
            try { sessionStorage.setItem('luci_weather_active_tab', 'main'); } catch(e) {}
            isUserInteracting = false;
            stopMeshPolling();
            combinedModemWifiWrapper.style.display = 'none';
            meshContainerNode.style.display = 'none';
            deviceManagementWrapper.style.display = 'none';
            fileExplorerContent.style.display = 'none';
            airdropContainerNode.style.display = 'none';
            if (typeof sentinelContainerNode !== 'undefined' && sentinelContainerNode) sentinelContainerNode.style.display = 'none';
            if (typeof simManagementWrapper !== 'undefined' && simManagementWrapper) simManagementWrapper.style.display = 'none';
            weatherMainTableNode.style.display = 'block';
            flashFirmwareCard.style.display = 'block';
            weatherTitleBar.style.display = 'flex';
            try { poll.start(); } catch(e) {}
            syncOnTabWake();
            updateActiveTabNav('main');
        }

        function openTab(targetNode, tabKey) {
            var isAlreadyOpen = (currentActiveTab === tabKey);
            closeAllTabs();
            if (!isAlreadyOpen) {
                currentActiveTab = tabKey;
                try { sessionStorage.setItem('luci_weather_active_tab', tabKey); } catch(e) {}
                targetNode.style.display = 'block';
                weatherMainTableNode.style.display = 'none';
                flashFirmwareCard.style.display = 'none';
                weatherTitleBar.style.display = 'none';
                try { poll.stop(); } catch(e) {}
                updateActiveTabNav(tabKey);
                if (tabKey === 'devices' || tabKey === 'modem') {
                    refreshDeviceList();
                } else if (tabKey === 'airdrop') {
                    refreshRemoteDomainStatus();
                    refreshNASStatus();
                    updateLuciStorageLabels();
                } else if (tabKey === 'mesh') {
                    refreshMeshStatus(false);
                    startMeshPolling();
                } else if (tabKey === 'sentinel') {
                    refreshAISentinelStatus();
                } else if (tabKey === 'sim') {
                    refreshSimManagerUI();
                }
            }
        }

