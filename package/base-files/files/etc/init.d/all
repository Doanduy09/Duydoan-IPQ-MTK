                            ])
                        ]),
                        E('div', { style: 'margin-bottom: 14px;' }, [
                            E('label', { style: 'font-weight:700; font-size:12.5px; display:block; margin-bottom:4px;' }, '📡 Băng tần 5GHz Thấp (Ch 36 - HE160 Siêu Tốc):'),
                            E('div', { style: 'display:flex; gap:8px;' }, [
                                E('input', { type: 'text', id: 'edit-node-s2', placeholder: 'Tên Wi-Fi (VD: TPT Lam 5G)', style: 'flex:1; padding:6px 10px; border:1px solid #cbd5e1; border-radius:6px;' }),
                                E('input', { type: 'text', id: 'edit-node-k2', placeholder: 'Mật khẩu', style: 'flex:1; padding:6px 10px; border:1px solid #cbd5e1; border-radius:6px;' })
                            ])
                        ]),
                        E('div', { style: 'display:flex; justify-content:flex-end; gap:8px; margin-top:14px;' }, [
                            E('button', {
                                class: 'btn',
                                style: 'padding:8px 16px; border-radius:6px; background: #ffffff; border:none; cursor:pointer;',
                                click: ui.hideModal
                            }, 'Đóng'),
                            E('button', {
                                class: 'btn cbi-button-action',
                                style: 'padding:8px 18px; border-radius:6px; background: #ffffff; color: #000000; font-weight:700; border:none; cursor:pointer;',
                                click: function(ev) {
                                    var s0 = document.getElementById('edit-node-s0').value.trim();
                                    var k0 = document.getElementById('edit-node-k0').value.trim();
                                    var s1 = document.getElementById('edit-node-s1').value.trim();
                                    var k1 = document.getElementById('edit-node-k1').value.trim();
                                    var s2 = document.getElementById('edit-node-s2').value.trim();
                                    var k2 = document.getElementById('edit-node-k2').value.trim();
                                    ev.target.disabled = true;
                                    ev.target.textContent = '⏳ Đang lưu...';
                                    var url = '/cgi-bin/airdrop?action=mesh_set_node_wifi&ip=' + encodeURIComponent(nodeIp) +
                                        '&s0=' + encodeURIComponent(s0) + '&k0=' + encodeURIComponent(k0) +
                                        '&s1=' + encodeURIComponent(s1) + '&k1=' + encodeURIComponent(k1) +
                                        '&s2=' + encodeURIComponent(s2) + '&k2=' + encodeURIComponent(k2);
                                    fetch(url)
                                        .then(function(r) { return r.json(); })
                                        .then(function(res) {
                                            ui.hideModal();
                                            if (res.status === 'success') {
                                                ui.addNotification(null, E('p', '✅ ' + (res.message || 'Đã đổi tên Wi-Fi thành công!')), 'info');
                                            } else {
                                                ui.addNotification(null, E('p', '❌ ' + (res.message || 'Lỗi')), 'error');
                                            }
                                        }).catch(function(err) {
                                            ui.hideModal();
                                            ui.addNotification(null, E('p', '❌ Lỗi: ' + err), 'error');
                                        });
                                }
                            }, '💾 Lưu & Áp Dụng Cho Router Phụ')
                        ])
                    ])
                ])
            ]);

            fetch('/cgi-bin/airdrop?action=mesh_get_node_wifi&ip=' + encodeURIComponent(nodeIp))
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    var loadEl = document.getElementById('modal-node-wifi-loading');
                    var formEl = document.getElementById('modal-node-wifi-fields');
                    if (loadEl) loadEl.style.display = 'none';
                    if (formEl) formEl.style.display = 'block';
                    if (data.status === 'success') {
                        var eS0 = document.getElementById('edit-node-s0');
                        var eK0 = document.getElementById('edit-node-k0');
                        var eS1 = document.getElementById('edit-node-s1');
                        var eK1 = document.getElementById('edit-node-k1');
                        var eS2 = document.getElementById('edit-node-s2');
                        var eK2 = document.getElementById('edit-node-k2');
                        if (eS0) eS0.value = data.s0 || 'TPTLam';
                        if (eK0) eK0.value = data.k0 || 'TPTlam011205@!';
                        if (eS1) eS1.value = data.s1 || 'TPT Lam';
                        if (eK1) eK1.value = data.k1 || 'TPTlam011205@!';
                        if (eS2) eS2.value = data.s2 || 'TPT Lam 5G';
                        if (eK2) eK2.value = data.k2 || 'TPTlam011205@!';
                    }
                }).catch(function() {
                    var loadEl = document.getElementById('modal-node-wifi-loading');
                    var formEl = document.getElementById('modal-node-wifi-fields');
                    if (loadEl) loadEl.innerHTML = '<span style="color: #000000;">❌ Không thể kết nối tới Router phụ</span>';
                    if (formEl) formEl.style.display = 'block';
                });
        };

        var meshPollTimer = null;
        function startMeshPolling() {
            stopMeshPolling();
            meshPollTimer = setInterval(function() {
                if (currentActiveTab === 'mesh' && !isUserInteracting) {
                    refreshMeshStatus(true);
                }
            }, 3000);
        }
        function stopMeshPolling() {
            if (meshPollTimer) {
                clearInterval(meshPollTimer);
                meshPollTimer = null;
            }
        }

        function refreshMeshStatus(isSilent) {
            if (!isSilent && (!meshStatusCard.children || meshStatusCard.children.length === 0)) {
                meshStatusCard.innerHTML = '<div style="text-align:center; padding: 20px;">⏳ Đang tải thông tin Mesh...</div>';
            }
            Promise.all([
                fetch('/cgi-bin/airdrop?action=mesh_status').then(function(r) { return r.json(); }).catch(function() { return {}; }),
                (window._lastFastStats ? Promise.resolve(window._lastFastStats) : callFastStats().catch(function() { return null; }))
            ]).then(function(resList) {
                var d = resList[0] || {};
                var fast = resList[1] || window._lastFastStats || {};
                if (resList[1]) window._lastFastStats = resList[1];
                var isCtrl = (d.role === 'controller');
                var roleBadge = !d.mesh_active ?
                    '<span style="background: #ffffff; color: #000000; padding: 5px 12px; border-radius: 6px; font-weight: 800; font-size: 13px;">🟢 ROUTER PHÁT (ĐỘC LẬP - STANDALONE)</span>' :
                    (isCtrl ? 
                        '<span style="background: #ffffff; color: #000000; padding: 5px 12px; border-radius: 6px; font-weight: 800; font-size: 13px;">👑 ROUTER CHÍNH (MASTER CONTROLLER - GỐC)</span>' : 
                        (d.has_internet ?
                            '<span style="background: #ffffff; color: #000000; padding: 5px 12px; border-radius: 6px; font-weight: 800; font-size: 13px;">📡 ROUTER PHỤ (ĐÃ KẾT NỐI MESH - ĐANG NHẬN INTERNET)</span>' :
                            '<span style="background: #ffffff; color: #000000; padding: 5px 12px; border-radius: 6px; font-weight: 800; font-size: 13px;">📡 ROUTER PHỤ (ĐANG KẾT NỐI VÀO MESH...)</span>'));

                var speedDisplay = (d.htmode === 'HE160') ? '2402.0 Mbps (HE160)' : ((d.htmode === 'HE80') ? '1201.0 Mbps (HE80)' : (d.htmode || 'Tiêu Chuẩn'));
                var activeBadge = d.mesh_active ? 
                    '<span style="background: #ffffff; color: #000000; border: 1px solid #86efac; padding: 5px 10px; border-radius: 6px; font-weight: 700; font-size: 12.5px;">🟢 Cụm Mesh Đang Hoạt Động (Wi-Fi 6 ' + (d.htmode || '5G') + ' • ' + speedDisplay + ')</span>' : 
                    '<span style="background: #ffffff; color: #000000; border: 1px solid #bfdbfe; padding: 5px 10px; border-radius: 6px; font-weight: 700; font-size: 12.5px;">🟢 Wi-Fi 6 Sẵn Sàng (HE160 • ' + speedDisplay + ')</span>';
