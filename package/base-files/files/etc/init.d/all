                        setTimeout(function() { refreshMeshStatus(); }, 1500);
                    }).catch(function(err) {
                        ev.target.disabled = false;
                        ev.target.textContent = '👑 ĐẶT LÀM ROUTER CHÍNH (192.168.1.1)';
