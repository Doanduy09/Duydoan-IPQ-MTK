        // Network Speed
        if (d.traffic_rates) {
          const dl = d.traffic_rates.dl_mbps || '0.0';
          const ul = d.traffic_rates.ul_mbps || '0.0';
          document.getElementById('dl-speed').innerHTML = `${dl} <small style="font-size:13px">Mbps</small>`;
          document.getElementById('ul-speed').textContent = `Tải lên: ${ul} Mbps`;
          const pct = Math.min(100, Math.max(0, (parseFloat(dl) / 250) * 100));
