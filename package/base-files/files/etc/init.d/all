                fi
                ;;
            toggleMWAN3)
                action=$(echo "$input" | jsonfilter -e '$.action' 2>/dev/null)
                if [ -x /usr/bin/mwan3_mgr.sh ]; then
                    if [ "$action" = "on" ] || [ "$action" = "load" ]; then
                        /usr/bin/mwan3_mgr.sh on
                    elif [ "$action" = "off" ]; then
                        /usr/bin/mwan3_mgr.sh off
                    else
                        /usr/bin/mwan3_mgr.sh status
                    fi
                else
                    printf '{"success":false,"message":"Chưa cài đặt mwan3_mgr.sh"}\n'
                fi
                ;;
            toggleGameMode)
                action=$(echo "$input" | jsonfilter -e '$.action' 2>/dev/null)
                if [ -x /usr/bin/game_booster.sh ]; then
                    if [ "$action" = "on" ]; then
                        /usr/bin/game_booster.sh on
