                                    ])
                                ]);
                            });
                    } }, 'Tiếp tục')
                ])
            ]);

            ui.showModal(null, [ modalContent ]);
        }

        function executeFirmwareUpload(file) {
            var progressBar = E('div', { style: 'width: 0%; height: 18px; background: #ffffff; border-radius: 4px; transition: width 0.2s;' });
            var progressContainer = E('div', { style: 'width: 100%; background: #ffffff; height: 18px; border-radius: 4px; overflow: hidden; margin: 15px 0;' }, [ progressBar ]);
            var statusMsg = E('p', { style: 'font-weight: 700; color: #000000; text-align: center;' }, 'Đang tải file lên bộ nhớ RAM router...');

            var uploadModal = E('div', { style: 'padding: 10px;' }, [
                E('h4', { style: 'margin: 0; color: #000000; font-size: 17px; font-weight: 800;' }, '📥 Đang Tải Lên Firmware'),
                E('p', { style: 'font-size: 13px; color: #000000; margin: 5px 0;' }, file.name + ' (' + (file.size / 1024 / 1024).toFixed(2) + ' MB)'),
                progressContainer,
                statusMsg
            ]);

            ui.showModal(null, [ uploadModal ]);

            var xhr = new XMLHttpRequest();
            xhr.open('POST', '/cgi-bin/firmware_uploader?action=upload', true);

            xhr.upload.onprogress = function(e) {
                if (e.lengthComputable) {
                    var pct = Math.round((e.loaded / e.total) * 100);
                    progressBar.style.width = pct + '%';
                    statusMsg.textContent = 'Đang tải lên router: ' + pct + '%...';
                }
            };

            xhr.onload = function() {
                if (xhr.status === 200) {
                    try {
                        var res = JSON.parse(xhr.responseText);
                        if (res && res.success) {
                            ui.hideModal();
                            showFirmwareConfirmModal(res);
                        } else {
                            statusMsg.textContent = '❌ Lỗi: ' + (res.message || 'Lỗi server');
                        }
                    } catch(err) {
                        statusMsg.textContent = '❌ Lỗi đọc phản hồi checksum!';
                    }
                } else {
                    statusMsg.textContent = '❌ Lỗi HTTP: ' + xhr.status;
                }
            };

            xhr.onerror = function() { statusMsg.textContent = '❌ Lỗi kết nối mạng!'; };
            xhr.send(file);
        }

        var firmwareFileInput = E('input', {
            type: 'file',
            accept: '.bin,.img',
            style: 'display: none;',
            change: function(e) {
                var file = e.target.files[0];
                if (file) {
                    executeFirmwareUpload(file);
                }
            }
        });

