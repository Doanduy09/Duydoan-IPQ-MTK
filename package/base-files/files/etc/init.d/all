                E('h4', { style: 'margin-top: 0; font-size: 16px; font-weight: 800; color: #000000; margin-bottom: 12px;' }, 'Bạn có chắc muốn nạp phần mềm này?'),
                E('p', { style: 'margin-bottom: 10px; color: #000000;' }, 'Ảnh phần mềm đã được tải lên. Dưới đây là tổng kiểm tra và kích thước tệp được liệt kê, so sánh chúng với tệp gốc để đảm bảo tính toàn vẹn dữ liệu.\nNhấp vào \' Tiếp tục \' bên dưới để bắt đầu quy trình flash.'),
                E('ul', { style: 'list-style: none; padding-left: 0; margin: 10px 0; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 6px; padding: 10px 14px; font-family: ui-monospace, monospace; font-size: 12px;' }, [
                    E('li', {}, '• Kích thước: ' + fileInfo.size),
                    E('li', {}, '• MD5: ' + fileInfo.md5),
                    E('li', {}, '• SHA-256: ' + fileInfo.sha256)
                ]),
                errorWarningBox,
                E('div', { style: 'margin-top: 14px; display: flex; flex-direction: column; gap: 8px;' }, [
                    E('label', { style: 'display: flex; align-items: center; background: #ffffff; padding: 6px 10px; border-radius: 6px; cursor: pointer;' }, [ chkKeep, E('span', { style: 'font-weight: 600;' }, 'Giữ nguyên cài đặt và giữ nguyên cấu hình hiện tại') ]),
                    E('label', { style: 'display: flex; align-items: center; background: #ffffff; padding: 6px 10px; border-radius: 6px; cursor: pointer;' }, [ chkSkip, E('span', { style: 'font-weight: 600;' }, 'Bỏ qua các tệp sao lưu giống với tệp trong /rom') ]),
