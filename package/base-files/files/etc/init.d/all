                            setTimeout(refreshCameraCloudStatus, 500);
                        }
                    }).catch(function(err) {
                        ui.addNotification(null, E('p', '❌ Lỗi xóa: ' + (err.message || err)), 'error');
                    });
            }
        }, '🗑️ Xóa Bot');

