        function updateLuciStorageLabels() {
            fetch('/cgi-bin/airdrop?action=sys_stats&t=' + Date.now())
                .then(function(r) { return r.json(); })
                .then(function(d) {
                    if (d && d.status === 'OK') {
                        var badge = document.getElementById('luciStorageHeaderBadge');
                        if (badge) {
                            var isFlash = d.storage_type && d.storage_type.indexOf('Flash') >= 0;
                            var sLabel = isFlash ? ('Flash ' + (d.emmc_total || '74MB')) : ('eMMC ' + (d.emmc_free || '128GB'));
                            badge.textContent = '⚡ ' + sLabel + ' + Cụm NAS';
                        }
                        var btn = document.getElementById('subTabAirdropBtn');
                        if (btn) {
                            var isFlash = d.storage_type && d.storage_type.indexOf('Flash') >= 0;
                            var sName = isFlash ? 'Bộ Nhớ Flash' : 'Bộ Nhớ eMMC';
                            btn.textContent = '📂 Router AirDrop (' + sName + ')';
                        }
                    }
                }).catch(function(){});
            if (typeof refreshCameraCloudStatus === 'function') {
                refreshCameraCloudStatus();
            }
        }
        setTimeout(updateLuciStorageLabels, 300);

