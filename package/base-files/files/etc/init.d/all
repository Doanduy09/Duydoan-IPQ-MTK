function formatProtoName(p) {
    if (!p) return 'Máy khách DHCP';
    var lower = p.toLowerCase();
    if (lower === 'quectel') return 'Quectel QMI/ECM';
    if (lower === 'xmm') return 'Fibocom / Intel XMM';
    if (lower === 'mbim') return 'MBIM Cellular (Fast 5G)';
    if (lower === 'modemmanager') return 'ModemManager';
    if (lower === 'dhcp') return 'RNDIS / ECM (DHCP)';
    if (lower === 'qmi') return 'QMI Cellular';
    return p;
}

function renderHnatToggleBtn(isHnatEn) {
    return E('button', {
        id: 'btn-toggle-hnat-badge',
        'data-enabled': isHnatEn ? '1' : '0',
        title: 'Bấm để Bật / Tắt tăng tốc phần cứng MediaTek PPE HNAT (WED Turbo)',
        style: 'margin-left: 6px; padding: 2px 10px; border-radius: 14px; font-size: 12px; font-weight: 800; cursor: pointer; transition: all 0.2s; ' +
               (isHnatEn ? 'background: #dcfce7; color: #15803d; border: 1px solid #86efac;' : 'background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1;'),
        click: function(ev) {
            ev.stopPropagation();
            var btn = document.getElementById('btn-toggle-hnat-badge') || ev.currentTarget;
            var curOn = btn.getAttribute('data-enabled') === '1';
            var nextAct = curOn ? 'off' : 'on';
            btn.textContent = '⏳ Đang chuyển...';
            callToggleHNAT(nextAct).then(function(res) {
                var nowOn = (nextAct === 'on');
                btn.setAttribute('data-enabled', nowOn ? '1' : '0');
                btn.textContent = nowOn ? '🟢 HNAT: BẬT' : '⚪ HNAT: TẮT';
                btn.style.background = nowOn ? '#dcfce7' : '#f1f5f9';
                btn.style.color = nowOn ? '#15803d' : '#475569';
                btn.style.border = nowOn ? '1px solid #86efac' : '1px solid #cbd5e1';
                if (window._lastFastStats) window._lastFastStats.hnat_enabled = nowOn ? 1 : 0;
                var elPpe = document.getElementById('ppe-conns-val');
                if (elPpe) elPpe.textContent = nowOn ? 'Hoạt động' : 'Đã tắt (CPU/VPN)';
                ui.addNotification(null, E('p', (res && res.message) ? res.message : (nowOn ? '⚡ Đã BẬT MediaTek PPE HNAT!' : '🛑 Đã TẮT MediaTek PPE HNAT!')), 'info');
            }).catch(function(err) {
                btn.textContent = curOn ? '🟢 HNAT: BẬT' : '⚪ HNAT: TẮT';
                ui.addNotification(null, E('p', '❌ Lỗi: ' + (err.message || err)), 'error');
            });
        }
    }, isHnatEn ? '🟢 HNAT: BẬT' : '⚪ HNAT: TẮT');
}

function updateCombinedWwanUI(f, w) {
    var wwanEl = document.getElementById('wwan-combined-status-box');
    if (!wwanEl) return;

    var hasWwan = false;
    if (f && f.has_wwan !== undefined) hasWwan = !!f.has_wwan;
    else if (w && w.has_wwan !== undefined) hasWwan = !!w.has_wwan;
    else if (w && w.wwan_name && w.wwan_name !== '' && w.wwan_name !== 'Modem 5G/LTE' && w.wwan_name !== 'WWAN') hasWwan = true;

    var hasWan = false;
    if (w && w.has_wan !== undefined) hasWan = !!w.has_wan;
    else if (f && f.has_wan !== undefined) hasWan = !!f.has_wan;

    var ifaceVal = (w && w.active_iface) ? w.active_iface : '';
    var isWan = hasWan || (ifaceVal === 'wan' || ifaceVal === 'wan6');

    var tempVal = (f && f.wwan_temp) ? f.wwan_temp : '';
    var sigVal  = (f && f.wwan_signal) ? f.wwan_signal : '';
    var cardName = (w && w.wwan_name) ? w.wwan_name : '';
    var protoVal = (w && w.active_proto) ? w.active_proto : '';
    var ipVal    = (w && w.active_ip) ? w.active_ip : '';

    var isConnected = ipVal && ipVal !== '' && ipVal !== '0.0.0.0' && ipVal !== 'Đang kết nối...' && ipVal !== 'N/A';

    var r1 = document.getElementById('wwan-row1-text');
    var r1Icon = document.getElementById('wwan-row1-icon');
    var r2Box = document.getElementById('wwan-row2-box');
    var rProto = document.getElementById('wwan-proto-val');
    var rIface = document.getElementById('wwan-iface-val');
    var rIpLabel = document.getElementById('wwan-ip-label');
    var rIp = document.getElementById('wwan-ip-val');
    var btnAction = document.getElementById('btn-restart-wwan');

    if (!hasWwan && !isWan) {
        // TRẠNG THÁI 1: CHƯA CÓ THIẾT BỊ MẠNG (Không có Card WWAN và Không có Cáp WAN)
        wwanEl.style.background = '#f8fafc';
        wwanEl.style.borderColor = '#cbd5e1';
        wwanEl.style.color = '#475569';
        if (r1Icon) r1Icon.textContent = '⚪ ';
        if (r1) {
            r1.textContent = 'Chưa Phát Hiện Thiết Bị Mạng (Chưa gắn Card WWAN hoặc Cáp Mạng WAN)';
            r1.style.color = '#475569';
            r1.style.fontWeight = '800';
        }
        if (r2Box) r2Box.style.color = '#64748b';
        if (rProto) rProto.textContent = 'Trống';
        if (rIface) rIface.textContent = 'Chưa kích hoạt';
        if (rIpLabel) rIpLabel.textContent = 'IP: ';
        if (rIp) {
            rIp.textContent = 'Không có kết nối';
            rIp.style.color = '#64748b';
            rIp.style.background = '#f1f5f9';
            rIp.style.borderColor = '#cbd5e1';
        }
        if (btnAction) {
            btnAction.textContent = '🔍 Dò Tìm Thiết Bị';
            btnAction.style.background = '#64748b';
        }
    } else if (isWan && !hasWwan) {
        // TRẠNG THÁI 2: KẾT NỐI CÁP MẠNG WAN (Ethernet)
        wwanEl.style.background = '#eff6ff';
        wwanEl.style.borderColor = '#bfdbfe';
        wwanEl.style.color = '#1d4ed8';
        if (r1Icon) r1Icon.textContent = '🌐 ';
        if (r1) {
            r1.textContent = 'Kết Nối Cáp Mạng WAN (Cáp mạng có dây Ethernet)';
            r1.style.color = '#1d4ed8';
            r1.style.fontWeight = '800';
        }
        if (r2Box) r2Box.style.color = '#2563eb';
        if (rProto) rProto.textContent = formatProtoName(protoVal || 'dhcp');
        if (rIface) rIface.textContent = ifaceVal || 'wan';
        if (rIpLabel) rIpLabel.textContent = 'IP WAN: ';
        if (rIp) {
            rIp.textContent = isConnected ? ipVal : '[⏳ Đang nhận IP...]';
            rIp.style.color = isConnected ? '#1e40af' : '#ca8a04';
            rIp.style.background = isConnected ? '#dbeafe' : '#fef9c3';
            rIp.style.borderColor = isConnected ? '#93c5fd' : '#fde047';
        }
        if (btnAction) {
            btnAction.textContent = '🔄 Làm Mới WAN';
            btnAction.style.background = '#2563eb';
        }
    } else {
        // TRẠNG THÁI 3: ĐÃ GẮN CARD WWAN 5G/LTE
        var devName = cardName || 'Modem 5G/LTE';
        if (btnAction) {
            btnAction.textContent = '🔄 Khởi Động Card WWAN';
            btnAction.style.background = '#2563eb';
        }

        if (isConnected) {
            // 3A: Đã có IP
            wwanEl.style.background = '#f0fdf4';
            wwanEl.style.borderColor = '#86efac';
            wwanEl.style.color = '#166534';
            if (r1Icon) r1Icon.textContent = '';
            var tempStr = tempVal ? ('🔥 ' + tempVal + ' ') : '';
            var sigStr = sigVal ? ('❄️ ' + sigVal + ' — ') : '';
            if (r1) {
                r1.textContent = tempStr + sigStr + devName;
                r1.style.color = '#166534';
                r1.style.fontWeight = '700';
            }
            if (r2Box) r2Box.style.color = '#047857';
            if (rProto) rProto.textContent = formatProtoName(protoVal || 'mbim');
            if (rIface) rIface.textContent = ifaceVal || 'wwan0';
            if (rIpLabel) rIpLabel.textContent = 'IP ' + (ifaceVal || 'WWAN0').toUpperCase() + ': ';
            if (rIp) {
                rIp.textContent = ipVal;
                rIp.style.color = '#db2777';
                rIp.style.background = '#fdf2f8';
                rIp.style.borderColor = '#fbcfe8';
            }
        } else {
            // 3B: Đang kết nối (chưa nhận IP)
            wwanEl.style.background = '#fefce8';
            wwanEl.style.borderColor = '#fef08a';
            wwanEl.style.color = '#854d0e';
            if (r1Icon) r1Icon.textContent = '⏳ ';
            if (r1) {
                r1.textContent = 'Đang kết nối mạng di động... — ' + devName;
                r1.style.color = '#854d0e';
                r1.style.fontWeight = '700';
            }
            if (r2Box) r2Box.style.color = '#a16207';
            if (rProto) rProto.textContent = formatProtoName(protoVal || 'mbim');
            if (rIface) rIface.textContent = ifaceVal || 'wwan0';
            if (rIpLabel) rIpLabel.textContent = 'IP ' + (ifaceVal || 'WWAN0').toUpperCase() + ': ';
            if (rIp) {
                rIp.textContent = '[⏳ Đang nhận IP...]';
                rIp.style.color = '#ca8a04';
                rIp.style.background = '#fef9c3';
                rIp.style.borderColor = '#fde047';
            }
        }
    }
}

function getFormattedLiveTime() {
    var now = new Date();
    var pad = function(n) { return (n < 10 ? '0' : '') + n; };
    return pad(now.getHours()) + ':' + pad(now.getMinutes()) + ':' + pad(now.getSeconds()) + ' - ' + pad(now.getDate()) + '/' + pad(now.getMonth() + 1) + '/' + now.getFullYear();
}

function updateHwAccelBadge(f, curModel) {
    var elNssBadge = document.getElementById('nss-ecm-turbo-badge');
    if (!elNssBadge || !f) return;

    var isMtkCur = (f.hw_accel_type === 'mtk_ppe') || 
                   (f.hw_accel_name && f.hw_accel_name.indexOf('MediaTek') !== -1) || 
                   (curModel && (curModel.indexOf('TUF-AX4200') !== -1 || curModel.indexOf('TUF-AX6000') !== -1 || curModel.indexOf('AX6000') !== -1 || curModel.indexOf('AX4200') !== -1 || curModel.indexOf('Filogic') !== -1 || curModel.indexOf('5GCPE') !== -1 || curModel.indexOf('MediaTek') !== -1 || curModel.indexOf('MT798') !== -1)) ||
                   (f.soc_family && f.soc_family.indexOf('MediaTek') !== -1);

    var hwLabel = isMtkCur ? '⚡ MediaTek PPE Hardware NAT (WED Turbo):' : (f.hw_accel_name ? ('⚡ ' + f.hw_accel_name + ':') : '⚡ Qualcomm NSS + ECM Turbo:');
    var elTitle = document.getElementById('hw-accel-badge-title') || elNssBadge.firstElementChild;
    if (elTitle) elTitle.textContent = hwLabel;

    var elDetailsBox = document.getElementById('hw-accel-details-box') || elNssBadge.children[1];
    var curArch = elNssBadge.getAttribute('data-arch');
    var targetArch = isMtkCur ? 'mtk' : 'qca';

    var ecmConns = f.conntrack_count || f.ecm_conns || '0';
    var ecmTcp = f.conntrack_tcp || f.ecm_tcp || '0';
    var ecmUdp = f.conntrack_udp || f.ecm_udp || '0';

    if (elDetailsBox && curArch !== targetArch) {
        elNssBadge.setAttribute('data-arch', targetArch);
        while (elDetailsBox.firstChild) elDetailsBox.removeChild(elDetailsBox.firstChild);
        if (isMtkCur) {
            var ppeVal = parseInt(f.ppe_conns || '0');
            var ppeTxt = ppeVal > 0 ? (ppeVal + ' luồng HW') : 'Hoạt động';
            elDetailsBox.appendChild(E('span', {}, [
                'PPE HW: ',
                E('b', { id: 'ppe-conns-val', style: 'color: #000000;' }, ppeTxt)
            ]));
            elDetailsBox.appendChild(E('span', { style: 'color: #000000;' }, ' • '));
            elDetailsBox.appendChild(E('span', {}, [
                'Conntrack: ',
                E('b', { id: 'ecm-conns-val', style: 'color: #000000;' }, ecmConns + ' luồng'),
                E('span', { id: 'ecm-proto-breakdown', style: 'color: #000000; font-size: 11px; margin-left: 2px;' }, ' (TCP ' + ecmTcp + ' / UDP ' + ecmUdp + ')')
            ]));
        } else {
            elDetailsBox.appendChild(E('span', {}, [
                'NSS: ',
                E('b', { id: 'nss-traffic-val', style: 'color: #000000;' }, f.nss_traffic || '0 MB'),
                E('span', { id: 'nss-load-val', style: 'color: #000000; font-size: 11px; margin-left: 2px;' }, ' (' + (f.nss_load || '0%') + ')')
            ]));
            elDetailsBox.appendChild(E('span', { style: 'color: #000000;' }, ' • '));
            elDetailsBox.appendChild(E('span', {}, [
                'ECM: ',
                E('b', { id: 'ecm-conns-val', style: 'color: #000000;' }, (f.ecm_conns || '0') + ' luồng'),
                E('span', { id: 'ecm-proto-breakdown', style: 'color: #000000; font-size: 11px; margin-left: 2px;' }, ' (TCP ' + (f.ecm_tcp || '0') + ' / UDP ' + (f.ecm_udp || '0') + ')')
            ]));
        }
    } else {
        if (isMtkCur) {
            var isHnatEn = (f.hnat_enabled === undefined || f.hnat_enabled === null) ? true : (String(f.hnat_enabled) !== '0' && f.hnat_enabled !== false);
            var elPpe = document.getElementById('ppe-conns-val');
            var ppeVal = parseInt(f.ppe_conns || '0');
            if (elPpe) elPpe.textContent = !isHnatEn ? 'Đã tắt (CPU/VPN)' : (ppeVal > 0 ? (ppeVal + ' luồng HW') : 'Hoạt động');
            var elBtnHnat = document.getElementById('btn-toggle-hnat-badge');
            if (!elBtnHnat && elDetailsBox) {
                elBtnHnat = renderHnatToggleBtn(isHnatEn);
                elDetailsBox.appendChild(elBtnHnat);
            } else if (elBtnHnat && elBtnHnat.textContent.indexOf('⏳') === -1) {
                elBtnHnat.setAttribute('data-enabled', isHnatEn ? '1' : '0');
                elBtnHnat.textContent = isHnatEn ? '🟢 HNAT: BẬT' : '⚪ HNAT: TẮT';
                elBtnHnat.style.background = isHnatEn ? '#dcfce7' : '#f1f5f9';
                elBtnHnat.style.color = isHnatEn ? '#15803d' : '#475569';
                elBtnHnat.style.border = isHnatEn ? '1px solid #86efac' : '1px solid #cbd5e1';
            }
            var elConntrack = document.getElementById('ecm-conns-val');
            if (elConntrack) elConntrack.textContent = ecmConns + ' luồng';
            var elBreakdown = document.getElementById('ecm-proto-breakdown');
            if (elBreakdown) elBreakdown.textContent = ' (TCP ' + ecmTcp + ' / UDP ' + ecmUdp + ')';
        } else {
            var elNssTraffic = document.getElementById('nss-traffic-val');
            if (elNssTraffic && f.nss_traffic) elNssTraffic.textContent = f.nss_traffic;
            var elNssLoad = document.getElementById('nss-load-val');
            if (elNssLoad && f.nss_load) elNssLoad.textContent = ' (' + f.nss_load + ')';
            var elEcmConns = document.getElementById('ecm-conns-val');
            if (elEcmConns && f.ecm_conns) elEcmConns.textContent = (f.ecm_conns || '0') + ' luồng';
            var elEcmBreakdown = document.getElementById('ecm-proto-breakdown');
            if (elEcmBreakdown) elEcmBreakdown.textContent = ' (TCP ' + (f.ecm_tcp || '0') + ' / UDP ' + (f.ecm_udp || '0') + ')';
        }
    }
}

function updateRamBadge(f) {
    var elZram = document.getElementById('zram-badge-val');
    if (!elZram || !f) return;
    var swVal = parseInt(f.swap_total_mb || '0');
    var isZr = (f.zram_active === true || f.zram_active === 'true');
    var isEmmc = (f.swap_type === 'emmc_swap');
    var ramTot = parseInt(f.ram_total_mb || '0');
    if (isZr && swVal > 0 && !isEmmc) {
        var swLabel = (swVal >= 1024) ? ((swVal / 1024).toFixed(1).replace('.0', '') + 'GB') : swVal + 'MB';
        elZram.textContent = '⚡ Turbo zRAM: ' + swLabel;
        elZram.title = 'Turbo zRAM Engine (' + (f.swap_type || 'zram') + ' ' + swLabel + ')';
    } else if (swVal > 0) {
        var swLabel = (swVal >= 1024) ? ((swVal / 1024).toFixed(1).replace('.0', '') + 'GB') : swVal + 'MB';
        elZram.textContent = '⚡ Swap: ' + swLabel;
        elZram.title = 'Phân vùng Swap: ' + swLabel;
    } else if (ramTot >= 1500) {
        elZram.textContent = '⚡ 2GB DDR4 High-Speed RAM';
        elZram.title = 'Bộ Nhớ Siêu Tốc 2GB DDR4 • Không Cần Swap (Độ trễ Nano-giây)';
    } else if (ramTot >= 700) {
        elZram.textContent = '⚡ Turbo zRAM: 512MB';
        elZram.title = 'Turbo zRAM Engine (zstd 512MB • Chuẩn Nén 3:1)';
    } else {
        elZram.textContent = '⚡ RAM ' + ramTot + 'MB';
        elZram.title = 'RAM vật lý';
    }
}

function updateRFSignalBadgeDisplay(rf) {
    var elScore = document.getElementById('rf-score-badge');
    var el5G = document.getElementById('rf-5g-badge');
    var elLTE = document.getElementById('rf-lte-badge');
    var elAdv = document.getElementById('rf-advice-box');

    var hasModem = rf && rf.has_modem !== false && rf.status !== 'no_device' && rf.status !== 'error';
    var sc = (rf && rf.score !== undefined && rf.score !== null) ? parseInt(rf.score) : 0;
    if (isNaN(sc)) sc = 0;

    if (!hasModem || sc === 0) {
        if (elScore) {
            elScore.textContent = '🎯 Điểm: 0/100 (Chưa có thiết bị / Mất sóng)';
            elScore.style.background = '#f1f5f9';
            elScore.style.color = '#64748b';
            elScore.style.borderColor = '#cbd5e1';
        }
        if (el5G) {
            el5G.textContent = '⚡ 5G NR: Không có thiết bị';
            el5G.style.background = '#f1f5f9';
            el5G.style.color = '#64748b';
            el5G.style.borderColor = '#cbd5e1';
        }
        if (elLTE) {
            elLTE.textContent = '📶 LTE: Không có thiết bị';
            elLTE.style.background = '#f1f5f9';
            elLTE.style.color = '#64748b';
            elLTE.style.borderColor = '#cbd5e1';
        }
        if (elAdv) {
            elAdv.textContent = '💡 ' + ((rf && rf.advice) ? rf.advice : 'Chưa phát hiện module WWAN 5G hoặc chưa kết nối modem mạng di động.');
            elAdv.style.background = '#f8fafc';
            elAdv.style.borderLeftColor = '#94a3b8';
            elAdv.style.color = '#475569';
        }
        return;
    }

    if (elScore) {
        elScore.textContent = '🎯 Điểm: ' + sc + '/100 (' + (rf.grade || 'Hoàn Hảo') + ')';
        elScore.style.background = sc >= 90 ? '#ecfdf5' : (sc >= 70 ? '#fefce8' : '#fef2f2');
        elScore.style.color = sc >= 90 ? '#047857' : (sc >= 70 ? '#854d0e' : '#b91c1c');
        elScore.style.borderColor = sc >= 90 ? '#a7f3d0' : (sc >= 70 ? '#fef08a' : '#fecaca');
    }
    if (el5G && rf.nr5g) {
        el5G.textContent = '⚡ 5G NR: ' + (rf.nr5g.band || 'n41') + ' (' + (rf.nr5g.bw || '100 MHz') + ') | RSRP: ' + (rf.nr5g.rsrp || '--') + ' | SINR: ' + (rf.nr5g.sinr || '--');
        el5G.style.background = '#eff6ff';
        el5G.style.color = '#1d4ed8';
        el5G.style.borderColor = '#bfdbfe';
    }
    if (elLTE && rf.lte) {
        elLTE.textContent = '📶 LTE Neo: ' + (rf.lte.band || 'B3') + ' | RSRP: ' + (rf.lte.rsrp || '--') + ' | SINR: ' + (rf.lte.sinr || '--');
        elLTE.style.background = '#f8fafc';
        elLTE.style.color = '#475569';
        elLTE.style.borderColor = '#e2e8f0';
    }
    if (elAdv && rf.advice) {
        elAdv.textContent = '💡 ' + rf.advice;
        if (rf.advice.indexOf('📈') !== -1) {
            elAdv.style.background = '#ecfdf5';
            elAdv.style.borderLeftColor = '#10b981';
            elAdv.style.color = '#047857';
        } else if (rf.advice.indexOf('📉') !== -1) {
            elAdv.style.background = '#fef2f2';
            elAdv.style.borderLeftColor = '#ef4444';
            elAdv.style.color = '#b91c1c';
        } else {
            elAdv.style.background = '#f0fdf4';
            elAdv.style.borderLeftColor = '#10b981';
            elAdv.style.color = '#047857';
        }
    }
}

function syncOnTabWake() {
    if (currentActiveTab !== 'main') return;
    Promise.all([
        callFastStats().catch(function() { return null; }),
        callGetWeather().catch(function() { return null; }),
        callGetRFSignal().catch(function() { return null; })
    ]).then(function(results) {
        var f = results[0];
        var w = results[1];
        var rf = results[2];
        if (rf) updateRFSignalBadgeDisplay(rf);

        if (f) {
            window._lastFastStats = f;
            var curModel = f.board_model || f.model || window._savedBoardModel || (boardInfo && boardInfo.model) || (res && res.model) || ((boardInfo && boardInfo.model) || (res && res.model) || 'JDCloud RE-CS-02 (Athena AX6600)');
            if (curModel && curModel !== 'OpenWrt Router') window._savedBoardModel = curModel;
            var elModel = document.getElementById('model-val-span');
            if (elModel) elModel.textContent = curModel;

            var isMtkCur = (f.hw_accel_type === 'mtk_ppe') || 
                           (f.hw_accel_name && f.hw_accel_name.indexOf('MediaTek') !== -1) || 
                           (curModel && (curModel.indexOf('TUF-AX4200') !== -1 || curModel.indexOf('TUF-AX6000') !== -1 || curModel.indexOf('AX6000') !== -1 || curModel.indexOf('Filogic') !== -1 || curModel.indexOf('5GCPE') !== -1 || curModel.indexOf('MediaTek') !== -1 || curModel.indexOf('MT798') !== -1)) ||
                           (f.soc_family && f.soc_family.indexOf('MediaTek') !== -1);
            var elSoc = document.getElementById('soc-badge-span');
            if (elSoc) {
                var socName = f.soc_family || (isMtkCur ? 'MediaTek Filogic 830' : 'Qualcomm IPQ60xx');
                var cNum = f.cpu_cores || 4;
                elSoc.textContent = '⚡ ' + socName + ' (' + cNum + ' Cores, ' + (f.cpu_arch || 'aarch64') + ')';
            }

            updateHwAccelBadge(f, curModel);

            var elUptime = document.getElementById('uptime-badge-span');
            if (elUptime && f.uptime) elUptime.textContent = '⏱️ ' + f.uptime;

            var elClients = document.getElementById('clients-badge-span');
            if (elClients && f.online_clients) elClients.textContent = '📱 ' + f.online_clients + ' Thiết bị Online';

            var elCpu = document.getElementById('cpu-temp-badge');
            if (elCpu) {
                    var cPct = parseInt(f.cpu_pct || 0);
                    var cPStr = (f.cpu_pct !== undefined && f.cpu_pct !== null && f.cpu_pct !== '') ? (f.cpu_pct + ' • ') : '';
                    var cpuTxt = 'CPU: ' + (f.cpu_cores ? ('(' + f.cpu_cores + ' Cores) • ') : '') + cPStr + (f.cpu_temp || '45.0 °C') + ' ⚡';
                    elCpu.textContent = cpuTxt;
                    elCpu.style.background = cPct >= 90 ? '#fef2f2' : (cPct >= 70 ? '#fefce8' : '#f0fdf4');
                    elCpu.style.borderColor = cPct >= 90 ? '#fca5a5' : (cPct >= 70 ? '#fef08a' : '#86efac');
                    elCpu.style.color = cPct >= 90 ? '#991b1b' : (cPct >= 70 ? '#854d0e' : '#166534');
                }

            var elWifi = document.getElementById('wifi-temp-badge');
            if (elWifi && f.wifi_temp) elWifi.textContent = 'Wi-Fi: ' + f.wifi_temp + ' 📶';

            var elData = document.getElementById('data-used-cell');
            if (elData && f.data_used) elData.textContent = f.data_used;

            var p = parseInt(f.ram_pct || '0');
            var fill = document.getElementById('ram-bar-fill');
            var txt = document.getElementById('ram-text-val');
            var dot = document.getElementById('ram-dot-val');
            if (fill && txt && dot) {
                fill.style.width = p + '%';
                fill.style.background = p >= 85 ? '#ef4444' : (p >= 60 ? '#f59e0b' : '#3b82f6');
                txt.textContent = (f.ram_used_mb || '0') + ' MB / ' + (f.ram_total_mb || '0') + ' MB (' + p + '%)';
                dot.textContent = p >= 85 ? '🔴' : (p >= 60 ? '🟡' : '🟢');
            }

            updateRamBadge(f);
        }

        if (w) {
            var elLoc = document.getElementById('loc-label-span');
            if (elLoc && w.location) elLoc.textContent = w.location;
            var elLunar = document.getElementById('lunar-val-cell');
            if (elLunar && w.lunar) elLunar.textContent = w.lunar;
        }

        var elUpd = document.getElementById('weather-updated-text');
        if (elUpd) elUpd.textContent = '🕒 Cập nhật: ' + getFormattedLiveTime();

        updateCombinedWwanUI(f, w);
    }).catch(function() {});
}

document.addEventListener('visibilitychange', function() {
    if (document.hidden) {
        isTabFocused = false;
        try { poll.stop(); } catch(e) {}
    } else {
        isTabFocused = true;
        if (currentActiveTab === 'main') {
            try { poll.start(); } catch(e) {}
            syncOnTabWake();
        }
    }
});

window.addEventListener('focus', function() {
    if (!isTabFocused) {
        isTabFocused = true;
        if (currentActiveTab === 'main') {
            try { poll.start(); } catch(e) {}
            syncOnTabWake();
        }
    }
});

window.addEventListener('blur', function() {
    isTabFocused = false;
    try { poll.stop(); } catch(e) {}
});

function parseAndRenderSMS(rawText) {
    try {
        if (!rawText || typeof rawText !== 'string' || rawText.indexOf('MSG:') === -1) {
            return [ E('div', { style: 'padding: 24px; text-align: center; color: #000000; font-size: 14px; background: #ffffff; border-radius: 10px; border: 1px dashed #cbd5e1;' }, '📭 Hộp thư trống hoặc chưa có tin nhắn mới.') ];
        }
        var lines = rawText.split('\n'), rawMessages = [], curMsg = null, curStorage = 'Router (ME)';
        for (var i = 0; i < lines.length; i++) {
            var line = lines[i], trimmed = line.trim();
            if (/\[.*(SIM|\(SM\)).*\]/i.test(trimmed)) { curStorage = 'Thẻ SIM (SM)'; continue; }
            else if (/\[.*(ROUTER|MODEM|\(ME\)|\(MT\)).*\]/i.test(trimmed)) { curStorage = 'Router (ME)'; continue; }

            if (trimmed.match(/^MSG:\s*[0-9]+/i)) {
                if (curMsg) rawMessages.push(curMsg);
                curMsg = { 
                    id: trimmed.replace(/^MSG:\s*/i, '').trim(), 
                    storage: curStorage, 
                    from: 'Không xác định', 
                    datetime: '', 
                    refNum: '', 
                    segIndex: 1, 
                    segTotal: 1, 
                    contentLines: [] 
                };
                continue;
            }
            if (!curMsg) continue;
            if (trimmed.match(/^From:\s*/i)) curMsg.from = trimmed.replace(/^From:\s*/i, '').trim();
            else if (trimmed.match(/^Date\/Time:\s*/i)) curMsg.datetime = trimmed.replace(/^Date\/Time:\s*/i, '').trim();
            else if (trimmed.match(/^Reference number:\s*/i)) curMsg.refNum = trimmed.replace(/^Reference number:\s*/i, '').trim();
            else if (trimmed.match(/^SMS segment\s*[0-9]+/i)) {
                var segMatch = trimmed.match(/^SMS segment\s*([0-9]+)(?:\s*(?:of|\/)\s*([0-9]+))?/i);
                if (segMatch) { 
                    curMsg.segIndex = parseInt(segMatch[1]); 
                    curMsg.segTotal = segMatch[2] ? parseInt(segMatch[2]) : 3; 
                }
            } else { curMsg.contentLines.push(line); }
        }
        if (curMsg) rawMessages.push(curMsg);

        // Grouping & Merging Multipart SMS
        var mergedMap = {}, standaloneList = [];
        rawMessages.forEach(function(m) {
            m.body = m.contentLines.join(' ')
                .replace(/^SMS segment\s*[0-9]*\s*(?:of\s*[0-9]+)?/i, '')
                .replace(/(\w+)-\s+(\w+)/g, '$1$2')
                .replace(/\s+/g, ' ')
                .trim();

            var ts = 0;
            if (m.datetime) {
                var dtParts = m.datetime.replace(/,/g, ' ').split(/\s+/);
                if (dtParts.length >= 2) {
                    var dParts = dtParts[0].split(/[\/\-]/);
                    var tParts = dtParts[1].split(':');
                    if (dParts.length === 3 && tParts.length >= 2) {
                        var yr = parseInt(dParts[2]) > 50 ? 1900 + parseInt(dParts[2]) : 2000 + parseInt(dParts[2]);
                        var mo = parseInt(dParts[0]) - 1;
                        var da = parseInt(dParts[1]);
                        var hr = parseInt(tParts[0]);
                        var mi = parseInt(tParts[1]);
                        var sc = parseInt(tParts[2] || 0);
                        ts = new Date(yr, mo, da, hr, mi, sc).getTime();
                    }
                }
            }
            if (!ts) ts = parseInt(m.id) || 0;
            m.ts = ts;

            var key = '';
            if (m.refNum) {
                key = m.from + '_' + m.refNum;
            } else if (m.segTotal > 1) {
                key = m.from + '_tot' + m.segTotal;
            }

            if (key) {
                if (!mergedMap[key]) {
                    mergedMap[key] = { from: m.from, storage: m.storage, datetime: m.datetime, ts: m.ts, parts: {}, rawIds: [] };
                }
                if (m.body && !/^SMS segment\s*[0-9]*$/i.test(m.body)) {
                    mergedMap[key].parts[m.segIndex] = m.body;
                }
                mergedMap[key].rawIds.push(m.id);
                if (m.ts > mergedMap[key].ts) {
                    mergedMap[key].ts = m.ts;
                    mergedMap[key].datetime = m.datetime;
                }
            } else if (m.body && !/^SMS segment\s*[0-9]*$/i.test(m.body)) {
                standaloneList.push({ from: m.from, storage: m.storage, datetime: m.datetime, ts: m.ts, rawIds: [m.id], fullBody: m.body });
            }
        });

        var allMerged = [];
        Object.keys(mergedMap).forEach(function(k) {
            var item = mergedMap[k], joinedBody = "";
            var sortedIndexes = Object.keys(item.parts).sort(function(a, b) { return a - b; });
            sortedIndexes.forEach(function(idx) {
                var part = (item.parts[idx] || '').trim();
                if (!part) return;
                if (joinedBody.length > 0) {
                    joinedBody += " " + part;
                } else {
                    joinedBody = part;
                }
            });
            if (joinedBody.trim() && !/^SMS segment\s*[0-9]*$/i.test(joinedBody.trim())) {
                allMerged.push({ from: item.from, storage: item.storage, datetime: item.datetime, ts: item.ts, rawIds: item.rawIds, fullBody: joinedBody.trim() });
            }
        });

        var combined = allMerged.concat(standaloneList);
        combined.sort(function(a, b) { return (b.ts || 0) - (a.ts || 0); });

        var finalMessages = [];
        var seenBodies = {};
        for (var j = 0; j < combined.length; j++) {
            var cur = combined[j];
            if (!cur.fullBody || cur.fullBody === 'SMS segment 1' || /^SMS segment\s*[0-9]+$/i.test(cur.fullBody.trim())) continue;
            
            var sig = cur.from + '_' + cur.fullBody.substring(0, 35);
            if (!seenBodies[sig]) {
                seenBodies[sig] = true;
                finalMessages.push(cur);
            }
        }

        if (finalMessages.length === 0) {
            return [ E('div', { style: 'padding: 24px; text-align: center; color: #000000; font-size: 14px; background: #ffffff; border-radius: 10px; border: 1px dashed #cbd5e1;' }, '📭 Hộp thư trống hoặc chưa có tin nhắn mới.') ];
        }

        var cards = [];
        finalMessages.forEach(function(m) {
            var isSim = (m.storage && m.storage.indexOf('SIM') !== -1);
            var storageBadge = isSim 
                ? E('span', { style: 'background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 750; white-space: nowrap;' }, '📱 ' + m.storage)
                : E('span', { style: 'background: #fef3c7; color: #b45309; border: 1px solid #fde68a; padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 750; white-space: nowrap;' }, '💾 ' + m.storage);

            var displayBody = (m.fullBody || '').trim();
            var isDataInfo = /luu luong|data|dung luong|\d+MB|\d+GB|kttk|5g480b|3t5g150/i.test(displayBody);

            var leftChildren = [
                E('span', { style: 'font-weight: 800; font-size: 13.5px; color: #000000; white-space: nowrap;' }, (isDataInfo ? '📶 ' : '👤 ') + m.from),
                storageBadge
            ];
            if (isDataInfo) {
                leftChildren.push(E('span', { style: 'background: #dcfce7; color: #15803d; border: 1px solid #86efac; padding: 2px 7px; border-radius: 10px; font-size: 11px; font-weight: 800; white-space: nowrap;' }, '⚡ Data'));
            }

            var row = E('div', { 
                style: 'display: flex; align-items: center; justify-content: space-between; gap: 10px; background: #ffffff; border: 1px solid ' + (isDataInfo ? '#86efac' : '#e2e8f0') + '; border-radius: 8px; padding: 10px 14px; margin-bottom: 6px; box-shadow: 0 1px 2px rgba(0,0,0,0.03); width: 100%; box-sizing: border-box; flex-wrap: wrap;' 
            }, [
                E('div', { style: 'display: flex; align-items: center; gap: 6px; flex: 0 0 auto;' }, leftChildren),
                E('div', { 
                    style: 'flex: 1 1 280px; font-size: 13px; line-height: 1.5; color: #000000; font-weight: ' + (isDataInfo ? '700' : '500') + '; padding: 2px 8px; word-break: break-word;',
                    title: displayBody
                }, displayBody || '(Trống)'),
                E('div', { style: 'display: flex; align-items: center; gap: 8px; flex: 0 0 auto;' }, [
                    E('span', { style: 'font-size: 12px; color: #000000; font-weight: 600; white-space: nowrap;' }, '⏰ ' + (m.datetime || '--')),
                    E('button', { 
                        class: 'btn cbi-button cbi-button-remove', 
                        style: 'padding: 3px 10px; font-size: 11.5px; font-weight: 700; border-radius: 6px; white-space: nowrap;', 
                        click: function(ev) {
                            ev.stopPropagation();
                            if (!confirm("Xóa tin nhắn này?")) return;
                            callDeleteSingleSMS(m.rawIds.join(','), m.storage).then(function() {
                                var box = document.getElementById('sms-card-container');
                                if (box) callFetchSMS().then(function(rep) { box.innerHTML = ''; parseAndRenderSMS(rep.inbox || '').forEach(function(n) { box.appendChild(n); }); });
                            });
                        } 
                    }, '🗑️ Xóa')
                ])
            ]);
            cards.push(row);
        });
        return cards;
    } catch(err) {
        console.error('parseAndRenderSMS error:', err);
        return [ E('div', { style: 'padding: 16px; text-align: center; color: #b91c1c; font-weight: 700; background: #fef2f2; border-radius: 8px; border: 1px solid #fecaca;' }, '⚠️ Không thể hiển thị tin nhắn: ' + (err.message || err)) ];
    }
}

function createCustomTimeInput(initTimeStr, labelText) {
    var val = initTimeStr || '00:00';
    var inputEl = E('input', {
        type: 'text',
        class: 'cbi-input-text',
        value: val,
        placeholder: 'HH:MM',
        style: 'width: 65px; padding: 4px 6px; font-weight: 800; font-size: 13px; font-family: monospace; text-align: center; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 6px; color: #000000;'
    });

    var box = E('div', { 
        style: 'display: inline-flex; align-items: center; gap: 4px; background: #ffffff; padding: 3px 6px; border: 1px solid #e2e8f0; border-radius: 8px;' 
    }, [
        E('span', { style: 'font-size: 11px; font-weight: 800; color: #000000; margin-right: 2px;' }, labelText || ''),
        inputEl
    ]);

    box.getValue = function() {
        var v = inputEl.value.trim();
        if (!v) return '00:00';
        if (v.indexOf(':') !== -1) {
            var parts = v.split(':');
            var h = parseInt(parts[0] || '0');
            var m = parseInt(parts[1] || '0');
            return (h < 10 ? '0' : '') + h + ':' + (m < 10 ? '0' : '') + m;
        }
        return v;
    };
    box.setValue = function(newVal) {
        inputEl.value = newVal || '00:00';
    };
    return box;
}

function checkTimeInRange(st, et) {
    var now = new Date();
    var cur = now.getHours() * 60 + now.getMinutes();
    var sp = st.split(':'), ep = et.split(':');
    var s = parseInt(sp[0] || 0) * 60 + parseInt(sp[1] || 0);
    var e = parseInt(ep[0] || 0) * 60 + parseInt(ep[1] || 0);
    if (s <= e) {
        return cur >= s && cur <= e;
    } else {
        return cur >= s || cur <= e;
    }
}

function updateWifiDisplay(w) {
    if (!w || !w.list || !Array.isArray(w.list)) return;
    window._lastWifiData = w;
    if (typeof window._wifiInputsRef === 'undefined') return;
    if (!isUserInteracting) {
        w.list.forEach(function(item) {
            Object.keys(window._wifiInputsRef).forEach(function(k) {
                var obj = window._wifiInputsRef[k];
                if (obj.band === item.band) {
                    if (item.ssid) obj.sInput.value = item.ssid;
                    if (item.key) obj.pInput.value = item.key;
                    if (item.htmode) obj.wSelect.value = item.htmode;
                }
            });
        });
    }
}

function updateCellDisplay(c) {
    if (!c) return;
    window._lastCellData = c;
    var isLocked = (c.is_cell_locked == 1);
    var lteRsrpNum = parseInt(c.lte_rsrp || '-85');
    var nrSinrNum = parseFloat(c.nr_sinr || '20');
    var isLockSupported = (c.supports_cell_lock !== false && c.supports_cell_lock !== 0 && c.supports_cell_lock !== 'false');

    var elBadge = document.getElementById('cell-lock-badge');
    if (elBadge) {
        if (!isLockSupported) {
            elBadge.style.background = '#f1f5f9';
            elBadge.style.color = '#0369a1';
            elBadge.style.borderColor = '#bae6fd';
            elBadge.textContent = 'ℹ️ Dò Tự Do (Không hỗ trợ Khóa PCI)';
        } else if (isLocked) {
            elBadge.style.background = '#ecfdf5';
            elBadge.style.color = '#047857';
            elBadge.style.borderColor = '#a7f3d0';
            elBadge.textContent = '🔒 ĐANG KHÓA CỐ ĐỊNH TRẠM';
        } else {
            elBadge.style.background = '#f1f5f9';
            elBadge.style.color = '#475569';
            elBadge.style.borderColor = '#cbd5e1';
            elBadge.textContent = '🔓 Đang Tự Do Dò Trạm';
        }
    }

    var elLte = document.getElementById('cell-lte-info');
    if (elLte) elLte.textContent = 'B' + (c.lte_band || '3') + ' (EARFCN: ' + (c.lte_earfcn || '--') + ', PCI: ' + (c.lte_pci || '--') + ', Cell ID: ' + (c.lte_cellid || '--') + ')';

    var elLteRsrp = document.getElementById('cell-lte-rsrp');
    if (elLteRsrp) elLteRsrp.textContent = 'RSRP: ' + (c.lte_rsrp || '--') + ' dBm' + (c.lte_sinr && c.lte_sinr !== '--' ? ' | SINR: ' + c.lte_sinr + ' dB' : '');

    var carrierDesc = 'Viettel';
    var carrierRaw = (c.carrier_name || '').toLowerCase();
    if (carrierRaw.indexOf('vina') !== -1) carrierDesc = 'VinaPhone';
    else if (carrierRaw.indexOf('mobi') !== -1) carrierDesc = 'MobiFone';
    else if (carrierRaw.indexOf('vietnamobile') !== -1) carrierDesc = 'Vietnamobile';

    var nrBandDesc = '';
    var nrB = (c.nr_band || '41').toString().replace(/^n/i, '');
    if (nrB === '41') {
        nrBandDesc = 'n41 (Băng tần Vàng Viettel 2500MHz)';
    } else if (nrB === '78') {
        nrBandDesc = 'n78 (Băng tần 5G VinaPhone 3700MHz)';
    } else if (nrB === '77') {
        nrBandDesc = 'n77 (Băng tần 5G MobiFone 3800MHz)';
    } else {
        nrBandDesc = 'n' + nrB + ' (' + carrierDesc + ' 5G NR)';
    }

    var elNr = document.getElementById('cell-nr-info');
    if (elNr) elNr.textContent = nrBandDesc + ' (ARFCN: ' + (c.nr_arfcn || '--') + ', PCI: ' + (c.nr_pci || '--') + ')';

    var elNrRsrp = document.getElementById('cell-nr-rsrp');
    if (elNrRsrp) elNrRsrp.textContent = 'RSRP: ' + (c.nr_rsrp || '--') + ' dBm | SINR: ' + (c.nr_sinr || '--') + ' dB';

    var elLockActions = document.getElementById('cell-lock-actions-row');
    var elNoLockNotice = document.getElementById('cell-no-lock-notice');
    if (elLockActions && elNoLockNotice) {
        if (!isLockSupported) {
            elLockActions.style.display = 'none';
            elNoLockNotice.style.display = 'block';
        } else {
            elLockActions.style.display = 'flex';
            elNoLockNotice.style.display = 'none';
        }
    }

    var elAdviceBox = document.getElementById('cell-advice-box');
    var elAdviceBadge = document.getElementById('cell-advice-badge');
    var elAdviceText = document.getElementById('cell-advice-text');

    if (elAdviceBox && elAdviceBadge && elAdviceText) {
        if (!isLockSupported) {
            elAdviceBox.style.background = '#f0fdf4';
            elAdviceBox.style.borderColor = '#86efac';
            elAdviceBadge.style.background = '#dcfce7';
            elAdviceBadge.style.color = '#15803d';
            elAdviceBadge.textContent = '🟢 KHUYẾN NGHỊ: DÙNG KHÓA BĂNG TẦN (TỐI ƯU TUYỆT ĐỐI CHO MODEM NÀY)';
            elAdviceText.style.color = '#166534';
            elAdviceText.textContent = 'Card modem WWAN đang sử dụng không hỗ trợ can thiệp trực tiếp phần cứng vào mã trạm PCI BTS. Đây là cơ chế bảo vệ của dòng modem này. Bạn chỉ cần chọn Khóa Băng Tần (B3+n41) ở mục Quản Lý Sóng là tốc độ tối đa và modem tự động bắt trạm khỏe nhất, tuyệt đối không bị mất mạng!';
        } else if (isLocked) {
            elAdviceBox.style.background = '#f0fdf4';
            elAdviceBox.style.borderColor = '#86efac';
            elAdviceBadge.style.background = '#dcfce7';
            elAdviceBadge.style.color = '#15803d';
            elAdviceBadge.textContent = '🎯 TRẠNG THÁI: ĐÃ KHÓA CỐ ĐỊNH TRẠM (PCI ' + (c.lte_pci || '--') + ')';
            elAdviceText.style.color = '#166534';
            elAdviceText.textContent = 'Router đã ghim cố định vào trạm BTS này, modem sẽ không bao giờ đổi trạm. Lưu ý: Nếu một ngày trạm BTS này bảo trì hoặc mất điện thì router sẽ mất mạng tạm thời. Khi đó bạn chỉ cần bấm nút [🔓 Mở Khóa Trạm (Tự Do)] bên dưới là xong.';
        } else if (nrSinrNum >= 12 && lteRsrpNum >= -92) {
            elAdviceBox.style.background = '#f0fdf4';
            elAdviceBox.style.borderColor = '#86efac';
            elAdviceBadge.style.background = '#dcfce7';
            elAdviceBadge.style.color = '#15803d';
            elAdviceBadge.textContent = '🟢 KHUYẾN NGHỊ: CHỈ CẦN KHÓA BĂNG TẦN (KHÔNG CẦN KHÓA CELL)';
            elAdviceText.style.color = '#166534';
            elAdviceText.textContent = 'Trạm hiện tại (PCI 4G: ' + (c.lte_pci || '27') + ' / PCI 5G: ' + (c.nr_pci || '603') + ') sóng cực mạnh (' + (c.lte_rsrp || '-83') + ' dBm) và rất sạch nhiễu (SINR ' + (c.nr_sinr || '24') + ' dB). Sóng đang ở trạng thái tối ưu 100%. Bạn KHÔNG CẦN KHÓA CELL! Chỉ cần Khóa Băng Tần (B3+n41) là tối ưu nhất. Không khóa cell giúp router tự động chuyển trạm dự phòng nếu trạm chính mất điện hoặc bảo trì!';
        } else {
            elAdviceBox.style.background = '#fffbeb';
            elAdviceBox.style.borderColor = '#fde68a';
            elAdviceBadge.style.background = '#fef3c7';
            elAdviceBadge.style.color = '#b45309';
            elAdviceBadge.textContent = '⚠️ KHUYẾN NGHỊ: NÊN KHÓA CỐ ĐỊNH TRẠM NÀY ĐỂ ỔN ĐỊNH';
            elAdviceText.style.color = '#92400e';
            elAdviceText.textContent = 'Tín hiệu có dấu hiệu nhiễu chéo từ các trạm xung quanh (SINR thấp) hoặc router nằm ở vùng giao thoa trạm. Bạn nên bấm [🔒 Khóa Cố Định Trạm Này] để ép modem gắn chặt vào trạm mạnh nhất, triệt tiêu hiện tượng nhảy trạm (ping-pong handover) làm rớt ping khi chơi game.';
        }
    }

    var elLockedDet = document.getElementById('cell-locked-detail');
    if (elLockedDet) {
        if (isLocked && c.locked_details) {
            elLockedDet.style.display = 'block';
            elLockedDet.textContent = '🎯 Chi tiết trạm khóa: ' + c.locked_details;
        } else {
            elLockedDet.style.display = 'none';
        }
    }
}

return baseclass.extend({
    title: _('Thời Tiết & Quản Lý Mạng'),

    load: function() {
        // TỐI ƯU HÓA INSTANT FIRST PAINT (<0.1s):
        // Nạp song song từ RAM (tmpfs) với Timeout Guard 1200ms -> KHÔNG BAO GIỜ TREO HAY XOAY CHẬM!
        function rpcFast(p, fb) {
            return Promise.race([
                p,
                new Promise(function(res) { setTimeout(function() { res(fb); }, 1200); })
            ]).catch(function() { return fb; });
        }

        return Promise.all([
            rpcFast(callGetWeather(), window._lastWeatherData || {}),
            rpcFast(callFastStats(), window._lastFastStats || {}),
            rpcFast(rpc.declare({ object: 'system', method: 'board' })(), {}),
            rpcFast(callSMSInfo(), window._lastSMSInfo || {}),
            rpcFast(callGetWifi(), window._lastWifiData || { list: [] }),
            rpcFast(callGetCellInfo(), window._lastCellData || {}),
            rpcFast(callGetAdShield(), window._lastAdShieldData || { active: 1, rules: 96, family: 1 }),
            rpcFast(callGetGameLatency(), window._lastGameLatency || {}),
            rpcFast(callGetRFSignal(), window._lastRFSignal || {})
        ]).then(function(results) {
            var weatherData = results[0] || {};
            var fastStats = results[1] || {};
            var boardInfo = results[2] || {};
            var smsInfo = results[3] || window._lastSMSInfo || {};
            var wifiData = results[4] || window._lastWifiData || { list: [] };
            var cellData = results[5] || window._lastCellData || {};
            var adshieldData = results[6] || window._lastAdShieldData || { active: 1, rules: 96, family: 1 };
            var gameLatencyData = results[7] || window._lastGameLatency || {};
            var rfSignal = results[8] || window._lastRFSignal || {};

            window._lastWeatherData = weatherData;
            window._lastFastStats = fastStats;
            window._lastSMSInfo = smsInfo;
            window._lastRFSignal = rfSignal;
            window._lastCellData = cellData;
            window._lastAdShieldData = adshieldData;
            window._lastGameLatency = gameLatencyData;
            if (wifiData && wifiData.list && wifiData.list.length > 0) {
                window._lastWifiData = wifiData;
            }

            return [
                weatherData,
                fastStats,
                boardInfo,
                smsInfo,
                wifiData,
                { ip: (window.location.hostname || '192.168.1.1') },
                cellData,
                rfSignal,
                adshieldData,
                gameLatencyData
            ];
        });
    },
