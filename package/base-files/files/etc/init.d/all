        var curLanIP = lanInfo.ip || window.location.hostname || '192.168.1.1';
        var lanIpInput = E('input', {
            type: 'text',
            class: 'cbi-input-text',
            value: curLanIP,
            placeholder: curLanIP,
            style: 'width: 140px; font-weight: 700; padding: 5px 8px; text-align: center;'
