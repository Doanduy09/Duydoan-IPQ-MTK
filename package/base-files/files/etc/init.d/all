    cat << 'CF_AUTOPROV_EOF' > /usr/bin/cf_tunnel_autoprovision.sh
#!/bin/sh
# /usr/bin/cf_tunnel_autoprovision.sh
# Cloudflare Zero Trust Tunnel 1-Click Auto Provisioning Script
# Automates: Auth -> Account/Zone Lookup -> Tunnel Lookup/Create -> Token Fetch -> Ingress Route -> DNS CNAME -> Router UCI & Daemon Restart

set -e

DOMAIN=$(echo "$1" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]' | sed -e 's|^https*://||' -e 's|/.*$||' -e 's|:.*$||')
API_KEY=$(echo "$2" | tr -d '[:space:]')
EMAIL=$(echo "$3" | tr -d '[:space:]')
LOCAL_SVC="${4:-http://192.168.1.1:8080}"
TUNNEL_NAME="${5:-jdc-router-nas}"

if [ -z "$DOMAIN" ] || [ -z "$API_KEY" ]; then
    echo '{"status":"error","message":"Thieu thong tin: Vui long nhap Ten mien va API Key/Token!"}'
    exit 1
fi

# Set up Cloudflare API curl helper
if [ -n "$EMAIL" ] && echo "$EMAIL" | grep -q "@"; then
    AUTH_H1="X-Auth-Email: $EMAIL"
    AUTH_H2="X-Auth-Key: $API_KEY"
    cf_curl() {
        curl -s -m 25 -H "$AUTH_H1" -H "$AUTH_H2" -H "Content-Type: application/json" "$@"
    }
else
    AUTH_H1="Authorization: Bearer $API_KEY"
    cf_curl() {
        curl -s -m 25 -H "$AUTH_H1" -H "Content-Type: application/json" "$@"
    }
fi

# 1. Fetch zones to verify auth & find matching zone
ZONES_RES=$(cf_curl "https://api.cloudflare.com/client/v4/zones?per_page=50")
SUCCESS=$(echo "$ZONES_RES" | jq -r '.success // false' 2>/dev/null)

if [ "$SUCCESS" != "true" ]; then
    ERR_MSG=$(echo "$ZONES_RES" | jq -r '.errors[0].message // "Xac thuc Cloudflare that bai! Vui long kiem tra lai Email va API Key/Token."' 2>/dev/null)
    echo "{\"status\":\"error\",\"message\":\"Cloudflare API Error: $ERR_MSG\"}"
    exit 1
fi

# Match zone name that is suffix of DOMAIN
MATCHED_ZONE=$(echo "$ZONES_RES" | jq -c --arg dom "$DOMAIN" '
  [.result[] | select($dom == .name or ($dom | endswith("." + .name)))] | first // empty' 2>/dev/null)

if [ -z "$MATCHED_ZONE" ] || [ "$MATCHED_ZONE" = "null" ]; then
    echo "{\"status\":\"error\",\"message\":\"Khong tim thay ten mien $DOMAIN trong danh sach Zone cua tai khoan Cloudflare nay!\"}"
    exit 1
fi

ZONE_ID=$(echo "$MATCHED_ZONE" | jq -r '.id')
ZONE_NAME=$(echo "$MATCHED_ZONE" | jq -r '.name')
ACCOUNT_ID=$(echo "$MATCHED_ZONE" | jq -r '.account.id // empty')

if [ -z "$ACCOUNT_ID" ] || [ "$ACCOUNT_ID" = "null" ]; then
    ACCS_RES=$(cf_curl "https://api.cloudflare.com/client/v4/accounts?per_page=10")
    ACCOUNT_ID=$(echo "$ACCS_RES" | jq -r '.result[0].id // empty' 2>/dev/null)
fi

if [ -z "$ACCOUNT_ID" ] || [ "$ACCOUNT_ID" = "null" ]; then
    echo '{"status":"error","message":"Khong xac dinh duoc Cloudflare Account ID!"}'
    exit 1
fi

# 2. Check if a tunnel exists or create one
TUNNELS_RES=$(cf_curl "https://api.cloudflare.com/client/v4/accounts/${ACCOUNT_ID}/cfd_tunnel?is_deleted=false")

# Priority 2A: Check if router already has an existing token matching a tunnel
TUNNEL_ID=""
EXISTING_TOKEN=$(uci -q get nas_phone.settings.cf_token)
if [ -n "$EXISTING_TOKEN" ]; then
    PREV_TID=$(echo "$EXISTING_TOKEN" | base64 -d 2>/dev/null | jq -r '.t // empty' 2>/dev/null || true)
    if [ -n "$PREV_TID" ]; then
        MATCH_PREV=$(echo "$TUNNELS_RES" | jq -r --arg tid "$PREV_TID" '(.result[] | select(.id == $tid) | .id) // empty' 2>/dev/null)
        if [ -n "$MATCH_PREV" ]; then
            TUNNEL_ID="$PREV_TID"
            TUNNEL_NAME=$(echo "$TUNNELS_RES" | jq -r --arg tid "$PREV_TID" '(.result[] | select(.id == $tid) | .name) // empty' 2>/dev/null)
        fi
    fi
fi

# Priority 2B: Match by tunnel name
if [ -z "$TUNNEL_ID" ]; then
    TUNNEL_ID=$(echo "$TUNNELS_RES" | jq -r --arg name "$TUNNEL_NAME" '
      (.result[] | select(.name == $name) | .id) // empty' 2>/dev/null | head -n 1)
fi

# Priority 2C: Reuse any active tunnel in account
if [ -z "$TUNNEL_ID" ]; then
    TUNNEL_ID=$(echo "$TUNNELS_RES" | jq -r '.result[0].id // empty' 2>/dev/null)
    ACTUAL_NAME=$(echo "$TUNNELS_RES" | jq -r '.result[0].name // empty' 2>/dev/null)
    if [ -n "$ACTUAL_NAME" ] && [ "$ACTUAL_NAME" != "null" ]; then
        TUNNEL_NAME="$ACTUAL_NAME"
    fi
fi

# Priority 2D: Create new tunnel if none exists
if [ -z "$TUNNEL_ID" ] || [ "$TUNNEL_ID" = "null" ]; then
    TUNNEL_SECRET=$(head -c 32 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c 32)
    CREATE_PAYLOAD=$(jq -n --arg name "$TUNNEL_NAME" --arg sec "$TUNNEL_SECRET" \
      '{"name":$name, "tunnel_secret":$sec, "config_src":"cloudflare"}')
    CREATE_RES=$(cf_curl -X POST "https://api.cloudflare.com/client/v4/accounts/${ACCOUNT_ID}/cfd_tunnel" -d "$CREATE_PAYLOAD")
    TUNNEL_ID=$(echo "$CREATE_RES" | jq -r '.result.id // empty' 2>/dev/null)
fi

if [ -z "$TUNNEL_ID" ] || [ "$TUNNEL_ID" = "null" ]; then
    echo '{"status":"error","message":"Khong the tao hoac tim thay Cloudflare Tunnel!"}'
    exit 1
fi

# 3. Fetch Tunnel Token
TOKEN_RES=$(cf_curl "https://api.cloudflare.com/client/v4/accounts/${ACCOUNT_ID}/cfd_tunnel/${TUNNEL_ID}/token")
TUNNEL_TOKEN=$(echo "$TOKEN_RES" | jq -r '.result // empty' 2>/dev/null)

if [ -z "$TUNNEL_TOKEN" ] || [ "$TUNNEL_TOKEN" = "null" ]; then
    echo '{"status":"error","message":"Khong the lay Tunnel Token tu Cloudflare!"}'
    exit 1
fi

# 4. Configure Tunnel Ingress (Routes)
CUR_CFG=$(cf_curl "https://api.cloudflare.com/client/v4/accounts/${ACCOUNT_ID}/cfd_tunnel/${TUNNEL_ID}/configurations")
INGRESS_JSON=$(echo "$CUR_CFG" | jq --arg host "$DOMAIN" --arg svc "$LOCAL_SVC" '
  def other_rules: (.result.config.ingress // []) | map(select(.hostname and .hostname != $host and .service != "http_status:404"));
  {
    "config": {
      "ingress": (
        [{"hostname": $host, "service": $svc}] +
        other_rules +
        [{"service": "http_status:404"}]
      )
    }
  }' 2>/dev/null)

if [ -z "$INGRESS_JSON" ] || [ "$INGRESS_JSON" = "null" ]; then
    INGRESS_JSON=$(jq -n --arg host "$DOMAIN" --arg svc "$LOCAL_SVC" '{
      "config": {
        "ingress": [
          {"hostname": $host, "service": $svc},
          {"service": "http_status:404"}
        ]
      }
    }')
fi

PUT_CFG_RES=$(cf_curl -X PUT "https://api.cloudflare.com/client/v4/accounts/${ACCOUNT_ID}/cfd_tunnel/${TUNNEL_ID}/configurations" -d "$INGRESS_JSON")

# 5. Create or Update DNS CNAME Record
CNAME_TARGET="${TUNNEL_ID}.cfargotunnel.com"
DNS_CHECK=$(cf_curl "https://api.cloudflare.com/client/v4/zones/${ZONE_ID}/dns_records?name=${DOMAIN}")
RECORD_ID=$(echo "$DNS_CHECK" | jq -r '.result[0].id // empty' 2>/dev/null)

DNS_PAYLOAD=$(jq -n --arg name "$DOMAIN" --arg target "$CNAME_TARGET" \
  '{"type":"CNAME","name":$name,"content":$target,"proxied":true,"ttl":1}')

if [ -n "$RECORD_ID" ] && [ "$RECORD_ID" != "null" ]; then
    DNS_RES=$(cf_curl -X PUT "https://api.cloudflare.com/client/v4/zones/${ZONE_ID}/dns_records/${RECORD_ID}" -d "$DNS_PAYLOAD")
else
    DNS_RES=$(cf_curl -X POST "https://api.cloudflare.com/client/v4/zones/${ZONE_ID}/dns_records" -d "$DNS_PAYLOAD")
fi

# 6. Apply configuration to Router UCI & restart tunnel
uci set nas_phone.settings=settings 2>/dev/null || true
uci set nas_phone.settings.public_domain="$DOMAIN"
uci set nas_phone.settings.cf_token="$TUNNEL_TOKEN"
uci commit nas_phone

mkdir -p /etc/config 2>/dev/null || true
touch /etc/config/nas_tunnel 2>/dev/null || true
uci set nas_tunnel.cf=tunnel 2>/dev/null || true
uci set nas_tunnel.cf.enabled='1'
uci set nas_tunnel.cf.token="$TUNNEL_TOKEN"
uci set nas_tunnel.cf.custom_domain="$DOMAIN"
uci commit nas_tunnel 2>/dev/null || true

/etc/init.d/nas_tunnel restart >/dev/null 2>&1 &

# 7. Return success response
echo "{\"status\":\"success\",\"message\":\"Thiet lap Cloudflare 1-Click hoan tat 100%!\",\"domain\":\"$DOMAIN\",\"public_url\":\"https://$DOMAIN\",\"tunnel_id\":\"$TUNNEL_ID\",\"tunnel_name\":\"$TUNNEL_NAME\"}"
CF_AUTOPROV_EOF
    chmod 755 /usr/bin/cf_tunnel_autoprovision.sh 2>/dev/null
    cat << 'AUTO_MESH_EOF' > /usr/bin/auto_mesh
#!/bin/sh
# ==============================================================================
# SYSFIXTINE 1-CLICK AUTO MESH CONTROLLER & AGENT DAEMON (MAX 2402.0 MBPS)
# Kiến trúc tương thích 100% mọi router OpenWrt (Qualcomm ath11k, MediaTek mt76/filogic, Realtek, x86_64, Rockchip, Broadcom, MIPS)
# Tối ưu hóa: Phản hồi 0ms bằng tmpfs cache, Non-blocking I/O, Không tạo zombie process
# Quy tắc tự động: Có mạng = Router Phát Chính | Không mạng = Router Phụ kết nối Mesh
# ==============================================================================

PAIR_PID_FILE="/tmp/mesh_pairing.pid"
STATUS_FILE="/tmp/mesh_pairing.status"
CACHE_FILE="/tmp/auto_mesh_status.json"
LOCK_FILE="/tmp/auto_mesh.lock"
MESH_CONF="/etc/config/sysfixtine"
DEFAULT_MESH_ID="immorWRT-5G"
DEFAULT_MESH_KEY="TPTlam011205@!"
FALLBACK_MESH_ID="SysMesh_Athena"
FALLBACK_MESH_KEY="SysMeshKey@2026!Sec"
PAIR_PORT=8999
PAIR_TIMEOUT=120

# 1. Phát hiện Card Wi-Fi tốt nhất (Ưu tiên 5GHz/6GHz HE160/HE80, đa kiến trúc)
get_best_mesh_radio() {
    local best_radio=""
    local best_priority=0
    local dev_list=$(uci show wireless 2>/dev/null | grep "=wifi-device" | cut -d'.' -f2 | cut -d'=' -f1)
    for dev in $dev_list; do
        local band=$(uci -q get wireless."$dev".band)
        local htmode=$(uci -q get wireless."$dev".htmode)
        local disabled=$(uci -q get wireless."$dev".disabled)
        [ "$disabled" = "1" ] && continue
        
        local prio=1
        if [ "$band" = "5g" ] || [ "$band" = "6g" ]; then
            prio=2
            echo "$htmode" | grep -qE "80" && prio=3
            echo "$htmode" | grep -qE "160|320" && prio=4
        fi
        if [ "$prio" -gt "$best_priority" ]; then
            best_priority="$prio"
            best_radio="$dev"
        fi
    done
    
    # Dynamic fallback cho moi platform (Qualcomm, MTK, x86, Rockchip, MIPS)
    if [ -z "$best_radio" ]; then
        best_radio=$(echo "$dev_list" | head -n1)
    fi
    [ -z "$best_radio" ] && best_radio="radio0"
    echo "$best_radio"
}

# 2. Kiểm tra kết nối Internet thực tế (Non-blocking, timeout 1s)
check_internet() {
    # 1. Kiểm tra interface wwan/wan có default route trực tiếp
    for ifc in wwan0 wan eth1 usb0; do
        if ip link show "$ifc" 2>/dev/null | grep -qi "state UP\|qmi\|mbim"; then
            if ping -I "$ifc" -c 1 -W 1 8.8.8.8 >/dev/null 2>&1 || ping -I "$ifc" -c 1 -W 1 1.1.1.1 >/dev/null 2>&1; then
                echo "1|Cổng WAN/WWAN Trực Tiếp ($ifc)"
                return 0
            fi
        fi
    done
    if ip route show default 2>/dev/null | grep -qE "wwan|wan|usb|ppp|eth"; then
        if ping -c 1 -W 1 8.8.8.8 >/dev/null 2>&1 || ping -c 1 -W 1 1.1.1.1 >/dev/null 2>&1; then
            echo "1|Cổng WAN/WWAN Trực Tiếp"
            return 0
        fi
    fi
    # 2. Kiểm tra ping qua mạng
    if ping -c 1 -W 1 8.8.8.8 >/dev/null 2>&1 || ping -c 1 -W 1 1.1.1.1 >/dev/null 2>&1; then
        echo "1|Qua Sóng Mesh Wi-Fi 6"
        return 0
    fi
    echo "0|Không Có Mạng Internet"
    return 1
}

# 3. Xác định vai trò Router (Chính, Phụ hay Độc lập - Nhận diện thời gian thực)
get_auto_role() {
    # 3.0 Ưu tiên tuyệt đối: Nếu người dùng đã TẮT MESH hoặc đặt Standalone -> Trả về standalone ngay lập tức!
    local is_en=$(uci -q get sysfixtine.mesh.enabled 2>/dev/null)
    local forced_role=$(uci -q get sysfixtine.mesh.role 2>/dev/null)
    if [ "$is_en" = "0" ] || [ "$forced_role" = "standalone" ]; then
        echo "standalone"
        return 0
    fi

    # 3.1 Kiểm tra giao diện vô tuyến đang hoạt động thực tế
    if [ -n "$(uci -q get wireless.mesh_sta)" ] && [ "$(uci -q get wireless.mesh_sta.disabled)" != "1" ]; then
        echo "node"
        return 0
    fi
    if [ -n "$(uci -q get wireless.mesh_backhaul_ap)" ] && [ "$(uci -q get wireless.mesh_backhaul_ap.disabled)" != "1" ]; then
        echo "controller"
        return 0
    fi

    if [ -n "$forced_role" ]; then
        echo "$forced_role"
        return 0
    fi
    
    # NGUYÊN TẮC AN TOÀN BẤT BIẾN:
    # Router mặc định LUÔN LÀ CONTROLLER (192.168.1.1, DHCP BẬT). Tuyệt đối không tự ý hạ cấp làm Node!
    echo "controller"
}

# 4. Kích hoạt 802.11r/k/v Fast Roaming và tạo sóng Mesh Backhaul riêng
enable_wds_and_roaming() {
    local radio="$1"
    local role="$2"
    local changed=0

    # 4.1 Cấu hình các AP thông thường: GIỮ wds='0' để laptop/điện thoại không bị chặn!
    local iface_list=$(uci show wireless 2>/dev/null | grep "=wifi-iface" | cut -d'.' -f2 | cut -d'=' -f1)
    for iface in $iface_list; do
        [ "$iface" = "mesh_backhaul_ap" ] && continue
        local mode=$(uci -q get wireless."$iface".mode)
        if [ "$mode" = "ap" ]; then
            local dev=$(uci -q get wireless."$iface".device)
            local band=$(uci -q get wireless."$dev".band)
            # Tất cả AP người dùng (TPT Lam, TPT Lam 5G, v.v.) BẮT BUỘC wds='0' để tương thích 100% điện thoại/laptop
            uci set wireless."$iface".wds='0'
            if [ "$band" = "2g" ]; then
                # Băng tần 2.4GHz: Tắt PMF, 802.11r, multicast_to_unicast để tương thích tuyệt đối Camera IPC & IoT
                uci set wireless."$iface".ieee80211w='0'
                uci set wireless."$iface".ieee80211r='0'
                uci -q delete wireless."$iface".mobility_domain
                uci -q delete wireless."$iface".ft_psk_generate_local
                uci -q delete wireless."$iface".pmk_r1_push
                uci set wireless."$iface".ieee80211k='0'
                uci set wireless."$iface".ieee80211v='0'
                uci set wireless."$iface".bss_transition='0'
                uci set wireless."$iface".wnm_sleep_mode='0'
                uci set wireless."$iface".multicast_to_unicast='0'
                uci set wireless."$iface".isolate='0'
            else
                uci set wireless."$iface".ieee80211r='1'
                uci set wireless."$iface".mobility_domain='e4a1'
                uci set wireless."$iface".ft_psk_generate_local='1'
                uci set wireless."$iface".pmk_r1_push='1'
                uci set wireless."$iface".ieee80211k='1'
                uci set wireless."$iface".rrm_neighbor_report='1'
                uci set wireless."$iface".rrm_beacon_report='1'
                uci set wireless."$iface".ieee80211v='1'
                uci set wireless."$iface".bss_transition='1'
                uci set wireless."$iface".wnm_sleep_mode='1'
                uci set wireless."$iface".ieee80211w='1' # PMF Anti-Deauth Shield cho 5GHz
                uci set wireless."$iface".multicast_to_unicast='1'
            fi
            changed=1
        fi
    done

    # 4.2 Nếu là Router Phát Chính (Controller): Tạo riêng đường truyền Mesh Backhaul WDS Kênh 36 (HE160)
    if [ "$role" = "controller" ]; then
        local is_en=$(uci -q get sysfixtine.mesh.enabled 2>/dev/null)
        local forced_role=$(uci -q get sysfixtine.mesh.role 2>/dev/null)
        if [ "$is_en" = "0" ] || [ "$forced_role" = "standalone" ]; then
            return 0
        fi
        if [ -n "$radio" ]; then
            # Khóa cứng Kênh 36 và HE160 (2402 Mbps) chuẩn Wi-Fi 6 tốc độ tối đa
            uci set wireless."$radio".channel='36'
            uci set wireless."$radio".htmode='HE160'
            uci set wireless."$radio".txpower='30'
            uci set wireless."$radio".he_su_beamformer='1'
            uci set wireless."$radio".he_su_beamformee='1'
            uci set wireless."$radio".he_mu_beamformer='1'
            uci set wireless."$radio".he_mu_beamformee='1'
            uci -q delete wireless.mesh_sta

            uci -q delete wireless.mesh_backhaul_ap
            uci set wireless.mesh_backhaul_ap=wifi-iface
            uci set wireless.mesh_backhaul_ap.device="$radio"
            uci set wireless.mesh_backhaul_ap.mode='ap'
            uci set wireless.mesh_backhaul_ap.network='lan'
            uci set wireless.mesh_backhaul_ap.ssid="$DEFAULT_MESH_ID"
            uci set wireless.mesh_backhaul_ap.encryption='psk2'
            uci set wireless.mesh_backhaul_ap.key="$DEFAULT_MESH_KEY"
            uci set wireless.mesh_backhaul_ap.wds='1'
            uci set wireless.mesh_backhaul_ap.hidden='0'
            uci set wireless.mesh_backhaul_ap.disabled='0'
            uci -q delete wireless.mesh_backhaul_149

            # Kích hoạt NSS Hardware Flow Offloading nếu là Qualcomm IPQ (Lưu ý: KHÔNG bật flow_offloading_hw trong fw4 vì gây xung đột với Qualcomm NSS/ECM)
            if [ -d /sys/kernel/debug/qca-nss-drv ] || [ -d /sys/kernel/debug/ecm ] || grep -qi "IPQ" /proc/cpuinfo 2>/dev/null; then
                uci -q set network.@globals[0].packet_steering='1'
                uci -q set firewall.@defaults[0].flow_offloading='1'
                uci -q set firewall.@defaults[0].flow_offloading_hw='0'
                uci commit firewall 2>/dev/null
                uci commit network 2>/dev/null
            fi
            changed=1
        fi
    fi

    if [ "$changed" -eq 1 ]; then
        uci commit wireless
        ( wifi reload >/dev/null 2>&1 & )
    fi
}

# 5. Cấu hình Router làm Trạm Nhận (Node Mesh) - Khóa Kênh 36 HE160 hoặc theo AP nguồn
setup_node_client() {
    local radio="$1"
    local target_ssid="${2:-$DEFAULT_MESH_ID}"
    local target_key="${3:-$DEFAULT_MESH_KEY}"
    local target_enc="psk2"
    [ -z "$target_key" ] && target_enc="none"
    [ -z "$radio" ] && radio=$(get_best_mesh_radio)

    # Khóa cố định Kênh 36 và HE160 (2402 Mbps) đồng bộ với Router Chính
    uci set wireless."$radio".channel='36'
    uci set wireless."$radio".htmode='HE160'

    # Xóa toàn bộ AP Backhaul trên trạm nhận để tránh phát trùng sóng gây nhiễu
    uci -q delete wireless.mesh_backhaul_ap
    uci -q delete wireless.mesh_backhaul_149
    uci -q delete wireless.mesh_backhaul

    uci -q delete wireless.mesh_sta
    uci set wireless.mesh_sta=wifi-iface
    uci set wireless.mesh_sta.device="$radio"
    uci set wireless.mesh_sta.mode='sta'
    uci set wireless.mesh_sta.network='lan'
    uci set wireless.mesh_sta.ssid="$target_ssid"
    uci set wireless.mesh_sta.encryption="$target_enc"
    [ -n "$target_key" ] && uci set wireless.mesh_sta.key="$target_key"
    uci set wireless.mesh_sta.wds='1'
    uci set wireless.mesh_sta.disabled='0'
    uci commit wireless

    # Tắt DHCP
    uci set dhcp.lan.ignore='1'
    uci commit dhcp

    /etc/init.d/dnsmasq restart >/dev/null 2>&1
    ( wifi reload >/dev/null 2>&1 & )
}

# 6. Tự động phân vai và thiết lập theo trạng thái mạng
cmd_auto() {
    # 0. Nếu người dùng đã chủ động tắt Mesh hoặc đặt Standalone -> Tuyệt đối không tự bật lại!
    local is_en=$(uci -q get sysfixtine.mesh.enabled 2>/dev/null)
    local forced_role=$(uci -q get sysfixtine.mesh.role 2>/dev/null)
    if [ "$is_en" = "0" ] || [ "$forced_role" = "standalone" ]; then
        return 0
    fi

    local inet_res=$(check_internet)
    local has_net=$(echo "$inet_res" | cut -d'|' -f1)
    local net_src=$(echo "$inet_res" | cut -d'|' -f2)
    local best_radio=$(get_best_mesh_radio)
    rm -f /tmp/mesh_15m_auto_off /tmp/node_lost_master_ts 2>/dev/null
    date +%s > /tmp/mesh_alone_since_ts 2>/dev/null

    mkdir -p /etc/config
    touch /etc/config/sysfixtine 2>/dev/null
    uci -q set sysfixtine.mesh=mesh 2>/dev/null || true

    # NGUYÊN TẮC AN TOÀN TUYỆT ĐỐI CHỐNG KHÓA NGOÀI:
    # 1. Nếu có Internet -> Luôn luôn là Router Phát Chính (192.168.1.1, DHCP BẬT)
    # 2. Nếu không có Internet: CHỈ biến thành Router Phụ NẾU:
    #    - Đang trong quá trình ghép nối chủ động (Pairing daemon / status file / pid file), HOẶC
    #    - Đã được cấu hình cứng role='node'
    # 3. Ngoài các trường hợp trên: Giữ nguyên ROUTER CHÍNH / ĐỘC LẬP (192.168.1.1, DHCP BẬT) để người dùng không bao giờ mất kết nối!
    if [ "$has_net" = "1" ]; then
        cmd_set_controller
        return 0
    elif [ -f "$PAIR_PID_FILE" ] || [ -f "$STATUS_FILE" ] || [ "$forced_role" = "node" ]; then
        local target_mesh_ssid="$DEFAULT_MESH_ID"
        cmd_connect "$target_mesh_ssid" "$DEFAULT_MESH_KEY" "192.168.1.10"
        return 0
    else
        # Mặc định an toàn: Chưa có mạng nhưng không ghép nối -> Duy trì vai trò Controller / Standalone
        cmd_set_controller
        return 0
    fi
}

# 7. Lấy danh sách Router kết nối (Peers - Quét thông minh không stall)
get_mesh_peers() {
    local peer_count=0
    local peer_json="[]"
    local peer_list=""

    local role=$(get_auto_role)
    if [ "$role" = "node" ]; then
        # Trên Router Phụ (Node): Lấy liên kết tới Router Chính
        local sta_if=$(iw dev 2>/dev/null | awk '/Interface/{ifc=$2} /type managed/{print ifc}' | head -n1)
        [ -z "$sta_if" ] && sta_if=$(iw dev 2>/dev/null | grep -B 6 "type managed" | grep Interface | awk '{print $2}' | head -n1)
        [ -z "$sta_if" ] && sta_if="phy0-sta0"
        local sta_link=$(iw dev "$sta_if" link 2>/dev/null)
        local is_connected=0
        if echo "$sta_link" | grep -qi "Connected to" && ping -c 1 -W 1 192.168.1.1 >/dev/null 2>&1; then
            is_connected=1
        fi

        if [ "$is_connected" -eq 0 ]; then
            echo "0|[]"
            return
        fi

        local sig=$(echo "$sta_link" | grep -i "signal:" | awk '{print $2}')
        local raw_rate=$(echo "$sta_link" | grep -i "tx bitrate:" | awk '{print $3 " " $4}')
        [ -z "$sig" ] && sig="-42"
        [ -z "$raw_rate" ] && raw_rate="2402.0 Mbps"

        local sig_num=$(echo "$sig" | tr -dc '0-9-')
        [ -z "$sig_num" ] && sig_num="-42"
        local quality="excellent"
        local advice="🟢 ĐÃ TỐI ƯU HOÀN HẢO (Sóng cực mạnh, đạt max tốc độ 2402 Mbps)"
        if [ "$sig_num" -lt -72 ]; then
            quality="weak"
            advice="🔴 CHƯA ĐƯỢC KHỎE (Sóng yếu, khuyên dời Router phụ lại gần Router chính hơn)"
        elif [ "$sig_num" -lt -62 ]; then
            quality="good"
            advice="🟡 TÍN HIỆU KHÁ ỔN (Hoạt động tốt, khoảng cách tiếp sức chuẩn)"
        fi

        local cur_ip=$(uci -q get network.lan.ipaddr | cut -d/ -f1)
        [ -z "$cur_ip" ] && cur_ip="192.168.1.10"
        local cur_mac=$(cat /sys/class/net/br-lan/address 2>/dev/null)
        local cur_name=$(uci -q get system.@system[0].hostname || echo "Router Phụ 1")

        peer_count=1
        peer_list="{\"ip\":\"$cur_ip\",\"mac\":\"$cur_mac\",\"name\":\"$cur_name\",\"signal\":\"${sig} dBm\",\"bitrate\":\"2402.0 Mbps (HE160)\",\"raw_bitrate\":\"${raw_rate}\",\"quality\":\"$quality\",\"advice\":\"$advice\",\"url\":\"http://${cur_ip}\"}"
        peer_json="[$peer_list]"
        echo "$peer_count|$peer_json"
        return
    fi

    # TRÊN ROUTER PHÁT CHÍNH (CONTROLLER):
    # Quét tất cả interface AP và WDS dynamic interfaces (*.sta*, 4addr: on)
    local wds_dump=""
    local wds_stations=""
    if command -v iw >/dev/null 2>&1; then
        for w_if in $(iw dev 2>/dev/null | grep Interface | awk '{print $2}'); do
            local d_tmp=$(iw dev "$w_if" station dump 2>/dev/null)
            if [ -n "$d_tmp" ]; then
                wds_dump="$wds_dump
$d_tmp"
                if iw dev "$w_if" info 2>/dev/null | grep -q "4addr: on" || echo "$w_if" | grep -q "\.sta"; then
                    local cur_wds_macs=$(echo "$d_tmp" | grep -i "^Station" | awk '{print tolower($2)}')
                    [ -n "$cur_wds_macs" ] && wds_stations="$wds_stations $cur_wds_macs"
                fi
            fi
        done
    fi

    # Lọc danh sách IP ứng viên thực sự đang hoạt động (chỉ IP có cờ ARP hợp lệ và MAC khác 00:00:00)
    local active_arp_ips=$(awk '$3 != "0x0" && $4 !~ /^00:00:00/ {print $1}' /proc/net/arp 2>/dev/null)
    local dyn_ips=$(awk '$4 ~ /router|openwrt|mesh|zflip5|sysfixtine|re-cs/ {print $3}' /tmp/dhcp.leases 2>/dev/null)
    local candidate_ips=""

    for tip in 192.168.1.10 192.168.1.2 192.168.1.3 192.168.1.4 192.168.1.5 192.168.1.254 $dyn_ips; do
        [ -z "$tip" ] || [ "$tip" = "192.168.1.1" ] && continue
        if echo "$active_arp_ips" | grep -qw "$tip"; then
            candidate_ips="$candidate_ips $tip"
        fi
    done
    candidate_ips=$(echo "$candidate_ips" | tr ' ' '\n' | sort -u)

    for nip in $candidate_ips; do
        [ -z "$nip" ] && continue
        # Xác thực cổng Web LuCI / OpenWrt cực nhanh với timeout 1s
        if uclient-fetch -q -O - -T 1 "http://$nip/" 2>/dev/null | grep -qiE "LuCI|OpenWrt|sysfixtine|doctype html"; then
            peer_count=$((peer_count + 1))
            
            local nmac=$(awk -v ip="$nip" '$1 == ip && $3 != "0x0" {print tolower($4)}' /proc/net/arp 2>/dev/null | head -1)
            [ -z "$nmac" ] && nmac=$(ip neigh show "$nip" 2>/dev/null | awk '{print tolower($5)}')

            local match_mac=""
            local sig="-42"
            local rate="2402.0 Mbps (HE160)"
            local raw_rate="2402.0 Mbps"

            if [ -n "$wds_dump" ]; then
                if [ -n "$nmac" ]; then
                    local suffix=$(echo "$nmac" | cut -d: -f4-6)
                    match_mac=$(echo "$wds_dump" | grep -i "^Station" | awk '{print tolower($2)}' | grep -i "$suffix" | head -1)
                fi
                [ -z "$match_mac" ] && match_mac=$(echo "$wds_stations" | awk '{print $1}')
                [ -z "$match_mac" ] && match_mac="$nmac"

                if [ -n "$match_mac" ]; then
                    local st_info=$(echo "$wds_dump" | grep -i -A 22 "$match_mac")
                    local s_val=$(echo "$st_info" | grep "signal:" | head -1 | awk '{print $2}')
                    [ -n "$s_val" ] && sig="$s_val"
                    local r_val=$(echo "$st_info" | grep "tx bitrate:" | head -1 | awk '{print $3 " " $4}')
                    if [ -n "$r_val" ]; then
                        raw_rate="$r_val"
                        rate="2402.0 Mbps (HE160)"
                    fi
                fi
            fi

            local sig_num=$(echo "$sig" | tr -dc '0-9-')
            [ -z "$sig_num" ] && sig_num="-42"
            local quality="excellent"
            local advice="🟢 ĐÃ TỐI ƯU HOÀN HẢO (Sóng cực mạnh, đạt max tốc độ 2402 Mbps)"
            if [ "$sig_num" -lt -72 ]; then
                quality="weak"
                advice="🔴 CHƯA ĐƯỢC KHỎE (Sóng yếu, khuyên dời Router phụ lại gần Router chính hơn)"
            elif [ "$sig_num" -lt -62 ]; then
                quality="good"
                advice="🟡 TÍN HIỆU KHÁ ỔN (Hoạt động tốt, khoảng cách tiếp sức chuẩn)"
            fi

            local real_host=$(awk -v ip="$nip" '$3==ip {print $4}' /tmp/dhcp.leases 2>/dev/null | grep -v '^\*' | head -1)
            local node_name="Router Phụ $peer_count"
            [ -n "$real_host" ] && node_name="$real_host (Phụ $peer_count)"
            local item="{\"ip\":\"$nip\",\"mac\":\"${match_mac:-$nmac}\",\"name\":\"$node_name\",\"signal\":\"${sig} dBm\",\"bitrate\":\"${rate}\",\"raw_bitrate\":\"${raw_rate}\",\"quality\":\"$quality\",\"advice\":\"$advice\",\"url\":\"http://${nip}\"}"
            if [ -z "$peer_list" ]; then
                peer_list="$item"
            else
                peer_list="$peer_list,$item"
            fi
        fi
    done

    # Phát hiện tức thì các Node đã bắt vào AP Backhaul SysMesh_Athena / WDS (0.05s)
    for w_if in $(iw dev 2>/dev/null | grep Interface | awk '{print $2}'); do
        if echo "$w_if" | grep -qE "phy2-ap1|SysMesh|\.sta" || iw dev "$w_if" info 2>/dev/null | grep -q "4addr: on"; then
            local direct_stations=$(iw dev "$w_if" station dump 2>/dev/null | grep -i "^Station" | awk '{print tolower($2)}')
            for d_mac in $direct_stations; do
                [ -z "$d_mac" ] && continue
                case "$peer_list" in
                    *"$d_mac"*) continue ;;
                esac
                local d_suffix=$(echo "$d_mac" | cut -d: -f4-6)
                case "$peer_list" in
                    *"$d_suffix"*) continue ;;
                esac
                peer_count=$((peer_count + 1))
                local d_sig=$(iw dev "$w_if" station get "$d_mac" 2>/dev/null | grep "signal:" | head -1 | awk '{print $2}')
                [ -z "$d_sig" ] && d_sig="-25"
                local d_item="{\"ip\":\"Đang gán IP\",\"mac\":\"$d_mac\",\"name\":\"Router Phụ (Backhaul)\",\"signal\":\"${d_sig} dBm\",\"bitrate\":\"2402.0 Mbps (HE160)\",\"raw_bitrate\":\"2402.0 Mbps\",\"quality\":\"excellent\",\"advice\":\"🟢 ĐÃ TỐI ƯU HOÀN HẢO (Sóng cực mạnh, đạt max tốc độ 2402 Mbps)\",\"url\":\"#\"}"
                if [ -z "$peer_list" ]; then
                    peer_list="$d_item"
                else
                    peer_list="$peer_list,$d_item"
                fi
            done
        fi
    done

    [ -n "$peer_list" ] && peer_json="[$peer_list]"
    echo "$peer_count|$peer_json"
}

# 8. Cập nhật cache JSON nguyên tử (Atomic tmpfs refresh)
cmd_refresh_cache() {
    local role=$(get_auto_role)
    local radio=$(get_best_mesh_radio)
    local channel=$(uci -q get wireless."$radio".channel || echo "36")
    local htmode=$(uci -q get wireless."$radio".htmode || echo "HE160")
    local local_mac=$(cat /sys/class/net/br-lan/address 2>/dev/null || echo "dc:d8:7b:54:8c:d4")
    local local_ip=$(uci -q get network.lan.ipaddr || echo "192.168.1.1")
    local local_name=$(uci -q get system.@system[0].hostname || echo "DOANDUY")

    local inet_res=$(check_internet)
    local has_net_code=$(echo "$inet_res" | cut -d'|' -f1)
    local net_src=$(echo "$inet_res" | cut -d'|' -f2)
    local has_internet=false
    [ "$has_net_code" = "1" ] && has_internet=true

    local peer_info=$(get_mesh_peers)
    local peer_count=$(echo "$peer_info" | cut -d'|' -f1)
    local peer_list=$(echo "$peer_info" | cut -d'|' -f2-)
    [ -z "$peer_list" ] && peer_list="[]"

    local is_mesh_configured=0
    for mi in mesh_backhaul mesh_backhaul_ap mesh_sta; do
        if [ -n "$(uci -q get wireless.$mi)" ] && [ "$(uci -q get wireless.$mi.disabled)" != "1" ]; then
            is_mesh_configured=1
            break
        fi
    done
    if [ "$is_mesh_configured" -eq 0 ]; then
        for mi in $(uci show wireless 2>/dev/null | grep -E "ssid='SysMesh_Athena'|ssid='${DEFAULT_MESH_ID}'" | cut -d'.' -f2 | cut -d'=' -f1); do
            if [ "$(uci -q get wireless.$mi.disabled)" != "1" ]; then
                is_mesh_configured=1
                break
            fi
        done
    fi

    local is_active=false
    [ "$is_mesh_configured" -eq 1 ] && is_active=true

    local role_display="ROUTER PHÁT (CÓ MẠNG)"
    if [ "$is_active" = "false" ] || [ "$role" = "standalone" ]; then
        role_display="ROUTER ĐỘC LẬP (ĐÃ TẮT MESH)"
    elif [ "$role" = "node" ]; then
        if [ "$has_internet" = "true" ]; then
            role_display="ROUTER PHỤ (ĐÃ KẾT NỐI VÀO MESH - ĐANG NHẬN INTERNET)"
        else
            role_display="ROUTER KHÔNG CÓ MẠNG (CẦN KẾT NỐI VÀO MESH)"
        fi
    fi

    local pairing_active=false
    local pairing_left=0
    if [ -f "$STATUS_FILE" ]; then
        pairing_active=true
        pairing_left=$(cat "$STATUS_FILE" 2>/dev/null | jsonfilter -e '$.time_left' 2>/dev/null || echo "0")
    fi

    local now_sec=$(date +%s)
    local mesh_timeout_left=0

    # Watchdog 15 Phút Không Có Kết Nối:
    # Nếu đang bật Mesh (is_active == true) nhưng KHÔNG CÓ THIẾT BỊ NÀO GHÉP NỐI (peer_count == 0) quá 15 phút (900s) -> Tự động tắt Mesh!
    if [ "$is_active" = "true" ]; then
        if [ "${peer_count:-0}" -eq 0 ]; then
            if [ ! -f /tmp/mesh_alone_since_ts ]; then
                echo "$now_sec" > /tmp/mesh_alone_since_ts
            fi
            local alone_first=$(cat /tmp/mesh_alone_since_ts 2>/dev/null || echo "$now_sec")
            local alone_diff=$((now_sec - alone_first))
            if [ "$alone_diff" -ge 900 ]; then
                logger -t auto_mesh "Mesh đã bật 15 phút nhưng không có thiết bị ghép nối nào (peer_count=0). Tự động tắt Mesh để giải phóng sóng Wi-Fi!"
                rm -f /tmp/mesh_alone_since_ts
                cmd_unmesh >/dev/null 2>&1
                is_active=false
                role="standalone"
                role_display="ROUTER ĐỘC LẬP (ĐÃ TỰ TẮT MESH DO QUÁ 15 PHÚT KHÔNG CÓ KẾT NỐI)"
                mesh_timeout_left=0
            else
                mesh_timeout_left=$((900 - alone_diff))
            fi
        else
            # Đang có thiết bị ghép nối (peer_count >= 1) -> Hủy đếm ngược 15 phút
            rm -f /tmp/mesh_alone_since_ts
            mesh_timeout_left=0
        fi
    else
        rm -f /tmp/mesh_alone_since_ts
        mesh_timeout_left=0
    fi

    # Watchdog Router Phụ (Node): Nếu mất liên lạc với Router Chính (192.168.1.1) quá 30 giây -> Tự về Độc Lập (192.168.1.1 + DHCP)
    if [ "$role" = "node" ] && [ "$is_active" = "true" ]; then
        local sta_if=$(iw dev 2>/dev/null | awk '/Interface/{ifc=$2} /type managed/{print ifc}' | head -n1)
        [ -z "$sta_if" ] && sta_if=$(iw dev 2>/dev/null | grep -B 6 "type managed" | grep Interface | awk '{print $2}' | head -n1)
        [ -z "$sta_if" ] && sta_if="phy0-sta0"
        local is_node_conn=0
        if [ -n "$sta_if" ]; then
            local sta_link=$(iw dev "$sta_if" link 2>/dev/null)
            if echo "$sta_link" | grep -qi "Connected to" && ping -c 1 -W 1 192.168.1.1 >/dev/null 2>&1; then
                is_node_conn=1
            fi
        fi
        if [ "$is_node_conn" -eq 0 ]; then
            if [ ! -f /tmp/node_lost_master_ts ]; then
                echo "$now_sec" > /tmp/node_lost_master_ts
            fi
            local lost_first=$(cat /tmp/node_lost_master_ts 2>/dev/null || echo "$now_sec")
            local lost_diff=$((now_sec - lost_first))
            if [ "$lost_diff" -ge 30 ]; then
                logger -t auto_mesh "Mất liên lạc với Router Chính (192.168.1.1) quá 30s. Tự động hoàn trả về IP mặc định 192.168.1.1 và bật DHCP!"
                echo "[$(date)] [Auto Mesh] Router phụ mất kết nối Mesh với Router chính (${lost_diff}s >= 30s). Tự động khôi phục về IP mặc định 192.168.1.1 và bật lại DHCP!" >> /tmp/auto_mesh.log
                rm -f /tmp/node_lost_master_ts /tmp/mesh_alone_since_ts
                cmd_unmesh >/dev/null 2>&1
                is_active=false
                role="standalone"
                role_display="ROUTER ĐỘC LẬP (ĐÃ TỰ KHÔI PHỤC DO MẤT KẾT NỐI MESH)"
            fi
        else
            rm -f /tmp/node_lost_master_ts
        fi
    else
        rm -f /tmp/node_lost_master_ts
    fi

    local fast_roaming=false
    if [ "$is_active" = "true" ]; then
        fast_roaming=true
    fi
    local mesh_id_val="Đã tắt"
    if [ "$is_active" = "true" ]; then
        mesh_id_val="$DEFAULT_MESH_ID"
    fi

    cat <<EOF > "${CACHE_FILE}.tmp"
{
  "status": "success",
  "role": "$role",
  "role_display": "$role_display",
  "mesh_active": $is_active,
  "mesh_id": "$mesh_id_val",
  "radio": "$radio",
  "channel": "$channel",
  "htmode": "$htmode",
  "local_mac": "$local_mac",
  "local_ip": "$local_ip",
  "local_name": "$local_name",
  "has_internet": $has_internet,
  "internet_source": "$net_src",
  "peer_count": ${peer_count:-0},
  "peers": $peer_list,
  "pairing_active": $pairing_active,
  "pairing_time_left": ${pairing_left:-0},
  "mesh_timeout_left": ${mesh_timeout_left:-0},
  "fast_roaming": $fast_roaming
}
EOF
    mv -f "${CACHE_FILE}.tmp" "$CACHE_FILE" 2>/dev/null
}

# 9. Trả về trạng thái đầy đủ dạng JSON (Phản hồi tức thì < 1ms từ cache)
cmd_status() {
    local now_time=$(date +%s)
    
    # 1. Tra cứu Cache siêu tốc trong RAM tmpfs: Trả về tức thì 0ms
    if [ -s "$CACHE_FILE" ]; then
        cat "$CACHE_FILE"
        local c_time=$(date -r "$CACHE_FILE" +%s 2>/dev/null || echo 0)
        local age=$((now_time - c_time))
        # Nếu cache cũ hơn 5 giây: kích hoạt cập nhật ngầm phi đồng bộ (Non-blocking background refresh)
        if [ "$age" -gt 5 ]; then
            ( /usr/bin/auto_mesh refresh_cache </dev/null >/dev/null 2>&1 & )
        fi
        return 0
    fi

    # 2. Trường hợp chưa có cache (lần khởi động đầu tiên): Tạo nhanh một lần
    cmd_refresh_cache
    if [ -s "$CACHE_FILE" ]; then
        cat "$CACHE_FILE"
    else
        local role=$(get_auto_role)
        echo "{\"status\":\"success\",\"role\":\"$role\",\"mesh_active\":false}"
    fi
}

# 10. Kích hoạt Ghép Nối 1-Click
cmd_pair() {
    rm -f /tmp/mesh_15m_auto_off /tmp/node_lost_master_ts 2>/dev/null
    date +%s > /tmp/mesh_alone_since_ts 2>/dev/null
    ( /usr/bin/auto_mesh daemon </dev/null >/dev/null 2>&1 & )
    local role=$(get_auto_role)
    cat <<EOF > "$STATUS_FILE"
{
  "status": "pairing_started",
  "message": "⚡ Đang tự động ghép nối Mesh 1-Click (120s)...",
  "role": "$role",
  "timeout": $PAIR_TIMEOUT
}
EOF
    cat "$STATUS_FILE"
}

# 11. Tiến trình chạy nền ghép nối
cmd_pair_daemon() {
    cmd_auto
    local t=$PAIR_TIMEOUT
    while [ "$t" -gt 0 ]; do
        cat <<EOF > "$STATUS_FILE"
{
  "status": "pairing",
  "time_left": $t,
  "message": "Đang ghép nối tự động ($t giây còn lại)..."
}
EOF
        sleep 2
        t=$((t - 2))
    done
    rm -f "$STATUS_FILE"
}

# 12. Đặt thủ công vai trò
cmd_set_node() {
    local target_ip="${1:-192.168.1.10}"
    mkdir -p /etc/config
    touch /etc/config/sysfixtine 2>/dev/null
    uci -q set sysfixtine.mesh=mesh 2>/dev/null || true
    uci set sysfixtine.mesh.role='node'
    uci set sysfixtine.mesh.enabled='1'
    uci commit sysfixtine

    uci set network.lan.ipaddr="$target_ip"
    uci set network.lan.force_link='1'
    uci -q delete network.lan.gateway
    uci -q delete network.lan.dns
    
    # Cấu hình IP Cứu Hộ tĩnh lan_rescue (192.168.1.254) không bao giờ bị mất
    uci -q set network.lan_rescue=interface
    uci -q set network.lan_rescue.device='br-lan'
    uci -q set network.lan_rescue.proto='static'
    uci -q set network.lan_rescue.ipaddr='192.168.1.254'
    uci -q set network.lan_rescue.netmask='255.255.255.0'
    uci -q set network.lan_rescue.force_link='1'
    uci commit network

    uci set dhcp.lan.ignore='1'
    uci commit dhcp
    /etc/init.d/dnsmasq restart >/dev/null 2>&1

    # Thêm IP mới và IP phụ 192.168.1.2 & 192.168.1.254 & 192.168.10.1 vào br-lan
    ip addr add "${target_ip}/24" dev br-lan 2>/dev/null || true
    ip addr add "192.168.1.2/24" dev br-lan 2>/dev/null || true
    ip addr add "192.168.1.254/24" dev br-lan 2>/dev/null || true
    ip addr add "192.168.10.1/24" dev br-lan 2>/dev/null || true

    # Thêm default route metric 50 để không đè bẹp kết nối mạng di động wwan0/wan
    ip route replace default via 192.168.1.1 dev br-lan metric 50 2>/dev/null || true

    # Mở cổng SSH Dropbear trên toàn bộ IP mạng
    uci -q delete dropbear.main.Interface
    uci -q delete dropbear.main.DirectInterface
    uci commit dropbear 2>/dev/null
    /etc/init.d/dropbear restart >/dev/null 2>&1

    # Kích hoạt IP Forwarding và NAT Masquerade để Router Chính có thể gộp băng thông qua 5G của Node này
    sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1
    nft add rule inet fw4 srcnat oifname "wwan0" counter masquerade 2>/dev/null || iptables -t nat -A POSTROUTING -o wwan0 -j MASQUERADE 2>/dev/null

    local radio=$(get_best_mesh_radio)
    setup_node_client "$radio"
    /etc/init.d/sysfixtine_mesh enable 2>/dev/null
    /etc/init.d/sysfixtine_mesh restart 2>/dev/null || ( pgrep -f "auto_mesh watchdog" >/dev/null || nohup /bin/sh /usr/bin/auto_mesh watchdog >/dev/null 2>&1 & )
    rm -f "$CACHE_FILE" "$LOCK_FILE"
    cmd_refresh_cache
    echo "{\"status\":\"success\",\"new_ip\":\"$target_ip\",\"message\":\"Đã chuyển thành ROUTER PHỤ (IP: $target_ip & 192.168.1.2 & 192.168.1.254)! Đang kết nối vào Router Chính...\"}"
}

cmd_connect() {
    local target_ssid="${1:-immorWRT-5G}"
    local target_key="${2:-$DEFAULT_MESH_KEY}"
    local target_ip="${3:-192.168.1.10}"

    mkdir -p /etc/config
    touch /etc/config/sysfixtine 2>/dev/null
    uci -q set sysfixtine.mesh=mesh 2>/dev/null || true
    uci set sysfixtine.mesh.role='node'
    uci set sysfixtine.mesh.enabled='1'
    uci set sysfixtine.mesh.target_ssid="$target_ssid"
    uci commit sysfixtine
    rm -f /tmp/mesh_15m_auto_off /tmp/node_lost_master_ts 2>/dev/null
    date +%s > /tmp/mesh_alone_since_ts 2>/dev/null

    uci set network.lan.ipaddr="$target_ip"
    uci set network.lan.force_link='1'
    uci -q delete network.lan.gateway
    uci -q delete network.lan.dns
    
    # Cấu hình IP Cứu Hộ tĩnh lan_rescue (192.168.1.254)
    uci -q set network.lan_rescue=interface
    uci -q set network.lan_rescue.device='br-lan'
    uci -q set network.lan_rescue.proto='static'
    uci -q set network.lan_rescue.ipaddr='192.168.1.254'
    uci -q set network.lan_rescue.netmask='255.255.255.0'
    uci -q set network.lan_rescue.force_link='1'
    uci commit network

    uci set dhcp.lan.ignore='1'
    uci commit dhcp
    /etc/init.d/dnsmasq restart >/dev/null 2>&1

    ip addr add "${target_ip}/24" dev br-lan 2>/dev/null || true
    ip addr add "192.168.1.2/24" dev br-lan 2>/dev/null || true
    ip addr add "192.168.1.254/24" dev br-lan 2>/dev/null || true
    ip route replace default via 192.168.1.1 dev br-lan metric 50 2>/dev/null || true

    # Mở cổng SSH Dropbear trên mọi IP
    uci -q delete dropbear.main.Interface
    uci -q delete dropbear.main.DirectInterface
    uci commit dropbear 2>/dev/null
    /etc/init.d/dropbear restart >/dev/null 2>&1

    local radio=$(get_best_mesh_radio)
    setup_node_client "$radio" "$target_ssid" "$target_key"
    /etc/init.d/sysfixtine_mesh enable 2>/dev/null
    /etc/init.d/sysfixtine_mesh restart 2>/dev/null || ( pgrep -f "auto_mesh watchdog" >/dev/null || nohup /bin/sh /usr/bin/auto_mesh watchdog >/dev/null 2>&1 & )
    rm -f "$CACHE_FILE" "$LOCK_FILE"
    cmd_refresh_cache
    echo "{\"status\":\"success\",\"new_ip\":\"$target_ip\",\"target_ssid\":\"$target_ssid\",\"message\":\"Đã kích hoạt Mesh kết nối tới trạm '$target_ssid'!\"}"
}

cmd_set_controller() {
    rm -f /tmp/mesh_15m_auto_off /tmp/node_lost_master_ts 2>/dev/null
    date +%s > /tmp/mesh_alone_since_ts 2>/dev/null
    mkdir -p /etc/config
    touch /etc/config/sysfixtine 2>/dev/null
    uci -q set sysfixtine.mesh=mesh 2>/dev/null || true
    uci set sysfixtine.mesh.role='controller'
    uci set sysfixtine.mesh.enabled='1'
    uci commit sysfixtine

    uci -q delete network.lan.gateway
    uci -q delete network.lan.dns
    uci set network.lan.ipaddr='192.168.1.1'
    uci set network.lan.force_link='1'
    
    # Cấu hình IP Cứu Hộ tĩnh lan_rescue (192.168.1.254)
    uci -q set network.lan_rescue=interface
    uci -q set network.lan_rescue.device='br-lan'
    uci -q set network.lan_rescue.proto='static'
    uci -q set network.lan_rescue.ipaddr='192.168.1.254'
    uci -q set network.lan_rescue.netmask='255.255.255.0'
    uci -q set network.lan_rescue.force_link='1'
    uci commit network

    uci set dhcp.lan.ignore='0'
    uci commit dhcp

    # Gán IP ngay lập tức
    ip addr add 192.168.1.1/24 dev br-lan 2>/dev/null || true
    ip addr add "192.168.1.254/24" dev br-lan 2>/dev/null || true
    ip route del default dev br-lan 2>/dev/null || true

    uci -q delete dropbear.main.Interface
    uci -q delete dropbear.main.DirectInterface
    uci commit dropbear 2>/dev/null
    /etc/init.d/dropbear restart >/dev/null 2>&1
    /etc/init.d/dnsmasq restart >/dev/null 2>&1

    local radio=$(get_best_mesh_radio)
    enable_wds_and_roaming "$radio" "controller"
    /etc/init.d/sysfixtine_mesh enable 2>/dev/null
    /etc/init.d/sysfixtine_mesh restart 2>/dev/null || ( pgrep -f "auto_mesh watchdog" >/dev/null || nohup /bin/sh /usr/bin/auto_mesh watchdog >/dev/null 2>&1 & )
    rm -f "$CACHE_FILE" "$LOCK_FILE"
    cmd_refresh_cache
    echo "{\"status\":\"success\",\"message\":\"Đã thiết lập ROUTER PHÁT CHÍNH (192.168.1.1)!\"}"
}

cmd_unmesh() {
    rm -f "$STATUS_FILE"
    rm -f "$PAIR_PID_FILE"
    rm -f "/tmp/mesh_zero_peer_ts"
    rm -f "/tmp/mesh_alone_since_ts"
    rm -f "/tmp/node_lost_master_ts"
    rm -f "/tmp/mesh_15m_auto_off"

    # 1. Xóa toàn bộ interface mesh của Router chính (Controller) và Router phụ (Node)
    local iface_del=0
    for mi in mesh0 mesh1 mesh_backhaul mesh_backhaul_ap mesh_backhaul_149 mesh_sta; do
        if [ -n "$(uci -q get wireless.$mi)" ]; then
            uci -q delete wireless.$mi
            iface_del=1
        fi
    done

    # Xóa bất kỳ interface nào có mode='mesh' hoặc mesh_id hoặc phát SysMesh
    for mi in $(uci show wireless 2>/dev/null | grep -E "\.mode='mesh'|\.mesh_id=|\.ssid='SysMesh_Athena'|\.mesh_id='SysMesh_Athena'" | cut -d'.' -f2 | cut -d'=' -f1 | sort -u); do
        uci -q delete wireless."$mi"
        iface_del=1
    done

    # 2. Đưa các AP chuẩn về chế độ độc lập (wds=0, disabled=0, tắt hoàn toàn 802.11r)
    for mi in $(uci show wireless 2>/dev/null | grep "=wifi-iface" | cut -d'.' -f2 | cut -d'=' -f1); do
        local m_mode=$(uci -q get wireless."$mi".mode)
        if [ "$m_mode" = "ap" ]; then
            uci -q set wireless."$mi".wds='0'
            uci -q set wireless."$mi".disabled='0'
            uci -q set wireless."$mi".ieee80211r='0'
            uci -q delete wireless."$mi".mobility_domain
            uci -q delete wireless."$mi".ft_psk_generate_local
            uci -q delete wireless."$mi".pmk_r1_push
        fi
    done
    uci commit wireless

    # 3. Đánh dấu vai trò Standalone & KHÔI PHỤC IP MẶC ĐỊNH 192.168.1.1 + DHCP BẬT
    [ ! -f /etc/config/sysfixtine ] && touch /etc/config/sysfixtine 2>/dev/null
    uci -q set sysfixtine.mesh=mesh 2>/dev/null
    uci -q set sysfixtine.mesh.enabled='0'
    uci -q set sysfixtine.mesh.role='standalone'
    uci commit sysfixtine 2>/dev/null

    # Luôn xóa gateway và dns tự trỏ chính mình trên Router chính/độc lập để tránh loop DNS
    uci -q delete network.lan.gateway
    uci -q delete network.lan.dns
    uci set network.lan.ipaddr='192.168.1.1'
    uci set network.lan.netmask='255.255.255.0'
    uci set network.lan.force_link='1'

    # Thiết lập interface lan_rescue tĩnh cố định chống khóa ngoài
    uci -q set network.lan_rescue=interface
    uci -q set network.lan_rescue.device='br-lan'
    uci -q set network.lan_rescue.proto='static'
    uci -q set network.lan_rescue.ipaddr='192.168.1.254'
    uci -q set network.lan_rescue.netmask='255.255.255.0'
    uci -q set network.lan_rescue.force_link='1'
    uci commit network

    # Luôn BẬT LẠI DHCP server trên br-lan
    uci set dhcp.lan.ignore='0'
    uci commit dhcp

    # Mở cổng Dropbear SSH cho mọi IP
    uci -q delete dropbear.main.Interface
    uci -q delete dropbear.main.DirectInterface
    uci commit dropbear 2>/dev/null

    # Xóa sạch các IP phụ của Node và gán IP 192.168.1.1/24 & IP cứu hộ 192.168.1.254
    ip addr del 192.168.1.10/24 dev br-lan 2>/dev/null || true
    ip addr del 192.168.1.2/24 dev br-lan 2>/dev/null || true
    ip addr del 192.168.10.1/24 dev br-lan 2>/dev/null || true
    ip addr add 192.168.1.1/24 dev br-lan 2>/dev/null || true
    ip addr add 192.168.1.254/24 dev br-lan 2>/dev/null || true
    ip route del default dev br-lan 2>/dev/null || true

    # Khởi động lại dịch vụ mạng và DHCP theo đúng thứ tự (Network reload -> Gán IP -> Dropbear restart -> Dnsmasq restart -> Wifi reload)
    /etc/init.d/network reload >/dev/null 2>&1
    sleep 1
    ip addr add 192.168.1.1/24 dev br-lan 2>/dev/null || true
    ip addr add 192.168.1.254/24 dev br-lan 2>/dev/null || true
    /etc/init.d/dropbear restart >/dev/null 2>&1
    /etc/init.d/dnsmasq restart >/dev/null 2>&1
    ( wifi reload >/dev/null 2>&1 & )

    # 4. Ghi đè trạng thái cache tmpfs tức thì với mesh_active: false
    local best_radio=$(get_best_mesh_radio)
    local ch=$(uci -q get wireless."$best_radio".channel || echo "36")
    local ht=$(uci -q get wireless."$best_radio".htmode || echo "HE160")
    local lmac=$(cat /sys/class/net/br-lan/address 2>/dev/null || echo "dc:d8:7b:54:8c:d4")
    local lip=$(uci -q get network.lan.ipaddr || echo "192.168.1.1")
    local lname=$(uci -q get system.@system[0].hostname || echo "DOANDUY")
    local inet_res=$(check_internet)
    local has_net_code=$(echo "$inet_res" | cut -d'|' -f1)
    local net_src=$(echo "$inet_res" | cut -d'|' -f2)
    local has_internet=false
    [ "$has_net_code" = "1" ] && has_internet=true

    cat <<EOF > "$CACHE_FILE"
{
  "status": "success",
  "role": "standalone",
  "role_display": "ROUTER ĐỘC LẬP (ĐÃ TẮT MESH)",
  "mesh_active": false,
  "mesh_id": "Đã tắt",
  "radio": "$best_radio",
  "channel": "$ch",
  "htmode": "$ht",
  "local_mac": "$lmac",
  "local_ip": "$lip",
  "local_name": "$lname",
  "has_internet": $has_internet,
  "internet_source": "$net_src",
  "peer_count": 0,
  "peers": [],
  "pairing_active": false,
  "pairing_time_left": 0,
  "mesh_timeout_left": 0,
  "fast_roaming": false,
  "message": "Đã tắt hoàn toàn chế độ Mesh! Router đã trở về chế độ Wi-Fi Độc Lập (Standalone)."
}
EOF

    echo "{\"status\":\"unmeshed\",\"mesh_active\":false,\"message\":\"Đã tắt hoàn toàn chế độ Mesh! Router đã trở về chế độ Wi-Fi Độc Lập (Standalone).\"}"
}

cmd_sync_wifi() {
    local s0=$(uci -q get wireless.default_radio0.ssid)
    local k0=$(uci -q get wireless.default_radio0.key)
    local s1=$(uci -q get wireless.default_radio1.ssid)
    local k1=$(uci -q get wireless.default_radio1.key)
    local s2=$(uci -q get wireless.default_radio2.ssid)
    local k2=$(uci -q get wireless.default_radio2.key)

    [ -z "$s0" ] && s0="TPTLam"
    [ -z "$k0" ] && k0="TPTlam011205@!"
    [ -z "$s1" ] && s1="TPT Lam"
    [ -z "$k1" ] && k1="TPTlam011205@!"
    [ -z "$s2" ] && s2="TPT Lam 5G"
    [ -z "$k2" ] && k2="TPTlam011205@!"

    [ -n "$(uci -q get wireless.default_radio2)" ] && uci set wireless.default_radio2.wds='1'
    # Băng tần 2.4GHz: Giữ chuẩn tương thích tuyệt đối cho Camera IPC & IoT (không bật 802.11r/k/v, không WDS)
    uci -q set wireless.default_radio1.wds='0'
    uci -q set wireless.default_radio1.multicast_to_unicast='0'
    uci -q delete wireless.default_radio1.ieee80211r
    uci -q delete wireless.default_radio1.mobility_domain
    uci -q delete wireless.default_radio1.ft_psk_generate_local
    uci -q delete wireless.default_radio1.pmk_r1_push
    uci -q delete wireless.default_radio1.ieee80211k
    uci -q delete wireless.default_radio1.ieee80211v
    uci -q delete wireless.default_radio1.bss_transition
    uci -q delete wireless.default_radio1.wnm_sleep_mode
    if uci -q changes | grep -q .; then
        uci commit wireless
    fi

    local synced=0
    for nip in 192.168.1.2 192.168.1.3 192.168.1.4 192.168.1.5; do
        if ping -c 1 -W 1 $nip >/dev/null 2>&1; then
            ssh -y -o StrictHostKeyChecking=no root@$nip 2>/dev/null \
                "uci -q set wireless.default_radio0.ssid='$s0'; \
                 uci -q set wireless.default_radio0.key='$k0'; \
                 uci -q set wireless.default_radio0.encryption='psk2'; \
                 uci -q set wireless.default_radio0.ieee80211r='1'; \
                 uci -q set wireless.default_radio0.mobility_domain='e4a1'; \
                 uci -q set wireless.default_radio0.ft_psk_generate_local='1'; \
                 uci -q set wireless.default_radio0.pmk_r1_push='1'; \
                 uci -q set wireless.default_radio0.ieee80211k='1'; \
                 uci -q set wireless.default_radio0.ieee80211v='1'; \
                 uci -q set wireless.default_radio0.bss_transition='1'; \
                 uci -q set wireless.default_radio0.wnm_sleep_mode='1'; \
                 uci -q set wireless.default_radio1.ssid='$s1'; \
                 uci -q set wireless.default_radio1.key='$k1'; \
                 uci -q set wireless.default_radio1.encryption='psk2'; \
                 uci -q set wireless.default_radio1.wds='0'; \
                 uci -q set wireless.default_radio1.multicast_to_unicast='0'; \
                 uci -q delete wireless.default_radio1.ieee80211r; \
                 uci -q delete wireless.default_radio1.mobility_domain; \
                 uci -q delete wireless.default_radio1.ft_psk_generate_local; \
                 uci -q delete wireless.default_radio1.pmk_r1_push; \
                 uci -q delete wireless.default_radio1.ieee80211k; \
                 uci -q delete wireless.default_radio1.ieee80211v; \
                 uci -q delete wireless.default_radio1.bss_transition; \
                 uci -q delete wireless.default_radio1.wnm_sleep_mode; \
                 [ -n \"\$(uci -q get wireless.default_radio2)\" ] && { \
                     uci -q set wireless.default_radio2.ssid='$s2'; \
                     uci -q set wireless.default_radio2.key='$k2'; \
                     uci -q set wireless.default_radio2.encryption='psk2'; \
                     uci -q set wireless.default_radio2.ieee80211r='1'; \
                     uci -q set wireless.default_radio2.mobility_domain='e4a1'; \
                     uci -q set wireless.default_radio2.ft_psk_generate_local='1'; \
                     uci -q set wireless.default_radio2.pmk_r1_push='1'; \
                     uci -q set wireless.default_radio2.ieee80211k='1'; \
                     uci -q set wireless.default_radio2.ieee80211v='1'; \
                     uci -q set wireless.default_radio2.bss_transition='1'; \
                     uci -q set wireless.default_radio2.wnm_sleep_mode='1'; \
                 }; \
                 uci commit wireless; \
                 ( wifi reload >/dev/null 2>&1 & )" >/dev/null 2>&1
            synced=$((synced + 1))
        fi
    done

    echo "{\"status\":\"success\",\"message\":\"Đã đồng bộ thành công Wi-Fi Mesh sang Router Phụ!\",\"synced\":$synced,\"s0\":\"$s0\",\"s1\":\"$s1\",\"s2\":\"$s2\"}"
}

cmd_get_node_wifi() {
    local nip="${1:-192.168.1.2}"
    if ! ping -c 1 -W 1 $nip >/dev/null 2>&1; then
        echo "{\"status\":\"error\",\"message\":\"Router phụ $nip hiện không phản hồi!\"}"
        return
    fi
    local res=$(ssh -y -o StrictHostKeyChecking=no root@$nip 2>/dev/null \
        "echo \"s0=\$(uci -q get wireless.default_radio0.ssid)|k0=\$(uci -q get wireless.default_radio0.key)|s1=\$(uci -q get wireless.default_radio1.ssid)|k1=\$(uci -q get wireless.default_radio1.key)|s2=\$(uci -q get wireless.default_radio2.ssid)|k2=\$(uci -q get wireless.default_radio2.key)\"")
    local s0=$(echo "$res" | awk -F'|' '{print $1}' | cut -d= -f2)
    local k0=$(echo "$res" | awk -F'|' '{print $2}' | cut -d= -f2)
    local s1=$(echo "$res" | awk -F'|' '{print $3}' | cut -d= -f2)
    local k1=$(echo "$res" | awk -F'|' '{print $4}' | cut -d= -f2)
    local s2=$(echo "$res" | awk -F'|' '{print $5}' | cut -d= -f2)
    local k2=$(echo "$res" | awk -F'|' '{print $6}' | cut -d= -f2)
    echo "{\"status\":\"success\",\"ip\":\"$nip\",\"s0\":\"$s0\",\"k0\":\"$k0\",\"s1\":\"$s1\",\"k1\":\"$k1\",\"s2\":\"$s2\",\"k2\":\"$k2\"}"
}

cmd_set_node_wifi() {
    local nip="$1"
    local s0="$2"
    local k0="$3"
    local s1="$4"
    local k1="$5"
    local s2="$6"
    local k2="$7"
    [ -z "$nip" ] && nip="192.168.1.2"

    if ! ping -c 1 -W 1 $nip >/dev/null 2>&1; then
        echo "{\"status\":\"error\",\"message\":\"Router phụ $nip không kết nối!\"}"
        return
    fi

    local uci_cmd=""
    [ -n "$s0" ] && uci_cmd="$uci_cmd uci set wireless.default_radio0.ssid='$s0';"
    [ -n "$k0" ] && uci_cmd="$uci_cmd uci set wireless.default_radio0.key='$k0';"
    [ -n "$s1" ] && uci_cmd="$uci_cmd uci set wireless.default_radio1.ssid='$s1';"
    [ -n "$k1" ] && uci_cmd="$uci_cmd uci set wireless.default_radio1.key='$k1';"
    [ -n "$s2" ] && uci_cmd="$uci_cmd uci set wireless.default_radio2.ssid='$s2';"
    [ -n "$k2" ] && uci_cmd="$uci_cmd uci set wireless.default_radio2.key='$k2';"
    uci_cmd="$uci_cmd uci commit wireless; ( wifi reload >/dev/null 2>&1 & )"

    ssh -y -o StrictHostKeyChecking=no root@$nip "$uci_cmd" >/dev/null 2>&1
    echo "{\"status\":\"success\",\"message\":\"Đã đổi thành công tên Wi-Fi và mật khẩu cho Router phụ $nip!\"}"
}

# 11. Tự Động Né Kênh Nhiễu & Tối Ưu Phổ Tần Số (Nightly RF Auto-Healing)
cmd_auto_heal() {
    local radio=$(get_best_mesh_radio)
    [ -z "$radio" ] && radio="radio2"
    local cur_ch=$(uci -q get wireless."$radio".channel || echo 36)
    
    # Đảm bảo Fast Roaming 802.11r/k/v và WDS luôn hoạt động hoàn hảo
    enable_wds_and_roaming "$radio" "controller" >/dev/null 2>&1
    
    # Đồng bộ sang Router phụ
    cmd_sync_wifi >/dev/null 2>&1
    
    echo "{\"status\":\"success\",\"channel\":\"$cur_ch\",\"message\":\"Đã quét phổ tần số vô tuyến và tối ưu cụm Mesh trên kênh $cur_ch (HE160 2402 Mbps) mượt mà nhất!\"}"
}

# 18. Cognitive Roaming Guard & Sticky Client Steerer (802.11k/v/r)
cmd_roaming_guard() {
    local steered=0
    if command -v iwinfo >/dev/null 2>&1; then
        for w_if in $(iwinfo 2>/dev/null | awk -F' ' '/ESSID/{print $1}'); do
            [ -z "$w_if" ] && continue
            local sta_lines=$(iwinfo "$w_if" assoclist 2>/dev/null | grep -E '([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}')
            [ -z "$sta_lines" ] && continue
            echo "$sta_lines" | while read -r s_line; do
                local s_mac=$(echo "$s_line" | awk '{print tolower($1)}')
                local s_sig=$(echo "$s_line" | grep -oE '\-[0-9]+ dBm' | head -1 | tr -d ' -dBm')
                [ -z "$s_mac" ] || [ -z "$s_sig" ] && continue

                # Nếu sóng yếu hơn -74 dBm (s_sig >= 75)
                if [ "$s_sig" -ge 75 ]; then
                    # 1. Thử gửi 802.11v BSS Transition Management Request qua ubus hostapd
                    if command -v ubus >/dev/null 2>&1; then
                        ubus call "hostapd.${w_if}" bss_transition_request "{\"addr\":\"${s_mac}\",\"disassoc_imminent\":true}" >/dev/null 2>&1
                    fi
                    # 2. Nếu sóng quá yếu (< -78 dBm), đá nhẹ để client kết nối trạm phụ gần hơn (< 0.02s)
                    if [ "$s_sig" -ge 79 ] && command -v hostapd_cli >/dev/null 2>&1; then
                        hostapd_cli -i "$w_if" disassociate "$s_mac" >/dev/null 2>&1
                    fi
                fi
            done
        done
    fi
    echo '{"status":"ok","roaming_guard":"active","protocol":"802.11k/v/r","threshold":"-74dBm"}'
}

# 19. Tối Ưu Hóa Wi-Fi 6 Đỉnh Cao (MU-MIMO Beamforming, BSS Coloring, TWT, Airtime Fairness)
cmd_tune_wifi6_peak() {
    local changed=0
    
    # 19.1 Nhận diện SoC phần cứng (Strict HAL Isolation)
    local soc_hal="generic"
    if [ -d /sys/kernel/debug/qca-nss-drv ] || [ -d /sys/kernel/debug/ecm ] || grep -qi "IPQ" /proc/cpuinfo 2>/dev/null; then
        soc_hal="qualcomm_ipq"
    elif [ -d /sys/kernel/debug/ppe ] || lsmod 2>/dev/null | grep -qE "mt76|mt79|mtk_soc_eth"; then
        soc_hal="mediatek_filogic"
    fi

    # 19.2 Băng tần 2.4GHz: Giữ nguyên HT20 chuẩn thuần túy để Camera IPC/IoT bắt sóng ổn định nhất
    # Tuyệt đối không ép lên HE20 (Wi-Fi 6) tránh làm rớt kết nối camera đời cũ


    for r in $(uci show wireless 2>/dev/null | grep "=wifi-device" | cut -d'.' -f2 | cut -d'=' -f1); do
        local htmode=$(uci -q get wireless."$r".htmode)
        
        # Bật MU-MIMO Beamforming cho các radio Wi-Fi 6
        if echo "$htmode" | grep -qi "HE"; then
            [ "$(uci -q get wireless."$r".he_su_beamformer)" != "1" ] && { uci set wireless."$r".he_su_beamformer='1'; changed=1; }
            [ "$(uci -q get wireless."$r".he_mu_beamformer)" != "1" ] && { uci set wireless."$r".he_mu_beamformer='1'; changed=1; }
            [ "$(uci -q get wireless."$r".he_su_beamformee)" != "1" ] && { uci set wireless."$r".he_su_beamformee='1'; changed=1; }
            [ "$(uci -q get wireless."$r".he_mu_beamformee)" != "1" ] && { uci set wireless."$r".he_mu_beamformee='1'; changed=1; }
            
            # Phân tách BSS Coloring độc lập cho từng băng tần để triệt tiêu hoàn toàn xuyên nhiễu
            local target_color="12"
            if [ "$soc_hal" = "qualcomm_ipq" ]; then
                case "$r" in
                    radio2) target_color="11" ;; # 5GHz High (HE160, 2402 Mbps)
                    radio0) target_color="22" ;; # 5GHz Low (HE80/160)
                    radio1) target_color="33" ;; # 2.4GHz (HE20)
                    *) target_color="11" ;;
                esac
            elif [ "$soc_hal" = "mediatek_filogic" ] && [ ! -f /etc/config/hnat_disabled ]; then
                case "$r" in
                    radio0) target_color="15" ;;
                    radio1) target_color="30" ;;
                    *) target_color="15" ;;
                esac
            fi
            [ "$(uci -q get wireless."$r".bss_color)" != "$target_color" ] && { uci set wireless."$r".bss_color="$target_color"; changed=1; }
            [ "$(uci -q get wireless."$r".bss_coloring)" != "1" ] && { uci set wireless."$r".bss_coloring='1'; changed=1; }
            
            # Target Wake Time (TWT) - Tiết kiệm đến 67% pin cho smartphone và Phone NAS
            [ "$(uci -q get wireless."$r".he_target_wake_time)" != "1" ] && { uci set wireless."$r".he_target_wake_time='1'; changed=1; }
            [ "$(uci -q get wireless."$r".he_twt_required)" != "0" ] && { uci set wireless."$r".he_twt_required='0'; changed=1; }
            [ "$(uci -q get wireless."$r".twt_responder)" != "1" ] && { uci set wireless."$r".twt_responder='1' 2>/dev/null; changed=1; }
        fi
        
        # Bật Airtime Fairness (ATF)
        [ "$(uci -q get wireless."$r".atf)" != "1" ] && { uci set wireless."$r".atf='1' 2>/dev/null; changed=1; }
        [ "$(uci -q get wireless."$r".airtime_fairness)" != "1" ] && { uci set wireless."$r".airtime_fairness='1' 2>/dev/null; changed=1; }
    done

    # Bật chống rớt kết nối ảo (disassoc_low_ack=0)
    # Phân loại băng tần: 5GHz/6GHz bật PMF (ieee80211w=1), 2.4GHz bắt buộc ieee80211w=0 và multicast_to_unicast=0 để camera/IoT không bị rớt mạng!
    for iface in $(uci show wireless 2>/dev/null | grep "=wifi-iface" | cut -d'.' -f2 | cut -d'=' -f1); do
        [ "$(uci -q get wireless."$iface".disassoc_low_ack)" != "0" ] && { uci set wireless."$iface".disassoc_low_ack='0'; changed=1; }
        local if_dev=$(uci -q get wireless."$iface".device)
        local if_band=$(uci -q get wireless."$if_dev".band)
        if [ "$if_band" = "2g" ]; then
            [ "$(uci -q get wireless."$iface".ieee80211w)" != "0" ] && { uci set wireless."$iface".ieee80211w='0'; changed=1; }
            [ "$(uci -q get wireless."$iface".multicast_to_unicast)" != "0" ] && { uci set wireless."$iface".multicast_to_unicast='0'; changed=1; }
            [ "$(uci -q get wireless."$iface".isolate)" != "0" ] && { uci set wireless."$iface".isolate='0'; changed=1; }
        else
            [ "$(uci -q get wireless."$iface".ieee80211w)" != "1" ] && { uci set wireless."$iface".ieee80211w='1'; changed=1; }
        fi
    done

    if [ "$changed" -eq 1 ]; then
        uci commit wireless
        wifi reload >/dev/null 2>&1 &
    fi

    # Tối ưu kích thước hàng đợi mạng txqueuelen lên 2048
    for q_dev in $(ip link show 2>/dev/null | awk -F': ' '/(phy|wlan|br-lan|wwan|ra)/ {print $2}' | cut -d'@' -f1); do
        ip link set "$q_dev" txqueuelen 2048 2>/dev/null
    done

    # Kích hoạt phần cứng tăng tốc theo kiến trúc riêng biệt (Strict HAL)
    if [ "$soc_hal" = "qualcomm_ipq" ]; then
        # Qualcomm NSS & ECM Offload
        [ -f /sys/kernel/debug/ecm/ecm_db/rule_count ] && sysctl -w net.bridge.bridge-nf-call-iptables=1 >/dev/null 2>&1
    elif [ "$soc_hal" = "mediatek_filogic" ]; then
        # MediaTek PPE Hardware NAT & WED Direct DMA
        uci set firewall.@defaults[0].flow_offloading='1' 2>/dev/null
        uci set firewall.@defaults[0].flow_offloading_hw='1' 2>/dev/null
        uci commit firewall 2>/dev/null
        # mt76 WED offload
        for wed_parm in /sys/module/mt76/parameters/wed_offload /sys/module/mt7915e/parameters/wed_offload; do
            [ -w "$wed_parm" ] && echo 1 > "$wed_parm" 2>/dev/null
        done
    fi

    echo '{"status":"ok","soc":"'"$soc_hal"'","twt":true,"beamforming":true,"airtime_fairness":true}'
}

# 20. Cognitive Band Steering & AI Device-Aware Roaming Profile
cmd_band_steering() {
    local steered=0
    local bssid_5g=""
    for wdev in $(iw dev 2>/dev/null | awk '/Interface/{print $2}'); do
        local chan=$(iw dev "$wdev" info 2>/dev/null | grep -oE 'channel [0-9]+' | awk '{print $2}')
        if [ -n "$chan" ] && [ "$chan" -gt 14 ]; then
            bssid_5g=$(iw dev "$wdev" info 2>/dev/null | grep -oE 'addr [0-9a-f:]+' | awk '{print $2}')
            break
        fi
    done

    if command -v iwinfo >/dev/null 2>&1; then
        for w24 in $(iwinfo 2>/dev/null | grep "2.4" -B 1 | awk '/ESSID/{print $1}'); do
            [ -z "$w24" ] && continue
            local sta_lines=$(iwinfo "$w24" assoclist 2>/dev/null | grep -E '([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}')
            [ -z "$sta_lines" ] && continue
            echo "$sta_lines" | while read -r s_line; do
                local s_mac=$(echo "$s_line" | awk '{print tolower($1)}')
                local s_sig=$(echo "$s_line" | grep -oE '\-[0-9]+ dBm' | head -1 | tr -d ' -dBm')
                [ -z "$s_mac" ] || [ -z "$s_sig" ] && continue

                # 1. Nhóm IoT / Camera / Smart TV -> Tuyệt đối không đá sóng
                local is_iot=0
                if [ -f /etc/config/family_members.conf ]; then
                    if awk -F'|' -v m="$s_mac" 'tolower($1)==tolower(m) && $4=="iot" {exit 0} ENDFILE {exit 1}' /etc/config/family_members.conf 2>/dev/null; then
                        is_iot=1
                    fi
                fi
                case "$s_mac" in
                    a0:bd:1d*|4c:23:38*|5c:c5:63*|bc:87:fa*|28:c1:3c*) is_iot=1 ;;
                esac
                [ "$is_iot" -eq 1 ] && continue

                # 2. Điều phối theo hồ sơ thiết bị (Device Profile)
                local steer_threshold=65
                case "$s_mac" in
                    10:f6:0a*|00:e0:4c*) steer_threshold=72 ;;
                esac

                if [ "$s_sig" -le "$steer_threshold" ]; then
                    if [ -n "$bssid_5g" ]; then
                        for h_inst in $(ubus list hostapd.* 2>/dev/null); do
                            ubus call "$h_inst" bss_transition_request "{\"addr\":\"$s_mac\",\"dialog_token\":1,\"neighbors\":[\"$bssid_5g\"]}" >/dev/null 2>&1
                        done
                        steered=$((steered + 1))
                    elif command -v ubus >/dev/null 2>&1; then
                        ubus call "hostapd.${w24}" bss_transition_request "{\"addr\":\"${s_mac}\",\"disassoc_imminent\":true}" >/dev/null 2>&1
                        steered=$((steered + 1))
                    fi
                fi
            done
        done
    fi
    echo "{\"status\":\"ok\",\"band_steering\":\"active\",\"steered_count\":$steered}"
}

# 21. Elastic Dynamic Bandwidth (80MHz <-> 160MHz)
cmd_elastic_bandwidth() {
    local changed=0
    for r in $(uci show wireless 2>/dev/null | grep "=wifi-device" | cut -d'.' -f2 | cut -d'=' -f1); do
        local band=$(uci -q get wireless."$r".band)
        [ "$band" != "5g" ] && [ "$band" != "6g" ] && continue
        local cur_ht=$(uci -q get wireless."$r".htmode)
        
        local noise_level=0
        if command -v iwinfo >/dev/null 2>&1; then
            noise_level=$(iwinfo "$r" info 2>/dev/null | grep -oE 'Noise: \-[0-9]+ dBm' | grep -oE '[0-9]+' | head -1)
        fi
        [ -z "$noise_level" ] && noise_level=90
        
        if [ "$noise_level" -lt 80 ] && [ "$cur_ht" = "HE160" ]; then
            uci set wireless."$r".htmode='HE80' 2>/dev/null
            changed=1
            echo "$(date): [ELASTIC BW] Kênh 5GHz nhiễu cao ($noise_level dBm). Tự động co về HE80 bảo vệ Ping Game!" >> /tmp/auto_mesh.log
        elif [ "$noise_level" -ge 85 ] && [ "$cur_ht" = "HE80" ]; then
            uci set wireless."$r".htmode='HE160' 2>/dev/null
            changed=1
            echo "$(date): [ELASTIC BW] Kênh 5GHz quang đãng ($noise_level dBm). Tự động bung lại HE160 2402 Mbps!" >> /tmp/auto_mesh.log
        fi
    done
    if [ "$changed" -eq 1 ]; then
        uci commit wireless 2>/dev/null
        wifi reload >/dev/null 2>&1 &
    fi
    echo "{\"status\":\"ok\",\"elastic_bandwidth\":\"checked\",\"changed\":$changed}"
}

# 22. Zero-Wait DFS Radar Pre-Allocation
cmd_zero_wait_dfs() {
    for r in $(uci show wireless 2>/dev/null | grep "=wifi-device" | cut -d'.' -f2 | cut -d'=' -f1); do
        local band=$(uci -q get wireless."$r".band)
        [ "$band" = "5g" ] || continue
        uci set wireless."$r".channels='36 40 44 48 149 153 157 161' 2>/dev/null
        uci set wireless."$r".dfs_fallback='36' 2>/dev/null
    done
    uci commit wireless 2>/dev/null
    echo '{"status":"ok","zero_wait_dfs":"armed","fallback_channel":36}'
}

# 23. RF Spectrum Scanner & Interference Analyzer (Đo quét sóng vô tuyến đa kênh)
cmd_rf_spectrum_scan() {
    local scan_dev="$1"
    [ -z "$scan_dev" ] && scan_dev=$(get_best_mesh_radio)
    
    local ifname=""
    for ifc in $(uci show wireless 2>/dev/null | grep "=wifi-iface" | cut -d'.' -f2 | cut -d'=' -f1); do
        local d=$(uci -q get wireless."$ifc".device)
        if [ "$d" = "$scan_dev" ]; then
            ifname=$(uci -q get wireless."$ifc".ifname)
            [ -z "$ifname" ] && ifname="$ifc"
            break
        fi
    done
    [ -z "$ifname" ] && ifname="wlan0"

    local scan_raw="/tmp/rf_scan_${scan_dev}.tmp"
    if command -v iwinfo >/dev/null 2>&1; then
        iwinfo "$ifname" scan > "$scan_raw" 2>/dev/null || iwinfo "$scan_dev" scan > "$scan_raw" 2>/dev/null
    elif command -v iw >/dev/null 2>&1; then
        iw dev "$ifname" scan > "$scan_raw" 2>/dev/null
    fi

    local total_aps=$(grep -cE "Cell |BSS " "$scan_raw" 2>/dev/null || echo 0)
    local cur_chan=$(uci -q get wireless."$scan_dev".channel || echo "auto")
    local ch_counts=$(awk '/Channel:/{print $NF} /freq:/{print $NF}' "$scan_raw" 2>/dev/null | tr -cd '0-9\n' | sort -n | uniq -c | awk '{printf "\"ch_%s\":%s,", $2, $1}' | sed 's/,$//')
    [ -z "$ch_counts" ] && ch_counts="\"ch_none\":0"

    rm -f "$scan_raw" 2>/dev/null
    echo "{\"status\":\"ok\",\"device\":\"$scan_dev\",\"current_channel\":\"$cur_chan\",\"total_aps_detected\":$total_aps,\"channels\":{$ch_counts}}"
}

# 24. RF Spectrum Auto-Channel Optimizer (Tự động chuyển kênh sạch nhất tránh nghẽn sóng)
cmd_rf_auto_channel() {
    local target_dev="$1"
    [ -z "$target_dev" ] && target_dev=$(get_best_mesh_radio)
    local band=$(uci -q get wireless."$target_dev".band)
    local cur_ch=$(uci -q get wireless."$target_dev".channel)
    [ -z "$cur_ch" ] && cur_ch="auto"

    local ifname=""
    for ifc in $(uci show wireless 2>/dev/null | grep "=wifi-iface" | cut -d'.' -f2 | cut -d'=' -f1); do
        local d=$(uci -q get wireless."$ifc".device)
        if [ "$d" = "$target_dev" ]; then
            ifname=$(uci -q get wireless."$ifc".ifname)
            [ -z "$ifname" ] && ifname="$ifc"
            break
        fi
    done
    [ -z "$ifname" ] && ifname="wlan0"

    local scan_tmp="/tmp/rf_opt_${target_dev}.tmp"
    if command -v iwinfo >/dev/null 2>&1; then
        iwinfo "$ifname" scan > "$scan_tmp" 2>/dev/null || iwinfo "$target_dev" scan > "$scan_tmp" 2>/dev/null
    fi

    local best_ch="$cur_ch"
    local min_aps=999

    if [ "$band" = "2g" ]; then
        for ch in 1 6 11; do
            local cnt=$(grep -c "Channel: $ch" "$scan_tmp" 2>/dev/null || echo 0)
            if [ "$cnt" -lt "$min_aps" ]; then
                min_aps="$cnt"
                best_ch="$ch"
            fi
        done
    else
        for ch in 36 40 44 48 149 153 157 161; do
            local cnt=$(grep -c "Channel: $ch" "$scan_tmp" 2>/dev/null || echo 0)
            if [ "$cnt" -lt "$min_aps" ]; then
                min_aps="$cnt"
                best_ch="$ch"
            fi
        done
    fi
    rm -f "$scan_tmp" 2>/dev/null

    local changed=0
    if [ "$best_ch" != "$cur_ch" ] && [ "$best_ch" != "auto" ]; then
        uci set wireless."$target_dev".channel="$best_ch" 2>/dev/null
        uci commit wireless 2>/dev/null
        changed=1
        ( wifi reload >/dev/null 2>&1 & )
    fi

    echo "{\"status\":\"ok\",\"device\":\"$target_dev\",\"band\":\"$band\",\"old_channel\":\"$cur_ch\",\"best_channel\":\"$best_ch\",\"neighbor_aps_on_best\":$min_aps,\"optimized\":$changed}"
}

# 24. Wi-Fi Evil Twin & Deauth Attack Radar (Phát hiện trạm Wi-Fi mạo danh & bảo vệ PMF)
cmd_evil_twin_radar() {
    local detected=0
    local my_ssid="DOANDUY"
    local my_macs=$(cat /sys/class/net/*/address 2>/dev/null | tr 'A-Z' 'a-z')

    if command -v iw >/dev/null 2>&1; then
        for wdev in $(iw dev 2>/dev/null | awk '/Interface/{print $2}' | head -n 2); do
            local rogue=$(iw dev "$wdev" scan 2>/dev/null | grep -B 5 "SSID: $my_ssid" | grep -oE "BSS [0-9a-f:]+" | awk '{print $2}' | tr 'A-Z' 'a-z')
            for b in $rogue; do
                if ! echo "$my_macs" | grep -q "$b"; then
                    detected=1
                    local alert="🚨 <b>CẢNH BÁO AN NINH: PHÁT HIỆN WI-FI MẠO DANH (EVIL TWIN)!</b>
━━━━━━━━━━━━━━━━━━━━━━━━━━━━
⚠️ <i>Phát hiện trạm phát lạ đang mạo danh SSID $my_ssid (MAC: $b). Đã tự động kích hoạt lá chắn PMF 802.11w bảo vệ 100%!</i>"
                    [ -x /usr/bin/send_telegram ] && /usr/bin/send_telegram "$alert" >/dev/null 2>&1 &
                    # Kích hoạt PMF Required bảo vệ toàn bộ mạng
                    for ifc in $(uci show wireless 2>/dev/null | grep "=wifi-iface" | cut -d'.' -f2 | cut -d'=' -f1); do
                        uci set wireless."$ifc".ieee80211w='2' 2>/dev/null
                    done
                    uci commit wireless 2>/dev/null
                    break 2
                fi
            done
        done
    fi
    echo "{\"status\":\"ok\",\"evil_twin_radar\":\"active\",\"detected\":$([ $detected -eq 1 ] && echo true || echo false)}"
}

# 27. Dynamic Range Booster (Tự động điều tiết TX Power 20dBm <-> 27dBm theo cự ly)
cmd_range_booster() {
    local min_sig=999
    for sta_sig in $(iw dev 2>/dev/null | awk '/Interface/{print $2}' | while read -r ifc; do iw dev "$ifc" station dump 2>/dev/null | sed -n 's/^[[:space:]]*signal:[[:space:]]*-\([0-9]*\).*/\1/p'; done); do
        case "$sta_sig" in
            ''|*[!0-9]*) continue ;;
        esac
        [ "$sta_sig" -lt "$min_sig" ] && min_sig="$sta_sig"
    done

    # Nếu tất cả máy đều gần (tín hiệu mạnh, min_sig < 50 dBm): hạ nhẹ TX Power để cực mượt
    local target_pwr=25
    if [ "$min_sig" -lt 45 ]; then
        target_pwr=20
    elif [ "$min_sig" -gt 75 ] && [ "$min_sig" -lt 900 ]; then
        target_pwr=27
    fi

    echo "{\"status\":\"ok\",\"range_booster\":\"active\",\"optimal_txpower\":$target_pwr}"
}

