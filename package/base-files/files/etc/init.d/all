send_tg() {
    local c_id="$1"
    local msg="$2"
    local t_token="$3"
    [ -z "$t_token" ] && t_token=$(uci -q get telegram_bot.settings.bot_token)
    [ -z "$t_token" ] || [ -z "$c_id" ] && return 1
    curl -s -m 10 -d chat_id="$c_id" --data-urlencode "text=$msg" "https://api.telegram.org/bot${t_token}/sendMessage" >/dev/null 2>&1
}

logger -t hermes_edge "Hermes Edge Command Receiver started (PID: $$)"

last_offset=0
while true; do
    token=$(uci -q get telegram_bot.settings.bot_token)
    admin_id=$(uci -q get telegram_bot.settings.admin_chat_id)

    if [ -z "$token" ]; then
        sleep 30
        continue
    fi

    updates=$(curl -s -m 30 "https://api.telegram.org/bot${token}/getUpdates?offset=${last_offset}&timeout=25" 2>/dev/null)
    [ -z "$updates" ] && { sleep 3; continue; }

    update_ids=$(echo "$updates" | jsonfilter -e '$.result[*].update_id' 2>/dev/null)
    for uid in $update_ids; do
        [ -z "$uid" ] && continue
        last_offset=$(( uid + 1 ))

        msg_obj=$(echo "$updates" | jsonfilter -e "$.result[@.update_id=${uid}].message" 2>/dev/null)
        [ -z "$msg_obj" ] && continue

        from_id=$(echo "$msg_obj" | jsonfilter -e '$.chat.id' 2>/dev/null)
        text=$(echo "$msg_obj" | jsonfilter -e '$.text' 2>/dev/null)
        [ -z "$text" ] && continue

        if [ -z "$admin_id" ] && [ "$text" = "/start" ]; then
            uci set telegram_bot.settings.admin_chat_id="$from_id" 2>/dev/null
            uci commit telegram_bot 2>/dev/null
            admin_id="$from_id"
            send_tg "$from_id" "ðŸŽ‰ ÄÃ£ káº¿t ná»‘i Router Athena vá»›i Hermes Bot thÃ nh cÃ´ng! Chat ID: $from_id" "$token"
            continue
        fi

        [ "$from_id" != "$admin_id" ] && continue

        cmd=$(echo "$text" | awk '{print $1}')
        arg1=$(echo "$text" | awk '{print $2}')
        arg2=$(echo "$text" | awk '{$1=""; $2=""; print $0}' | sed 's/^[ \t]*//')

        case "$cmd" in
            /status)
                up=$(uptime | sed 's/.*up \([^,]*\), .*/\1/')
                m_load=$(uptime | awk -F'load average:' '{print $2}' | xargs)
                mem=$(free -m | awk '/Mem:/{printf "%d/%dMB (%.0f%%)", $3, $2, ($3/$2)*100}')
