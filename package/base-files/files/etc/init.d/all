if action == "rename" then
    local old_name = clean_filename(q.old_name)
    local new_name = clean_filename(q.new_name)
    if old_name and new_name then
        os.rename(current_dir .. old_name, current_dir .. new_name)
        print("Content-Type: application/json\r\n\r\n{\"status\":\"OK\"}")
    else
        print("Status: 400 Bad Request\r\nContent-Type: text/plain\r\n\r\nInvalid names")
    end
    return
end

-- Multi-tier download/view
if action == "download" or action == "view" then
    local name = clean_filename(q.name)
    if not name then
        print("Status: 400 Bad Request\r\nContent-Type: text/plain\r\n\r\nBad filename")
        return
    end

    local path, f = resolve_file(subfolder, name)
    if f == "REDIRECT" then
        if is_remote_client() then
            stream_remote_url(path, name, action == "view" or q.inline == "1")
            return
        else
            print("Status: 302 Found\r\nLocation: " .. path .. "\r\n\r")
            return
        end
    elseif f == "CLOUD_STREAM" then
        stream_cloud_file(path, name, action == "view" or q.inline == "1")
        return
    elseif f == "DIR" then
        stream_dir(path, name)
        return
    elseif f then
        stream_file(f, path, name, action == "view" or q.inline == "1")
        return
    else
        print("Status: 404 Not Found\r\nContent-Type: text/plain\r\n\r\nFile Not Found")
        return
    end
end

if action == "delete" then
    local name = clean_filename(q.name)
    if name then
        os.execute("rm -rf '" .. current_dir .. name .. "'")
        local alt_storage = (STORAGE == PRIMARY_STORAGE) and FALLBACK_STORAGE or PRIMARY_STORAGE
        os.execute("rm -rf '" .. alt_storage .. (subfolder ~= "" and (subfolder .. "/") or "") .. name .. "'")
    end
    print("Content-Type: application/json\r\n\r\n{\"status\":\"OK\"}")
    return
end

