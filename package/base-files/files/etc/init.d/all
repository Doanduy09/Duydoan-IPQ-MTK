                    E('td', { class: 'td left label-col', style: labelStyle }, _('\uD83C\uDFAE Game & M\u1EA1ng X\u00E3 H\u1ED9i (QoS)')), 
                    E('td', { class: 'td left', style: valStyle }, gameQosWidget) 
                ]),
                E('tr', { class: 'tr' }, [ 
                    E('td', { class: 'td left label-col', style: labelStyle }, _('\uD83C\uDF10 \u0110\u1ECBa ch\u1EC9 IP LAN & N\u1EA1p \u1EA2nh Ph\u1EA7n M\u1EC1m')), 
                    E('td', { class: 'td left', style: valStyle }, lanIpRowWidget) 
                ]),
                E('tr', { class: 'tr' }, [ 
                    E('td', { class: 'td left label-col', style: labelStyle }, _('\uD83D\uDEE1\uFE0F Camera AI Sentinel 24/7')), 
                    E('td', { class: 'td left', style: valStyle }, sentinelOverviewRowWidget) 
                ])
            ])
        ]);
        var flashFirmwareCard = E('div', { id: 'flash-firmware-box-card', style: 'display: none;' });

        var activeCountdowns = {};
        setInterval(function() {
            var nowSec = Math.floor(Date.now() / 1000);
            Object.keys(activeCountdowns).forEach(function(mac) {
                var item = activeCountdowns[mac];
                var rem = item.expire - nowSec;
                if (rem > 0) {
                    var m = Math.floor(rem / 60);
                    var s = rem % 60;
                    item.el.textContent = '🟢 Đang hoạt động bình thường (còn ' + m + 'p ' + (s < 10 ? '0' : '') + s + 's)';
                    item.el.style.color = '#15803d';
                } else {
                    item.el.textContent = '⛔ Hết thời gian cấp phép (Đã chặn)';
                    item.el.style.color = '#dc2626';
                    delete activeCountdowns[mac];
                }
            });
        }, 1000);

        var adshieldStatusBadge = E('span', { 
            id: 'adshield-status-badge',
            'data-active': initAdAct ? '1' : '0',
            'data-rules': String(initRules),
            style: 'display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 800; ' +
                   (initAdAct ? 'background: #ffffff; color: #000000; border: 1px solid #86efac;' : 'background: #ffffff; color: #000000; border: 1px solid #cbd5e1;')
        }, initAdAct ? ('🟢 Micro AdShield: Đang Bật (' + initRules + ' quy tắc | DNS Hijack: BẬT | 0-RAM 0-Flash)') : '⚪ Micro AdShield: Đang Tắt');

        var adshieldFamilyBadge = E('span', {
            id: 'adshield-family-badge',
            'data-family': initAdFam ? '1' : '0',
            style: 'display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 800; ' +
                   (initAdFam ? 'background: #ffffff; color: #000000; border: 1px solid #7dd3fc;' : 'background: #ffffff; color: #000000; border: 1px solid #cbd5e1;')
        }, initAdFam ? '👶 Bảo Vệ Trẻ Em: Đang Bật (SafeSearch)' : '⚪ Chế Độ Trẻ Em: Tắt');

        var btnToggleAdShield = E('button', {
            class: 'btn cbi-button',
            id: 'btn-toggle-adshield-panel',
            'data-active': initAdAct ? '1' : '0',
            style: 'font-weight: 800; font-size: 12px; padding: 6px 14px; border-radius: 6px; color: #000000 !important; cursor: pointer; border: none; ' +
                   (initAdAct ? 'background: #ffffff !important;' : 'background: #ffffff !important;'),
            click: function(e) {
                var btn = document.getElementById('btn-toggle-adshield-panel') || e.target;
                var isAct = btn.getAttribute('data-active') === '1';
                btn.textContent = '⏳ Đang xử lý...';
                callSetAdShield(isAct ? 'off' : 'on').then(function(r) {
                    updateAdShieldUI();
                    ui.addNotification(null, E('p', isAct ? '🛑 Đã tắt Micro AdShield!' : '🛡️ Đã bật Micro AdShield & Chống Bypass DNS!'), 'info');
                }).catch(function(err) {
                    ui.addNotification(null, E('p', '❌ Lỗi: ' + (err.message || err)), 'error');
                    updateAdShieldUI();
                });
            }
        }, initAdAct ? '🛑 Tắt AdShield' : '🛡️ Bật AdShield');

        var btnToggleFamily = E('button', {
            class: 'btn cbi-button',
            id: 'btn-toggle-adshield-family',
            'data-family': initAdFam ? '1' : '0',
            style: 'font-weight: 800; font-size: 12px; padding: 6px 14px; border-radius: 6px; color: #000000; cursor: pointer; border: none; ' +
                   (initAdFam ? 'background: #ffffff;' : 'background: #ffffff;'),
            click: function(e) {
                var btn = document.getElementById('btn-toggle-adshield-family') || e.target;
                var isFam = btn.getAttribute('data-family') === '1';
                btn.textContent = '⏳ Đang xử lý...';
                callSetAdShield(isFam ? 'family_off' : 'family_on').then(function(r) {
                    updateAdShieldUI();
                    ui.addNotification(null, E('p', isFam ? '👶 Đã tắt Chế Độ Trẻ Em.' : '👶 Đã bật Chế Độ Trẻ Em & SafeSearch!'), 'info');
                }).catch(function(err) {
                    ui.addNotification(null, E('p', '❌ Lỗi: ' + (err.message || err)), 'error');
                    updateAdShieldUI();
                });
            }
        }, initAdFam ? '👶 Tắt Trẻ Em' : '👶 Bật Trẻ Em');

        var btnReloadRules = E('button', {
            class: 'btn cbi-button',
            style: 'font-weight: 700; font-size: 12px; padding: 6px 12px; border-radius: 6px; background: #ffffff; color: #000000; border: 1px solid #cbd5e1; cursor: pointer;',
            click: function(e) {
                e.target.textContent = '⏳...';
                callSetAdShield('refresh').then(function(r) {
                    e.target.textContent = '🔄 Làm Mới';
                    updateAdShieldUI();
                    ui.addNotification(null, E('p', '🎉 ' + (r.message || 'Đã làm mới bộ lọc!')), 'info');
                }).catch(function(err) {
                    e.target.textContent = '🔄 Làm Mới';
                    ui.addNotification(null, E('p', '❌ Lỗi: ' + (err.message || err)), 'error');
                });
