media-coccoc.com
qc.coccoc.com
qc.coccoc.vn
banners-gallery.coccoc.com
media-ad.vn
vietad.vn
novanet.vn
tracking.shopee.vn
ads.shopee.vn
ads.zalo.me
tracking.zalo.me
adsmol.zaloapp.com
ads.tiktok.com
analytics.tiktok.com
log.byteoversea.com

# SMART TV (SAMSUNG, LG) & HARDWARE TELEMETRY ADS
samsungads.com
smetrics.samsung.com
config.samsungads.com
gpm.samsungqbe.com
log-config.samsungacs.com
lgtvcommon.com
ssp.lgtvcommon.com
ad.lgappstv.com
ibs.lgappstv.com
tracking.miui.com
data.mistat.xiaomi.com
ad.xiaomi.com
sdkconfig.ad.xiaomi.com

# GLOBAL POPUP, BANNER, NATIVE ADS & TRACKERS
taboola.com
outbrain.com
popads.net
popcash.net
propellerads.com
mgid.com
adsterra.com
