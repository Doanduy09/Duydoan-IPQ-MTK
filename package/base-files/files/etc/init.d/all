                fetch('/cgi-bin/airdrop?action=mesh_unmesh')
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        ui.hideModal();
                        try { sessionStorage.setItem('luci_weather_active_tab', 'main'); } catch(e) {}
                        closeAllTabs();
                        ui.addNotification(null, E('p', '✅ ' + (data.message || 'Đã tắt hoàn toàn chế độ Mesh! Router đã trở về chế độ Wi-Fi Độc Lập.')), 'info');
                    }).catch(function(err) {
                        ui.hideModal();
                        btn.disabled = false;
                        btn.textContent = '⛔ TẮT CHẾ ĐỘ MESH';
                        ui.addNotification(null, E('p', '❌ Lỗi tắt Mesh: ' + err), 'error');
                    });
            }
        }, '⛔ TẮT CHẾ ĐỘ MESH');

        var btnSetMaster = E('button', {
            class: 'btn cbi-button',
            style: 'background: #ffffff; color: #000000; font-size: 13.5px; font-weight: 800; padding: 11px 18px; border-radius: 8px; cursor: pointer; border: none; box-shadow: 0 2px 4px rgba(2, 132, 199, 0.2);',
            click: function(ev) {
                if (!confirm('Xác nhận đặt thiết bị này làm ROUTER PHÁT CHÍNH (Master Controller)?\n- IP LAN sẽ giữ nguyên 192.168.1.1\n- Bật máy chủ DHCP và phát sóng Backhaul SysMesh_Athena.')) return;
