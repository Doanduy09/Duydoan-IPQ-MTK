                    adshieldStatusBadge,
                    adshieldFamilyBadge
                ]),
                E('div', { style: 'font-size: 12px; color: #000000; font-weight: 600;' }, 'Chống Bypass DNS qua NAT Port 53, chặn DoH/DoT, ngăn chặn cờ bạc, lừa đảo và ép SafeSearch (0% RAM tiêu thụ, 0% hao mòn Flash).')
            ]),
