    cat << 'CMDSETICCID' > /usr/bin/set_iccid
#!/bin/sh
CMD_NAME=$(basename "$0" | tr -d '\r')
INPUT=$(echo "$*" | tr -d '\r')
ICCID=""

if echo "$CMD_NAME" | grep -qE '^[0-9]{15,22}$'; then
    ICCID="$CMD_NAME"
elif echo "$INPUT" | grep -qE '[0-9]{15,22}'; then
    ICCID=$(echo "$INPUT" | grep -oE '[0-9]{15,22}' | head -n 1)
elif [ -n "$1" ]; then
    ICCID=$(echo "$1" | tr -d '\r')
fi

if [ -z "$ICCID" ]; then
    echo "══════════════════════════════════════════════════════════════"
    echo "  📱 CÀI ĐẶT SIM ICCID MẶC ĐỊNH (BẢO MẬT)"
    echo "══════════════════════════════════════════════════════════════"
    echo " 💡 CÁCH DÙNG: Dán số ICCID (18-22 số) vào terminal!"
    echo "    Hoặc gõ:   set_iccid <SỐ_ICCID>  (hoặc iccid <SỐ_ICCID>)"
    cur_ic=$(cat /etc/config/default_sim_iccid 2>/dev/null | tr -d ' \r\n')
    if [ -n "$cur_ic" ] && [ ${#cur_ic} -ge 10 ]; then
        h=$(echo "$cur_ic" | cut -c1-6)
        t=$(echo "$cur_ic" | awk '{print substr($0, length($0)-3, 4)}')
        echo "    Hiện tại:  ${h}******${t} (Đã mã hóa bảo mật)"
    else
        echo "    Hiện tại:  Chưa cấu hình"
    fi
    echo " 🔒 Lưu ý: Để chống lộ số SIM cho người lạ xem trộm,"
    echo "    thông tin SIM chỉ được phép nạp qua SSH và Telegram Bot!"
    echo "══════════════════════════════════════════════════════════════"
    exit 1
fi

