if [ "$dow" -eq 7 ] || [ "$1" = "--fstrim" ]; then
    if command -v fstrim >/dev/null 2>&1; then
        echo "$(date): Đang kích hoạt fstrim wear-leveling cho ổ eMMC 128GB..." >> "$LOG_FILE"
        trim_out=$(fstrim -v /mnt/storage 2>/dev/null || fstrim -v /overlay 2>/dev/null)
        echo "$(date): [FSTRIM] $trim_out" >> "$LOG_FILE"
        mkdir -p /mnt/storage/.blackbox /tmp/.blackbox 2>/dev/null
        echo "$(date '+%Y-%m-%d %H:%M:%S') [WEEKLY_FSTRIM] $trim_out" >> /mnt/storage/.blackbox/flight_recorder.log 2>/dev/null
    fi
fi

# 2.2 HEURISTIC WEEKLY TRAFFIC FORECAST & HARDWARE PRE-WARMING
