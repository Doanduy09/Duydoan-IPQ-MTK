    elseif cmd == "protect_battery_on" then
        run_adb("'settings put global protect_battery 1'")
        print("Content-Type: application/json; charset=utf-8\r\n\r\n{\"success\":true,\"message\":\"ÄÃ£ báº­t cháº¿ Ä‘á»™ báº£o vá»‡ pin (85%)\"}")
