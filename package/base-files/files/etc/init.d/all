    cat << 'CCTV_PURGE_EOF' > /usr/bin/cctv_retention_purge.sh
#!/bin/sh
# ==============================================================================
# 🧹 SYSFIXTINE CCTV ROLLING RETENTION PURGE ENGINE v3.0
# Automatic 15-Day Rolling Delete via Telegram deleteMessage API
# Automatic Google Drive Retention Purge via rclone
# ==============================================================================

CONFIG_FILE="/etc/config/cctv_bot"
RETENTION_DIR="/tmp/cctv_retention"

log_msg() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [RETENTION] $1"
    logger -t cctv_retention "$1"
}

retention_days=$(uci -q get cctv_bot.global.retention_days || echo "15")
[ -z "$retention_days" ] && retention_days=15
cutoff_sec=$(( retention_days * 86400 ))
now=$(date +%s)
threshold=$(( now - cutoff_sec ))

log_msg "Starting retention purge (Retention: ${retention_days} days, Cutoff TS: $threshold)..."

# 1. PURGE EXPIRED TELEGRAM MESSAGES
if [ -d "$RETENTION_DIR" ]; then
    for hist in "$RETENTION_DIR"/history_*.log; do
        [ ! -f "$hist" ] && continue
        cam_id=$(basename "$hist" | sed 's/history_//;s/\.log//')
        tmp_hist="${hist}.tmp.$$"
        del_count=0
        
        while IFS=':' read -r ts mid cid tok; do
            [ -z "$ts" ] || [ -z "$mid" ] || [ -z "$cid" ] || [ -z "$tok" ] && continue
            
            if [ "$ts" -lt "$threshold" ]; then
                # Message is older than retention period -> Delete from Telegram
                log_msg "Deleting message $mid on Telegram (Cam: $cam_id, Age: $(( (now - ts) / 86400 )) days)..."
                curl -s -m 5 -X POST "https://api.telegram.org/bot${tok}/deleteMessage" \
                    -d "chat_id=${cid}&message_id=${mid}" >/dev/null 2>&1
                del_count=$(( del_count + 1 ))
            else
                # Keep active message in history
                echo "${ts}:${mid}:${cid}:${tok}" >> "$tmp_hist"
            fi
        done < "$hist"
        
        if [ -f "$tmp_hist" ]; then
            mv -f "$tmp_hist" "$hist"
        else
            rm -f "$hist"
        fi
        log_msg "Purged $del_count expired Telegram messages for camera [$cam_id]."
    done
fi

# 2. PURGE EXPIRED GOOGLE DRIVE FILES
if command -v rclone >/dev/null 2>&1; then
    log_msg "Running Google Drive rolling retention purge (--min-age ${retention_days}d)..."
    rclone delete "gdrive:CCTV/" --min-age "${retention_days}d" 2>/dev/null
fi

# 3. PURGE OVERDUE RAM BUFFER FILES (> 24 HOURS UNPROCESSED)
find /tmp/cctv_ram_buffer -name "*.mp4" -mtime +1 -delete 2>/dev/null

log_msg "Retention purge completed successfully."
exit 0
CCTV_PURGE_EOF
    chmod 755 /usr/bin/cctv_retention_purge.sh 2>/dev/null
    ln -sf /usr/bin/cctv_retention_purge.sh /usr/bin/cctv_purge 2>/dev/null

    cat << 'NVR_FLUSH_EOF' > /usr/bin/nvr_night_flusher.sh
#!/bin/sh
# ==============================================================================
# 🌙 SYSFIXTINE NIGHTTIME BULK CLOUD SYNC & FLUSHER v4.0
# Tự động đồng bộ toàn bộ video đã tích lũy trên eMMC NAS lên Google Drive
# Chạy vào khung giờ đêm (01:00 - 05:00 sáng) khi cả nhà ngủ say, 0 máy dùng mạng
# Sóng 5G ban đêm đạt tốc độ Upload cực đại (50 - 70 Mbps)
# Module System Storage Sync (2026)
# ==============================================================================

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export TZ=Asia/Ho_Chi_Minh

NAS_BASE="/mnt/storage/airdrop/Camera_NAS"
QUEUE_FILE="/tmp/cctv_night_queue.list"
LOG_FILE="/tmp/nvr_night_flusher.log"
LOCK_FILE="/var/run/nvr_night_flusher.lock"

exec 220>"$LOCK_FILE"
flock -x -n 220 2>/dev/null || exit 0

log_msg() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [NIGHT_FLUSHER] $1" >> "$LOG_FILE"
    logger -t nvr_night_flusher "$1"
}

send_tg_summary() {
    local text="$1"
    if [ -x /usr/bin/send_telegram ]; then
        /usr/bin/send_telegram "$text" >/dev/null 2>&1 &
    fi
}

run_nightly_sync() {
    log_msg "Starting Nightly Bulk Cloud Sync at off-peak hours..."

    if ! command -v rclone >/dev/null 2>&1; then
        log_msg "rclone not found. Skipping Google Drive sync."
        return 1
    fi

    # Kiểm tra Google Drive remote
    if ! rclone listremotes 2>/dev/null | grep -q "^gdrive:"; then
        log_msg "Google Drive remote (gdrive:) not configured. Skipping."
        return 1
    fi

    local synced_cnt=0
    local synced_bytes=0

    # 1. Đồng bộ các video từ danh sách chờ (Queue) nếu có
    if [ -f "$QUEUE_FILE" ] && [ -s "$QUEUE_FILE" ]; then
        log_msg "Processing queued files from $QUEUE_FILE..."
        while IFS= read -r fpath; do
            [ ! -f "$fpath" ] && continue
            local cam_dir=$(dirname "$fpath" | xargs dirname | xargs basename)
            [ -z "$cam_dir" ] && cam_dir="General"
            
            local f_sz=$(wc -c < "$fpath" 2>/dev/null || echo 0)
            log_msg "Syncing queued file: $fpath (${f_sz} bytes) -> gdrive:CCTV/${cam_dir}/"
            
            nice -n 19 rclone copy "$fpath" "gdrive:CCTV/${cam_dir}/" --bwlimit 30M 2>/dev/null
            if [ $? -eq 0 ]; then
                synced_cnt=$(( synced_cnt + 1 ))
                synced_bytes=$(( synced_bytes + f_sz ))
            fi
        done < "$QUEUE_FILE"
        rm -f "$QUEUE_FILE"
    fi

    # 2. Quét toàn bộ thư mục NAS quay trong ngày hôm nay và hôm qua
    if [ -d "$NAS_BASE" ]; then
        local today=$(date '+%Y-%m-%d')
        local yest=$(date -d "@$(( $(date +%s) - 86400 ))" '+%Y-%m-%d' 2>/dev/null || echo "")
        
        for d in "$today" "$yest"; do
            [ -z "$d" ] && continue
            for cam_folder in "$NAS_BASE"/*/"$d"; do
                [ ! -d "$cam_folder" ] && continue
                local cname=$(basename "$(dirname "$cam_folder")")
                log_msg "Syncing NAS directory: $cam_folder -> gdrive:CCTV/${cname}/${d}/"
                
                # Chạy rclone copy cả thư mục với nice 19 và bwlimit 30M
                nice -n 19 rclone copy "$cam_folder" "gdrive:CCTV/${cname}/${d}/" --bwlimit 30M 2>/dev/null
                if [ $? -eq 0 ]; then
                    local f_in_dir=$(ls -1 "$cam_folder"/*.mkv "$cam_folder"/*.mp4 2>/dev/null | wc -l)
                    synced_cnt=$(( synced_cnt + f_in_dir ))
                fi
            done
        done
    fi

    # 3. Gửi thông báo tổng kết ban đêm lên Telegram
    local size_mb=$(( synced_bytes / 1048576 ))
    [ "$size_mb" -eq 0 ] && size_mb=$(du -sm "$NAS_BASE" 2>/dev/null | awk '{print $1}')

    log_msg "Nightly sync completed. Synced $synced_cnt files (~${size_mb} MB)."

    if [ "$synced_cnt" -gt 0 ]; then
        send_tg_summary "🌙 <b>ĐỒNG BỘ CLOUD BAN ĐÊM HOÀN TẤT!</b>
━━━━━━━━━━━━━━━━━━━
📦 <b>Số lượng video:</b> <b>${synced_cnt} clip</b>
💾 <b>Tổng dữ liệu:</b> <b>~${size_mb} MB</b>
☁️ <b>Đích đến:</b> Google Drive (CCTV/)
⚡ <b>Tốc độ 5G đêm:</b> Đạt đỉnh, không ảnh hưởng bất kỳ ai
💡 <i>Đường truyền gia đình cả ngày hôm nay hoàn toàn thông suốt!</i>"
    fi

    return 0
}

case "$1" in
    run|sync|now|"")
        run_nightly_sync
        ;;
    test)
        echo "Testing nightly sync..."
        run_nightly_sync
        ;;
    *)
        echo "Usage: $0 {run|test}"
        ;;
esac
