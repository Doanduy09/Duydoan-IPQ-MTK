            { mac: '00:e0:4c:68:01:45', ip: '192.168.1.2', name: 'Anh Duy (PC DOANDUY LAN)', type: 'work', badge: '💼 VIP Game & Work', detail: 'Độ trễ thấp eSport (EF)', bg: '#eff6ff', color: '#1d4ed8', border: '#bfdbfe' },
