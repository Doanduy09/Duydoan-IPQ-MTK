total_ram=$(awk '/MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 500000)
tot_ram_mb=$((total_ram / 1024))
if [ "$tot_ram_mb" -lt 1500 ]; then
    before_avail=$(awk '/MemAvailable:/ {print $2}' /proc/meminfo 2>/dev/null || awk '/MemFree:/ {print $2}' /proc/meminfo 2>/dev/null || echo 250000)
    sync
    echo 3 > /proc/sys/vm/drop_caches
    after_avail=$(awk '/MemAvailable:/ {print $2}' /proc/meminfo 2>/dev/null || awk '/MemFree:/ {print $2}' /proc/meminfo 2>/dev/null || echo 300000)
    freed_kb=$((after_avail - before_avail))
    [ "$freed_kb" -lt 0 ] && freed_kb=0
    freed_mb=$((freed_kb / 1024))
    echo "$(date): Đã giải phóng ${freed_mb}MB RAM đệm cho thiết bị RAM thấp." >> "$LOG_FILE"
else
    sync
    [ -f /proc/sys/vm/compact_memory ] && echo 1 > /proc/sys/vm/compact_memory 2>/dev/null
    echo "$(date): Router 2GB DDR4 - Bảo lưu Pagecache tốc độ cao (Chống nghẽn I/O & đơ giật giao diện LuCI)." >> "$LOG_FILE"
fi

# 5. Đồng bộ giờ chuẩn quốc tế NTP
ntpd -q -p time.google.com -p time.cloudflare.com -p pool.ntp.org >/dev/null 2>&1 &
echo "$(date): Đã đồng bộ lại giờ hệ thống NTP." >> "$LOG_FILE"

# 6. Ghi nhật ký bảo trì im lặng (Không gửi Telegram và không phát TTS vào ban đêm)
echo "$(date): Đã hoàn tất bảo trì đêm tĩnh lặng 04:00 AM (AdShield: ${rule_cnt} rules). Báo cáo sẽ gửi lúc 07:00 sáng." >> "$LOG_FILE"
echo "$(date): === HOÀN THÀNH BẢO TRÌ 04:00 AM ===" >> "$LOG_FILE"
