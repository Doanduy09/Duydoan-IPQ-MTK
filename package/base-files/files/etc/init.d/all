/etc/init.d/firewall reload >/dev/null 2>&1

echo "SUCCESS: Đã kích hoạt Phone NAS thành công cho [$PHONE_DISPLAY_NAME] (Android $ANDROID_VER) tại $DEV_IP!"
exit 0
NAS_PHONE_AUTO_SETUP_EOF
    chmod +x /usr/bin/nas_phone_auto_setup.sh

