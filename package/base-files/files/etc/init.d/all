                return;
            }
            let html = '';
            phones.forEach(p => {
                const isOnline = p.online || (p.status && p.status.includes('trực tuyến'));
                const badge = isOnline ? 
                    `<span style="background:rgba(16,185,129,0.2); color:#4ade80; border:1px solid rgba(16,185,129,0.4); padding:2px 8px; border-radius:12px; font-weight:700;">🟢 ${p.ping || 'Online'}</span>` : 
                    `<span style="background:rgba(239,68,68,0.2); color:#f87171; border:1px solid rgba(239,68,68,0.4); padding:2px 8px; border-radius:12px; font-weight:700;">🔴 Mất kết nối</span>`;
                const folderSlug = p.folder_slug || ('Phones/' + (p.name || p.ip).replace(/[^\w-]/g, '_'));
                const authBadge = p.has_pass ? 
                    `<span style="color:#38bdf8; font-size:0.75rem;">🔒 Mật khẩu OK</span>` : 
                    `<span style="color:var(--text-muted); font-size:0.75rem;">🔓 Không mật khẩu</span>`;

                html += `
                    <tr style="border-bottom:1px solid var(--border-color);">
                        <td style="padding:10px; font-weight:700; color:#fff;">
                            📱 ${escapeHtml(p.name)}
                            ${(p.battery !== undefined && p.battery >= 0) ? `<br><span style="font-size:0.75rem; color:#facc15; font-weight:normal;">🔋 ${p.battery}% ${p.charging ? '⚡ (Đang sạc)' : '❌ (Chưa sạc)'}</span>` : `<br><span style="font-size:0.75rem; color:#94a3b8; font-weight:normal;">🔌 ADB: Chưa kết nối</span>`}
                        </td>
                        <td style="padding:10px; font-family:monospace; color:var(--primary-neon);">
                            ${escapeHtml(p.ip)}:${escapeHtml(p.port || '8080')}<br>
                            <span style="color:var(--text-sub); font-size:0.7rem;">📁 ${escapeHtml(p.folder || 'DATA NASS')}</span>
                        </td>
                        <td style="padding:10px;">${authBadge}</td>
                        <td style="padding:10px;">${badge}</td>
                        <td style="padding:10px; text-align:right;">
                            <div style="display:flex; gap:6px; justify-content:flex-end; flex-wrap:wrap;">
                                <button class="btn-sub" style="padding:3px 8px; font-size:0.75rem;" title="Mở NAS" onclick="switchFolder('${escapeHtml(folderSlug)}'); closeModal('nasConfigModal');">📂 Mở</button>
                                <button class="btn-sub" style="padding:3px 8px; font-size:0.75rem; border-color:#38bdf8; color:#38bdf8;" title="Xem màn hình & điều khiển từ xa qua ADB" onclick="openPhoneRemote('${escapeHtml(p.ip)}', '${escapeHtml(p.name)}')">📱 Màn Hình</button>
                                <button class="btn-sub" style="padding:3px 8px; font-size:0.75rem;" title="Kiểm tra kết nối" onclick="testPhoneNode('${escapeHtml(p.ip)}', '${escapeHtml(p.port)}')">🧪 Test</button>
                                <button class="btn-sub" style="padding:3px 8px; font-size:0.75rem;" title="Thiết lập 1-Click Zero-Root qua ADB" onclick="triggerPhoneAutoSetup('${escapeHtml(p.ip)}')">⚡ Setup 1-Click</button>
                                <button class="btn-sub" style="padding:3px 8px; font-size:0.75rem; border-color:#00ffcc; color:#00ffcc;" title="Đo tốc độ Đọc/Ghi & Thẩm định độ bền chip nhớ" onclick="triggerPhoneDiskBench('${escapeHtml(p.ip)}')">💾 Đo Ổ Cứng</button>
                                <button class="btn-sub" style="padding:3px 8px; font-size:0.75rem;" title="Sao lưu ảnh DCIM về eMMC 128GB" onclick="triggerBackupPhotos()">📸 Backup Ảnh</button>
                                <button class="btn-sub" style="padding:3px 8px; font-size:0.75rem;" title="Đồng bộ ngay" onclick="syncPhoneNode('${escapeHtml(p.id)}', '${escapeHtml(p.name)}', '${escapeHtml(p.ip)}')">🔄 Sync</button>
                                <button class="btn-sub" style="padding:3px 8px; font-size:0.75rem; border-color:var(--accent-red); color:var(--accent-red);" title="Xóa" onclick="deletePhoneNode('${escapeHtml(p.id)}')">🗑️</button>
                            </div>
                        </td>
                    </tr>
                `;
            });
            tbody.innerHTML = html;
        }

        function renderCloudTable(clouds) {
