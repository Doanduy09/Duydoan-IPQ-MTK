#!/bin/sh
# /usr/bin/airdrop_cli.sh - Helper script for Telegram Bot & Web integration
STORAGE="/mnt/storage/airdrop"
[ ! -d "$STORAGE" ] && STORAGE="/overlay/airdrop"
mkdir -p "$STORAGE"

get_storage_info() {
    [ -d "/mnt/storage/airdrop" ] && STORAGE="/mnt/storage/airdrop"
    df_line=$(df -h "$STORAGE" 2>/dev/null | tail -n 1)
    dev=$(echo "$df_line" | awk '{print $1}')
    total=$(echo "$df_line" | awk '{print $2}')
    avail=$(echo "$df_line" | awk '{print $4}')
    stype="Bộ nhớ tạm Overlay"
    case "$dev" in
        *mmcblk0p27*|*mmcblk0*|*storage*) stype="Bộ nhớ eMMC 128GB siêu tốc" ;;
        *sd*|*usb*) stype="Ổ cứng / USB ngoài" ;;
        *cifs*|*smb*|*rclone*|*dav*|*pc_storage*) stype="Mượn ổ cứng Laptop/PC qua LAN" ;;
    esac
}

case "$1" in
    list)
        count=$(ls -1 "$STORAGE" 2>/dev/null | wc -l)
        total_size=$(du -sh "$STORAGE" 2>/dev/null | awk '{print $1}')
        [ -z "$total_size" ] && total_size="0 B"
        get_storage_info
        
        echo "COUNT=$count"
        echo "TOTAL=$total_size"
        echo "AVAIL=$avail"
        echo "TYPE=$stype"
        if [ "$count" -eq 0 ]; then
            echo "EMPTY"
        else
            echo "FILES:"
            ls -lt "$STORAGE" 2>/dev/null | awk 'NR>1 {printf "• %s (%s)\n", $9, $5}' | head -n 10
        fi
        ;;
    clear)
        rm -rf "$STORAGE"/*
        echo "CLEARED"
        ;;
    status|stats)
        count=$(ls -1 "$STORAGE" 2>/dev/null | wc -l)
        total_size=$(du -sh "$STORAGE" 2>/dev/null | awk '{print $1}')
        [ -z "$total_size" ] && total_size="0 B"
        get_storage_info
        echo "{\"count\":$count,\"total_size\":\"$total_size\",\"avail\":\"$avail\",\"storage_type\":\"$stype\"}"
        ;;
    send_tg)
        file_path="$2"
        if [ -f "$file_path" ] && [ -f /etc/config/telegram_bot.conf ]; then
            . /etc/config/telegram_bot.conf
            fname=$(basename "$file_path")
            curl -s -m 120 -F "chat_id=${TG_ADMIN_ID}" -F "document=@${file_path}" -F "caption=📂 File từ Trạm NAS: ${fname}" "https://api.telegram.org/bot${TG_BOT_TOKEN}/sendDocument" >/dev/null 2>&1 &
            echo "OK"
        else
            echo "FILE_NOT_FOUND"
        fi
        ;;
    *)
        echo "Usage: $0 {list|clear|status|stats|send_tg <file>}"
        ;;
esac
AIRDROP_CLI_EOF
    chmod +x /usr/bin/airdrop_cli.sh

