if action == "cctv_status" then
    print("Content-Type: application/json\r\nCache-Control: no-cache\r\n\r")
    local glob_enabled = uci_get("cctv_bot.global.enabled", "1")
    local push_tg = uci_get("cctv_bot.global.push_to_telegram", "1")
    local push_gd = uci_get("cctv_bot.global.push_to_gdrive", "1")
    local ret_days = uci_get("cctv_bot.global.retention_days", "15")
    local mesh_en = uci_get("cctv_bot.global.mesh_relay_enabled", "1")
    local mesh_ip = uci_get("cctv_bot.global.mesh_node_ip", "192.168.1.2")
    local comp_mode = uci_get("cctv_bot.global.compression_mode", "h265_zero_copy")
    local fps = uci_get("cctv_bot.global.fps", "15")

    local def_tok = uci_get("cctv_sentinel.settings.telegram_bot_token", "")
    local def_chat = uci_get("cctv_sentinel.settings.telegram_chat_id", "")
    if (def_tok == "" or def_chat == "") and fs.stat("/etc/config/telegram_bot.conf") then
        local f = io.open("/etc/config/telegram_bot.conf", "r")
        if f then
            for line in f:lines() do
                local k, v = line:match('^([%w_]+)="?([^"\r\n]+)"?')
                if k == "TG_BOT_TOKEN" and def_tok == "" then def_tok = v end
                if k == "TG_ADMIN_ID" and def_chat == "" then def_chat = v end
            end
            f:close()
        end
    end

    local cams = {}
    uci:foreach("cctv_bot", "cctv_camera", function(s)
        local cid = s[".name"]
        local cname = s.name or cid
        local rtsp = s.rtsp_url or ""
        local tok = s.bot_token or ""
        local chat = s.chat_id or ""
        if (not chat or chat == "") and def_chat and #def_chat > 0 then
            chat = def_chat
        end
        local en = s.enabled or "1"
        local dur = s.duration or uci_get("camera." .. cid .. ".duration", "15")
        local stream_prof = s.stream_profile or "sub"
        local p_tg = s.push_tg or "1"
        local snap_p = s.snap_preview or "0"
        local masked_tok = ""
        if tok and #tok >= 10 then
            masked_tok = tok:sub(1, 6) .. "..." .. tok:sub(-4)
        end
        table.insert(cams, string.format(
            '{"id":%s,"name":%s,"rtsp_url":%s,"bot_token":%s,"chat_id":%s,"enabled":%s,"has_token":%s,"duration":%s,"stream_profile":%s,"push_tg":%s,"snap_preview":%s}',
            json_str(cid), json_str(cname), json_str(rtsp), json_str(masked_tok), json_str(chat),
            en == "1" and "true" or "false", #tok >= 10 and "true" or "false",
            json_str(dur), json_str(stream_prof), p_tg == "1" and "true" or "false", snap_p == "1" and "true" or "false"
        ))
    end)

    local ram_used_mb = 0
    local vid_cnt = 0
    local p_du = io.popen("du -sm /tmp/cctv_ram_buffer 2>/dev/null | awk '{print $1}'")
    if p_du then
        ram_used_mb = tonumber(p_du:read("*l") or 0) or 0
        p_du:close()
    end
    local p_ls = io.popen("ls -1 /tmp/cctv_ram_buffer/*.mp4 2>/dev/null | wc -l")
    if p_ls then
        vid_cnt = tonumber(p_ls:read("*l") or 0) or 0
        p_ls:close()
    end

    local is_nvr_running = (os.execute("pgrep -f cloud_cam_recorder_daemon >/dev/null 2>&1") == 0)
    local is_bot_running = (os.execute("pgrep -f cctv_bot_daemon >/dev/null 2>&1") == 0)

    local arbiter_policy = "ALLOW_FULL"
    local p_arb = io.popen("/usr/bin/cctv_upload_arbiter.sh status_json 2>/dev/null")
    if p_arb then
        local arb_raw = p_arb:read("*a")
        p_arb:close()
        if arb_raw then
            arbiter_policy = arb_raw:match('"network_policy"%s*:%s*"([^"]+)"') or "ALLOW_FULL"
        end
    end

    print(string.format('{"status":"success","global":{"enabled":%s,"push_to_telegram":%s,"push_to_gdrive":%s,"retention_days":%s,"mesh_relay_enabled":%s,"mesh_node_ip":%s,"compression_mode":%s,"fps":%s,"arbiter_policy":%s,"silent_mode":true,"strict_49mb":true,"core1_affinity":true},"cameras":[%s],"ram":{"used_mb":%d,"video_count":%d,"nvr_running":%s,"bot_running":%s,"zero_flash_wear":true}}',
        glob_enabled == "1" and "true" or "false",
        push_tg == "1" and "true" or "false",
        push_gd == "1" and "true" or "false",
        json_str(ret_days),
        mesh_en == "1" and "true" or "false",
        json_str(mesh_ip),
        json_str(comp_mode),
        json_str(fps),
        json_str(arbiter_policy),
        table.concat(cams, ","),
        ram_used_mb, vid_cnt,
        is_nvr_running and "true" or "false",
        is_bot_running and "true" or "false"
    ))
    return
end

