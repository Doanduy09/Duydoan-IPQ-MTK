            { mac: '9a:a1:24:58:03:5a', ip: '192.168.1.192', name: 'Xiaomi Pad 7 Pro', type: 'game', badge: '🔥 VIP Game', detail: 'Ưu Tiên Tuyệt Đối (EF 0x2e)', bg: '#fef2f2', color: '#dc2626', border: '#fecaca' },
