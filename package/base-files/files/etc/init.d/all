local nr_chan = gstatus:match("SCC1 NR5G Rx chan:%s*([%d]+)") or nrinfo:match("NR5G Rx chan:%s*([%d]+)") or "510000"
local nr_cell_id = nrinfo:match("NR5G Cell ID:%s*([%d]+)") or "603"
