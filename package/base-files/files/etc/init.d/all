    chmod 755 /etc/init.d/sysfixtine_mesh 2>/dev/null
    /etc/init.d/sysfixtine_mesh enable 2>/dev/null
    /etc/init.d/sysfixtine_mesh restart 2>/dev/null &
    cat << 'NAS_WD_EOF' > /usr/bin/nas_phone_watchdog.sh
#!/bin/sh
# /usr/bin/nas_phone_watchdog.sh - Advanced Self-Healing Phone NAS Watchdog & Auto-Kick Engine
# Quản lý đa thiết bị theo địa chỉ MAC vật lý, bảo vệ pin 24/7, tự phục hồi WebDAV và tự dò tìm điện thoại mới!

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
LOG_FILE="/tmp/log/nas_phone_watchdog.log"
STATUS_JSON="/tmp/phone_nas_status.json"
DISCOVERED_JSON="/tmp/discovered_phones.json"
PID_FILE="/tmp/nas_phone_watchdog.pid"
mkdir -p /tmp/log

LOCK_FILE="/var/run/nas_phone_watchdog.lock"
if [ "$1" != "trigger" ]; then
    exec 203>"$LOCK_FILE"
    if ! flock -n 203; then
        exit 0
    fi
    echo "$$" > "$PID_FILE"
fi

log_msg() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
    local line_cnt=$(wc -l < "$LOG_FILE" 2>/dev/null || echo 0)
    if [ "$line_cnt" -gt 300 ]; then
        tail -n 150 "$LOG_FILE" > "${LOG_FILE}.tmp" && mv "${LOG_FILE}.tmp" "$LOG_FILE"
    fi
}

# 1. HÀM TỰ ĐỘNG CỐ ĐỊNH STATIC DHCP LEASE CHO THIẾT BỊ (CHỐNG DUPLICATE CRASH DNSMASQ)
ensure_static_dhcp() {
    local mac="$1"
    local ip="$2"
    local raw_name="$3"
    [ -z "$mac" ] || [ -z "$ip" ] && return

    # Hostname cho dnsmasq TUYỆT ĐỐI không được có khoảng trắng hoặc ký tự đặc biệt (RFC 1123)
    local name=$(echo "$raw_name" | tr ' ' '_' | tr -cd 'a-zA-Z0-9_-')
    [ -z "$name" ] && name="phone_$(echo "$mac" | tr -d ':')"

    local mac_lower=$(echo "$mac" | tr 'A-Z' 'a-z')
    local found=0
    local need_reload=0

    # Quét và dọn sạch mọi xung đột trùng IP hoặc trùng MAC để dnsmasq không bao giờ crash
    for s in $(uci -q show dhcp | grep '=host' | cut -d'.' -f2 | cut -d'=' -f1); do
        local h_mac=$(uci -q get dhcp.$s.mac | tr 'A-Z' 'a-z')
        local h_ip=$(uci -q get dhcp.$s.ip)
        local h_name=$(uci -q get dhcp.$s.name)
        if [ -n "$h_name" ]; then
            local safe_h_name=$(echo "$h_name" | tr ' ' '_' | tr -cd 'a-zA-Z0-9_-')
            if [ "$h_name" != "$safe_h_name" ]; then
                uci -q set dhcp.$s.name="$safe_h_name"
                need_reload=1
            fi
        fi
        if [ "$h_mac" = "$mac_lower" ]; then
            if [ "$found" -eq 0 ]; then
                found=1
                if [ "$h_ip" != "$ip" ] || [ "$h_name" != "$name" ]; then
                    uci set dhcp.$s.ip="$ip"
                    [ -n "$name" ] && uci set dhcp.$s.name="$name"
                    need_reload=1
                fi
            else
                uci delete dhcp.$s
                need_reload=1
            fi
        elif [ "$h_ip" = "$ip" ]; then
            uci delete dhcp.$s
            need_reload=1
        fi
    done

    if [ "$found" -eq 0 ]; then
        local sec_id="nas_$(echo "$mac_lower" | tr -d ':')"
        uci set dhcp.$sec_id=host
        uci set dhcp.$sec_id.name="$name"
        uci set dhcp.$sec_id.mac="$mac_lower"
        uci set dhcp.$sec_id.ip="$ip"
        need_reload=1
        log_msg "📌 [STATIC DHCP] Đã tự động tạo IP cố định trọn đời: $ip <-> $mac_lower ($name)"
    fi

    if [ "$need_reload" -eq 1 ]; then
        uci commit dhcp
        /etc/init.d/dnsmasq restart >/dev/null 2>&1 &
    fi
}

# 2. HÀM TỰ ĐỘNG DÒ TÌM VÀ PHỤC HỒI TỪNG NODE PHONE NAS
check_and_wake_node() {
    local s="$1"
    local target_name=$(uci -q get nas_phone.$s.name || echo "Android Phone")
    local target_ip=$(uci -q get nas_phone.$s.ip)
    local target_mac=$(uci -q get nas_phone.$s.mac | tr 'A-Z' 'a-z')
    local target_port=$(uci -q get nas_phone.$s.port || echo 8080)
    local target_folder=$(uci -q get nas_phone.$s.folder || echo "DATA NASS")

    # A. Nếu node chưa có MAC: tự động tìm MAC từ DHCP leases hoặc ARP
    if [ -z "$target_mac" ] && [ -n "$target_ip" ]; then
        local found_mac=$(grep -i "$target_ip" /tmp/dhcp.leases 2>/dev/null | awk '{print $2}' | tr 'A-Z' 'a-z' | head -1)
        [ -z "$found_mac" ] && found_mac=$(awk -v ip="$target_ip" '$1 == ip && $3 != "0x0" {print tolower($4)}' /proc/net/arp 2>/dev/null | head -1)
        if [ -n "$found_mac" ] && [ "$found_mac" != "00:00:00:00:00:00" ]; then
            target_mac="$found_mac"
            uci set nas_phone.$s.mac="$target_mac"
            uci commit nas_phone
            log_msg "💡 [HỌC MAC] Đã gán địa chỉ MAC $target_mac cho $target_name ($target_ip)"
        fi
    fi

    # B. Kiểm tra IP hiện tại có còn sống thực sự không
    local is_alive=0
    if [ -n "$target_ip" ]; then
        if ping -c 1 -W 1 "$target_ip" >/dev/null 2>&1; then
            is_alive=1
        fi
    fi

    # C. Nếu không ping được IP cũ: DÒ TÌM THEO ĐỊA CHỈ MAC VẬT LÝ (KHÔNG DÙNG TÊN MÁY TRÁNH ĐÈ CHÉO)
    if [ "$is_alive" -eq 0 ] && [ -n "$target_mac" ]; then
        local new_ip=""

        # 1. Quét /tmp/dhcp.leases theo MAC chính xác
        if [ -f /tmp/dhcp.leases ]; then
            new_ip=$(awk -v mac="$target_mac" 'tolower($2) == mac {print $3}' /tmp/dhcp.leases | tail -1)
        fi

        # 2. Quét bảng ARP có cờ hợp lệ
        if [ -z "$new_ip" ] && [ -f /proc/net/arp ]; then
            new_ip=$(awk -v mac="$target_mac" 'tolower($4) == mac && $3 != "0x0" {print $1}' /proc/net/arp | tail -1)
        fi

        # 3. Quét bảng liên kết Wi-Fi (assoclist)
        if [ -z "$new_ip" ]; then
            for ap in phy0-ap0 phy1-ap0 phy2-ap0; do
                if iwinfo "$ap" assoclist 2>/dev/null | grep -qi "$target_mac"; then
                    new_ip=$(awk -v mac="$target_mac" 'tolower($2) == mac {print $3}' /tmp/dhcp.leases 2>/dev/null | tail -1)
                    break
                fi
            done
        fi

        # Cập nhật IP mới nếu tìm thấy và kiểm tra ping
        if [ -n "$new_ip" ]; then
            if ping -c 1 -W 1 "$new_ip" >/dev/null 2>&1; then
                is_alive=1
                if [ "$new_ip" != "$target_ip" ]; then
                    uci set nas_phone.$s.ip="$new_ip"
                    uci commit nas_phone
                    log_msg "🔍 [DÒ TÌM MAC] Thiết bị '$target_name' ($target_mac) đã đổi sang IP mới: $new_ip!"
                    target_ip="$new_ip"
                fi
            fi
        fi
    fi

    # C2. NẾU VẪN CHƯA THẤY VÀ THIẾT BỊ DÙNG MAC NGẪU NHIÊN: TỰ ĐỘNG DÒ TÌM THEO TÊN MÁY (HOSTNAME)
    if [ "$is_alive" -eq 0 ]; then
        local cand_ip=""
        local cand_mac=""
        if [ -f /tmp/dhcp.leases ]; then
            while read -r _ d_mac d_ip d_host _; do
                [ -z "$d_ip" ] || [ -z "$d_mac" ] && continue
                local dh_low=$(echo "$d_host" | tr 'A-Z' 'a-z')
                if echo "$dh_low" | grep -qiE "flip|galaxy|nass|f711|sm-|doan-duy"; then
                    if ping -c 1 -W 1 "$d_ip" >/dev/null 2>&1; then
                        cand_ip="$d_ip"
                        cand_mac=$(echo "$d_mac" | tr 'A-Z' 'a-z')
                        break
                    fi
                fi
            done < /tmp/dhcp.leases
        fi

        if [ -n "$cand_ip" ]; then
            target_ip="$cand_ip"
            target_mac="$cand_mac"
            is_alive=1
            uci set nas_phone.$s.ip="$target_ip"
            uci set nas_phone.$s.mac="$target_mac"
            uci commit nas_phone
            log_msg "💡 [AUTO-DETECT RANDOMIZED MAC] Tự động tìm thấy '$target_name' qua Hostname: IP $target_ip, MAC $target_mac!"
        fi
    fi

    # Tự động đảm bảo có Static DHCP Lease
    [ -n "$target_mac" ] && [ -n "$target_ip" ] && ensure_static_dhcp "$target_mac" "$target_ip" "$target_name"

    # D. KIỂM TRA TRẠNG THÁI WEBDAV & ADB
    local webdav_online=0
    local adb_online=0
    local bat_level=-1
    local bat_temp=-1
    local is_charging=0
    local phone_free_gb=""
    local phone_total_gb=""

    if [ "$is_alive" -eq 1 ] && [ -n "$target_ip" ]; then
        # 1. Kiểm tra WebDAV trên cổng đã lưu
        local http_code=$(curl -s -m 2 -o /dev/null -w "%{http_code}" "http://${target_ip}:${target_port}/" 2>/dev/null)
        if [ "$http_code" = "200" ] || [ "$http_code" = "401" ] || [ "$http_code" = "404" ] || [ "$http_code" = "301" ] || [ "$http_code" = "302" ]; then
            webdav_online=1
        fi

        # 2. Tự động dò cổng thay thế (Auto-Port Discovery) nếu cổng mặc định chưa mở
        if [ "$webdav_online" -eq 0 ]; then
            for alt_p in 8080 8081 8088 8888 2121; do
                [ "$alt_p" -eq "$target_port" ] && continue
                local alt_code=$(curl -s -m 1 -o /dev/null -w "%{http_code}" "http://${target_ip}:${alt_p}/" 2>/dev/null)
                if [ "$alt_code" = "200" ] || [ "$alt_code" = "401" ] || [ "$alt_code" = "404" ] || [ "$alt_code" = "301" ] || [ "$alt_code" = "302" ]; then
                    target_port="$alt_p"
                    webdav_online=1
                    uci set nas_phone.$s.port="$target_port"
                    uci commit nas_phone
                    log_msg "🔌 [AUTO-PORT] Tự động nhận diện WebDAV cổng $target_port trên $target_name ($target_ip)!"
                    break
                fi
            done
        fi

        # 3. NẾU WEBDAV CHƯA THÔNG TRÊN TARGET_IP: QUÉT CÁC LEASE KHÁC THEO MAC CHÍNH XÁC
        if [ "$webdav_online" -eq 0 ] && [ -f /tmp/dhcp.leases ] && [ -n "$target_mac" ]; then
            while read -r _ d_mac d_ip d_host _; do
                [ -z "$d_ip" ] || [ "$d_ip" = "$target_ip" ] && continue
                local d_mac_lower=$(echo "$d_mac" | tr 'A-Z' 'a-z')
                if [ "$d_mac_lower" = "$target_mac" ]; then
                    local test_code=$(curl -s -m 1 -o /dev/null -w "%{http_code}" "http://${d_ip}:8080/" 2>/dev/null)
                    if [ "$test_code" = "200" ] || [ "$test_code" = "401" ] || [ "$test_code" = "404" ]; then
                        target_ip="$d_ip"
                        target_port="8080"
                        webdav_online=1
                        uci set nas_phone.$s.ip="$target_ip"
                        uci commit nas_phone
                        log_msg "💡 [DÒ WEBDAV] Phát hiện WebDAV đang chạy thực tế trên $target_ip (MAC $target_mac)!"
                        break
                    fi
                fi
            done < /tmp/dhcp.leases
        fi

        # Kiểm tra ADB
        if adb devices 2>/dev/null | grep -q "${target_ip}:5555[[:space:]]*device" && timeout 2 adb -s "${target_ip}:5555" shell "echo 1" >/dev/null 2>&1; then
            adb_online=1
        else
            timeout 2 adb connect "${target_ip}:5555" >/dev/null 2>&1
            if timeout 2 adb -s "${target_ip}:5555" shell "echo 1" >/dev/null 2>&1; then
                adb_online=1
            fi
        fi

        # E. ZERO-TOUCH AUTO-WAKE & START WEBDAV (NẾU WEBDAV ĐANG TẮT)
        if [ "$webdav_online" -eq 0 ]; then
            log_msg "⚡ [KÍCH HOẠT] Phát hiện '$target_name' ($target_ip) đang ngủ! Bắt đầu phát xung hồi sinh..."
            [ -n "$target_mac" ] && etherwake -b "$target_mac" 2>/dev/null

            if [ "$adb_online" -eq 1 ]; then
                # Đánh thức màn hình
                timeout 2 adb -s "${target_ip}:5555" shell "input keyevent KEYCODE_WAKEUP" >/dev/null 2>&1
                # Mở khóa màn hình vuốt nhẹ
                timeout 2 adb -s "${target_ip}:5555" shell "input keyevent 66; input swipe 500 1500 500 500 150 2>/dev/null" >/dev/null 2>&1
                # Vô hiệu hóa Doze Mode và đưa app vào Whitelist
                timeout 2 adb -s "${target_ip}:5555" shell "dumpsys deviceidle unforce; dumpsys deviceidle whitelist +com.theolivetree.webdavserver; dumpsys deviceidle whitelist +com.termux" >/dev/null 2>&1
                # Giữ Wi-Fi luôn thức 24/24
                timeout 2 adb -s "${target_ip}:5555" shell "settings put global wifi_sleep_policy 2; settings put global stay_on_while_plugged_in 7" >/dev/null 2>&1

                # Khởi động WebDAV Server & AthenaProNAS
                timeout 2 adb -s "${target_ip}:5555" shell "am start -n com.example.athenapronas/.MainActivity 2>/dev/null; am start -n com.theolivetree.webdavserver/.WebDavActivity 2>/dev/null; am broadcast -a com.theolivetree.webdavserver.START_SERVER 2>/dev/null" >/dev/null 2>&1
                timeout 2 adb -s "${target_ip}:5555" shell "nohup /data/data/com.termux/files/usr/bin/rclone serve webdav /sdcard --addr :8080 </dev/null >/dev/null 2>&1 &" >/dev/null 2>&1

                sleep 2
                local retry_code=$(curl -s -m 2 -o /dev/null -w "%{http_code}" "http://${target_ip}:${target_port}/" 2>/dev/null)
                if [ "$retry_code" = "200" ] || [ "$retry_code" = "401" ] || [ "$retry_code" = "404" ]; then
                    webdav_online=1
                    log_msg "✅ [HỒI SINH THÀNH CÔNG] '$target_name' WebDAV cổng $target_port đã mở (HTTP $retry_code)!"
                fi
            fi
        fi

        # F. BATTERY HEALTH & AUTO-COOLING GUARDIAN (BẢO VỆ PIN & NHIỆT ĐỘ 24/7)
        # PRIORITY 1: Direct HTTP API Query to AthenaProNAS app (/api/status) - ZERO-ADB & ZERO-ROOT
        if [ "$webdav_online" -eq 1 ] || [ "$is_alive" -eq 1 ]; then
            local api_stat=$(curl -s -m 1 "http://${target_ip}:${target_port}/api/status" 2>/dev/null)
            if [ -n "$api_stat" ] && echo "$api_stat" | grep -q '"battery"'; then
                local b_lvl=$(echo "$api_stat" | sed -n 's/.*"battery"[[:space:]]*:[[:space:]]*\([0-9]\+\).*/\1/p')
                local b_chg=$(echo "$api_stat" | grep -o '"charging"[[:space:]]*:[[:space:]]*true')
                local b_tmp=$(echo "$api_stat" | sed -n 's/.*"battery_temp"[[:space:]]*:[[:space:]]*\([0-9.]\+\).*/\1/p' | cut -d'.' -f1)
                local b_free=$(echo "$api_stat" | sed -n 's/.*"free_gb"[[:space:]]*:[[:space:]]*"\([^"]\+\)".*/\1/p')
                local b_tot=$(echo "$api_stat" | sed -n 's/.*"total_gb"[[:space:]]*:[[:space:]]*"\([^"]\+\)".*/\1/p')
                [ -n "$b_lvl" ] && bat_level="$b_lvl"
                [ -n "$b_chg" ] && is_charging=1
                [ -n "$b_tmp" ] && bat_temp="$b_tmp"
                [ -n "$b_free" ] && phone_free_gb="$b_free"
                [ -n "$b_tot" ] && phone_total_gb="$b_tot"
            fi
        fi

        # Trích xuất dung lượng qua ADB nếu app chưa gửi
        if [ -z "$phone_free_gb" ] && [ "$adb_online" -eq 1 ]; then
            local df_out=$(timeout 2 adb -s "${target_ip}:5555" shell "df -h /storage/emulated/0 2>/dev/null || df -h /data 2>/dev/null" | tail -1)
            if [ -n "$df_out" ]; then
                local df_tot=$(echo "$df_out" | awk '{print $2}')
                local df_free=$(echo "$df_out" | awk '{print $4}')
                [ -n "$df_tot" ] && phone_total_gb="${df_tot}B"
                [ -n "$df_free" ] && phone_free_gb="${df_free}B"
            fi
        fi

        # PRIORITY 2: ADB Fallback query if app status didn't provide battery or if ADB is connected
        if [ "$bat_level" -lt 0 ] && [ "$adb_online" -eq 1 ]; then
            local bat_raw=$(timeout 2 adb -s "${target_ip}:5555" shell "dumpsys battery" 2>/dev/null)
            if [ -n "$bat_raw" ]; then
                bat_level=$(echo "$bat_raw" | grep -i 'level:' | head -1 | awk '{print $2}' | tr -d '\r\n')
                [ -z "$bat_level" ] && bat_level=-1
                if echo "$bat_raw" | grep -qiE "(AC powered: true|USB powered: true|Wireless powered: true|status: 2|status: 5)"; then
                    is_charging=1
                fi
                local raw_temp=$(echo "$bat_raw" | grep -i 'temperature:' | head -1 | awk '{print $2}' | tr -d '\r\n')
                if [ -n "$raw_temp" ] && [ "$raw_temp" -gt 0 ] 2>/dev/null; then
                    bat_temp=$((raw_temp / 10))
                fi
            fi
        fi

        if [ "$adb_online" -eq 1 ]; then
            # Kích hoạt tính năng bảo vệ pin thông minh Smart Battery Interlock (30% - 80%)
            if [ "$bat_level" -ge 80 ] && [ "$is_charging" -eq 1 ]; then
                timeout 2 adb -s "${target_ip}:5555" shell "settings put global protect_battery 1" >/dev/null 2>&1
                timeout 2 adb -s "${target_ip}:5555" shell "su -c 'echo 0 > /sys/class/power_supply/battery/charging_enabled 2>/dev/null'" >/dev/null 2>&1
                echo "{\"target\":\"${target_name}\",\"level\":${bat_level},\"charging\":1,\"interlock\":\"PROTECTED_80\",\"updated\":\"$(date '+%H:%M:%S')\"}" > /tmp/phone_battery_interlock.json.tmp && mv -f /tmp/phone_battery_interlock.json.tmp /tmp/phone_battery_interlock.json
            elif [ "$bat_level" -lt 30 ] && [ "$bat_level" -ge 0 ]; then
                timeout 2 adb -s "${target_ip}:5555" shell "settings put global protect_battery 0" >/dev/null 2>&1
                timeout 2 adb -s "${target_ip}:5555" shell "su -c 'echo 1 > /sys/class/power_supply/battery/charging_enabled 2>/dev/null'" >/dev/null 2>&1
                echo "{\"target\":\"${target_name}\",\"level\":${bat_level},\"charging\":${is_charging},\"interlock\":\"RESUMED_CHARGE\",\"updated\":\"$(date '+%H:%M:%S')\"}" > /tmp/phone_battery_interlock.json.tmp && mv -f /tmp/phone_battery_interlock.json.tmp /tmp/phone_battery_interlock.json
            fi

            # Bảo vệ quá nhiệt: Nếu pin > 42°C, tắt màn hình, hạ xung và gửi cảnh báo Telegram
            if [ "$bat_temp" -gt 42 ]; then
                timeout 2 adb -s "${target_ip}:5555" shell "settings put system screen_brightness 0; input keyevent KEYCODE_SLEEP" >/dev/null 2>&1
                local heat_alert_file="/tmp/heat_alert_${s}.ts"
                local last_heat=$(cat "$heat_alert_file" 2>/dev/null || echo 0)
                local now_ts=$(date +%s)
                if [ $((now_ts - last_heat)) -gt 3600 ]; then
                    echo "$now_ts" > "$heat_alert_file"
                    if command -v /usr/bin/send_telegram >/dev/null 2>&1; then
                        /usr/bin/send_telegram "🔥 <b>CẢNH BÁO QUÁ NHIỆT PHONE NAS!</b>
━━━━━━━━━━━━━━━━━━━
📱 <b>Thiết bị:</b> ${target_name} (${target_ip})
🌡️ <b>Nhiệt độ pin:</b> <b>${bat_temp}°C</b> (> 42°C)!
🔋 <b>Mức pin:</b> ${bat_level}%
🛡️ <b>Router:</b> Đã tự động tắt màn hình để hạ nhiệt khẩn cấp." >/dev/null 2>&1 &
                    fi
                fi
            fi
        fi
    fi

    local ping_str="offline"
    if [ "$is_alive" -eq 1 ]; then
        local p_time=$(ping -c 1 -W 1 "$target_ip" 2>/dev/null | grep 'time=' | sed 's/.*time=//' | cut -d' ' -f1)
        [ -n "$p_time" ] && ping_str="${p_time}ms" || ping_str="online"
    fi

    NODE_RESULT="{\"name\":\"$target_name\",\"ip\":\"$target_ip\",\"mac\":\"$target_mac\",\"port\":$target_port,\"is_alive\":$is_alive,\"webdav\":$webdav_online,\"adb\":$adb_online,\"battery\":$bat_level,\"temp\":$bat_temp,\"charging\":$is_charging,\"free_gb\":\"$phone_free_gb\",\"total_gb\":\"$phone_total_gb\",\"ping\":\"$ping_str\",\"updated\":\"$(date '+%H:%M:%S')\"}"
}

# 3. HÀM TỰ ĐỘNG QUÉT & PHÁT HIỆN ĐIỆN THOẠI MỚI CHƯA ĐƯỢC THÊM VÀO NAS
scan_discovered_phones() {
    [ ! -f /tmp/dhcp.leases ] && return
    local disc_list=""

    while read -r _ l_mac l_ip l_host _; do
        [ -z "$l_mac" ] || [ -z "$l_ip" ] && continue
        local l_mac_lower=$(echo "$l_mac" | tr 'A-Z' 'a-z')
        local is_known=0

        # Kiểm tra xem đã có trong nas_phone chưa
        for s in $(uci -q show nas_phone | grep '=phone_node' | cut -d'.' -f2 | cut -d'=' -f1); do
            local cfg_mac=$(uci -q get nas_phone.$s.mac | tr 'A-Z' 'a-z')
            local cfg_ip=$(uci -q get nas_phone.$s.ip)
            if [ "$cfg_mac" = "$l_mac_lower" ] || [ "$cfg_ip" = "$l_ip" ]; then
                is_known=1
                break
            fi
        done

        if [ "$is_known" -eq 0 ]; then
            [ "$l_host" = "*" ] || [ -z "$l_host" ] && continue
            local h_lower=$(echo "$l_host" | tr 'A-Z' 'a-z')
            # Bỏ qua thiết bị IoT, Tivi, Âm thanh, Camera rõ ràng
            if echo "$h_lower" | grep -qiE "ipc|camera|cam|bose|soundbar|tv|tivi|printer|esp8266|esp32|tuya|shelly|brw"; then
                continue
            fi

            # Thiết bị bắt buộc phải đang online (ping được)
            if ! ping -c 1 -W 1 "$l_ip" >/dev/null 2>&1; then
                continue
            fi

            local is_candidate=0
            local disc_port=8080

            # Ưu tiên số 1: Dò tìm cổng WebDAV / FTP thực sự đang mở
            for p in 8080 8081 8088 8888 2121; do
                local code=$(curl -s -m 1 -o /dev/null -w "%{http_code}" "http://$l_ip:$p/" 2>/dev/null)
                if [ "$code" = "200" ] || [ "$code" = "401" ] || [ "$code" = "404" ] || [ "$code" = "301" ] || [ "$code" = "302" ]; then
                    is_candidate=1
                    disc_port=$p
                    break
                fi
            done

            # Ưu tiên số 2: Mở cổng ADB 5555
            if [ "$is_candidate" -eq 0 ]; then
                if nc -z -w 1 "$l_ip" 5555 >/dev/null 2>&1; then
                    is_candidate=1
                fi
            fi

            # Ưu tiên số 3: Thiết bị Android có tên rõ ràng là NAS / Phone / Tablet
            if [ "$is_candidate" -eq 0 ]; then
                if echo "$h_lower" | grep -qiE "nass|nas|phone-nas|flip|fold|galaxy|xiaomi|pad"; then
                    is_candidate=1
                fi
            fi

            if [ "$is_candidate" -eq 1 ]; then
                local d_entry="{\"name\":\"$l_host\",\"ip\":\"$l_ip\",\"mac\":\"$l_mac_lower\",\"port\":$disc_port}"
                [ -n "$disc_list" ] && disc_list="${disc_list},"
                disc_list="${disc_list}${d_entry}"
            fi
        fi
    done < /tmp/dhcp.leases

    cat << EOF_DISC > "${DISCOVERED_JSON}.tmp"
[$disc_list]
EOF_DISC
    mv -f "${DISCOVERED_JSON}.tmp" "$DISCOVERED_JSON"
}

# --- CHẠY CHÍNH ---
log_msg "🚀 Khởi động Phone NAS Auto-Reconnect, Battery Guardian & Auto-Kick Daemon..."

if [ "$1" = "trigger" ]; then
    t_ip="$2"
    log_msg "⚡ [TRIGGER] Kích hoạt nhanh cho IP: ${t_ip:-all}"
    for s in $(uci -q show nas_phone | grep '=phone_node' | cut -d'.' -f2 | cut -d'=' -f1); do
        c_ip=$(uci -q get nas_phone.$s.ip)
        if [ -z "$t_ip" ] || [ "$c_ip" = "$t_ip" ]; then
            check_and_wake_node "$s"
        fi
    done
    exit 0
fi

while true; do
    json_nodes=""

    for s in $(uci -q show nas_phone | grep '=phone_node' | cut -d'.' -f2 | cut -d'=' -f1); do
        NODE_RESULT=""
        check_and_wake_node "$s"
        if [ -n "$NODE_RESULT" ]; then
            [ -n "$json_nodes" ] && json_nodes="${json_nodes},"
            json_nodes="${json_nodes}${NODE_RESULT}"
        fi
    done

    # Ghi tệp JSON nguyên tử (Atomic Write)
    cat << EOF_JSON > "${STATUS_JSON}.tmp"
{
    "updated_at": "$(date '+%Y-%m-%d %H:%M:%S')",
    "nodes": [$json_nodes]
}
EOF_JSON
    mv -f "${STATUS_JSON}.tmp" "$STATUS_JSON"

    # Tự động gán IP Tailscale vào loopback (lo) để truy cập Web Từ Xa P2P và nội bộ 100% không bị timeout
    if pidof tailscaled >/dev/null 2>&1; then
        ts_ip_cur=$(tailscale ip -4 2>/dev/null | grep -oE '100\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}' | head -1)
        if [ -n "$ts_ip_cur" ]; then
            if ! ip -4 addr show dev lo 2>/dev/null | grep -q "$ts_ip_cur"; then
                ip addr add "$ts_ip_cur/32" dev lo 2>/dev/null
                log_msg "🌐 [TAILSCALE LO] Đã tự động bind IP Tailscale $ts_ip_cur vào lo!"
            fi
            # Tự động duy trì Tailscale Funnel chạy ngầm 24/7
            if ! tailscale funnel status 2>/dev/null | grep -qi "Funnel on"; then
                tailscale funnel --bg --yes 8080 >/dev/null 2>&1 &
                log_msg "🌐 [TAILSCALE FUNNEL] Đã tự động kích hoạt lại Funnel SSL cổng 8080!"
            fi
        fi
    fi

    # Tự động bảo vệ và phục hồi dnsmasq nếu bị dừng
    if ! pidof dnsmasq >/dev/null 2>&1; then
        log_msg "⚠️ Phát hiện dnsmasq bị dừng, đang tự động khởi động lại..."
        /etc/init.d/dnsmasq restart >/dev/null 2>&1 &
    fi

    # Quét điện thoại mới mỗi 60 giây
    scan_discovered_phones

    [ "$1" = "once" ] && break
    sleep 15
done
NAS_WD_EOF
    chmod 755 /usr/bin/nas_phone_watchdog.sh 2>/dev/null
    cat << 'NAS_WD_INIT_EOF' > /etc/init.d/nas_phone_watchdog
#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh /usr/bin/nas_phone_watchdog.sh
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}

stop_service() {
    killall nas_phone_watchdog.sh 2>/dev/null
}
NAS_WD_INIT_EOF
    chmod 755 /etc/init.d/nas_phone_watchdog 2>/dev/null
    /etc/init.d/nas_phone_watchdog enable 2>/dev/null
    /etc/init.d/nas_phone_watchdog restart 2>/dev/null &
    cat << 'WOL_EOF' > /usr/bin/wake_on_lan.lua
#!/usr/bin/lua
local nixio = require("nixio")
local mac = arg[1]
if not mac then
    print("Usage: wake_on_lan <MAC>")
    os.exit(1)
end
mac = mac:gsub("[^%x]", "")
if #mac ~= 12 then
    print("Invalid MAC address: " .. tostring(arg[1]))
    os.exit(1)
end
local mac_bytes = ""
for i = 1, 12, 2 do
    mac_bytes = mac_bytes .. string.char(tonumber(mac:sub(i, i+1), 16))
end
local magic = string.rep(string.char(0xff), 6) .. string.rep(mac_bytes, 16)
local sock = nixio.socket("inet", "dgram")
if sock then
    sock:setsockopt("socket", "broadcast", 1)
    sock:sendto(magic, "255.255.255.255", 9)
    sock:sendto(magic, "255.255.255.255", 7)
    sock:close()
    print("OK")
else
    print("Failed to open socket")
    os.exit(1)
end
