                        btn.style.background = '#0284c7';
                        btn.textContent = '💾 Lưu Cài Đặt Tự Động Hóa';
                    }, 2500);
                    var retText = Number(retVal) === 0 ? 'Vĩnh viễn (không xóa)' : (retVal + ' ngày');
                    ui.addNotification(null, E('p', '✅ Đã lưu cài đặt tự động hóa: Hạn video [' + retText + '], Giờ đêm đẩy Cloud [' + opStart + ' - ' + opEnd + ']!'), 'info');
