        // =============================================================
        // 🛡️ FULL-SCREEN TAB: CAMERA AI SENTINEL 24/7
        // =============================================================
        var sentinelTabStatusCard = E('div', {
            style: 'background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 16px; margin-bottom: 16px;'
        });

        function refreshAISentinelStatus() {
            callGetAISentinel().then(function(st) {
                if (!st) return;
                updateSentinelOverviewUI(st);
                if (typeof renderAISentinelTabContent === 'function') {
                    renderAISentinelTabContent(st);
                }
            }).catch(function(){});
        }

        var sentinelPhoneInput = E('input', {
            type: 'text',
            class: 'cbi-input-text',
            style: 'font-weight: 700; width: 180px; padding: 6px 10px;',
            value: '',
            placeholder: 'SĐT Khẩn Cấp'
        });

        var sentinelChatInput = E('input', {
            type: 'text',
            class: 'cbi-input-text',
            style: 'font-weight: 700; width: 160px; padding: 6px 10px;',
            value: '',
            placeholder: 'Telegram Chat ID'
        });

        var sentinelAutoCallCheck = E('input', { type: 'checkbox', checked: true });
        var sentinelAutoSmsCheck = E('input', { type: 'checkbox', checked: true });
        var sentinelAutoTgCheck = E('input', { type: 'checkbox', checked: true });
        var sentinelFireCheck = E('input', { type: 'checkbox', checked: true });
        var sentinelFallCheck = E('input', { type: 'checkbox', checked: true });

        var sentinelStrangerModeSelect = E('select', {
            class: 'cbi-input-select',
            style: 'font-weight: 700; width: 220px; padding: 6px 10px;'
        }, [
            E('option', { value: 'all_day' }, '🟢 24/7 Nguyên Ngày (Liên tục)'),
            E('option', { value: 'schedule' }, '🌙 Theo Khung Giờ Tùy Chọn'),
            E('option', { value: 'off' }, '⚪ Tắt Giám Sát Người Lạ')
        ]);

        var sentinelStrangerStartInput = E('input', {
            type: 'text',
            class: 'cbi-input-text',
            style: 'font-weight: 700; width: 90px; padding: 6px 10px; text-align: center;',
            value: '00:00'
        });

        var sentinelStrangerEndInput = E('input', {
            type: 'text',
            class: 'cbi-input-text',
            style: 'font-weight: 700; width: 90px; padding: 6px 10px; text-align: center;',
            value: '06:00'
        });

        var sentinelStrangerClipInput = E('input', {
            type: 'number',
            class: 'cbi-input-text',
            style: 'font-weight: 700; width: 80px; padding: 6px 10px; text-align: center;',
            value: '6',
            min: '3',
            max: '15'
