                locationPopupEditor.style.display = (locationPopupEditor.style.display === 'none' || !locationPopupEditor.style.display) ? 'flex' : 'none';
            }
        }, [ _('dashboard / '), E('span', { id: 'loc-label-span', style: 'font-weight: 600; color: #1f2328;' }, loc) ]);

        var weatherTitleBar = E('div', { 
            style: (currentActiveTab === 'main' ? 'display: flex;' : 'display: none;') + ' justify-content: space-between; align-items: center; margin-top: 4px; margin-bottom: 12px; gap: 8px; flex-wrap: wrap;' 
        }, [
            E('div', { style: 'display: flex; flex-direction: column; align-items: flex-start; max-width: 100%;' }, [
                E('div', { style: 'display: flex; align-items: center; gap: 8px; flex-wrap: wrap;' }, [
                    E('span', { style: 'font-weight: 600; color: #0969da; font-size: 15px;' }, 'DOANDUY-ROUTER'),
                    E('span', { style: 'color: #656d76; font-size: 15px;' }, '/'),
                    weatherTitleClickable,
                    E('span', { class: 'gh-mono-tag', style: 'border-radius: 20px; font-size: 11.5px; padding: 1px 8px; color: #656d76;' }, 'Public'),
                    btnToggleLocBadge
                ]),
                locationPopupEditor
            ]),
            E('div', { style: 'display: flex; justify-content: center; align-items: center;' }, [
                E('span', { id: 'weather-updated-text', class: 'gh-mono-tag', style: 'font-size: 12px; color: #656d76; padding: 4px 10px;' }, '\uD83D\uDD52 C\u1EADp nh\u1EADt: ' + getFormattedLiveTime())
            ]),
            E('div', { style: 'display: flex; justify-content: space-end; align-items: center; gap: 6px; flex-wrap: wrap;' }, [
                sidebarToggleBtn,
                inlineBtnToggleAll,
                inlineBtnGameMode,
                inlineBtnAdShield,
                inlineBtnGemini,
                inlineBtnReboot,
                E('button', {
                    class: 'btn cbi-button cbi-button-action gh-btn-primary',
                    style: 'font-weight: 600; font-size: 12.5px; padding: 5px 14px; border-radius: 6px;',
                    click: function(ev) {
                        ev.target.textContent = '\u23F3 \u0110ang qu\u00E9t...';
                        callRefreshAll().then(function() {
                            location.reload();
                        }).catch(function() {
                            location.reload();
                        });
                    }
                }, '\uD83D\uDD04 C\u1EADp nh\u1EADt')
            ])
        ]);

        if (currentActiveTab !== 'main') {
            weatherMainTableNode.style.display = 'none';
            flashFirmwareCard.style.display = 'none';
        }

        function updateGameQosDisplay(g) {
            if (!g) return;
            window._lastGameLatency = g;
            var elAvg = document.getElementById('game-avg-badge');
            if (elAvg && g.avg_ping) elAvg.textContent = '⚡ Trễ Game: ' + g.avg_ping + ' ms (' + (g.grade || '🌟 Siêu Mượt') + ')';
            var elGar = document.getElementById('game-garena-badge');
            if (elGar && g.garena) elGar.textContent = '🎮 Garena: ' + g.garena + ' ms';
            var elRiot = document.getElementById('game-riot-badge');
            if (elRiot && g.riot) elRiot.textContent = '⚔️ Riot: ' + g.riot + ' ms';
            var elCdn = document.getElementById('game-cdn-badge');
            if (elCdn && g.cdn) elCdn.textContent = '☁️ CDN Web: ' + g.cdn + ' ms';
            var elVtt = document.getElementById('game-viettel-badge');
            if (elVtt && g.viettel) elVtt.textContent = '🚀 Viettel: ' + g.viettel + ' ms';
            var agList = (g.active_gamers && Array.isArray(g.active_gamers)) ? g.active_gamers : [];
            var suList = (g.social_users && Array.isArray(g.social_users)) ? g.social_users : [];
            var doList = (g.device_optimizations && Array.isArray(g.device_optimizations)) ? g.device_optimizations : [];
            var boxList = document.getElementById('active-gamers-list');
            if (boxList) {
                while (boxList.firstChild) boxList.removeChild(boxList.firstChild);
                var newBadges = buildQosDeviceBadges(agList, suList, doList);
                for (var bi = 0; bi < newBadges.length; bi++) {
                    boxList.appendChild(newBadges[bi]);
                }
            }
        }

        var cloudPollTick = 0;
        poll.add(function() {
            if (!isTabFocused || document.hidden || currentActiveTab !== 'main' || isUserInteracting) {
                return Promise.resolve();
            }
            cloudPollTick++;
            if (cloudPollTick % 4 === 0) {
                callGetCloudConfig().then(function(c) {
                    if (c) renderTailscaleStatus(c);
                }).catch(function() {});
            }
            if (cloudPollTick % 2 === 0) {
                callGetAISentinel().then(function(st) {
                    if (st) updateSentinelOverviewUI(st);
                }).catch(function() {});
            }
            return Promise.all([
                callFastStats().catch(function() { return null; }),
                callGetWeather().catch(function() { return null; }),
                callGetRFSignal().catch(function() { return null; }),
                (cloudPollTick % 2 === 0 ? callGetGameLatency().catch(function() { return null; }) : Promise.resolve(null))
            ]).then(function(results) {
                var f = results[0];
                var w = results[1];
                var rf = results[2];
                var g = results[3];
                if (g) updateGameQosDisplay(g);

                if (rf) updateRFSignalBadgeDisplay(rf);

                var elUpdated = document.getElementById('weather-updated-text');
                if (elUpdated) {
                    elUpdated.textContent = '🕒 Cập nhật: ' + getFormattedLiveTime();
                }

                if (f) {
                    var curModel = f.board_model || f.model || window._savedBoardModel || (boardInfo && boardInfo.model) || ((boardInfo && boardInfo.model) || (res && res.model) || 'JDCloud RE-CS-02 (Athena AX6600)');
                    if (curModel && curModel !== 'OpenWrt Router') window._savedBoardModel = curModel;
                    var elModel = document.getElementById('model-val-span');
                    if (elModel) elModel.textContent = curModel;

                    var isMtkCur = (f.hw_accel_type === 'mtk_ppe') || 
                                   (f.hw_accel_name && f.hw_accel_name.indexOf('MediaTek') !== -1) || 
                                   (curModel && (curModel.indexOf('TUF-AX4200') !== -1 || curModel.indexOf('TUF-AX6000') !== -1 || curModel.indexOf('AX6000') !== -1 || curModel.indexOf('AX4200') !== -1 || curModel.indexOf('Filogic') !== -1 || curModel.indexOf('5GCPE') !== -1 || curModel.indexOf('MediaTek') !== -1 || curModel.indexOf('MT798') !== -1)) ||
                                   (f.soc_family && f.soc_family.indexOf('MediaTek') !== -1);
                    var elSoc = document.getElementById('soc-badge-span');
                    if (elSoc) {
                        var socName = f.soc_family || (isMtkCur ? 'MediaTek Filogic 830' : 'Qualcomm IPQ60xx');
                        var cNum = f.cpu_cores || 4;
                        elSoc.textContent = '⚡ ' + socName + ' (' + cNum + ' Cores, ' + (f.cpu_arch || 'aarch64') + ')';
                    }

                    updateHwAccelBadge(f, curModel);

                    var elUptime = document.getElementById('uptime-badge-span');
                    if (elUptime && f.uptime) elUptime.textContent = '⏱️ ' + f.uptime;

                    var elClients = document.getElementById('clients-badge-span');
                    if (elClients && f.online_clients) elClients.textContent = '📱 ' + f.online_clients + ' Thiết bị Online';

                    var elCpu = document.getElementById('cpu-temp-badge');
                    if (elCpu) {
                    var cPct = parseInt(f.cpu_pct || 0);
                    var cPStr = (f.cpu_pct !== undefined && f.cpu_pct !== null && f.cpu_pct !== '') ? (f.cpu_pct + ' • ') : '';
                    var cpuTxt = 'CPU: ' + (f.cpu_cores ? ('(' + f.cpu_cores + ' Cores) • ') : '') + cPStr + (f.cpu_temp || '45.0 °C') + ' ⚡';
                    elCpu.textContent = cpuTxt;
                    elCpu.style.background = cPct >= 90 ? '#fef2f2' : (cPct >= 70 ? '#fefce8' : '#f0fdf4');
                    elCpu.style.borderColor = cPct >= 90 ? '#fca5a5' : (cPct >= 70 ? '#fef08a' : '#86efac');
                    elCpu.style.color = cPct >= 90 ? '#991b1b' : (cPct >= 70 ? '#854d0e' : '#166534');
                }

                    var elWifi = document.getElementById('wifi-temp-badge');
                    if (elWifi && f.wifi_temp) elWifi.textContent = 'Wi-Fi: ' + f.wifi_temp + ' 📶';

                    var elData = document.getElementById('data-used-cell');
                    if (elData && f.data_used) elData.textContent = f.data_used;

                    var p = parseInt(f.ram_pct || '0');
                    var fill = document.getElementById('ram-bar-fill');
                    var txt = document.getElementById('ram-text-val');
                    var dot = document.getElementById('ram-dot-val');
                    if (fill && txt && dot) {
                        fill.style.width = p + '%';
                        fill.style.background = p >= 85 ? '#ef4444' : (p >= 60 ? '#f59e0b' : '#3b82f6');
                        txt.textContent = (f.ram_used_mb || '0') + ' MB / ' + (f.ram_total_mb || '0') + ' MB (' + p + '%)';
                        dot.textContent = p >= 85 ? '🔴' : (p >= 60 ? '🟡' : '🟢');
                    }

                    updateRamBadge(f);
                }

                if (w) {
                    window._lastWeatherData = w;
                    var elLunar = document.getElementById('lunar-badge-span');
                    if (elLunar && w.lunar && w.lunar !== '--') {
                        var lText = w.lunar.indexOf('Âm') !== -1 || w.lunar.indexOf('AL') !== -1 ? w.lunar : (w.lunar + ' Âm Lịch');
                        elLunar.textContent = '📅 ' + lText;
                    }

                    var elLoc = document.getElementById('loc-label-span');
                    if (elLoc && w.location) {
                        elLoc.textContent = w.location;
                    }

                    var elEnv = document.getElementById('env-temp-box');
                    if (elEnv && w.temp && w.temp !== '--') {
                        var envTempNum = parseInt(w.temp);
                        var envColor = envTempNum >= 38 ? '#dc3545' : (envTempNum >= 33 ? '#ea580c' : '#16a34a');
                        elEnv.style.color = envColor;
                        elEnv.textContent = w.temp + ' °C (' + (w.humi || '--') + '%)';
                    }

                    var elUv = document.getElementById('uv-box');
                    if (elUv) {
                        var isNightPoll = (new Date().getHours() >= 18 || new Date().getHours() < 6);
                        var uvVal = isNightPoll ? 0 : ((w.uv !== undefined && w.uv !== null && w.uv !== '' && w.uv !== '--') ? parseInt(w.uv) : 3);
                        if (isNightPoll) uvVal = 0;
                        var uvText = isNightPoll ? 'Đêm (An toàn)' : (uvVal >= 11 ? 'Cực tột' : (uvVal >= 8 ? 'Rất cao' : (uvVal >= 6 ? 'Cao' : (uvVal >= 3 ? 'Trung bình' : 'Thấp (An toàn)'))));
                        var uvColor = isNightPoll ? '#0284c7' : (uvVal >= 8 ? '#dc3545' : (uvVal >= 6 ? '#ea580c' : (uvVal >= 3 ? '#d97706' : '#16a34a')));
                        var uvIcon = isNightPoll ? '🌙' : '☀️';
                        elUv.style.color = uvColor;
                        elUv.textContent = uvIcon + ' UV: ' + uvVal + ' (' + uvText + ')';
                    }

                    var elRainBox = document.getElementById('rain-hours-box');
                    if (elRainBox && w.rain_hours) {
                        var rainHours = (w.rain_hours || '0,0,0,0,0,0,').split(',');
                        var curH = new Date().getHours();
                        var baseH = w.updated && w.updated.indexOf(':') !== -1 ? parseInt(w.updated.split(':')[0]) || curH : curH;
                        var newBars = [];
                        for (var i = 0; i < 6; i++) {
                            var hVal = parseInt(rainHours[i] || '0'), slotHour = (baseH + i) % 24, isSlotNight = (slotHour < 6 || slotHour >= 18);
                            var icon = isSlotNight ? '🌙' : '☀️';
                            if (hVal >= 15 && hVal <= 40) icon = isSlotNight ? '☁️' : '⛅';
                            else if (hVal > 40 && hVal <= 75) icon = isSlotNight ? '🌧️' : '🌦️';
                            else if (hVal > 75) icon = isSlotNight ? '🌩️' : '⛈️';
                            newBars.push(E('div', { style: 'display: flex; flex-direction: column; align-items: center; padding: 4px 8px; background: #ffffff; border-radius: 6px; border: 1px solid #cbd5e1; min-width: 46px;' }, [
                                E('span', { style: 'font-size: 16px;' }, icon),
                                E('span', { style: 'font-size: 11px; font-weight: 700; color: #000000;' }, hVal + '%'),
                                E('span', { style: 'font-size: 9.5px; font-weight: 600; color: #000000;' }, i === 0 ? 'Hiện tại' : (slotHour + ':00'))
                            ]));
                        }
                        elRainBox.innerHTML = '';
                        newBars.forEach(function(b) { elRainBox.appendChild(b); });
                    }

                    var elPm = document.getElementById('pm-box');
                    if (elPm && w.pm25 && w.pm25 !== '--') {
                        var pmRisk = w.pm_risk || 'Trung bình';
                        var isBadPm = (pmRisk.indexOf('Kém') !== -1 || pmRisk.indexOf('Xấu') !== -1);
                        elPm.style.background = isBadPm ? '#fef2f2' : '#f0fdf4';
                        elPm.style.borderColor = isBadPm ? '#fca5a5' : '#86efac';
                        elPm.style.color = isBadPm ? '#991b1b' : '#166534';
                        elPm.textContent = w.pm25 + ' µg/m³ (' + pmRisk + ')';
                    }
                }

                updateCombinedWwanUI(f, w);
            }).catch(function() {});
        }, 3);

        setInterval(function() {
            if (isTabFocused && !document.hidden && currentActiveTab === 'main') {
                var elUpdated = document.getElementById('weather-updated-text');
                if (elUpdated) {
                    elUpdated.textContent = '🕒 Cập nhật: ' + getFormattedLiveTime();
                }
            }
        }, 1000);

        var rootContainer = E('div', { class: 'cbi-section', id: 'weather-custom-section', style: 'font-size: 15px; margin-top: 0; padding-top: 0; width: 100%;' }, [
            topButtonsGrid,
            combinedModemWifiWrapper,
            meshContainerNode,
            deviceManagementWrapper,
            airdropContainerNode,
            sentinelContainerNode,
            simManagementWrapper,
            weatherTitleBar,
            weatherMainTableNode,
            flashFirmwareCard
        ]);

        rootContainer.addEventListener('focusin', function(e) {
            var tag = e.target.tagName.toLowerCase();
            if (tag === 'input' || tag === 'select' || tag === 'textarea') {
                isUserInteracting = true;
                try { poll.stop(); } catch(err) {}
            }
        });

        rootContainer.addEventListener('focusout', function() {
            setTimeout(function() {
                var active = document.activeElement;
                if (!active || (active.tagName.toLowerCase() !== 'input' && active.tagName.toLowerCase() !== 'select' && active.tagName.toLowerCase() !== 'textarea')) {
                    isUserInteracting = false;
                    if (currentActiveTab === 'main') {
                        try { poll.start(); } catch(err) {}
                    }
                }
            }, 300);
        });

        // ĐỒNG BỘ NỀN BẤT ĐỒNG BỘ: Chạy sau khi giao diện đã hiện lên 50ms, êm ái ngầm 100%
        setTimeout(function() {
            callFastStats().then(function(f) {
                if (f) updateCombinedWwanUI(f, window._lastWeatherData);
            }).catch(function() {});
            callGetWeather().then(function(w) {
                if (w) {
                    window._lastWeatherData = w;
                    var elLunar = document.getElementById('lunar-badge-span');
                    if (elLunar && w.lunar && w.lunar !== '--') {
                        var lText = w.lunar.indexOf('Âm') !== -1 || w.lunar.indexOf('AL') !== -1 ? w.lunar : (w.lunar + ' Âm Lịch');
                        elLunar.textContent = '📅 ' + lText;
                    }
                    updateCombinedWwanUI(window._lastFastStats, w);
                }
            }).catch(function() {});
            callGetWifi().then(function(w) {
                if (w && w.list) updateWifiDisplay(w);
            }).catch(function() {});
            callSMSInfo().then(function(s) {
                if (s && typeof window._updateSmsScheduleUI === 'function') window._updateSmsScheduleUI(s);
            }).catch(function() {});
            callGetCellInfo().then(function(c) {
                if (c) updateCellDisplay(c);
            }).catch(function() {});
            callGetGameLatency().then(function(g) {
                if (g) updateGameQosDisplay(g);
            }).catch(function() {});
            callGetAISentinel().then(function(st) {
                if (st) updateSentinelOverviewUI(st);
            }).catch(function() {});
            if (typeof updateAdShieldUI === 'function') updateAdShieldUI();
            if (typeof refreshSimManagerUI === 'function') refreshSimManagerUI();
            if (typeof refreshRemoteDomainStatus === 'function') refreshRemoteDomainStatus();
            callRefreshAll().catch(function() {});
        }, 80);

        setTimeout(function() {
            callGetGameLatency().then(function(g) {
                if (g) updateGameQosDisplay(g);
            }).catch(function() {});
        }, 350);

        // F5 TAB & SUBTAB RESTORATION (KHÔI PHỤC TAB & THƯ MỤC KHI F5 THEO Ý ANH DUY)
        setTimeout(function() {
            try {
                var savedTab = sessionStorage.getItem('luci_weather_active_tab');
                if (savedTab && savedTab !== 'main') {
                    if (savedTab === 'devices' && typeof deviceManagementWrapper !== 'undefined') {
                        openTab(deviceManagementWrapper, 'devices');
                    } else if (savedTab === 'modem' && typeof combinedModemWifiWrapper !== 'undefined') {
                        openTab(combinedModemWifiWrapper, 'modem');
                    } else if (savedTab === 'airdrop' && typeof airdropContainerNode !== 'undefined') {
                        openTab(airdropContainerNode, 'airdrop');
                        var savedSub = sessionStorage.getItem('luci_weather_storage_subtab');
                        if (savedSub === 'nas_phone' && typeof subTabNasPhoneBtn !== 'undefined') {
                            subTabNasPhoneBtn.click();
                        } else if (savedSub === 'camera_cloud' && typeof subTabCameraCloudBtn !== 'undefined') {
                            subTabCameraCloudBtn.click();
                        } else if (typeof subTabAirdropBtn !== 'undefined') {
                            subTabAirdropBtn.click();
                        }
                    } else if (savedTab === 'sim' && typeof simManagementWrapper !== 'undefined') {
                        openTab(simManagementWrapper, 'sim');
                    } else if (savedTab === 'sentinel' && typeof sentinelContainerNode !== 'undefined') {
                        openTab(sentinelContainerNode, 'sentinel');
                    } else if (savedTab === 'mesh' && typeof meshContainerNode !== 'undefined') {
                        openTab(meshContainerNode, 'mesh');
                    } else if (savedTab === 'file' && typeof fileExplorerContent !== 'undefined') {
                        openTab(fileExplorerContent, 'file');
                    }
                }
            } catch(e) {}
        }, 120);

        return rootContainer;
    }
});

