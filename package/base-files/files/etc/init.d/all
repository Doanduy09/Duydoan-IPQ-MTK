        function renderMeshTopologyHtml(d) {
            var rawPeers = (d.peers && d.peers.length > 0) ? d.peers.filter(function(p) {
                // CHỈ GIỮ LẠI ROUTER PHỤ MESH (IP 192.168.1.2 -> 192.168.1.5), TUYỆT ĐỐI BỎ QUA CLIENT
                return p.ip && /^192\.168\.1\.[2-5]$/.test(p.ip);
            }) : [];
            var isCtrl = (d.role === 'controller');
            var localIp = d.local_ip || (isCtrl ? '192.168.1.1' : '192.168.1.2');
            var localName = d.local_name || ((boardInfo && boardInfo.hostname) || 'Router');

            // KHỐI TRÊN: ROUTER CHÍNH (TRẠM PHÁT GỐC)
            var mainName = isCtrl ? ('Router Chính (' + localName + ')') : ((d.main_router && d.main_router.name) ? d.main_router.name : 'Router Chính (Trạm Phát 5G)');
            var mainIp = '192.168.1.1';
            var mainMac = isCtrl ? (d.local_mac || '') : ((d.main_router && d.main_router.mac) ? d.main_router.mac : '');

            var rootHtml = '<div style="display: flex; flex-direction: column; align-items: center; margin-bottom: 8px;">' +
                '<div style="background: #ffffff; border: 2px solid #10b981; box-shadow: 0 0 24px rgba(16, 185, 129, 0.35); border-radius: 14px; padding: 18px 28px; min-width: 320px; max-width: 580px; text-align: center; color: #000000;">' +
                    '<div style="display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 6px;">' +
                        '<span style="background: #ffffff; color: #000000; font-size: 11.5px; font-weight: 800; padding: 3px 10px; border-radius: 4px; border: 1px solid #10b981;">👑 ROUTER PHÁT CHÍNH (CÓ MẠNG)</span>' +
                        '<span style="background: #ffffff; color: #000000; font-size: 11px; font-weight: 800; padding: 2px 8px; border-radius: 4px;">' + (isCtrl ? 'THIẾT BỊ NÀY' : 'TRẠM GỐC') + '</span>' +
                    '</div>' +
                    '<div style="font-size: 30px; margin: 4px 0;">📡</div>' +
                    '<div style="font-size: 17px; font-weight: 800; color: #000000;">' + mainName + '</div>' +
                    '<div style="font-size: 14.5px; color: #000000; font-family: monospace; font-weight: 800; margin: 3px 0;">' +
                        'IP Quản Trị: <span style="background: rgba(0,0,0,0.4); padding: 2px 8px; border-radius: 4px; border: 1px solid #10b981;">' + mainIp + '</span>' +
                    '</div>' +
                    (mainMac ? ('<div style="font-size: 11.5px; color: #000000; font-family: monospace; margin-bottom: 6px;">MAC: ' + mainMac + '</div>') : '') +
