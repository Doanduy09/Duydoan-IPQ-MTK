        var sentinelSaveToast = E('div', {
            id: 'sentinel-save-toast-banner',
            style: 'display: none; background: #ffffff; border: 1px solid #10b981; color: #000000; padding: 10px 16px; border-radius: 8px; margin-top: 10px; font-weight: 700; font-size: 13px; align-items: center; gap: 8px; box-shadow: 0 2px 4px rgba(16,185,129,0.1);'
        });

        function handleSaveAISentinel(btn) {
            var origText = btn.textContent;
            var p = sentinelPhoneInput.value.trim();
            var c = sentinelChatInput.value.trim();
            var callVal = sentinelAutoCallCheck.checked ? 1 : 0;
            var smsVal = sentinelAutoSmsCheck.checked ? 1 : 0;
            var tgVal = sentinelAutoTgCheck.checked ? 1 : 0;
            var fireVal = sentinelFireCheck.checked ? 1 : 0;
            var fallVal = sentinelFallCheck.checked ? 1 : 0;
            var stMode = sentinelStrangerModeSelect.value;
            var stStart = sentinelStrangerStartInput.value.trim() || '00:00';
            var stEnd = sentinelStrangerEndInput.value.trim() || '06:00';
            var stClip = parseInt(sentinelStrangerClipInput.value) || 6;

            btn.disabled = true;
            btn.textContent = '⏳ Đang lưu...';
            btn.style.opacity = '0.7';

            callSetAISentinel(p, c, callVal, smsVal, tgVal, fireVal, fallVal, stMode, stStart, stEnd, stClip).then(function(res) {
                btn.disabled = true;
                btn.style.opacity = '1';
                btn.textContent = '✔ Đã Lưu Thành Công!';
                btn.style.background = '#10b981';
                btn.style.color = '#ffffff';
                btn.style.borderColor = '#059669';

                if (typeof showSentinelSaveToast === 'function') {
                    showSentinelSaveToast('💾 Đã lưu cấu hình AI Sentinel thành công! Các thông số đã được đồng bộ xuống phần cứng.');
                }

                sentinelSaveToast.style.display = 'flex';
                sentinelSaveToast.style.background = '#ecfdf5';
                sentinelSaveToast.style.borderColor = '#10b981';
                sentinelSaveToast.style.color = '#065f46';
                sentinelSaveToast.innerHTML = '💾 <b>Đã lưu cấu hình AI Sentinel thành công!</b> Các thông số đã được đồng bộ xuống phần cứng Router.';

                setTimeout(function() {
                    btn.disabled = false;
                    btn.textContent = origText || '💾 Lưu Cấu Hình';
                    btn.style.background = '';
                    btn.style.color = '';
                    btn.style.borderColor = '';
                    sentinelSaveToast.style.display = 'none';
                }, 3500);

                ui.addNotification(null, E('p', {}, '✅ ' + (res && res.message ? res.message : 'Đã lưu cấu hình AI Sentinel thành công!')), 'info');
                refreshAISentinelStatus();
            }).catch(function(err) {
                btn.disabled = false;
                btn.style.opacity = '1';
                btn.textContent = '❌ Lỗi Lưu!';
                btn.style.background = '#dc2626';

                sentinelSaveToast.style.display = 'flex';
                sentinelSaveToast.style.background = '#fef2f2';
                sentinelSaveToast.style.borderColor = '#ef4444';
                sentinelSaveToast.style.color = '#991b1b';
                sentinelSaveToast.innerHTML = '❌ <b>Lỗi lưu cấu hình:</b> ' + (err.message || err);

                setTimeout(function() {
