#!/bin/sh
# /usr/bin/study_mode.sh - Athena Study & Sleep Curfew Manager for Children
# Khoá mạng giải trí (TikTok, YouTube, Games, Social) giữ kết nối học tập (Zoom, Meet, Teams, Docs)

CONF_FILE="/tmp/dnsmasq.d/study_mode.conf"
PID_FILE="/tmp/study_timer.pid"
EXP_FILE="/tmp/study_expire_ts.dat"
DUR_FILE="/tmp/study_duration_min.dat"

enable_study_mode() {
    local mins="$1"
    mins=$(echo "$mins" | tr -cd '0-9')
    
    cat << 'EOF' > "$CONF_FILE"
# Athena Study & Sleep Mode - Dual-Stack null routing
address=/tiktok.com/#
address=/tiktokv.com/#
address=/tiktokcdn.com/#
address=/byteoversea.com/#
address=/musical.ly/#
address=/youtube.com/#
address=/youtu.be/#
address=/googlevideo.com/#
address=/ytimg.com/#
address=/facebook.com/#
address=/fbcdn.net/#
address=/instagram.com/#
address=/roblox.com/#
address=/rbxcdn.com/#
address=/garena.vn/#
address=/freefiremobile.com/#
address=/twitch.tv/#
address=/discord.com/#
address=/discordapp.com/#
address=/bilibili.com/#
address=/douyin.com/#
EOF

    # Huỷ bộ đếm cũ nếu có
    if [ -f "$PID_FILE" ]; then
        local old_pid=$(cat "$PID_FILE" 2>/dev/null)
        [ -n "$old_pid" ] && kill "$old_pid" 2>/dev/null
        rm -f "$PID_FILE" 2>/dev/null
    fi

    if [ -n "$mins" ] && [ "$mins" -gt 0 ]; then
        local now=$(date +%s)
        local exp=$((now + mins * 60))
        echo "$exp" > "$EXP_FILE"
        echo "$mins" > "$DUR_FILE"
        
        (
            echo "$$" > "$PID_FILE"
            sleep $((mins * 60))
            /usr/bin/study_mode.sh off >/dev/null 2>&1
            rm -f "$PID_FILE" 2>/dev/null
            
            # Gửi thông báo hoàn thành về Telegram
            if [ -x /usr/bin/send_telegram ]; then
                /usr/bin/send_telegram "🎉 <b>HẾT GIỜ HỌC BÀI / GIỜ ĐI NGỦ!</b>
━━━━━━━━━━━━━━━━━━━
⏰ Thời gian học bài (<b>${mins} phút</b>) đã hoàn tất!
🌐 Router đã tự động khôi phục toàn bộ kết nối Internet & giải trí cho các bé."
            fi
            if [ -x /usr/bin/tts_speaker.sh ]; then
                /usr/bin/tts_speaker.sh "Thời gian học bài ${mins} phút đã hết. Toàn bộ kết nối giải trí đã được mở lại bình thường cho các bé rồi ạ." force "NONE" "" >/dev/null 2>&1 &
            fi
        ) &
    else
        rm -f "$EXP_FILE" "$DUR_FILE" 2>/dev/null
    fi

    /etc/init.d/dnsmasq restart >/dev/null 2>&1
    echo "ENABLED"
}

disable_study_mode() {
    rm -f "$CONF_FILE" "$EXP_FILE" "$DUR_FILE" 2>/dev/null
    if [ -f "$PID_FILE" ]; then
        local old_pid=$(cat "$PID_FILE" 2>/dev/null)
        [ -n "$old_pid" ] && kill "$old_pid" 2>/dev/null
        rm -f "$PID_FILE" 2>/dev/null
    fi
    /etc/init.d/dnsmasq restart >/dev/null 2>&1
    echo "DISABLED"
}

status_study_mode() {
    if [ -f "$CONF_FILE" ]; then
        local now=$(date +%s)
        local exp=$(cat "$EXP_FILE" 2>/dev/null || echo 0)
        local dur=$(cat "$DUR_FILE" 2>/dev/null || echo 0)
        local rem=0
        if [ "$exp" -gt "$now" ]; then
            rem=$(( (exp - now + 59) / 60 ))
        fi
        echo "{\"status\":\"ACTIVE\",\"remaining\":$rem,\"duration\":$dur}"
    else
        echo "{\"status\":\"INACTIVE\"}"
    fi
}

case "$1" in
    on|enable|start)
        enable_study_mode "$2"
        ;;
    off|disable|stop)
        disable_study_mode
        ;;
    status)
        status_study_mode
        ;;
    *)
        enable_study_mode "$2"
        ;;
esac
STUDY_MODE_EOF
