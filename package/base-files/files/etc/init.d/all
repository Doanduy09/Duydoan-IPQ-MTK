                        <option value="Public_Share">🌐 Public_Share/ (Chia sẻ chung)</option>
                    </select>
                </div>

                <!-- Live Progress and Actions -->
                <div style="margin-top:14px; display:flex; flex-direction:column; gap:10px;">
                    <button class="btn-cta" style="width:100%; justify-content:center; padding:12px; font-size:0.92rem; background:linear-gradient(135deg, #10b981 0%, #059669 100%); transition:all 0.3s;" id="btnToggleAutoSyncSchedule" onclick="toggleAutoSyncSchedule()">
                        🔄 BẬT TỰ ĐỘNG ĐỒNG BỘ THEO GIỜ/PHÚT (AUTO-SYNC)
                    </button>
                    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:8px;">
                        <button class="btn-cta" style="width:100%; justify-content:center; padding:10px; font-size:0.84rem; background:linear-gradient(135deg, #0284c7 0%, #2563eb 100%);" id="btnStartLaptopSync" onclick="startLaptopSyncNow()">
                            ⚡ Đồng Bộ Ngay 1 Lần (Sync Now)
                        </button>
                        <button class="btn-sub" style="width:100%; justify-content:center; padding:10px; font-size:0.82rem;" onclick="downloadWindowsSyncBat()">
                            ⬇️ Tải Tool Sync Windows (.bat)
                        </button>
                    </div>
                </div>

                <!-- Progress Bar for Sync -->
                <div id="laptopSyncProgressBox" style="display:none; margin-top:12px; background:rgba(15,23,42,0.8); border:1px solid var(--border-color); border-radius:8px; padding:10px;">
                    <div style="display:flex; justify-content:space-between; font-size:0.75rem; color:var(--text-sub); margin-bottom:4px;">
                        <span id="laptopSyncCurrentFile">Đang đồng bộ...</span>
                        <span id="laptopSyncPercent">0%</span>
                    </div>
                    <div class="progress-bar-bg">
                        <div class="progress-fill-blue" id="laptopSyncFill" style="width:0%;"></div>
                    </div>
                </div>

                <!-- Sync Log Activity -->
                <div style="margin-top:12px; background:#070b14; border:1px solid var(--border-color); border-radius:8px; padding:8px 12px; font-size:0.72rem; color:var(--text-muted); font-family:monospace; max-height:80px; overflow-y:auto;" id="laptopSyncLog">
                    <div>[Hệ thống] Trạm đồng bộ Laptop sẵn sàng. Bấm "Cập Nhật Đồng Bộ Ngay" hoặc bật Tự Động.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-sub" onclick="closeModal('laptopSyncModal')">Đóng</button>
            </div>
        </div>
    </div>

