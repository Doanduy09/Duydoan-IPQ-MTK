        var isMenuVisible = false;
        var sidebarToggleBtn = E('button', {
            class: 'btn cbi-button',
            style: 'font-weight: 700; font-size: 12.5px; padding: 4px 10px; border-radius: 6px; cursor: pointer;',
            click: function(e) {
                var toggleStyle = document.getElementById('dynamic-menu-toggle-style');
                if (isMenuVisible) {
                    if (!toggleStyle) {
                        var sNode = document.createElement('style');
                        sNode.id = 'dynamic-menu-toggle-style';
                        sNode.innerHTML = `
                            header, nav, .main-header, .top, .bar, .header-bar, #mainmenu, aside, .main-left, .slidebar {
                                display: none !important;
                                visibility: hidden !important;
                            }
                        `;
                        document.head.appendChild(sNode);
                    }
                    document.body.classList.add('hide-side-menu');
                    isMenuVisible = false;
                    e.target.textContent = '📑 Hiện Menu';
                    window.dispatchEvent(new Event('resize'));
                } else {
                    if (toggleStyle) {
                        toggleStyle.remove();
                    }
                    document.body.classList.remove('hide-side-menu');

                    var elementsToRestore = document.querySelectorAll('.container, .container-fluid, .main-right, #maincontent');
                    for (var i = 0; i < elementsToRestore.length; i++) {
                        elementsToRestore[i].style.removeProperty('width');
                        elementsToRestore[i].style.removeProperty('max-width');
                        elementsToRestore[i].style.removeProperty('margin');
                    }

                    var menuEls = document.querySelectorAll('header, nav, .main-header, .top, .bar, .header-bar, #mainmenu, aside, .main-left, .slidebar');
                    menuEls.forEach(function(el) {
                        el.style.removeProperty('display');
                        el.style.removeProperty('visibility');
                    });

                    isMenuVisible = true;
                    e.target.textContent = '☰ Ẩn Menu';
                }
            }
        }, '📑 Hiện Menu');

        var inlineBtnGameMode = E('button', {
