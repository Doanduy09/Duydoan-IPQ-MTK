        advice = "Trạm phát LTE neo có tín hiệu yếu, nên đặt router gần cửa sổ hơn."
    end
else
    if n_sinr_num >= 30 and n_rsrp_num >= -80 then
        score = 100
    elseif n_sinr_num >= 25 and n_rsrp_num >= -88 then
        score = 95
    elseif n_sinr_num >= 20 and n_rsrp_num >= -95 then
        score = 88
    elseif n_sinr_num >= 15 and n_rsrp_num >= -100 then
        score = 80
    elseif n_sinr_num >= 10 then
        score = 70
    elseif n_sinr_num >= 5 then
        score = 60
    else
        score = 45
    end

    if prev_rsrp and math.abs(delta) >= 2 then
        if delta >= 2 then
            grade = "🌟 Cải Thiện" .. delta_str
            advice = string.format("📈 Tín hiệu vừa tăng +%d dBm (từ %d lên %d dBm)! Hướng xoay hiện tại rất chuẩn, hãy GIỮ NGUYÊN vị trí/hướng router này.", delta, prev_rsrp, n_rsrp_num)
        else
            grade = "⚠️ Suy Giảm" .. delta_str
            advice = string.format("📉 Tín hiệu vừa giảm %d dBm (từ %d xuống %d dBm)! Hướng vừa xoay bị chắn sóng hoặc lệch trạm. Hãy XOAY NGƯỢC LẠI hướng vừa rồi!", math.abs(delta), prev_rsrp, n_rsrp_num)
        end
    else
        if score >= 95 then
            grade = "🌟 Hoàn Hảo (Tối Ưu 100%)" .. delta_str
            advice = string.format("🌟 Vị trí đặt router hiện tại CỰC KỲ HOÀN HẢO! Sóng 5G %s đạt %d dBm (SINR %s dB sạch tuyệt đối), tốc độ đỉnh đạt tối đa. Không cần xoay thêm!", nr_b, n_rsrp_num, nr_sinr)
        elseif score >= 85 then
            grade = "🟢 Rất Tốt" .. delta_str
            advice = string.format("🟢 Chất lượng sóng 5G %s rất tốt (%d dBm). Bạn có thể xoay nhẹ 15°-30° sang trái hoặc phải để tìm góc đón sóng trực diện với trạm BTS.", nr_b, n_rsrp_num)
        elseif score >= 70 then
            grade = "🟡 Trung Bình Khá" .. delta_str
            advice = string.format("🟡 Tín hiệu sóng 5G ở mức ổn định (%d dBm) nhưng có vật cản. Nên dời router lại gần cửa sổ hoặc đưa lên vị trí cao hơn.", n_rsrp_num)
        else
            grade = "🔴 Sóng Yếu / Nhiễu Cao" .. delta_str
            advice = string.format("🔴 Sóng 5G bị suy hao hoặc nhiễu (%d dBm, SINR < 5 dB). Hãy xoay router sang hướng khác hoặc tránh xa các nguồn nhiễu tường bê tông dày.", n_rsrp_num)
        end
    end
end

local updated = os.date("!%H:%M:%S - %d/%m/%Y", os.time() + 7*3600)

