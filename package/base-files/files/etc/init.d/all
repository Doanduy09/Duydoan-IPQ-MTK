        // ==========================================
        // MOUSE DRAG MULTI-SELECTION (MARQUEE SELECTION)
        // Cho phép dùng chuột kéo quét để chọn nhanh nhiều tệp tin / thư mục
        // ==========================================
        (function initMarqueeSelection() {
            let isSelecting = false;
            let startX = 0, startY = 0;
            let marqueeBox = null;
            let initialSelected = new Set();

            function getMarqueeBox() {
                if (marqueeBox) return marqueeBox;
                marqueeBox = document.getElementById('marqueeSelectionBox');
                if (!marqueeBox) {
                    marqueeBox = document.createElement('div');
                    marqueeBox.id = 'marqueeSelectionBox';
                    document.body.appendChild(marqueeBox);
                }
                return marqueeBox;
            }

            document.addEventListener('DOMContentLoaded', function() {
                const dropArea = document.getElementById('dropArea') || document.body;

                dropArea.addEventListener('mousedown', function(e) {
                    if (e.button !== 0) return; // Chỉ nhận chuột trái
                    if (e.target.closest('button, a, input, select, textarea, .card-actions, .list-actions, .card-checkbox, .topbar, .sidebar, .actionbar, .modal')) {
                        return;
                    }

                    if (!e.ctrlKey && !e.shiftKey && !e.target.closest('.file-card.selected, .list-row.selected, .gallery-item.selected')) {
                        selectedItems.clear();
                        updateBatchBar();
                        document.querySelectorAll('.file-card.selected, .list-row.selected, .gallery-item.selected').forEach(el => {
                            el.classList.remove('selected');
                            const chk = el.querySelector('input[type="checkbox"]');
                            if (chk) chk.checked = false;
                        });
                    }

                    isSelecting = true;
                    startX = e.clientX;
                    startY = e.clientY;
                    initialSelected = new Set(selectedItems);

                    const box = getMarqueeBox();
                    box.style.left = startX + 'px';
                    box.style.top = startY + 'px';
                    box.style.width = '0px';
                    box.style.height = '0px';
                    box.style.display = 'none';
                });

                window.addEventListener('mousemove', function(e) {
                    if (!isSelecting) return;

                    const currentX = e.clientX;
                    const currentY = e.clientY;
                    const minX = Math.min(startX, currentX);
                    const minY = Math.min(startY, currentY);
                    const width = Math.abs(currentX - startX);
                    const height = Math.abs(currentY - startY);

                    if (width < 6 && height < 6) return;

                    const box = getMarqueeBox();
                    box.style.display = 'block';
                    box.style.left = minX + 'px';
                    box.style.top = minY + 'px';
                    box.style.width = width + 'px';
                    box.style.height = height + 'px';

                    const selectRect = {
                        left: minX,
                        top: minY,
                        right: minX + width,
                        bottom: minY + height
                    };

                    const cardElements = document.querySelectorAll('.file-card, .list-row, .gallery-item');
                    cardElements.forEach(card => {
                        const itemName = card.getAttribute('data-name');
                        if (!itemName) return;

                        const r = card.getBoundingClientRect();
                        const isIntersecting = !(selectRect.right < r.left || selectRect.left > r.right || selectRect.bottom < r.top || selectRect.top > r.bottom);

                        if (isIntersecting) {
                            selectedItems.add(itemName);
                            card.classList.add('selected');
                            const chk = card.querySelector('input[type="checkbox"]');
                            if (chk) chk.checked = true;
                        } else if (!initialSelected.has(itemName)) {
                            selectedItems.delete(itemName);
                            card.classList.remove('selected');
                            const chk = card.querySelector('input[type="checkbox"]');
                            if (chk) chk.checked = false;
                        }
                    });

                    updateBatchBar();
                });

                window.addEventListener('mouseup', function() {
                    if (!isSelecting) return;
                    isSelecting = false;
                    const box = getMarqueeBox();
                    if (box) box.style.display = 'none';
                    updateBatchBar();
                });
            });
        })();
    </script>
</body>
</html>
