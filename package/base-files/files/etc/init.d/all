    <script>
        let currentFolder = '';
        let currentItems = [];
        let viewMode = 'grid';
        let searchQuery = '';
        let activeCategory = 'all';
        let selectedItems = new Set();
        let sortKey = 'name';
        let sortAsc = true;

        const API = '/cgi-bin/airdrop';

        function handleUrlHash() {
            let hash = (window.location.hash || '').replace(/^#\/?/, '').trim();
            if (hash) {
                try {
                    hash = decodeURIComponent(hash);
                } catch(e) {}
                if (hash !== currentFolder) {
                    switchFolder(hash, false);
                    return true;
                }
            }
            return false;
        }

        window.addEventListener('DOMContentLoaded', () => {
            setupDragAndDrop();
            const handledHash = handleUrlHash();
            if (!handledHash) {
                loadFiles();
            }
            loadStorageStats();
            loadSysStats();
            loadNasClusterData();
            setupKeyboardShortcuts();
            setInterval(loadSysStats, 10000);
            window.addEventListener('hashchange', () => {
                handleUrlHash();
            });
        });

        function showToast(msg) {
            const t = document.getElementById('nasToast');
            t.innerText = msg;
            t.classList.add('active');
            clearTimeout(window._toastTimer);
            window._toastTimer = setTimeout(() => {
                t.classList.remove('active');
            }, 2600);
        }

        function setupKeyboardShortcuts() {
            window.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    closeAllModals();
                } else if (e.key === 'Backspace' && document.activeElement.tagName !== 'INPUT' && currentFolder) {
                    navigateUpFolder();
                }
            });
        }

        function closeAllModals() {
            closePreviewModal();
            closeModal('newFolderModal');
            closeModal('renameModal');
            closeModal('shareModal');
            closeModal('nasConfigModal');
        }

        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('mobile-open');
        }

        function setViewMode(mode) {
            viewMode = mode;
            document.getElementById('btnViewGrid').classList.toggle('active', mode === 'grid');
            document.getElementById('btnViewList').classList.toggle('active', mode === 'list');
            const bG = document.getElementById('btnViewGallery');
            if (bG) bG.classList.toggle('active', mode === 'gallery');
            renderExplorer();
        }

        function setCategoryFilter(category) {
            activeCategory = category;
            document.querySelectorAll('.pill-btn').forEach(btn => {
                const text = btn.innerText.toLowerCase();
                const isMatch = (category === 'all' && text.includes('tất cả')) ||
                                (category === 'image' && text.includes('ảnh')) ||
                                (category === 'video' && text.includes('video')) ||
                                (category === 'document' && text.includes('tài liệu')) ||
                                (category === 'audio' && text.includes('nhạc'));
                btn.classList.toggle('active', isMatch);
            });
            renderExplorer();
        }

        function switchFolder(folder, updateHash = true) {
            currentFolder = folder;
            if (updateHash && window.history && window.history.replaceState) {
                const newHash = folder ? ('#' + encodeURIComponent(folder)) : '';
                window.history.replaceState(null, '', window.location.pathname + window.location.search + newHash);
            }
            selectedItems.clear();
            updateBatchBar();
            document.querySelectorAll('.nav-item').forEach(el => {
                const f = el.getAttribute('data-folder');
                el.classList.toggle('active', f === currentFolder);
            });
            renderBreadcrumbs();
            document.getElementById('sidebar').classList.remove('mobile-open');
            document.getElementById('btnParentFolder').style.display = currentFolder ? 'inline-flex' : 'none';
            loadFiles();
        }

        function navigateUpFolder() {
            if (!currentFolder) return;
            const parts = currentFolder.split('/');
            parts.pop();
            switchFolder(parts.join('/'));
        }

        function renderBreadcrumbs() {
            const container = document.getElementById('breadcrumbBar');
            if (!currentFolder) {
                container.innerHTML = `<span class="bc-item current" onclick="switchFolder('')">🏠 Athena NAS</span>`;
                return;
            }

            const parts = currentFolder.split('/');
            let html = `<span class="bc-item" onclick="switchFolder('')">🏠 Gốc</span>`;
            let accumulated = '';
            for (let i = 0; i < parts.length; i++) {
                accumulated += (i > 0 ? '/' : '') + parts[i];
                html += `<span class="bc-sep">/</span>`;
                if (i === parts.length - 1) {
                    html += `<span class="bc-item current">${escapeHtml(parts[i])}</span>`;
                } else {
                    const jumpPath = accumulated;
                    html += `<span class="bc-item" onclick="switchFolder('${escapeHtml(jumpPath)}')">${escapeHtml(parts[i])}</span>`;
                }
            }
            container.innerHTML = html;
        }

        async function loadFiles() {
            const counter = document.getElementById('itemCounter');
            counter.innerText = 'Đang tải...';

            try {
                const res = await fetch(`${API}?action=list&folder=${encodeURIComponent(currentFolder)}&t=${Date.now()}`);
                const data = await res.json();
                currentItems = Array.isArray(data) ? data : (data.items || []);
                renderExplorer();
            } catch (err) {
                console.error(err);
                counter.innerText = 'Lỗi kết nối máy chủ';
            }
        }

        function handleSearch(query) {
            searchQuery = query.toLowerCase().trim();
            renderExplorer();
        }

        function toggleSort(key) {
            if (sortKey === key) {
                sortAsc = !sortAsc;
            } else {
                sortKey = key;
                sortAsc = true;
            }
            renderExplorer();
        }

        function getFilteredAndSortedItems() {
            let list = currentItems.filter(item => {
                const matchesSearch = !searchQuery || item.name.toLowerCase().includes(searchQuery);
                const matchesCat = (activeCategory === 'all') || (item.is_dir) || (item.type === activeCategory);
                return matchesSearch && matchesCat;
            });

            list.sort((a, b) => {
                if (a.is_dir !== b.is_dir) {
                    return a.is_dir ? -1 : 1;
                }
                let valA = a[sortKey];
                let valB = b[sortKey];
                if (typeof valA === 'string') {
                    valA = valA.toLowerCase();
                    valB = valB.toLowerCase();
                }
                if (valA < valB) return sortAsc ? -1 : 1;
                if (valA > valB) return sortAsc ? 1 : -1;
                return 0;
            });

            return list;
        }

        function getItemIcon(item) {
            if (item.is_dir) return '📁';
            switch (item.type) {
                case 'image': return '🖼️';
                case 'video': return '🎬';
                case 'audio': return '🎵';
                case 'document': return '📄';
                case 'code': return '💻';
                case 'archive': return '📦';
                default: return '📄';
            }
        }

        function toggleItemSelection(name, event) {
            if (event) event.stopPropagation();
            if (selectedItems.has(name)) {
                selectedItems.delete(name);
            } else {
                selectedItems.add(name);
            }
            updateBatchBar();
            renderExplorer();
        }

        function toggleSelectAll(event) {
            const items = getFilteredAndSortedItems();
            if (selectedItems.size === items.length) {
                selectedItems.clear();
            } else {
                items.forEach(i => selectedItems.add(i.name));
            }
            updateBatchBar();
            renderExplorer();
        }

        function clearSelection() {
            selectedItems.clear();
            updateBatchBar();
            renderExplorer();
        }

        function updateBatchBar() {
            const bar = document.getElementById('batchBar');
            const countLabel = document.getElementById('batchCountLabel');
            if (selectedItems.size > 0) {
                countLabel.innerText = `Đã chọn ${selectedItems.size} mục`;
                bar.classList.add('active');
            } else {
                bar.classList.remove('active');
            }
        }

        async function deleteSelectedBatch() {
            if (selectedItems.size === 0) return;
            if (!confirm(`Bạn có chắc chắn muốn xóa ${selectedItems.size} mục đã chọn không?`)) return;

            for (const name of selectedItems) {
                try {
                    await fetch(`${API}?action=delete&folder=${encodeURIComponent(currentFolder)}&name=${encodeURIComponent(name)}`);
                } catch (e) {}
            }
            selectedItems.clear();
            updateBatchBar();
            showToast('🗑️ Đã xóa các mục đã chọn thành công!');
            loadFiles();
            loadStorageStats();
        }

        function downloadSelectedBatch() {
            if (selectedItems.size === 0) return;
            selectedItems.forEach(name => {
                downloadFile(name);
            });
            showToast('⬇️ Đang bắt đầu tải xuống...');
        }

        function getCloudBannerHtml() {
            if (!currentFolder || !currentFolder.startsWith('Cloud_Sync')) return '';
            let cloudAcc = null;
            if (currentNasData && currentNasData.clouds) {
                cloudAcc = currentNasData.clouds.find(c => {
                    const sub = c.subfolder || ('Cloud_Sync/' + (c.name || '').replace(/[^\w-]/g, '_'));
                    return currentFolder.startsWith(sub) || sub.startsWith(currentFolder);
                });
            }
            const email = cloudAcc ? cloudAcc.email : 'Chưa cấu hình';
            const quotaTotal = cloudAcc ? (cloudAcc.quota_total || '5.00 TB') : '5.00 TB';
            const quotaUsed = cloudAcc ? (cloudAcc.quota_used || '0 MB') : '0 MB';
            const quotaFree = cloudAcc ? (cloudAcc.quota_free || '5.00 TB') : '5.00 TB';
            const cId = cloudAcc ? cloudAcc.id : 'cloud_default';
            const cName = cloudAcc ? (cloudAcc.name || 'Google Drive') : 'Google Drive';
            const remoteDir = (cloudAcc && cloudAcc.remote_folder && cloudAcc.remote_folder !== 'rm3000') ? cloudAcc.remote_folder : 'Toàn bộ Drive (Gốc)';

            return `
                <div style="margin-bottom:16px; padding:12px 18px; border-radius:12px; background:linear-gradient(90deg, rgba(2, 132, 199, 0.15), rgba(15, 23, 42, 0.85)); border:1px solid rgba(56, 189, 248, 0.35); display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:12px; box-shadow:0 4px 20px rgba(0,0,0,0.25);">
                    <div style="display:flex; align-items:center; gap:12px;">
                        <div style="font-size:1.8rem; background:rgba(56,189,248,0.15); width:44px; height:44px; display:flex; align-items:center; justify-content:center; border-radius:10px; border:1px solid rgba(56,189,248,0.3);">☁️</div>
                        <div>
                            <div style="font-weight:700; font-size:0.92rem; color:#fff; display:flex; align-items:center; gap:8px;">
                                ${escapeHtml(cName)}
                                <span style="font-size:0.7rem; padding:2px 8px; border-radius:10px; background:rgba(52,211,153,0.2); color:#34d399; font-weight:700;">🟢 ĐÃ LIÊN KẾT & TỰ ĐỘNG ĐỒNG BỘ</span>
                            </div>
                            <div style="font-size:0.76rem; color:var(--text-sub); margin-top:2px;">
                                Tài khoản: <b style="color:#38bdf8; font-family:monospace;">${escapeHtml(email)}</b> • Dung lượng: <b style="color:#38bdf8;">${escapeHtml(quotaUsed)} / ${escapeHtml(quotaTotal)}</b> (Trống: <b style="color:#34d399;">${escapeHtml(quotaFree)}</b>) • Thư mục: <b style="color:#fde047; font-family:monospace;">${escapeHtml(remoteDir)}</b>
                            </div>
                        </div>
                    </div>
                    <div style="display:flex; gap:8px; align-items:center;">
                        <span style="font-size:0.72rem; color:var(--text-muted); background:rgba(255,255,255,0.05); padding:4px 8px; border-radius:6px; border:1px solid rgba(255,255,255,0.1);">⚡ Rclone ARM64 Native</span>
                        <button class="btn-cta" style="padding:6px 14px; font-size:0.78rem; background:linear-gradient(135deg, #0284c7, #06b6d4);" onclick="syncCloudAccount('${escapeHtml(cId)}', '${escapeHtml(cName)}')">🔄 Đồng Bộ Ngay</button>
                    </div>
                </div>
            `;
        }

        function renderExplorer() {
            const container = document.getElementById('explorerContainer');
            const items = getFilteredAndSortedItems();
            const counter = document.getElementById('itemCounter');
            const bannerHtml = getCloudBannerHtml();

            counter.innerText = `${items.length} mục`;

            if (items.length === 0) {
                container.innerHTML = bannerHtml + `
                    <div class="empty-box">
                        <div class="empty-icon">📂</div>
                        <h3>Không có tệp tin phù hợp</h3>
                        <p>Kéo thả tệp trực tiếp vào cửa sổ này hoặc nhấn nút "Tải Lên Tệp" phía trên để lưu trữ ngay.</p>
                    </div>
                `;
                return;
            }

            if (viewMode === 'grid') {
                renderGrid(container, items, bannerHtml);
            } else if (viewMode === 'gallery') {
                renderGallery(container, items, bannerHtml);
            } else {
                renderList(container, items, bannerHtml);
            }
        }

        function renderGallery(container, items, bannerHtml = '') {
            const mediaItems = items.filter(it => !it.is_dir && (it.type === 'image' || it.type === 'video'));
            const dirItems = items.filter(it => it.is_dir);

            let foldersHtml = '';
            if (dirItems.length > 0) {
                foldersHtml = '<div class="gallery-folders-bar">';
                dirItems.forEach(d => {
                    const fPath = currentFolder ? currentFolder + '/' + d.name : d.name;
                    foldersHtml += `<div class="gallery-folder-chip" onclick="switchFolder('${escapeHtml(fPath)}')">📁 ${escapeHtml(d.name)}</div>`;
                });
                foldersHtml += '</div>';
            }

            if (mediaItems.length === 0) {
                container.innerHTML = bannerHtml + foldersHtml + `
                    <div class="empty-box" style="padding:40px 20px;">
                        <div class="empty-icon">🖼️</div>
                        <h3>Chưa Có Ảnh Hoặc Video Trong Thư Mục Này</h3>
                        <p>Bấm vào các thư mục phía trên hoặc chuyển sang chế độ 🔲 Lưới / 📋 Danh sách để duyệt tất cả tệp tin.</p>
                    </div>
                `;
                return;
            }

            let html = bannerHtml + foldersHtml + '<div class="gallery-view">';
            mediaItems.forEach(item => {
                const isVideo = item.type === 'video';
                const fileUrl = `${API}?action=view&folder=${encodeURIComponent(currentFolder)}&name=${encodeURIComponent(item.name)}`;
                const clickAction = `openPreview('${escapeHtml(item.name)}', '${item.type}')`;

                html += `
                    <div class="gallery-item" data-name="${escapeHtml(item.name)}" onclick="${clickAction}">
                        ${isVideo ? `<div class="video-badge">▶️ Video</div>` : ''}
                        <img src="${fileUrl}" loading="lazy" alt="${escapeHtml(item.name)}">
                        <div class="gallery-overlay">
                            <div class="gallery-name" title="${escapeHtml(item.name)}">${escapeHtml(item.name)}</div>
                            <div class="gallery-meta">${item.size_str}</div>
                        </div>
                    </div>
                `;
            });
            html += '</div>';
            container.innerHTML = html;
        }

        function renderGrid(container, items, bannerHtml = '') {
            let html = bannerHtml + '<div class="grid-view">';
            items.forEach(item => {
                const isDir = item.is_dir;
                const icon = getItemIcon(item);
                const isChecked = selectedItems.has(item.name);
                const clickAction = isDir 
                    ? `switchFolder('${escapeHtml(currentFolder ? currentFolder + '/' + item.name : item.name)}')`
                    : `openPreview('${escapeHtml(item.name)}', '${item.type}')`;

                let thumbHtml = `<span class="card-icon">${icon}</span>`;
                if (!isDir && item.type === 'image') {
                    const imgUrl = `${API}?action=view&folder=${encodeURIComponent(currentFolder)}&name=${encodeURIComponent(item.name)}`;
                    thumbHtml = `<img src="${imgUrl}" loading="lazy" alt="${escapeHtml(item.name)}">`;
                }

                html += `
                    <div class="file-card ${isChecked ? 'selected' : ''}" data-name="${escapeHtml(item.name)}" onclick="${clickAction}">
                        <input type="checkbox" class="card-checkbox" ${isChecked ? 'checked' : ''} onclick="toggleItemSelection('${escapeHtml(item.name)}', event)">
                        <div class="card-actions" onclick="event.stopPropagation()">
                            ${!isDir ? `<button class="card-btn" title="Xem trước" onclick="openPreview('${escapeHtml(item.name)}', '${item.type}')">👁️</button>` : ''}
                            ${!isDir ? `<button class="card-btn" title="Tải về" onclick="downloadFile('${escapeHtml(item.name)}')">⬇️</button>` : ''}
                            ${!isDir ? `<button class="card-btn" title="Chia sẻ" onclick="openShareModal('${escapeHtml(item.name)}')">🔗</button>` : ''}
                            <button class="card-btn" title="Đổi tên" onclick="openRenameModal('${escapeHtml(item.name)}')">✏️</button>
                            <button class="card-btn btn-danger" title="Xóa" onclick="deleteItem('${escapeHtml(item.name)}')">🗑️</button>
                        </div>
                        <div class="card-thumb">${thumbHtml}</div>
                        <div class="card-name" title="${escapeHtml(item.name)}">${escapeHtml(item.name)}</div>
                        <div class="card-meta">${isDir ? 'Thư mục' : item.size_str}</div>
                    </div>
                `;
            });
            html += '</div>';
            container.innerHTML = html;
        }

        function renderList(container, items, bannerHtml = '') {
            const allSelected = items.length > 0 && selectedItems.size === items.length;
            const sortArrow = (key) => (sortKey === key ? (sortAsc ? ' ▲' : ' ▼') : '');

            let html = bannerHtml + `
                <table class="list-view">
                    <thead>
                        <tr>
                            <th style="width: 36px;"><input type="checkbox" ${allSelected ? 'checked' : ''} onclick="toggleSelectAll(event)"></th>
                            <th onclick="toggleSort('name')">Tên Tệp / Thư Mục${sortArrow('name')}</th>
                            <th onclick="toggleSort('type')">Phân Loại${sortArrow('type')}</th>
                            <th onclick="toggleSort('size')">Kích Thước${sortArrow('size')}</th>
                            <th onclick="toggleSort('date')">Ngày Cập Nhật${sortArrow('date')}</th>
                            <th style="text-align:right;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
            `;
            items.forEach(item => {
                const isDir = item.is_dir;
                const icon = getItemIcon(item);
                const isChecked = selectedItems.has(item.name);
                const clickAction = isDir 
                    ? `switchFolder('${escapeHtml(currentFolder ? currentFolder + '/' + item.name : item.name)}')`
                    : `openPreview('${escapeHtml(item.name)}', '${item.type}')`;

                let typeLabel = isDir ? 'Thư mục' : (item.ext ? item.ext.toUpperCase() : 'Tệp');
                let typeClass = isDir ? 'type-folder' : `type-${item.type || 'document'}`;

                html += `
                    <tr class="list-row ${isChecked ? 'selected' : ''}" data-name="${escapeHtml(item.name)}" onclick="${clickAction}">
                        <td onclick="event.stopPropagation()"><input type="checkbox" ${isChecked ? 'checked' : ''} onclick="toggleItemSelection('${escapeHtml(item.name)}', event)"></td>
                        <td>
                            <div class="list-name-col">
                                <span class="list-icon">${icon}</span>
                                <span title="${escapeHtml(item.name)}">${escapeHtml(item.name)}</span>
                            </div>
                        </td>
                        <td><span class="list-type-badge ${typeClass}">${typeLabel}</span></td>
                        <td>${isDir ? '--' : item.size_str}</td>
                        <td style="color:var(--text-sub);">${item.date || '--'}</td>
                        <td style="text-align:right;" onclick="event.stopPropagation()">
                            <div class="list-actions" style="justify-content:flex-end;">
                                ${!isDir ? `<button class="btn-list-action" title="Xem trước" onclick="openPreview('${escapeHtml(item.name)}', '${item.type}')">👁️</button>` : ''}
                                ${!isDir ? `<button class="btn-list-action" title="Tải về" onclick="downloadFile('${escapeHtml(item.name)}')">⬇️</button>` : ''}
                                ${!isDir ? `<button class="btn-list-action" title="Chia sẻ" onclick="openShareModal('${escapeHtml(item.name)}')">🔗</button>` : ''}
                                <button class="btn-list-action" title="Đổi tên" onclick="openRenameModal('${escapeHtml(item.name)}')">✏️</button>
                                <button class="btn-list-action del" title="Xóa" onclick="deleteItem('${escapeHtml(item.name)}')">🗑️</button>
                            </div>
                        </td>
                    </tr>
                `;
            });
            html += '</tbody></table>';
            container.innerHTML = html;
        }

        function downloadFile(name) {
            window.location.href = `${API}?action=download&folder=${encodeURIComponent(currentFolder)}&name=${encodeURIComponent(name)}`;
        }

        function setupDragAndDrop() {
            const overlay = document.getElementById('dragOverlay');

            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(name => {
                window.addEventListener(name, (e) => e.preventDefault(), false);
            });

            window.addEventListener('dragover', (e) => {
                e.preventDefault();
                overlay.classList.add('active');
                document.getElementById('dragTargetFolder').innerText = `Tải vào: ${currentFolder ? currentFolder : 'Thư mục gốc (Root)'}`;
            });

            window.addEventListener('dragleave', (e) => {
                if (e.clientX <= 0 || e.clientY <= 0) {
                    overlay.classList.remove('active');
                }
            });

            window.addEventListener('drop', async (e) => {
                e.preventDefault();
                overlay.classList.remove('active');
                if (e.dataTransfer && e.dataTransfer.items && e.dataTransfer.items.length > 0) {
                    const files = await getFilesFromDataTransfer(e.dataTransfer.items);
                    if (files.length > 0) {
                        handleFileSelect(files);
                        return;
                    }
                }
                if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                    handleFileSelect(Array.from(e.dataTransfer.files));
                }
            });
        }

        async function getFilesFromDataTransfer(items) {
            const result = [];
            async function traverse(entry, path) {
                if (entry.isFile) {
                    await new Promise((resolve) => {
                        entry.file((f) => {
                            f.customRelativePath = path ? `${path}/${f.name}` : f.name;
                            result.push(f);
                            resolve();
                        }, () => resolve());
                    });
                } else if (entry.isDirectory) {
                    const dirReader = entry.createReader();
                    const newPath = path ? `${path}/${entry.name}` : entry.name;
                    await new Promise((resolve) => {
                        dirReader.readEntries(async (entries) => {
                            for (const child of entries) {
                                await traverse(child, newPath);
                            }
                            resolve();
                        }, () => resolve());
                    });
                }
            }
            for (let i = 0; i < items.length; i++) {
                const item = items[i];
                if (item.webkitGetAsEntry) {
                    const entry = item.webkitGetAsEntry();
                    if (entry) await traverse(entry, '');
                }
            }
            return result;
        }

        function triggerFileInput() {
            document.getElementById('fileInput').click();
        }

        async function handleFileSelect(files) {
            if (!files || files.length === 0) return;
            const floatBox = document.getElementById('uploadFloat');
            floatBox.classList.add('active');

            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                const displayPath = file.customRelativePath || file.webkitRelativePath || file.name;
                document.getElementById('uploadFloatTitle').innerText = `Đang tải ${i + 1}/${files.length}`;
                document.getElementById('uploadFileName').innerText = displayPath;
                document.getElementById('uploadFloatFill').style.width = '0%';
                document.getElementById('uploadFloatPercent').innerText = '0%';

                await uploadSingleFile(file);
            }

            document.getElementById('uploadFloatTitle').innerText = '✅ Tải lên hoàn tất!';
            showToast(`✅ Đã tải lên thành công ${files.length} tệp tin!`);
            setTimeout(() => {
                floatBox.classList.remove('active');
                loadFiles();
                loadStorageStats();
            }, 1200);
        }

        function uploadSingleFile(file) {
            return new Promise((resolve) => {
                const xhr = new XMLHttpRequest();
                const startTime = Date.now();

                xhr.upload.onprogress = (e) => {
                    if (e.lengthComputable) {
                        const percent = Math.round((e.loaded / e.total) * 100);
                        document.getElementById('uploadFloatFill').style.width = `${percent}%`;
                        document.getElementById('uploadFloatPercent').innerText = `${percent}%`;

                        const elapsed = (Date.now() - startTime) / 1000;
                        if (elapsed > 0) {
                            const speed = Math.round((e.loaded / 1024) / elapsed);
                            document.getElementById('uploadSpeed').innerText = `${speed} KB/s`;
                        }
                    }
                };

                xhr.onload = () => resolve();
                xhr.onerror = () => resolve();

                const formData = new FormData();
                const relPath = file.customRelativePath || file.webkitRelativePath || file.name;
                formData.append('file', file, relPath);
                xhr.open('POST', `${API}?action=upload&folder=${encodeURIComponent(currentFolder)}`);
                xhr.send(formData);
            });
        }

        function openNewFolderModal() {
            document.getElementById('newFolderNameInput').value = '';
            document.getElementById('newFolderModal').classList.add('open');
            document.getElementById('newFolderNameInput').focus();
        }

        async function confirmCreateFolder() {
            const name = document.getElementById('newFolderNameInput').value.trim();
            if (!name) return;
            closeModal('newFolderModal');

            try {
                await fetch(`${API}?action=mkdir&folder=${encodeURIComponent(currentFolder)}&name=${encodeURIComponent(name)}`);
                showToast(`📁 Đã tạo thư mục [${name}] thành công!`);
                loadFiles();
            } catch (err) {
                showToast('❌ Không thể tạo thư mục');
            }
        }

        function openRenameModal(oldName) {
            document.getElementById('renameOldName').value = oldName;
            document.getElementById('renameNewNameInput').value = oldName;
            document.getElementById('renameModal').classList.add('open');
            document.getElementById('renameNewNameInput').focus();
        }

        async function confirmRename() {
            const oldName = document.getElementById('renameOldName').value;
            const newName = document.getElementById('renameNewNameInput').value.trim();
            if (!newName || newName === oldName) {
                closeModal('renameModal');
                return;
            }
            closeModal('renameModal');

            try {
                await fetch(`${API}?action=rename&folder=${encodeURIComponent(currentFolder)}&old_name=${encodeURIComponent(oldName)}&new_name=${encodeURIComponent(newName)}`);
                showToast(`✏️ Đã đổi tên thành [${newName}]!`);
                loadFiles();
            } catch (err) {
                showToast('❌ Không thể đổi tên');
            }
        }

        async function deleteItem(name) {
            if (!confirm(`Bạn có chắc chắn muốn xóa mục [${name}] không?`)) return;
            try {
                await fetch(`${API}?action=delete&folder=${encodeURIComponent(currentFolder)}&name=${encodeURIComponent(name)}`);
                showToast(`🗑️ Đã xóa [${name}] thành công!`);
                loadFiles();
                loadStorageStats();
            } catch (err) {
                showToast('❌ Lỗi xóa mục');
            }
        }

        let currentShareFileName = '';

        async function openShareModal(name) {
            currentShareFileName = name;
            
            // 1. Update file target info in UI
            const item = currentItems ? currentItems.find(x => x.name === name) : null;
            const sizeStr = item ? (item.size_str || '') : '';
            const fileNameEl = document.getElementById('shareTargetFileName');
            const fileSizeEl = document.getElementById('shareTargetFileSize');
            if (fileNameEl) fileNameEl.innerText = name;
            if (fileSizeEl) fileSizeEl.innerText = sizeStr ? `Dung lượng: ${sizeStr}` : '';

            // 2. Reset create result box
            const resBox = document.getElementById('shareResultBox');
            if (resBox) resBox.style.display = 'none';

            // 3. Setup Tab 2: Local LAN link
            const pathPart = `${API}?action=download&folder=${encodeURIComponent(currentFolder)}&name=${encodeURIComponent(name)}`;
            const localOrigin = window.location.origin.includes('100.') ? 'http://192.168.1.1:8080' : window.location.origin;
            const localUrl = `${localOrigin}${pathPart}`;
            const localInput = document.getElementById('shareLocalUrlInput');
            if (localInput) localInput.value = localUrl;
            drawSimpleQrCode('shareQrCanvasLocal', localUrl);

            // 4. Default to Tab 1 (Create self-expiring link)
            switchShareMainTab('create');

            // 5. Open modal
            document.getElementById('shareModal').classList.add('open');
        }

        function switchShareMainTab(tab) {
            const btnCreate = document.getElementById('shareMainTabBtnCreate');
            const btnLocal = document.getElementById('shareMainTabBtnLocal');
            const btnManage = document.getElementById('shareMainTabBtnManage');
            if (btnCreate) btnCreate.classList.toggle('active', tab === 'create');
            if (btnLocal) btnLocal.classList.toggle('active', tab === 'local');
            if (btnManage) btnManage.classList.toggle('active', tab === 'manage');

            const tabCreate = document.getElementById('shareTabCreate');
            const tabLocal = document.getElementById('shareTabLocal');
            const tabManage = document.getElementById('shareTabManage');
            if (tabCreate) tabCreate.style.display = (tab === 'create') ? 'block' : 'none';
            if (tabLocal) tabLocal.style.display = (tab === 'local') ? 'block' : 'none';
            if (tabManage) tabManage.style.display = (tab === 'manage') ? 'block' : 'none';

            if (tab === 'manage') {
                loadActiveSharesList();
            }
        }

        async function createSelfExpiringShareSubmit() {
            if (!currentShareFileName) {
                showToast('❌ Không tìm thấy tệp tin!');
                return;
            }
            const btn = document.getElementById('btnCreateShareLink');
            const hours = document.getElementById('shareExpireHours').value;
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '⏳ Đang tạo liên kết tự hủy...';
            }

            try {
                const res = await fetch(`${API}?action=create_share&folder=${encodeURIComponent(currentFolder)}&name=${encodeURIComponent(currentShareFileName)}&hours=${encodeURIComponent(hours)}`);
                const data = await res.json();
                if (data.ok) {
                    const resBox = document.getElementById('shareResultBox');
                    if (resBox) resBox.style.display = 'block';

                    const genUrl = document.getElementById('shareGeneratedUrl');
                    if (genUrl) genUrl.value = data.funnel_share_url || data.share_url || '';

                    // REMOTE WEB DIRECT LINK (100% 5G SPEED)
                    let remoteUrl = data.remote_share_url || '';
                    if (!window.location.hostname.startsWith('192.168.') && !window.location.hostname.includes('.ts.net')) {
                        remoteUrl = `${window.location.origin}/cgi-bin/airdrop?action=share&token=${encodeURIComponent(data.token)}`;
                    } else if (!remoteUrl) {
                        const liveTsIp = (currentNasData && currentNasData.tailscale_ip && currentNasData.tailscale_ip !== '127.0.0.1') ? currentNasData.tailscale_ip : window.location.hostname;
                        remoteUrl = `http://${liveTsIp}:8080/cgi-bin/airdrop?action=share&token=${encodeURIComponent(data.token)}`;
                    }
                    const remoteGenUrl = document.getElementById('shareRemoteUrl');
                    if (remoteGenUrl) remoteGenUrl.value = remoteUrl;

                    const localGenUrl = document.getElementById('shareLocalUrl');
                    if (localGenUrl) localGenUrl.value = data.local_share_url || `http://192.168.1.1/cgi-bin/airdrop?action=share&token=${encodeURIComponent(data.token)}`;

                    const notice = document.getElementById('shareExpireNotice');
                    if (notice) {
                        notice.innerText = hours === '0' ? '♾️ Vĩnh viễn (Không tự hủy)' : `⏱️ Hết hạn sau ${hours} giờ`;
                    }

                    // Store active URLs for QR switcher & Direct buttons
                    currentShareGlobalUrl = data.funnel_share_url || data.share_url || '';
                    currentShareRemoteUrl = remoteUrl;
                    currentShareLocalUrl = data.local_share_url || `http://192.168.1.1/cgi-bin/airdrop?action=share&token=${encodeURIComponent(data.token)}`;

                    const btnDirectDl = document.getElementById('btnShareDirectDownload');
                    if (btnDirectDl) {
                        // Tải trực tiếp qua kênh web người dùng đang kết nối (100% không bị bóp)
                        btnDirectDl.href = `/cgi-bin/airdrop?action=share&token=${encodeURIComponent(data.token)}&download=1`;
                    }

                    const btnTestOpen = document.getElementById('btnShareTestOpenLink');
                    if (btnTestOpen) {
                        btnTestOpen.href = currentShareRemoteUrl || currentShareGlobalUrl || currentShareLocalUrl;
                    }

                    switchShareQr('remote');

                    showToast('✅ Đã tạo liên kết chia sẻ Siêu Tốc thành công!');
                } else {
                    showToast('❌ Không thể tạo liên kết: ' + (data.error || 'Lỗi'));
                }
            } catch (err) {
                showToast('❌ Lỗi kết nối tạo liên kết');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '⚡ TẠO LINK CHIA SẺ RA NGOÀI NGAY';
                }
            }
        }

        async function loadActiveSharesList() {
            const tbody = document.getElementById('activeSharesTableBody');
            if (!tbody) return;
            tbody.innerHTML = '<tr><td colspan="5" style="padding:16px; text-align:center; color:var(--text-muted);">Đang nạp danh sách liên kết...</td></tr>';
            
            try {
                const res = await fetch(`${API}?action=list_shares&t=${Date.now()}`);
                const data = await res.json();
                const shares = data.shares || [];
                if (shares.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" style="padding:16px; text-align:center; color:var(--text-muted);">Chưa có liên kết chia sẻ nào đang hoạt động.</td></tr>';
                    return;
                }

                let html = '';
                shares.forEach(s => {
                    const liveTsIp = (currentNasData && currentNasData.tailscale_ip && currentNasData.tailscale_ip !== '127.0.0.1') ? currentNasData.tailscale_ip : '100.96.94.19';
                    const remoteDlUrl = s.remote_url || (`http://${liveTsIp}:8080/cgi-bin/airdrop?action=share&token=` + encodeURIComponent(s.token));
                    const localDlUrl = s.local_url || `http://192.168.1.1:8080/cgi-bin/airdrop?action=share&token=${encodeURIComponent(s.token)}`;
                    const isExp = s.is_expired;
                    const badge = isExp ? 
                        `<span style="background:rgba(239,68,68,0.2); color:#f87171; padding:2px 8px; border-radius:12px; font-weight:700;">Đã hết hạn</span>` :
                        `<span style="background:rgba(16,185,129,0.2); color:#34d399; padding:2px 8px; border-radius:12px; font-weight:700;">⏱️ ${escapeHtml(s.remaining_str || 'Đang mở')}</span>`;

                    html += `
                        <tr style="border-bottom:1px solid var(--border-color);">
                            <td style="padding:8px 10px; font-weight:700; color:#fff; max-width:140px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="${escapeHtml(s.name)}">📦 ${escapeHtml(s.name)}</td>
                            <td style="padding:8px 10px; color:var(--text-sub);">${escapeHtml(s.size_str || '--')}</td>
                            <td style="padding:8px 10px;">${badge}</td>
                            <td style="padding:8px 10px; text-align:center; font-family:monospace; color:var(--primary-neon);">${s.downloads || 0}</td>
                            <td style="padding:8px 10px; text-align:right;">
                                <div style="display:flex; gap:6px; justify-content:flex-end; flex-wrap:wrap;">
                                    <button class="btn-sub" style="padding:3px 8px; font-size:0.75rem; border-color:#a855f7; color:#c084fc;" title="Sao chép link tải qua Web Quản Trị Từ Xa (Full 100% 5G)" onclick="copyTextSafe('${escapeHtml(remoteDlUrl)}', '🚀 Đã sao chép Link Web Từ Xa (Siêu Tốc 100% 5G)!');">🚀 Web Từ Xa</button>
                                    <button class="btn-cta" style="padding:3px 8px; font-size:0.75rem;" title="Sao chép link tải ngoài mạng toàn cầu (Funnel)" onclick="copyTextSafe('${escapeHtml(funnelDlUrl)}', '🌐 Đã sao chép Link Ngoài Toàn Cầu!');">🌐 Toàn Cầu</button>
                                    <button class="btn-sub" style="padding:3px 8px; font-size:0.75rem; border-color:#10b981; color:#34d399;" title="Sao chép link tải qua Wi-Fi ở nhà" onclick="copyTextSafe('${escapeHtml(localDlUrl)}', '🏠 Đã sao chép Link Ở Nhà (Wi-Fi 6)!');">🏠 Link Nhà</button>
                                    <button class="btn-sub" style="padding:3px 8px; font-size:0.75rem; border-color:var(--accent-red); color:var(--accent-red);" title="Hủy liên kết" onclick="revokeShare('${escapeHtml(s.token)}')">🗑️ Hủy</button>
                                </div>
                            </td>
                        </tr>
                    `;
                });
                tbody.innerHTML = html;
            } catch (err) {
                tbody.innerHTML = '<tr><td colspan="5" style="padding:16px; text-align:center; color:var(--accent-red);">Lỗi nạp danh sách chia sẻ.</td></tr>';
            }
        }

        async function revokeShare(token) {
            if (!confirm('Bạn có chắc muốn hủy liên kết chia sẻ này ngay? Sau khi hủy, người khác sẽ không thể tải được.')) return;
            try {
                const res = await fetch(`${API}?action=revoke_share&token=${encodeURIComponent(token)}`);
                const data = await res.json();
                if (data.ok) {
                    showToast('🗑️ Đã hủy liên kết chia sẻ thành công!');
                    loadActiveSharesList();
                } else {
                    showToast('❌ Không thể hủy: ' + (data.error || 'Lỗi'));
                }
            } catch (err) {
                showToast('❌ Lỗi gửi yêu cầu hủy liên kết');
            }
        }

        let currentShareGlobalUrl = '';
        let currentShareRemoteUrl = '';
        let currentShareLocalUrl = '';

        function switchShareQr(mode) {
            const btnG = document.getElementById('btnQrSwitchGlobal');
            const btnR = document.getElementById('btnQrSwitchRemote');
            const btnL = document.getElementById('btnQrSwitchLocal');
            const hint = document.getElementById('shareQrHint');

            if (btnG) btnG.classList.remove('active');
            if (btnR) btnR.classList.remove('active');
            if (btnL) btnL.classList.remove('active');

            if (mode === 'local') {
                if (btnL) btnL.classList.add('active');
                drawSimpleQrCode('shareQrCanvas', currentShareLocalUrl);
                if (hint) hint.innerText = '🏠 Đang hiển thị QR Tải Siêu Tốc Wi-Fi 6 5GHz Ở Nhà (192.168.1.1 - 2402 Mbps)';
            } else if (mode === 'remote') {
                if (btnR) btnR.classList.add('active');
                drawSimpleQrCode('shareQrCanvas', currentShareRemoteUrl || currentShareGlobalUrl);
                if (hint) hint.innerText = '🚀 Đang hiển thị QR Web Từ Xa (Mở Trọn 100% Tốc Độ 5G - P2P Siêu Tốc)';
            } else {
                if (btnG) btnG.classList.add('active');
                drawSimpleQrCode('shareQrCanvas', currentShareGlobalUrl || currentShareLocalUrl);
                if (hint) hint.innerText = '🌐 Đang hiển thị QR Tải Toàn Cầu (Không cần App, mọi mạng 4G/5G)';
            }
        }

        function copyTextSafe(text, msg) {
            if (!text) return;
            try {
                if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function' && window.isSecureContext) {
                    navigator.clipboard.writeText(text).then(() => {
                        showToast(msg || '📋 Đã sao chép liên kết vào Clipboard!');
                    }).catch(() => {
                        fallbackCopyText(text, msg);
                    });
                    return;
                }
            } catch(e) {}
            fallbackCopyText(text, msg);
        }

        function fallbackCopyText(text, msg) {
            try {
                const temp = document.createElement('textarea');
                temp.value = text;
                temp.setAttribute('readonly', '');
                temp.style.position = 'fixed';
                temp.style.left = '-9999px';
                temp.style.top = '0';
                temp.style.opacity = '0';
                document.body.appendChild(temp);
                temp.focus();
                temp.select();
                if (typeof temp.setSelectionRange === 'function') {
                    temp.setSelectionRange(0, 99999);
                }
                const ok = document.execCommand('copy');
                document.body.removeChild(temp);
                if (ok) {
                    showToast(msg || '📋 Đã sao chép liên kết vào Clipboard!');
                    return;
                }
            } catch(e) {}
            window.prompt('Nhấn Ctrl+C (hoặc giữ để sao chép) liên kết:', text);
        }

        function copyInputText(inputId) {
            const el = document.getElementById(inputId);
            if (!el) return;
            const textToCopy = el.value || el.innerText || '';
            if (!textToCopy) return;

            el.focus();
            el.select();
            if (typeof el.setSelectionRange === 'function') {
                el.setSelectionRange(0, 99999);
            }
            copyTextSafe(textToCopy);
        }

        function toggleModalFullscreen(windowId) {
            const el = document.getElementById(windowId);
            if (!el) return;
            el.classList.toggle('modal-window-maximized');
        }

        function openPreview(name, type) {
            const fileUrl = `${API}?action=view&folder=${encodeURIComponent(currentFolder)}&name=${encodeURIComponent(name)}`;
            const container = document.getElementById('previewContainer');
            const title = document.getElementById('previewTitle');
            const dlBtn = document.getElementById('previewDownloadBtn');

            title.innerText = `👁️ ${name}`;
            dlBtn.href = `${API}?action=download&folder=${encodeURIComponent(currentFolder)}&name=${encodeURIComponent(name)}`;
            container.innerHTML = '<div style="color:#fff;">Đang tải...</div>';
            document.getElementById('previewModal').classList.add('open');

            if (type === 'image') {
                container.innerHTML = `<img src="${fileUrl}" alt="${escapeHtml(name)}">`;
            } else if (type === 'video') {
                container.innerHTML = `
                    <video controls autoplay playsinline>
                        <source src="${fileUrl}" type="video/mp4">
                        Trình duyệt không hỗ trợ phát video này.
                    </video>
                `;
            } else if (type === 'audio') {
                container.innerHTML = `
                    <audio controls autoplay>
                        <source src="${fileUrl}">
                        Trình duyệt không hỗ trợ phát âm thanh này.
                    </audio>
                `;
            } else if (type === 'code' || type === 'document') {
                fetch(fileUrl)
                    .then(r => r.text())
                    .then(txt => {
                        container.innerHTML = `<pre class="code-preview">${escapeHtml(txt)}</pre>`;
                    })
                    .catch(() => {
                        container.innerHTML = `<div style="padding:20px; color:#fff;">Không thể đọc định dạng văn bản này. Vui lòng bấm "Tải về" để xem trên máy.</div>`;
                    });
            } else {
                container.innerHTML = `
                    <div style="padding:30px; text-align:center; color:#fff;">
                        <div style="font-size:3rem; margin-bottom:10px;">📄</div>
                        <p>Định dạng này không hỗ trợ xem trực tiếp.</p>
                        <a class="btn-cta" style="margin-top:14px; text-decoration:none;" href="${dlBtn.href}" download>Tải Về Máy Ngay</a>
                    </div>
                `;
            }
        }

        function closePreviewModal() {
            const container = document.getElementById('previewContainer');
            container.innerHTML = '';
            closeModal('previewModal');
        }

        function closeModal(id) {
            document.getElementById(id).classList.remove('open');
        }

        async function loadStorageStats() {
            try {
                const res = await fetch(`${API}?action=stats&t=${Date.now()}`);
                const data = await res.json();
                if (data.disk_free) {
                    document.getElementById('emmcUsage').innerText = `${data.disk_free} trống`;
                }
            } catch (e) {}

            try {
                const res2 = await fetch(`${API}?action=get_nas&t=${Date.now()}`);
                const nas = await res2.json();
                if (nas.phone_status) {
                    document.getElementById('phoneStatusLabel').innerText = `${nas.phone_status} ${nas.phone_ping ? '(' + nas.phone_ping + ')' : ''}`;
                }
            } catch (e) {}
        }

        function copyHudLink(url) {
            if (!url) return;
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(url).then(() => {
                    showToast('📋 Đã sao chép liên kết: ' + url);
                }).catch(() => {
                    prompt('Sao chép liên kết truy cập:', url);
                });
            } else {
                prompt('Sao chép liên kết truy cập:', url);
            }
        }

        async function loadSysStats() {
            if (document.hidden) return;
            try {
                const res = await fetch(`${API}?action=sys_stats&t=${Date.now()}`);
                const data = await res.json();
                if (!data || data.status !== 'OK') return;
                window._lastSysStats = data;

                // Update Hardware HUD
                const cpuTitle = document.getElementById('hudCpuTitle');
                if (cpuTitle && data.cpu) {
                    cpuTitle.textContent = data.cpu.toUpperCase();
                }
                const nssB = document.getElementById('hudNssBadge');
                if (nssB) {
                    nssB.textContent = data.nss_active ? (data.hw_name ? `🚀 ${data.hw_name}: ACTIVE` : '🚀 HW Offload: ACTIVE') : '⚡ CPU Software Routing';
                }
                const ramB = document.getElementById('hudRamLoad');
                if (ramB && data.ram_pct !== undefined) {
                    ramB.textContent = `RAM: ${data.ram_pct}% (${data.ram_used}M)`;
                }
                const wifiTitle = document.getElementById('hudWifiTitle');
                if (wifiTitle && data.wifi_5g) {
                    wifiTitle.textContent = data.wifi_5g.toUpperCase();
                }
                const storTitle = document.getElementById('hudStorageTitle');
                if (storTitle && data.storage_type) {
                    storTitle.textContent = data.storage_type.toUpperCase();
                }
                const storB = document.getElementById('hudStorageBadge');
                if (storB && data.emmc_free) {
                    const healthStr = data.flash_health_pct ? ` • Độ bền: ${data.flash_health_pct}%` : '';
                    storB.textContent = `${data.emmc_free} Trống${healthStr}`;
                    if (data.flash_health_status) {
                        storB.title = `Bộ Nhớ Flash: ${data.flash_health_status} (Hao mòn: ${data.flash_wear_pct || 0}%)`;
                    }
                }

                // Update Sidebar Storage
                const rStorName = document.getElementById('routerStorageName');
                if (rStorName && data.storage_type) {
                    rStorName.textContent = `💾 ${data.storage_type}`;
                }
                const rEmmcUsage = document.getElementById('emmcUsage');
                if (rEmmcUsage && data.emmc_free) {
                    rEmmcUsage.textContent = `${data.emmc_free} trống`;
                }
                const rBar = document.querySelector('.storage-item .progress-fill-blue');
                if (rBar && data.emmc_pct !== undefined) {
                    rBar.style.width = `${data.emmc_pct}%`;
                }
                const rTotLabel = document.getElementById('storageTotalLabel');
                if (rTotLabel && data.emmc_total) {
                    rTotLabel.textContent = `${data.emmc_total} + Cụm NAS`;
                }

                // Update channel chips with real IPs
                if (data.tailscale_ip && data.tailscale_ip !== '127.0.0.1') {
                    const p2pC = document.getElementById('hudP2pChip');
                    if (p2pC) {
                        p2pC.onclick = () => copyHudLink(`http://${data.tailscale_ip}:8080/`);
                        p2pC.title = `Bấm copy link Web Từ Xa 100% 5G: http://${data.tailscale_ip}:8080/`;
                    }
                }
                if (data.funnel_url) {
                    const fC = document.getElementById('hudFunnelChip');
                    if (fC) {
                        fC.onclick = () => copyHudLink(data.funnel_url);
                        fC.title = `Bấm copy link Toàn Cầu Funnel: ${data.funnel_url}`;
                    }
                }
            } catch (e) {}
        }

