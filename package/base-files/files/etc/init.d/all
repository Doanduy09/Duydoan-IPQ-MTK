if action == "use_tailscale" then
    -- 1. Ensure Tailscale is enabled and running
    local p_check = io.popen("ps -w | grep '[t]ailscaled'")
    local running = p_check and p_check:read("*l")
    if p_check then p_check:close() end

    if not running or #running == 0 then
        os.execute("/etc/init.d/tailscale enable >/dev/null 2>&1")
        os.execute("/etc/init.d/tailscale start >/dev/null 2>&1")
        for _ = 1, 6 do
            nixio.nanosleep(0, 500000000)
            local p2 = io.popen("ps -w | grep '[t]ailscaled'")
            local r2 = p2 and p2:read("*l")
            if p2 then p2:close() end
            if r2 and #r2 > 0 then break end
        end
    end

    -- 2. Query Tailscale IP & Status
    local ts_ip = ""
    local ts_dns = ""
    for _ = 1, 6 do
        local p_ip = io.popen("tailscale ip -4 2>/dev/null")
        local tip = p_ip and p_ip:read("*l")
        if p_ip then p_ip:close() end
        if tip and tip:match("^%d+%.%d+%.%d+%.%d+$") then
            ts_ip = tip
            break
        end
        nixio.nanosleep(0, 500000000)
    end

    local p_stat = io.popen("tailscale status --json 2>/dev/null")
    if p_stat then
        local raw = p_stat:read("*a")
        p_stat:close()
        if raw and #raw > 0 then
            local self_dns = raw:match('"Self"%s*:%s*{.-"DNSName"%s*:%s*"([^"]+)"')
            if not self_dns then self_dns = raw:match('"DNSName"%s*:%s*"([^"]+)"') end
            if self_dns and #self_dns > 0 then ts_dns = self_dns:gsub("%.$", "") end
        end
    end

    if ts_ip and ts_ip ~= "" and ts_ip ~= "127.0.0.1" then
        local target_url = "http://" .. ts_ip .. ":8080"
        os.execute(string.format("uci set nas_phone.settings=settings && uci set nas_phone.settings.tailscale_url='%s' && uci commit nas_phone", target_url))
        os.execute("/usr/sbin/tailscale serve --bg --tcp 8080 127.0.0.1:8080 >/dev/null 2>&1 &")
        os.execute(string.format("ip addr add %s/32 dev lo 2>/dev/null", ts_ip))
        os.execute("[ -e /www/airdrop/airdrop ] || ln -sf /www/airdrop /www/airdrop/airdrop")

        print("Content-Type: application/json\r\n\r\n" .. string.format(
            '{"ok":true,"status":"success","tailscale_ip":"%s","tailscale_dns":"%s","public_url":"%s","message":"âœ… ÄÃ£ tá»± Ä‘á»™ng báº­t Tailscale & chuyá»ƒn sang TÃªn Miá»n Cá»‘ Äá»‹nh: %s"}',
            ts_ip, ts_dns, target_url, target_url
        ))
        return
    else
        local p_up = io.popen("tailscale up --qr=false 2>&1")
        local up_out = p_up and p_up:read("*a") or ""
        if p_up then p_up:close() end
        local auth_url = up_out:match("(https://login%.tailscale%.com/a/[%w]+)") or ""

        print("Content-Type: application/json\r\n\r\n" .. string.format(
            '{"ok":false,"status":"need_auth","auth_url":"%s","message":"âš ï¸ Tailscale Ä‘Ã£ Ä‘Æ°á»£c báº­t nhÆ°ng chÆ°a Ä‘Äƒng nháº­p tÃ i khoáº£n. Vui lÃ²ng má»Ÿ liÃªn káº¿t xÃ¡c thá»±c Router!"}',
            auth_url
        ))
        return
    end
end


