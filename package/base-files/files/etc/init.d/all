#!/usr/bin/lua
local function header()
    io.write("Content-Type: application/json\r\n")
    io.write("Cache-Control: no-store, no-cache, must-revalidate\r\n")
    io.write("Access-Control-Allow-Origin: *\r\n\r\n")
end

local function urldecode(s)
    if not s then return "" end
    s = s:gsub("+", " ")
    s = s:gsub("%%(%x%x)", function(h)
        return string.char(tonumber(h, 16))
    end)
    return s
end

local function get_query()
    local q = {}
    local qs = os.getenv("QUERY_STRING") or ""
    local rm = os.getenv("REQUEST_METHOD") or "GET"
    if rm == "POST" then
        local len = tonumber(os.getenv("CONTENT_LENGTH") or "0") or 0
        if len > 0 then
            local post_body = io.read(len) or ""
            if #qs > 0 then
                qs = qs .. "&" .. post_body
            else
                qs = post_body
            end
        end
    end
    for k, v in qs:gmatch("([^&=?]+)=([^&=?]+)") do
        q[urldecode(k)] = urldecode(v)
    end
    return q
end

header()
local q = get_query()
local mac = (q.mac or ""):lower():gsub("%s+", "")
local name = (q.name or ""):gsub("^%s+", ""):gsub("%s+$", "")

if #mac < 11 or #name == 0 then
    io.write('{"success":false,"error":"Invalid mac or name"}\n')
    return
end

local function update_file_mac_val(filepath, target_mac, new_line)
    local lines = {}
    local f = io.open(filepath, "r")
    if f then
        for line in f:lines() do
            local lmac = line:match("^([^=|]+)")
            if lmac and lmac:lower() == target_mac:lower() then
                -- skip old entry
            else
                table.insert(lines, line)
            end
        end
        f:close()
    end
    if new_line then
        table.insert(lines, new_line)
    end
    local tmp = filepath .. ".tmp." .. os.time()
    local out = io.open(tmp, "w")
    if out then
        for _, l in ipairs(lines) do
            out:write(l .. "\n")
        end
        out:close()
        os.execute(string.format("mv -f %q %q 2>/dev/null", tmp, filepath))
    end
end

os.execute("mkdir -p /etc/config")
update_file_mac_val("/etc/config/device_names.conf", mac, mac .. "=" .. name)
update_file_mac_val("/etc/config/family_members.conf", mac, mac .. "|" .. name .. "|Gia đình|user")

local clean_host = name:gsub("%s+", "-"):gsub("[^%w%-_]", "")
if #clean_host == 0 then clean_host = "Device" end

local leases_file = "/tmp/dhcp.leases"
local lf = io.open(leases_file, "r")
if lf then
    local llines = {}
    for line in lf:lines() do
        local parts = {}
        for p in line:gmatch("%S+") do table.insert(parts, p) end
        if #parts >= 4 and parts[2]:lower() == mac:lower() then
            parts[4] = clean_host
            table.insert(llines, table.concat(parts, " "))
        else
            table.insert(llines, line)
        end
    end
    lf:close()
    local out = io.open(leases_file .. ".tmp", "w")
    if out then
        for _, l in ipairs(llines) do out:write(l .. "\n") end
        out:close()
        os.execute("mv -f /tmp/dhcp.leases.tmp /tmp/dhcp.leases 2>/dev/null")
    end
end

local cmd = string.format([[
sh -c '
found_sec=""
for sec in $(uci show dhcp 2>/dev/null | grep "=host$" | cut -d"=" -f1 | cut -d"." -f2); do
    smac=$(uci -q get dhcp."$sec".mac | tr "[:upper:]" "[:lower:]")
    if [ "$smac" = "%s" ]; then
        found_sec="$sec"
        break
    fi
done
[ -z "$found_sec" ] && found_sec=$(uci add dhcp host)
uci -q set dhcp."$found_sec".mac="%s"
uci -q set dhcp."$found_sec".name="%s"
cur_rip=$(awk -v m="%s" "tolower(\$2) == m {print \$3}" /tmp/dhcp.leases 2>/dev/null | head -1)
[ -z "$cur_rip" ] && cur_rip=$(awk -v m="%s" "tolower(\$4) == m {print \$1}" /proc/net/arp 2>/dev/null | head -1)
[ -n "$cur_rip" ] && uci -q set dhcp."$found_sec".ip="$cur_rip"
uci commit dhcp >/dev/null 2>&1
/etc/init.d/dnsmasq reload >/dev/null 2>&1
sync
' >/dev/null 2>&1 &
]], mac, mac, clean_host, mac, mac)
os.execute(cmd)

local function json_escape(str)
    return (str:gsub('\\', '\\\\'):gsub('"', '\\"'):gsub('\n', '\\n'):gsub('\r', '\\r'))
end

io.write(string.format('{"success":true,"mac":"%s","name":"%s"}\n', json_escape(mac), json_escape(name)))
