                if (!retVal || isNaN(retVal) || Number(retVal) < 0) retVal = '15';

                var t = Date.now();
                Promise.all([
                    fetch('/cgi-bin/airdrop?action=cloud_cam_set_retention&days=' + encodeURIComponent(retVal) + '&_t=' + t),
