      const dayName = days[now.getDay()];
      const d = String(now.getDate()).padStart(2, '0');
      const mo = String(now.getMonth() + 1).padStart(2, '0');
      const y = now.getFullYear();
      document.getElementById('date-display').textContent = `${dayName}, ${d}/${mo}/${y}`;
    }
    setInterval(updateClock, 1000);
    updateClock();

    // 2. Telemetry Polling Engine
    let lastBytes = 0;
    let lastTime = Date.now();

    async function fetchTelemetry() {
      try {
        const res = await fetch('/cgi-bin/airdrop?action=sys_stats', { cache: 'no-store' });
        if (!res.ok) return;
        const d = await res.json();

        // RAM & CPU
        if (d.ram_pct !== undefined) {
          document.getElementById('ram-val').innerHTML = `${d.ram_pct}% <small style="font-size:13px">RAM</small>`;
        }
