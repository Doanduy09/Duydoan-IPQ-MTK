local nr_rsrq = gstatus:match("NR5G RSRQ %(dB%):%s*([%-%d]+)") or nrinfo:match("NR5G RSRQ %(dB%):%s*([%-%d]+)") or "-11"
local nr_sinr = gstatus:match("NR5G SINR %(dB%):%s*([%-%d%.]+)") or nrinfo:match("NR5G SINR %(dB%):%s*([%-%d%.]+)") or "34.5"
