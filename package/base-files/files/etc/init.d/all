            mon_mac=$(echo "$mon_mac" | tr '[:upper:]' '[:lower:]' | tr -d '\r\n ')
            [ -z "$mon_mac" ] && continue
            if ! echo "$mon_mac" | grep -qE '^([0-9a-f]{2}:){5}[0-9a-f]{2}$'; then
                continue
            fi
