                if [ -x /usr/bin/adshield ]; then
                    case "$action" in
                        on) /usr/bin/adshield on ;;
                        off) /usr/bin/adshield off ;;
                        family_on) /usr/bin/adshield family on ;;
                        family_off) /usr/bin/adshield family off ;;
                        refresh) /usr/bin/adshield reload ;;
                        update) /usr/bin/adshield update ;;
                        *) /usr/bin/adshield status ;;
                    esac
                else
                    echo '{"success":false,"message":"Chưa cài đặt adshield"}'
                fi
