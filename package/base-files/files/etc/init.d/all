                        treeHtml = masterCardHtml + connectorHtml + slaveStandbyCardHtml;
                    }

                    var peersHtml = treeHtml;
                    var timeoutNotice = '';
                    if (d.mesh_active && d.mesh_timeout_left > 0 && (!d.peer_count || d.peer_count === 0)) {
