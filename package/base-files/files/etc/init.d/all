    table.insert(neighbors, { type = "InterFreq", earfcn = earfcn, pci = pci, rsrq = rsrq, rsrp = rsrp, rssi = rssi })
end

-- Tính toán thanh mức sóng trực quan
local function render_bar(rsrp_val)
    local n = tonumber(rsrp_val) or -100
    if n >= -75 then return "[██████████] 100%"
    elseif n >= -85 then return "[████████░░] 80%"
    elseif n >= -95 then return "[██████░░░░] 60%"
    elseif n >= -105 then return "[████░░░░░░] 40%"
    else return "[██░░░░░░░░] 20%" end
end

