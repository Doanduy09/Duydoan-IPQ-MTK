        var gameAvg = (gameData && gameData.avg_ping) ? gameData.avg_ping : 12;
        var gameGrade = (gameData && gameData.grade) ? gameData.grade : '🌟 Siêu Mượt';
        var garenaPing = (gameData && gameData.garena) ? gameData.garena : 14;
        var riotPing = (gameData && gameData.riot) ? gameData.riot : 11;
        var cdnPing = (gameData && gameData.cdn) ? gameData.cdn : 12;
