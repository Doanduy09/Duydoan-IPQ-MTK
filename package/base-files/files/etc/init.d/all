        var _simActiveFullIccid = '';
        var _simActiveMaskedIccid = '';
        var _simIsMasked = true;
        var _simCountdownTimer = null;
        var _simTargetEpoch = 0;
        var _simIsWhitelisted = false;
        var _simScheduleTime = '01:53:45';
        var _simAllowedIccids = [];

        function toggleMaskIccid() {
            _simIsMasked = !_simIsMasked;
            var el = document.getElementById('sim-active-iccid-text');
            if (el) {
                el.textContent = _simIsMasked ? _simActiveMaskedIccid : _simActiveFullIccid;
            }
        }

        function updateSimLiveCountdown() {
            var elCountdown = document.getElementById('sim-countdown-badge');
            if (!elCountdown) return;

            if (!_simIsWhitelisted || _simTargetEpoch <= 0) {
                elCountdown.className = 'gh-badge gh-badge-danger';
                elCountdown.textContent = '\uD83D\uDD12 KH\u00D4NG L\u00CAN L\u1ECACH (\u0110\u00E3 kh\u00F3a ch\u1EB7t 100%)';
                return;
            }

            var now = Math.floor(Date.now() / 1000);
            var diff = _simTargetEpoch - now;
            if (diff <= 0) {
                elCountdown.className = 'gh-badge gh-badge-attention';
                elCountdown.textContent = '\u26A1 \u0110ang chu\u1EA9n b\u1ECB g\u1EEDi SMS...';
                return;
            }

            var h = Math.floor(diff / 3600);
            var m = Math.floor((diff % 3600) / 60);
            var s = diff % 60;
            elCountdown.className = 'gh-badge gh-badge-attention';
            elCountdown.textContent = '\u23F3 C\u00F2n l\u1EA1i: ' + h + 'h ' + m + 'p ' + s + 's';
        }

        function refreshSimManagerUI() {
            fetch('/cgi-bin/sim_manager?action=get_state&t=' + Date.now())
                .then(function(r) { return r.json(); })
                .then(function(d) {
                    if (!d || d.status !== 'success') return;
                    _simActiveFullIccid = d.active_iccid || '';
                    _simActiveMaskedIccid = d.masked_iccid || '';
                    _simIsWhitelisted = !!d.is_whitelisted;
                    _simScheduleTime = d.schedule_time || '01:53:45';
                    _simTargetEpoch = d.next_send_epoch || 0;
                    _simAllowedIccids = d.allowed_iccids || [];

                    // 1. Cap nhat the 1: SIM dang gan
                    var elIccid = document.getElementById('sim-active-iccid-text');
                    if (elIccid) {
                        elIccid.textContent = _simIsMasked ? _simActiveMaskedIccid : _simActiveFullIccid;
                    }

                    var elWhitelist = document.getElementById('sim-whitelist-badge');
                    var elMatchedName = document.getElementById('sim-matched-name');
                    var btnForce = document.getElementById('btn-force-test-renew');
                    var tagHeader = document.getElementById('sim-card1-status-tag');
                    var elSchedTime = document.getElementById('sim-sched-time-tag');

                    if (_simIsWhitelisted) {
                        if (elWhitelist) {
                            elWhitelist.className = 'gh-badge gh-badge-success';
                            elWhitelist.textContent = '\uD83D\uDFE2 SIM VIP M\u1EB7c \u0110\u1ECBnh (Cho ph\u00E9p l\u00EAn l\u1ECBch SMS)';
                        }
                        if (elMatchedName) {
                            elMatchedName.textContent = '(G\u00F3i 5G150N + Y g\u1EEDi 191)';
                            elMatchedName.style.color = '#1a7f37';
                        }
                        if (btnForce) {
                            btnForce.style.display = 'inline-block';
                            btnForce.disabled = false;
                            btnForce.style.opacity = '1';
                        }
                        if (tagHeader) {
                            tagHeader.innerHTML = '<span class="gh-badge gh-badge-success">\u2714\uFE0F S\u1EB5n s\u00E0ng gia h\u1EA1n</span>';
                        }
                        if (elSchedTime) {
                            elSchedTime.textContent = '\uD83D\uDD52 ' + _simScheduleTime;
                            elSchedTime.className = 'gh-mono-tag';
                        }
                    } else {
                        if (elWhitelist) {
                            elWhitelist.className = 'gh-badge gh-badge-danger';
                            elWhitelist.textContent = '\uD83D\uDD12 SIM Ngo\u00E0i Danh S\u00E1ch (\u0110\u00C3 KH\u00D3A CH\u1EB6T 100%)';
                        }
                        if (elMatchedName) {
                            elMatchedName.textContent = '(Tuy\u1EC7t \u0111\u1ED1i kh\u00F4ng l\u00EAn l\u1ECBch g\u1EEDi tin nh\u1EAFn)';
                            elMatchedName.style.color = '#cf222e';
                        }
                        if (btnForce) {
                            btnForce.style.display = 'none';
                        }
                        if (tagHeader) {
                            tagHeader.innerHTML = '<span class="gh-badge gh-badge-danger">\uD83D\uDD12 \u0110\u00E3 kh\u00F3a ch\u1EB7t SMS</span>';
                        }
                        if (elSchedTime) {
                            elSchedTime.textContent = '\uD83D\uDD12 KH\u00D4NG L\u00CAN L\u1ECACH';
                            elSchedTime.className = 'gh-badge gh-badge-danger';
                        }
                    }

                    var elSchedRow = document.getElementById('sim-sched-row-wrapper');
                    var elCard2 = document.getElementById('sim-card2-wrapper');
                    if (elSchedRow) elSchedRow.style.display = _simIsWhitelisted ? '' : 'none';
                    if (elCard2) elCard2.style.display = _simIsWhitelisted ? 'block' : 'none';

                    updateSimLiveCountdown();
                    if (!_simCountdownTimer) {
                        _simCountdownTimer = setInterval(updateSimLiveCountdown, 1000);
                    }

                    var elCb = document.getElementById('sim-circuit-breaker-tag');
                    var elCbDesc = document.getElementById('sim-circuit-breaker-desc');
                    if (elCb) {
                        if (_simIsWhitelisted) {
                            if (d.circuit_breaker_ready) {
                                elCb.className = 'gh-badge gh-badge-success';
                                elCb.textContent = '\u2714\uFE0F S\u1EB5n s\u00E0ng (T\u1ED1i \u0111a 1 SMS / 12h)';
                            } else {
                                elCb.className = 'gh-badge gh-badge-attention';
                                elCb.textContent = '\u23F3 \u0110\u00E3 g\u1EEDi h\u00F4m nay (Kh\u00F3a an to\u00E0n NVRAM)';
                            }
                            if (elCbDesc) elCbDesc.textContent = 'Ch\u1ED1ng g\u1EEDi tr\u00F9ng l\u1EB7p, b\u1EA3o to\u00E0n qua m\u1ECDi l\u1EA7n reboot';
                        } else {
                            elCb.className = 'gh-badge gh-badge-danger';
                            elCb.textContent = '\uD83D\uDEE1\uFE0F \u0110\u00E3 kh\u00F3a c\u1EE9ng c\u1ED5ng g\u1EEDi SMS';
                            if (elCbDesc) elCbDesc.textContent = 'B\u1EA3o v\u1EC7 tuy\u1EC7t \u0111\u1ED1i t\u00E0i kho\u1EA3n SIM ngo\u00E0i 100%';
                        }
                    }

                    // Cap nhat tin nhan phan hoi tu 191
                    var elRespTag = document.getElementById('sim-last-response-text');
                    if (elRespTag) {
                        if (d.last_sms_response && d.last_sms_response.length > 0) {
                            elRespTag.textContent = d.last_sms_response;
                            elRespTag.style.color = d.is_low_balance ? '#cf222e' : (d.is_renew_success ? '#1a7f37' : '#1f2328');
                        } else {
                            elRespTag.textContent = '(Ch\u01B0a c\u00F3 ph\u1EA3n h\u1ED3i m\u1EDBi t\u1EEB t\u1ED5ng \u0111\u00E0i 191)';
                            elRespTag.style.color = '#656d76';
                        }
                    }

                    // 2. Cap nhat the 2
                    renderActiveSimControlPanel();

                    // 3. Cap nhat the 3
                    renderDefaultIccidsList(_simAllowedIccids, _simActiveFullIccid);
                }).catch(function(err) {});
        }

