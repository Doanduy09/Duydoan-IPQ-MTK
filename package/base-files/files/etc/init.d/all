                    E('h4', { style: 'margin: 0; font-weight: 700; color: #1f2328; font-size: 16px;' }, 'Qu\u1EA3n L\u00FD SIM & L\u1ECBch Gia H\u1EA1n G\u00F3i C\u01B0\u1EDBc SMS'),
                    E('span', { class: 'gh-badge gh-badge-success', style: 'font-size: 11px;' }, '\u26A1 AI Hybrid Guard')
                ]),
                E('div', { style: 'display: flex; gap: 8px; flex-wrap: wrap;' }, [
                    E('button', {
