                var pPass = nasPhonePassInput.value.trim();

                ev.target.textContent = '⏳ Đang thêm...';
                callAddPhoneNode(pName, pIp, pProto, pPort, pRPort, pFolder, pUser, pPass).then(function(res) {
                    ev.target.textContent = '➕ Thêm Vào Cụm (Kiểm Tra & Lưu)';
                    ui.addNotification(null, E('p', '✅ ' + (res.message || 'Đã thêm trạm NAS!')), 'info');
                    refreshNASStatus();
                }).catch(function(err) {
                    ev.target.textContent = '➕ Thêm Vào Cụm (Kiểm Tra & Lưu)';
                    ui.addNotification(null, E('p', '❌ Lỗi: ' + (err.message || err)), 'error');
                });
            }
        }, '➕ Thêm Vào Cụm (Kiểm Tra & Lưu)');

        var nasAddCloudBtn = E('button', {
