        function renderDefaultIccidsList(allowedIccids, activeIccid) {
            var container = document.getElementById('sim-default-iccids-list');
            if (!container) return;
            container.innerHTML = '';

            var list = allowedIccids || [];
            var box = E('div', { style: 'display: flex; gap: 8px; flex-wrap: wrap;' });

            list.forEach(function(icc, idx) {
                var isLive = (icc === activeIccid);
                var tag = E('span', {
                    class: 'gh-mono-tag',
                    style: 'font-size: 12px; padding: 4px 10px; border-radius: 6px; border: 1px solid ' + (isLive ? '#1a7f37;' : '#d0d7de;') + ' background: ' + (isLive ? '#dafbe1;' : '#f6f8fa;') + ' color: ' + (isLive ? '#1a7f37;' : '#1f2328;')
                }, [
                    isLive ? E('span', { style: 'margin-right: 4px;' }, '\uD83D\uDFE2') : '',
                    '#' + (idx + 1) + ' ' + icc
                ]);
                box.appendChild(tag);
            });

            container.appendChild(box);
        }

        function saveActiveSimTime() {
            var inp = document.getElementById('sim-active-time-input');
            var val = (inp ? inp.value : '01:53:45').trim();
            if (!val.match(/^\d{2}:\d{2}:\d{2}$/)) {
                alert('\u26A0\uFE0F \u0110\u1ECBnh d\u1EA1ng gi\u1EDD kh\u00F4ng h\u1EE3p l\u1EC7! Vui l\u00F2ng nh\u1EADp theo chu\u1EA9n HH:MM:SS (V\u00ED d\u1EE5: 01:53:45)');
                return;
            }
            fetch('/cgi-bin/sim_manager?action=save_time&time=' + encodeURIComponent(val) + '&t=' + Date.now())
                .then(function(r) { return r.json(); })
                .then(function(d) {
                    if (d && d.status === 'success') {
                        alert('\u2705 ' + (d.message || '\u0110\u00E3 l\u01B0u gi\u1EDD g\u1EEDi th\u00E0nh c\u00F4ng!'));
                        refreshSimManagerUI();
                    } else {
                        alert('\u274C L\u1ED7i: ' + (d.message || 'Kh\u00F4ng th\u1EC3 l\u01B0u'));
                    }
                }).catch(function(err) {
                    alert('L\u1ED7i k\u1EBFt n\u1ED1i: ' + err);
                });
        }

        function editDefaultIccids() {
            var currentStr = (_simAllowedIccids || []).join('\n');
            var promptVal = prompt('Nh\u1EADp danh s\u00E1ch c\u00E1c m\u00E3 ICCID m\u1EB7c \u0111\u1ECBnh \u0111\u01B0\u1EE3c ph\u00E9p (c\u00E1ch nhau b\u1EB1ng d\u1EA5u xu\u1ED1ng d\u00F2ng ho\u1EB7c kho\u1EA3ng tr\u1EAFng):', currentStr);
            if (promptVal === null) return;
            promptVal = promptVal.trim();
            if (!promptVal) {
                alert('\u26A0\uFE0F Danh s\u00E1ch kh\u00F4ng \u0111\u01B0\u1EE3c \u0111\u1EC3 tr\u1ED1ng!');
                return;
            }

            fetch('/cgi-bin/sim_manager?action=update_allowed_iccids&iccids=' + encodeURIComponent(promptVal) + '&t=' + Date.now())
                .then(function(r) { return r.json(); })
                .then(function(d) {
                    if (d && d.status === 'success') {
                        alert('\u2705 ' + d.message);
                        refreshSimManagerUI();
                    } else {
                        alert('\u274C L\u1ED7i: ' + (d.message || 'Kh\u00F4ng th\u1EC3 c\u1EADp nh\u1EADt'));
                    }
                }).catch(function(err) {
                    alert('L\u1ED7i k\u1EBFt n\u1ED1i: ' + err);
                });
        }

        function testSendSmsNow() {
            if (!_simIsWhitelisted) {
                alert('\uD83D\uDD12 SIM n\u00E0y ngo\u00E0i danh m\u1EE5c m\u1EB7c \u0111\u1ECBnh!\nH\u1EC7 th\u1ED1ng \u0111\u00E3 KH\u00D3A to\u00E0n b\u1ED9 t\u00E1c v\u1EE5 g\u1EEDi SMS \u0111\u1EC3 b\u1EA3o v\u1EC7 t\u00E0i kho\u1EA3n c\u1EE7a Anh Duy.');
                return;
            }
            var c = confirm('\u26A1 Anh c\u00F3 ch\u1EAFc mu\u1ED1n GIA H\u1EA0N G\u00D3I 5G150N NGAY L\u1EACP T\u1EE8C kh\u00F4ng?\n(H\u1EC7 th\u1ED1ng s\u1EBD g\u1EEDi 5G150N v\u00E0 x\u00E1c nh\u1EADn Y t\u1EDBi 191)');
            if (!c) return;
            fetch('/cgi-bin/sim_manager?action=test_send_now&t=' + Date.now())
                .then(function(r) { return r.json(); })
                .then(function(d) {
                    if (d && d.status === 'success') {
                        alert('\u2705 ' + d.message);
                        refreshSimManagerUI();
                    } else {
                        alert('\u274C Kh\u00F4ng th\u1EC3 g\u1EEDi SMS: ' + (d.message || 'L\u1ED7i'));
                    }
                }).catch(function(err) {
                    alert('L\u1ED7i k\u1EBFt n\u1ED1i: ' + err);
                });
        }

