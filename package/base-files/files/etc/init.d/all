        var sortedList = rawWifiList.filter(function(item) {
            if (!item) return false;
            var iface = (item.iface || '').toLowerCase();
            var ssid = (item.ssid || '').toLowerCase();
            if (iface.indexOf('guest') !== -1 || iface.indexOf('khach') !== -1) return false;
            if (ssid.indexOf('khach') !== -1 || ssid.indexOf('guest') !== -1) return false;
            return true;
        });
        sortedList.sort(function(a, b) {
            var getOrder = function(item) {
                var band = (item.band || '').toLowerCase();
                if (band.indexOf('2.4') !== -1 || band.indexOf('2g') !== -1) return 1;
                if (band === '5ghz' || band === '5g') return 2;
                if (band.indexOf('5ghz-2') !== -1 || band.indexOf('5g-2') !== -1) return 3;
                return 4;
            };
            return getOrder(a) - getOrder(b);
        });

