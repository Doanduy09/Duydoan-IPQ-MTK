    chmod +x /etc/init.d/nas_tunnel
    /etc/init.d/nas_tunnel enable 2>/dev/null
    /etc/init.d/nas_tunnel start 2>/dev/null

    cat << 'ATHENA_STORAGE_EOF' > /etc/init.d/athena_storage
#!/bin/sh /etc/rc.common
# /etc/init.d/athena_storage - High Performance Storage Manager & Auto-Expander
START=95

auto_expand_emmc() {
    # Check if mmcblk0 exists (Qualcomm eMMC 128GB on RE-CS-02) and partition 27 is missing
    if [ -b /dev/mmcblk0 ] && [ ! -b /dev/mmcblk0p27 ]; then
        local total_sectors=$(cat /sys/class/block/mmcblk0/size 2>/dev/null)
        # 100,000,000 sectors * 512B ≈ 51.2 GB
        if [ "$total_sectors" -gt 100000000 ]; then
            # Create partition 27 using fdisk automatically
            printf 'n\n\n\n\nw\n' | fdisk /dev/mmcblk0 >/dev/null 2>&1
            partx -a /dev/mmcblk0 2>/dev/null || blockdev --rereadpt /dev/mmcblk0 2>/dev/null
            sleep 2
            if [ -b /dev/mmcblk0p27 ] && [ -x /usr/sbin/mkfs.ext4 ]; then
                mkfs.ext4 -F -L AthenaStorage /dev/mmcblk0p27 >/dev/null 2>&1
            fi
        fi
    fi
}

start() {
    # 0. Auto-expand on fresh flashed RE-CS-02 routers if not done yet
    auto_expand_emmc

    # 1. Check & mount 111.5 GB internal eMMC storage if present
    if [ -b /dev/mmcblk0p27 ]; then
        local fs_type=$(blkid -s TYPE -o value /dev/mmcblk0p27 2>/dev/null)
        if [ "$fs_type" != "ext4" ] && [ -x /usr/sbin/mkfs.ext4 ]; then
            mkfs.ext4 -F -L AthenaStorage /dev/mmcblk0p27 >/dev/null 2>&1
        fi
        mkdir -p /mnt/storage
        if ! grep -qs '/mnt/storage' /proc/mounts; then
            mount -t ext4 -o rw,noatime,nodiratime,commit=30,barrier=1,errors=remount-ro /dev/mmcblk0p27 /mnt/storage 2>/dev/null
        fi
        # Tối ưu I/O Scheduler sang bfq hoặc deadline cho chip nhớ eMMC
        if [ -f /sys/block/mmcblk0/queue/scheduler ]; then
            echo bfq > /sys/block/mmcblk0/queue/scheduler 2>/dev/null || echo deadline > /sys/block/mmcblk0/queue/scheduler 2>/dev/null
        fi

        # Tự động đồng bộ vào UCI fstab để mount tự động khi boot
        if ! uci -q show fstab | grep -q "/mnt/storage"; then
            local uuid=$(blkid -s UUID -o value /dev/mmcblk0p27 2>/dev/null)
            if [ -n "$uuid" ]; then
                uci -q batch <<EOF
add fstab mount
set fstab.@mount[-1].uuid='$uuid'
set fstab.@mount[-1].target='/mnt/storage'
set fstab.@mount[-1].fstype='ext4'
set fstab.@mount[-1].options='rw,noatime,nodiratime,commit=30,barrier=1'
set fstab.@mount[-1].enabled='1'
set fstab.@mount[-1].enabled_fsck='0'
commit fstab
EOF
                /etc/init.d/fstab enable >/dev/null 2>&1
            fi
        fi

        if grep -qs '/mnt/storage' /proc/mounts; then
            mkdir -p /mnt/storage/airdrop
            if [ ! -L /overlay/airdrop ]; then
                [ -d /overlay/airdrop ] && cp -a /overlay/airdrop/* /mnt/storage/airdrop/ 2>/dev/null && rm -rf /overlay/airdrop
                ln -sf /mnt/storage/airdrop /overlay/airdrop
            fi
            return 0
        fi
    fi

    # 2. Check & mount external USB storage if present
    for dev in /dev/sd[a-z][1-9]; do
        if [ -b "$dev" ]; then
            mkdir -p /mnt/usb
            if ! grep -qs '/mnt/usb' /proc/mounts; then
                mount -o noatime "$dev" /mnt/usb 2>/dev/null
            fi
            if grep -qs '/mnt/usb' /proc/mounts; then
                mkdir -p /mnt/usb/airdrop
                if [ ! -L /overlay/airdrop ]; then
                    [ -d /overlay/airdrop ] && cp -a /overlay/airdrop/* /mnt/usb/airdrop/ 2>/dev/null && rm -rf /overlay/airdrop
                    ln -sf /mnt/usb/airdrop /overlay/airdrop
                fi
                return 0
            fi
        fi
    done

    # 3. Universal Fallback: Auto-unlock large eMMC/NVMe/Disk partitions if present
    if [ -x /usr/bin/auto_unlock_storage.sh ]; then
        /usr/bin/auto_unlock_storage.sh >/dev/null 2>&1
    fi
    if grep -qs '/mnt/storage' /proc/mounts; then
        return 0
    fi

    # 4. Default fallback to overlay
    mkdir -p /overlay/airdrop
}

stop() {
    return 0
}
