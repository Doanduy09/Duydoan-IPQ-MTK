                reply="ðŸ“¶ Athena Router Status:
â±ï¸ Uptime: $up | Load: $m_load
ðŸ’¾ RAM: $mem
ðŸŒ 5G IP: ${ip:-Offline}
ðŸ“¡ RSRP: ${sig:-N/A} dBm"
                send_tg "$from_id" "$reply" "$token"
                ;;
            /reboot)
                send_tg "$from_id" "ðŸ”„ Äang khá»Ÿi Ä‘á»™ng láº¡i router theo lá»‡nh tá»« Hermes..." "$token"
                sync
                reboot &
                ;;
            /restart_wwan)
                send_tg "$from_id" "â³ Äang khá»Ÿi Ä‘á»™ng láº¡i giao diá»‡n WWAN 5G..." "$token"
