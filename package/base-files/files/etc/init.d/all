                        ev.target.textContent = '👑 ĐẶT LÀM ROUTER CHÍNH (192.168.1.1)';
                        ui.addNotification(null, E('p', data.message || '✅ Đã đặt thiết bị làm Router Phát Chính!'), 'info');
                        setTimeout(function() { refreshMeshDashboard(); }, 1500);
