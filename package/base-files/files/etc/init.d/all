    cat << 'GUEST_WIFI_EOF' > /usr/bin/guest_wifi_ctrl.sh
#!/bin/sh
# ==============================================================================
# ATHENA WI-FI 6 GUEST NETWORK CONTROLLER (5GHz HE160 VIP GUEST)
# Tạo mạng Wi-Fi khách trên Băng Tần 5GHz HE160 Cao Nhất (Qualcomm QCN9074)
# Băng thông 160MHz - Tốc độ tối đa 2400 Mbps - Cô lập mạng LAN (isolate=1)
# ==============================================================================

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export TZ=Asia/Ho_Chi_Minh

ACTION="${1:-status}"
ARG_MINS="${2:-60}"
ARG_KEY="${3:-}"
ARG_NAME="${4:-}"

GUEST_IF="guest_5g"
DEFAULT_SSID="TPT Lam 5G VIP Guest"
TIMER_FILE="/tmp/guest_wifi_exp.ts"
PID_FILE="/tmp/guest_wifi_timer.pid"

status_guest() {
    local dev=$(uci -q get wireless.${GUEST_IF}.device)
    local dis=$(uci -q get wireless.${GUEST_IF}.disabled)
    if [ -n "$dev" ] && [ "$dis" != "1" ]; then
        local exp_ts=$(cat "$TIMER_FILE" 2>/dev/null || echo 0)
        local now_ts=$(date +%s)
        local rem_secs=$((exp_ts - now_ts))
        [ "$rem_secs" -lt 0 ] && rem_secs=0
        local rem_mins=$((rem_secs / 60))
        local ssid=$(uci -q get wireless.${GUEST_IF}.ssid || echo "$DEFAULT_SSID")
        local key=$(uci -q get wireless.${GUEST_IF}.key || echo "khach5gvip")
        echo "ON|${ssid}|${key}|${rem_mins}|${rem_secs}|5GHz-HE160"
    else
        echo "OFF"
    fi
}

enable_guest() {
    local mins="${ARG_MINS:-60}"
    [ "$mins" -le 0 ] 2>/dev/null && mins=60

    local key="${ARG_KEY}"
    if [ -z "$key" ]; then
        key=$(hexdump -n 4 -e '4/4 "%08X" 1 "\n"' /dev/urandom 2>/dev/null | cut -c1-8 | tr '[:upper:]' '[:lower:]')
        [ -z "$key" ] && key="guest$(date +%M%S)"
    fi

    local ssid="$DEFAULT_SSID"
    if [ -n "$ARG_NAME" ]; then
        ssid="TPT Lam 5G - ${ARG_NAME}"
    fi

    # Ưu tiên tạo trên radio2 (Qualcomm QCN9074 - 5GHz HE160 cao nhất)
    # Nếu không có radio2 thì fallback về radio0 (5GHz HE80)
    local target_radio="radio2"
    if ! uci -q get wireless.${target_radio} >/dev/null; then
        target_radio=$(uci show wireless | grep -E '\.band=.5g.' | head -1 | cut -d'.' -f2 | cut -d'=' -f1)
        [ -z "$target_radio" ] && target_radio="radio0"
    fi

    # Cấu hình Virtual AP trên radio 5GHz cao nhất
    uci -q set wireless.${GUEST_IF}=wifi-iface
    uci -q set wireless.${GUEST_IF}.device="$target_radio"
    uci -q set wireless.${GUEST_IF}.mode='ap'
    uci -q set wireless.${GUEST_IF}.network='lan'
    uci -q set wireless.${GUEST_IF}.ssid="$ssid"
    uci -q set wireless.${GUEST_IF}.encryption='psk2'
    uci -q set wireless.${GUEST_IF}.key="$key"
    uci -q set wireless.${GUEST_IF}.isolate='1'
    uci -q set wireless.${GUEST_IF}.disabled='0'
    uci commit wireless
    wifi reload >/dev/null 2>&1

    local exp_ts=$(( $(date +%s) + (mins * 60) ))
    local exp_str=$(date -d "@${exp_ts}" '+%H:%M:%S' 2>/dev/null)
    echo "$exp_ts" > "$TIMER_FILE"
    echo "$ssid" > /tmp/guest_wifi_ssid
    echo "$key" > /tmp/guest_wifi_key
    echo "$mins" > /tmp/guest_wifi_mins

    # Dừng bộ đếm thời gian cũ nếu đang chạy
    if [ -f "$PID_FILE" ]; then
        local old_pid=$(cat "$PID_FILE" 2>/dev/null)
        [ -n "$old_pid" ] && kill -9 "$old_pid" 2>/dev/null
        rm -f "$PID_FILE" 2>/dev/null
    fi

    # Tiến trình đếm ngược tự hủy VAP ngầm
    (
        sleep $(( mins * 60 ))
        uci -q delete wireless.${GUEST_IF}
        uci commit wireless
        wifi reload >/dev/null 2>&1
        rm -f "$TIMER_FILE" "$PID_FILE" /tmp/guest_wifi_ssid /tmp/guest_wifi_key /tmp/guest_wifi_mins 2>/dev/null

        fin_msg="⏳ <b>THỜI HẠN WI-FI KHÁCH 5GHZ ĐÃ KẾT THÚC!</b>
━━━━━━━━━━━━━━━━━━━━━━━━━━━━
📶 <b>SSID:</b> <code>${ssid}</code>
⏱️ Đã hết thời lượng <b>${mins} phút</b>.
🛡️ Router đã tự động xóa hoàn toàn sóng Wi-Fi khách để bảo mật mạng và tối ưu băng thông."

        if [ -x /usr/bin/send_telegram ]; then
            /usr/bin/send_telegram "$fin_msg" >/dev/null 2>&1
        fi

        if [ -x /usr/bin/tts_speaker.sh ]; then
            /usr/bin/tts_speaker.sh "Đã hết thời hạn ${mins} phút sử dụng Wi-Fi khách 5GHz. Sóng Wi-Fi khách đã được tự động tắt và xóa bỏ an toàn để bảo mật tuyệt đối cho gia đình anh." force "NONE" "" >/dev/null 2>&1
        fi
    ) </dev/null >/dev/null 2>&1 &
    echo $! > "$PID_FILE"

    echo "OK|${ssid}|${key}|${mins}|${exp_str}|${target_radio}"
}

disable_guest() {
    # Hủy tiến trình timer
    if [ -f "$PID_FILE" ]; then
        local old_pid=$(cat "$PID_FILE" 2>/dev/null)
        [ -n "$old_pid" ] && kill -9 "$old_pid" 2>/dev/null
        rm -f "$PID_FILE" 2>/dev/null
    fi

    uci -q delete wireless.${GUEST_IF}
    uci commit wireless
    wifi reload >/dev/null 2>&1
    rm -f "$TIMER_FILE" /tmp/guest_wifi_ssid /tmp/guest_wifi_key /tmp/guest_wifi_mins 2>/dev/null
    echo "DELETED"
}

case "$ACTION" in
    on|enable)
        enable_guest
        ;;
    off|disable)
        disable_guest
        ;;
    status)
        status_guest
        ;;
    *)
        echo "Usage: $0 {on [mins] [key] [name]|off|status}"
        exit 1
        ;;
esac
GUEST_WIFI_EOF
    chmod +x /usr/bin/guest_wifi_ctrl.sh

    cat << 'FLEET_MGR_EOF' > /usr/bin/fleet_manager.sh
#!/bin/sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export TZ=Asia/Ho_Chi_Minh

ACTION="${1:-status}"
CONF_FILE="/etc/config/fleet.conf"

ASUS_IP=$(grep "^ASUS_IP=" "$CONF_FILE" 2>/dev/null | cut -d'=' -f2-)
[ -z "$ASUS_IP" ] && ASUS_IP="192.168.1.134"

if ! ping -c 1 -W 1 "$ASUS_IP" >/dev/null 2>&1; then
    found_ip=$(awk '/00:0c:43/ || /TUF-AX4200/ {print $3}' /tmp/dhcp.leases 2>/dev/null | head -1)
    [ -n "$found_ip" ] && ASUS_IP="$found_ip"
fi

get_fleet_status() {
    local jdc_uptime=$(cat /proc/uptime 2>/dev/null | awk '{print int($1/3600)"h "int(($1%3600)/60)"m"}')
    local jdc_ram=$(free 2>/dev/null | awk '/Mem:/ {print int($3/1024)"MB/"int($2/1024)"MB"}')
    local jdc_carrier=$(cat /tmp/master_carrier_name 2>/dev/null || echo "Viettel 5G")
    
    local asus_status="🔴 Ngoại tuyến (Chưa kết nối / Tắt nguồn)"
    local asus_ping="N/A"
    if ping -c 1 -W 1 "$ASUS_IP" >/dev/null 2>&1; then
        asus_status="🟢 Trực tuyến (Sẵn sàng hoạt động)"
        asus_ping="< 2ms"
    fi
    
    echo "👑 <b>Router Chính (Master):</b> JDCloud Athena RE-CS-02"
    echo "• IP: <code>192.168.1.1</code> (Qualcomm IPQ6000 + 5G Snapdragon X55)"
    echo "• Mạng 5G: <b>${jdc_carrier}</b> | RAM: ${jdc_ram} | Uptime: ${jdc_uptime}"
    echo ""
    echo "📡 <b>Router Vệ Tinh (Node 1):</b> ASUS TUF-AX4200"
    echo "• IP: <code>${ASUS_IP}</code> (MediaTek Filogic 820 Wi-Fi 6)"
    echo "• Trạng thái: ${asus_status}"
    [ "$asus_ping" != "N/A" ] && echo "• Độ trễ LAN: <code>${asus_ping}</code>"
    return 0
}

reboot_asus() {
    if ping -c 1 -W 1 "$ASUS_IP" >/dev/null 2>&1; then
        ssh -o BatchMode=yes -o ConnectTimeout=2 -o StrictHostKeyChecking=no root@"$ASUS_IP" "reboot" >/dev/null 2>&1 &
        echo "OK"
    else
        echo "OFFLINE"
    fi
}

reboot_fleet() {
    reboot_asus
    (sleep 4 && reboot) &
    echo "OK"
}

case "$ACTION" in
    status)
        get_fleet_status
        ;;
    reboot_asus)
        reboot_asus
        ;;
    reboot_fleet)
        reboot_fleet
        ;;
    *)
        echo "Usage: $0 {status|reboot_asus|reboot_fleet}"
        ;;
esac
FLEET_MGR_EOF
    chmod +x /usr/bin/fleet_manager.sh

    cat << 'AI_LEARN_EOF' > /usr/bin/ai_learner.sh
#!/bin/sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export TZ=Asia/Ho_Chi_Minh

MACRO_FILE="/etc/config/ai_custom_macros.json"
CONTEXT_FILE="/tmp/ai_last_context.json"

mkdir -p /etc/config

# Tự động bảo đảm 5 khẩu lệnh khởi tạo thông minh luôn có mặt trong kho tri thức
ensure_starter_macros() {
    [ ! -f "$MACRO_FILE" ] && echo "{}" > "$MACRO_FILE"
    lua -e '
        local json = require("luci.jsonc")
        local path = "'"$MACRO_FILE"'"
        local f = io.open(path, "r")
        local data = {}
        if f then
            data = json.parse(f:read("*a")) or {}
            f:close()
        end
        local changed = false
        if not data["di ngu"] then
            data["di ngu"] = { raw_trigger = "đi ngủ", actions = "ACTION:EXEC_LEARNED:GUEST_WIFI_OFF và LED:off", created_at = "Hệ thống" }
            changed = true
        end
        if not data["thuc day"] then
            data["thuc day"] = { raw_trigger = "thức dậy", actions = "ACTION:EXEC_LEARNED:LED:on", created_at = "Hệ thống" }
            changed = true
        end
        if not data["khach den"] then
            data["khach den"] = { raw_trigger = "khách đến", actions = "ACTION:EXEC_LEARNED:GUEST_WIFI:60", created_at = "Hệ thống" }
            changed = true
        end
        if not data["tang toc"] then
            data["tang toc"] = { raw_trigger = "tăng tốc", actions = "ACTION:EXEC_LEARNED:OPT_GAME và OPT_4K", created_at = "Hệ thống" }
            changed = true
        end
        if not data["don dep"] then
            data["don dep"] = { raw_trigger = "dọn dẹp", actions = "ACTION:EXEC_LEARNED:CLEAN_RAM và CLEAR_CHAT", created_at = "Hệ thống" }
            changed = true
        end
        if changed then
            local out = io.open(path, "w")
            if out then
                out:write(json.stringify(data, 1))
                out:close()
            end
        end
    '
}
ensure_starter_macros

[ ! -f "$CONTEXT_FILE" ] && echo "{}" > "$CONTEXT_FILE"

CMD="$1"
shift

case "$CMD" in
    learn)
        trigger="$1"
        action="$2"
        [ -z "$trigger" ] || [ -z "$action" ] && { echo "ERR:Missing trigger or action"; exit 1; }
        
        lua -e '
            local json = require("luci.jsonc")
            local function norm_txt(str)
                if not str then return "" end
                local map = {
                    ["à"]="a", ["á"]="a", ["ả"]="a", ["ã"]="a", ["ạ"]="a",
                    ["â"]="a", ["ầ"]="a", ["ấ"]="a", ["ẩ"]="a", ["ẫ"]="a", ["ậ"]="a",
                    ["ă"]="a", ["ằ"]="a", ["ắ"]="a", ["ẳ"]="a", ["ẵ"]="a", ["ặ"]="a",
                    ["è"]="e", ["é"]="e", ["ẻ"]="e", ["ẽ"]="e", ["ẹ"]="e",
                    ["ê"]="e", ["ề"]="e", ["ế"]="e", ["ể"]="e", ["ễ"]="e", ["ệ"]="e",
                    ["ì"]="i", ["í"]="i", ["ỉ"]="i", ["ĩ"]="i", ["ị"]="i",
                    ["ò"]="o", ["ó"]="o", ["ỏ"]="o", ["õ"]="o", ["ọ"]="o",
                    ["ô"]="o", ["ồ"]="o", ["ố"]="o", ["ổ"]="o", ["ỗ"]="o", ["ộ"]="o",
                    ["ơ"]="o", ["ờ"]="o", ["ớ"]="o", ["ở"]="o", ["ỡ"]="o", ["ợ"]="o",
                    ["ù"]="u", ["ú"]="u", ["ủ"]="u", ["ũ"]="u", ["ụ"]="u",
                    ["ư"]="u", ["ừ"]="u", ["ứ"]="u", ["ử"]="u", ["ữ"]="u", ["ự"]="u",
                    ["ỳ"]="y", ["ý"]="y", ["ỷ"]="y", ["ỹ"]="y", ["ỵ"]="y",
                    ["đ"]="d", ["Đ"]="d"
                }
                local s = str:lower()
                for k, v in pairs(map) do s = s:gsub(k, v) end
                return s:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
            end

            local function translate_action_nl(raw_act)
                if raw_act:find("^ACTION:") then return raw_act end
                local norm = norm_txt(raw_act)
                local sub_acts = {}

                if norm:find("tat wifi khach") or norm:find("dong wifi khach") then
                    table.insert(sub_acts, "GUEST_WIFI_OFF")
                elseif norm:find("bat wifi khach") or norm:find("mo wifi khach") then
                    local m = norm:match("(%d+)%s*phut") or norm:match("(%d+)%s*p") or "30"
                    table.insert(sub_acts, "GUEST_WIFI:" .. m)
                end

                if norm:find("tat den") or norm:find("tat led") then
                    table.insert(sub_acts, "LED:off")
                elseif norm:find("bat den") or norm:find("bat led") then
                    table.insert(sub_acts, "LED:on")
                end

                if norm:find("game") or norm:find("giam ping") then
                    table.insert(sub_acts, "OPT_GAME")
                end

                if norm:find("4k") or norm:find("vuot bop") then
                    table.insert(sub_acts, "OPT_4K")
                end

                if norm:find("tat hoc bai") then
                    table.insert(sub_acts, "STUDY:off")
                elseif norm:find("hoc bai") then
                    table.insert(sub_acts, "STUDY:on")
                end

                if norm:find("don ram") or norm:find("giai phong ram") or norm:find("xoa cache") then
                    table.insert(sub_acts, "CLEAN_RAM")
                end

                if norm:find("xoa tin") or norm:find("don chat") or norm:find("xoa chat") then
                    table.insert(sub_acts, "CLEAR_CHAT")
                end

                if norm:find("khoi dong") or norm:find("reboot") then
                    table.insert(sub_acts, "REBOOT_JDC")
                end

                if #sub_acts > 1 then
                    return "ACTION:EXEC_LEARNED:" .. table.concat(sub_acts, " và ")
                elseif #sub_acts == 1 then
                    return "ACTION:" .. sub_acts[1]
                else
                    return "ACTION:EXEC_LEARNED:" .. raw_act
                end
            end

            local raw_t = [=['"$trigger"']=]
            local raw_a = [=['"$action"']=]
            local key = norm_txt(raw_t)
            local final_act = translate_action_nl(raw_a)

            local path = "'"$MACRO_FILE"'"
            local f = io.open(path, "r")
            local data = {}
            if f then
                data = json.parse(f:read("*a")) or {}
                f:close()
            end
            data[key] = {
                raw_trigger = raw_t,
                actions = final_act,
                created_at = os.date("%H:%M %d/%m/%Y")
            }
            local out = io.open(path, "w")
            if out then
                out:write(json.stringify(data, 1))
                out:close()
            end
            print("OK:LEARNED:" .. key .. ":" .. final_act)
        '
        ;;

    lookup)
        input_text="$1"
        [ -z "$input_text" ] && exit 0

        lua -e '
            local json = require("luci.jsonc")
            local function norm_txt(str)
                if not str then return "" end
                local map = {
                    ["à"]="a", ["á"]="a", ["ả"]="a", ["ã"]="a", ["ạ"]="a",
                    ["â"]="a", ["ầ"]="a", ["ấ"]="a", ["ẩ"]="a", ["ẫ"]="a", ["ậ"]="a",
                    ["ă"]="a", ["ằ"]="a", ["ắ"]="a", ["ẳ"]="a", ["ẵ"]="a", ["ặ"]="a",
                    ["è"]="e", ["é"]="e", ["ẻ"]="e", ["ẽ"]="e", ["ẹ"]="e",
                    ["ê"]="e", ["ề"]="e", ["ế"]="e", ["ể"]="e", ["ễ"]="e", ["ệ"]="e",
                    ["ì"]="i", ["í"]="i", ["ỉ"]="i", ["ĩ"]="i", ["ị"]="i",
                    ["ò"]="o", ["ó"]="o", ["ỏ"]="o", ["õ"]="o", ["ọ"]="o",
                    ["ô"]="o", ["ồ"]="o", ["ố"]="o", ["ổ"]="o", ["ỗ"]="o", ["ộ"]="o",
                    ["ơ"]="o", ["ờ"]="o", ["ớ"]="o", ["ở"]="o", ["ỡ"]="o", ["ợ"]="o",
                    ["ù"]="u", ["ú"]="u", ["ủ"]="u", ["ũ"]="u", ["ụ"]="u",
                    ["ư"]="u", ["ừ"]="u", ["ứ"]="u", ["ử"]="u", ["ữ"]="u", ["ự"]="u",
                    ["ỳ"]="y", ["ý"]="y", ["ỷ"]="y", ["ỹ"]="y", ["ỵ"]="y",
                    ["đ"]="d", ["Đ"]="d"
                }
                local s = str:lower()
                for k, v in pairs(map) do s = s:gsub(k, v) end
                return s:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
            end

            local raw_in = [=['"$input_text"']=]
            local in_norm = norm_txt(raw_in)

            local f = io.open("'"$MACRO_FILE"'", "r")
            if not f then os.exit(0) end
            local data = json.parse(f:read("*a")) or {}
            f:close()

            for k, v in pairs(data) do
                if k == in_norm or in_norm:find(k, 1, true) then
                    print(v.actions)
                    os.exit(0)
                end
            end
        '
        ;;

    list)
        lua -e '
            local json = require("luci.jsonc")
            local f = io.open("'"$MACRO_FILE"'", "r")
            if not f then 
                print("Chưa có lệnh tự học nào.")
                os.exit(0) 
            end
            local data = json.parse(f:read("*a")) or {}
            f:close()
            local cnt = 0
            for k, v in pairs(data) do
                cnt = cnt + 1
                print(string.format("• <b>%s:</b> <code>%s</code> <i>(%s)</i>", v.raw_trigger, v.actions, v.created_at or "--"))
            end
            if cnt == 0 then
                print("Chưa có lệnh tự học nào. Anh có thể nói: <i>Học lệnh: đi ngủ là tắt đèn và tắt wifi khách</i>.")
            end
        '
        ;;

    forget)
        trigger="$1"
        [ -z "$trigger" ] && exit 1
        lua -e '
            local json = require("luci.jsonc")
            local function norm_txt(str)
                if not str then return "" end
                local map = {
                    ["à"]="a", ["á"]="a", ["ả"]="a", ["ã"]="a", ["ạ"]="a",
                    ["â"]="a", ["ầ"]="a", ["ấ"]="a", ["ẩ"]="a", ["ẫ"]="a", ["ậ"]="a",
                    ["ă"]="a", ["ằ"]="a", ["ắ"]="a", ["ẳ"]="a", ["ẵ"]="a", ["ặ"]="a",
                    ["è"]="e", ["é"]="e", ["ẻ"]="e", ["ẽ"]="e", ["ẹ"]="e",
                    ["ê"]="e", ["ề"]="e", ["ế"]="e", ["ể"]="e", ["ễ"]="e", ["ệ"]="e",
                    ["ì"]="i", ["í"]="i", ["ỉ"]="i", ["ĩ"]="i", ["ị"]="i",
                    ["ò"]="o", ["ó"]="o", ["ỏ"]="o", ["õ"]="o", ["ọ"]="o",
                    ["ô"]="o", ["ồ"]="o", ["ố"]="o", ["ổ"]="o", ["ỗ"]="o", ["ộ"]="o",
                    ["ơ"]="o", ["ờ"]="o", ["ớ"]="o", ["ở"]="o", ["ỡ"]="o", ["ợ"]="o",
                    ["ù"]="u", ["ú"]="u", ["ủ"]="u", ["ũ"]="u", ["ụ"]="u",
                    ["ư"]="u", ["ừ"]="u", ["ứ"]="u", ["ử"]="u", ["ữ"]="u", ["ự"]="u",
                    ["ỳ"]="y", ["ý"]="y", ["ỷ"]="y", ["ỹ"]="y", ["ỵ"]="y",
                    ["đ"]="d", ["Đ"]="d"
                }
                local s = str:lower()
                for k, v in pairs(map) do s = s:gsub(k, v) end
                return s:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
            end
            local raw_t = [=['"$trigger"']=]
            local key = norm_txt(raw_t)

            local path = "'"$MACRO_FILE"'"
            local f = io.open(path, "r")
            if not f then os.exit(0) end
            local data = json.parse(f:read("*a")) or {}
            f:close()
            data[key] = nil
            local out = io.open(path, "w")
            if out then
                out:write(json.stringify(data, 1))
                out:close()
            end
            print("OK:FORGOTTEN:" .. key)
        '
        ;;

    set_context)
        key="$1"
        val="$2"
        [ -z "$key" ] || [ -z "$val" ] && exit 1
        lua -e '
            local json = require("luci.jsonc")
            local path = "'"$CONTEXT_FILE"'"
            local f = io.open(path, "r")
            local data = {}
            if f then
                data = json.parse(f:read("*a")) or {}
                f:close()
            end
            data["'"$key"'"] = [=['"$val"']=]
            data["updated_at"] = os.time()
            local out = io.open(path, "w")
            if out then
                out:write(json.stringify(data))
                out:close()
            end
        '
        ;;

    get_context)
        key="$1"
        [ -z "$key" ] && exit 1
        lua -e '
            local json = require("luci.jsonc")
            local f = io.open("'"$CONTEXT_FILE"'", "r")
            if not f then os.exit(0) end
            local data = json.parse(f:read("*a")) or {}
            f:close()
            if data["'"$key"'"] then
                print(data["'"$key"'"])
            end
        '
        ;;

    *)
        echo "Usage: $0 {learn <trigger> <action>|lookup <text>|list|forget <trigger>|set_context <k> <v>|get_context <k>}"
        exit 1
        ;;
esac

AI_LEARN_EOF
    chmod +x /usr/bin/ai_learner.sh

    cat << 'TTS_SPEAKER_EOF' > /usr/bin/tts_speaker.sh
#!/bin/sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export TZ=Asia/Ho_Chi_Minh

RAW_TEXT="$1"
MODE="$2"
TARGET_MID="$3"
CUSTOM_MARKUP="$4"
REQ_SEQ="$5"

[ -z "$RAW_TEXT" ] && exit 0

# Kiểm tra xem có bật chế độ giọng nói hay không (mặc định là 1: BẬT)
VOICE_SETTING=$(cat /etc/config/tg_bot_voice_enabled 2>/dev/null || echo "1")
if [ "$VOICE_SETTING" = "0" ] && [ "$MODE" != "force" ] && [ "$MODE" != "voice_card" ] && [ "$MODE" != "cache" ]; then
    exit 0
fi

# Chống tắc nghẽn & tiền xử lý ưu tiên (Preemptive Task Cancellation)
old_pid=$(cat /tmp/tts_active.pid 2>/dev/null)
if [ -n "$old_pid" ] && [ "$old_pid" != "$$" ] && kill -0 "$old_pid" 2>/dev/null; then
    kill -9 "$old_pid" 2>/dev/null
fi
echo "$$" > /tmp/tts_active.pid

trap 'rm -f /tmp/tts_part_${$}*.mp3 /tmp/tts_voice_$$.mp3 /tmp/tts_cfg_$$.txt /tmp/tg_vcap_$$.txt /tmp/tg_vmk_$$.json /tmp/tts_speech_$$.txt 2>/dev/null' EXIT INT TERM

DEFAULT_TOKEN=""
ADMIN_CHAT_ID=""
BOT_TOKEN=""

if [ -n "$CCTV_BOT_TOKEN" ] && [ -n "$CCTV_CHAT_ID" ]; then
    BOT_TOKEN="$CCTV_BOT_TOKEN"
    ADMIN_CHAT_ID="$CCTV_CHAT_ID"
elif [ -f /etc/config/telegram_bot.conf ]; then
    . /etc/config/telegram_bot.conf 2>/dev/null
    [ -n "$TG_BOT_TOKEN" ] && BOT_TOKEN="$TG_BOT_TOKEN"
    [ -n "$TG_ADMIN_ID" ] && ADMIN_CHAT_ID="$TG_ADMIN_ID"
fi

[ -z "$BOT_TOKEN" ] || [ -z "$ADMIN_CHAT_ID" ] && exit 0

API_URL="https://api.telegram.org/bot${BOT_TOKEN}"

check_rate_limit() {
    local ban_file="/tmp/tg_rate_limit_until.ts"
    if [ -f "$ban_file" ]; then
        local ban_until=$(cat "$ban_file" 2>/dev/null)
        local now=$(date +%s)
        if [ -n "$ban_until" ] && [ "$now" -lt "$ban_until" ]; then
            return 1
        fi
    fi
    return 0
}

record_rate_limit() {
    local resp="$1"
    if echo "$resp" | grep -q '"error_code":429'; then
        local retry_after=$(echo "$resp" | jsonfilter -e '$.parameters.retry_after' 2>/dev/null)
        [ -z "$retry_after" ] && retry_after=60
        local now=$(date +%s)
        local ban_until=$(( now + retry_after + 2 ))
        echo "$ban_until" > /tmp/tg_rate_limit_until.ts
    fi
}

if ! check_rate_limit; then
    exit 0
fi

if [ "$TARGET_MID" = "NONE" ] || [ "$TARGET_MID" = "keep" ]; then
    TARGET_MID=""
elif [ -z "$TARGET_MID" ]; then
    TARGET_MID=$(cat /tmp/tg_last_bot_mid.txt 2>/dev/null)
fi

TMP_AUDIO="/tmp/tts_voice_$$.mp3"
rm -f /tmp/tts_part_${$}*.mp3 "$TMP_AUDIO" 2>/dev/null

# THƯ MỤC BỘ NHỚ ĐỆM TRÊN RAM (RAM tmpfs Cache):
CACHE_DIR="/tmp/tts_cache"
mkdir -p "$CACHE_DIR" 2>/dev/null

# 1. Bộ lọc UTF-8 chuẩn xác, tóm tắt giọng đọc thông minh và tách đoạn tự nhiên
lua - "$RAW_TEXT" "$$" << 'LUAENC' 2>/dev/null
local raw, pid = arg[1] or "", arg[2] or "0"

-- Trích xuất tóm tắt phát âm thông minh (Speech Digest)
-- Nén file MP3 xuống ~40KB (thay vì 549KB) để tải và gửi cực nhanh qua mạng 5G
local function extract_speech_digest(text)
    local upper = text:upper()
    local clean = text:gsub("<[^>]+>", " "):gsub("[%c\r\n]+", " ")

    if upper:find("BÁO CÁO TRẠNG THÁI ROUTER") or upper:find("TRẠNG THÁI ROUTER") then
        local sig = clean:match("Tín hiệu sóng:%s*([^\n\r]+)") or ""
        local devs = clean:match("(%d+)%s*thiết bị") or ""
        local temp = clean:match("CPU:%s*([%d%.]+)") or ""
        local parts = {"Báo cáo Router"}
        if #sig > 0 then table.insert(parts, "sóng " .. sig:gsub("•.*", "")) end
        if #devs > 0 then table.insert(parts, devs .. " thiết bị đang kết nối") end
        if #temp > 0 then table.insert(parts, "nhiệt độ " .. temp .. " độ C") end
        table.insert(parts, "hệ thống hoạt động rất ổn định")
        return table.concat(parts, ", ")
    elseif upper:find("KẾT QUẢ ĐO TỐC ĐỘ") or upper:find("SPEEDTEST") then
        local dl = clean:match("Download:%s*([%d%.]+%s*%a+)") or clean:match("Tải xuống:%s*([%d%.]+%s*%a+)") or ""
        local ul = clean:match("Upload:%s*([%d%.]+%s*%a+)") or clean:match("Tải lên:%s*([%d%.]+%s*%a+)") or ""
        local ping = clean:match("Ping:%s*([%d%.]+%s*%a+)") or clean:match("Độ trễ:%s*([%d%.]+%s*%a+)") or ""
        local parts = {"Kết quả đo tốc độ"}
        if #dl > 0 then table.insert(parts, "tải xuống " .. dl) end
        if #ul > 0 then table.insert(parts, "tải lên " .. ul) end
        if #ping > 0 then table.insert(parts, "độ trễ " .. ping) end
        return table.concat(parts, ", ")
    elseif upper:find("DANH SÁCH THIẾT BỊ") or upper:find("THIẾT BỊ ONLINE") then
        local devs = clean:match("(%d+)%s*thiết bị") or ""
        if #devs > 0 then
            return "Báo cáo mạng, hiện có " .. devs .. " thiết bị đang kết nối Wi-Fi"
        end
    elseif upper:find("RADAR") or upper:find("KHÓA TRẠM") then
        local band = clean:match("Băng tần:%s*([^\n\r]+)") or ""
        local pci = clean:match("PCI:%s*([%d]+)") or ""
        local parts = {"Báo cáo radar sóng 5G"}
        if #band > 0 then table.insert(parts, "băng tần " .. band) end
        if #pci > 0 then table.insert(parts, "trạm " .. pci) end
        return table.concat(parts, ", ")
    end

    if #text > 300 then
        local stripped = clean:gsub("%s+", " ")
        local short = stripped:sub(1, 260):match("(.*[%.!%?])") or stripped:sub(1, 220):match("(.*%s)") or stripped:sub(1, 220)
        return short
    end

    return text
end

local digest_text = extract_speech_digest(raw)
digest_text = digest_text:gsub("<[^>]+>", " ")
digest_text = digest_text:gsub("https?://%S+", " ")
digest_text = digest_text:gsub("%x%x:%x%x:%x%x:%x%x:%x%x:%x%x", " ")
digest_text = digest_text:gsub("192%.168%.1%.1/airdrop", " một chín hai chấm một sáu tám chấm một chấm một gạch chéo airdrop ")
digest_text = digest_text:gsub("(%d+)%s*/%s*([%a%d_]+)", "%1 gạch chéo %2")
digest_text = digest_text:gsub("192%.168%.%d+%.%d+", " ")

-- 1. Lọc UTF-8 bảo tồn 100% tiếng Việt, loại bỏ toàn bộ emoji và ký tự rác
local function clean_utf8_keep_vietnamese(s)
    local out = {}
    local i = 1
    local len = #s
    while i <= len do
        local b1 = s:byte(i)
        if b1 < 128 then
            if (b1 >= 48 and b1 <= 57) or (b1 >= 65 and b1 <= 90) or (b1 >= 97 and b1 <= 122) 
               or b1 == 44 or b1 == 46 or b1 == 33 or b1 == 63 or b1 == 58 or b1 == 40 or b1 == 41 
               or b1 == 47 or b1 == 45 or b1 == 32 or b1 == 10 or b1 == 37 or b1 == 38 then
                table.insert(out, string.char(b1))
            else
                table.insert(out, " ")
            end
            i = i + 1
        elseif b1 >= 192 and b1 <= 223 then
            if i + 1 <= len then
                local b2 = s:byte(i+1)
                if (b1 >= 194 and b1 <= 198) and (b2 >= 128 and b2 <= 191) then
                    table.insert(out, s:sub(i, i+1))
                else
                    table.insert(out, " ")
                end
                i = i + 2
            else
                i = i + 1
            end
        elseif b1 >= 224 and b1 <= 239 then
            if i + 2 <= len then
                local b2 = s:byte(i+1)
                local b3 = s:byte(i+2)
                if b1 == 225 and (b2 >= 186 and b2 <= 191) and (b3 >= 128 and b3 <= 191) then
                    table.insert(out, s:sub(i, i+2))
                else
                    table.insert(out, " ")
                end
                i = i + 3
            else
                i = i + 1
            end
        elseif b1 >= 240 and b1 <= 247 then
            table.insert(out, " ")
            i = i + 4
        else
            i = i + 1
        end
    end
    return table.concat(out)
end

-- 2. Bộ Việt hóa phát âm toàn diện (Chuẩn hóa từ viết tắt, tiếng Anh, kỹ thuật, bóng đá và số liệu)
local function normalize_phonetics(s)
    if not s then return "" end

    -- Bóng đá & thể thao tiếng Anh
    s = s:gsub("%f[%a][Vv][Ss]%f[%A]", " gặp ")
    s = s:gsub("%f[%a]Premier%s+League%f[%A]", " Ngoại Hạng Anh ")
    s = s:gsub("%f[%a]Manchester%s+United%f[%A]", " Man chét tơ Diu nai tịt ")
    s = s:gsub("%f[%a]Man%s+United%f[%A]", " Man Diu ")
    s = s:gsub("%f[%a]Chelsea%f[%A]", " Chen xi ")
    s = s:gsub("%f[%a]Arsenal%f[%A]", " Át xơ nôn ")
    s = s:gsub("%f[%a]Everton%f[%A]", " É vơ tơn ")
    s = s:gsub("%f[%a]Liverpool%f[%A]", " Li vơ pun ")
    s = s:gsub("%f[%a]Manchester%s+City%f[%A]", " Man Xi ti ")
    s = s:gsub("%f[%a]Man%s+City%f[%A]", " Man Xi ti ")
    s = s:gsub("%f[%a]Tottenham%f[%A]", " Tót ten ham ")
    s = s:gsub("%f[%a]Real%s+Madrid%f[%A]", " Rê an Ma đrít ")
    s = s:gsub("%f[%a]Barcelona%f[%A]", " Bác xa ")
    s = s:gsub("%f[%a]Super%s+Sunday%f[%A]", " Chủ Nhật Siêu Hấp Dẫn ")
    s = s:gsub("%f[%a]Goodison%s+Park%f[%A]", " Gu đi xơn Pác ")
    s = s:gsub("%f[%a]Emirates%f[%A]", " Ê mi rết ")
    s = s:gsub("%f[%a]Derby%f[%A]", " Đác bi ")
    s = s:gsub("%f[%a]derby%f[%A]", " đác bi ")
    s = s:gsub("%f[%a]FPT%s+Play%f[%A]", " Ép Phê Tê Play ")

    -- Thuật ngữ mạng & phần cứng
    s = s:gsub("%f[%a]SPEEDTEST%f[%A]", " ")
    s = s:gsub("%f[%a]Speedtest%f[%A]", " ")
    s = s:gsub("%f[%a]speedtest%f[%A]", " ")
    s = s:gsub("%f[%a]Download%f[%A]", " tải xuống ")
    s = s:gsub("%f[%a]Upload%f[%A]", " tải lên ")
    s = s:gsub("[Đđ]ộ%s+trễ%s+[Pp]ing", " độ trễ pin ")
    s = s:gsub("%f[%a]Ping%f[%A]", " độ trễ pin ")
    s = s:gsub("%f[%a]ping%f[%A]", " độ trễ pin ")
    s = s:gsub("%f[%a]CPU%f[%A]", " xi pi u ")
    s = s:gsub("%f[%a]RAM%f[%A]", " ram ")
    s = s:gsub("%f[%a]Wi%-Fi%f[%A]", " wai fai ")
    s = s:gsub("%f[%a]Wifi%f[%A]", " wai fai ")
    s = s:gsub("%f[%a]wifi%f[%A]", " wai fai ")
    s = s:gsub("%f[%a]Modem%f[%A]", " mô đem ")
    s = s:gsub("%f[%a]modem%f[%A]", " mô đem ")
    s = s:gsub("%f[%a]Router%f[%A]", " rao tơ ")
    s = s:gsub("%f[%a]router%f[%A]", " rao tơ ")
    s = s:gsub("%f[%a]Network%f[%A]", " mạng ")
    s = s:gsub("%f[%a]Ho%s+Chi%s+Minh%f[%A]", " Hồ Chí Minh ")
    s = s:gsub("%f[%a]TCP%f[%A]", " tê xê phê ")
    s = s:gsub("%f[%a]UDP%f[%A]", " u đê phê ")
    s = s:gsub("%f[%a]IP%f[%A]", " ai pi ")

    -- Tên gói cước & SIM chính chủ
    s = s:gsub("12T5G125", " mười hai tê năm gờ một hai lăm ")
    s = s:gsub("5G150N", " năm gờ một năm không nờ ")
    s = s:gsub("PCRF", " ")
    s = s:gsub("ICCID", " ai xi xi đi ")
    s = s:gsub("Viettel", " Viết ten ")
    s = s:gsub("VinaPhone", " Vi na phôn ")
    s = s:gsub("MobiFone", " Mô bi phôn ")

    -- Phần cứng viễn thông & router
    s = s:gsub("Qualcomm", " Coan com ")
    s = s:gsub("IPQ6018", " I P Q sáu không một tám ")
    s = s:gsub("Sierra", " Xi e ra ")
    s = s:gsub("EM9190", " E M chín một chín không ")
    s = s:gsub("JDCloud", " Gây Đi Clao ")
    s = s:gsub("Athena", " A the na ")
    s = s:gsub("ASUS", " A xút ")
    s = s:gsub("Tailscale", " Têu skeo ")
    s = s:gsub("LuCI", " Lu xi ")
    s = s:gsub("AirDrop", " e đờ rốp ")
    s = s:gsub("airdrop", " e đờ rốp ")
    s = s:gsub("Airdrop", " e đờ rốp ")
    s = s:gsub("NSS", " N S S ")
    s = s:gsub("Tri%-Band", " ba băng tần ")
    s = s:gsub("Dual%-Band", " hai băng tần ")

    -- Băng tần sóng & Đơn vị kỹ thuật
    s = s:gsub("5G%s+NR", " năm gờ ")
    s = s:gsub("%f[%a]5G%f[%A]", " năm gờ ")
    s = s:gsub("%f[%a]4G%f[%A]", " bốn gờ ")
    s = s:gsub("%f[%a]3G%f[%A]", " ba gờ ")
    s = s:gsub("n41", " nờ 41 ")
    s = s:gsub("n78", " nờ 78 ")
    s = s:gsub("n77", " nờ 77 ")
    s = s:gsub("B3%f[%A]", " băng ba ")
    s = s:gsub("B1%f[%A]", " băng một ")
    s = s:gsub("B7%f[%A]", " băng bảy ")
    s = s:gsub("B8%f[%A]", " băng tám ")
    s = s:gsub("B28%f[%A]", " băng hai tám ")
    s = s:gsub("RSRP", " R S R P ")
    s = s:gsub("SINR", " S I N R ")
    s = s:gsub("RSRQ", " R S R Q ")
    s = s:gsub("MHz", " Mê ga héc ")
    s = s:gsub("GHz", " Ghi ga héc ")
    s = s:gsub("Mbps", " Mê ga bít trên giây ")
    s = s:gsub("MB/s", " Mê ga bai trên giây ")
    s = s:gsub("KB/s", " Ki lô bai trên giây ")
    s = s:gsub("Gbps", " Gi ga bít trên giây ")
    s = s:gsub("GB", " Gi ga bai ")
    s = s:gsub("MB", " Mê ga bai ")
    s = s:gsub("%-([0-9]+)%s*dBm", " âm %1 đề xi ben ")
    s = s:gsub("([0-9]+)%s*dBm%f[%A]", "%1 đề xi ben ")
    s = s:gsub("8K", " 8 ca ")
    s = s:gsub("4K", " 4 ca ")
    s = s:gsub("0%s+Trễ", " không trễ ")
    s = s:gsub("&", " và ")
    s = s:gsub("%(?%s*100/100%s*%)?", " tối đa một trăm điểm ")

    -- Xử lý số thập phân (.0 bỏ, .x đọc là phẩy)
    s = s:gsub("(%d+)%.0+%s*°C", " %1 độ C ")
    s = s:gsub("(%d+)%.(%d+)%s*°C", " %1 phẩy %2 độ C ")
    s = s:gsub("(%d+)%s*°C", " %1 độ C ")

    s = s:gsub("(%d+)%.0+%s*ms%f[%A]", " %1 mi li giây ")
    s = s:gsub("(%d+)%.(%d+)%s*ms%f[%A]", " %1 phẩy %2 mi li giây ")
    s = s:gsub("(%d+)%s*ms%f[%A]", " %1 mi li giây ")

    s = s:gsub("(%d+)%.0+%s*", "%1 ")
    s = s:gsub("(%d+)%.(%d+)", "%1 phẩy %2")

    -- Chuẩn hóa thời gian giờ phút đọc tự nhiên cho tiếng Việt (20:00 -> 20 giờ, 22:30 -> 22 giờ 30 phút)
    s = s:gsub("(%d+):00%s*[sS][aA]%f[%A]", " %1 giờ sáng ")
    s = s:gsub("(%d+):00%s*[cC][hH]%f[%A]", " %1 giờ chiều ")
    s = s:gsub("(%d+):(%d+)%s*[sS][aA]%f[%A]", " %1 giờ %2 phút sáng ")
    s = s:gsub("(%d+):(%d+)%s*[cC][hH]%f[%A]", " %1 giờ %2 phút chiều ")
    s = s:gsub("(%d+):00", " %1 giờ ")
    s = s:gsub("(%d+)[hH]00", " %1 giờ ")
    s = s:gsub("(%d+)[hH]%f[%A]", " %1 giờ ")
    s = s:gsub("(%d+):(%d+)", " %1 giờ %2 phút ")
    s = s:gsub("(%d+)[hH](%d+)", " %1 giờ %2 phút ")

    -- Chuẩn hóa dấu câu cho ngữ điệu đọc tự nhiên
    s = s:gsub("%s*[:;]%s*", ", ")
    s = s:gsub("%s*-%s*", ", ")
    s = s:gsub("%s*%(%s*", ", ")
    s = s:gsub("%s*%)%s*", ", ")
    s = s:gsub("[%c\r\n]+", " ")
    s = s:gsub("%,%s*%,+", ", ")
    s = s:gsub("%s+", " ")
    s = s:gsub("^%s+", ""):gsub("%s+$", "")

    return s
end

local cleaned = clean_utf8_keep_vietnamese(digest_text)
local speech = normalize_phonetics(cleaned)

-- Ghi câu phát âm đã chuẩn hóa ra file tạm để tính hash MD5 siêu tốc trong RAM
local sp_f = io.open("/tmp/tts_speech_" .. pid .. ".txt", "w")
if sp_f then
    sp_f:write(speech)
    sp_f:close()
end

local words = {}
for w in speech:gmatch("%S+") do
    table.insert(words, w)
end

local chunks = {}
local curr = ""
for _, w in ipairs(words) do
    if #curr == 0 then
        curr = w
    elseif #curr + 1 + #w <= 200 then
        curr = curr .. " " .. w
    else
        table.insert(chunks, curr)
        curr = w
        if #chunks >= 2 then break end
    end
end
if #curr > 0 and #chunks < 2 then
    table.insert(chunks, curr)
end

-- Tạo file cấu hình curl --parallel tải đồng thời trên RAM
local cfg_f = io.open("/tmp/tts_cfg_" .. pid .. ".txt", "w")
if cfg_f then
    for i, c in ipairs(chunks) do
        local enc = (c:gsub("([^%w_.~-])", function(b) return string.format("%%%02X", string.byte(b)) end))
        cfg_f:write('url = "https://translate.google.com/translate_tts?ie=UTF-8&tl=vi&client=tw-ob&q=' .. enc .. '"\n')
        cfg_f:write('output = "/tmp/tts_part_' .. pid .. '_' .. i .. '.mp3"\n')
    end
    cfg_f:close()
end
LUAENC

# 2. KIỂM TRA BỘ NHỚ ĐỆM RAM (RAM CACHE HIT < 0.001s):
SPEECH_HASH=$(md5sum "/tmp/tts_speech_$$.txt" 2>/dev/null | awk '{print $1}')
[ -z "$SPEECH_HASH" ] && SPEECH_HASH=$(echo -n "$RAW_TEXT" | md5sum | awk '{print $1}')
CACHED_FILE="${CACHE_DIR}/${SPEECH_HASH}.mp3"

CACHE_HIT=0
if [ -s "$CACHED_FILE" ]; then
    cp "$CACHED_FILE" "$TMP_AUDIO" 2>/dev/null
    CACHE_HIT=1
fi

# 3. TẢI ĐA LUỒNG HTTP/2 QUA RAM NẾU CHƯA CÓ CACHE (~0.6s - 0.8s):
if [ "$CACHE_HIT" -eq 0 ]; then
    if [ -s "/tmp/tts_cfg_$$.txt" ]; then
        curl -s -m 5 -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64)" --parallel --config "/tmp/tts_cfg_$$.txt" 2>/dev/null
        cat /tmp/tts_part_${$}_*.mp3 > "$TMP_AUDIO" 2>/dev/null
        rm -f /tmp/tts_part_${$}_*.mp3 2>/dev/null
    fi

    # Lưu vào RAM cache cho các lần truy vấn tiếp theo
    if [ -s "$TMP_AUDIO" ]; then
        cp "$TMP_AUDIO" "$CACHED_FILE" 2>/dev/null
        # Tự động dọn dẹp cache nếu vượt quá 15MB RAM
        cache_kb=$(du -s "$CACHE_DIR" 2>/dev/null | awk '{print $1}')
        if [ -n "$cache_kb" ] && [ "$cache_kb" -gt 15360 ]; then
            find "$CACHE_DIR" -type f -mmin +60 -delete 2>/dev/null
        fi
    fi
fi

# NẾU LÀ CHẾ ĐỘ CACHE (TẠO TRƯỚC TRONG NỀN):
if [ "$MODE" = "cache" ]; then
    if [ -s "$TMP_AUDIO" ]; then
        cp "$TMP_AUDIO" /tmp/tg_cached_voice.mp3 2>/dev/null
        echo "$RAW_TEXT" > /tmp/tg_cached_text.txt
    fi
    rm -f "$TMP_AUDIO" 2>/dev/null
    exit 0
fi

# KIỂM TRA MÃ PHIÊN LÀM VIỆC (PREEMPTION CHECK):
if [ -n "$REQ_SEQ" ]; then
    active_seq=$(cat /tmp/tg_voice_active_seq.txt 2>/dev/null)
    if [ -n "$active_seq" ] && [ "$active_seq" != "$REQ_SEQ" ]; then
        rm -f "$TMP_AUDIO" 2>/dev/null
        exit 0
    fi
fi

# GỬI TIN NHẮN TÍCH HỢP VOICE CARD VÀO TELEGRAM:
if [ -s "$TMP_AUDIO" ]; then
    # Lưu vào bộ nhớ đệm cho các lần truy vấn tiếp theo
    cp "$TMP_AUDIO" /tmp/tg_cached_voice.mp3 2>/dev/null
    echo "$RAW_TEXT" > /tmp/tg_cached_text.txt

    # 1. Chuẩn bị bàn phím: Loại bỏ hoàn toàn nút [🔊 Đọc Giọng Nói] vì loa nói đã tích hợp trực tiếp trên đầu tin nhắn
    NEW_MARKUP=""
    MARKUP_SOURCE=""
    [ -n "$CUSTOM_MARKUP" ] && MARKUP_SOURCE="$CUSTOM_MARKUP"
    [ -z "$MARKUP_SOURCE" ] && [ -f /tmp/tg_last_ai_markup.json ] && MARKUP_SOURCE=$(cat /tmp/tg_last_ai_markup.json 2>/dev/null)

    if [ -n "$MARKUP_SOURCE" ]; then
        NEW_MARKUP=$(lua - "$MARKUP_SOURCE" << 'LUAMK' 2>/dev/null
local content = arg[1] or ""
if #content == 0 then return end
local json = require("luci.jsonc")
local data = json.parse(content)
if data and data.inline_keyboard then
    local new_rows = {}
    for _, row in ipairs(data.inline_keyboard) do
        local new_row = {}
        for _, btn in ipairs(row) do
            if btn.callback_data ~= "cmd:read_last" then
                table.insert(new_row, btn)
            end
        end
        if #new_row > 0 then
            table.insert(new_rows, new_row)
        end
    end
    print(json.stringify({ inline_keyboard = new_rows }))
end
LUAMK
)
    fi

    # 2. Xử lý caption cho Voice Note: Giới hạn tối đa 1000 ký tự an toàn theo quy định của Telegram & tự đóng thẻ HTML
    CAPTION_SAFE=$(lua - "$RAW_TEXT" << 'LUACAP' 2>/dev/null
local s = arg[1] or ""
local function utf8_len(str)
    local _, count = str:gsub("[%z\1-\127\194-\244][\128-\191]*", "")
    return count
end

local function utf8_sub_chars(str, max_chars)
    local count = 0
    local last_pos = 0
    for pos, c in str:gmatch("()([%z\1-\127\194-\244][\128-\191]*)") do
        count = count + 1
        if count > max_chars then break end
        last_pos = pos + #c - 1
    end
    return str:sub(1, last_pos)
end

if utf8_len(s) <= 1024 then
    io.write(s)
else
    local sub = utf8_sub_chars(s, 950)
    sub = sub:match("(.*)%s") or sub
    sub = sub:gsub("<[^>]*$", "")
    local stack = {}
    for is_close, tag in sub:gmatch("<(/?)([a-zA-Z0-9]+)[^>]*>") do
        tag = tag:lower()
        if is_close == "/" then
            if #stack > 0 and stack[#stack] == tag then table.remove(stack) end
        else
            table.insert(stack, tag)
        end
    end
    local closing = ""
    for i = #stack, 1, -1 do closing = closing .. "</" .. stack[i] .. ">" end
    io.write(sub .. "\n... [Xem tiếp trong Web LuCI]" .. closing)
end
LUACAP
)
    [ -z "$CAPTION_SAFE" ] && CAPTION_SAFE="$RAW_TEXT"

    # 3. Ghi caption đầy đủ vào file để gửi kèm thanh sóng âm
    echo "$CAPTION_SAFE" > "/tmp/tg_vcap_$$.txt"
    [ -n "$NEW_MARKUP" ] && echo "$NEW_MARKUP" > "/tmp/tg_vmk_$$.json"

    # 4. Gửi Audio Track Mini Sang Trọng (sendAudio) tích hợp TRỰC TIẾP toàn bộ thông tin làm Caption
    # Không còn dải sóng âm răng cưa thô ráp! Thay vào đó là thanh timeline siêu mỏng tinh tế!
    AUDIO_TITLE="Báo Cáo Router 5G"
    AUDIO_PERFORMER="Trợ Lý AI Router"
    if echo "$RAW_TEXT" | grep -qi "TỐC ĐỘ"; then
        AUDIO_TITLE="Kết Quả Đo Tốc Độ 5G"
    elif echo "$RAW_TEXT" | grep -qi "DATA"; then
        AUDIO_TITLE="Báo Cáo Dung Lượng SIM"
    elif echo "$RAW_TEXT" | grep -qi "RADAR\|TRẠM"; then
        AUDIO_TITLE="Radar Sóng & Khóa Trạm 5G"
    elif echo "$RAW_TEXT" | grep -qi "THIẾT BỊ"; then
        AUDIO_TITLE="Danh Sách Thiết Bị Mạng"
    elif echo "$RAW_TEXT" | grep -qi "GAME"; then
        AUDIO_TITLE="Tối Ưu Game & Độ Trễ"
    elif echo "$RAW_TEXT" | grep -qi "BĂNG TẦN\|SÓNG 5G\|TÍN HIỆU SÓNG"; then
        AUDIO_TITLE="Báo Cáo Băng Tần 5G/4G"
    fi

    if ! check_rate_limit; then
        rm -f "/tmp/tg_vcap_$$.txt" "/tmp/tg_vmk_$$.json" "$TMP_AUDIO" 2>/dev/null
        exit 0
    fi

    # Đảm bảo khoảng cách tối thiểu 1.0s so với tin nhắn text tạm trước đó để không bị Telegram giới hạn 1 msg/s
    last_ts=$(cat /tmp/tg_last_msg_sent_ts 2>/dev/null || echo 0)
    now_ts=$(date +%s)
    if [ "$now_ts" -le "$last_ts" ] 2>/dev/null; then
        sleep 1
    fi

    resp=""
    if [ -s "/tmp/tg_vmk_$$.json" ]; then
        resp=$(curl -s -m 15 "${API_URL}/sendVoice" \
            -F "chat_id=${ADMIN_CHAT_ID}" \
            -F "voice=@${TMP_AUDIO}" \
            -F "caption=</tmp/tg_vcap_$$.txt" \
            -F "parse_mode=HTML" \
            -F "reply_markup=</tmp/tg_vmk_$$.json;type=application/json")
    else
        resp=$(curl -s -m 15 "${API_URL}/sendVoice" \
            -F "chat_id=${ADMIN_CHAT_ID}" \
            -F "voice=@${TMP_AUDIO}" \
            -F "caption=</tmp/tg_vcap_$$.txt" \
            -F "parse_mode=HTML")
    fi
    rm -f "/tmp/tg_vcap_$$.txt" "/tmp/tg_vmk_$$.json" 2>/dev/null
    record_rate_limit "$resp"

    # 5. Ghi nhận ID tin nhắn âm thanh mới nhất & Xóa tin nhắn text tạm (Zero Flicker)
    v_mid=$(echo "$resp" | jsonfilter -e '$.result.message_id' 2>/dev/null)
    if [ -n "$v_mid" ]; then
        echo "$v_mid" > /tmp/tg_last_voice_mid.txt
        echo "$v_mid" > /tmp/tg_last_bot_mid.txt
        echo "$(date +%s)|${v_mid}" >> /tmp/tg_msg_history.log
        date +%s > /tmp/tg_last_msg_sent_ts

        # Xóa tin nhắn văn bản tạm trước đó (Zero Flicker)
        if [ -n "$TARGET_MID" ] && [ "$TARGET_MID" != "keep" ] && [ "$TARGET_MID" != "NONE" ]; then
            if check_rate_limit; then
                curl -s -m 3 "${API_URL}/deleteMessage?chat_id=${ADMIN_CHAT_ID}&message_id=${TARGET_MID}" >/dev/null 2>&1 &
            fi
        fi
    else
        # 6. Fallback cứu hộ: Nếu gửi Audio thất bại, fallback an toàn sang Text
        if check_rate_limit; then
            pfile_fb="/tmp/.tg_fb_$$.txt"
            if [ -z "$TARGET_MID" ] || [ "$TARGET_MID" = "NONE" ]; then
                lua - "$ADMIN_CHAT_ID" "$RAW_TEXT" "${NEW_MARKUP:-$CUSTOM_MARKUP}" "$pfile_fb" << 'LUAFB' 2>/dev/null
local cid, text, markup, outpath = arg[1], arg[2], arg[3], arg[4]
text = text or ''
local enc = (string.gsub(text, '([^%w_.~-])', function(c) return string.format('%%%02X', string.byte(c)) end))
local post_data = 'chat_id=' .. cid .. '&parse_mode=HTML&text=' .. enc
if markup and #markup > 0 then
    local enc_markup = (string.gsub(markup, '([^%w_.~-])', function(c) return string.format('%%%02X', string.byte(c)) end))
    post_data = post_data .. '&reply_markup=' .. enc_markup
end
local f = io.open(outpath, 'w')
if f then f:write(post_data); f:close() end
LUAFB
                resp=$(curl -s -m 8 -d @"$pfile_fb" "${API_URL}/sendMessage" 2>/dev/null)
            else
                lua - "$ADMIN_CHAT_ID" "$TARGET_MID" "$RAW_TEXT" "${NEW_MARKUP:-$CUSTOM_MARKUP}" "$pfile_fb" << 'LUAFB2' 2>/dev/null
local cid, mid, text, markup, outpath = arg[1], arg[2], arg[3], arg[4], arg[5]
text = text or ''
local enc = (string.gsub(text, '([^%w_.~-])', function(c) return string.format('%%%02X', string.byte(c)) end))
local post_data = 'chat_id=' .. cid .. '&message_id=' .. mid .. '&parse_mode=HTML&text=' .. enc
if markup and #markup > 0 then
    local enc_markup = (string.gsub(markup, '([^%w_.~-])', function(c) return string.format('%%%02X', string.byte(c)) end))
    post_data = post_data .. '&reply_markup=' .. enc_markup
end
local f = io.open(outpath, 'w')
if f then f:write(post_data); f:close() end
LUAFB2
                resp=$(curl -s -m 8 -d @"$pfile_fb" "${API_URL}/editMessageText" 2>/dev/null)
            fi
            rm -f "$pfile_fb" 2>/dev/null
            record_rate_limit "$resp"
            fb_mid=$(echo "$resp" | jsonfilter -e '$.result.message_id' 2>/dev/null)
            [ -z "$fb_mid" ] && fb_mid="$TARGET_MID"
            if [ -n "$fb_mid" ]; then
                echo "$fb_mid" > /tmp/tg_last_bot_mid.txt
            fi
        fi
    fi
fi

rm -f "$TMP_AUDIO" 2>/dev/null

TTS_SPEAKER_EOF
    chmod +x /usr/bin/tts_speaker.sh


    if ! command -v curl >/dev/null 2>&1; then
        cat << 'CURL_WRAPPER' > /usr/bin/curl
#!/bin/sh
# Universal curl wrapper using uclient-fetch for OpenWrt
url=""
post_data=""
post_file=""
out_file="-"
timeout=15
headers=""
ipv4_only=""

while [ $# -gt 0 ]; do
    case "$1" in
        --version|-V)
            echo "curl 8.5.0 (uclient-fetch wrapper)"
            exit 0
            ;;
        -4) ipv4_only="-4"; shift ;;
        -6) shift ;;
        -s|-q|--silent|-S) shift ;;
        -m|--max-time) timeout="$2"; shift 2 ;;
        -X) shift 2 ;;
        -H|--header)
            headers="${headers} --header='$2'"
            shift 2
            ;;
        -d|--data|--data-raw|--data-ascii|--data-binary)
            case "$2" in
                @*)
                    post_file="${2#@}"
                    ;;
                *)
                    if [ -n "$post_data" ]; then
                        post_data="${post_data}&$2"
                    else
                        post_data="$2"
                    fi
                    ;;
            esac
            shift 2
            ;;
        --data-urlencode)
            key=$(echo "$2" | cut -d= -f1)
            val=$(echo "$2" | cut -d= -f2-)
            enc_val=$(printf '%s' "$val" | sed 's/ /%20/g; s/&/%26/g' | tr '\n' '\001' | sed 's/\001/%0A/g')
            if [ -n "$post_data" ]; then
                post_data="${post_data}&${key}=${enc_val}"
            else
                post_data="${key}=${enc_val}"
            fi
            shift 2
            ;;
        -o|--output) out_file="$2"; shift 2 ;;
        http://*|https://*) url="$1"; shift ;;
        *) shift ;;
    esac
done

if [ -z "$url" ]; then
    exit 0
fi

cmd="uclient-fetch -q $ipv4_only -O \"$out_file\" --no-check-certificate --timeout=\"$timeout\""
if [ -n "$post_file" ] && [ -f "$post_file" ]; then
    cmd="$cmd --post-file=\"$post_file\""
elif [ -n "$post_data" ]; then
    cmd="$cmd --post-data=\"$post_data\""
fi

if [ -n "$headers" ]; then
    eval "$cmd $headers \"$url\""
else
    eval "$cmd \"$url\""
fi

CURL_WRAPPER
        chmod +x /usr/bin/curl
    fi

    cat << 'CMDTELEGRAM' > /usr/bin/send_telegram
#!/bin/sh
trap 'wait -n 2>/dev/null' CHLD
BOT_TOKEN=""
ADMIN_CHAT_ID=""
if [ -f /etc/config/telegram_bot.conf ]; then
    . /etc/config/telegram_bot.conf 2>/dev/null
    [ -n "$TG_BOT_TOKEN" ] && BOT_TOKEN="$TG_BOT_TOKEN"
    [ -n "$TG_ADMIN_ID" ] && ADMIN_CHAT_ID="$TG_ADMIN_ID"
fi
msg="$1"
markup="$2"
autodel="${3:-$TG_AUTODEL}"
[ -z "$msg" ] || [ -z "$ADMIN_CHAT_ID" ] || [ -z "$BOT_TOKEN" ] && exit 0

# 🌙 CHẾ ĐỘ YÊN TĨNH BAN ĐÊM (23:00 - 06:59): Không gửi báo cáo định kỳ làm phiền giấc ngủ
cur_hour=$(date +%H 2>/dev/null || echo 12)
if [ "$cur_hour" -ge 23 ] || [ "$cur_hour" -lt 7 ]; then
    if ! echo "$msg" | grep -qE '(CẢNH BÁO KHẨN|SOS|BÁO ĐỘNG|XÂM NHẬP|CHÁY NỔ|QUÁ NHIỆT|NGUY HIỂM)'; then
        exit 0
    fi
fi

# 🛡️ CHỐNG TRÙNG LẶP TIN NHẮN (DEDUPLICATION HASH FILTER):
text_hash=$(echo -n "$msg" | md5sum 2>/dev/null | awk '{print $1}')
if [ -n "$text_hash" ]; then
    hash_file="/tmp/tg_hash_${text_hash}"
    if [ -f "$hash_file" ]; then
        now_s=$(date +%s)
        file_s=$(date -r "$hash_file" +%s 2>/dev/null || stat -c %Y "$hash_file" 2>/dev/null || echo 0)
        if [ $((now_s - file_s)) -lt 1800 ]; then
            exit 0
        fi
    fi
    touch "$hash_file" 2>/dev/null
    find /tmp -maxdepth 1 -name "tg_hash_*" -mmin +60 -delete 2>/dev/null &
fi

check_rate_limit() {
    local now=$(date +%s)
    local ban_until=$(cat /tmp/tg_rate_limit_until.ts 2>/dev/null || echo 0)
    if [ "$now" -lt "$ban_until" ] 2>/dev/null; then
        return 1
    fi
    return 0
}

record_rate_limit() {
    local resp="$1"
    if echo "$resp" | grep -q '"error_code":429'; then
        local r_sec=$(echo "$resp" | jsonfilter -e '$.parameters.retry_after' 2>/dev/null || echo 15)
        [ -z "$r_sec" ] || [ "$r_sec" -lt 2 ] 2>/dev/null && r_sec=15
        local now=$(date +%s)
        local until=$((now + r_sec + 2))
        echo "$until" > /tmp/tg_rate_limit_until.ts
        return 1
    fi
    return 0
}

if ! check_rate_limit; then
    exit 0
fi

pfile="/tmp/.tg_send_$$.txt"
lua - "$ADMIN_CHAT_ID" "$msg" "${markup:-}" "$pfile" << 'LUAPOST' 2>/dev/null
local cid, text, markup, outpath = arg[1], arg[2], arg[3], arg[4]
text = text or ''
text = string.gsub(text, '\\n', '\n')
text = string.gsub(text, '\r', '')

local function sanitize_tg_html(s)
    if not s or #s == 0 then return "" end
    local tags, counter = {}, 0
    local p = s:gsub("<(/?)([a-zA-Z0-9_-]+)([^>]*)>", function(slash, tag, attrs)
        local t = tag:lower()
        if t == "b" or t == "strong" or t == "i" or t == "em" or t == "u" or t == "ins" or
           t == "s" or t == "strike" or t == "del" or t == "code" or t == "pre" or
           t == "a" or t == "tg-spoiler" or t == "blockquote" then
            counter = counter + 1
            local ph = "\001TAG" .. counter .. "\002"
            tags[ph] = "<" .. slash .. tag .. attrs .. ">"
            return ph
        end
        return "&lt;" .. slash .. tag .. attrs .. "&gt;"
    end)
    p = p:gsub("&", "&amp;"):gsub("&amp;([a-zA-Z0-9]+);", "&%1;")
    p = p:gsub("<", "&lt;"):gsub(">", "&gt;")
    for ph, tag in pairs(tags) do p = p:gsub(ph, tag) end
    if #p > 4000 then p = p:sub(1, 3950) .. "..." end
    return p
end

text = sanitize_tg_html(text)
local enc = (string.gsub(text, '([^%w_.~-])', function(c)
    return string.format('%%%02X', string.byte(c))
end))
local post_data = 'chat_id=' .. cid .. '&parse_mode=HTML&text=' .. enc
if markup and #markup > 0 and markup:match('^%s*{') then
    local enc_markup = (string.gsub(markup, '([^%w_.~-])', function(c)
        return string.format('%%%02X', string.byte(c))
    end))
    post_data = post_data .. '&reply_markup=' .. enc_markup
end
local f = io.open(outpath, 'w')
if f then
    f:write(post_data)
    f:close()
end
LUAPOST

res=""
if command -v curl >/dev/null 2>&1; then
    res=$(curl -s -m 8 -d @"$pfile" "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" 2>/dev/null)
else
    res=$(uclient-fetch -q -O - --no-check-certificate --timeout=8 --post-file="$pfile" "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" 2>/dev/null)
fi
rm -f "$pfile" 2>/dev/null
record_rate_limit "$res"

if ! echo "$res" | grep -q '"ok":true'; then
    check_rate_limit || exit 0
    plain_text=$(echo "$msg" | sed 's/<[^>]*>/ /g' | tr -s ' ' | cut -c 1-4000)
    pfile_fb="/tmp/.tg_send_fb_$$.txt"
    lua - "$ADMIN_CHAT_ID" "$plain_text" "${markup:-}" "$pfile_fb" << 'LUAFB' 2>/dev/null
local cid, text, markup, outpath = arg[1], arg[2], arg[3], arg[4]
text = text or ''
local enc = (string.gsub(text, '([^%w_.~-])', function(c) return string.format('%%%02X', string.byte(c)) end))
local post_data = 'chat_id=' .. cid .. '&text=' .. enc
if markup and #markup > 0 and markup:match('^%s*{') then
    local enc_markup = (string.gsub(markup, '([^%w_.~-])', function(c) return string.format('%%%02X', string.byte(c)) end))
    post_data = post_data .. '&reply_markup=' .. enc_markup
end
local f = io.open(outpath, 'w')
if f then f:write(post_data); f:close() end
LUAFB
    if command -v curl >/dev/null 2>&1; then
        res=$(curl -s -m 8 -d @"$pfile_fb" "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" 2>/dev/null)
    else
        res=$(uclient-fetch -q -O - --no-check-certificate --timeout=8 --post-file="$pfile_fb" "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" 2>/dev/null)
    fi
    rm -f "$pfile_fb" 2>/dev/null
    record_rate_limit "$res"
fi

msg_id=$(echo "$res" | jsonfilter -e '$.result.message_id' 2>/dev/null)
[ -z "$msg_id" ] && msg_id=$(echo "$res" | sed -n 's/.*"message_id":[ ]*\([0-9]*\).*/\1/p')

if [ -n "$autodel" ] && [ "$autodel" -gt 0 ] 2>/dev/null && [ -n "$msg_id" ]; then
    (
        sleep "$autodel"
        if [ -x /usr/bin/delete_telegram ]; then
            /usr/bin/delete_telegram "$msg_id" "$ADMIN_CHAT_ID" >/dev/null 2>&1
        elif command -v curl >/dev/null 2>&1; then
            curl -s -m 6 -d "chat_id=${ADMIN_CHAT_ID}&message_id=${msg_id}" "https://api.telegram.org/bot${BOT_TOKEN}/deleteMessage" >/dev/null 2>&1
        else
            uclient-fetch -q -O - --no-check-certificate --timeout=6 --post-data="chat_id=${ADMIN_CHAT_ID}&message_id=${msg_id}" "https://api.telegram.org/bot${BOT_TOKEN}/deleteMessage" >/dev/null 2>&1
        fi
    ) >/dev/null 2>&1 &
fi

echo "$res"
CMDTELEGRAM
    chmod +x /usr/bin/send_telegram

    cat << 'CMD_DEL_TELEGRAM' > /usr/bin/delete_telegram
#!/bin/sh
# ==============================================================================
# 🗑️ UNIVERSAL TELEGRAM MESSAGE DELETER CLI (OPENWRT / SYSFIXTINE)
# Xóa tin nhắn Telegram chỉ định qua API deleteMessage
# Sử dụng: delete_telegram <message_id> [chat_id]
# ==============================================================================

BOT_TOKEN=""
ADMIN_CHAT_ID=""
if [ -f /etc/config/telegram_bot.conf ]; then
    . /etc/config/telegram_bot.conf 2>/dev/null
    [ -n "$TG_BOT_TOKEN" ] && BOT_TOKEN="$TG_BOT_TOKEN"
    [ -n "$TG_ADMIN_ID" ] && ADMIN_CHAT_ID="$TG_ADMIN_ID"
fi

mid="$1"
cid="${2:-$ADMIN_CHAT_ID}"

[ -z "$mid" ] || [ -z "$cid" ] || [ -z "$BOT_TOKEN" ] && exit 0

if command -v curl >/dev/null 2>&1; then
    curl -s -m 6 -d "chat_id=${cid}&message_id=${mid}" "https://api.telegram.org/bot${BOT_TOKEN}/deleteMessage" >/dev/null 2>&1
else
    uclient-fetch -q -O - --no-check-certificate --timeout=6 --post-data="chat_id=${cid}&message_id=${mid}" "https://api.telegram.org/bot${BOT_TOKEN}/deleteMessage" >/dev/null 2>&1
fi
exit 0
CMD_DEL_TELEGRAM
    chmod +x /usr/bin/delete_telegram
    ln -sf /usr/bin/delete_telegram /usr/bin/del_tg 2>/dev/null

    cat << 'AUTO_APN_EOF' > /usr/bin/auto_apn.sh
#!/bin/sh
# ==============================================================================
# 🌐 ZERO-TOUCH MULTI-CARRIER AUTO-APN & BAND OPTIMIZER
# Tự động nhận diện SIM nhà mạng (Viettel, Vina, Mobi, Wintel, Vietnamobile...)
# Cấu hình APN chuẩn, MTU tối ưu và PDP context tự động 100% không cần can thiệp thủ công
# ==============================================================================

MODEM_PORT=""
for p in /dev/ttyUSB2 /dev/ttyUSB1 /dev/ttyUSB0 /dev/mhi_BHI /dev/cdc-wdm0; do
    if [ -e "$p" ]; then
        MODEM_PORT="$p"
        break
    fi
done

STATUS_FILE="/tmp/auto_apn_status.json"

send_at_cmd() {
    local cmd="$1"
    local dev="${2:-$MODEM_PORT}"
    [ -z "$dev" ] && return 1

    if command -v atinout >/dev/null 2>&1; then
        echo "$cmd" | timeout 3 atinout - "$dev" - 2>/dev/null | tr -d '\r'
    elif command -v sms_tool >/dev/null 2>&1; then
        timeout 3 sms_tool -d "$dev" at "$cmd" 2>/dev/null | tr -d '\r'
    else
        return 1
    fi
}

detect_carrier_from_modem() {
    local imsi=""
    local plmn=""
    local oper=""

    # 1. Đọc từ file cache trạng thái nhanh nếu có sẵn
    if [ -f /tmp/fast_state/modem.json ]; then
        imsi=$(grep -o '"imsi":"[^"]*"' /tmp/fast_state/modem.json 2>/dev/null | cut -d'"' -f4)
        oper=$(grep -o '"operator":"[^"]*"' /tmp/fast_state/modem.json 2>/dev/null | cut -d'"' -f4)
    fi

    # 2. Đọc IMSI qua uqmi / qmicli
    if [ -z "$imsi" ]; then
        for cdc in /dev/cdc-wdm0 /dev/cdc-wdm1; do
            if [ -c "$cdc" ]; then
                if command -v uqmi >/dev/null 2>&1; then
                    imsi=$(uqmi -d "$cdc" --get-imsi 2>/dev/null | tr -d '"\r\n ')
                fi
                if [ -z "$imsi" ] && command -v qmicli >/dev/null 2>&1; then
                    imsi=$(qmicli -d "$cdc" --dms-uim-get-imsi 2>/dev/null | awk -F"'" '/IMSI/ {print $2}')
                fi
                [ -n "$imsi" ] && break
            fi
        done
    fi

    # 3. Đọc IMSI & COPS qua AT command
    if [ -z "$imsi" ] && [ -n "$MODEM_PORT" ]; then
        local at_res=$(send_at_cmd "AT+CIMI")
        imsi=$(echo "$at_res" | grep -oE '[0-9]{15}' | head -1)
        if [ -z "$imsi" ]; then
            at_res=$(send_at_cmd "AT+COPS?")
            oper=$(echo "$at_res" | grep -oE '"[^"]+"' | tr -d '"' | head -1)
        fi
    fi

    local mcc_mnc=""
    [ -n "$imsi" ] && mcc_mnc=$(echo "$imsi" | cut -c 1-5)

    echo "${mcc_mnc}|${imsi}|${oper}"
}

resolve_carrier_profile() {
    local mcc_mnc="$1"
    local oper="$2"

    local c_name="Viettel Telecom 4G/5G"
    local c_apn="v-internet"
    local c_mtu=1420
    local c_ussd="*098#"
    local c_sms="9220|DL"

    case "$mcc_mnc" in
        45204|45208|45218)
            c_name="Viettel Telecom 4G/5G"
            c_apn="v-internet"
            c_mtu=1420
            c_ussd="*098#"
            c_sms="9220|DL"
            ;;
        45202|45205)
            c_name="VNPT VinaPhone 4G/5G"
            c_apn="m3-world"
            c_mtu=1440
            c_ussd="*888#"
            c_sms="888|KT"
            ;;
        45201)
            c_name="MobiFone 4G/5G"
            c_apn="m-internet"
            c_mtu=1430
            c_ussd="*101#"
            c_sms="999|KT"
            ;;
        45207)
            c_name="Vietnamobile 4G"
            c_apn="internet"
            c_mtu=1430
            c_ussd="*102#"
            c_sms="1414|KT"
            ;;
        45206)
            c_name="Wintel (Reddi) 4G"
            c_apn="internet.reddi.com.vn"
            c_mtu=1430
            c_ussd="*103#"
            c_sms="1800599930|TT"
            ;;
        44010|44020)
            c_name="Japan Carrier (Docomo/Softbank)"
            c_apn="plus.acs.jp"
            c_mtu=1500
            ;;
        310260|310410)
            c_name="USA Carrier (T-Mobile/AT&T)"
            c_apn="fast.t-mobile.com"
            c_mtu=1440
            ;;
        *)
            # Heuristic match qua tên nhà mạng nếu không có IMSI
            local low_oper=$(echo "$oper" | tr '[:upper:]' '[:lower:]')
            if echo "$low_oper" | grep -qi "vina"; then
                c_name="VNPT VinaPhone 4G/5G"; c_apn="m3-world"; c_mtu=1440
            elif echo "$low_oper" | grep -qi "mobi"; then
                c_name="MobiFone 4G/5G"; c_apn="m-internet"; c_mtu=1430
            elif echo "$low_oper" | grep -qi "vietnamobile"; then
                c_name="Vietnamobile 4G"; c_apn="internet"; c_mtu=1430
            elif echo "$low_oper" | grep -qi "wintel"; then
                c_name="Wintel (Reddi) 4G"; c_apn="internet.reddi.com.vn"; c_mtu=1430
            else
                c_name="Viettel Telecom 4G/5G"; c_apn="v-internet"; c_mtu=1420
            fi
            ;;
    esac

    echo "${c_name}|${c_apn}|${c_mtu}|${c_ussd}|${c_sms}"
}

apply_apn_profile() {
    local force="$1"
    local raw_info=$(detect_carrier_from_modem)
    local mcc_mnc=$(echo "$raw_info" | cut -d'|' -f1)
    local imsi=$(echo "$raw_info" | cut -d'|' -f2)
    local oper=$(echo "$raw_info" | cut -d'|' -f3)

    local prof=$(resolve_carrier_profile "$mcc_mnc" "$oper")
    local c_name=$(echo "$prof" | cut -d'|' -f1)
    local c_apn=$(echo "$prof" | cut -d'|' -f2)
    local c_mtu=$(echo "$prof" | cut -d'|' -f3)

    local cur_apn=$(uci -q get network.wwan0.apn)
    local cur_mtu=$(uci -q get network.wwan0.mtu)
    local changed=0

    if [ "$cur_apn" != "$c_apn" ] || [ "$cur_mtu" != "$c_mtu" ] || [ "$force" = "force" ]; then
        changed=1
        logger -t auto_apn "🌐 Phát hiện SIM: $c_name (MCC/MNC: ${mcc_mnc:-Viettel}) - Tự động thiết lập APN: $c_apn, MTU: $c_mtu"

        uci set network.wwan0.apn="$c_apn"
        uci set network.wwan0.mtu="$c_mtu"
        uci commit network 2>/dev/null

        # Cấu hình PDP Context trực tiếp vào modem qua AT command
        if [ -n "$MODEM_PORT" ]; then
            send_at_cmd "AT+CGDCONT=1,\"IPV4V6\",\"${c_apn}\"" >/dev/null 2>&1
        fi

        # Khởi động lại interface WWAN trong nền mượt mà
        ( sleep 1 && ifup wwan0 ) >/dev/null 2>&1 &
    fi

    local res_json="{\"status\":\"ok\",\"carrier\":\"$c_name\",\"mcc_mnc\":\"${mcc_mnc:-45204}\",\"apn\":\"$c_apn\",\"mtu\":$c_mtu,\"applied\":$changed}"
    echo "$res_json" > "$STATUS_FILE"
    echo "$res_json"
}

case "$1" in
    apply|auto|"")
        apply_apn_profile "auto"
        ;;
    force)
        apply_apn_profile "force"
        ;;
    status)
        cat "$STATUS_FILE" 2>/dev/null || apply_apn_profile "auto"
        ;;
    *)
        echo "Usage: $0 {apply|force|status}"
        exit 1
        ;;
esac
AUTO_APN_EOF
    chmod +x /usr/bin/auto_apn.sh
    ln -sf /usr/bin/auto_apn.sh /usr/bin/auto_apn 2>/dev/null

    cat << 'LAN_GUARDIAN_EOF' > /usr/bin/lan_guardian
#!/bin/sh
# ==============================================================================
# 🛡️ LAN IP GUARDIAN & FAILSAFE RECOVERY SYSTEM (BẢO VỆ CỔNG LAN & IP LAN)
# Tác giả: Sysfixtine Universal Architecture
# Tính năng:
#  1. Tự động liên kết các cổng LAN vật lý (lan1, lan2, lan3, eth0...) vào bridge br-lan.
#  2. Khóa cứng IP LAN 192.168.1.1/24 và tự động phục hồi nếu bị mất hoặc thay đổi.
#  3. Tự động cấp 2 IP Cứu Hộ Bất Tử: 192.168.99.1/24 và 169.254.1.1/16 (APIPA).
#  4. Giám sát và tự động hồi sinh DHCP server (dnsmasq) cấp dải 192.168.1.100-250.
#  5. Ngăn ngừa triệt để lỗi mất kết nối cổng LAN khi Flash ROM mới.
# ==============================================================================

LOG_FILE="/tmp/lan_guardian.log"
LOCK_DIR="/tmp/lan_guardian.lock"

log_msg() {
    local msg="[$(date '+%Y-%m-%d %H:%M:%S')] [LAN_GUARDIAN] $1"
    echo "$msg"
    echo "$msg" >> "$LOG_FILE" 2>/dev/null
}

# Dò quét danh sách các cổng mạng Ethernet LAN vật lý có mặt trên phần cứng
get_physical_lan_ports() {
    local ports=""
    for iface in /sys/class/net/*; do
        [ -d "$iface" ] || continue
        local dev_name=$(basename "$iface")
        [ -d "$iface/dsa" ] && continue
        case "$dev_name" in
            lan*|eth[0-9]|enp*|eth1|eth2)
                # Loại trừ bridge, wireless và modem
                [ "$dev_name" = "br-lan" ] && continue
                ports="$ports $dev_name"
                ;;
        esac
    done
    echo "$ports" | sed 's/^[[:space:]]*//'
}

# Kiểm tra và kích hoạt cổng vật lý vào bridge br-lan
ensure_physical_ports_bridged() {
    local target_ports=$(get_physical_lan_ports)
    [ -z "$target_ports" ] && target_ports="lan1 lan2"

    for port in $target_ports; do
        if [ -d "/sys/class/net/$port" ]; then
            # Ép bật link cổng vật lý
            ip link set dev "$port" up 2>/dev/null

            # Kiểm tra xem cổng đã thuộc master br-lan chưa
            local cur_master=$(ip link show dev "$port" 2>/dev/null | grep -oE 'master [^ ]+' | awk '{print $2}')
            if [ "$cur_master" != "br-lan" ]; then
                log_msg ">> Gắn cổng vật lý $port vào bridge br-lan..."
                ip link set dev "$port" master br-lan 2>/dev/null
            fi
        fi
    done
}

# Đảm bảo bridge br-lan luôn có IP 192.168.1.1 và các IP cứu hộ
ensure_lan_ip_addresses() {
    # 1. Đảm bảo br-lan đang UP
    if [ -d "/sys/class/net/br-lan" ]; then
        ip link set dev br-lan up 2>/dev/null
    fi

    # 2. Kiá»ƒm tra IP chÃ­nh cá»§a LAN
    local target_lan_ip=$(uci -q get network.lan.ipaddr || echo "192.168.1.1")
    [ -z "$target_lan_ip" ] && target_lan_ip="192.168.1.1"
    local has_main_ip=$(ip -4 addr show dev br-lan 2>/dev/null | grep -w "$target_lan_ip")
    if [ -z "$has_main_ip" ]; then
        log_msg ">> Cáº¢NH BÃO: br-lan bá»‹ máº¥t IP $target_lan_ip! Äang khÃ´i phá»¥c ngay láº­p tá»©c..."
        ip addr add "$target_lan_ip"/24 dev br-lan 2>/dev/null
    fi






    # 3. Gán IP Cứu Hộ 1: 192.168.99.1/24 (Dự phòng tĩnh không xung đột)
    local has_rescue_ip=$(ip -4 addr show dev br-lan 2>/dev/null | grep -w "192.168.99.1")
    if [ -z "$has_rescue_ip" ]; then
        ip addr add 192.168.99.1/24 dev br-lan 2>/dev/null
    fi

    # 4. Gán IP Cứu Hộ 2: 169.254.1.1/16 (APIPA ZeroConf - cắm dây là thông kể cả khi mất DHCP)
    local has_apipa_ip=$(ip -4 addr show dev br-lan 2>/dev/null | grep -w "169.254.1.1")
    if [ -z "$has_apipa_ip" ]; then
        ip addr add 169.254.1.1/16 dev br-lan 2>/dev/null
    fi
}

# Đảm bảo cấu hình UCI network & dhcp vĩnh viễn
ensure_uci_lan_config() {
    local changed=0
    local cur_ip=$(uci -q get network.lan.ipaddr)
    local cur_proto=$(uci -q get network.lan.proto)
    local cur_dev=$(uci -q get network.lan.device)

    if [ -z "$cur_ip" ]; then
        log_msg ">> Cập nhật lại cấu hình chuẩn cho network.lan..."
        uci -q batch <<EOC
set network.lan=interface
set network.lan.device='br-lan'
set network.lan.proto='static'
set network.lan.ipaddr='192.168.1.1'
set network.lan.netmask='255.255.255.0'
commit network
EOC
        changed=1
    fi

    # Đảm bảo DHCP Server lan được kích hoạt
    local dhcp_ignore=$(uci -q get dhcp.lan.ignore)
    if [ "$dhcp_ignore" = "1" ] || [ -z "$(uci -q get dhcp.lan)" ]; then
        log_msg ">> Kích hoạt lại DHCP Server dnsmasq trên interface lan..."
        uci -q batch <<EOC
set dhcp.lan=dhcp
set dhcp.lan.interface='lan'
set dhcp.lan.start='100'
set dhcp.lan.limit='150'
set dhcp.lan.leasetime='12h'
set dhcp.lan.dhcpv4='server'
set dhcp.lan.ignore='0'
commit dhcp
EOC
        changed=1
    fi

    if [ "$changed" -eq 1 ]; then
        /etc/init.d/network reload 2>/dev/null
        /etc/init.d/dnsmasq restart 2>/dev/null
    fi
}

# Giám sát và tự động hồi sinh DHCP Server dnsmasq
ensure_dhcp_service() {
    if ! pgrep -x dnsmasq >/dev/null 2>&1; then
        log_msg ">> PHÁT HIỆN dnsmasq chưa chạy! Đang tự động khởi động lại..."
        /etc/init.d/dnsmasq restart >/dev/null 2>&1
    fi
}

# Kiểm tra chống xung đột IP giữa WAN / WWAN và LAN (192.168.1.x)
check_subnet_conflict() {
    for wan_if in wan usb0 wwan0; do
        local wan_ip=$(ip -4 addr show dev "$wan_if" 2>/dev/null | grep 'inet ' | awk '{print $2}')
        if echo "$wan_ip" | grep -q "^192\.168\.1\."; then
            log_msg ">> ⚠️ CẢNH BÁO: Interface $wan_if nhận dải IP $wan_ip trùng với LAN (192.168.1.0/24)! Đang ưu tiên bảo vệ LAN..."
        fi
    done
}

# Lệnh tổng lực hồi phục (Heal All)
heal_lan() {
    mkdir -p /tmp/lan_guardian.lock 2>/dev/null || true
    ensure_uci_lan_config
    ensure_physical_ports_bridged
    ensure_lan_ip_addresses
    ensure_dhcp_service
    check_subnet_conflict
    rmdir /tmp/lan_guardian.lock 2>/dev/null || true
    log_msg ">> Hoàn tất kiểm tra & bảo vệ cổng LAN! IP chính: 192.168.1.1 · Cứu hộ: 192.168.99.1 & 169.254.1.1"
}

# Trạng thái hiện tại xuất dạng JSON
status_lan() {
    local ports=$(get_physical_lan_ports)
    local br_ips=$(ip -4 addr show dev br-lan 2>/dev/null | grep 'inet ' | awk '{print $2}' | tr '\n' ',' | sed 's/,$//')
    local dns_status=$(pgrep -x dnsmasq >/dev/null 2>&1 && echo "running" || echo "stopped")
    cat <<EOF
{
  "status": "protected",
  "main_ip": "192.168.1.1",
  "rescue_ips": ["192.168.99.1", "169.254.1.1"],
  "active_ips": "$br_ips",
  "physical_ports": "$ports",
  "dnsmasq": "$dns_status"
}
EOF
}

case "$1" in
    heal|fix|start)
        heal_lan
        ;;
    check)
        ensure_physical_ports_bridged
        ensure_lan_ip_addresses
        ensure_dhcp_service
        ;;
    status)
        status_lan
        ;;
    *)
        echo "Sử dụng: $0 {heal|check|status}"
        heal_lan
        ;;
esac
