        print("Content-Type: application/json; charset=utf-8\r\n\r\n{\"success\":true,\"message\":\"ÄÃ£ Ä‘Ã¡nh thá»©c mÃ n hÃ¬nh\"}")
    elseif cmd == "sleep" then
        run_adb("input keyevent KEYCODE_SLEEP")
        print("Content-Type: application/json; charset=utf-8\r\n\r\n{\"success\":true,\"message\":\"ÄÃ£ táº¯t mÃ n hÃ¬nh\"}")
    elseif cmd == "restart_webdav" then
        run_adb("'am force-stop com.example.athenapronas 2>/dev/null; am force-stop com.theolivetree.webdavserver 2>/dev/null; am start -n com.example.athenapronas/.MainActivity 2>/dev/null || am start -n com.theolivetree.webdavserver/.WebDavActivity 2>/dev/null; am broadcast -a com.example.athenapronas.START_SERVER 2>/dev/null; am broadcast -a com.theolivetree.webdavserver.START_SERVER 2>/dev/null'")
