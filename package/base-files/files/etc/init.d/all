        var cctvGlobalData = null;
        function loadCameraIntoForm(cam) {
            var defaultAdminId = (tgAdminInput && tgAdminInput.value.trim()) || '';
            if (!cam || cam === 'new_cam') {
                cctvCamSelect.value = 'new_cam';
                cctvBotNameInput.value = '';
                cctvRtspInput.value = '';
                cctvRtspInput.placeholder = 'rtsp://admin:password@192.168.1.xxx:554/cam/realmonitor?channel=1&subtype=1';
                cctvTokenInput.value = '';
                cctvTokenInput.placeholder = 'Nhập Token Bot Telegram';
                cctvChatIdInput.value = defaultAdminId;
                cctvDurationSelect.value = (cctvGlobalData && cctvGlobalData.global && cctvGlobalData.global.segment_duration) || '10';
                cctvNvrModeSelect.value = (cctvGlobalData && cctvGlobalData.global && cctvGlobalData.global.nvr_mode) || '1';
                cctvStreamProfileSelect.value = 'sub';
                cctvPushTgSelect.value = '1';
                cctvSnapPreviewCheckbox.checked = false;
            } else {
                cctvCamSelect.value = cam.id;
                cctvBotNameInput.value = cam.name || '';
                cctvRtspInput.value = cam.rtsp_url || '';
                cctvTokenInput.value = '';
                cctvTokenInput.placeholder = cam.has_token ? '•••••••••••••••••••• (Đã bảo mật)' : 'Nhập Token Bot Telegram';
                cctvChatIdInput.value = cam.chat_id || defaultAdminId;
                cctvDurationSelect.value = cam.duration || (cctvGlobalData && cctvGlobalData.global && cctvGlobalData.global.segment_duration) || '10';
                cctvNvrModeSelect.value = (cctvGlobalData && cctvGlobalData.global && cctvGlobalData.global.nvr_mode) || '1';
                cctvStreamProfileSelect.value = cam.stream_profile || 'sub';
                cctvPushTgSelect.value = (cam.push_tg === false || cam.push_tg === '0') ? '0' : '1';
                cctvSnapPreviewCheckbox.checked = (cam.snap_preview === true || cam.snap_preview === '1');
            }
        }

        cctvCamSelect.addEventListener('change', function() {
            var selectedId = this.value;
            if (selectedId === 'new_cam') {
                loadCameraIntoForm('new_cam');
            } else if (cctvGlobalData && cctvGlobalData.cameras) {
                var found = cctvGlobalData.cameras.find(function(c) { return c.id === selectedId; });
                if (found) loadCameraIntoForm(found);
            }
        });

        function refreshCctvUi() {
            fetch('/cgi-bin/airdrop?action=cctv_status')
                .then(function(r) { return r.json(); })
                .then(function(res) {
                    if (!res || res.status !== 'success') return;
                    cctvGlobalData = res;

                    var activeCount = (res.cameras || []).length;
                    var ramUsed = (res.ram && res.ram.used_mb) || 0;
                    cctvBadge.textContent = '🟢 ' + activeCount + ' Bot Cam | ' + ramUsed + 'MB RAM';
                    cctvBadge.style.background = '#dcfce7';
                    cctvBadge.style.color = '#15803d';

                    var nvrMode = (res.global && res.global.nvr_mode) || '1';
                    cctvNvrModeSelect.value = nvrMode;

                    var pTg = res.global && res.global.push_to_telegram;
                    if (pTg) {
                        cctvTgToggleBtn.textContent = '📤 Đẩy Telegram: BẬT';
                        cctvTgToggleBtn.style.background = '#dcfce7';
                        cctvTgToggleBtn.style.color = '#15803d';
                        cctvTgToggleBtn.style.borderColor = '#86efac';
                    } else {
                        cctvTgToggleBtn.textContent = '📤 Đẩy Telegram: TẮT';
                        cctvTgToggleBtn.style.background = '#fee2e2';
                        cctvTgToggleBtn.style.color = '#b91c1c';
                        cctvTgToggleBtn.style.borderColor = '#fca5a5';
                    }

                    while (cctvBotsListContainer.firstChild) {
                        cctvBotsListContainer.removeChild(cctvBotsListContainer.firstChild);
                    }

                    if (!res.cameras || res.cameras.length === 0) {
                        cctvBotsListContainer.appendChild(E('span', {
                            style: 'font-size: 11px; color: #000000; font-style: italic;'
                        }, 'Chưa có bot an ninh riêng. Bấm Thêm Bot để thêm.'));
                    } else {
                        res.cameras.forEach(function(cam) {
                            var isEn = (cam.enabled === true || cam.enabled === '1' || cam.enabled === 1);
                            var toggleBtn = E('button', {
                                class: 'btn',
                                style: 'font-size: 10px; font-weight: 800; padding: 1px 6px; border-radius: 10px; cursor: pointer; border: 1px solid; ' +
                                    (isEn ? 'background: #ffffff; color: #000000; border-color: #000000;' : 'background: #ffffff; color: #000000; border-color: #000000;'),
                                title: isEn ? ('Bấm để TẮT ' + (cam.name || cam.id)) : ('Bấm để BẬT ' + (cam.name || cam.id)),
                                click: function(ev) {
                                    ev.stopPropagation();
                                    var btn = this;
                                    btn.disabled = true;
                                    btn.textContent = '⏳ ...';
                                    var nextState = isEn ? '0' : '1';
                                    fetch('/cgi-bin/airdrop?action=cctv_toggle_camera&id=' + encodeURIComponent(cam.id) + '&state=' + nextState + '&_t=' + Date.now())
                                        .then(function(r) { return r.json(); })
                                        .then(function() {
                                            ui.addNotification(null, E('p', nextState === '1' ? ('🟢 Đã BẬT ' + (cam.name || cam.id)) : ('🔴 Đã TẮT ' + (cam.name || cam.id))), 'info');
                                            refreshCctvUi();
                                            if (typeof refreshCameraCloudStatus === 'function') refreshCameraCloudStatus();
                                        }).catch(function(err) {
                                            btn.disabled = false;
                                            ui.addNotification(null, E('p', '⚠️ Lỗi: ' + (err.message || err)), 'error');
                                        });
                                }
                            }, isEn ? '🟢 BẬT' : '🔴 TẮT');

                            var chip = E('div', {
                                style: 'display: inline-flex; align-items: center; gap: 6px; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 16px; padding: 3px 8px 3px 10px; font-size: 11px; font-weight: 700; color: #000000; box-shadow: 0 1px 2px rgba(0,0,0,0.04); cursor: pointer;',
                                title: 'Bấm tên để sửa cấu hình camera này',
                                click: function() {
                                    loadCameraIntoForm(cam);
                                    cctvFormWrapper.style.display = 'block';
                                    cctvToggleFormBtn.textContent = '🔼 Thu Gọn (Ẩn)';
                                }
                            }, [
                                E('span', {}, '📹 ' + (cam.name || cam.id)),
                                toggleBtn
                            ]);
                            cctvBotsListContainer.appendChild(chip);
                        });
                    }

                    while (cctvCamSelect.firstChild) {
                        cctvCamSelect.removeChild(cctvCamSelect.firstChild);
                    }
                    var optNew = E('option', { value: 'new_cam' }, '➕ Thêm Bot Camera Mới...');
                    cctvCamSelect.appendChild(optNew);
                    if (res.cameras) {
                        res.cameras.forEach(function(cam) {
                            var opt = E('option', { value: cam.id }, '📹 ' + (cam.name || cam.id) + ' (' + cam.id + ')');
                            cctvCamSelect.appendChild(opt);
                        });
                    }
                }).catch(function(e) {});
        }

