                    E('label', { style: 'display: flex; align-items: center; background: #ffffff; border: 1px solid #f87171; padding: 6px 10px; border-radius: 6px; cursor: pointer;' }, [ chkForce, E('span', { style: 'font-weight: 800; color: #000000;' }, '⚡ Buộc cập nhật (Bỏ qua kiểm tra ID Thiết bị / --force)') ])
                ]),
