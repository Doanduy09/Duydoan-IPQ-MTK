    cat << 'AIRDROP_CGI_EOF' > /www/cgi-bin/airdrop
#!/usr/bin/env lua
-- /www/cgi-bin/airdrop - Athena Wi-Fi 6 Ultra-Performance Web NAS Backend v3
-- Multi-Tier Storage Resolver, Self-Expiring Public Share Links, Multi-Phone Cluster & Laptop Sync
local nixio = require("nixio")
local fs = require("nixio.fs")

-- Auto-heal rclone & ffmpeg binary symlinks if missing
if not fs.stat("/usr/bin/rclone") then
    for _, p in ipairs({"/mnt/storage/rclone", "/mnt/mmcblk0p27/rclone", "/mnt/storage/bin/rclone"}) do
        if fs.stat(p) then
            os.execute(string.format("ln -sf '%s' /usr/bin/rclone 2>/dev/null", p))
            break
        end
    end
end
if not fs.stat("/usr/bin/ffmpeg") then
    for _, p in ipairs({"/mnt/storage/bin/ffmpeg", "/mnt/mmcblk0p27/bin/ffmpeg"}) do
        if fs.stat(p) then
            os.execute(string.format("ln -sf '%s' /usr/bin/ffmpeg 2>/dev/null", p))
            break
        end
    end
end
-- Auto-heal /etc/config/nas_phone if missing so UCI commands never fail
if not fs.stat("/etc/config/nas_phone") then
    os.execute("touch /etc/config/nas_phone 2>/dev/null")
end
-- Zero-dependency standalone UCI parser (never crashes, no ubus required)
local uci = {}
function uci:foreach(cfg_name, target_type, callback)
    local p = io.popen("uci show " .. cfg_name .. " 2>/dev/null")
    if not p then return end
    local secs = {}
    local order = {}
    for line in p:lines() do
        local sec, stype = line:match("^" .. cfg_name .. "%.([^.=]+)=([^%s]+)")
        if sec and stype then
            if not target_type or stype == target_type then
                if not secs[sec] then
                    secs[sec] = { [".name"] = sec, [".type"] = stype }
                    table.insert(order, sec)
                end
            end
        else
            local s, k, v = line:match("^" .. cfg_name .. "%.([^.=]+)%.([^=]+)='?(.-)'?$")
            if s and k and secs[s] then
                secs[s][k] = v
            end
        end
    end
    p:close()
    for _, sname in ipairs(order) do
        callback(secs[sname])
    end
end

local function uci_get(key, default)
    if not key then return default or "" end
    local cfg, sec, opt = key:match("^([^.]+)%.([^.]+)%.(.*)")
    if not cfg then cfg, opt = key:match("^([^.]+)%.(.*)") end
    if cfg and opt then
        local content = fs.readfile("/etc/config/" .. cfg)
        if content then
            local val = content:match("option%s+" .. opt .. "%s+['\"]?([^'\"\r\n]+)['\"]?")
            if val then return val end
        end
    end
    local p = io.popen("uci -q get " .. key .. " 2>/dev/null")
    if p then
        local v = p:read("*l")
        p:close()
        if v and #v > 0 then return v end
    end
    return default or ""
end

local PRIMARY_STORAGE = "/mnt/storage/airdrop/"
local FALLBACK_STORAGE = "/overlay/airdrop/"
local SHARES_FILE = "/mnt/storage/airdrop/.shares.json"

local STORAGE = PRIMARY_STORAGE
if not fs.stat("/mnt/storage/airdrop") then
    STORAGE = FALLBACK_STORAGE
    SHARES_FILE = "/overlay/airdrop/.shares.json"
end
fs.mkdirr(STORAGE)

local function get_query()
    local qs = os.getenv("QUERY_STRING") or ""
    local q = {}
    for part in qs:gmatch("[^&;]+") do
        local k, v = part:match("^([^=]+)=(.*)$")
        if k then
            k = k:gsub("%%(%x%x)", function(h) return string.char(tonumber(h, 16)) end)
            v = v:gsub("%%(%x%x)", function(h) return string.char(tonumber(h, 16)) end)
            q[k] = v
        else
            local k_only = part:gsub("%%(%x%x)", function(h) return string.char(tonumber(h, 16)) end)
            q[k_only] = ""
        end
    end
    return q
end

local function clean_filename(name)
    if not name then return nil end
    name = name:gsub("%%(%x%x)", function(h) return string.char(tonumber(h, 16)) end)
    name = name:gsub("%z", "")
    name = name:gsub("[\r\n\\/:]", "")
    name = name:gsub("[;`$><|&!~]", "")
    name = name:gsub("['\"]", "")
    name = name:gsub("^%.+", "")
    name = name:gsub("%.%.+", ".")
    if #name == 0 then return nil end
    return name
end

local function clean_path(p)
    if not p then return "" end
    p = p:gsub("%%(%x%x)", function(h) return string.char(tonumber(h, 16)) end)
    p = p:gsub("%z", "")
    p = p:gsub("%.%.+", "")
    p = p:gsub("[\r\n\\:;`$><|&!~]", "")
    p = p:gsub("['\"]", "")
    p = p:gsub("^[/\\]+", "")
    p = p:gsub("[/\\]+$", "")
    p = p:gsub("//+", "/")
    return p
end

local function format_bytes(bytes)
    bytes = tonumber(bytes) or 0
    if bytes >= 1073741824 then
        return string.format("%.2f GB", bytes / 1073741824)
    elseif bytes >= 1048576 then
        return string.format("%.2f MB", bytes / 1048576)
    elseif bytes >= 1024 then
        return string.format("%.1f KB", bytes / 1024)
    else
        return bytes .. " B"
    end
end

local mimes = {
    jpg = "image/jpeg", jpeg = "image/jpeg", png = "image/png", gif = "image/gif",
    webp = "image/webp", svg = "image/svg+xml", ico = "image/x-icon", bmp = "image/bmp",
    mp4 = "video/mp4", mkv = "video/mp4", webm = "video/webm", mov = "video/quicktime",
    avi = "video/x-msvideo", flv = "video/x-flv", m4v = "video/mp4", ts = "video/mp2t",
    mp3 = "audio/mpeg", wav = "audio/wav", ogg = "audio/ogg", flac = "audio/flac",
    m4a = "audio/mp4", aac = "audio/aac", wma = "audio/x-ms-wma",
    pdf = "application/pdf",
    txt = "text/plain; charset=utf-8", log = "text/plain; charset=utf-8", json = "application/json",
    md = "text/markdown; charset=utf-8", csv = "text/csv; charset=utf-8", html = "text/html; charset=utf-8",
    htm = "text/html; charset=utf-8", xml = "text/xml; charset=utf-8",
    sh = "text/plain; charset=utf-8", py = "text/plain; charset=utf-8", js = "text/javascript; charset=utf-8",
    css = "text/css; charset=utf-8", conf = "text/plain; charset=utf-8", bat = "text/plain; charset=utf-8",
    zip = "application/zip", rar = "application/x-rar-compressed", ["7z"] = "application/x-7z-compressed",
    tar = "application/x-tar", gz = "application/gzip", apk = "application/vnd.android.package-archive",
    ipk = "application/octet-stream", bin = "application/octet-stream"
}

local function get_file_type(name, is_dir)
    if is_dir then return "folder", "" end
    local ext = name:match("%.([^%.]+)$")
    ext = ext and ext:lower() or ""
    local img = {jpg=1, jpeg=1, png=1, gif=1, webp=1, svg=1, bmp=1, ico=1}
    local vid = {mp4=1, mkv=1, webm=1, mov=1, avi=1, flv=1, m4v=1, ts=1}
    local aud = {mp3=1, wav=1, ogg=1, flac=1, m4a=1, aac=1, wma=1}
    local doc = {pdf=1, doc=1, docx=1, xls=1, xlsx=1, ppt=1, pptx=1, txt=1, rtf=1, odt=1}
    local arc = {zip=1, rar=1, ["7z"]=1, tar=1, gz=1, bz2=1, xz=1, apk=1, ipk=1}
    local code = {html=1, css=1, js=1, json=1, sh=1, py=1, lua=1, xml=1, md=1, c=1, cpp=1, h=1, conf=1, log=1, bat=1}

    if img[ext] then return "image", ext end
    if vid[ext] then return "video", ext end
    if aud[ext] then return "audio", ext end
    if doc[ext] then return "document", ext end
    if arc[ext] then return "archive", ext end
    if code[ext] then return "code", ext end
    return "file", ext
end

-- Resolve file across eMMC, Overlay, Public_Share, and Phone WebDAV
local function resolve_file(subfolder, name)
    local sub = clean_path(subfolder or "")
    local n = clean_filename(name)
    if not n then return nil, nil end

    local cdir = STORAGE .. (sub ~= "" and (sub .. "/") or "")
    local path = cdir .. n
    local st = fs.stat(path)
    if st and st.type == "dir" then return path, "DIR" end
    local f = io.open(path, "rb")
    if f then return path, f end

    -- Tier 2: Check alternative storage
    local alt_storage = (STORAGE == PRIMARY_STORAGE) and FALLBACK_STORAGE or PRIMARY_STORAGE
    local alt_path = alt_storage .. (sub ~= "" and (sub .. "/") or "") .. n
    local alt_st = fs.stat(alt_path)
    if alt_st and alt_st.type == "dir" then return alt_path, "DIR" end
    f = io.open(alt_path, "rb")
    if f then return alt_path, f end

    -- Tier 3: Check Public_Share fallback
    if sub ~= "Public_Share" then
        local pub_path = STORAGE .. "Public_Share/" .. n
        local pub_st = fs.stat(pub_path)
        if pub_st and pub_st.type == "dir" then return pub_path, "DIR" end
        f = io.open(pub_path, "rb")
        if f then return pub_path, f end
    end

    -- Tier 4: Multi-Phone Enterprise Cluster WebDAV redirect
    if sub == "Phone_NAS_512GB" or sub:match("^Phone_") or sub:match("^Phones/") then
        local target_ip, target_port, target_folder, target_user, target_pass
        local raw_phone_path = sub:gsub("^Phones/", ""):gsub("^Phone_", "")
        local phone_slug = raw_phone_path:match("^([^/]+)") or raw_phone_path
        local phone_sub = raw_phone_path:match("^[^/]+/(.+)$") or ""

        uci:foreach("nas_phone", "phone_node", function(s)
            local s_slug = (s.name or s.ip or ""):gsub("[^%w_%-]", "_")
            local s_ip_clean = (s.ip or ""):gsub("%.", "_")
            if phone_slug == s_slug or (s.ip and phone_slug:find(s_ip_clean, 1, true)) or (s.ip and sub:find(s.ip, 1, true)) then
                target_ip = s.ip
                target_port = s.port or "8080"
                target_folder = s.folder or ""
                target_user = s.user
                target_pass = s.pass
                return false
            end
        end)
        if not target_ip then
            target_ip = uci_get("nas_phone.settings.phone_ip", "192.168.1.131")
            target_port = uci_get("nas_phone.settings.phone_port", "8080")
            target_folder = uci_get("nas_phone.settings.phone_folder", "")
            target_user = uci_get("nas_phone.settings.phone_user", "")
            target_pass = uci_get("nas_phone.settings.phone_pass", "")
        end

        local ping_test = os.execute("ping -c 1 -W 1 '" .. target_ip .. "' >/dev/null 2>&1")
        if ping_test == 0 then
            local auth_str = ""
            if target_user and target_user ~= "" and target_pass and target_pass ~= "" then
                auth_str = target_user .. ":" .. target_pass .. "@"
            end
            local full_path = n
            if phone_sub ~= "" then
                full_path = phone_sub .. "/" .. n
            end
            local enc_path = full_path:gsub("([^%w%-%_%.%~%/])", function(c) return string.format("%%%02X", string.byte(c)) end)
            return string.format("http://%s%s:%s/%s", auth_str, target_ip, target_port, enc_path), "REDIRECT"
        end
    end

    -- Tier 5: Cloud Archival Fallback (Khi tá»‡p tin Camera_NAS Ä‘Ã£ Ä‘Æ°á»£c Ä‘áº©y lÃªn Google Drive vÃ  xÃ³a khá»i eMMC)
    if (sub:find("Camera_NAS") or n:match("^Clip_") or sub:find("Camera_")) and fs.stat("/usr/bin/rclone") then
        local p_rem = io.popen("uci -q get camera.settings.cloud_remote")
        local cam_remote = p_rem and p_rem:read("*l") or "cloud_doantptlam011205_gmail_com"
        if p_rem then p_rem:close() end
        local p_fld = io.popen("uci -q get camera.settings.cloud_folder")
        local cam_folder = p_fld and p_fld:read("*l") or "Camera_Cloud"
        if p_fld then p_fld:close() end

        local rel_sub = sub:gsub("^Camera_NAS/?", "")
        local remote_file = string.format("%s:%s/%s%s", cam_remote, cam_folder, rel_sub ~= "" and (rel_sub .. "/") or "", n)
        local p_chk = io.popen(string.format("/usr/bin/rclone size '%s' 2>/dev/null", remote_file:gsub("'", "'\\''")))
        local chk_out = p_chk and p_chk:read("*a") or ""
        if p_chk then p_chk:close() end
        if chk_out:find("Total objects: 1") or chk_out:find("Total size:") then
            return remote_file, "CLOUD_STREAM"
        end
    end

    return nil, nil
end

local function is_remote_client()
    local host = os.getenv("HTTP_HOST") or ""
    local remote_addr = os.getenv("REMOTE_ADDR") or ""
    if host:find("ts%.net") or host:find("trycloudflare%.com") or host:find("cloudflare") then
        return true
    end
    if not remote_addr:match("^192%.168%.") and not remote_addr:match("^127%.") and remote_addr ~= "" then
        return true
    end
    if host:match("^100%.") or remote_addr:match("^100%.") then
        return true
    end
    return false
end

-- Ultra-Fast Proxy Streaming for Phone NAS WebDAV (Bypass LAN unreachable barrier for WAN/5G clients)
local function stream_remote_url(url, name, is_view)
    local ext = name:match("%.([^%.]+)$")
    ext = ext and ext:lower() or ""
    local content_type = mimes[ext] or "application/octet-stream"
    local disposition = is_view and "inline" or "attachment"

    local range_header = os.getenv("HTTP_RANGE")
    if not range_header or #range_header == 0 then
        local qs = os.getenv("QUERY_STRING") or ""
        local r_val = qs:match("[?&]range=([^&]+)") or qs:match("[?&]bytes=([^&]+)") or qs:match("^range=([^&]+)") or qs:match("^bytes=([^&]+)")
        if r_val then
            if not r_val:find("^bytes=") then
                range_header = "bytes=" .. r_val
            else
                range_header = r_val
            end
        end
    end
    local req_method = os.getenv("REQUEST_METHOD") or "GET"

    local curl_cmd = "curl -s -k --tcp-nodelay --buffer -m 7200"
    if req_method == "HEAD" then
        curl_cmd = curl_cmd .. " -I"
    end
    if range_header and #range_header > 0 then
        local r = range_header:gsub("^bytes=", "")
        curl_cmd = curl_cmd .. " -r '" .. r:gsub("'", "") .. "'"
    end
    curl_cmd = curl_cmd .. " -D - '" .. url:gsub("'", "'\\''") .. "'"

    local p = io.popen(curl_cmd, "r")
    if not p then
        print("Status: 502 Bad Gateway\r\nContent-Type: text/plain\r\n\r\nFailed to reach Phone NAS")
        return
    end

    local status_line = "Status: 200 OK"
    local headers_done = false
    while not headers_done do
        local line = p:read("*l")
        if not line or line == "" or line == "\r" then
            headers_done = true
        else
            line = line:gsub("[\r\n]", "")
            if line:match("^HTTP/%d+%.%d+%s+(%d+)") then
                local code = line:match("^HTTP/%d+%.%d+%s+(%d+)")
                if code == "206" then
                    status_line = "Status: 206 Partial Content"
                elseif code == "200" then
                    status_line = "Status: 200 OK"
                else
                    status_line = "Status: " .. code
                end
            elseif line:match("^Content%-Length:") or line:match("^Content%-Range:") or line:match("^Accept%-Ranges:") then
                print(line .. "\r")
            end
        end
    end

    print(status_line .. "\r")
    print("Content-Type: " .. content_type .. "\r")
    print("Content-Disposition: " .. disposition .. "; filename=\"" .. name .. "\"\r")
    print("X-Content-Type-Options: nosniff\r")
    print("Cache-Control: public, max-age=3600\r\n\r")

    if req_method ~= "HEAD" then
        while true do
            local chunk = p:read(262144)
            if not chunk or #chunk == 0 then break end
            io.write(chunk)
        end
        io.flush()
    end
    p:close()
end

local function stream_dir(path, name)
    local archive_name = (name or "archive") .. ".tar.gz"
    print("Content-Type: application/gzip\r")
    print("Content-Disposition: attachment; filename=\"" .. archive_name .. "\"\r")
    print("X-Content-Type-Options: nosniff\r")
    print("Cache-Control: no-cache\r\n\r")
    local parent_dir = path:match("^(.*)/[^/]+$") or "/"
    local dir_name = path:match("/([^/]+)$") or path
    local p = io.popen(string.format("tar -cz -C '%s' '%s' 2>/dev/null", parent_dir, dir_name))
    if p then
        while true do
            local chunk = p:read(262144)
            if not chunk then break end
            io.write(chunk)
        end
        io.flush()
        p:close()
    end
end

local function stream_cloud_file(remote_target, name, is_view)
    local ext = name:match("%.([^%.]+)$")
    ext = ext and ext:lower() or ""
    local content_type = mimes[ext] or "application/octet-stream"
    local disposition = is_view and "inline" or "attachment"

    local p_sz = io.popen(string.format("/usr/bin/rclone size '%s' 2>/dev/null | grep 'Total size:' | awk '{print $3}'", remote_target:gsub("'", "'\\''")))
    local sz_bytes = p_sz and p_sz:read("*l") or ""
    if p_sz then p_sz:close() end
    sz_bytes = (sz_bytes or ""):gsub("[^0-9]", "")

    print("Status: 200 OK\r")
    print("Content-Type: " .. content_type .. "\r")
    print("Content-Disposition: " .. disposition .. "; filename=\"" .. name .. "\"\r")
    if sz_bytes ~= "" and tonumber(sz_bytes) and tonumber(sz_bytes) > 0 then
        print("Content-Length: " .. sz_bytes .. "\r")
    end
    print("X-Content-Type-Options: nosniff\r")
    print("Cache-Control: public, max-age=3600\r\n\r")

    local req_method = os.getenv("REQUEST_METHOD") or "GET"
    if req_method ~= "HEAD" then
        local p = io.popen(string.format("/usr/bin/rclone cat '%s' 2>/dev/null", remote_target:gsub("'", "'\\''")))
        if p then
            while true do
                local chunk = p:read(262144)
                if not chunk or #chunk == 0 then break end
                io.write(chunk)
            end
            io.flush()
            p:close()
        end
    end
end

-- Stream file with Range Partial Content support
local function stream_file(f, path, name, is_view)
    f:seek("end")
    local size = f:seek()
    f:seek("set", 0)

    local ext = name:match("%.([^%.]+)$")
    ext = ext and ext:lower() or ""
    local content_type = mimes[ext] or "application/octet-stream"
    local disposition = is_view and "inline" or "attachment"

    local req_method = os.getenv("REQUEST_METHOD") or "GET"
    if req_method == "HEAD" then
        print("Status: 200 OK\r")
        print("Content-Type: " .. content_type .. "\r")
        print("Content-Disposition: " .. disposition .. "; filename=\"" .. name .. "\"\r")
        print("Content-Length: " .. size .. "\r")
        print("Accept-Ranges: bytes\r\n\r")
        f:close()
        return
    end

    local range_header = os.getenv("HTTP_RANGE")
    if not range_header then
        local qs = os.getenv("QUERY_STRING") or ""
        local r_val = qs:match("[?&]range=([^&]+)") or qs:match("[?&]bytes=([^&]+)") or qs:match("^range=([^&]+)") or qs:match("^bytes=([^&]+)")
        if r_val then
            if not r_val:find("^bytes=") then
                range_header = "bytes=" .. r_val
            else
                range_header = r_val
            end
        end
    end
    if range_header then
        local r_start, r_end = range_header:match("bytes=(%d+)%-(%d*)")
        if r_start then
            r_start = tonumber(r_start)
            r_end = tonumber(r_end) or (size - 1)
            if r_end >= size then r_end = size - 1 end
            local length = r_end - r_start + 1

            print("Status: 206 Partial Content\r")
            print("Content-Type: " .. content_type .. "\r")
            print("Content-Disposition: " .. disposition .. "; filename=\"" .. name .. "\"\r")
            print(string.format("Content-Range: bytes %d-%d/%d\r", r_start, r_end, size))
            print("Content-Length: " .. length .. "\r")
            print("Accept-Ranges: bytes\r")
            print("X-Content-Type-Options: nosniff\r")
            print("Cache-Control: public, max-age=86400\r\n\r")

            f:seek("set", r_start)
            local remaining = length
            while remaining > 0 do
                local read_len = math.min(262144, remaining)
                local chunk = f:read(read_len)
                if not chunk then break end
                io.write(chunk)
                remaining = remaining - #chunk
            end
            io.flush()
            f:close()
            return
        end
    end

    print("Content-Type: " .. content_type .. "\r")
    print("Content-Disposition: " .. disposition .. "; filename=\"" .. name .. "\"\r")
    print("Content-Length: " .. size .. "\r")
    print("Accept-Ranges: bytes\r")
    print("X-Content-Type-Options: nosniff\r")
    print("Cache-Control: public, max-age=86400\r\n\r")

    while true do
        local chunk = f:read(262144)
        if not chunk then break end
        io.write(chunk)
    end
    io.flush()
    f:close()
end

-- ==============================================================================
-- SELF-EXPIRING SHARES DATABASE HELPERS
-- ==============================================================================
local function load_shares()
    local f = io.open(SHARES_FILE, "r")
    if not f then f = io.open("/overlay/airdrop/.shares.json", "r") end
    if not f then return {} end
    local content = f:read("*a")
    f:close()
    if not content or #content == 0 then return {} end
    local shares = {}
    for item in content:gmatch("%b{}") do
        local token = item:match('"token"%s*:%s*"([^"]+)"')
        local name = item:match('"name"%s*:%s*"([^"]+)"')
        local folder = item:match('"folder"%s*:%s*"([^"]*)"') or ""
        local size = tonumber(item:match('"size"%s*:%s*(%d+)')) or 0
        local size_str = item:match('"size_str"%s*:%s*"([^"]+)"') or ""
        local created_at = tonumber(item:match('"created_at"%s*:%s*(%d+)')) or 0
        local expires_at = tonumber(item:match('"expires_at"%s*:%s*(%d+)')) or 0
        local downloads = tonumber(item:match('"downloads"%s*:%s*(%d+)')) or 0
        if token and name then
            shares[token] = {
                token = token, name = name, folder = folder,
                size = size, size_str = size_str,
                created_at = created_at, expires_at = expires_at,
                downloads = downloads
            }
        end
    end
    return shares
end

local function save_shares(shares)
    local items = {}
    local now = os.time()
    for _, s in pairs(shares) do
        if s.expires_at == 0 or s.expires_at > now then
            table.insert(items, string.format(
                '{"token":"%s","name":"%s","folder":"%s","size":%d,"size_str":"%s","created_at":%d,"expires_at":%d,"downloads":%d}',
                s.token, s.name:gsub('"', '\\"'), (s.folder or ""):gsub('"', '\\"'),
                s.size or 0, s.size_str or "", s.created_at or 0, s.expires_at or 0, s.downloads or 0
            ))
        end
    end
    local content = "[\n  " .. table.concat(items, ",\n  ") .. "\n]"
    local f = io.open(SHARES_FILE, "w")
    if not f then f = io.open("/overlay/airdrop/.shares.json", "w") end
    if f then
        f:write(content)
        f:close()
    end
end

-- ==============================================================================
-- UNIVERSAL 5-TIER NETWORK ENDPOINT RESOLVER (MULTI-ROUTER & MULTI-ACCOUNT)
-- ==============================================================================
local function get_network_endpoints()
    -- Tailscale Private IP & Domain Detection
    local ts_ip = ""
    local ts_dns = ""
    local p_ts = io.popen("tailscale status --json 2>/dev/null")
    if p_ts then
        local raw = p_ts:read("*a")
        p_ts:close()
        if raw and #raw > 0 then
            local self_dns = raw:match('"Self"%s*:%s*{.-"DNSName"%s*:%s*"([^"]+)"')
            if not self_dns then
                self_dns = raw:match('"DNSName"%s*:%s*"([^"]+)"')
            end
            if self_dns and #self_dns > 0 then
                ts_dns = self_dns:gsub("%.$", "")
            end

            local self_ip = raw:match('"Self"%s*:%s*{.-"TailscaleIPs"%s*:%s*%[%s*"([^"]+)"')
            if not self_ip then
                self_ip = raw:match('"TailscaleIPs"%s*:%s*%[%s*"([^"]+)"')
            end
            if self_ip and self_ip:match("^%d+%.%d+%.%d+%.%d+$") then
                ts_ip = self_ip
            end
        end
    end

    if not ts_ip or ts_ip == "" then
        local p_ip = io.popen("tailscale ip -4 2>/dev/null")
        local tip = p_ip and p_ip:read("*l")
        if p_ip then p_ip:close() end
        if tip and tip:match("^%d+%.%d+%.%d+%.%d+$") then ts_ip = tip end
    end
    if not ts_ip or ts_ip == "" then ts_ip = "127.0.0.1" end
    if ts_ip and ts_ip ~= "127.0.0.1" then
        os.execute("ip addr add '" .. ts_ip .. "/32' dev lo 2>/dev/null")
    end

    -- IPv6 WAN Public IP Detection (For Direct 100% 5G Speed)
    local ipv6_wan = ""
    local p_ip6 = io.popen("ip -6 addr show scope global 2>/dev/null | grep inet6 | grep -v 'scope link' | head -n 1 | sed -e 's/^[ ]*inet6 //' -e 's/\\/.*$//'")
    if p_ip6 then
        local ip6 = p_ip6:read("*l")
        p_ip6:close()
        if ip6 and ip6:match("^[0-9a-fA-F:]+$") and not ip6:match("^fe80") and not ip6:match("^fc") and not ip6:match("^fd") then
            ipv6_wan = ip6
        end
    end

    -- 1. Check user-defined custom domain in UCI (settings.public_domain)
    local cfg_domain = io.popen("uci -q get nas_phone.settings.public_domain"):read("*l") or ""
    if cfg_domain and #cfg_domain > 0 then
        local raw_host = cfg_domain:gsub("^https?://", ""):gsub("/.*$", ""):gsub(":%d+$", "")
        local is_private_ip = raw_host:match("^192%.168%.") or raw_host:match("^127%.") or raw_host:match("^10%.") or raw_host:match("^100%.") or raw_host:match("^172%.1[6-9]%.") or raw_host:match("^172%.2[0-9]%.") or raw_host:match("^172%.3[0-1]%.")
        if not is_private_ip then
            local has_https = (cfg_domain:match("^https://") ~= nil)
            cfg_domain = cfg_domain:gsub("^https?://", ""):gsub("/.*$", "")
            local is_custom_https = has_https or not (cfg_domain:find(":") or cfg_domain:match("^%d+%.%d+%.%d+%.%d+$"))
            local proto = is_custom_https and "https://" or "http://"
            return ts_ip, proto .. cfg_domain, ipv6_wan
        end
    end

    -- 2. Check Active Cloudflare Tunnel (Permanent Named Tunnel or Quick Tunnel)
    local cf_url = ""
    local is_cf_running = false
    local p_chk = io.popen("pgrep -f 'cloudflared.*(8080|run)' 2>/dev/null")
    if p_chk then
        local pid_str = p_chk:read("*l")
        p_chk:close()
        if pid_str and #pid_str > 0 then
            is_cf_running = true
        end
    end

    if is_cf_running then
        local f_cf = io.open("/tmp/cf_nas_url", "r")
        if f_cf then
            cf_url = f_cf:read("*l") or ""
            f_cf:close()
        end
    else
        os.remove("/tmp/cf_nas_url")
    end

    -- Auto-start nas_tunnel service if binary exists and not yet running
    if (not cf_url or #cf_url == 0) and fs.stat("/usr/bin/cloudflared") then
        os.execute("/etc/init.d/nas_tunnel start >/dev/null 2>&1 &")
        for _ = 1, 8 do
            nixio.nanosleep(1, 0)
            local f = io.open("/tmp/cf_nas_url", "r")
            if f then
                cf_url = f:read("*l") or ""
                f:close()
                if cf_url and #cf_url > 0 then break end
            end
            local p = io.popen("grep -oE 'https://[a-zA-Z0-9.-]+\\.trycloudflare\\.com' /tmp/cf_nas.log 2>/dev/null | head -n 1")
            if p then
                local u = p:read("*l") or ""
                p:close()
                if u and #u > 0 then
                    cf_url = u
                    local fw = io.open("/tmp/cf_nas_url", "w")
                    if fw then fw:write(cf_url .. "\n"); fw:close() end
                    break
                end
            end
        end
    end
    if cf_url and #cf_url > 0 then
        return ts_ip, cf_url:gsub("/+$", ""), ipv6_wan
    end

    -- 3. Dynamic HTTP_HOST Detection (Reverse Proxy / Port Forward / DDNS)
    local http_host = os.getenv("HTTP_HOST") or ""
    if http_host ~= "" and not http_host:match("^192%.168%.") and not http_host:match("^127%.") and not http_host:match("^10%.") and not http_host:match("^172%.1[6-9]%.") and not http_host:match("^172%.2[0-9]%.") and not http_host:match("^172%.3[0-1]%.") then
        local is_https = (os.getenv("HTTPS") == "on" or os.getenv("HTTP_X_FORWARDED_PROTO") == "https" or http_host:find("%.ts%.net$") ~= nil or http_host:find("%.trycloudflare%.com$") ~= nil)
        local proto = is_https and "https://" or "http://"
        return ts_ip, proto .. http_host, ipv6_wan
    end

    -- 4. Tailscale Funnel Detection (Public Global Access 0Ä‘ with HTTPS SSL)
    if ts_dns and #ts_dns > 0 and ts_dns:find("%.ts%.net$") then
        return ts_ip, "https://" .. ts_dns, ipv6_wan
    end

    -- 5. Fallback: Dynamic Tailscale Node IP (DÃ nh cho thiáº¿t bá»‹ trong máº¡ng Tailnet)
    if ts_ip and ts_ip ~= "127.0.0.1" then
        return ts_ip, "http://" .. ts_ip .. ":8080", ipv6_wan
    end

    -- 6. Dynamic Public WAN IP Detection (For routers with direct public IP)
    local p_wan = io.popen("curl -s --connect-timeout 2 https://api.ipify.org 2>/dev/null")
    local wan_ip = p_wan and p_wan:read("*l")
    if p_wan then p_wan:close() end
    if wan_ip and wan_ip:match("^%d+%.%d+%.%d+%.%d+$") then
        return ts_ip, "http://" .. wan_ip .. ":8080", ipv6_wan
    end

    -- 6. Fallback to Local Router LAN IP (from UCI network.lan)
    local p_lan = io.popen("uci -q get network.lan.ipaddr")
    local lan_ip = p_lan and p_lan:read("*l") or "192.168.1.1"
    if p_lan then p_lan:close() end
    lan_ip = (lan_ip or "192.168.1.1"):gsub("/.*$", "")
    return ts_ip, "http://" .. lan_ip .. ":8080", ipv6_wan
end

local q = get_query()
local action = q.action or "list"

local subfolder = clean_path(q.folder or "")
local current_dir = STORAGE
if subfolder ~= "" then
    current_dir = STORAGE .. subfolder .. "/"
    fs.mkdirr(current_dir)
end

-- ==============================================================================
-- SHARE ENGINE: CREATE, LIST, REVOKE & PUBLIC LANDING
-- ==============================================================================
if action == "create_share" then
    local name = clean_filename(q.name)
    local folder = clean_path(q.folder or "")
    local hours = tonumber(q.hours) or 24
    if not name then
        print("Status: 400 Bad Request\r\nContent-Type: text/plain\r\n\r\nThieu ten tep")
        return
    end

    local path, f = resolve_file(folder, name)
    if not f then
        print("Status: 404 Not Found\r\nContent-Type: text/plain\r\n\r\nTep khong ton tai")
        return
    end

    local size = 0
    if f ~= "REDIRECT" and f ~= "DIR" then
        f:seek("end")
        size = f:seek()
        f:close()
    end

    math.randomseed(os.time() + (tonumber(tostring(os.clock()):match("%d+$")) or 1234))
    local token = string.format("%04x%04x", math.random(0x1000, 0xffff), math.random(0x1000, 0xffff))
    local now = os.time()
    local expires_at = (hours > 0) and (now + hours * 3600) or 0

    local shares = load_shares()
    shares[token] = {
        token = token, name = name, folder = folder,
        size = size, size_str = format_bytes(size),
        created_at = now, expires_at = expires_at,
        downloads = 0
    }
    save_shares(shares)

    local expires_str = (hours > 0) and os.date("%H:%M %d/%m/%Y", expires_at) or "VÄ©nh viá»…n"
    local remaining_str = (hours > 0) and string.format("%d giá»", hours) or "VÄ©nh viá»…n"

    -- Dynamic Network endpoints
    local p_lan = io.popen("uci -q get network.lan.ipaddr")
    local lan_ip = p_lan and p_lan:read("*l") or "192.168.1.1"
    if p_lan then p_lan:close() end
    lan_ip = (lan_ip or "192.168.1.1"):gsub("/.*$", "")

    local ts_ip, funnel_base, ipv6_wan = get_network_endpoints()
    local funnel_share_url = funnel_base .. "/cgi-bin/airdrop?action=share&token=" .. token
    local local_share_url = "http://" .. lan_ip .. ":8080/cgi-bin/airdrop?action=share&token=" .. token
    local remote_share_url = "http://" .. ts_ip .. ":8080/cgi-bin/airdrop?action=share&token=" .. token
    local ipv6_share_url = (ipv6_wan and #ipv6_wan > 0) and ("http://[" .. ipv6_wan .. "]:8080/cgi-bin/airdrop?action=share&token=" .. token) or ""
    local direct_dl_url = "/cgi-bin/airdrop?action=share&token=" .. token .. "&download=1"

    print("Content-Type: application/json\r\nCache-Control: no-cache\r\n\r")
    print(string.format('{"ok":true,"status":"OK","token":"%s","name":"%s","folder":"%s","size_str":"%s","expires_at":%d,"expires_str":"%s","remaining_str":"%s","hours":%d,"share_url":"%s","funnel_share_url":"%s","ipv6_share_url":"%s","local_share_url":"%s","remote_share_url":"%s","direct_dl_url":"%s"}',
        token, name:gsub('"', '\\"'), folder:gsub('"', '\\"'), format_bytes(size), expires_at, expires_str, remaining_str, hours, funnel_share_url, funnel_share_url, ipv6_share_url, local_share_url, remote_share_url, direct_dl_url))
    return
end

if action == "list_shares" then
    local p_lan = io.popen("uci -q get network.lan.ipaddr")
    local lan_ip = p_lan and p_lan:read("*l") or "192.168.1.1"
    if p_lan then p_lan:close() end
    lan_ip = (lan_ip or "192.168.1.1"):gsub("/.*$", "")

    local ts_ip, funnel_base, ipv6_wan = get_network_endpoints()
    local shares = load_shares()
    save_shares(shares) -- auto-purges expired
    local now = os.time()
    local list = {}
    for _, s in pairs(shares) do
        local rem_sec = (s.expires_at > 0) and math.max(0, s.expires_at - now) or -1
        local rem_str = "VÄ©nh viá»…n"
        local is_exp = false
        if rem_sec > 0 then
            local rh = math.floor(rem_sec / 3600)
            local rm = math.floor((rem_sec % 3600) / 60)
            rem_str = string.format("%d giá» %d phÃºt", rh, rm)
        elseif rem_sec == 0 then
            rem_str = "ÄÃ£ háº¿t háº¡n"
            is_exp = true
        end
        local item_funnel = funnel_base .. "/cgi-bin/airdrop?action=share&token=" .. s.token
        local item_local = "http://" .. lan_ip .. ":8080/cgi-bin/airdrop?action=share&token=" .. s.token
        local item_remote = "http://" .. ts_ip .. ":8080/cgi-bin/airdrop?action=share&token=" .. s.token
        local item_ipv6 = (ipv6_wan and #ipv6_wan > 0) and ("http://[" .. ipv6_wan .. "]:8080/cgi-bin/airdrop?action=share&token=" .. s.token) or ""
        table.insert(list, string.format(
            '{"token":"%s","name":"%s","folder":"%s","size":%d,"size_str":"%s","created_at":%d,"expires_at":%d,"remaining_sec":%d,"remaining_str":"%s","is_expired":%s,"downloads":%d,"funnel_url":"%s","ipv6_url":"%s","remote_url":"%s","local_url":"%s"}',
            s.token, s.name:gsub('"', '\\"'), (s.folder or ""):gsub('"', '\\"'),
            s.size, s.size_str, s.created_at, s.expires_at, rem_sec, rem_str, is_exp and "true" or "false", s.downloads or 0,
            item_funnel, item_ipv6, item_remote, item_local
        ))
    end
    print("Content-Type: application/json\r\nCache-Control: no-cache\r\n\r")
    print('{"ok":true,"shares":[' .. table.concat(list, ",") .. ']}')
    return
end

if action == "revoke_share" then
    local token = q.token
    if token and token ~= "" then
        local shares = load_shares()
        shares[token] = nil
        save_shares(shares)
        print("Content-Type: application/json\r\n\r\n{\"ok\":true,\"status\":\"OK\",\"message\":\"ÄÃ£ há»§y liÃªn káº¿t chia sáº» thÃ nh cÃ´ng!\"}")
    else
        print("Status: 400 Bad Request\r\nContent-Type: text/plain\r\n\r\nThieu token")
    end
    return
end

