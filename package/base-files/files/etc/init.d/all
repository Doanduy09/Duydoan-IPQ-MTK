    chmod +x /usr/bin/send_daily_morning_report.sh

    cat << 'RAM_WATCHDOG_EOF' > /usr/bin/ram_watchdog.sh
#!/bin/sh
# ==============================================================================
# ROUTER AUTONOMOUS UNIFIED SELF-HEALING SUPERVISOR & MEMORY OPTIMIZER
# Tự động giám sát nhịp tim và phục hồi các dịch vụ cốt lõi (dnsmasq, dropbear, bot, nas)
# Tự động giải phóng cache khi RAM > 60%, đưa RAM về mức tinh khôi 35-40% 24/7
# Ring-Buffer 128KB cho mọi file log, triệt tiêu 100% rò rỉ bộ nhớ & tiến trình zombie
# ==============================================================================

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export TZ=Asia/Ho_Chi_Minh

# 0. Singleton Guard: Đảm bảo chỉ 1 bản sao Supervisor hoạt động
LOCK_FILE="/var/run/ram_watchdog.lock"
if [ "$1" != "status" ] && [ "$1" != "zram-status" ]; then
    exec 202>"$LOCK_FILE"
    if ! flock -n 202; then
        exit 0
    fi
fi

TOTAL=$(awk '/MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null)
AVAIL=$(awk '/MemAvailable:/ {print $2}' /proc/meminfo 2>/dev/null)

[ -z "$TOTAL" ] || [ "$TOTAL" -le 0 ] && exit 0
[ -z "$AVAIL" ] && AVAIL=$(awk '/MemFree:/ {print $2}' /proc/meminfo 2>/dev/null)

USED=$(( TOTAL - AVAIL ))
USED_PCT=$(( USED * 100 / TOTAL ))

mkdir -p /tmp/fast_state 2>/dev/null
find /tmp/fast_state/ -name "*.tmp*" -mmin +5 -delete 2>/dev/null

# 1. TỰ ĐỘNG THU HỒI CACHE RAM KHI VƯỢT QUÁ 88%
if [ "$USED_PCT" -ge 88 ]; then
    sync
    echo 3 > /proc/sys/vm/drop_caches
    
    NEW_AVAIL=$(awk '/MemAvailable:/ {print $2}' /proc/meminfo 2>/dev/null)
    NEW_USED=$(( TOTAL - NEW_AVAIL ))
    NEW_PCT=$(( NEW_USED * 100 / TOTAL ))
    FREED_MB=$(( (NEW_AVAIL - AVAIL) / 1024 ))
    [ "$FREED_MB" -lt 0 ] && FREED_MB=0
    
    echo "$(date '+%Y-%m-%d %H:%M:%S'): [SUPERVISOR] Tự nhận biết RAM ${USED_PCT}% -> Đã thu hồi ${FREED_MB}MB cache, đưa RAM về ${NEW_PCT}%." >> /tmp/ram_watchdog.log
fi

# 2. TỰ ĐỘNG DỌN SẠCH CÁC TỆP TẠM LỚN (> 3MB) KHỎI TMPFS
for bigf in /tmp/*.zip /tmp/*.apk /tmp/*.tar* /tmp/*.ipk /tmp/*.iso /tmp/rclone_arm64*; do
    [ ! -f "$bigf" ] && continue
    if echo "$bigf" | grep -q "\.apk$" && [ -d /mnt/storage/downloads ]; then
        mv -f "$bigf" /mnt/storage/downloads/ 2>/dev/null || rm -f "$bigf" 2>/dev/null
    else
        rm -f "$bigf" 2>/dev/null
    fi
done

# 2.5 VAN AN TOÀN TRÀN ĐỆM CAMERA NVR BUFFER (CHỐNG OOM CRASH)
if [ -d /tmp/cctv_ram_buffer ]; then
    nvr_buf_kb=$(du -s /tmp/cctv_ram_buffer 2>/dev/null | awk '{print $1}')
    [ -z "$nvr_buf_kb" ] && nvr_buf_kb=0
    ram_avail_kb=$(awk '/MemAvailable:/ {print $2}' /proc/meminfo 2>/dev/null || echo 500000)
    # Nếu buffer > 100MB (~102400KB) hoặc RAM khả dụng < 150MB:
    if [ "$nvr_buf_kb" -gt 102400 ] || [ "$ram_avail_kb" -lt 153600 ]; then
        if [ -d /mnt/storage ]; then
            mkdir -p /mnt/storage/cctv_cache 2>/dev/null
            find /tmp/cctv_ram_buffer -type f -name "*.mk[v4]" -mmin +5 -exec mv -f {} /mnt/storage/cctv_cache/ \; 2>/dev/null
            echo "$(date '+%Y-%m-%d %H:%M:%S'): [RAM_SENTINEL] Đã xả đệm NVR sang /mnt/storage/cctv_cache để bảo vệ RAM!" >> /tmp/ram_watchdog.log
        fi
    fi
fi

# 2.6 BẢO VỆ TIẾN TRÌNH CỐT LÕI KHỎI OOM-KILLER (oom_score_adj = -1000)
for proc_name in dnsmasq dropbear uhttpd rpcd device_guard_daemon.sh telegram_bot_daemon.sh fast_stats_fetcher.sh; do
    for p_id in $(pgrep -f "$proc_name" 2>/dev/null); do
        [ -w "/proc/$p_id/oom_score_adj" ] && echo -1000 > "/proc/$p_id/oom_score_adj" 2>/dev/null
    done
done

# 3. LOG RING-BUFFER 128KB (FIFO 250 DÒNG MỚI NHẤT) - CHỐNG TRÀN RAM 100%
for logf in /tmp/*.log /var/log/*.log; do
    [ ! -f "$logf" ] && continue
    lsize=$(wc -c < "$logf" 2>/dev/null || echo 0)
    if [ "$lsize" -gt 131072 ]; then
        tail -n 250 "$logf" > "${logf}.tmp.$$" 2>/dev/null && mv -f "${logf}.tmp.$$" "$logf" 2>/dev/null
    fi
done

# 4. ZERO-ZOMBIE PROCESS REAPING (THU DỌN TIẾN TRÌNH RÁC DEFUNCT)
zombie_pids=$(ps 2>/dev/null | grep -i "defunct" | grep -v grep | awk '{print $1}')
if [ -n "$zombie_pids" ]; then
    for z in $zombie_pids; do
        ppid=$(awk '{print $4}' /proc/$z/stat 2>/dev/null)
        if [ -n "$ppid" ] && [ "$ppid" -gt 1 ]; then
            kill -CHLD "$ppid" 2>/dev/null
        fi
    done
fi
wait 2>/dev/null

# 5. DỌN DẸP BẢN SAO TRÙNG LẶP CỦA CÁC TIẾN TRÌNH NỀN
for d_name in nas_phone_watchdog.sh auto_mesh game_booster.sh game_latency_monitor.sh; do
    p_list=$(pgrep -f "$d_name" 2>/dev/null | sort -n)
    p_cnt=$(echo "$p_list" | wc -w)
    if [ "$p_cnt" -gt 1 ]; then
        newest_p=$(echo "$p_list" | awk '{print $NF}')
        for p in $p_list; do
            if [ "$p" != "$newest_p" ] && [ "$p" != "$$" ]; then
                kill -9 "$p" 2>/dev/null
            fi
        done
        echo "$(date '+%Y-%m-%d %H:%M:%S'): [SUPERVISOR] Đã dọn dẹp các bản sao trùng lặp của $d_name." >> /tmp/ram_watchdog.log
    fi
done

# 6. HEARTBEAT VÀ TỰ PHỤC HỒI DỊCH VỤ CỐT LÕI (SELF-HEALING)
# Đóng FD 202 trước khi fork daemons để tránh rò rỉ khóa và triệt tiêu tiến trình Zombie
exec 202>&- 2>/dev/null

# 6.1 DNS & DHCP (dnsmasq)
if ! pgrep -x dnsmasq >/dev/null 2>&1 && ! pidof dnsmasq >/dev/null 2>&1; then
    echo "$(date '+%Y-%m-%d %H:%M:%S'): [SELF-HEAL] Phát hiện dnsmasq dừng hoạt động! Đang khởi động lại..." >> /tmp/ram_watchdog.log
    /etc/init.d/dnsmasq restart >/dev/null 2>&1
fi

# 6.2 SSH Server (dropbear)
if ! pgrep -x dropbear >/dev/null 2>&1 && ! pidof dropbear >/dev/null 2>&1; then
    echo "$(date '+%Y-%m-%d %H:%M:%S'): [SELF-HEAL] Phát hiện dropbear dừng hoạt động! Đang khởi động lại..." >> /tmp/ram_watchdog.log
    /etc/init.d/dropbear restart >/dev/null 2>&1
fi

# 6.3 AI Watchdog Daemon
if ! pgrep -f "ai_watchdog\.sh" >/dev/null 2>&1 && [ -x /usr/bin/ai_watchdog.sh ]; then
    nohup /usr/bin/ai_watchdog.sh >/dev/null 2>&1 &
fi

# 6.4 Telegram Bot Daemon
if ! pgrep -f "telegram_bot_daemon\.sh" >/dev/null 2>&1 && [ -x /usr/bin/telegram_bot_daemon.sh ]; then
    if [ -s /etc/config/telegram_bot.conf ] && grep -q '^TG_BOT_TOKEN=.\+' /etc/config/telegram_bot.conf 2>/dev/null; then
        nohup /usr/bin/telegram_bot_daemon.sh >/dev/null 2>&1 &
    fi
fi

# 6.5 Phone NAS Watchdog
if ! pgrep -f "nas_phone_watchdog\.sh" >/dev/null 2>&1 && [ -x /usr/bin/nas_phone_watchdog.sh ]; then
    nohup /usr/bin/nas_phone_watchdog.sh >/dev/null 2>&1 &
fi

# 6.6 CCTV Bot Daemon
if ! pgrep -f "cctv_bot_daemon\.sh" >/dev/null 2>&1 && [ -x /usr/bin/cctv_bot_daemon.sh ]; then
    /usr/bin/cctv_bot_daemon.sh start >/dev/null 2>&1 &
fi

# 6.7 Cloud Cam NVR Recorder Daemon
if ! pgrep -f "cloud_cam_recorder_daemon\.sh" >/dev/null 2>&1 && [ -x /usr/bin/cloud_cam_recorder_daemon.sh ]; then
    /usr/bin/cloud_cam_recorder_daemon.sh start >/dev/null 2>&1 &
fi

# 7. ADAPTIVE THERMAL GUARD (BẢO VỆ NHIỆT ĐỘ PHẦN CỨNG CHỦ ĐỘNG - KHÔNG NGẮT SÓNG MESH)
cpu_raw_temp=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || echo 0)
cpu_c=$(( cpu_raw_temp / 1000 ))
[ "$cpu_raw_temp" -lt 200 ] && cpu_c="$cpu_raw_temp"

if [ "$cpu_c" -gt 75 ]; then
    if [ ! -f /tmp/thermal_throttled ]; then
        touch /tmp/thermal_throttled
        echo "$(date '+%Y-%m-%d %H:%M:%S'): [THERMAL GUARD] Cảnh báo nhiệt độ CPU đạt ${cpu_c}°C (>75°C). Bảo vệ kết nối Mesh 2402 Mbps, kernel tự điều tiết xung nhịp." >> /tmp/ram_watchdog.log
    fi
elif [ "$cpu_c" -le 65 ] && [ -f /tmp/thermal_throttled ]; then
    rm -f /tmp/thermal_throttled
    echo "$(date '+%Y-%m-%d %H:%M:%S'): [THERMAL GUARD] Nhiệt độ CPU đã hạ về mức mát mẻ ${cpu_c}°C." >> /tmp/ram_watchdog.log
fi

# 8. ZERO-WEAR RAM STORAGE TIERING SYNC
if [ -d /tmp/airdrop_ram_cache ] && [ -d /mnt/storage/airdrop ]; then
    cached_files=$(find /tmp/airdrop_ram_cache/ -type f 2>/dev/null)
    if [ -n "$cached_files" ]; then
        cp -a /tmp/airdrop_ram_cache/* /mnt/storage/airdrop/ 2>/dev/null && rm -rf /tmp/airdrop_ram_cache/*
        sync
    fi
fi

# 9. OOM-KILLER IMMUNITY & KERNEL MEMORY PROTECTION (GÁN -1000 CHỐNG DIE TIẾN TRÌNH CỐT LÕI)
enforce_oom_immunity() {
    # 9.1 Bảo vệ bộ nhớ nhân Kernel (Heuristic Overcommit 0 an toàn tuyệt đối cho thiết bị nhúng 256MB/512MB RAM)
    sysctl -w vm.panic_on_oom=0 >/dev/null 2>&1
    sysctl -w vm.overcommit_memory=0 >/dev/null 2>&1
    sysctl -w vm.overcommit_ratio=85 >/dev/null 2>&1
    
    local min_free=8192
    [ "$TOTAL" -gt 400000 ] && min_free=16384
    [ "$TOTAL" -gt 800000 ] && min_free=32768
    sysctl -w vm.min_free_kbytes=$min_free >/dev/null 2>&1

    # 9.2 Miễn nhiễm OOM (-1000) cho các tiến trình sống còn của router
    for daemon_pat in dnsmasq dropbear netifd uhttpd fast_stats_fetcher telegram_bot_daemon airdrop_backend smart_modem_watchdog wan_failover_guard; do
        for p in $(pgrep -f "$daemon_pat" 2>/dev/null); do
            if [ -w "/proc/$p/oom_score_adj" ]; then
                echo -1000 > "/proc/$p/oom_score_adj" 2>/dev/null
            fi
        done
    done
}
enforce_oom_immunity

# 10. NIGHT ECO MODE HOOK (TỰ ĐỘNG KÍCH HOẠT CHẾ ĐỘ TIẾT KIỆM ĐIỆN VÀ HẠ NHIỆT BAN ĐÊM)
if [ -x /usr/bin/night_eco_daemon.sh ]; then
    /usr/bin/night_eco_daemon.sh check >/dev/null 2>&1 &
fi

# 11. ADAPTIVE ZRAM & SWAP MEMORY TIERING & KERNEL COMPACTION (CHỐNG TRÀN RAM 100%)
init_memory_tiering() {
    # 11.1 Dồn Nén và Gom Cụm Bộ Nhớ RAM Chống Phân Mảnh (Kernel Compaction)
    [ -w /proc/sys/vm/compact_memory ] && echo 1 > /proc/sys/vm/compact_memory 2>/dev/null
    [ -w /proc/sys/vm/compaction_proactiveness ] && sysctl -w vm.compaction_proactiveness=50 >/dev/null 2>&1

    local tot_ram_mb=$(free -m 2>/dev/null | awk '/Mem:/ {print $2}')
    [ -z "$tot_ram_mb" ] && tot_ram_mb=$(awk '/MemTotal:/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 1024)

    # ĐỐI VỚI ROUTER RAM >= 1.2GB (ASUS TUF-AX6000 2GB DDR4): CHẾ ĐỘ PURE DDR4 ZERO-SWAP
    if [ "$tot_ram_mb" -ge 1200 ]; then
        if grep -qE "swapfile|zram" /proc/swaps 2>/dev/null; then
            swapoff -a 2>/dev/null
        fi
        rm -f /mnt/storage/.swapfile 2>/dev/null
        sysctl -w vm.swappiness=0 >/dev/null 2>&1
        [ ! -x /usr/bin/rclone ] && for c in /mnt/storage/rclone /mnt/mmcblk0p27/rclone; do [ -x "$c" ] && ln -sf "$c" /usr/bin/rclone 2>/dev/null && break; done
        [ ! -x /usr/bin/ffmpeg ] && for c in /mnt/storage/bin/ffmpeg /mnt/mmcblk0p27/bin/ffmpeg; do [ -x "$c" ] && ln -sf "$c" /usr/bin/ffmpeg 2>/dev/null && break; done
        return 0
    fi

    # 11.2 Khởi tạo ZRAM Nén RAM Ảo Cho Thiết Bị RAM Thấp (< 1.2GB)
    if [ -e /sys/class/zram-control ]; then
        if [ -b /dev/zram0 ] && ! grep -q "zram0" /proc/swaps 2>/dev/null; then
            echo lz4 > /sys/block/zram0/comp_algorithm 2>/dev/null || echo lzo > /sys/block/zram0/comp_algorithm 2>/dev/null
            echo "256M" > /sys/block/zram0/disksize 2>/dev/null
            mkswap /dev/zram0 >/dev/null 2>&1
            swapon -p 100 /dev/zram0 2>/dev/null || swapon /dev/zram0 2>/dev/null
        fi
    fi

    # 11.3 Tầng Đệm Swap Trên Phân Vùng Lưu Trữ Thật (Chỉ chạy khi có ổ gắn ngoài / eMMC thật, tuyệt đối KHÔNG chạy trên Flash Overlay)
    if [ -w /sys/kernel/mm/lru_gen/enabled ]; then
        echo y > /sys/kernel/mm/lru_gen/enabled 2>/dev/null
    fi
    local st_dev=$(df -P /mnt/storage 2>/dev/null | awk 'NR==2 {print $1}')
    local st_free_kb=$(df -k /mnt/storage 2>/dev/null | awk 'NR==2 {print $4}')
    if [ -n "$st_dev" ] && [ "$st_dev" != "overlayfs:/overlay" ] && [ "$st_dev" != "rootfs" ] && [ "${st_free_kb:-0}" -gt 2097152 ]; then
        local target_swap_mb=1024
        local cur_swap_sz=0
        [ -f /mnt/storage/.swapfile ] && cur_swap_sz=$(du -m /mnt/storage/.swapfile 2>/dev/null | awk '{print $1}')
        if [ "$cur_swap_sz" -lt "$target_swap_mb" ]; then
            swapoff /mnt/storage/.swapfile 2>/dev/null
            dd if=/dev/zero of=/mnt/storage/.swapfile bs=1M count="$target_swap_mb" 2>/dev/null
            chmod 600 /mnt/storage/.swapfile 2>/dev/null
            mkswap /mnt/storage/.swapfile >/dev/null 2>&1
        fi
        if ! grep -q "/mnt/storage/.swapfile" /proc/swaps 2>/dev/null && [ -f /mnt/storage/.swapfile ]; then
            swapon -p 50 /mnt/storage/.swapfile 2>/dev/null
        fi
    fi
    [ ! -x /usr/bin/rclone ] && for c in /mnt/storage/rclone /mnt/mmcblk0p27/rclone; do [ -x "$c" ] && ln -sf "$c" /usr/bin/rclone 2>/dev/null && break; done
    [ ! -x /usr/bin/ffmpeg ] && for c in /mnt/storage/bin/ffmpeg /mnt/mmcblk0p27/bin/ffmpeg; do [ -x "$c" ] && ln -sf "$c" /usr/bin/ffmpeg 2>/dev/null && break; done

    # 11.4 Tự động quét và kích hoạt Swap trên USB / Ổ cứng cắm ngoài cho Router RAM thấp
    if ! grep -q "file" /proc/swaps 2>/dev/null; then
        for ext_mnt in /mnt/sda* /mnt/sdb* /mnt/usb* /media/*; do
            [ -d "$ext_mnt" ] || continue
            local free_kb
            free_kb=$(df -k "$ext_mnt" 2>/dev/null | awk 'NR==2 {print $4}')
            if [ -n "$free_kb" ] && [ "$free_kb" -gt 1048576 ] && ! grep -q "$ext_mnt/.swapfile" /proc/swaps 2>/dev/null; then
                if [ ! -f "$ext_mnt/.swapfile" ]; then
                    dd if=/dev/zero of="$ext_mnt/.swapfile" bs=1M count=512 2>/dev/null
                    chmod 600 "$ext_mnt/.swapfile" 2>/dev/null
                    mkswap "$ext_mnt/.swapfile" >/dev/null 2>&1
                fi
                if [ -f "$ext_mnt/.swapfile" ]; then
                    swapon -p 40 "$ext_mnt/.swapfile" 2>/dev/null
                    echo "$(date '+%Y-%m-%d %H:%M:%S'): [RAM_WATCHDOG] Đã tự động kích hoạt 512MB Swap trên USB ngoài $ext_mnt!" >> /tmp/ram_watchdog.log
                    break
                fi
            fi
        done
    fi

    sysctl -w vm.swappiness=20 >/dev/null 2>&1
}
init_memory_tiering

# 12. I/O BURST SCHEDULER & EMMC LONGEVITY GUARD
tune_emmc_io_scheduler() {
    for blk in /sys/block/mmcblk* /sys/block/nvme* /sys/block/sd*; do
        [ -d "$blk" ] || continue
        [ -w "$blk/queue/read_ahead_kb" ] && echo 2048 > "$blk/queue/read_ahead_kb" 2>/dev/null
        if [ -w "$blk/queue/scheduler" ]; then
            for sched in bfq mq-deadline deadline; do
                if grep -q "$sched" "$blk/queue/scheduler" 2>/dev/null; then
                    echo "$sched" > "$blk/queue/scheduler" 2>/dev/null
                    break
                fi
            done
        fi
    done
}
tune_emmc_io_scheduler

# 13. RUNAWAY & LEAKED PROCESS REAPER (Chống rò rỉ bộ nhớ ảo & crash)
reap_stale_memory_leaks() {
    # Dọn dẹp rclone authorize drive nếu tiến trình chạy quá 10 phút hoặc treo
    local rc_pids
    rc_pids=$(pgrep -f "rclone authorize" 2>/dev/null)
    if [ -n "$rc_pids" ]; then
        for pid in $rc_pids; do
            kill -9 "$pid" 2>/dev/null
        done
    fi
}
reap_stale_memory_leaks

# 14. ZERO-STALL MEMORY RECLAIM SHIELD (Triệt tiêu khựng RAM khi cấp phát bộ đệm mạng)
tune_zero_stall_memory_shield() {
    local mem_total_kb
    mem_total_kb=$(grep "^MemTotal:" /proc/meminfo 2>/dev/null | awk '{print $2}')
    if [ -n "$mem_total_kb" ] && [ "$mem_total_kb" -gt 262144 ]; then
        # Nâng min_free_kbytes lên 32MB để kswapd dọn dẹp trước khi RAM chạm đáy
        sysctl -w vm.min_free_kbytes=32768 >/dev/null 2>&1
        sysctl -w vm.watermark_scale_factor=200 >/dev/null 2>&1
    else
        sysctl -w vm.min_free_kbytes=16384 >/dev/null 2>&1
        sysctl -w vm.watermark_scale_factor=150 >/dev/null 2>&1
    fi
    sysctl -w vm.vfs_cache_pressure=50 >/dev/null 2>&1
    sysctl -w vm.dirty_background_ratio=5 >/dev/null 2>&1
    sysctl -w vm.dirty_ratio=15 >/dev/null 2>&1
}
tune_zero_stall_memory_shield

case "$1" in
    zram-status)
        swapon -s
        ;;
    mem-shield|zero-stall)
        tune_zero_stall_memory_shield
        echo "ZERO_STALL_MEMORY_SHIELD_ACTIVE"
        ;;
    status)
        echo "=== RAM WATCHDOG STATUS ==="
        free -m
        swapon -s
        ;;
    *)
        ;;
esac
RAM_WATCHDOG_EOF
    chmod +x /usr/bin/ram_watchdog.sh

    cat << 'WIFI_PRESENCE_EOF' > /usr/bin/wifi_presence.sh
#!/bin/sh
# 🏠 Athena Wi-Fi Family Presence CLI
FAMILY_CONF="/etc/config/family_members.conf"
STATE_FILE="/tmp/family_presence_state.json"

case "$1" in
    add)
        mac="$2"
        name="$3"
        role="${4:-Gia đình}"
        [ -z "$mac" ] || [ -z "$name" ] && echo "Cú pháp: wifi_presence.sh add <MAC> <Tên> [Vai trò]" && exit 1
        mac=$(echo "$mac" | tr '[:upper:]' '[:lower:]' | tr -d '\r\n ')
        mkdir -p /etc/config
        sed -i "/^${mac}|/Id" "$FAMILY_CONF" 2>/dev/null
        echo "${mac}|${name}|${role}|phone" >> "$FAMILY_CONF"
        echo "✅ Đã thêm ${name} (${mac}) vào danh bạ gia đình."
        /usr/bin/family_presence_daemon.sh check >/dev/null 2>&1 &
        ;;
    del|remove)
        mac="$2"
        [ -z "$mac" ] && echo "Cú pháp: wifi_presence.sh del <MAC>" && exit 1
        mac=$(echo "$mac" | tr '[:upper:]' '[:lower:]')
        sed -i "/^${mac}|/Id" "$FAMILY_CONF" 2>/dev/null
        echo "✅ Đã xóa ${mac} khỏi danh bạ gia đình."
        /usr/bin/family_presence_daemon.sh check >/dev/null 2>&1 &
        ;;
    list|status|"")
        if [ -x /usr/bin/family_presence_daemon.sh ]; then
            /usr/bin/family_presence_daemon.sh status
        elif [ -f "$STATE_FILE" ]; then
            cat "$STATE_FILE"
        else
            echo '{"status":"empty","members":[]}'
        fi
        ;;
    check)
        if [ -x /usr/bin/family_presence_daemon.sh ]; then
            /usr/bin/family_presence_daemon.sh check
        fi
        ;;
esac
WIFI_PRESENCE_EOF
    chmod +x /usr/bin/wifi_presence.sh

    cat << 'FAMILY_PRESENCE_EOF' > /usr/bin/family_presence_daemon.sh
#!/bin/sh
# 🏠 ATHENA FAMILY PRESENCE & WELCOME AUTOMATION DAEMON
# Tự động nhận diện thành viên gia đình (Ba Mẹ, Con Cái...) khi về nhà
# Lắng nghe sự kiện ubus và quét ARP không tốn CPU (< 0.05% CPU)
# Debounce 10 phút (600s) chống báo động giả khi điện thoại Deep Sleep
# Gửi tin nhắn Telegram chào mừng và phát lời chào qua loa TTS

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export TZ=Asia/Ho_Chi_Minh

LOCK_FILE="/var/lock/family_presence.lock"
exec 205>"$LOCK_FILE"
if ! flock -n 205; then
    exit 0
fi

FAMILY_CONF="/etc/config/family_members.conf"
NAMES_CONF="/etc/config/device_names.conf"
STATE_FILE="/tmp/family_presence_state.json"
STATE_DIR="/tmp/family_presence"
mkdir -p "$STATE_DIR" /etc/config 2>/dev/null

HOLD_TIME=600       # 10 phút không thấy tín hiệu mới tính là rời nhà
ALERT_COOLDOWN=1800 # 30 phút giữa các lần chào cùng 1 người

init_family_conf() {
    if [ ! -s "$FAMILY_CONF" ]; then
        touch "$FAMILY_CONF"
        if [ -f "$NAMES_CONF" ]; then
            while IFS='=' read -r mac name; do
                mac=$(echo "$mac" | tr '[:upper:]' '[:lower:]' | tr -d '\r\n ')
                name=$(echo "$name" | tr -d '\r\n')
                [ -z "$mac" ] || [ -z "$name" ] && continue
                # 🚫 Loại trừ tuyệt đối thiết bị IoT, TV, Loa, Camera, Máy In, PC cố định
                if echo "$name" | grep -qiE 'TV|Soundbar|Bose|Camera|IPC|Máy in|Printer|PC |Foxconn|LAN'; then
                    continue
                fi
                if echo "$mac" | grep -qE '^([0-9a-f]{2}:){5}[0-9a-f]{2}$'; then
                    echo "${mac}|${name}|Gia đình|mobile" >> "$FAMILY_CONF"
                fi
            done < "$NAMES_CONF"
        fi
    fi
}
init_family_conf

# Đọc danh sách MAC đang kết nối (Wi-Fi + ARP)
get_online_macs() {
    local online_raw=""
    # 1. Bảng ARP kernel
    if [ -f /proc/net/arp ]; then
        online_raw="${online_raw} $(awk '$4 != "00:00:00:00:00:00" && $3 == "0x2" {print tolower($4)}' /proc/net/arp)"
    fi
    # 2. Bảng ip neigh
    if command -v ip >/dev/null 2>&1; then
        online_raw="${online_raw} $(ip neigh show 2>/dev/null | awk '{print tolower($5)}' | grep -E '^([0-9a-f]{2}:){5}[0-9a-f]{2}$')"
    fi
    # 3. Danh sách Wi-Fi hostapd qua iwinfo hoặc ubus
    if command -v iwinfo >/dev/null 2>&1; then
        for w_if in $(iwinfo 2>/dev/null | awk '/ESSID/ {print $1}'); do
            online_raw="${online_raw} $(iwinfo "$w_if" assoclist 2>/dev/null | grep -oE '([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}' | tr '[:upper:]' '[:lower:]')"
        done
    fi
    echo "$online_raw" | tr ' ' '\n' | grep -E '^([0-9a-f]{2}:){5}[0-9a-f]{2}$' | sort -u
}

send_arrival_alert() {
    local mac="$1"
    local name="$2"
    local role="${3:-Thành viên}"
    local now_ts=$(date +%s)
    local last_alert_file="${STATE_DIR}/alert_${mac}.ts"
    local last_alert=$(cat "$last_alert_file" 2>/dev/null || echo 0)

    if [ $((now_ts - last_alert)) -lt "$ALERT_COOLDOWN" ]; then
        return 0
    fi
    echo "$now_ts" > "$last_alert_file"

    local cur_time_str=$(date "+%H:%M, %d/%m/%Y")
    local cur_h=$(date "+%H" | sed 's/^0//')
    local cur_m=$(date "+%M" | sed 's/^0//')
    local natural_time="${cur_h} giờ"
    [ "$cur_m" -gt 0 ] && natural_time="${natural_time} ${cur_m} phút"

    # THÔNG BÁO TÍCH HỢP ĐỘC BẢN: 1 TIN NHẮN THOẠI DUY NHẤT (VOICE CARD)
    # Có giọng đọc tự nhiên, Thẻ Card thông tin HTML và nút bấm ngay trong caption!
    # Triệt tiêu 100% tin nhắn trùng lặp / bong bóng chat rác!
    local tg_msg="🌸 <b>CHÀO MỪNG THÀNH VIÊN VỀ NHÀ!</b>
━━━━━━━━━━━━━━━━━━━
👋 <b>${name}</b> (${role}) đã về đến nhà an toàn!
📶 <b>Thời gian:</b> <code>${cur_time_str}</code>
✨ <i>Chúc ${name} có những phút giây nghỉ ngơi thoải mái!</i>"

    local tg_kb='{"inline_keyboard":[[{"text":"🏠 Xem Nhà Có Ai","callback_data":"cmd:presence"},{"text":"📊 Trạng Thái Router","callback_data":"cmd:status"}]]}'
    local voice_text="Chào mừng ${name} đã về nhà lúc ${natural_time}."

    if [ -x /usr/bin/tts_speaker.sh ]; then
        ( /usr/bin/tts_speaker.sh "$voice_text" voice_card "" "$tg_kb" "" "$tg_msg" ) >/dev/null 2>&1 &
    elif [ -x /usr/bin/send_telegram ]; then
        /usr/bin/send_telegram "$tg_msg" "$tg_kb" >/dev/null 2>&1 &
    fi
}

update_presence_cycle() {
    local now_ts=$(date +%s)
    local online_macs=$(get_online_macs)
    local json_members=""

    if [ ! -f "$FAMILY_CONF" ]; then
        return 0
    fi

    while IFS='|' read -r f_mac f_name f_role f_type; do
        f_mac=$(echo "$f_mac" | tr '[:upper:]' '[:lower:]' | tr -d '\r\n ')
        f_name=$(echo "$f_name" | tr -d '\r\n')
        f_role=$(echo "${f_role:-Gia đình}" | tr -d '\r\n')
        f_type=$(echo "${f_type:-mobile}" | tr -d '\r\n')
        [ -z "$f_mac" ] || [ -z "$f_name" ] && continue
        echo "$f_mac" | grep -qE '^([0-9a-f]{2}:){5}[0-9a-f]{2}$' || continue

        # 📱 Chỉ lưu tâm đến thiết bị di động thực tế (Điện thoại, Máy tính bảng gia đình)
        # Loại trừ tuyệt đối các thiết bị IoT cố định (Camera, TV, Loa, Máy In, PC)
        if [ "$f_type" != "mobile" ] && [ "$f_type" != "phone" ]; then
            continue
        fi
        if echo "$f_name" | grep -qiE 'TV|Soundbar|Bose|Camera|IPC|Máy in|Printer|PC |Foxconn|LAN'; then
            continue
        fi

        local member_seen_file="${STATE_DIR}/seen_${f_mac}.ts"
        local member_state_file="${STATE_DIR}/state_${f_mac}.txt"
        local member_arr_file="${STATE_DIR}/arrived_${f_mac}.ts"
        local member_left_file="${STATE_DIR}/left_${f_mac}.ts"

        local last_seen=$(cat "$member_seen_file" 2>/dev/null || echo 0)
        local prev_state=$(cat "$member_state_file" 2>/dev/null || echo "unknown")
        local arrived_ts=$(cat "$member_arr_file" 2>/dev/null || echo 0)
        local left_ts=$(cat "$member_left_file" 2>/dev/null || echo 0)

        local is_currently_online=0
        if echo "$online_macs" | grep -qi "^${f_mac}$"; then
            is_currently_online=1
            last_seen="$now_ts"
            echo "$now_ts" > "$member_seen_file"
        fi

        local cur_status="away"
        if [ "$is_currently_online" -eq 1 ] || [ $((now_ts - last_seen)) -le "$HOLD_TIME" ]; then
            cur_status="home"
        fi

        # Chuyển trạng thái
        if [ "$prev_state" != "home" ] && [ "$cur_status" = "home" ]; then
            arrived_ts="$now_ts"
            echo "$now_ts" > "$member_arr_file"
            # Chỉ bắn cảnh báo nếu trước đó đã từng ở trạng thái away (tránh spam khi vừa khởi động daemon)
            if [ "$prev_state" = "away" ]; then
                send_arrival_alert "$f_mac" "$f_name" "$f_role"
            fi
        elif [ "$prev_state" = "home" ] && [ "$cur_status" = "away" ]; then
            left_ts="$now_ts"
            echo "$now_ts" > "$member_left_file"
        fi
        echo "$cur_status" > "$member_state_file"

        local arr_str=""
        [ "$arrived_ts" -gt 0 ] && arr_str=$(date -d "@$arrived_ts" "+%H:%M %d/%m" 2>/dev/null || date "+%H:%M %d/%m")
        local left_str=""
        [ "$left_ts" -gt 0 ] && left_str=$(date -d "@$left_ts" "+%H:%M %d/%m" 2>/dev/null || date "+%H:%M %d/%m")

        local m_json="{\"mac\":\"$f_mac\",\"name\":\"$f_name\",\"role\":\"$f_role\",\"status\":\"$cur_status\",\"last_seen\":$last_seen,\"arrived_at\":\"$arr_str\",\"left_at\":\"$left_str\"}"
        [ -n "$json_members" ] && json_members="${json_members},"
        json_members="${json_members}${m_json}"
    done < "$FAMILY_CONF"

    # Xuất ra JSON trạng thái hoàn chỉnh
    echo "{\"updated_at\":$now_ts,\"hold_time\":$HOLD_TIME,\"members\":[${json_members}]}" > "${STATE_FILE}.tmp" && mv -f "${STATE_FILE}.tmp" "$STATE_FILE"
}

# Chế độ chạy liên tục ngầm (Daemon Loop)
run_daemon_loop() {
    # Chạy chu kỳ đầu tiên ngay lập tức
    update_presence_cycle

    while true; do
        sleep 20
        update_presence_cycle
    done
}

case "$1" in
    check|once)
        update_presence_cycle
        cat "$STATE_FILE" 2>/dev/null
        ;;
    status)
        update_presence_cycle
        if [ -f "$STATE_FILE" ]; then
            cat "$STATE_FILE"
        else
            echo '{"status":"empty","members":[]}'
        fi
        ;;
    daemon|start|"")
        run_daemon_loop
        ;;
esac

FAMILY_PRESENCE_EOF
