                btnToggleAdShield,
                btnToggleFamily,
                btnReloadRules
            ])
        ]);

        function updateAdShieldUI() {
            callGetAdShield().then(function(adRes) {
                if (!adRes) return;
                window._lastAdShieldData = adRes;
                var isAct = (adRes.active === 1 || adRes.active === '1' || adRes.active === true);
                var isFam = (adRes.family === 1 || adRes.family === '1' || adRes.family === true);
                var rulesCnt = adRes.rules || 0;

                var btnHead = document.getElementById('btn-luci-adshield');
                if (btnHead) {
                    var oldHeadAct = btnHead.getAttribute('data-active');
                    var newHeadAct = isAct ? '1' : '0';
                    if (oldHeadAct !== newHeadAct || btnHead.textContent.indexOf('...') !== -1) {
                        btnHead.setAttribute('data-active', newHeadAct);
                        btnHead.style.background = isAct ? '#16a34a' : '#64748b';
                        btnHead.textContent = isAct ? '🛡️ Chặn QC: BẬT' : '🛡️ Chặn QC: TẮT';
                    }
                }

                if (adshieldStatusBadge) {
                    var oldBadgeAct = adshieldStatusBadge.getAttribute('data-active');
                    var oldBadgeRules = adshieldStatusBadge.getAttribute('data-rules');
                    var newBadgeAct = isAct ? '1' : '0';
                    if (oldBadgeAct !== newBadgeAct || oldBadgeRules !== String(rulesCnt)) {
                        adshieldStatusBadge.setAttribute('data-active', newBadgeAct);
                        adshieldStatusBadge.setAttribute('data-rules', String(rulesCnt));
                        if (isAct) {
                            adshieldStatusBadge.style.background = '#dcfce7';
                            adshieldStatusBadge.style.color = '#15803d';
                            adshieldStatusBadge.style.border = '1px solid #86efac';
                            adshieldStatusBadge.innerHTML = '🟢 Micro AdShield: <b>Đang Bật</b> (' + rulesCnt + ' quy tắc | DNS Hijack: BẬT | 0-RAM 0-Flash)';
                        } else {
                            adshieldStatusBadge.style.background = '#f1f5f9';
                            adshieldStatusBadge.style.color = '#64748b';
                            adshieldStatusBadge.style.border = '1px solid #cbd5e1';
                            adshieldStatusBadge.innerHTML = '⚪ Micro AdShield: <b>Đang Tắt</b>';
                        }
                    }
                }

                if (adshieldFamilyBadge) {
                    var oldFamAct = adshieldFamilyBadge.getAttribute('data-family');
                    var newFamAct = isFam ? '1' : '0';
                    if (oldFamAct !== newFamAct) {
                        adshieldFamilyBadge.setAttribute('data-family', newFamAct);
                        if (isFam) {
                            adshieldFamilyBadge.style.background = '#e0f2fe';
                            adshieldFamilyBadge.style.color = '#0369a1';
                            adshieldFamilyBadge.style.border = '1px solid #7dd3fc';
                            adshieldFamilyBadge.innerHTML = '👶 Bảo Vệ Trẻ Em: <b>Đang Bật</b> (SafeSearch)';
                        } else {
                            adshieldFamilyBadge.style.background = '#f8fafc';
                            adshieldFamilyBadge.style.color = '#475569';
                            adshieldFamilyBadge.style.border = '1px solid #cbd5e1';
                            adshieldFamilyBadge.innerHTML = '⚪ Chế Độ Trẻ Em: <b>Tắt</b>';
                        }
                    }
                }

                if (btnToggleAdShield) {
                    var oldBtnAct = btnToggleAdShield.getAttribute('data-active');
                    var newBtnAct = isAct ? '1' : '0';
                    if (oldBtnAct !== newBtnAct || btnToggleAdShield.textContent.indexOf('...') !== -1) {
                        btnToggleAdShield.setAttribute('data-active', newBtnAct);
                        if (isAct) {
                            btnToggleAdShield.style.background = '#dc2626 !important';
                            btnToggleAdShield.textContent = '🛑 Tắt AdShield';
                        } else {
                            btnToggleAdShield.style.background = '#16a34a !important';
                            btnToggleAdShield.textContent = '🛡️ Bật AdShield';
                        }
                    }
                }

                if (btnToggleFamily) {
                    var oldFamBtn = btnToggleFamily.getAttribute('data-family');
                    var newFamBtn = isFam ? '1' : '0';
                    if (oldFamBtn !== newFamBtn || btnToggleFamily.textContent.indexOf('...') !== -1) {
                        btnToggleFamily.setAttribute('data-family', newFamBtn);
                        if (isFam) {
                            btnToggleFamily.style.background = '#e11d48';
                            btnToggleFamily.textContent = '👶 Tắt Trẻ Em';
                        } else {
                            btnToggleFamily.style.background = '#0284c7';
                            btnToggleFamily.textContent = '👶 Bật Trẻ Em';
                        }
                    }
                }
            }).catch(function() {});
        }

        var deviceTableBody = E('tbody');
        function refreshDeviceList(btnEl, force) {
    if (isUserInteracting && !force && !btnEl) return;
            if (btnEl) {
                btnEl.textContent = '⏳ Đang quét...';
                btnEl.disabled = true;
            }
            updateAdShieldUI();
            callGetDevices().then(function(res) {
                if (btnEl) {
                    btnEl.textContent = '🔄 Quét Thiết Bị';
                    btnEl.disabled = false;
                }
                deviceTableBody.innerHTML = '';
                var list = (res && res.devices) ? res.devices : [];
                if (list.length === 0) {
                    deviceTableBody.appendChild(E('tr', {}, [ E('td', { colspan: 9, style: "text-align: center; padding: 15px; color: #000000;" }, "Hiện không có thiết bị nào đang kết nối" ) ]));
                    return;
                }
                list.forEach(function(d) {
                    var nameInput = E('input', { 
                        type: "text", 
                        class: "cbi-input-text", 
                        value: d.name || '', 
                        placeholder: "Đặt tên gợi nhớ...", 
                        title: "Nhập tên gợi nhớ (VD: PC Của Duy, iPhone 15) và bấm Lưu hoặc Enter",
                        style: "font-weight: 800; font-size: 12.5px; color: #000000; padding: 5px 8px; border: 1px solid #cbd5e1; border-radius: 6px; min-width: 220px; width: 100%; box-sizing: border-box;" 
                    });
                    nameInput.addEventListener('focus', function() { isUserInteracting = true; });
                    nameInput.addEventListener('blur', function() { isUserInteracting = false; });

                    var chkBlock = E('input', { type: "checkbox", style: "width: 18px; height: 18px; cursor: pointer; accent-color: #000000;" });
                    chkBlock.checked = (d.mode === 'block');

                    var chkMon = E('input', { type: "checkbox", style: "width: 18px; height: 18px; cursor: pointer; accent-color: #000000;" });
                    chkMon.checked = (d.monitored === true || d.monitored === 1 || d.monitored === '1');
                    chkMon.addEventListener('change', function() {
                        var isMon = chkMon.checked ? 1 : 0;
                        var sTime = startPicker.getValue();
                        var eTime = endPicker.getValue();
                        var minsVal = parseInt(minInput.value || 0);
                        var curName = (nameInput.value || '').trim() || d.name;
                        var targetMode = chkBlock.checked ? 'block' : ((sTime !== '00:00' || eTime !== '23:59') ? 'time' : 'allow');
                        callSetDeviceRule(d.mac, targetMode, sTime, eTime, curName, minsVal, isMon).then(function(r) {
                            ui.addNotification(null, E('p', isMon ? '👁️ Đã bật giám sát online (30-45-60P) cho ' + curName : '👁️ Đã tắt giám sát cho ' + curName), 'info');
                        });
                    });

                    var startPicker = createCustomTimeInput(d.start_t || '00:00', 'Từ');
                    var endPicker = createCustomTimeInput(d.end_t || '23:59', 'Đến');

                    var minInput = E('input', { type: "number", min: "1", max: "1440", placeholder: "Phút", class: "cbi-input-text", style: "width: 65px; padding: 5px; text-align: center; font-weight: 800; border-radius: 6px;" });
                    var statusNoteSpan = E('span', { style: "font-size: 12px; font-weight: 800; white-space: nowrap; margin-left: 6px;" }, "");

                    var expEpoch = parseInt(d.expire_epoch || 0);
                    var curSec = Math.floor(Date.now() / 1000);

                    if (chkBlock.checked) {
                        statusNoteSpan.textContent = '⛔ Đang khóa mạng vĩnh viễn';
                        statusNoteSpan.style.color = '#dc2626';
                    } else if (expEpoch > 0) {
                        if (expEpoch > curSec) {
                            activeCountdowns[d.mac] = { expire: expEpoch, el: statusNoteSpan };
                        } else {
                            statusNoteSpan.textContent = '⛔ Hết thời gian cấp phép (Đã chặn)';
                            statusNoteSpan.style.color = '#dc2626';
                        }
                    } else if ((d.start_t && d.start_t !== '00:00') || (d.end_t && d.end_t !== '23:59')) {
                        var inRange = checkTimeInRange(d.start_t, d.end_t);
                        if (inRange) {
                            statusNoteSpan.textContent = '🟢 Đang trong giờ cho phép (' + d.start_t + ' - ' + d.end_t + ')';
                            statusNoteSpan.style.color = '#15803d';
                        } else {
                            statusNoteSpan.textContent = '⛔ Ngoài giờ cho phép (Đã chặn)';
                            statusNoteSpan.style.color = '#dc2626';
                        }
                    } else {
                        statusNoteSpan.textContent = '🟢 Hoạt động bình thường';
                        statusNoteSpan.style.color = '#15803d';
                    }

                    var isWifi = (d.conn_type === 'WIFI');
                    var badgeConn = isWifi 
                        ? E('span', { style: 'background: #ffffff; color: #000000; border: 1px solid #86efac; padding: 3px 8px; border-radius: 12px; font-size: 11.5px; font-weight: 800; white-space: nowrap;' }, '📶 Wi-Fi')
                        : E('span', { style: 'background: #ffffff; color: #000000; border: 1px solid #7dd3fc; padding: 3px 8px; border-radius: 12px; font-size: 11.5px; font-weight: 800; white-space: nowrap;' }, '🔌 Cáp LAN');

                    var onlineTimeBadge = E('span', {
                        style: 'display: inline-flex; align-items: center; gap: 4px; padding: 3px 8px; border-radius: 12px; font-size: 11.5px; font-weight: 800; background: #ffffff; color: #000000; border: 1px solid #bbf7d0; white-space: nowrap;'
                    }, [
                        '⏱️ ' + (d.online_time || 'Vừa kết nối')
                    ]);

                    var quickRenameBtn = E('button', {
                        class: "btn cbi-button",
                        style: "padding: 5px 8px; font-weight: 800; font-size: 12px; background: #ffffff !important; color: #000000 !important; border-radius: 6px; border: none; cursor: pointer; white-space: nowrap;",
                        title: "Bấm để lưu tên thiết bị này ngay lập tức",
                        click: function() {
                            var newName = (nameInput.value || '').trim();
                            if (!newName) {
                                ui.addNotification(null, E('p', '⚠️ Vui lòng nhập tên mới cho thiết bị!'), 'warning');
                                return;
                            }
                            quickRenameBtn.textContent = '⏳';
                            var sTime = startPicker.getValue();
                            var eTime = endPicker.getValue();
                            var minsVal = parseInt(minInput.value || 0);
                            var isMon = chkMon.checked ? 1 : 0;
                            var targetMode = chkBlock.checked ? 'block' : ((sTime !== '00:00' || eTime !== '23:59') ? 'time' : 'allow');
                            callSetDeviceRule(d.mac, targetMode, sTime, eTime, newName, minsVal, isMon).then(function(r) {
                                quickRenameBtn.textContent = '💾';
                                ui.addNotification(null, E('p', '🎉 Đã đổi tên thiết bị thành: ' + newName), 'info');
                                isUserInteracting = false;
                                refreshDeviceList(null, true);
                            }).catch(function(e) {
                                quickRenameBtn.textContent = '💾';
                                ui.addNotification(null, E('p', '❌ Lỗi đổi tên: ' + (e.message || e)), 'error');
                            });
                        }
                    }, "💾");

                    nameInput.addEventListener('keydown', function(ev) {
                        if (ev.key === 'Enter') {
                            ev.preventDefault();
                            quickRenameBtn.click();
                        }
                    });

                    var applyBtn = E('button', { 
                        class: "btn cbi-button cbi-button-action", 
                        style: "padding: 5px 12px; font-weight: 800; background: #ffffff !important; color: #000000 !important; border-radius: 6px; border: none; cursor: pointer; white-space: nowrap;", 
                        click: function() {
                            var sTime = startPicker.getValue();
                            var eTime = endPicker.getValue();
                            var minsVal = parseInt(minInput.value || 0);
                            var isMon = chkMon.checked ? 1 : 0;
                            var saveName = (nameInput.value || '').trim() || d.name;
                            
                            var targetMode = 'allow';
                            if (chkBlock.checked) {
                                targetMode = 'block';
                            } else if (sTime !== '00:00' || eTime !== '23:59') {
                                targetMode = 'time';
                            }

                            callSetDeviceRule(d.mac, targetMode, sTime, eTime, saveName, minsVal, isMon).then(function(r) {
                                ui.addNotification(null, E('p', '🎉 ' + (r.message || 'Đã lưu cấu hình và đặt tên thiết bị: ' + saveName)), 'info');
                                isUserInteracting = false;
                                refreshDeviceList(null, true);
                            });
                        } 
                    }, "💾 Lưu");

                    var unblockBtn = E('button', { 
                        class: "btn cbi-button", 
                        style: "padding: 5px 12px; font-weight: 800; background: #ffffff !important; color: #000000 !important; border-radius: 6px; border: none; cursor: pointer; white-space: nowrap;", 
                        click: function() {
                            chkBlock.checked = false;
                            chkMon.checked = false;
                            minInput.value = '';
                            startPicker.setValue('00:00');
                            endPicker.setValue('23:59');
                            delete activeCountdowns[d.mac];

                            var curName = (nameInput.value || '').trim() || d.name;
                            callSetDeviceRule(d.mac, 'allow', '00:00', '23:59', curName, 0, 0).then(function() {
                                ui.addNotification(null, E('p', '🟢 Đã gỡ bỏ toàn bộ giới hạn cho ' + curName), 'info');
                                isUserInteracting = false;
                                refreshDeviceList(null, true);
                            });
                        } 
                    }, "🔓 Mở");

                    var actionsWrap = E('div', { style: 'display: flex; gap: 6px; align-items: center; justify-content: center; min-width: 145px;' }, [
                        applyBtn, unblockBtn
                    ]);

                    deviceTableBody.appendChild(E('tr', { class: "tr", style: "border-bottom: 1px solid #f1f5f9;" }, [
                        E('td', { style: "padding: 8px 8px; font-weight: 700; min-width: 160px;" }, [ 
                            E('div', { style: "font-weight: 800; font-size: 13.5px; color: #000000; margin-bottom: 4px;" }, d.name || 'Thiết bị mới'),
                            E('div', { style: 'display: flex; align-items: center; gap: 6px; flex-wrap: wrap;' }, [
                                badgeConn,
                                E('span', { style: "font-size: 12px; color: #000000; font-weight: 700; font-family: monospace;" }, d.ip)
                            ])
                        ]),
                        E('td', { style: "padding: 8px 8px; min-width: 195px;" }, [
                            E('div', { style: 'display: flex; align-items: center; gap: 6px;' }, [
                                nameInput,
                                quickRenameBtn
                            ])
                        ]),
                        E('td', { style: "padding: 10px 8px; font-family: monospace; font-size: 12.5px; font-weight: 800; color: #000000;" }, d.mac),
                        E('td', { style: "padding: 10px 8px; text-align: center;" }, onlineTimeBadge),
                        E('td', { style: "padding: 10px 8px; text-align: center;" }, E('label', { style: "display: inline-flex; align-items: center; gap: 4px; cursor: pointer;" }, [ chkBlock, E('span', { style: "font-weight: 800; color: #000000; font-size: 12.5px;" }, "Khóa mạng") ])),
                        E('td', { style: "padding: 10px 8px; text-align: center;" }, E('label', { style: "display: inline-flex; align-items: center; gap: 4px; cursor: pointer;" }, [ chkMon, E('span', { style: "font-weight: 800; color: #000000; font-size: 12.5px;" }, "Giám sát") ])),
                        E('td', { style: "padding: 10px 8px;" }, E('div', { style: "display: flex; align-items: center; gap: 6px;" }, [ startPicker, E('span', { style: "font-weight: 800; color: #000000;" }, "➔"), endPicker ])),
