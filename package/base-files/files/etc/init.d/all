        var card = E('div', { class: 'cbi-section', style: 'background:#ffffff; color:#000000; border:1px solid #cbd5e1; border-radius:12px; padding:24px; box-shadow:0 4px 6px rgba(0,0,0,0.05); max-width:820px; margin:20px auto;' }, [
            E('h2', { style: 'color:#000000; margin-top:0; font-size:22px; font-weight:900; border-bottom:2px solid #000000; padding-bottom:12px;' }, '\u2699\uFE0F Trung T\u00E2m Qu\u1EA3n L\u00FD Giao Di\u1EC7n & Script ALL'),
            E('p', { style: 'color:#334155; font-size:14px; margin-bottom:16px;' }, 'Cho ph\u00E9p Anh Duy linh ho\u1EA1t chuy\u1EC3n \u0111\u1ED5i gi\u1EEFa Giao di\u1EC7n Master Chuy\u00EAn S\u00E2u v\u00E0 Giao di\u1EC7n Theme Argon M\u1EB7c \u0110\u1ECBnh c\u1EE7a OpenWrt.'),
            
            E('div', { style: 'background:#f8fafc; border:1.5px solid ' + (isEnabled ? '#16a34a' : '#64748b') + '; border-radius:10px; padding:16px 20px; margin-bottom:16px; display:flex; align-items:center; justify-content:space-between;' }, [
                E('div', {}, [
                    E('div', { style: 'font-size:13px; font-weight:700; color:#64748b; text-transform:uppercase;' }, 'Giao di\u1EC7n hi\u1EC7n t\u1EA1i:'),
                    E('div', { style: 'font-size:18px; font-weight:900; color:' + (isEnabled ? '#16a34a' : '#334155') + '; margin-top:4px;' }, isEnabled ? '\uD83D\uDFE2 Giao Di\u1EC7n Master Chuy\u00EAn S\u00E2u' : '\u26AA Theme Argon M\u1EB7c \u0110\u1ECBnh (Stock)')
                ]),
                E('button', {
                    class: 'btn cbi-button',
                    style: 'font-weight:900; font-size:14.5px; padding:10px 20px; border-radius:8px; cursor:pointer; background:' + (isEnabled ? '#dc2626; color:#ffffff; border:none;' : '#16a34a; color:#ffffff; border:none;'),
                    click: function(e) {
                        var target = isEnabled ? 'off' : 'on';
                        var confirmMsg = isEnabled ? 
                            '\u26A0\uFE0F Anh c\u00F3 ch\u1EAFc mu\u1ED1n chuy\u1EC3n v\u1EC1 Theme Argon M\u1EB7c \u0110\u1ECBnh kh\u00F4ng?\n(\u2705 Modem 5G Watchdog v\u00E0 logall v\u1EABn ti\u1EBFp t\u1EE5c ho\u1EA1t \u0111\u1ED9ng \u0111\u1ED9c l\u1EADp ng\u1EA7m)' :
                            '\uD83D\uDE80 Anh c\u00F3 mu\u1ED1n B\u1EACT L\u1EA0I Giao di\u1EC7n Master Chuy\u00EAn S\u00E2u kh\u00F4ng?';
                        if (!confirm(confirmMsg)) return;
                        
                        ui.showModal('\u0110ang chuy\u1EC3n \u0111\u1ED5i giao di\u1EC7n...', [
                            E('p', { class: 'spinning' }, isEnabled ? '\u0110ang kh\u00F4i ph\u1EE5c theme Argon m\u1EB7c \u0110\u1ECBnh...' : '\u0110ang k\u00EDch ho\u1EA1t Master Dashboard chuy\u00EAn s\u00E2u...')
                        ]);
                        
                        callToggleAllScript(target).finally(function() {
                            setTimeout(function() {
                                window.location.href = '/cgi-bin/luci/admin/status/overview';
                            }, 3000);
                        });
                    }
                }, isEnabled ? '\u23F9\uFE0F Chuy\u1EC3n V\u1EC1 Argon M\u1EB7c \u0110\u1ECBnh' : '\uD83D\uDFE2 B\u1EADt Giao Di\u1EC7n Master')
            ]),

