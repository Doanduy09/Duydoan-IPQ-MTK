    # Cố định trần an toàn tuyệt đối 45MB cho Telegram Bot (ngưỡng 50MB)
    echo "47185920"
    return 0
}
old_get_dynamic_target_fs_disabled() {
    local cur_hm=$(date +%H%M)
    local offpeak_start=$(uci -q get cctv_bot.security.offpeak_start || uci -q get cctv_bot.security.night_start || echo "23:00")
    local offpeak_end=$(uci -q get cctv_bot.security.offpeak_end || uci -q get cctv_bot.security.night_end || echo "06:00")
    local s_hm=$(echo "$offpeak_start" | tr -d ':')
    local e_hm=$(echo "$offpeak_end" | tr -d ':')
    [ -z "$s_hm" ] && s_hm="2300"
    [ -z "$e_hm" ] && e_hm="0600"

    local is_offpeak=0
    if [ "$s_hm" -gt "$e_hm" ]; then
        if [ "$cur_hm" -ge "$s_hm" ] || [ "$cur_hm" -lt "$e_hm" ]; then
            is_offpeak=1
        fi
    else
        if [ "$cur_hm" -ge "$s_hm" ] && [ "$cur_hm" -lt "$e_hm" ]; then
            is_offpeak=1
        fi
    fi

    # Network QoS check from Arbiter: if network is under heavy strain, force peak limit
    if [ -x /usr/bin/cctv_upload_arbiter.sh ]; then
        local net_policy=$(/usr/bin/cctv_upload_arbiter.sh load 2>/dev/null)
        [ "$net_policy" = "PEAK_HOLD" ] && is_offpeak=0
    fi

    # Count active recording cameras to scale RAM budget safely on 512MB RAM
    local active_cams=0
    for s in $(uci show camera 2>/dev/null | grep "=camera" | cut -d'.' -f2 | cut -d'=' -f1); do
        local rec=$(uci -q get camera.${s}.record_247 || echo "1")
        local ip=$(uci -q get camera.${s}.ip)
        if [ "$rec" != "0" ] && [ -n "$ip" ]; then
            active_cams=$(( active_cams + 1 ))
        fi
    done
    [ "$active_cams" -lt 1 ] && active_cams=1

    # Check for manual UCI override if configured
    local manual_offpeak=$(uci -q get cctv_bot.global.target_fs_offpeak)
    local manual_peak=$(uci -q get cctv_bot.global.target_fs_peak)
    if [ -n "$manual_offpeak" ] && [ -n "$manual_peak" ]; then
        if [ "$is_offpeak" -eq 1 ]; then
            echo "$manual_offpeak"
            return 0
        else
            echo "$manual_peak"
            return 0
        fi
    fi

    # Dynamic Scaling Matrix based on camera count & off-peak/peak
    local arbiter_mode=$(/usr/bin/cctv_upload_arbiter.sh policy 2>/dev/null || echo "OFFPEAK_FULL")
    if [ "$arbiter_mode" = "OFFPEAK_FULL" ]; then
        is_offpeak=1
    elif [ "$arbiter_mode" = "PEAK_THROTTLE" ]; then
        is_offpeak=0
    fi

    # 🚀 TỐI ƯU CHO ANH DUY (DOANDUY) TRÊN ROUTER ATHENA (1GB RAM & >430MB tmpfs):
    # Luôn cấp trọn vẹn hạn mức 45MB Safe Cap (47,185,920 bytes) cho tất cả camera.
    # Đảm bảo video 2.5K Ultra HD và Full HD quay đủ trọn vẹn 10 phút (600s) không bị ngắt sớm!
    # Telegram Safe Cap: 45MB (dưới ngưỡng 50MB của Telegram Bot API).
    if [ "$is_offpeak" -eq 1 ]; then
        echo "47185920" # 45MB Safe Cap
    else
        echo "45088768" # 43MB Safe Cap (Peak hours)
    fi
}

stream_camera() {
    local cam_input="$1"
    local duration="$2"
    [ -z "$cam_input" ] && cam_input="cam1"
    
    init_config
    local cam_id=$(find_cam_section "$cam_input")
    [ -z "$cam_id" ] && cam_id="$cam_input"

    local cam_lock="/var/run/cloud_cam_${cam_id}.lock"
    exec 210>"$cam_lock"
    if ! flock -x -n 210; then
        echo "{\"status\":\"error\",\"message\":\"A recording session is already in progress for ${cam_id}\"}"
        return 1
    fi

    if [ -z "$duration" ]; then
        local cam_dur=$(uci -q get camera.${cam_id}.duration || uci -q get camera.settings.segment_duration || uci -q get camera.settings.default_duration || echo "10")
        case "$cam_dur" in
            5) duration=300 ;;
            10) duration=600 ;;
            15) duration=900 ;;
            20) duration=1200 ;;
            30) duration=1800 ;;
            *)
                if echo "$cam_dur" | grep -qE '^[0-9]+$'; then
                    duration=$(( cam_dur * 60 ))
                else
                    duration=600
                fi
                ;;
        esac
    fi

    local cam_name=$(get_config_val "$cam_id" "name" "Camera_${cam_id}")
    local cam_label=$(get_config_val "$cam_id" "label" "$cam_name")
    local cam_ip=$(get_config_val "$cam_id" "ip" "192.168.1.227")
    local cam_port=$(get_config_val "$cam_id" "port" "554")
    local cam_user=$(get_config_val "$cam_id" "username" "admin")
    local cam_pass=$(get_config_val "$cam_id" "password" "")
    local cam_path=$(get_config_val "$cam_id" "path" "cam/realmonitor?channel=1&subtype=0")
    [ "$cam_path" = "stream0" ] && cam_path="cam/realmonitor?channel=1&subtype=0"
    cam_path=$(echo "$cam_path" | sed 's|^/||')
    [ -z "$cam_path" ] && cam_path="cam/realmonitor?channel=1&subtype=0"
    
    if [ -x "/mnt/storage/bin/ffmpeg" ]; then
        ln -sf "/mnt/storage/bin/ffmpeg" /usr/bin/ffmpeg 2>/dev/null
    fi
    if [ ! -x "/usr/bin/ffmpeg" ]; then
        echo "{\"status\":\"error\",\"message\":\"ffmpeg binary not found in /usr/bin/ or storage\"}"
        return 1
    fi
    
    local cam_target=$(uci -q get camera.${cam_id}.storage_target)
    local target="$cam_target"
    [ -z "$target" ] || [ "$target" = "default" ] && target=$(get_storage_target)
    [ "$target" = "nas" ] && target="emmc"

    local target_mode=$(echo "$target" | cut -d':' -f1)
    local target_node=$(echo "$target" | cut -d':' -f2 -s)
    [ "$target_mode" = "nas" ] && target_mode="emmc"
    [ -z "$target_mode" ] && target_mode="phone_cloud_offpeak"
    local nvr_mode=$(uci -q get camera.${cam_id}.nvr_mode || uci -q get camera.${cam_id}.storage_target || uci -q get camera.settings.nvr_mode || echo "1")
    [ "$nvr_mode" = "nas" ] && nvr_mode="1"
    [ "$nvr_mode" = "nas_telegram" ] && nvr_mode="1"
    [ "$nvr_mode" = "nas_cloud" ] && nvr_mode="2"
    [ "$nvr_mode" = "ephemeral" ] && nvr_mode="3"
    [ "$nvr_mode" = "cloud" ] && nvr_mode="3"
    [ "$nvr_mode" = "telegram" ] && nvr_mode="4"
    [ "$nvr_mode" = "tg_instant" ] && nvr_mode="4"
    [ "$nvr_mode" = "low_traffic_auto" ] && nvr_mode="5"
    [ "$target_mode" = "nas_telegram" ] || [ "$target" = "1" ] && nvr_mode="1"
    [ "$target_mode" = "nas_cloud" ] || [ "$target" = "2" ] && nvr_mode="2"
    [ "$target_mode" = "ephemeral" ] || [ "$target_mode" = "cloud" ] || [ "$target" = "3" ] && nvr_mode="3"
    [ "$target_mode" = "telegram" ] || [ "$target" = "4" ] && nvr_mode="4"
    [ "$target_mode" = "low_traffic_auto" ] || [ "$target" = "5" ] && nvr_mode="5"

    local date_dir=$(date +%Y-%m-%d)
    local time_tag=$(date +%H%M%S)
    
    local enc_pass="$cam_pass"
    if [ -n "$cam_pass" ] && [ -x "/usr/bin/lua" ]; then
        local lenc=$(/usr/bin/lua -e 'local p=[====['"$cam_pass"']====]; print((string.gsub(p, "([^%w_.~-])", function(c) return string.format("%%%02X", string.byte(c)) end)))' 2>/dev/null)
        [ -n "$lenc" ] && enc_pass="$lenc"
    fi

    local auth_str=""
    if [ -n "$enc_pass" ]; then
        auth_str="${cam_user}:${enc_pass}@"
    elif [ -n "$cam_user" ]; then
        auth_str="${cam_user}@"
    fi
    local rtsp_url="rtsp://${auth_str}${cam_ip}:${cam_port}/${cam_path}"
    local cctv_rtsp=$(uci -q get cctv_bot.${cam_id}.rtsp_url)
    [ -n "$cctv_rtsp" ] && rtsp_url="$cctv_rtsp"
    
    # 0. SMART ADAPTIVE RESOLUTION & OFF-PEAK FULL VIDEO AGENT
    local forced_prof=$(uci -q get cctv_bot.${cam_id}.stream_profile || uci -q get camera.${cam_id}.stream_profile || echo "auto")
    local arbiter_mode=$(/usr/bin/cctv_upload_arbiter.sh policy 2>/dev/null || echo "OFFPEAK_FULL")
    local active_prof="main"

    if [ "$forced_prof" = "sub" ]; then
        active_prof="sub"
    elif [ "$forced_prof" = "main" ] || [ "$forced_prof" = "high" ] || [ "$forced_prof" = "2k" ] || [ "$forced_prof" = "4k" ]; then
        active_prof="main"
    else
        # Tự động thông minh theo điều kiện mạng:
        # Khi thấp điểm hoặc ít thiết bị online -> TỰ ĐỘNG QUAY FULL VIDEO (Main-stream 2K/4K/1080p)
        if [ "$arbiter_mode" = "OFFPEAK_FULL" ] || [ "$arbiter_mode" = "ALLOW_FULL" ]; then
            active_prof="main"
        else
            active_prof="sub"
        fi
    fi

    if [ "$active_prof" = "main" ]; then
        rtsp_url=$(echo "$rtsp_url" | sed 's/subtype=1/subtype=0/g')
        logger -t cloud_cam "🌟 Smart Adaptive: Activating FULL VIDEO (Main-stream 1080p/2K/4K, subtype=0) for $cam_id [Policy: $arbiter_mode]"
    else
        rtsp_url=$(echo "$rtsp_url" | sed 's/subtype=0/subtype=1/g')
        logger -t cloud_cam "⚡ Smart Adaptive: Activating Sub-stream (subtype=1) to conserve QoS for $cam_id [Policy: $arbiter_mode]"
    fi
    echo "$active_prof" > "/tmp/cctv_cur_profile_${cam_id}.txt"

    # 1. AUTO-PURGE STALE RAM BUFFER FILES (> 15 MINS) - Zero RAM Accumulation
    find /tmp/cctv_ram_buffer -type f -name "raw_*.mkv" -mmin +15 -exec rm -f {} \; 2>/dev/null
    find /tmp/cctv_ram_buffer -type f -name "emergency_*.mkv" -mmin +30 -exec rm -f {} \; 2>/dev/null

    # 2. DYNAMIC TARGET FILE SIZE (48MB off-peak, 38MB peak, auto-scaled for 3+ cams)
    local target_fs=$(get_dynamic_target_fs)
    local max_rec_sec=600
    [ -n "$duration" ] && [ "$duration" -gt 0 ] && [ "$duration" -le 3600 ] && max_rec_sec="$duration"
    local res_status="ok"
    local res_msg=""
    local target_file=""
    local write_target=""
    local cand_file=""
    local emergency_file=""
    local rc=1
    
    if [ "$target_mode" = "cloud" ]; then
        if [ ! -x "/usr/bin/rclone" ]; then
            echo "{\"status\":\"error\",\"message\":\"rclone binary not found in /usr/bin/\"}"
            flock -u 210 2>/dev/null; exec 210>&-
            return 1
        fi
        local remote=$(get_remote "$cam_id")
        local folder=$(get_config_val "settings" "cloud_folder" "$DEFAULT_CLOUD_FOLDER")
        target_file="${folder}/${cam_name}/${date_dir}/Clip_${time_tag}.mkv"
        
        logger -t cloud_cam "Starting Direct Pipe Stream to Cloud: $cam_label ($duration s) -> ${remote}:${target_file}"
        timeout -s 9 $((duration + 30)) taskset -c 3 nice -n 19 /usr/bin/ffmpeg -hide_banner -loglevel error -timeout 10000000 -rtsp_transport tcp \
            -i "$rtsp_url" -t "$duration" -c copy -f matroska pipe:1 | \
            taskset -c 3 nice -n 19 /usr/bin/rclone rcat "${remote}:${target_file}" 2>&1
        rc=$?
        if [ $rc -eq 0 ]; then
            res_msg="Uploaded to Cloud: ${remote}:${target_file}"
        else
            res_status="error"; res_msg="Cloud pipeline failed (code $rc)"
        fi

    elif [ "$target_mode" = "cloud_immediate" ]; then
        local nas_base=$(get_nas_dir "$target")
        local target_dir="${nas_base}/${cam_name}/${date_dir}"
        mkdir -p "$target_dir" 2>/dev/null
        target_file="${target_dir}/Clip_${time_tag}.mkv"
        local remote=$(get_remote "$cam_id")
        local folder=$(get_config_val "settings" "cloud_folder" "$DEFAULT_CLOUD_FOLDER")
        local cloud_dest="${remote}:${folder}/${cam_name}/${date_dir}/"
        
        timeout -s 9 $((max_rec_sec + 30)) taskset -c 3 nice -n 19 /usr/bin/ffmpeg -hide_banner -loglevel error \
            -buffer_size 1048576 -reorder_queue_size 64 -max_delay 500000 -timeout 10000000 -rtsp_transport tcp \
            -i "$rtsp_url" -fs "$target_fs" -t "$max_rec_sec" -c copy "${target_file}" 2>&1
        rc=$?
        if [ $rc -eq 0 ]; then
            (
                if nice -n 19 /usr/bin/rclone copy "${target_file}" "${cloud_dest}" >/dev/null 2>&1; then
                    [ "$target_mode" = "cloud_immediate" ] && rm -f "${target_file}"
                    logger -t cloud_cam "Immediate Offload Succeeded: ${target_file} -> ${cloud_dest}"
                else
                    logger -t cloud_cam "WARNING: Immediate offload failed for ${target_file}, retained locally"
                fi
            ) >/dev/null 2>&1 &
            res_msg="Buffer saved (${target_file}) & immediate offload triggered -> ${cloud_dest}"
        else
            res_status="error"; res_msg="Local recording failed (code $rc)"
        fi

    elif [ "$target_mode" = "cloud_offpeak" ]; then
        local nas_base=$(get_nas_dir "$target")
        local target_dir="${nas_base}/${cam_name}/${date_dir}"
        mkdir -p "$target_dir" 2>/dev/null
        target_file="${target_dir}/Clip_${time_tag}.mkv"
        local remote=$(get_remote "$cam_id")
        local folder=$(get_config_val "settings" "cloud_folder" "$DEFAULT_CLOUD_FOLDER")
        local cloud_dest="${remote}:${folder}/${cam_name}/${date_dir}/"
        
        # Zero-Wear RAM Buffer Acceleration
        local ram_buf_dir="/tmp/cctv_ram_buffer"
        mkdir -p "$ram_buf_dir" 2>/dev/null
        local free_ram_kb=$(df -P /tmp 2>/dev/null | tail -1 | awk '{print $4}')
        [ -z "$free_ram_kb" ] && free_ram_kb=0
        write_target="${target_file}"
        local use_ram_burst=0
        if [ "$free_ram_kb" -gt 80000 ]; then
            use_ram_burst=1
            write_target="${ram_buf_dir}/raw_${cam_id}_${time_tag}.mkv"
        fi

        logger -t cloud_cam "Recording with Off-Peak Schedule ($target): $cam_label ($duration s) -> ${write_target} (RAM_Burst=${use_ram_burst})"
        timeout -s 9 $((max_rec_sec + 30)) taskset -c 3 nice -n 19 /usr/bin/ffmpeg -hide_banner -loglevel error \
            -buffer_size 1048576 -reorder_queue_size 64 -max_delay 500000 -timeout 10000000 -rtsp_transport tcp \
            -i "$rtsp_url" -fs "$target_fs" -t "$max_rec_sec" -c copy "${write_target}" 2>&1
        rc=$?
        if [ $rc -eq 0 ] || [ -s "${write_target}" ]; then
            if [ "$use_ram_burst" = "1" ] && [ -f "${write_target}" ]; then
                mv "${write_target}" "${target_file}" 2>/dev/null || cp "${write_target}" "${target_file}"
                rm -f "${write_target}" 2>/dev/null
            fi
            rc=0
            if check_offpeak_window; then
                (
                    if nice -n 19 /usr/bin/rclone copy "${target_file}" "${cloud_dest}" >/dev/null 2>&1; then
                        logger -t cloud_cam "Off-Peak Window Active: ${target_file} synced to Cloud"
                    fi
                ) >/dev/null 2>&1 &
                res_msg="Saved to NAS & off-peak uploaded -> ${cloud_dest}"
            else
                res_msg="Buffer saved locally (${target_file}). Queued for off-peak sync (00:00-05:30)"
                logger -t cloud_cam "Peak hours active: ${target_file} queued for off-peak cloud upload"
            fi
        else
            [ "$use_ram_burst" = "1" ] && rm -f "${write_target}" 2>/dev/null
            res_status="error"; res_msg="Local recording failed (code $rc)"
        fi

    elif [ "$target_mode" = "nas" ] || [ "$target_mode" = "emmc" ] || [ "$target_mode" = "phone" ] || [ "$target_mode" = "phone_cloud_offpeak" ] || [ "$target_mode" = "phone_cloud_immediate" ] || [ "$target_mode" = "phone_nas" ] || [ "$target_mode" = "ephemeral" ] || [ -n "$nvr_mode" ]; then
        # 🎯 Định danh chuẩn hóa từng camera: Triệt tiêu xung đột ghi đè RAM buffer & nhầm lẫn bot
        local clean_cname=$(echo "$cam_id" | tr -cd 'A-Za-z0-9_')
        [ -z "$clean_cname" ] && clean_cname="cam_unknown"

        # Xác định chế độ NVR: 1 (nas_cloud), 2 (nas_telegram), 3 (ephemeral)
        local eff_mode="$nvr_mode"
        [ "$target_mode" = "ephemeral" ] && eff_mode="3"
        [ -z "$eff_mode" ] && eff_mode="1"

        local nas_base="/mnt/storage/airdrop/Camera_NAS"
        local target_dir="${nas_base}/${clean_cname}/${date_dir}"
        if [ "$eff_mode" = "4" ] || [ "$eff_mode" = "3" ]; then
            target_dir="/tmp/cctv_ram_buffer/${clean_cname}"
        fi
        mkdir -p "$target_dir" 2>/dev/null
        target_file="${target_dir}/Clip_${time_tag}.mkv"

        local dur_disp="$(( max_rec_sec / 60 ))p"
        logger -t cloud_cam "📹 Recording NVR (Mode $eff_mode): $cam_name (${dur_disp}) -> ${target_file}"
        timeout -s 9 $((max_rec_sec + 45)) taskset -c 3 nice -n 19 /usr/bin/ffmpeg -hide_banner -loglevel error \
            -buffer_size 1048576 -reorder_queue_size 64 -max_delay 500000 -timeout 25000000 \
            -rtsp_transport tcp \
            -i "$rtsp_url" -fs "$target_fs" -t "$max_rec_sec" -c copy "${target_file}" 2>&1
        rc=$?

        if [ $rc -eq 0 ] || [ -s "${target_file}" ]; then
            rc=0
            res_msg="Saved segment: ${target_file}"
            local v_base=$(basename "${target_file}")
            local remote=$(get_remote "$cam_id")
            local fsize_mb=$(du -m "$target_file" 2>/dev/null | awk '{print $1}')
            [ -z "$fsize_mb" ] && fsize_mb=0

            # -------------------------------------------------------------
            # CHẾ ĐỘ 3: GHI PHÂN ĐOẠN -> ĐẨY TELEGRAM -> XÓA NGAY (0MB RAM / 0MB FLASH)
            # -------------------------------------------------------------
            if [ "$eff_mode" = "3" ] || [ "$eff_mode" = "telegram" ] || [ "$eff_mode" = "tg_instant" ] || [ "$eff_mode" = "ephemeral_tg" ]; then
                logger -t cloud_cam "🤖 [CHẾ ĐỘ 3 - ĐẨY TELEGRAM XONG XÓA] Đang đẩy $v_base (${fsize_mb}MB) vào Telegram Bot..."
                local up_ok=0
                if [ -x /usr/bin/cctv_bot_daemon.sh ]; then
                    if /usr/bin/cctv_bot_daemon.sh dispatch_video "$cam_id" "${target_file}" >/dev/null 2>&1; then
                        up_ok=1
                    fi
                fi
                if [ $up_ok -eq 1 ]; then
                    rm -f "${target_file}" 2>/dev/null
                    # PageCache auto-managed by Linux kernel
                    logger -t cloud_cam "🗑️ [CHẾ ĐỘ 3] Đã xóa file $v_base sau khi đẩy Telegram thành công!"
                else
                    logger -t cloud_cam "⚠️ [CHẾ ĐỘ 3] Tạm giữ file $v_base vì chưa đẩy xong qua Telegram."
                fi
                flock -u 210 2>/dev/null
                exec 210>&-
                dispatched_flag=1
                return 0
            fi

            # -------------------------------------------------------------
            # CHẾ ĐỘ 4: QUAY TRỰC TIẾP LÊN CLOUD (ZERO DISK-WEAR) -> XÓA NGAY
            # -------------------------------------------------------------
            if [ "$eff_mode" = "4" ] || [ "$eff_mode" = "cloud" ] || [ "$eff_mode" = "ephemeral" ]; then
                logger -t cloud_cam "🚀 [CHẾ ĐỘ 4 - CLOUD DIRECT] Đang đẩy $v_base (${fsize_mb}MB) lên Cloud (${remote})..."
                local up_ok=0
                if nice -n 19 /usr/bin/rclone copy "${target_file}" "${remote}:Camera_Cloud/${clean_cname}/${date_dir}/" >/dev/null 2>&1; then
                    up_ok=1
                    logger -t cloud_cam "✅ [CHẾ ĐỘ 4] Đã tải lên Cloud Google Drive thành công!"
                else
                    logger -t cloud_cam "⚠️ [CHẾ ĐỘ 4] Tải lên Cloud Google Drive thất bại!"
                fi
                if [ $up_ok -eq 1 ]; then
                    rm -f "${target_file}" 2>/dev/null
                    # PageCache auto-managed by Linux kernel
                    logger -t cloud_cam "🗑️ [CHẾ ĐỘ 4] Đã xóa file $v_base sau khi upload thành công! 0MB Flash Wear."
                else
                    logger -t cloud_cam "⚠️ [CHẾ ĐỘ 4] Tạm giữ file $v_base để bảo vệ dữ liệu."
                fi
                dispatched_flag=1
                return 0
            fi

            # -------------------------------------------------------------
            # CHẾ ĐỘ 5: ĐẨY TỰ CHỦ THEO LƯU LƯỢNG (RẢNH ĐẨY NGAY XONG XÓA)
            # -------------------------------------------------------------
            if [ "$eff_mode" = "5" ]; then
                local cur_hm=$(date +%H%M)
                local is_low_traffic=0
                if [ "$cur_hm" -ge "0000" ] && [ "$cur_hm" -lt "0600" ]; then
                    is_low_traffic=1
                else
                    local arb_pol=$(/usr/bin/cctv_upload_arbiter.sh policy 2>/dev/null || echo "OFFPEAK_FULL")
                    [ "$arb_pol" = "OFFPEAK_FULL" ] && is_low_traffic=1
                fi
                if [ "$is_low_traffic" = "1" ]; then
                    logger -t cloud_cam "⚡ [CHẾ ĐỘ 5] Mạng rảnh / Ít thiết bị: Tự động đẩy $v_base lên Cloud & Telegram..."
                    (
                        local up_c=0
                        if nice -n 19 /usr/bin/rclone copy "${target_file}" "${remote}:Camera_Cloud/${clean_cname}/${date_dir}/" >/dev/null 2>&1; then
                            up_c=1
                            logger -t cloud_cam "✅ [CHẾ ĐỘ 5] Upload Cloud thành công!"
                        fi
                        if [ -x /usr/bin/cctv_bot_daemon.sh ]; then
                            /usr/bin/cctv_bot_daemon.sh dispatch_video "$cam_id" "${target_file}" >/dev/null 2>&1
                        fi
                        [ "$up_c" -eq 1 ] && rm -f "${target_file}" 2>/dev/null
                    ) >/dev/null 2>&1 &
                else
                    logger -t cloud_cam "⏳ [CHẾ ĐỘ 5] Mạng đang bận / Nhiều thiết bị: Tạm giữ $v_base trên NAS."
                fi
                dispatched_flag=1
                return 0
            fi

            # -------------------------------------------------------------
            # CHẾ ĐỘ 1 (NAS + TELEGRAM) & CHẾ ĐỘ 2 (NAS + CLOUD)
            # -------------------------------------------------------------
            local phone_ip=$(uci -q get camera.settings.phone_ip || uci -q get nas_phone.settings.phone_ip || echo "192.168.1.155")
            local phone_port=$(uci -q get camera.settings.phone_port || uci -q get nas_phone.settings.phone_port || echo "8080")
            local phone_online=0
            if timeout 2 nc "$phone_ip" "$phone_port" < /dev/null >/dev/null 2>&1; then
                phone_online=1
            fi

            local cur_hm=$(date +%H%M)
            local is_low_traffic=0
            if [ "$cur_hm" -ge "0000" ] && [ "$cur_hm" -lt "0600" ]; then
                is_low_traffic=1
            else
                local arb_pol=$(/usr/bin/cctv_upload_arbiter.sh policy 2>/dev/null || echo "OFFPEAK_FULL")
                if [ "$arb_pol" = "OFFPEAK_FULL" ]; then
                    is_low_traffic=1
                fi
            fi

            if [ "$phone_online" = "1" ]; then
                logger -t cloud_cam "📱 Phone NAS ONLINE ($phone_ip:$phone_port). Đang lưu ${v_base} vào Phone NAS..."
                curl -s -m 3 -X MKCOL "http://${phone_ip}:${phone_port}/Camera_NAS/" >/dev/null 2>&1
                curl -s -m 3 -X MKCOL "http://${phone_ip}:${phone_port}/Camera_NAS/${clean_cname}/" >/dev/null 2>&1
                curl -s -m 3 -X MKCOL "http://${phone_ip}:${phone_port}/Camera_NAS/${clean_cname}/${date_dir}/" >/dev/null 2>&1
                if curl -s -m 60 -T "${target_file}" "http://${phone_ip}:${phone_port}/Camera_NAS/${clean_cname}/${date_dir}/${v_base}" >/dev/null 2>&1; then
                    logger -t cloud_cam "✅ Đã lưu trọn vẹn ${v_base} vào NAS Điện Thoại (${clean_cname}/${date_dir})!"

                    # Snapshot AI Vision
                    local snap_base="${v_base%.*}.jpg"
                    local snap_tmp="/tmp/snap_${cam_id}_$$.jpg"
                    taskset -c 3 nice -n 19 /usr/bin/ffmpeg -nostdin -y -ss 00:00:03 -i "${target_file}" -vframes 1 -q:v 2 "$snap_tmp" >/dev/null 2>&1
                    if [ -s "$snap_tmp" ]; then
                        curl -s -m 3 -X MKCOL "http://${phone_ip}:${phone_port}/Camera_NAS/AI_Vision/" >/dev/null 2>&1
                        curl -s -m 3 -X MKCOL "http://${phone_ip}:${phone_port}/Camera_NAS/AI_Vision/${clean_cname}/" >/dev/null 2>&1
                        curl -s -m 15 -T "$snap_tmp" "http://${phone_ip}:${phone_port}/Camera_NAS/AI_Vision/${clean_cname}/${snap_base}" >/dev/null 2>&1
                    fi
                    rm -f "$snap_tmp" 2>/dev/null
                else
                    logger -t cloud_cam "⚠️ Lưu vào NAS Điện Thoại gặp timeout!"
                fi

                # CHẾ ĐỘ 1: NAS + TELEGRAM (Mạng rảnh đẩy ngay rồi xóa; giờ cao điểm giữ NAS, 0h-6h đẩy)
                if [ "$eff_mode" = "1" ]; then
                    if [ "$is_low_traffic" = "1" ]; then
                        logger -t cloud_cam "🤖 [CHẾ ĐỘ 1] Mạng rảnh / Ít thiết bị: Tự động đẩy ngay ${v_base} lên Telegram..."
                        if [ -x /usr/bin/cctv_bot_daemon.sh ]; then
                            /usr/bin/cctv_bot_daemon.sh dispatch_video "$cam_id" "${target_file}" >/dev/null 2>&1 &
                        fi
                        ( sleep 30 && rm -f "${target_file}" ) >/dev/null 2>&1 &
                    else
                        logger -t cloud_cam "⏳ [CHẾ ĐỘ 1] Giờ cao điểm: Giữ ${v_base} trên NAS, hẹn giờ 00h-06h đẩy lên Telegram rồi xóa."
                    fi
                # CHẾ ĐỘ 2: NAS + CLOUD (Mạng rảnh đẩy ngay rồi xóa; giờ cao điểm giữ NAS, 0h-6h đẩy)
                elif [ "$eff_mode" = "2" ]; then
                    if [ "$is_low_traffic" = "1" ]; then
                        logger -t cloud_cam "☁️ [CHẾ ĐỘ 2] Mạng rảnh / Ít thiết bị: Tự động đẩy ngay ${v_base} lên Google Drive..."
                        (
                            if nice -n 19 /usr/bin/rclone copy "${target_file}" "${remote}:Camera_Cloud/${clean_cname}/${date_dir}/" >/dev/null 2>&1; then
                                rm -f "${target_file}" 2>/dev/null
                                logger -t cloud_cam "✅ [CHẾ ĐỘ 2] Upload Cloud thành công, đã xóa file đệm ${v_base}!"
                            fi
                        ) >/dev/null 2>&1 &
                    else
                        logger -t cloud_cam "⏳ [CHẾ ĐỘ 2] Giờ cao điểm: Giữ ${v_base} trên NAS, hẹn giờ 00h-06h đẩy lên Cloud rồi xóa."
                    fi
                fi
            else
                # 🚨 MẤT KẾT NỐI NAS ĐIỆN THOẠI (Dự phòng lưu tại Router NAS / Flash)
                logger -t cloud_cam "🚨 CẢNH BÁO: NAS Điện Thoại ($phone_ip:$phone_port) OFFLINE!"
                if [ "$eff_mode" = "1" ]; then
                    if [ -x /usr/bin/cctv_bot_daemon.sh ]; then
                        /usr/bin/cctv_bot_daemon.sh dispatch_video "$cam_id" "${target_file}" "PHONE_OFFLINE" >/dev/null 2>&1 &
                    fi
                elif [ "$eff_mode" = "2" ]; then
                    logger -t cloud_cam "☁️ [BẢO VỆ DỮ LIỆU] Đẩy thẳng ${v_base} lên Cloud (${remote})..."
                    nice -n 19 /usr/bin/rclone copy "${target_file}" "${remote}:Camera_Cloud/${clean_cname}/${date_dir}/" >/dev/null 2>&1 &
                fi
                if [ -x /usr/bin/cctv_bot_daemon.sh ]; then
                    /usr/bin/cctv_bot_daemon.sh alert_nas_offline "$cam_id" "${target_file}" >/dev/null 2>&1 &
                fi
            fi
            if [ "$(uci -q get camera.settings.purge_after_sync)" = "1" ]; then
                    rm -f "${target_file}" 2>/dev/null
                    logger -t cloud_cam "Da xoa file ${v_base} sau khi dong bo (purge_after_sync=1)"
                fi
                dispatched_flag=1
            else
                res_status="error"; res_msg="NAS recording failed (code $rc)"
        fi

    elif [ "$target_mode" = "both" ]; then
        local nas_base=$(get_nas_dir "$target")
        local target_dir="${nas_base}/${cam_name}/${date_dir}"
        mkdir -p "$target_dir" 2>/dev/null
        target_file="${target_dir}/Clip_${time_tag}.mkv"
        local remote=$(get_remote "$cam_id")
        local folder=$(get_config_val "settings" "cloud_folder" "$DEFAULT_CLOUD_FOLDER")
        local cloud_dest="${remote}:${folder}/${cam_name}/${date_dir}/"

        # Zero-Wear RAM Buffer Acceleration
        local ram_buf_dir="/tmp/cctv_ram_buffer"
        mkdir -p "$ram_buf_dir" 2>/dev/null
        local free_ram_kb=$(df -P /tmp 2>/dev/null | tail -1 | awk '{print $4}')
        [ -z "$free_ram_kb" ] && free_ram_kb=0
        write_target="${target_file}"
        local use_ram_burst=0
        if [ "$free_ram_kb" -gt 80000 ]; then
            use_ram_burst=1
            write_target="${ram_buf_dir}/raw_${cam_id}_${time_tag}.mkv"
        fi

        logger -t cloud_cam "Starting Hybrid Recording: $cam_label ($duration s) -> ${write_target} (RAM_Burst=${use_ram_burst})"
        timeout -s 9 $((max_rec_sec + 30)) taskset -c 3 nice -n 19 /usr/bin/ffmpeg -hide_banner -loglevel error -timeout 10000000 -rtsp_transport tcp \
            -i "$rtsp_url" -fs "$target_fs" -t "$max_rec_sec" -c copy "${write_target}" 2>&1
        rc=$?
        if [ $rc -eq 0 ] || [ -s "${write_target}" ]; then
            if [ "$use_ram_burst" = "1" ] && [ -f "${write_target}" ]; then
                mv "${write_target}" "${target_file}" 2>/dev/null || cp "${write_target}" "${target_file}"
                rm -f "${write_target}" 2>/dev/null
            fi
            rc=0
            ( nice -n 19 /usr/bin/rclone copy "${target_file}" "${cloud_dest}" >/dev/null 2>&1 & )
            res_msg="Saved to NAS (${target_file}) & uploading to Cloud (${cloud_dest})"
        else
            [ "$use_ram_burst" = "1" ] && rm -f "${write_target}" 2>/dev/null
            res_status="error"; res_msg="Hybrid recording failed (code $rc)"
        fi
    else
        # Robust Fallback & NAS Health Check
        local nas_healthy=1
        if [ ! -d "/mnt/storage" ] || ! touch "/mnt/storage/.nas_wtest" 2>/dev/null; then
            nas_healthy=0
        fi
        rm -f "/mnt/storage/.nas_wtest" 2>/dev/null
        local nas_free_mb=$(df -m /mnt/storage 2>/dev/null | awk 'NR==2 {print $4}')
        if [ -z "$nas_free_mb" ] || [ "$nas_free_mb" -lt 100 ]; then
            nas_healthy=0
        fi

        local ram_buf_dir="/tmp/cctv_ram_buffer"
        mkdir -p "$ram_buf_dir" 2>/dev/null

        if [ "$nas_healthy" = "0" ]; then
            # 🚨 CẤP CỨU: Ổ CỨNG NAS MẤT KẾT NỐI HOẶC ĐẦY BỘ NHỚ
            logger -t cloud_cam "EMERGENCY: NAS /mnt/storage is unavailable or full! Recording to RAM for direct emergency upload."
            emergency_file="${ram_buf_dir}/emergency_${cam_id}_${time_tag}.mkv"
            timeout -s 9 $((max_rec_sec + 30)) taskset -c 3 nice -n 19 /usr/bin/ffmpeg -hide_banner -loglevel error -timeout 10000000 -rtsp_transport tcp \
                -i "$rtsp_url" -fs "$target_fs" -t "$max_rec_sec" -c copy "${emergency_file}" 2>&1
            rc=$?
            if [ $rc -eq 0 ] || [ -s "$emergency_file" ]; then
                rc=0
                res_msg="NAS Offline: Emergency direct upload triggered"
                if [ -x /usr/bin/cctv_bot_daemon.sh ]; then
                    /usr/bin/cctv_bot_daemon.sh dispatch_video "$cam_id" "$emergency_file" "EMERGENCY" >/dev/null 2>&1 &
                fi
            else
                res_status="error"; res_msg="Emergency RAM recording failed (code $rc)"
                rm -f "$emergency_file" 2>/dev/null
            fi
        else
            # 🟢 HOẠT ĐỘNG BÌNH THƯỜNG: Lưu vào eMMC NAS
            local nas_base=$(get_nas_dir "$target")
            local target_dir="${nas_base}/${cam_name}/${date_dir}"
            mkdir -p "$target_dir" 2>/dev/null
            target_file="${target_dir}/Clip_${time_tag}.mkv"
            
            # Zero-Wear RAM Buffer Acceleration
            local free_ram_kb=$(df -P /tmp 2>/dev/null | tail -1 | awk '{print $4}')
            [ -z "$free_ram_kb" ] && free_ram_kb=0
            write_target="${target_file}"
            local use_ram_burst=0
            if [ "$free_ram_kb" -gt 80000 ]; then
                use_ram_burst=1
                write_target="${ram_buf_dir}/raw_${cam_id}_${time_tag}.mkv"
            fi

            logger -t cloud_cam "Starting Local NAS Recording: $cam_label ($duration s) -> ${write_target}"
            timeout -s 9 $((max_rec_sec + 30)) taskset -c 3 nice -n 19 /usr/bin/ffmpeg -hide_banner -loglevel error -timeout 10000000 -rtsp_transport tcp \
                -i "$rtsp_url" -fs "$target_fs" -t "$max_rec_sec" -c copy "${write_target}" 2>&1
            rc=$?
            if [ $rc -eq 0 ] || [ -s "${write_target}" ]; then
                if [ "$use_ram_burst" = "1" ] && [ -f "${write_target}" ]; then
                    mv "${write_target}" "${target_file}" 2>/dev/null || cp "${write_target}" "${target_file}"
                    rm -f "${write_target}" 2>/dev/null
                fi
                rc=0
                res_msg="Saved to NAS: ${target_file}"
            else
                [ "$use_ram_burst" = "1" ] && rm -f "${write_target}" 2>/dev/null
                res_status="error"; res_msg="NAS recording failed (code $rc)"
            fi

        fi
    fi

    # 📹 Tự động chuyển giao cho CCTV Bot Daemon điều phối upload thông minh (Telegram Bot & Cloud NVR)
    if [ "$dispatched_flag" != "1" ] && [ -x /usr/bin/cctv_bot_daemon.sh ]; then
        cand_file="${target_file}"
        [ ! -s "$cand_file" ] && [ -s "${write_target}" ] && cand_file="${write_target}"
        [ ! -s "$cand_file" ] && [ -s "${emergency_file}" ] && cand_file="${emergency_file}"
        if [ -s "$cand_file" ]; then
            logger -t cloud_cam "Auto-Dispatching segment to CCTV Bot: $cand_file"
            /usr/bin/cctv_bot_daemon.sh dispatch_video "$cam_id" "$cand_file" >/dev/null 2>&1 &
        fi
    fi

    flock -u 210 2>/dev/null
    exec 210>&-

    echo "{\"status\":\"$res_status\",\"target\":\"$target\",\"camera\":\"$cam_name\",\"label\":\"$cam_label\",\"duration\":$duration,\"message\":\"$res_msg\"}"
    if [ "$res_status" != "ok" ]; then
        return 1
    fi
    return 0
}

snap_camera() {
    local cam_input="$1"
    [ -z "$cam_input" ] && cam_input="cam1"
    
    init_config
    local cam_id=$(find_cam_section "$cam_input")
    [ -z "$cam_id" ] && cam_id="$cam_input"

    local cam_name=$(get_config_val "$cam_id" "name" "Camera_${cam_id}")
    local cam_label=$(get_config_val "$cam_id" "label" "$cam_name")
    local cam_ip=$(get_config_val "$cam_id" "ip" "192.168.1.227")
    local cam_port=$(get_config_val "$cam_id" "port" "554")
    local cam_user=$(get_config_val "$cam_id" "username" "admin")
    local cam_pass=$(get_config_val "$cam_id" "password" "")
    local cam_path=$(get_config_val "$cam_id" "path" "cam/realmonitor?channel=1&subtype=0")
    [ "$cam_path" = "stream0" ] && cam_path="cam/realmonitor?channel=1&subtype=0"
    cam_path=$(echo "$cam_path" | sed 's|^/||')
    [ -z "$cam_path" ] && cam_path="cam/realmonitor?channel=1&subtype=0"

    local cur_prof=$(cat "/tmp/cctv_cur_profile_${cam_id}.txt" 2>/dev/null || echo "main")
    if [ "$cur_prof" = "main" ]; then
        cam_path=$(echo "$cam_path" | sed 's/subtype=1/subtype=0/g')
    fi
    
    local cam_target=$(uci -q get camera.${cam_id}.storage_target)
    local target="$cam_target"
    [ -z "$target" ] || [ "$target" = "default" ] && target=$(get_storage_target)
    [ "$target" = "nas" ] && target="emmc"

    local target_mode=$(echo "$target" | cut -d':' -f1)
    local target_node=$(echo "$target" | cut -d':' -f2 -s)
    [ "$target_mode" = "nas" ] && target_mode="emmc"

    local date_dir=$(date +%Y-%m-%d)
    local time_tag=$(date +%H%M%S)

    local nas_base=$(get_nas_dir "$target")
    local target_dir="${nas_base}/${cam_name}/${date_dir}"
    mkdir -p "$target_dir" 2>/dev/null
    local target_file="${target_dir}/Snap_${time_tag}.jpg"
    [ "$target_mode" = "cloud" ] && target_file="/tmp/Snap_${cam_id}_${time_tag}.jpg"
    local last_snap_cache="/tmp/cctv_last_snap_${cam_id}.jpg"

    # 🛡️ KIỂM TRA TRẠNG THÁI GHI HÌNH ĐỂ TRÁNH XUNG ĐỘT KÊNH RTSP
    local is_recording=0
    if pgrep -f "ffmpeg.*${cam_ip}" >/dev/null 2>&1 || pgrep -f "ffmpeg.*${cam_id}" >/dev/null 2>&1; then
        is_recording=1
    fi

    # 1. Nếu đang ghi hình: Ưu tiên trích xuất từ file đang ghi trên RAM
    if [ "$is_recording" = "1" ]; then
        local active_raw=$(ls -t "/tmp/cctv_ram_buffer/raw_${cam_id}_"*.mkv 2>/dev/null | head -n 1)
        if [ -n "$active_raw" ] && [ -s "$active_raw" ]; then
            local raw_sz=$(wc -c < "$active_raw" 2>/dev/null || echo 0)
            if [ "$raw_sz" -gt 50000 ]; then
                if taskset -c 3 nice -n 19 timeout -s 9 3 /usr/bin/ffmpeg -hide_banner -loglevel error -y -i "$active_raw" -vframes 1 -q:v 2 "$target_file" 2>/dev/null; then
                    if [ -s "$target_file" ]; then
                        cp -f "$target_file" "$last_snap_cache" 2>/dev/null
                        logger -t cloud_cam "Instant RAM snapshot extracted for $cam_name ($target_file) [Zero-Contention]"
                        echo "{\"status\":\"ok\",\"target\":\"$target\",\"camera\":\"$cam_name\",\"file\":\"${target_file}\",\"source\":\"ram_live\"}"
                        return 0
                    fi
                fi
            fi
        fi

        # Nếu file RAM mới tạo còn nhỏ, trích xuất từ clip hoàn tất gần nhất
        local last_clip=$(cat "/tmp/cctv_last_clip_${cam_id}.txt" 2>/dev/null)
        if [ -n "$last_clip" ] && [ -s "$last_clip" ]; then
            if taskset -c 3 nice -n 19 timeout -s 9 3 /usr/bin/ffmpeg -hide_banner -loglevel error -sseof -2 -i "$last_clip" -vframes 1 -q:v 2 "$target_file" 2>/dev/null; then
                if [ -s "$target_file" ]; then
                    cp -f "$target_file" "$last_snap_cache" 2>/dev/null
                    logger -t cloud_cam "Recent clip snapshot extracted for $cam_name ($target_file)"
                    echo "{\"status\":\"ok\",\"target\":\"$target\",\"camera\":\"$cam_name\",\"file\":\"${target_file}\",\"source\":\"recent_clip\"}"
                    return 0
                fi
            fi
        fi

        # Nếu có cache trước đó, trả về cache ngay để không ngắt luồng ghi hình chính
        if [ -s "$last_snap_cache" ]; then
            cp -f "$last_snap_cache" "$target_file" 2>/dev/null
            logger -t cloud_cam "Returned cached snapshot for $cam_name (Preventing RTSP recording interruption)"
            echo "{\"status\":\"ok\",\"target\":\"$target\",\"camera\":\"$cam_name\",\"file\":\"${target_file}\",\"source\":\"cache_safe\"}"
            return 0
        fi
    fi

    # 2. Nếu camera KHÔNG ghi hình: An toàn kết nối trực tiếp RTSP
    local enc_pass="$cam_pass"
    if [ -n "$cam_pass" ] && [ -x "/usr/bin/lua" ]; then
        local lenc=$(/usr/bin/lua -e 'local p=[====['"$cam_pass"']====]; print((string.gsub(p, "([^%w_.~-])", function(c) return string.format("%%%02X", string.byte(c)) end)))' 2>/dev/null)
        [ -n "$lenc" ] && enc_pass="$lenc"
    fi

    local auth_str=""
    [ -n "$enc_pass" ] && auth_str="${cam_user}:${enc_pass}@"
    local rtsp_url="rtsp://${auth_str}${cam_ip}:${cam_port}/${cam_path}"

    logger -t cloud_cam "Capturing snapshot from RTSP: $cam_label -> ${target_file}"
    if timeout -s 9 4 taskset -c 3 nice -n 19 /usr/bin/ffmpeg -hide_banner -loglevel error -timeout 3000000 -rtsp_transport tcp \
        -i "$rtsp_url" -vframes 1 -q:v 2 "${target_file}" 2>/dev/null; then
        if [ -s "$target_file" ]; then
            cp -f "$target_file" "$last_snap_cache" 2>/dev/null
            echo "{\"status\":\"ok\",\"target\":\"$target\",\"camera\":\"$cam_name\",\"file\":\"${target_file}\",\"source\":\"rtsp_live\"}"
            return 0
        fi
    fi

    # Cuối cùng: fallback cache nếu có
    if [ -s "$last_snap_cache" ]; then
        cp -f "$last_snap_cache" "$target_file" 2>/dev/null
        echo "{\"status\":\"ok\",\"target\":\"$target\",\"camera\":\"$cam_name\",\"file\":\"${target_file}\",\"source\":\"cache_fallback\"}"
        return 0
    fi

    echo "{\"status\":\"error\",\"message\":\"Snapshot unavailable\",\"camera\":\"$cam_name\"}"
    return 1
}
add_camera() {
    local name="$1"
    local ip="$2"
    local label="$3"
    local port="$4"
    local user="$5"
    local pass="$6"
    local path="$7"

    if [ -z "$ip" ]; then
        echo "{\"status\":\"error\",\"message\":\"IP address is required\"}"
        return 1
    fi

    init_config
    local ip_clean=$(echo "$ip" | tr '.' '_')
    local clean_name=$(echo "$name" | tr ' ' '_' | tr -cd 'a-zA-Z0-9_-')
    [ -z "$clean_name" ] && clean_name="Camera_${ip_clean}"
    [ -z "$label" ] && label="$name"
    [ -z "$port" ] && port="554"
    [ -z "$user" ] && user="admin"
    [ -z "$path" ] && path="cam/realmonitor?channel=1&subtype=0"
    path=$(echo "$path" | sed 's|^/||')

    # Detect if camera with same IP already exists to update it
    local existing_id=""
    for s in $(uci show camera 2>/dev/null | grep "=camera" | cut -d'.' -f2 | cut -d'=' -f1); do
        local cur_ip=$(uci -q get camera.${s}.ip)
        if [ "$cur_ip" = "$ip" ]; then
            existing_id="$s"
            break
        fi
    done

    local id="$existing_id"
    [ -z "$id" ] && id="cam_${ip_clean}"

    uci set camera.${id}=camera
    uci set camera.${id}.name="$clean_name"
    uci set camera.${id}.label="$label"
    uci set camera.${id}.ip="$ip"
    uci set camera.${id}.port="$port"
    uci set camera.${id}.username="$user"
    [ -n "$pass" ] && uci set camera.${id}.password="$pass"
    uci set camera.${id}.path="$path"
    [ -z "$(uci -q get camera.${id}.storage_target)" ] && uci set camera.${id}.storage_target="phone_cloud_offpeak"
    [ -z "$(uci -q get camera.${id}.duration)" ] && uci set camera.${id}.duration="10"
    [ -z "$(uci -q get camera.${id}.cloud_remote)" ] && uci set camera.${id}.cloud_remote=""
    [ -z "$(uci -q get camera.${id}.record_247)" ] && uci set camera.${id}.record_247="1"
    uci commit camera

    logger -t cloud_cam "Added/Updated camera: $clean_name ($ip:$port) id=$id"
    echo "{\"status\":\"ok\",\"id\":\"$id\",\"name\":\"$clean_name\",\"label\":\"$label\",\"ip\":\"$ip\",\"port\":$port}"
}

del_camera() {
    local target="$1"
    if [ -z "$target" ]; then
        echo "{\"status\":\"error\",\"message\":\"Camera ID or Name is required\"}"
        return 1
    fi

    init_config
    local sec=$(find_cam_section "$target")
    if [ -z "$sec" ]; then
        echo "{\"status\":\"error\",\"message\":\"Camera not found: $target\"}"
        return 1
    fi

    local c_name=$(uci -q get camera.${sec}.name)
    uci delete camera.${sec}
    uci commit camera

    # Bi-directional sync: Also remove from cctv_bot if exists
    if uci -q get cctv_bot."$sec" >/dev/null 2>&1; then
        uci delete cctv_bot."$sec"
        uci commit cctv_bot
        [ -x /usr/bin/cctv_bot_daemon.sh ] && /usr/bin/cctv_bot_daemon.sh restart >/dev/null 2>&1 &
    fi

    logger -t cloud_cam "Deleted camera: $sec ($c_name)"
    echo "{\"status\":\"ok\",\"deleted\":\"$sec\",\"name\":\"$c_name\"}"
}

list_cameras() {
    init_config
    local target=$(uci -q get camera.settings.nvr_mode || echo "1")
    local nvr_m=$(uci -q get camera.settings.nvr_mode || echo "1")
    local remote=$(get_remote)
    local ret=$(get_config_val "settings" "retention_days" "$DEFAULT_RETENTION_DAYS")
    local rec_247=$(get_config_val "settings" "record_247" "0")
    local seg_dur=$(get_config_val "settings" "segment_duration" "10")
    local op_start=$(get_config_val "settings" "offpeak_start" "00:00")
    local op_end=$(get_config_val "settings" "offpeak_end" "05:30")
    local daemon_running=0
    if pgrep -f "cloud_cam_recorder_daemon.sh master" >/dev/null 2>&1; then
        daemon_running=1
    fi
    local avail_remotes=$(get_available_remotes)
    local avail_phones=$(get_available_phones)
    local st_info=$(get_storage_info)
    
    echo "{\"status\":\"ok\",\"storage_target\":\"$target\",\"nvr_mode\":\"$nvr_m\",\"remote\":\"$remote\",\"retention_days\":$ret,\"record_247\":$rec_247,\"daemon_running\":$daemon_running,\"segment_duration\":$seg_dur,\"offpeak_start\":\"$op_start\",\"offpeak_end\":\"$op_end\",\"available_remotes\":$avail_remotes,\"available_phones\":$avail_phones,\"storage_info\":$st_info,\"cameras\":["
    local first=1
    for s in $(uci show camera 2>/dev/null | grep "=camera" | cut -d'.' -f2 | cut -d'=' -f1); do
        local c_name=$(uci -q get camera.${s}.name)
        local c_label=$(uci -q get camera.${s}.label)
        local c_ip=$(uci -q get camera.${s}.ip)
        local c_port=$(uci -q get camera.${s}.port || echo "554")
        [ -z "$c_port" ] && c_port="554"
        local c_nvr_m=$(uci -q get camera.${s}.nvr_mode || echo "$nvr_m")
        local c_target=$(uci -q get camera.${s}.storage_target || echo "$c_nvr_m")
        [ -z "$c_target" -o "$c_target" = "default" -o "$c_target" = "phone" -o "$c_target" = "phone_cloud_offpeak" ] && c_target="$c_nvr_m"
        local c_dur=$(uci -q get camera.${s}.duration)
        local c_rec247=$(uci -q get camera.${s}.record_247 || echo "1")
        local c_remote=$(uci -q get camera.${s}.cloud_remote)
        local c_pass=$(uci -q get camera.${s}.password || echo "")
        local c_path=$(uci -q get camera.${s}.path || echo "cam/realmonitor?channel=1&subtype=0")
        local has_pass=0
        [ -n "$c_pass" ] && has_pass=1
        [ -z "$c_dur" -o "$c_dur" = "default" ] && c_dur="10"
        [ -z "$c_rec247" ] && c_rec247="1"
        [ -z "$c_remote" -o "$c_remote" = "default" ] && c_remote=""

        local c_daemon_active=0
        if pgrep -f "cloud_cam_recorder_daemon\.sh loop $s" >/dev/null 2>&1; then
            c_daemon_active=1
        fi

        local bot_tok=$(uci -q get cctv_bot.${s}.bot_token)
        local bot_name=$(uci -q get cctv_bot.${s}.name || echo "")
        local has_bot=0
        [ -n "$bot_tok" ] && has_bot=1

        [ -z "$c_name" ] && c_name="Camera_${s}"
        [ -z "$c_label" ] && c_label="$c_name"

        local is_online="offline"
        if grep -q "^${c_ip}[[:space:]].*0x2" /proc/net/arp 2>/dev/null; then
            is_online="online"
        elif nc -z -w 1 "$c_ip" "${c_port:-554}" 2>/dev/null || ping -c 1 -W 1 "$c_ip" >/dev/null 2>&1; then
            is_online="online"
        fi

        [ $first -eq 0 ] && printf ","
        first=0
        printf "{\"id\":\"%s\",\"name\":\"%s\",\"label\":\"%s\",\"ip\":\"%s\",\"port\":%s,\"status\":\"%s\",\"storage_target\":\"%s\",\"nvr_mode\":\"%s\",\"duration\":\"%s\",\"record_247\":\"%s\",\"cloud_remote\":\"%s\",\"daemon_active\":%d,\"has_pass\":%d,\"password\":\"%s\",\"path\":\"%s\",\"has_bot\":%d,\"bot_name\":\"%s\"}" \
            "$s" "$c_name" "$c_label" "$c_ip" "$c_port" "$is_online" "$c_target" "$c_nvr_m" "$c_dur" "$c_rec247" "$c_remote" "$c_daemon_active" "$has_pass" "$c_pass" "$c_path" "$has_bot" "$bot_name"
    done
    echo "]}"
}

scan_lan_cameras() {
    echo "{\"status\":\"ok\",\"discovered_cameras\":["
    local first=1

    local candidate_ips=$( {
        awk '{print $3}' /tmp/dhcp.leases 2>/dev/null
        awk '$1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ {print $1}' /proc/net/arp 2>/dev/null
    } | sort -u )

    for ip in $candidate_ips; do
        [ "$ip" = "192.168.1.1" ] && continue
        [ "$ip" = "127.0.0.1" ] && continue
        
        if timeout 2 nc "$ip" 554 </dev/null >/dev/null 2>&1; then
            local mac=$(awk -v ip="$ip" '$3==ip {print $2}' /tmp/dhcp.leases 2>/dev/null | head -1)
            [ -z "$mac" ] && mac=$(awk -v ip="$ip" '$1==ip {print $4}' /proc/net/arp 2>/dev/null | head -1)
            local host=$(awk -v ip="$ip" '$3==ip {print $4}' /tmp/dhcp.leases 2>/dev/null | head -1)
            [ "$host" = "*" ] && host=""
            [ -z "$host" ] && host="IP Camera"

            [ $first -eq 0 ] && printf ","
            first=0
            printf "{\"ip\":\"%s\",\"mac\":\"%s\",\"hostname\":\"%s\",\"port\":554}" "$ip" "$mac" "$host"
        fi
    done
    echo "]}"
}


set_retention() {
    local days="$1"
    if [ -z "$days" ] || ! echo "$days" | grep -qE '^[0-9]+$'; then
        echo "{\"status\":\"error\",\"message\":\"Invalid days number\"}"
        return 1
    fi
    init_config
    uci set camera.settings.retention_days="$days"
    uci commit camera
    logger -t cloud_cam "Retention policy updated to: $days days"
    echo "{\"status\":\"ok\",\"retention_days\":$days}"
}

cleanup_retention() {
    local custom_days="$1"
    init_config
    local retention_days="$custom_days"
    [ -z "$retention_days" ] && retention_days=$(get_config_val "settings" "retention_days" "$DEFAULT_RETENTION_DAYS")
    
    local remote=$(get_remote)
    local cloud_folder=$(get_config_val "settings" "cloud_folder" "$DEFAULT_CLOUD_FOLDER")
    local nas_folder=$(get_nas_dir)
    
    if [ "$retention_days" -le 0 ] 2>/dev/null; then
        logger -t cloud_cam "Retention set to unlimited (0 days). Skipping cleanup."
        echo "{\"status\":\"ok\",\"retention_days\":0,\"message\":\"Unlimited retention - no files deleted\"}"
        return 0
    fi

    logger -t cloud_cam "Starting retention cleanup (older than ${retention_days} days)..."
    
    if [ -x "/usr/bin/rclone" ]; then
        /usr/bin/rclone delete "${remote}:${cloud_folder}" --min-age "${retention_days}d" --rmdirs >/dev/null 2>&1
        /usr/bin/rclone rmdirs "${remote}:${cloud_folder}" --leave-root >/dev/null 2>&1
    fi

    for n_dir in "/mnt/storage/airdrop/Camera_NAS" "/mnt/storage/airdrop/Phone_NAS_512GB/Camera_NAS"; do
        if [ -d "$n_dir" ]; then
            find "$n_dir" -type f -mtime +"${retention_days}" -delete 2>/dev/null
            find "$n_dir" -type d -empty -delete 2>/dev/null
        fi
    done
    
    # 🧹 Tối ưu hóa bộ nhớ & Đĩa Flash eMMC ban đêm (Smart Night Compaction)
    sync
    local tot_ram_mb=$(awk '/MemTotal:/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 512)
    if [ "$tot_ram_mb" -lt 1500 ]; then
        echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
        logger -t cloud_cam "Memory cache compaction executed (drop_caches=3)"
    else
        [ -f /proc/sys/vm/compact_memory ] && echo 1 > /proc/sys/vm/compact_memory 2>/dev/null
        logger -t cloud_cam "Preserved RAM pagecache on 2GB DDR4 (Zero-Drop-Caches mode)"
    fi

    logger -t cloud_cam "Retention cleanup completed (threshold: ${retention_days} days)"
    echo "{\"status\":\"ok\",\"retention_days\":$retention_days,\"remote\":\"$remote\",\"nas_folder\":\"$nas_folder\"}"
}

set_segment_duration() {
    local mins="$1"
    [ -z "$mins" ] && mins="10"
    init_config
    uci set camera.settings.segment_duration="$mins"
    uci set camera.settings.default_duration="$mins"
    for s in $(uci show camera 2>/dev/null | grep "=camera" | cut -d'.' -f2 | cut -d'=' -f1); do
        uci set camera.${s}.duration="$mins"
    done
    uci commit camera
    for s in $(uci show cctv_bot 2>/dev/null | grep "=cctv_camera" | cut -d'.' -f2 | cut -d'=' -f1); do
        uci set cctv_bot.${s}.duration="$mins"
    done
    uci commit cctv_bot
    logger -t cloud_cam "Segment duration set to ${mins} minutes across all cameras"
    if [ "$(uci -q get camera.settings.record_247)" = "1" ] && [ -x "/usr/bin/cloud_cam_recorder_daemon.sh" ]; then
        /usr/bin/cloud_cam_recorder_daemon.sh restart >/dev/null 2>&1 &
    fi
    echo "{\"status\":\"ok\",\"segment_duration\":$mins}"
}

set_nvr_mode() {
    local mode="$1"
    [ -z "$mode" ] && mode="1"
    init_config
    uci set camera.settings.nvr_mode="$mode"
    if [ "$mode" = "1" ]; then
        uci set cctv_bot.global.push_to_telegram='0'
        uci set cctv_bot.cam1.push_tg='0'
        uci set cctv_bot.cam2.push_tg='0'
        uci set camera.settings.storage_target='phone'
    elif [ "$mode" = "2" ]; then
        uci set cctv_bot.global.push_to_telegram='1'
        uci set cctv_bot.cam1.push_tg='1'
        uci set cctv_bot.cam2.push_tg='1'
        uci set camera.settings.storage_target='phone'
    elif [ "$mode" = "3" ]; then
        uci set camera.settings.storage_target='ephemeral'
    fi
    uci commit camera
    uci commit cctv_bot
    logger -t cloud_cam "NVR Mode set to: $mode"
    if [ "$(uci -q get camera.settings.record_247)" = "1" ] && [ -x "/usr/bin/cloud_cam_recorder_daemon.sh" ]; then
        /usr/bin/cloud_cam_recorder_daemon.sh restart >/dev/null 2>&1 &
    fi
    echo "{\"status\":\"ok\",\"nvr_mode\":\"$mode\"}"
}

start_247() {
    init_config
    if [ -x "/usr/bin/cloud_cam_recorder_daemon.sh" ]; then
        /usr/bin/cloud_cam_recorder_daemon.sh start
    else
        uci set camera.settings.record_247='1'
        uci commit camera
        echo "{\"status\":\"ok\",\"record_247\":1}"
    fi
}

stop_247() {
    init_config
    if [ -x "/usr/bin/cloud_cam_recorder_daemon.sh" ]; then
        /usr/bin/cloud_cam_recorder_daemon.sh stop
    else
        uci set camera.settings.record_247='0'
        uci commit camera
        echo "{\"status\":\"ok\",\"record_247\":0}"
    fi
}

toggle_247() {
    init_config
    local cur=$(uci -q get camera.settings.record_247 || echo "0")
    if [ "$cur" = "1" ]; then
        stop_247
    else
        start_247
    fi
}

status_247() {
    if [ -x "/usr/bin/cloud_cam_recorder_daemon.sh" ]; then
        /usr/bin/cloud_cam_recorder_daemon.sh status
    else
        show_status
    fi
}

setup_cron() {
    local cron_cmd="/usr/bin/cloud_cam_streamer.sh cleanup >/dev/null 2>&1"
    if ! grep -Fq "cloud_cam_streamer.sh cleanup" /etc/crontabs/root 2>/dev/null; then
        echo "0 3 * * * $cron_cmd" >> /etc/crontabs/root
        /etc/init.d/cron restart 2>/dev/null
        logger -t cloud_cam "Added 03:00 AM daily retention cleanup cron job"
    fi
}

show_status() {
    init_config
    local target=$(get_storage_target)
    local rem=$(get_remote)
    local cloud_f=$(get_config_val "settings" "cloud_folder" "$DEFAULT_CLOUD_FOLDER")
    local nas_f=$(get_nas_dir)
    local ret=$(get_config_val "settings" "retention_days" "$DEFAULT_RETENTION_DAYS")
    local rec_247=$(get_config_val "settings" "record_247" "0")
    local seg_dur=$(get_config_val "settings" "segment_duration" "10")
    
    local cam_count=0
    for s in $(uci show camera 2>/dev/null | grep "=camera" | cut -d'.' -f2 | cut -d'=' -f1); do
        cam_count=$((cam_count + 1))
    done

    local pending_clips=$(find "$nas_f" -type f -name "Clip_*.mkv" 2>/dev/null | wc -l)
    local pending_bytes=$(find "$nas_f" -type f -name "Clip_*.mkv" -exec wc -c {} + 2>/dev/null | awk '{s+=$1} END {print s+0}')
    local pending_mb=$((pending_bytes / 1048576))
    local offpeak_s=$(get_config_val "settings" "offpeak_start" "00:00")
    local offpeak_e=$(get_config_val "settings" "offpeak_end" "05:30")
    local cur_h=$(date +%H)
    local cur_bw="Full 100% (Dem)"
    [ "$cur_h" -ge 6 ] && [ "$cur_h" -lt 24 ] && cur_bw="2.5 MB/s (Ngay - Bao Ve Ping)"

    echo "{\"status\":\"ok\",\"storage_target\":\"$target\",\"remote\":\"$rem\",\"cloud_folder\":\"$cloud_f\",\"nas_folder\":\"$nas_f\",\"retention_days\":$ret,\"record_247\":$rec_247,\"segment_duration\":$seg_dur,\"camera_count\":$cam_count,\"pending_clips\":$pending_clips,\"pending_mb\":$pending_mb,\"offpeak_window\":\"$offpeak_s - $offpeak_e\",\"current_bw_limit\":\"$cur_bw\"}"
}

set_cam_config() {
    local cam_id="$1"
    local target="$2"
    local duration="$3"
    local rec_247="$4"
    local cloud_rem="$5"
    local pass="$6"
    [ -z "$cam_id" ] && { echo '{"status":"error","message":"Missing cam_id"}'; return 1; }
    init_config
    
    if [ -n "$target" ]; then
        [ "$target" = "nas" ] && target="1"
        [ "$target" = "default" ] && target="1"
        [ "$target" = "nas_cloud" ] && target="1"
        [ "$target" = "nas_telegram" ] && target="2"
        [ "$target" = "telegram" ] && target="3"
        [ "$target" = "tg_instant" ] && target="3"
        [ "$target" = "ephemeral_tg" ] && target="3"
        [ "$target" = "ephemeral" ] && target="4"
        [ "$target" = "cloud" ] && target="4"
        [ "$target" = "low_traffic_auto" ] && target="5"
        uci set camera.${cam_id}.storage_target="$target"
        uci set camera.${cam_id}.nvr_mode="$target"
        uci set camera.settings.nvr_mode="$target"
    fi
    
    if [ -n "$duration" ]; then
        [ "$duration" = "default" ] && duration="15"
        uci set camera.${cam_id}.duration="$duration"
        if uci -q get cctv_bot.${cam_id} >/dev/null; then
            uci set cctv_bot.${cam_id}.duration="$duration"
            uci commit cctv_bot
        fi
    fi
    
    if [ -n "$rec_247" ]; then
        uci set camera.${cam_id}.record_247="$rec_247"
    fi

    if [ -n "$cloud_rem" ]; then
        [ "$cloud_rem" = "default" ] && cloud_rem=""
        uci set camera.${cam_id}.cloud_remote="$cloud_rem"
    fi

    if [ -n "$pass" ]; then
        uci set camera.${cam_id}.password="$pass"
        if uci -q get cctv_bot.${cam_id} >/dev/null; then
            local old_rtsp=$(uci -q get cctv_bot.${cam_id}.rtsp_url)
            if [ -n "$old_rtsp" ]; then
                local new_rtsp=$(echo "$old_rtsp" | sed -E "s|://[^:]+:[^@]+@|://admin:${pass}@|")
                uci set cctv_bot.${cam_id}.rtsp_url="$new_rtsp"
                uci commit cctv_bot
            fi
        fi
    fi
    
    uci commit camera
    # Tức thì khởi động lại phân đoạn ghi hiện tại nếu daemon 24/7 đang chạy để áp dụng thời lượng và nơi lưu mới
    for sp in $(pgrep -f "cloud_cam_streamer\.sh stream $cam_id" 2>/dev/null); do
        kill -15 "$sp" 2>/dev/null
    done
    logger -t cloud_cam "Cam config updated for ${cam_id}: target=${target}, duration=${duration}, 247=${rec_247}, remote=${cloud_rem}"
    echo "{\"status\":\"ok\",\"cam_id\":\"$cam_id\",\"storage_target\":\"$target\",\"duration\":\"$duration\",\"record_247\":\"$rec_247\",\"cloud_remote\":\"$cloud_rem\"}"
}

set_cam_pass() {
    local cam_id="$1"
    local pass="$2"
    [ -z "$cam_id" ] && { echo '{"status":"error","message":"Missing cam_id"}'; return 1; }
    init_config
    uci set camera.${cam_id}.password="$pass"
    uci commit camera
    logger -t cloud_cam "Password/Safety code updated for camera ${cam_id}"
    echo "{\"status\":\"ok\",\"cam_id\":\"$cam_id\",\"message\":\"Safety code saved successfully\"}"
}

set_offpeak_window() {
    local start_t="$1"
    local end_t="$2"
    [ -z "$start_t" ] && start_t="00:00"
    [ -z "$end_t" ] && end_t="05:30"
    init_config
    uci set camera.settings.offpeak_start="$start_t"
    uci set camera.settings.offpeak_end="$end_t"
    uci commit camera
    logger -t cloud_cam "Off-peak cloud sync window set to: ${start_t} - ${end_t}"
    echo "{\"status\":\"ok\",\"offpeak_start\":\"$start_t\",\"offpeak_end\":\"$end_t\"}"
}

sync_offpeak_to_cloud() {
    init_config
    logger -t cloud_cam "Bắt đầu tiến trình tự chủ đẩy video camera lên Cloud và giải phóng bộ nhớ NAS..."
    
    local purge_on_success=$(uci -q get camera.settings.purge_after_sync || echo "1")
    local storage_pct=$(df -P /mnt/storage 2>/dev/null | tail -1 | awk '{gsub("%","",$5); print $5}')
    [ -z "$storage_pct" ] && storage_pct=0
    # Luôn tự động xóa sau khi đẩy thành công nếu bộ nhớ >= 70% hoặc purge_after_sync != 0
    if [ "$storage_pct" -ge 70 ]; then
        purge_on_success="1"
    fi

    local synced_count=0
    local total_bytes=0
    local tmp_list="/tmp/.clips_to_offload.$$"

    for s in $(uci show camera 2>/dev/null | grep "=camera" | cut -d'.' -f2 | cut -d'=' -f1); do
        local c_target=$(uci -q get camera.${s}.storage_target)
        [ -z "$c_target" ] || [ "$c_target" = "default" ] && c_target=$(get_storage_target)
        local t_mode=$(echo "$c_target" | cut -d':' -f1)
        [ "$t_mode" = "nas" ] && t_mode="emmc"

        # Đẩy clip cho các camera cài đặt cloud_offpeak, phone_cloud_offpeak, hoặc khi bộ nhớ NAS sắp đầy (>= 75%)
        if [ "$t_mode" = "cloud_offpeak" ] || [ "$t_mode" = "cloud_immediate" ] || [ "$t_mode" = "phone_cloud_offpeak" ] || [ "$t_mode" = "phone_cloud_immediate" ] || [ "$storage_pct" -ge 75 ] || [ "$1" = "force" ]; then
            local nas_base=$(get_nas_dir "$c_target")
            [ ! -d "$nas_base" ] && continue
            
            local c_name=$(uci -q get camera.${s}.name || echo "Camera_${s}")
            local cam_dir="${nas_base}/${c_name}"
            [ ! -d "$cam_dir" ] && continue
            
            local remote=$(get_remote "$s")
            local folder=$(get_config_val "settings" "cloud_folder" "$DEFAULT_CLOUD_FOLDER")
            
            # Tìm các file video đã ghi xong (cách đây > 2 phút, không bị khóa ghi bởi ffmpeg)
            rm -f "$tmp_list" 2>/dev/null
            find "$cam_dir" -type f -name "Clip_*.mkv" -mmin +2 2>/dev/null | sort > "$tmp_list"
            
            if [ -s "$tmp_list" ]; then
                while read -r f; do
                    [ -z "$f" ] || [ ! -f "$f" ] && continue
                    local f_size=$(wc -c < "$f" 2>/dev/null || echo 0)
                    [ "$f_size" -lt 1024 ] && continue

                    local rel_path=$(echo "$f" | sed "s|^${nas_base}/||")
                    local rel_dir=$(dirname "$rel_path")
                    local dest_url="${remote}:${folder}/${rel_dir}/"
                    
                    logger -t cloud_cam "Đang đẩy clip lên Cloud: $rel_path (${f_size} bytes) -> ${dest_url}"
                    
                    local cur_h=$(date +%H)
                    local bw_opt=""
                    # Ban ngày (06:00 - 23:59): Giới hạn an toàn 2.5MB/s để bảo vệ ping chơi game, xem phim gia đình
                    # Ban đêm (00:00 - 05:30): Mở 100% băng thông tối đa để dọn sạch eMMC
                    if [ "$cur_h" -ge 6 ] && [ "$cur_h" -lt 24 ] && [ "$1" != "force_max" ]; then
                        bw_opt="--bwlimit 2.5M"
                    fi

                    # 🎮 MA TRẬN ƯU TIÊN GAME & HỌP TRỰC TUYẾN (SUB-10MS PING SHIELD)
                    # Nếu phát hiện có máy đang chơi game (Liên Quân, Tốc Chiến, LOL, CS2) hoặc gọi họp (Zoom, Meet, Teams)
                    # Tự động đạp phanh Upload Camera xuống 256KB/s để bảo vệ triệt để độ trễ Ping < 15ms!
                    if [ -f /tmp/game_mode_active ] || ([ -x /usr/bin/game_booster.sh ] && /usr/bin/game_booster.sh is_gaming_active 2>/dev/null); then
                        bw_opt="--bwlimit 256k"
                        logger -t cloud_cam "🎮/📞 [PRIORITY MATRIX] Phát hiện thiết bị chơi Game / Họp trực tuyến: Đạp phanh Upload Camera còn 256KB/s (Ping Shield ON)!"
                    fi

                    if [ "$purge_on_success" = "1" ]; then
                        # SỬ DỤNG RCLONE MOVE: Chuyển lên Cloud và CHỈ XÓA FILE CỤC BỘ KHI XÁC THỰC THÀNH CÔNG 100%!
                        if /usr/bin/rclone move "$f" "${dest_url}" --buffer-size 4M --transfers 1 $bw_opt >/dev/null 2>&1; then
                            logger -t cloud_cam "✅ Đã đẩy thành công lên Cloud và xóa file gốc giải phóng NAS: $rel_path"
                            synced_count=$(( synced_count + 1 ))
                            total_bytes=$(( total_bytes + f_size ))
                        else
                            logger -t cloud_cam "⚠️ Lỗi khi đẩy $f lên ${dest_url} - File gốc vẫn được giữ an toàn trên NAS!"
                        fi
                    else
                        # Sao chép và giữ lại nếu cấu hình không tự xóa
                        if /usr/bin/rclone copy "$f" "${dest_url}" --buffer-size 4M --transfers 1 $bw_opt >/dev/null 2>&1; then
                            logger -t cloud_cam "✅ Đã đẩy lên Cloud (giữ file trên NAS): $rel_path"
                            synced_count=$(( synced_count + 1 ))
                            total_bytes=$(( total_bytes + f_size ))
                        else
                            logger -t cloud_cam "⚠️ Lỗi khi copy $f lên ${dest_url}"
                        fi
                    fi
                done < "$tmp_list"
            fi
            rm -f "$tmp_list" 2>/dev/null
            find "$cam_dir" -type d -empty -delete 2>/dev/null
        fi
    done

    find /mnt/storage/airdrop/Camera_NAS -type d -empty -delete 2>/dev/null
    local total_mb=$(( total_bytes / 1048576 ))
    logger -t cloud_cam "Hoàn tất đẩy Cloud tự chủ: Đã xử lý $synced_count clip (${total_mb} MB)."

    echo "{\"status\":\"ok\",\"synced\":$synced_count,\"freed_mb\":$total_mb,\"message\":\"Hoan tat day Cloud va don dep NAS\"}"
}

toggle_cam_247() {
    local cam_id="$1"
    local req_state="$2"
    [ -z "$cam_id" ] && { echo '{"status":"error","message":"Missing cam_id"}'; return 1; }
    init_config
    local cur=$(uci -q get camera.${cam_id}.record_247 || echo "1")
    local cur_bot=$(uci -q get cctv_bot.${cam_id}.enabled || echo "1")
    local new_state="$req_state"
    if [ -z "$new_state" ]; then
        if [ "$cur" = "0" ] || [ "$cur_bot" = "0" ]; then new_state="1"; else new_state="0"; fi
    fi
    
    local c_label=$(uci -q get camera.${cam_id}.label || uci -q get camera.${cam_id}.name || echo "$cam_id")
    uci set camera.${cam_id}.record_247="$new_state"
    uci commit camera
    uci set cctv_bot.${cam_id}.enabled="$new_state"
    uci commit cctv_bot
    
    if [ "$new_state" = "1" ]; then
        # Ensure global master recorder is enabled
        uci set camera.settings.record_247='1'
        uci commit camera
        
        if [ -x "/usr/bin/cloud_cam_recorder_daemon.sh" ]; then
            if ! pgrep -f "cloud_cam_recorder_daemon\.sh master" >/dev/null 2>&1; then
                /usr/bin/cloud_cam_recorder_daemon.sh start >/dev/null 2>&1 &
            else
                if ! pgrep -f "cloud_cam_recorder_daemon\.sh loop $cam_id" >/dev/null 2>&1; then
                    /usr/bin/cloud_cam_recorder_daemon.sh loop "$cam_id" >/dev/null 2>&1 &
                fi
            fi
        fi
        
        # Start CCTV bot listener for this camera if not already active
        local b_tok=$(uci -q get cctv_bot.${cam_id}.bot_token)
        if [ -n "$b_tok" ] && [ -x /usr/bin/cctv_bot_daemon.sh ]; then
            if ! pgrep -f "cctv_bot_daemon\.sh listener $cam_id" >/dev/null 2>&1; then
                /usr/bin/cctv_bot_daemon.sh listener "$cam_id" >/dev/null 2>&1 &
            fi
        fi
        logger -t cloud_cam "🟢 Camera ${cam_id} (${c_label}) đã được BẬT thành công!"
        echo "{\"status\":\"ok\",\"cam_id\":\"$cam_id\",\"record_247\":1,\"enabled\":1,\"message\":\"Đã BẬT ${c_label}\"}"
    else
        # Stop worker loop for this camera
        for p in $(pgrep -f "cloud_cam_recorder_daemon\.sh loop $cam_id" 2>/dev/null); do
            kill -9 "$p" 2>/dev/null
        done
        # Stop active streamer instance for this camera
        for p in $(pgrep -f "cloud_cam_streamer\.sh stream $cam_id" 2>/dev/null); do
            kill -15 "$p" 2>/dev/null
        done
        # Stop any active ffmpeg process for this camera IP
        local cam_ip=$(uci -q get camera.${cam_id}.ip)
        if [ -n "$cam_ip" ]; then
            for p in $(pgrep -f "ffmpeg.*$cam_ip" 2>/dev/null); do
                kill -15 "$p" 2>/dev/null
            done
        fi
        # Stop CCTV bot listener for this camera
        for p in $(pgrep -f "cctv_bot_daemon\.sh listener $cam_id" 2>/dev/null); do
            kill -9 "$p" 2>/dev/null
        done
        logger -t cloud_cam "🔴 Camera ${cam_id} (${c_label}) đã được TẮT thành công!"
        echo "{\"status\":\"ok\",\"cam_id\":\"$cam_id\",\"record_247\":0,\"enabled\":0,\"message\":\"Đã TẮT ${c_label}\"}"
    fi
}

case "$1" in
