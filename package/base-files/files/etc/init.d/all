              const chg = p0.charging ? '⚡' : '🔋';
              document.getElementById('battery-val').innerHTML = `${p0.battery}% <small style="font-size:13px">${chg}</small>`;
              document.getElementById('phone-status').textContent = p0.is_alive ? '🟢 Online WebDAV' : '🔴 Offline';
              if (p0.battery >= 80) {
                document.getElementById('interlock-label').textContent = '🛡️ Đạt 80% (Ngắt Sạc Bảo Vệ)';
              } else if (p0.battery <= 30) {
                document.getElementById('interlock-label').textContent = '⚡ Pin < 30% (Đang Bật Sạc)';
              } else {
                document.getElementById('interlock-label').textContent = '✅ Chu kỳ vàng: 30% - 80%';
              }
            }
          }
        }
      } catch (e) {}
    }
    setInterval(fetchTelemetry, 2500);
    fetchTelemetry();

    // 3. Fullscreen & WakeLock API
    async function toggleKioskFull() {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(() => {});
        try {
          if ('wakeLock' in navigator) {
            await navigator.wakeLock.request('screen');
          }
        } catch (e) {}
      } else {
        document.exitFullscreen().catch(() => {});
      }
    }
