#!/bin/sh
# /usr/bin/send_daily_morning_report.sh - Báo cáo duy nhất lúc 07:00 AM mỗi sáng
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export TZ=Asia/Ho_Chi_Minh

