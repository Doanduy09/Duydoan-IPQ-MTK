                        '⚡ Wi-Fi 6 HE160 (Kênh ' + (d.channel || 36) + ') • Tốc độ: <b style="color: #000000;">2402.0 Mbps</b> • Cấp DHCP & Chia sẻ Internet 5G' +
                    '</div>' +
                    (!isCtrl ? 
                        ('<div style="margin-top: 10px;">' +
                            '<a href="http://192.168.1.1" target="_blank" class="btn" style="display: inline-block; background: #ffffff; color: #000000; font-size: 12.5px; font-weight: 800; padding: 6px 16px; border-radius: 6px; text-decoration: none; border: 1px solid #34d399;">🌐 Mở Quản Trị Router Chính (192.168.1.1) ↗</a>' +
                        '</div>') : '') +
                '</div>' +
            '</div>';

            // ĐƯỜNG NỐI SÓNG VÀ ROUTER PHỤ THỜI GIAN THỰC
            var linkAndNodesHtml = '';

            if (rawPeers.length > 0) {
                // ĐÃ CÓ ROUTER PHỤ KẾT NỐI
                rawPeers.forEach(function(p, idx) {
                    var pIp = p.ip || ('192.168.1.' + (idx + 2));
                    var pName = p.name || ('Router Phụ ' + (idx + 1));
                    var pSignal = p.signal || '-42 dBm';
                    var pBitrate = p.bitrate || '2402.0 Mbps (HE160)';
                    var pRawRate = p.raw_bitrate || '';
                    var pQuality = p.quality || 'excellent';
                    var pAdvice = p.advice || '🟢 ĐÃ TỐI ƯU HOÀN HẢO (Sóng cực mạnh, đạt max tốc độ 2402 Mbps)';

                    var badgeBg = 'rgba(16, 185, 129, 0.2)';
                    var badgeBorder = '#10b981';
                    var badgeColor = '#34d399';
