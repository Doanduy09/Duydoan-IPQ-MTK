        var nasToggleTokenBtn = E('button', {
            class: 'btn cbi-button',
            style: 'font-size: 11.5px; font-weight: 700; padding: 6px 10px; background: transparent; border: 1px dashed #94a3b8; color: #000000; border-radius: 6px; cursor: pointer; white-space: nowrap;',
            click: function() {
                var isHidden = (nasTokenWrapper.style.display === 'none');
                nasTokenWrapper.style.display = isHidden ? 'block' : 'none';
                nasToggleTokenBtn.textContent = isHidden ? '▲ Ẩn Cấu Hình Cloudflare' : '▼ Cấu Hình Cloudflare 1-Click / Token (Nâng Cao)';
            }
        }, '▼ Cấu Hình Cloudflare 1-Click / Token (Nâng Cao)');

        function refreshRemoteDomainStatus() {
            fetch('/cgi-bin/airdrop?action=check_funnel&t=' + Date.now())
                .then(function(r) { return r.json(); })
                .then(function(d) {
                    if (!d) return;
                    nasActivePublicUrl = d.funnel_url || '';
                    if (d.custom_domain) {
                        nasCustomDomainInput.value = d.custom_domain;
                    }
                    if (d.cf_token) {
                        nasCfTokenInput.value = d.cf_token;
                    }
                    if (d.cf_email && nasCfAutoEmailInput) {
                        nasCfAutoEmailInput.value = d.cf_email;
                    }
                    if (d.cf_key && nasCfAutoKeyInput) {
                        nasCfAutoKeyInput.value = d.cf_key;
                    }

                    if (d.is_custom || (d.custom_domain && d.custom_domain.length > 0)) {
                        if (d.custom_domain.indexOf('100.') !== -1 || d.custom_domain.indexOf('.ts.net') !== -1) {
                            nasDomainBadge.textContent = '🔒 Giải Pháp 3: Tailscale Cố Định (' + d.custom_domain + ')';
                            nasDomainBadge.style.background = '#f5f3ff';
                            nasDomainBadge.style.borderColor = '#ddd6fe';
                            nasDomainBadge.style.color = '#6d28d9';
                        } else {
                            nasDomainBadge.textContent = '🟢 Giải Pháp 2: Tên Miền Riêng ' + d.custom_domain + ' (Đang áp dụng)';
                            nasDomainBadge.style.background = '#ecfdf5';
                            nasDomainBadge.style.borderColor = '#a7f3d0';
                            nasDomainBadge.style.color = '#047857';
                        }
                    } else if (d.funnel_url && d.funnel_url.indexOf('trycloudflare.com') !== -1) {
                        nasDomainBadge.textContent = '⚡ Giải Pháp 1: Cloudflare Quick Tunnel Tự Động (0đ)';
                        nasDomainBadge.style.background = '#f0f9ff';
                        nasDomainBadge.style.borderColor = '#bae6fd';
                        nasDomainBadge.style.color = '#0369a1';
                    } else if (d.funnel_url && d.funnel_url.indexOf('.ts.net') !== -1) {
                        nasDomainBadge.textContent = '🔒 Giải Pháp 3: Tailscale Funnel Toàn Cầu (0đ - HTTPS)';
                        nasDomainBadge.style.background = '#f0fdf4';
                        nasDomainBadge.style.borderColor = '#86efac';
                        nasDomainBadge.style.color = '#15803d';
                    } else if (d.tailscale_ip && d.tailscale_ip !== '127.0.0.1') {
                        nasDomainBadge.textContent = '🔒 Giải Pháp 3: Tailscale Network (' + d.tailscale_ip + ')';
                        nasDomainBadge.style.background = '#f5f3ff';
                        nasDomainBadge.style.borderColor = '#ddd6fe';
                        nasDomainBadge.style.color = '#6d28d9';
                    } else {
                        nasDomainBadge.textContent = '🏠 Mạng Nội Bộ (LAN)';
                        nasDomainBadge.style.background = '#f1f5f9';
                        nasDomainBadge.style.borderColor = '#cbd5e1';
                        nasDomainBadge.style.color = '#475569';
                    }

                    if (nasActivePublicUrl) {
                        nasDomainActiveLink.textContent = nasActivePublicUrl;
                        nasDomainActiveLink.href = nasActivePublicUrl;
                        nasDomainOpenBtn.href = nasActivePublicUrl;
                        nasDomainCopyBtn.style.display = 'inline-block';
                        nasDomainOpenBtn.style.display = 'inline-block';
                    } else {
                        nasDomainActiveLink.textContent = 'Chưa có liên kết ngoại mạng';
                        nasDomainCopyBtn.style.display = 'none';
                        nasDomainOpenBtn.style.display = 'none';
                    }
                }).catch(function() {});
        }

