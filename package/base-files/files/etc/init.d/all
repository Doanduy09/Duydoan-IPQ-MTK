    <!-- MODAL: ĐIỀU KHIỂN & XEM MÀN HÌNH ĐIỆN THOẠI TỪ XA -->
    <div class="modal-backdrop" id="phoneRemoteModal">
        <div class="modal-window" style="max-width: 520px;">
            <div class="modal-header">
                <h3 class="modal-title">📱 Điều Khiển Điện Thoại Từ Xa: <span id="remotePhoneTitle" style="color:var(--primary-neon);"></span></h3>
