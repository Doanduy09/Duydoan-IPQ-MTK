        function openGeminiModal() {
            ui.showModal('Đang tải cấu hình Gemini AI...', [ E('p', { class: 'spinning' }, 'Đang kiểm tra trạng thái Google Gemini AI...') ]);
            fetch('/cgi-bin/airdrop?action=gemini_status')
                .then(function(r) { return r.json(); })
                .then(function(d) {
                    var curMasked = d.masked_key || 'Chưa cài đặt';
                    var isConf = d.configured;
                    var keyInput = E('input', {
                        type: 'text',
                        class: 'cbi-input-text',
                        placeholder: 'Dán mã API Key mới tại đây (bắt đầu bằng AIza... hoặc AQ....)',
                        style: 'width: 100%; font-weight: bold; font-size: 13.5px; padding: 8px 12px; border-radius: 6px; box-sizing: border-box; margin-top: 6px;'
                    });
                    var statusBadge = E('span', {
                        style: 'display: inline-block; padding: 4px 10px; border-radius: 6px; font-weight: 700; font-size: 12.5px; background: ' + (isConf ? '#dcfce7; color: #000000; border: 1px solid #86efac;' : '#fee2e2; color: #000000; border: 1px solid #fca5a5;')
                    }, isConf ? ('🟢 Đã Cấu Hình: ' + curMasked) : '⚠️ Chưa Cấu Hình Key');

                    var testResultBox = E('div', {
                        id: 'gemini-test-result-box',
                        style: 'display: none; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 6px; padding: 10px; font-size: 13px; line-height: 1.4; margin-top: 10px;'
                    });

                    var btnSaveKey = E('button', {
                        class: 'btn cbi-button cbi-button-action',
                        style: 'font-weight: 800; font-size: 13.5px; padding: 8px 16px; border-radius: 6px; background: #ffffff; color: #000000;',
                        click: function(ev) {
                            var val = keyInput.value.trim();
                            if (val.length < 20) {
                                alert('⚠️ Vui lòng nhập API Key hợp lệ (tối thiểu 20 ký tự)!');
                                return;
                            }
                            ev.target.disabled = true;
                            ev.target.textContent = '⏳ Đang lưu & kích hoạt...';
                            fetch('/cgi-bin/airdrop?action=gemini_set_key&key=' + encodeURIComponent(val))
                                .then(function(r) { return r.json(); })
                                .then(function(res) {
                                    ev.target.disabled = false;
                                    ev.target.textContent = '💾 Lưu & Kích Hoạt Key';
                                    if (res.status === 'success' || res.status === 'warning') {
                                        ui.addNotification(null, E('p', res.message), res.status === 'success' ? 'info' : 'warning');
                                        openGeminiModal();
                                    } else {
                                        alert('❌ Lỗi: ' + (res.message || 'Không thể lưu key'));
                                    }
                                }).catch(function(err) {
                                    ev.target.disabled = false;
                                    ev.target.textContent = '💾 Lưu & Kích Hoạt Key';
                                    alert('❌ Lỗi mạng: ' + err);
                                });
                        }
                    }, '💾 Lưu & Kích Hoạt Key');

                    var btnTestKey = E('button', {
                        class: 'btn cbi-button',
                        style: 'font-weight: 700; font-size: 13px; padding: 8px 14px; border-radius: 6px;',
                        click: function(ev) {
                            ev.target.disabled = true;
                            ev.target.textContent = '⏳ Đang kết nối Google AI...';
                            testResultBox.style.display = 'block';
                            testResultBox.innerHTML = '⏳ Đang gửi truy vấn thử nghiệm tới máy chủ Google Gemini...';
                            fetch('/cgi-bin/airdrop?action=gemini_test')
                                .then(function(r) { return r.json(); })
                                .then(function(res) {
                                    ev.target.disabled = false;
                                    ev.target.textContent = '🔄 Kiểm Tra Kết Nối AI';
                                    if (res.status === 'success') {
                                        testResultBox.style.background = '#f0fdf4';
                                        testResultBox.style.borderColor = '#86efac';
                                        testResultBox.style.color = '#166534';
                                        testResultBox.innerHTML = '🟢 <b>Kết Nối Thành Công:</b> Google AI phản hồi: ' + (res.response || 'OK');
                                    } else {
                                        testResultBox.style.background = '#fef2f2';
                                        testResultBox.style.borderColor = '#fca5a5';
                                        testResultBox.style.color = '#b91c1c';
                                        testResultBox.innerHTML = '❌ <b>Thất Bại:</b> ' + (res.message || res.response || 'Không thể kết nối');
                                    }
                                }).catch(function(err) {
                                    ev.target.disabled = false;
                                    ev.target.textContent = '🔄 Kiểm Tra Kết Nối AI';
                                    testResultBox.innerHTML = '❌ Lỗi kết nối mạng: ' + err;
                                });
                        }
                    }, '🔄 Kiểm Tra Kết Nối AI');

                    var modalContent = [
                        E('div', { style: 'display: flex; flex-direction: column; gap: 12px;' }, [
                            E('div', { style: 'display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px;' }, [
