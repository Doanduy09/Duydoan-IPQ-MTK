                                <button class="btn-sub" style="padding:3px 8px; font-size:0.75rem; border-color:var(--accent-red); color:var(--accent-red);" title="Xóa tài khoản" onclick="deleteCloudAccount('${escapeHtml(c.id)}')">🗑️</button>
                            </div>
                        </td>
                    </tr>
                `;
            });
