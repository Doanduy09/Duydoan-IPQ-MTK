                        E('div', { style: 'flex: 1;' }, [
                            E('div', { style: 'font-weight: 700; color: #cf222e; font-size: 14.5px; margin-bottom: 6px;' },
                                'SIM Ngo\u00E0i Danh S\u00E1ch ICCID - \u0110\u00C3 KH\u00D3A CH\u1EB6T 100% (Tuy\u1EC7t \u0110\u1ED1i Kh\u00F4ng L\u00EAn L\u1ECBch)'
