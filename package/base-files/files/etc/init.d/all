    cat << 'CCTV_ARBITER_EOF' > /usr/bin/cctv_upload_arbiter.sh
#!/bin/sh
# ==============================================================================
# 🧠 AI CCTV UPLOAD ARBITER & SMART QoS TRAFFIC MONITOR v5.0
# Điều phối tải video camera thông minh theo điều kiện thực tế:
# 1. Nhận diện thấp điểm thông minh (Smart Off-Peak):
#    - Đếm thiết bị người dùng thực tế online (loại trừ IoT tĩnh: TV, Loa, Camera, Printer)
#    - Đo lưu lượng Upload WAN (wwan0) thời gian thực
#    - Kiểm tra độ trễ Ping & Chế độ Game Booster
#    - Đủ điều kiện -> OFFPEAK_FULL (Chủ động quay Full Video 2K/4K trên RAM và đẩy siêu tốc)
# 2. Nhận diện cao điểm / nghẽn mạng:
#    - Nhiều thiết bị / Đang chơi Game / Upload nghẽn -> PEAK_THROTTLE (Quay Sub-stream tiết kiệm)
# ==============================================================================

ACTION="${1:-check}"
CAM_ID="$2"

check_nas_health() {
    local target_cam="$1"
    local cam_tgt=""
    if [ -n "$target_cam" ]; then
        cam_tgt=$(uci -q get camera.${target_cam}.storage_target)
    fi
    [ -z "$cam_tgt" ] && cam_tgt=$(uci -q get camera.settings.storage_target || echo "nas")

    local emmc_ok=0
    if df -P /mnt/storage 2>/dev/null | grep -q "/mnt/storage"; then
        if touch /mnt/storage/.arbiter_test 2>/dev/null; then
            rm -f /mnt/storage/.arbiter_test 2>/dev/null
            local free_mb=$(df -m /mnt/storage 2>/dev/null | awk 'NR==2 {print $4}')
            if [ -n "$free_mb" ] && [ "$free_mb" -ge 200 ]; then
                emmc_ok=1
            fi
        fi
    fi

    local phone_ok=0
    if echo "$cam_tgt" | grep -q "phone"; then
        local phone_ip=$(uci -q get nas_phone.settings.phone_ip)
        local phone_port=$(uci -q get nas_phone.settings.phone_port || echo "8080")
        
        local node_name=$(echo "$cam_tgt" | cut -d':' -f2 -s)
        if [ -n "$node_name" ]; then
            for s in $(uci show nas_phone 2>/dev/null | grep "=phone_node" | cut -d'.' -f2 | cut -d'=' -f1); do
                local sname=$(uci -q get nas_phone.${s}.name)
                if [ "$sname" = "$node_name" ] || [ "$s" = "$node_name" ]; then
                    phone_ip=$(uci -q get nas_phone.${s}.ip)
                    phone_port=$(uci -q get nas_phone.${s}.port || echo "8080")
                    break
                fi
            done
        fi

        if [ -n "$phone_ip" ]; then
            if ping -c 1 -W 1 "$phone_ip" >/dev/null 2>&1; then
                if nc "$phone_ip" "$phone_port" < /dev/null >/dev/null 2>&1; then
                    phone_ok=1
                fi
            fi
        fi
    fi

    if [ "$emmc_ok" -eq 0 ] && [ "$phone_ok" -eq 0 ]; then
        logger -t cctv_arbiter "🚨 EMERGENCY: Cả ổ cứng eMMC và Phone NAS đều không khả dụng! Kích hoạt chế độ đẩy RAM khẩn cấp!"
        echo "EMERGENCY"
        return 0
    fi
    echo "HEALTHY"
    return 0
}

# Đếm số lượng thiết bị người dùng thực tế (loại trừ camera, loa, tv, máy in)
count_active_users() {
    local cnt=0
    while read -r lip lhw lflags lmac lmask ldev; do
        [ "$lmac" = "00:00:00:00:00:00" ] && continue
        [ "$lflags" != "0x2" ] && continue
        local lmac_low=$(echo "$lmac" | tr '[:upper:]' '[:lower:]')
        case "$lmac_low" in
            a0:bd:1d:d5:1f:95|a0:bd:1d:d5:2e:e6) continue ;; # Cameras
            4c:23:38:79:42:a0) continue ;; # Printer Brother
            bc:87:fa:0f:43:82) continue ;; # Loa Bose
            5c:c5:63:d4:17:1e) continue ;; # Smart TV
            8e:e8:ac:e6:6b:bd|bc:32:b2:e9:fd:49) continue ;; # NAS Devices
        esac
        # Ping nhanh 200ms kiểm tra phản hồi
        if ping -c 1 -W 1 "$lip" >/dev/null 2>&1; then
            cnt=$(( cnt + 1 ))
        fi
    done < /proc/net/arp
    [ "$cnt" -lt 1 ] && cnt=1
    echo "$cnt"
}

# Đo lưu lượng Upload thực tế trên cổng WAN (KB/s)
get_wan_upload_rate() {
    local wan_if=$(ip route show default 2>/dev/null | grep -o 'dev [^ ]*' | head -n 1 | cut -d' ' -f2)
    [ -z "$wan_if" ] && wan_if="wwan0"
    local tx_kbs=0
    if [ -d "/sys/class/net/$wan_if" ]; then
        local tx1=$(cat "/sys/class/net/$wan_if/statistics/tx_bytes" 2>/dev/null || echo 0)
        sleep 1
        local tx2=$(cat "/sys/class/net/$wan_if/statistics/tx_bytes" 2>/dev/null || echo 0)
        tx_kbs=$(( (tx2 - tx1) / 1024 ))
        [ "$tx_kbs" -lt 0 ] && tx_kbs=0
    fi
    echo "$tx_kbs"
}

check_network_load() {
    # 0. Bộ đệm RAM TTL 30 giây (Triệt tiêu 95% lệnh Ping & chu kỳ CPU thừa)
    local cache_file="/tmp/arbiter_net_policy.cache"
    local now_ts=$(date +%s)
    local last_ts=0
    if [ -f "$cache_file" ]; then
        last_ts=$(head -n 1 "$cache_file" 2>/dev/null || echo 0)
        if [ $((now_ts - last_ts)) -lt 30 ]; then
            sed -n '2p' "$cache_file" 2>/dev/null
            return 0
        fi
    fi

    local new_policy="ALLOW_FULL"
    local log_detail=""

    # 1. Kiểm tra Chế độ Game / Ping Shield
    if [ -f /tmp/game_mode_active ] || [ -f /tmp/ping_shield_active ]; then
        new_policy="PEAK_HOLD"
        log_detail="Game Booster / Ping Shield is active"
    else
        # 2. Đếm số lượng người dùng thực tế đang online
        local user_count=$(count_active_users)

        # 3. Đo tốc độ Upload đường truyền hiện tại
        local tx_kbs=$(get_wan_upload_rate)

        # 4. Kiểm tra độ trễ mạng (Ping trung bình tới 1.1.1.1)
        local ping_val=$(ping -c 2 -W 1 1.1.1.1 2>/dev/null | grep 'time=' | tail -1 | sed 's/.*time=//' | cut -d'.' -f1)
        [ -z "$ping_val" ] && ping_val=65

        # 🌟 ĐIỀU KIỆN THẤP ĐIỂM THÔNG MINH (OFFPEAK_FULL - QUAY FULL VIDEO 2K/4K):
        if [ "$user_count" -le 2 ] || [ "$tx_kbs" -lt 500 ]; then
            if [ "$ping_val" -lt 180 ]; then
                new_policy="OFFPEAK_FULL"
                log_detail="Smart Off-peak: ${user_count} users, Upload ${tx_kbs}KB/s, Ping ${ping_val}ms -> Full Video Mode"
            fi
        elif [ "$user_count" -ge 5 ] || [ "$tx_kbs" -gt 1500 ] || [ "$ping_val" -gt 220 ]; then
            new_policy="PEAK_THROTTLE"
            log_detail="High load: ${user_count} users, Upload ${tx_kbs}KB/s, Ping ${ping_val}ms -> Sub-stream Mode"
        else
            new_policy="ALLOW_FULL"
            log_detail="Normal load: ${user_count} users, Upload ${tx_kbs}KB/s -> Full Mode"
        fi
    fi

    # 5. Lưu cache 30s vào RAM
    printf "%s\n%s\n" "$now_ts" "$new_policy" > "$cache_file" 2>/dev/null

    # 6. State-Transition Logging (Chỉ ghi log syslog khi trạng thái thay đổi)
    local last_state_file="/tmp/arbiter_last_state.txt"
    local prev_policy=$(cat "$last_state_file" 2>/dev/null)
    if [ "$new_policy" != "$prev_policy" ]; then
        echo "$new_policy" > "$last_state_file" 2>/dev/null
        logger -t cctv_arbiter "AI Arbiter: ${new_policy} (${log_detail})"
    fi

    echo "$new_policy"
    return 0
}

# 🛡️ RAM SAFETY WATCHDOG & EMERGENCY EVICTION ENGINE (Chống tràn RAM 100%)
check_and_evict_ram() {
    local ram_buf_dir="/tmp/cctv_ram_buffer"
    [ ! -d "$ram_buf_dir" ] && return 0
    
    local cur_mb=$(du -sm "$ram_buf_dir" 2>/dev/null | awk '{print $1}')
    [ -z "$cur_mb" ] && cur_mb=0
    local free_ram_mb=$(awk '/MemAvailable:/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 400)
    
    # Ngưỡng an toàn: Nếu thư mục đệm RAM >= 120MB HOẶC RAM khả dụng < 100MB
    if [ "$cur_mb" -ge 120 ] || [ "$free_ram_mb" -lt 100 ]; then
        logger -t cctv_arbiter "⚠️ RAM WATERMARK ALERT: Buffer=${cur_mb}MB, FreeRAM=${free_ram_mb}MB. Triggering Emergency Eviction!"
        
        # 1. Quét các file video hoàn tất (không bị ffmpeg lock)
        for f in $(ls -tr "$ram_buf_dir"/*.mkv "$ram_buf_dir"/*.mp4 2>/dev/null); do
            if lsof "$f" 2>/dev/null | grep -q ffmpeg; then
                continue
            fi
            
            # Ưu tiên 1: Đẩy sang Phone NAS qua Wi-Fi nội bộ
            local phone_ok=0
            local active_phone="192.168.1.155:8080"
            if curl -s -m 2 -I "http://${active_phone}/" >/dev/null 2>&1; then
                local bname=$(basename "$f")
                curl -s -m 3 -X MKCOL "http://${active_phone}/Camera_NAS/Spillover/" >/dev/null 2>&1
                if curl -s -m 25 -T "$f" "http://${active_phone}/Camera_NAS/Spillover/${bname}" >/dev/null 2>&1; then
                    rm -f "$f" 2>/dev/null
                    logger -t cctv_arbiter "Evicted $bname to Phone NAS ($active_phone)"
                    phone_ok=1
                fi
            fi
            
            # Ưu tiên 2: Nếu Phone NAS offline, chuyển sang ổ eMMC 110GB (/mnt/storage/cctv_spillover)
            if [ "$phone_ok" -eq 0 ] && [ -d /mnt/storage ]; then
                mkdir -p /mnt/storage/cctv_spillover
                if mv "$f" /mnt/storage/cctv_spillover/ 2>/dev/null; then
                    logger -t cctv_arbiter "Evicted $f to eMMC /mnt/storage/cctv_spillover"
                    continue
                fi
            fi
            
            # Ưu tiên 3: Xóa file cũ nhất nếu không còn lối thoát
            if [ "$phone_ok" -eq 0 ]; then
                rm -f "$f" 2>/dev/null
                logger -t cctv_arbiter "Purged oldest file $f to protect router OS"
            fi
            
            cur_mb=$(du -sm "$ram_buf_dir" 2>/dev/null | awk '{print $1}')
            [ "$cur_mb" -lt 80 ] && break
        done
    fi
}

case "$ACTION" in
    evict)
        check_and_evict_ram
        echo "EVICT_DONE"
        exit 0
        ;;
    check)
        check_and_evict_ram
        nas_st=$(check_nas_health "$CAM_ID")
        if [ "$nas_st" = "EMERGENCY" ]; then
            echo "EMERGENCY"
            exit 0
        fi
        check_network_load
        ;;
    nas)
        check_nas_health "$CAM_ID"
        ;;
    load|policy)
        check_network_load
        ;;
    status_json)
        nas_st=$(check_nas_health "$CAM_ID")
        load_st=$(check_network_load)
        echo "{\"nas_status\":\"$nas_st\",\"network_policy\":\"$load_st\"}"
        ;;
    *)
        echo "Usage: $0 {check [cam_id]|nas [cam_id]|load|policy|status_json}"
        exit 1
        ;;
esac
exit 0

