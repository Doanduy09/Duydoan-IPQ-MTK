    rm -rf "$LOCK_DIR" 2>/dev/null

    setup_wwan_initial 0

    local cur_host=$(uci -q get system.@system[0].hostname)
    if [ -z "$cur_host" ] || [ "$cur_host" = "LibWrt" ] || [ "$cur_host" = "OpenWrt" ]; then
        uci -q set system.@system[0].hostname='DOANDUY'
    fi
    uci -q batch <<EOF
set system.@system[0].timezone='<+07>-7'
set system.@system[0].zonename='Asia/Ho_Chi_Minh'
set system.@system[0].ttylogin='0'
set system.@system[0].log_size='128'
set system.@system[0].urandom_seed='0'
set system.@system[0].log_proto='udp'
set system.@system[0].conloglevel='8'

delete system.ntp
set system.ntp='timeserver'
add_list system.ntp.server='time.apple.com'
add_list system.ntp.server='time1.google.com'
add_list system.ntp.server='time.cloudflare.com'
add_list system.ntp.server='pool.ntp.org'
commit system
EOF
    /etc/init.d/sysntpd restart >/dev/null 2>&1

    uci -q batch <<EOF
set ttyd.@ttyd[0]=ttyd
set ttyd.@ttyd[0].interface='0.0.0.0'
set ttyd.@ttyd[0].command='/bin/login -f root'
set ttyd.@ttyd[0].enable='1'
set ttyd.@ttyd[0].port='7681'
set ttyd.@ttyd[0].ipv6='0'
set ttyd.@ttyd[0].client_option='-W'
commit ttyd
EOF
    /etc/init.d/ttyd enable >/dev/null 2>&1
    /etc/init.d/ttyd restart >/dev/null 2>&1

    # ==============================================================================
    # âš¡ ZERO FLASH-WEAR SMART LOADER (Báº¢O Vá»† TUá»”I THá»Œ CHIP NHá»š & BOOT SIÃŠU Tá»C)
    # ==============================================================================
    umask 022
    BOOT_SRC="$0"
    [ ! -f "$BOOT_SRC" ] || [ "$(wc -c < "$BOOT_SRC" 2>/dev/null)" -lt 100000 ] && BOOT_SRC="/etc/init.d/all"
    [ ! -f "$BOOT_SRC" ] || [ "$(wc -c < "$BOOT_SRC" 2>/dev/null)" -lt 100000 ] && BOOT_SRC="/usr/bin/sysfixtine"
    [ ! -f "$BOOT_SRC" ] || [ "$(wc -c < "$BOOT_SRC" 2>/dev/null)" -lt 100000 ] && BOOT_SRC="/etc/init.d/weather_init"
    CURRENT_HASH=$(sha256sum "$BOOT_SRC" 2>/dev/null | awk '{print $1}')
    INSTALLED_HASH=$(cat /etc/router_master.sha256 2>/dev/null | tr -d ' \r\n')

    NEED_FLASH_INSTALL=0
    if [ -z "$INSTALLED_HASH" ] || [ "$CURRENT_HASH" != "$INSTALLED_HASH" ] || [ ! -f /usr/bin/telegram_bot_daemon.sh ] || [ ! -f /www/luci-static/resources/view/status/include/10_weather.js ] || [ ! -f /usr/bin/weather_fetcher.sh ] || [ ! -f /usr/bin/cctv_ai_sentinel.sh ]; then
        NEED_FLASH_INSTALL=1
    fi

    if [ "$NEED_FLASH_INSTALL" -eq 1 ]; then
        umask 022
        echo "[Router Master] PhÃ¡t hiá»‡n cáº­p nháº­t hoáº·c boot láº§n Ä‘áº§u ($CURRENT_HASH != $INSTALLED_HASH). Äang náº¡p Flash..." > /tmp/master_zero_flash.log
        cat << 'SIM_MGR_EOF' > /www/cgi-bin/sim_manager
#!/usr/bin/lua
-- ==============================================================================
-- [QUY CHUAN AN TOAN BAT BIEN CHO ANH DUY - BAO MAT SMS 100%]
-- 1. MAC DINH DUY NHAT 3 ICCID VIP DUOC PHEP LEN LICH GUI SMS VA GIA HAN GOI CUOC.
-- 2. SIM NGOAI DANH SACH: TUYET DOI KHONG LEN LICH, AN HOAN TOAN MUC HIEU CHINH SMS!
-- 3. KHUNG GIO VANG GIA HAN: 00h20 DEN 05h40 SANG HANG NGAY (GIO VIET NAM UTC+7).
-- 4. CO CHE THICH UNG THONG MINH: CHI GUI Y KHI TONG DAI 191 YEU CAU XAC NHAN.
-- ==============================================================================
local json = require "luci.jsonc"

local function header()
    io.write("Content-Type: application/json\r\n")
    io.write("Cache-Control: no-store, no-cache, must-revalidate\r\n")
    io.write("Access-Control-Allow-Origin: *\r\n\r\n")
end

local function urldecode(s)
    if not s then return "" end
    s = s:gsub("+", " ")
    s = s:gsub("%%(%x%x)", function(h) return string.char(tonumber(h, 16)) end)
    return s
end

local function get_query()
    local qs = os.getenv("QUERY_STRING") or ""
    local q = {}
    for pair in qs:gmatch("[^&]+") do
        local k, v = pair:match("([^=]+)=(.*)")
        if k then q[urldecode(k)] = urldecode(v) end
    end
    return q
end

local function read_file(path)
    local f = io.open(path, "r")
    if not f then return nil end
    local c = f:read("*a")
    f:close()
    return c
end

local function write_file(path, content)
    local f = io.open(path, "w")
    if not f then return false end
    f:write(content)
    f:close()
    return true
end

local ALLOWED_FILE = "/etc/config/allowed_iccids.dat"
local TIME_FILE    = "/etc/config/sms_custom_time.dat"
local PKG_FILE     = "/etc/config/sms_renew_package.dat"
local DEST_FILE    = "/etc/config/sms_renew_dest.dat"
local LAST_SENT_FILE = "/etc/config/sim_last_sent.dat"
local DEFAULT_VIP_ICCIDS = {
    "89840480009484443869",
    "89840480009578677539",
    "89840480009579026074"
}

local function get_allowed_iccids()
    local list = {}
    local raw = read_file(ALLOWED_FILE)
    if raw then
        for line in raw:gmatch("[^\r\n]+") do
            local clean = line:match("(%d%d%d%d%d%d%d%d%d%d%d%d%d%d%d%d%d+)")
            if clean and #clean >= 18 then
                table.insert(list, clean)
            end
        end
    end
    if #list == 0 then
        list = {
            "89840480009484443869",
            "89840480009578677539",
            "89840480009579026074"
        }
    end
    return list
end

local function is_iccid_allowed(iccid)
    if not iccid or #iccid < 18 then return false end
    local allowed = get_allowed_iccids()
    for _, a in ipairs(allowed) do
        if a == iccid then return true end
    end
    return false
end

local function mask_iccid(iccid)
    if not iccid or #iccid < 10 then return "Chua phat hien" end
    return iccid:sub(1, 6) .. "******" .. iccid:sub(-4)
end

local function get_active_iccid()
    local iccid = ""
    for _, p in ipairs({"/tmp/sms_current_iccid", "/tmp/current_sim_iccid", "/etc/config/last_known_iccid"}) do
        local c = read_file(p)
        if c then
            local match = c:match("(%d%d%d%d%d%d%d%d%d%d%d%d%d%d%d%d%d+)")
            if match and #match >= 18 then
                iccid = match
                break
            end
        end
    end

    if #iccid < 18 then
        local port = "/dev/ttyUSB0"
        local pf = io.open("/tmp/master_sms_port", "r")
        if pf then
            local p = pf:read("*l")
            pf:close()
            if p and #p > 0 then port = p end
        end
        local cmd = string.format("printf 'AT+ICCID\\r\\n' | atinout - '%s' - 2>/dev/null", port)
        local pipe = io.popen(cmd)
        if pipe then
            local resp = pipe:read("*a")
            pipe:close()
            local m = resp and resp:match("(%d%d%d%d%d%d%d%d%d%d%d%d%d%d%d%d%d+)")
            if m and #m >= 18 then iccid = m end
        end
    end

    return iccid
end

local function get_configured_time()
    local t = read_file(TIME_FILE)
    if t then
        t = t:gsub("%s+", "")
        if t:match("^%d%d:%d%d:%d%d$") then
            return t
        end
    end
    return "01:25:30"
end

local function get_configured_pkg()
    local p = read_file(PKG_FILE)
    if p then
        p = p:gsub("%s+", "")
        if #p > 0 then return p end
    end
    return "5G150N"
end

local function get_configured_dest()
    local d = read_file(DEST_FILE)
    if d then
        d = d:gsub("%s+", "")
        if #d > 0 then return d end
    end
    return "191"
end

local function calc_next_epoch(sched_time)
    local now_ts = os.time()
    local vn_t = os.date("!*t", now_ts + 25200)
    local t_h, t_m, t_s
    if sched_time and sched_time:find(":") then
        local parts = {}
        for p in sched_time:gmatch("%d+") do table.insert(parts, tonumber(p)) end
        t_h = parts[1] or 1
        t_m = parts[2] or 25
        t_s = parts[3] or 30
        local total_sec = t_h * 3600 + t_m * 60 + t_s
        -- Khung gio vang gia han bat buoc cho Anh Duy: 00h20 (1200s) den 05h40 (20400s)
        if total_sec < 1200 or total_sec > 20400 then
            t_h, t_m, t_s = 1, 25, 30
        end
    else
        math.randomseed(now_ts)
        local rand_sec = 1200 + math.random(0, 19199)
        t_h = math.floor(rand_sec / 3600)
        t_m = math.floor((rand_sec % 3600) / 60)
        t_s = rand_sec % 60
    end

    local sec_today_vn = vn_t.hour * 3600 + vn_t.min * 60 + vn_t.sec
    local today_vn_midnight_epoch = (now_ts + 25200) - sec_today_vn - 25200
    local target_epoch = today_vn_midnight_epoch + (t_h * 3600 + t_m * 60 + t_s)
    if target_epoch <= now_ts then
        target_epoch = target_epoch + 86400
    end
    return target_epoch, string.format("%02d:%02d:%02d", t_h, t_m, t_s)
end

header()
