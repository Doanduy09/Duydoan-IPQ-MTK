    cat << 'CCTV_DAEMON_EOF' > /usr/bin/cctv_bot_daemon.sh
#!/bin/sh
# ==============================================================================
# ðŸ“¹ LEAN MULTI-BOT CCTV CAMERA DISPATCHER v8.0
# Dedicated Bots per Camera | Pushes 10-min clips to Telegram
# Stream-Copy (0% CPU) | Zero Disk Wear | Fallback to NAS Storage
# ==============================================================================
CONFIG_FILE="/etc/config/cctv_bot"
PID_FILE="/var/run/cctv_bot_daemon.pid"

dispatch_video() {
    local cam_id="$1"
    local video_file="$2"
    local custom_caption="$3"

    [ ! -f "$video_file" ] && return 1

    local f_size_bytes=$(wc -c < "$video_file" 2>/dev/null || stat -c%s "$video_file" 2>/dev/null || echo "0")
    if [ "$f_size_bytes" -le 1024 ]; then
        logger -t cctv_bot "Video file $video_file is too small (${f_size_bytes}B). Skipping upload."
        return 1
    fi

    local b_token=$(uci -q get cctv_bot.${cam_id}.bot_token)
    local c_id=$(uci -q get cctv_bot.${cam_id}.chat_id)

    [ -z "$b_token" ] && b_token=$(uci -q get cctv_bot.global.bot_token || uci -q get telegram_bot.settings.bot_token)
    [ -z "$c_id" ] && c_id=$(uci -q get cctv_bot.global.chat_id || uci -q get telegram_bot.settings.admin_chat_id)

    if [ -z "$b_token" ] || [ -z "$c_id" ]; then
        logger -t cctv_bot "No Telegram bot token or chat ID configured for $cam_id. Clip kept in storage."
        return 0
    fi

    local cam_name=$(uci -q get cctv_bot.${cam_id}.name || echo "$cam_id")
    local f_size_mb=$(( f_size_bytes / 1048576 ))
    local time_str=$(date '+%H:%M:%S %d/%m/%Y')

    local cap="ðŸ“¹ [${cam_name}] Clip 10 PhÃºt HoÃ n Táº¥t
ðŸ•’ Thá»i gian: ${time_str}
ðŸ“¦ Dung lÆ°á»£ng: ${f_size_mb} MB
ðŸ’¡ PhÃ¢n tÃ­ch AI Ä‘Æ°á»£c xá»­ lÃ½ tá»± Ä‘á»™ng táº¡i MÃ¡y áº¢o & Gemini Pro."
    [ -n "$custom_caption" ] && cap="$custom_caption"

    logger -t cctv_bot "Uploading clip ${video_file} (${f_size_mb}MB) for ${cam_name} to Telegram..."

    local res=$(curl -s -m 180 \
        -F chat_id="$c_id" \
        -F video=@"$video_file" \
        -F caption="$cap" \
        -F supports_streaming="true" \
        "https://api.telegram.org/bot${b_token}/sendVideo" 2>&1)

    if echo "$res" | grep -q '"ok":true'; then
        logger -t cctv_bot "âœ… ÄÃ£ táº£i clip ${cam_name} lÃªn Telegram thÃ nh cÃ´ng!"
        local keep_local=$(uci -q get cctv_bot.global.keep_local_clips || echo "1")
        if [ "$keep_local" = "0" ] && echo "$video_file" | grep -q "^/tmp/"; then
            rm -f "$video_file" 2>/dev/null
        fi
        return 0
    else
        logger -t cctv_bot "âš ï¸ Lá»—i táº£i video lÃªn Telegram: $(echo "$res" | head -c 200)"
        return 1
    fi
}

case "$1" in
    dispatch_video)
        dispatch_video "$2" "$3" "$4"
        ;;
    start|restart|master)
        echo "$$" > "$PID_FILE"
        logger -t cctv_bot "CCTV Bot Dispatcher v8.0 is ready."
        ;;
    stop)
        rm -f "$PID_FILE"
        ;;
    *)
        if [ -n "$1" ] && [ -f "$2" ]; then
            dispatch_video "$1" "$2" "$3"
        else
            echo "Usage: $0 {dispatch_video <cam_id> <video_path> [caption]|start|stop}"
        fi
        ;;
esac
