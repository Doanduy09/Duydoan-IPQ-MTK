                fetch('/cgi-bin/airdrop?action=cloud_cam_scan&_t=' + Date.now()).then(function(res) {
                    return res.json();
                }).then(function(data) {
                    btn.disabled = false;
                    btn.textContent = '🔍 Quét Tìm Camera LAN';
                    while (camDiscoveredSelect.firstChild) {
                        camDiscoveredSelect.removeChild(camDiscoveredSelect.firstChild);
                    }
                    var cams = (data && data.discovered_cameras) ? data.discovered_cameras : [];
                    if (cams.length === 0) {
                        camDiscoveredSelect.appendChild(E('option', { value: '' }, '-- Không tìm thấy camera RTSP mới nào --'));
                        ui.addNotification(null, E('p', '⚠️ Không tìm thấy camera RTSP (port 554) mới nào trong LAN.'), 'warning');
                    } else {
                        camDiscoveredSelect.appendChild(E('option', { value: '' }, '-- Đã phát hiện ' + cams.length + ' camera (chọn để tự điền) --'));
                        cams.forEach(function(c) {
                            var label = c.ip + ' (' + (c.hostname || 'IP Camera') + ' - MAC: ' + (c.mac || 'N/A') + ')';
                            camDiscoveredSelect.appendChild(E('option', { value: c.ip + '|' + (c.hostname || '') }, label));
                        });
                        ui.addNotification(null, E('p', '✅ Đã tìm thấy ' + cams.length + ' camera RTSP trong mạng LAN!'), 'info');
                    }
                }).catch(function(err) {
                    btn.disabled = false;
                    btn.textContent = '🔍 Quét Tìm Camera LAN';
                    ui.addNotification(null, E('p', '⚠️ Lỗi quét camera: ' + (err.message || err)), 'error');
                });
            }
        }, '🔍 Quét Tìm Camera LAN');

        // Form Inputs for Adding Camera (Streamlined: Only 3 visible fields, details hidden)
        var camIpInput = E('input', {
            type: 'text',
            placeholder: 'VD: 192.168.1.161',
            class: 'cbi-input-text',
            style: 'width: 100%; padding: 6px 10px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 12px;'
        });

        var camLabelInput = E('input', {
            type: 'text',
            placeholder: 'VD: Camera Trong Nhà',
            class: 'cbi-input-text',
            style: 'width: 100%; padding: 6px 10px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 12px;'
        });

        var camPassInput = E('input', {
            type: 'password',
            placeholder: 'Mật khẩu / Safety Code (dưới đáy camera)',
            class: 'cbi-input-text',
            style: 'flex: 1; padding: 6px 10px; border-radius: 6px 0 0 6px; border: 1px solid #cbd5e1; border-right: none; font-size: 12px;'
        });

        var camPassEyeBtn = E('button', {
            type: 'button',
            title: 'Bấm để Xem / Ẩn Mật Khẩu',
            style: 'padding: 6px 10px; border-radius: 0 6px 6px 0; border: 1px solid #cbd5e1; border-left: none; background: #ffffff; cursor: pointer; font-size: 13px; line-height: 1; display: flex; align-items: center; justify-content: center;',
            click: function(ev) {
                ev.preventDefault();
                if (camPassInput.type === 'password') {
                    camPassInput.type = 'text';
                    camPassEyeBtn.textContent = '🙈';
                } else {
                    camPassInput.type = 'password';
                    camPassEyeBtn.textContent = '👁️';
                }
            }
        }, '👁️');

        var camPassWrapper = E('div', { style: 'display: flex; width: 100%; align-items: stretch;' }, [
            camPassInput,
            camPassEyeBtn
        ]);

        // Advanced Technical Details (Hidden inside <details>)
        var camNameInput = E('input', {
            type: 'text',
            placeholder: 'Tự động tạo (không dấu)',
            class: 'cbi-input-text',
            style: 'width: 100%; padding: 6px 10px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 12px;'
        });

        var camPortInput = E('input', {
            type: 'text',
            value: '554',
            class: 'cbi-input-text',
            style: 'width: 100%; padding: 6px 10px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 12px;'
        });

        var camUserInput = E('input', {
            type: 'text',
            value: 'admin',
            class: 'cbi-input-text',
            style: 'width: 100%; padding: 6px 10px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 12px;'
        });

        var camPathInput = E('input', {
            type: 'text',
            value: 'cam/realmonitor?channel=1&subtype=0',
            class: 'cbi-input-text',
            style: 'width: 100%; padding: 6px 10px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 12px;'
        });

        var camAddBtn = E('button', {
            class: 'btn cbi-button cbi-button-positive',
            style: 'font-weight: 800; font-size: 12px; height: 35px; padding: 6px 16px; background: #ffffff; color: #000000; border-radius: 6px; border: none; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 6px; white-space: nowrap; box-shadow: 0 1px 3px rgba(22,163,74,0.3);',
            click: function(ev) {
                var ip = (camIpInput.value || '').trim();
                var label = (camLabelInput.value || '').trim();
                var pass = (camPassInput.value || '').trim();
                var name = (camNameInput.value || '').trim();
                var port = (camPortInput.value || '554').trim();
                var user = (camUserInput.value || 'admin').trim();
                var path = (camPathInput.value || 'cam/realmonitor?channel=1&subtype=0').trim();

                if (!ip) {
                    alert('Vui lòng nhập địa chỉ IP hoặc chọn camera quét được từ mạng LAN!');
                    return;
                }
                if (!label) {
                    label = 'Camera ' + ip;
                }
                if (!name) {
                    name = 'Camera_' + ip.replace(/\./g, '_');
                }

                var btn = ev.target;
                btn.disabled = true;
                btn.textContent = '⏳ Đang thêm...';

                var url = '/cgi-bin/airdrop?action=cloud_cam_add' +
                    '&ip=' + encodeURIComponent(ip) +
                    '&name=' + encodeURIComponent(name) +
                    '&label=' + encodeURIComponent(label) +
                    '&port=' + encodeURIComponent(port) +
                    '&user=' + encodeURIComponent(user) +
                    '&pass=' + encodeURIComponent(pass) +
                    '&path=' + encodeURIComponent(path) +
                    '&_t=' + Date.now();

                fetch(url).then(function(res) {
                    return res.json();
                }).then(function(data) {
                    btn.disabled = false;
                    btn.textContent = '➕ Thêm Camera Vào Hệ Thống';
                    if (data && data.status === 'ok') {
                        ui.addNotification(null, E('p', '✅ Đã thêm thành công camera ' + label + ' (' + ip + ')!'), 'info');
                        camIpInput.value = '';
                        camLabelInput.value = '';
                        camPassInput.value = '';
                        camNameInput.value = '';
                        refreshCameraCloudStatus();
                    } else {
                        ui.addNotification(null, E('p', '⚠️ Lỗi thêm camera: ' + (data.message || 'Không xác định')), 'error');
                    }
                }).catch(function(err) {
                    btn.disabled = false;
                    btn.textContent = '➕ Thêm Camera Vào Hệ Thống';
                    ui.addNotification(null, E('p', '⚠️ Lỗi kết nối: ' + (err.message || err)), 'error');
                });
            }
        }, '➕ Thêm Camera Vào Hệ Thống');

        // Camera List Table Body (6 columns)
        var camTableBody = E('tbody', {}, [
            E('tr', { class: 'tr' }, [
                E('td', { class: 'td', colspan: 6, style: 'text-align: center; color: #000000; padding: 14px;' }, '⏳ Đang nạp danh sách camera...')
            ])
        ]);

        // Function to refresh camera list
        function refreshCameraCloudStatus() {
            fetch('/cgi-bin/airdrop?action=cloud_cam_list&_t=' + Date.now()).then(function(res) {
                return res.json();
            }).then(function(data) {
                if (!data || data.status !== 'ok') return;
                var stTarget = data.storage_target || 'phone_cloud_offpeak';
                var retDays = (data.retention_days !== undefined) ? Number(data.retention_days) : 15;
                var remote = data.remote || 'cloud_storage';
                var is247 = (data.record_247 === 1 || data.daemon_running === 1);
                var segMins = data.segment_duration || 10;
                var cams = data.cameras || [];

                // Update badges
                var formatTargetLabel = function(tgt) {
                    if (tgt === '1' || tgt === 'nas_cloud' || !tgt || String(tgt).indexOf('phone_cloud') === 0 || tgt === 'emmc' || tgt === 'nas') return '1️⃣ NAS + Cloud';
                    if (tgt === '2' || tgt === 'nas_telegram') return '2️⃣ NAS + Telegram + Cloud';
                    if (tgt === '3' || tgt === 'telegram' || tgt === 'tg_instant' || tgt === 'ephemeral_tg') return '3️⃣ Đẩy Telegram Xóa Ngay (0MB)';
                    if (tgt === '4' || tgt === 'ephemeral' || tgt === 'cloud') return '4️⃣ Đẩy Google Drive Xóa Ngay (0MB)';
                    if (tgt === '5' || tgt === 'low_traffic_auto') return '5️⃣ Theo Lưu Lượng';
                    return tgt;
                };
                camTargetBadge.textContent = '🎯 Nơi Lưu: ' + formatTargetLabel(stTarget);
                if (!remote || remote === '' || remote === 'default' || remote === 'cloud_storage' || remote === 'cloud_backup') {
                    camRemoteBadge.textContent = '⚪ Chưa kết nối Cloud';
                    camRemoteBadge.style.background = 'rgba(148, 163, 184, 0.15)';
                    camRemoteBadge.style.borderColor = 'rgba(148, 163, 184, 0.4)';
                    camRemoteBadge.style.color = '#94a3b8';
                } else {
                    camRemoteBadge.textContent = '☁️ ' + remote;
                    camRemoteBadge.style.background = 'rgba(34, 197, 94, 0.15)';
                    camRemoteBadge.style.borderColor = 'rgba(34, 197, 94, 0.4)';
                    camRemoteBadge.style.color = '#4ade80';
                }
                camRetentionBadge.textContent = retDays === 0 ? '⏱️ Hạn: Vĩnh Viễn' : ('⏱️ Hạn: ' + retDays + ' Ngày');
                camCountBadge.textContent = '📹 ' + cams.length + ' Camera';

                if (data.storage_info) {
                    var avail = data.storage_info.free_gb ? (data.storage_info.free_gb + ' GB') : (data.storage_info.avail || '102.8 GB');
                    var pct = data.storage_info.use_pct || data.storage_info.percent || '17%';
                    camStorageBadge.textContent = '💾 eMMC: ' + avail + ' Trống (' + pct + ')';
                }

                if (data.offpeak_start && data.offpeak_end) {
                    camOffpeakBadge.textContent = '🌙 Đêm: ' + data.offpeak_start + ' - ' + data.offpeak_end;
                    if (document.activeElement !== camOffpeakStartInput) camOffpeakStartInput.value = data.offpeak_start;
                    if (document.activeElement !== camOffpeakEndInput) camOffpeakEndInput.value = data.offpeak_end;
                }

                if (is247) {
                    cam247Badge.textContent = '🔴 Ghi 24/7: ĐANG CHẠY (' + segMins + 'p/clip)';
                    cam247Badge.style.background = 'rgba(239, 68, 68, 0.2)';
                    cam247Badge.style.borderColor = '#ef4444';
                    cam247Badge.style.color = '#ef4444';
                    camToggle247Btn.textContent = '⏹️ Dừng Ghi Toàn Bộ 24/7';
                    camToggle247Btn.style.background = '#dc2626';
                } else {
                    cam247Badge.textContent = '⚪ Ghi 24/7: Đã Tắt';
                    cam247Badge.style.background = 'rgba(148, 163, 184, 0.15)';
                    cam247Badge.style.borderColor = 'rgba(148, 163, 184, 0.4)';
                    cam247Badge.style.color = '#64748b';
                    camToggle247Btn.textContent = '🔴 Bật Ghi Toàn Bộ 24/7';
                    camToggle247Btn.style.background = '#16a34a';
                }

                // Sync Automation settings if not focused
                if (document.activeElement !== camRetentionInput) camRetentionInput.value = String(retDays);

                // Anti-Revert Lockout Guard: Chỉ dừng render bảng nếu người dùng đang chủ động gõ/chọn trong ô input/select của bảng
                var activeEl = document.activeElement;
                var isEditingTable = activeEl && camTableBody && camTableBody.contains(activeEl) &&
                    (activeEl.tagName === 'INPUT' || activeEl.tagName === 'SELECT');
                if (isEditingTable) {
                    return;
                }

                // Rebuild table
                while (camTableBody.firstChild) {
                    camTableBody.removeChild(camTableBody.firstChild);
                }

                if (cams.length === 0) {
                    camTableBody.appendChild(E('tr', { class: 'tr' }, [
                        E('td', { class: 'td', colspan: 6, style: 'text-align: center; color: #000000; padding: 16px;' }, 'Chưa có camera nào được thêm. Hãy quét LAN hoặc nhập IP ở trên để thêm!')
                    ]));
                    return;
                }

                cams.forEach(function(c) {
                    var isOnline = (c.status === 'online');
                    var statusBadge = E('span', {
                        style: 'display: inline-flex; align-items: center; gap: 3px; font-weight: 700; font-size: 10px; padding: 1px 6px; border-radius: 9999px; ' +
                            (isOnline ? 'background: #ffffff; color: #000000; border: 1px solid #86efac;' : 'background: #ffffff; color: #000000; border: 1px solid #fca5a5;')
                    }, isOnline ? '🟢 Online' : '🔴 Offline');

                    // Check if user has unsaved modifications for this camera
                    var dirty = dirtyCamConfigs[c.id] || null;
                    var curPass = (dirty && dirty.pass !== undefined) ? dirty.pass : (c.password || '');
                    var curTarget = (dirty && dirty.target) ? dirty.target : (c.storage_target || stTarget || '1');
                    if (curTarget === 'nas' || curTarget === 'default' || !curTarget || curTarget === 'phone_cloud_offpeak' || curTarget === 'nas_cloud') curTarget = '1';

                    var curRemote = (dirty && dirty.remote) ? dirty.remote : (c.cloud_remote || remote || 'cloud_storage');
                    if (curRemote === 'default' || !curRemote) curRemote = remote || 'cloud_storage';

                    var curDur = (dirty && dirty.duration) ? dirty.duration : (c.duration || String(segMins) || '10');
                    if (curDur === 'default' || !curDur) curDur = String(segMins) || '10';
                    var hasUnsaved = (dirty !== null);

                    // Telegram Bot status badge linked with CCTV Bot card
                    var hasBot = (c.has_bot == 1 || c.has_bot === '1');
                    var botName = c.bot_name || (cctvGlobalData && cctvGlobalData.cameras && (cctvGlobalData.cameras.find(function(b) { return b.id === c.id; }) || {}).name);
                    if (!hasBot && cctvGlobalData && cctvGlobalData.cameras && cctvGlobalData.cameras.some(function(b) { return b.id === c.id; })) {
                        hasBot = true;
                    }
                    var botBadge = E('span', {
                        style: 'display: inline-flex; align-items: center; gap: 4px; font-size: 10px; font-weight: 700; border-radius: 4px; padding: 2px 7px; cursor: pointer; transition: all 0.2s; margin-top: 3px; ' +
                            (hasBot ? 'background: #ffffff; color: #000000; border: 1px solid #bfdbfe;' : 'background: #ffffff; color: #000000; border: 1px dashed #cbd5e1;'),
                        title: hasBot ? 'Bấm để tùy chỉnh Bot Telegram riêng cho Camera này' : 'Bấm để kết nối Bot Telegram cho Camera này',
                        click: function(ev) {
                            ev.preventDefault();
                            var targetCam = null;
                            if (cctvGlobalData && cctvGlobalData.cameras) {
                                targetCam = cctvGlobalData.cameras.find(function(b) { return b.id === c.id; });
                            }
                            if (!targetCam) {
                                var p = passInp.value.trim() || c.password || '';
                                targetCam = {
                                    id: c.id,
                                    name: 'Bot ' + (c.label || c.name),
                                    rtsp_url: 'rtsp://admin:' + p + '@' + c.ip + ':' + (c.port || 554) + '/cam/realmonitor?channel=1&subtype=1',
                                    chat_id: (tgAdminInput && tgAdminInput.value.trim()) || '',
                                    duration: camDurSel.value || '15',
                                    stream_profile: 'sub',
                                    push_tg: '1',
                                    snap_preview: false
                                };
                            }
                            if (typeof loadCameraIntoForm === 'function') {
                                loadCameraIntoForm(targetCam);
                            }
                            if (cctvFormWrapper) {
                                cctvFormWrapper.style.display = 'block';
                                if (cctvToggleFormBtn) cctvToggleFormBtn.textContent = '🔼 Thu Gọn (Ẩn)';
                                cctvFormWrapper.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            }
                        }
                    }, hasBot ? ['🤖 ' + (botName || 'Bot Cam') + ' 🟢', E('span', { style: 'font-size: 9px; opacity: 0.7;' }, ' ✏️')] : '🤖 ➕ Gán Bot Telegram');

                    // Col 1: Camera info element
                    var camInfoCol = E('td', { class: 'td', style: 'padding: 8px 10px;' }, [
                        E('div', { style: 'display: flex; align-items: center; gap: 6px;' }, [
                            E('span', { style: 'font-weight: 800; color: #000000; font-size: 12.5px;' }, c.label || c.name),
                            statusBadge
                        ]),
                        E('div', { style: 'font-size: 11px; color: #000000; font-family: monospace; margin-top: 2px;' }, '🌐 ' + c.ip + ':' + (c.port || 554) + ' • ID: ' + c.id),
                        E('div', { style: 'font-size: 10.5px; color: #000000; margin-top: 2px;' }, '📂 /mnt/storage/airdrop/Camera_NAS/' + c.name),
                        E('div', { style: 'margin-top: 3px;' }, botBadge)
                    ]);

                    // Col 2: Safety Code / Password Input + Eye Toggle (Masked by default for privacy)
                    var hasPass = (c.has_pass === 1) || (curPass.length > 0);
                    var passInp = E('input', {
                        type: 'password',
                        value: curPass,
                        placeholder: 'Nhập Safety Code',
                        class: 'cbi-input-text',
                        style: 'flex: 1; min-width: 95px; padding: 5px 8px; border-radius: 6px 0 0 6px; font-size: 11.5px; font-family: monospace; font-weight: 700; box-sizing: border-box; ' +
                            (hasPass ? 'border: 1px solid #86efac; border-right: none; background: #ffffff; color: #000000;' : 'border: 1px solid #f59e0b; border-right: none; background: #ffffff; color: #000000;'),
                        input: function() {
                            markDirty();
                        }
                    });

                    var passEyeBtn = E('button', {
                        type: 'button',
                        title: 'Bấm để Xem / Ẩn Safety Code',
                        style: 'padding: 5px 8px; border-radius: 0 6px 6px 0; border: 1px solid ' + (hasPass ? '#86efac' : '#f59e0b') + '; border-left: none; background: ' + (hasPass ? '#dcfce7' : '#fef3c7') + '; cursor: pointer; font-size: 12px; line-height: 1; display: flex; align-items: center; justify-content: center;',
                        click: function(ev) {
                            ev.preventDefault();
                            if (passInp.type === 'password') {
                                passInp.type = 'text';
                                passEyeBtn.textContent = '🙈';
                                passEyeBtn.title = 'Bấm để Ẩn mã bảo mật';
                            } else {
                                passInp.type = 'password';
                                passEyeBtn.textContent = '👁️';
                                passEyeBtn.title = 'Bấm để Xem mã bảo mật';
                            }
                        }
                    }, '👁️');

                    var passWrapper = E('div', { style: 'display: flex; width: 100%; min-width: 135px; align-items: stretch;' }, [
                        passInp,
                        passEyeBtn
                    ]);

                    var passHelp = E('div', {
                        style: 'font-size: 10px; font-weight: 600; margin-top: 3px; ' +
                            (hasPass ? 'color: #000000;' : 'color: #000000;')
                    }, hasPass ? '🔒 Đã bảo mật (Bấm 👁️ xem)' : '⚠️ Nhập mã dưới tem camera');

                    var passCol = E('td', { class: 'td', style: 'padding: 8px 10px;' }, [
                        passWrapper,
                        passHelp
                    ]);

                    // Col 3: Storage Target & Cloud Push Mode (5 Chế Độ Chuẩn)
                    var matchedVal = '1';
                    if (curTarget === '2' || curTarget === 'nas_telegram') {
                        matchedVal = '2';
                    } else if (curTarget === '3' || curTarget === 'telegram' || curTarget === 'tg_instant' || curTarget === 'ephemeral_tg') {
                        matchedVal = '3';
                    } else if (curTarget === '4' || curTarget === 'ephemeral' || curTarget === 'cloud') {
                        matchedVal = '4';
                    } else if (curTarget === '5' || curTarget === 'low_traffic_auto') {
                        matchedVal = '5';
                    } else {
                        matchedVal = '1';
                    }

                    var camStorageModeSel = E('select', {
                        class: 'cbi-input-select',
                        style: 'width: 100%; min-width: 250px; padding: 5px 8px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 11px; font-weight: 700; background: white; color: #000000;',
                        change: function() {
                            markDirty();
                        }
                    }, [
                        E('option', { value: '1', selected: (matchedVal === '1') }, '1️⃣ Lưu Ổ NAS Router + Cloud Sync'),
                        E('option', { value: '2', selected: (matchedVal === '2') }, '2️⃣ Lưu NAS + Gửi Telegram + Cloud'),
                        E('option', { value: '3', selected: (matchedVal === '3') }, '3️⃣ Tự Đẩy Lên Telegram Rồi Xóa Ngay (0MB RAM / 0 Flash)'),
                        E('option', { value: '4', selected: (matchedVal === '4') }, '4️⃣ Tự Đẩy Lên Google Drive Rồi Xóa Ngay (0MB Disk)'),
                        E('option', { value: '5', selected: (matchedVal === '5') }, '5️⃣ Tự Đẩy Theo Lưu Lượng (Rảnh Đẩy Ngay / Bận 0h-6h)')
                    ]);
                    camStorageModeSel.value = matchedVal;
                    var storageCol = E('td', { class: 'td', style: 'padding: 8px 10px;' }, camStorageModeSel);

                    // Col 4: Cloud Remote Account Selector
                    var camCloudRemoteSel = E('select', {
                        class: 'cbi-input-select',
                        style: 'width: 100%; min-width: 145px; padding: 5px 8px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 11px; font-weight: 700; background: white; color: #000000;',
                        change: function(ev) {
                            var val = ev.target.value;
                            if (val === '__add_new__') {
                                var newEmail = prompt('Nhập địa chỉ Gmail mới để liên kết Google Drive (Ví dụ: taikhoan@gmail.com):');
                                if (newEmail && newEmail.indexOf('@') !== -1) {
                                    newEmail = newEmail.trim();
                                    var cleanAccName = 'cloud_' + newEmail.replace(/[@.]/g, '_');
                                    var opt = E('option', { value: cleanAccName, selected: true }, '📧 ' + newEmail);
                                    camCloudRemoteSel.insertBefore(opt, camCloudRemoteSel.lastElementChild);
                                    camCloudRemoteSel.value = cleanAccName;
                                    fetch('/cgi-bin/airdrop?action=add_cloud_account&service=gdrive&email=' + encodeURIComponent(newEmail) + '&name=' + encodeURIComponent('Google Drive (' + newEmail.split('@')[0] + ')') + '&sync_mode=2way&_t=' + Date.now());
                                } else {
                                    camCloudRemoteSel.value = curRemote;
                                    return;
                                }
                            }
                            markDirty();
                        }
                    }, []);

                    var availRemotes = (data.available_remotes && Array.isArray(data.available_remotes)) ? data.available_remotes : [];
                    if (availRemotes.length === 0) {
                        camCloudRemoteSel.appendChild(E('option', { value: '', disabled: true, selected: true }, '⚪ Chưa cấu hình Cloud (Rclone)'));
                    } else {
                        availRemotes.forEach(function(r) {
                            var rId = (typeof r === 'object' && r.id) ? r.id : r;
                            var rLabel = (typeof r === 'object' && r.label) ? r.label : ('☁️ ' + rId);
                            camCloudRemoteSel.appendChild(E('option', { value: rId, selected: (curRemote === rId) }, rLabel));
                        });
                    }
                    camCloudRemoteSel.appendChild(E('option', { value: '__add_new__', style: 'font-weight: 800; color: #000000;' }, '➕ Thêm Tài Khoản Google Drive...'));
                    if (curRemote && availRemotes.indexOf(curRemote) !== -1) camCloudRemoteSel.value = curRemote;

                    var cloudCol = E('td', { class: 'td', style: 'padding: 8px 10px;' }, camCloudRemoteSel);

                    // Col 5: Duration Select (Tùy chọn 5p, 10p, 15p, 20p)
                    var camDurSel = E('select', {
                        class: 'cbi-input-select',
                        style: 'width: 100%; min-width: 95px; padding: 5px 8px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 11px; font-weight: 700; background: white; color: #000000;',
                        change: function() {
                            markDirty();
                        }
                    }, [
                        E('option', { value: '5', selected: (curDur === '5') }, '⏱️ 5 Phút (~20MB - Siêu Tốc)'),
                        E('option', { value: '10', selected: (curDur === '10' || !curDur) }, '⏱️ 10 Phút (~38MB - Mặc Định)'),
                        E('option', { value: '15', selected: (curDur === '15') }, '⏱️ 15 Phút (~55MB - Tối Ưu)'),
                        E('option', { value: '20', selected: (curDur === '20') }, '⏱️ 20 Phút (~75MB - Phân Đoạn Dài)')
                    ]);
                    if (curDur) camDurSel.value = curDur;
                    var durCol = E('td', { class: 'td', style: 'padding: 8px 10px;' }, camDurSel);

                    // Mark Dirty Helper: ghi nhận thay đổi, nút sáng cam và chống hoàn tác (anti-revert)
                    function markDirty() {
                        dirtyCamConfigs[c.id] = {
                            pass: passInp.value.trim(),
                            target: camStorageModeSel.value,
                            remote: camCloudRemoteSel.value,
                            duration: camDurSel.value
                        };
                        saveCamBtn.style.background = '#d97706';
                        saveCamBtn.style.boxShadow = '0 0 0 2px rgba(217, 119, 6, 0.4)';
                        saveCamBtn.textContent = '💾 Lưu Cài Đặt *';
                    }

                    // Col 6: Dedicated Save Button + Record Toggle + Snap + Delete
                    var saveCamBtn = E('button', {
                        class: 'btn cbi-button cbi-button-action',
                        style: 'font-weight: 800; font-size: 11.5px; padding: 5px 12px; color: #000000; border-radius: 6px; border: none; cursor: pointer; white-space: nowrap; transition: all 0.2s; ' +
                            (hasUnsaved ? 'background: #ffffff; box-shadow: 0 0 0 2px rgba(217, 119, 6, 0.4);' : 'background: #ffffff; box-shadow: 0 1px 2px rgba(2,132,199,0.3);'),
                        click: function(ev) {
                            var b = ev.target;
                            b.disabled = true;
                            b.textContent = '⏳ Đang lưu...';
                            var newPass = passInp.value.trim();
                            var newTarget = camStorageModeSel.value || '1';
                            var newRemote = camCloudRemoteSel.value || c.cloud_remote || remote || 'cloud_backup';
                            var newDur = camDurSel.value || '10';
                            if (newRemote === '__add_new__') newRemote = c.cloud_remote || remote || 'cloud_backup';

                            var t = Date.now();
                            var url = '/cgi-bin/airdrop?action=cloud_cam_set_cam_config' +
                                '&id=' + encodeURIComponent(c.id) +
                                '&target=' + encodeURIComponent(newTarget) +
                                '&remote=' + encodeURIComponent(newRemote) +
                                '&duration=' + encodeURIComponent(newDur) +
                                '&pass=' + encodeURIComponent(newPass) +
                                '&_t=' + t;

                            // Đảm bảo mật khẩu được ghi nhận chắc chắn vào UCI
                            if (newPass.length > 0) {
                                fetch('/cgi-bin/airdrop?action=cloud_cam_set_pass&id=' + encodeURIComponent(c.id) + '&pass=' + encodeURIComponent(newPass) + '&_t=' + t).catch(function(){});
                            }

                            fetch(url).then(function(res) {
                                return res.json();
                            }).then(function(resData) {
                                b.disabled = false;
                                b.blur();
                                if (resData && resData.status === 'ok') {
                                    delete dirtyCamConfigs[c.id];
                                    c.password = newPass;
                                    c.has_pass = newPass.length > 0 ? 1 : 0;
                                    c.storage_target = newTarget;
                                    c.cloud_remote = newRemote;
                                    c.duration = newDur;
                                    b.style.background = '#16a34a';
                                    b.style.boxShadow = '0 0 0 2px rgba(22, 163, 74, 0.4)';
                                    b.textContent = '✅ Đã Lưu!';
                                    passInp.style.border = '1px solid #86efac';
                                    passInp.style.borderRight = 'none';
                                    passInp.style.background = '#f0fdf4';
                                    passInp.style.color = '#166534';
                                    if (passEyeBtn) {
                                        passEyeBtn.style.border = '1px solid #86efac';
                                        passEyeBtn.style.borderLeft = 'none';
                                        passEyeBtn.style.background = '#dcfce7';
                                    }
                                    passHelp.textContent = newPass.length > 0 ? '🔒 Đã bảo mật (Bấm 👁️ xem)' : '⚠️ Nhập mã dưới tem camera';
                                    passHelp.style.color = newPass.length > 0 ? '#16a34a' : '#d97706';
                                    var durText = newDur + ' phút/clip';
                                    ui.addNotification(null, E('p', '✅ Đã lưu thành công Camera "' + (c.label || c.name) + '": ' + durText + ', nơi lưu [' + newTarget + ']!'), 'info');
                                    setTimeout(function() {
                                        b.style.background = '#0284c7';
                                        b.style.boxShadow = '0 1px 2px rgba(2,132,199,0.3)';
                                        b.textContent = '💾 Lưu Cài Đặt';
                                    }, 2000);
                                    setTimeout(function() {
                                        refreshCameraCloudStatus();
                                        if (typeof refreshCctvUi === 'function') refreshCctvUi();
                                    }, 400);
                                } else {
                                    b.style.background = '#dc2626';
                                    b.textContent = '⚠️ Lỗi Lưu';
                                    ui.addNotification(null, E('p', '⚠️ Lỗi lưu cấu hình: ' + (resData ? resData.message : 'Thất bại')), 'error');
                                }
                            }).catch(function(err) {
                                b.disabled = false;
                                b.blur();
                                b.style.background = '#dc2626';
                                b.textContent = '⚠️ Lỗi Mạng';
                                ui.addNotification(null, E('p', '⚠️ Lỗi kết nối: ' + (err.message || err)), 'error');
                            });
                        }
                    }, hasUnsaved ? '💾 Lưu Cài Đặt *' : '💾 Lưu Cài Đặt');

