                if (!val) return;
                var parts = val.split('|');
                var ip = parts[0];
                var host = parts[1] || '';
                camIpInput.value = ip;
                var cleanName = host ? host.replace(/[^a-zA-Z0-9_]/g, '_') : ('Camera_' + ip.replace(/\./g, '_'));
                camNameInput.value = cleanName;
                camLabelInput.value = host || ('Camera ' + ip);
