                    '<span style="background: #ffffff; color: #000000; padding: 5px 10px; border-radius: 6px; font-weight: 800; font-size: 12.5px;">🌐 Internet: Sẵn Sàng (' + (d.internet_source || 'Trực Tiếp') + ')</span>' :
                    '<span style="background: #ffffff; color: #000000; padding: 5px 10px; border-radius: 6px; font-weight: 800; font-size: 12.5px;">⚠️ Đang tự động kết nối vào Router Phát...</span>';

                // --- THIẾT KẾ TOPOLOGY HÌNH CÂY PHÂN CẤP (HIERARCHICAL MESH TREE) ---
                var masterModel = (fast && (fast.board_model || fast.model)) || window._savedBoardModel || (d && d.local_name) || 'Router Chính';
                var masterCpu = (fast && fast.soc_family) ? 
                    (fast.soc_family + (fast.cpu_cores ? ' (' + fast.cpu_cores + ' Cores • ' + (fast.cpu_freq_ghz || '1.8 GHz') + (fast.ram_total_mb ? ' • ' + Math.round(fast.ram_total_mb/1024*10)/10 + 'GB RAM' : '') + ')' : '')) : 
                    'ARMv8 Quad-Core Turbo';
                var masterIp = d.local_ip || '192.168.1.1';
                var masterMac = d.local_mac || (fast && fast.local_mac) || '';
                var masterName = d.local_name || 'Gateway-Router';
                var masterClients = (fast && fast.online_clients) || '1';
                var masterInternet = (fast && fast.wwan_signal) ? (fast.wwan_signal + ' • ' + (fast.wwan_band_detail ? fast.wwan_band_detail.split('•')[0] : '5G Sub-6')) : (d.internet_source || 'Cổng WAN/WWAN Trực Tiếp');

