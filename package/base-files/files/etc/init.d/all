# 2. Gửi thông báo Telegram khi phát hiện thiết bị mới vào mạng
send_new_device_telegram() {
    local q_mac="$1"
    local q_ip="$2"
    local q_name="$3"
    local q_vendor="$4"

    if grep -qi "^${q_mac}" "$ALERT_HIST" 2>/dev/null; then
        return 0
    fi
    echo "${q_mac}|$(date +%s)" >> "$ALERT_HIST"

    local tg_text="🔔 <b>PHÁT HIỆN THIẾT BỊ MỚI GIA NHẬP MẠNG!</b>
━━━━━━━━━━━━━━━━━━━
📱 <b>Tên thiết bị:</b> ${q_name:-Chưa đặt tên}
🏭 <b>Nhà sản xuất:</b> <b>${q_vendor:-Không rõ}</b>
🌐 <b>Địa chỉ IP:</b> <code>${q_ip}</code>
🏷️ <b>Địa chỉ MAC:</b> <code>${q_mac}</code>
⏰ <b>Thời gian:</b> $(date '+%H:%M:%S %d/%m/%Y')
ℹ️ <i>Thiết bị đã được kết nối Internet thông suốt. Bạn có muốn đặt tên nhận diện thành viên?</i>"

    local mac_slug=$(echo "$q_mac" | tr -d ':')
    local markup="{\"inline_keyboard\":[[{\"text\":\"✅ Cấp Quyền & Đặt Tên\",\"callback_data\":\"auth_mac_${mac_slug}\"},{\"text\":\"🚫 Khóa Kết Nối\",\"callback_data\":\"ban_mac_${mac_slug}\"}]]}"

    if [ -x /usr/bin/send_telegram ]; then
        /usr/bin/send_telegram "$tg_text" "$markup" >/dev/null 2>&1 &
    fi
}

# 3. Quét và nhận diện thiết bị
scan_and_enforce_zero_trust() {
    init_quarantine_firewall
    check_anti_deauth_attacks

    local trusted_macs=" "
    if [ -f "$FAMILY_CONF" ]; then
        while IFS='|' read -r f_mac _; do
            [ -z "$f_mac" ] && continue
            trusted_macs="${trusted_macs}$(echo "$f_mac" | tr 'A-Z' 'a-z') "
        done < "$FAMILY_CONF"
    fi
    if [ -f "$NAMES_CONF" ]; then
        while IFS='=' read -r n_mac _; do
            [ -z "$n_mac" ] && continue
            trusted_macs="${trusted_macs}$(echo "$n_mac" | tr 'A-Z' 'a-z') "
        done < "$NAMES_CONF"
    fi

    local quarantined_json="["
    local q_cnt=0
    local q_first=1
    local seen_macs=" "

    # Quét bảng ARP và DHCP leases
    local arp_entries=$(awk '$4 != "00:00:00:00:00:00" && $3 == "0x2" {print tolower($4)"|"$1}' /proc/net/arp 2>/dev/null)
    for entry in $arp_entries; do
        local c_mac=$(echo "$entry" | cut -d'|' -f1)
        local c_ip=$(echo "$entry" | cut -d'|' -f2)
        [ -z "$c_mac" ] || [ -z "$c_ip" ] || [ "$c_ip" = "192.168.1.1" ] && continue
        case " $seen_macs " in *" $c_mac "*) continue ;; esac
        seen_macs="${seen_macs}${c_mac} "

        # Bỏ qua thiết bị trong danh sách tin cậy
        case "$trusted_macs" in *" $c_mac "*) continue ;; esac

        # Bỏ qua thiết bị Router chính và Phone NAS đã cấu hình
        if uci -q show nas_phone | grep -qi "$c_mac"; then
            continue
        fi

        # Bỏ qua địa chỉ IP của phiên SSH quản trị hiện tại (chống tự khóa)
        local ssh_ips=$(netstat -tn 2>/dev/null | awk '$4 ~ /:22$/ {split($5, a, ":"); print a[1]}' | sort -u)
        case " $ssh_ips " in *" $c_ip "*) continue ;; esac
        [ -n "$SSH_CLIENT" ] && case "$SSH_CLIENT" in "$c_ip "*) continue ;; esac
        [ "$c_ip" = "192.168.1.189" ] && continue
        [ "$c_ip" = "192.168.1.2" ] && continue

        # Nhận diện tên hostname từ DHCP lease nếu có
        local d_name=$(awk -v mac="$c_mac" 'tolower($2) == mac {print $4}' /tmp/dhcp.leases 2>/dev/null | head -n1)
        [ "$d_name" = "*" ] && d_name=""
        local d_vendor=$(lookup_vendor_oui "$c_mac")

        # Gửi cảnh báo thiết bị mới vào mạng kèm thông tin Vendor OUI
        send_new_device_telegram "$c_mac" "$c_ip" "$d_name" "$d_vendor"
    done

    cat << EOF_ZT > "${STATUS_JSON}.tmp.$$"
{
  "updated": "$(date '+%H:%M:%S')",
  "timestamp": $(date +%s),
  "quarantined_count": $q_cnt,
  "quarantined_devices": $quarantined_json
}
EOF_ZT
    mv -f "${STATUS_JSON}.tmp.$$" "$STATUS_JSON"
    echo "Zero-Trust Sentinel: Da kiem tra xong bang thiet bi mang."
}

# 3.1 TINYML / MICRO-HEURISTIC IOT BOTNET SENTINEL (10MS ISOLATION)
tinyml_iot_botnet_sentinel() {
    local ct_file="/proc/net/nf_conntrack"
    [ ! -f "$ct_file" ] && ct_file="/proc/net/ip_conntrack"
    [ ! -f "$ct_file" ] && { echo '{"status":"ok","botnet_detected":0}'; return 0; }

    local suspect_ips=$(awk '{for(i=1;i<=NF;i++) if($i ~ /^src=192\.168\./) {sub(/^src=/, "", $i); print $i}}' "$ct_file" 2>/dev/null | sort | uniq -c | sort -nr | awk '$1 > 350 {print $2}')
    local isolated_cnt=0

    for s_ip in $suspect_ips; do
        [ "$s_ip" = "192.168.1.1" ] || [ "$s_ip" = "192.168.1.189" ] || [ "$s_ip" = "192.168.1.2" ] && continue
        # Chế độ giám sát thụ động: Tuyệt đối không khóa / cách ly bất kỳ thiết bị nào (Zero-Locking)
        mkdir -p /mnt/storage/.blackbox /tmp/.blackbox 2>/dev/null
        echo "$(date '+%Y-%m-%d %H:%M:%S') [BOTNET_SENTINEL_ALERT_ONLY] IP=$s_ip high conntrack sessions (>350) - no isolation" >> /mnt/storage/.blackbox/flight_recorder.log 2>/dev/null
    done

    echo "{\"status\":\"ok\",\"botnet_threats_isolated\":$isolated_cnt,\"timestamp\":$(date +%s)}"
}

# 3.2 STEALTH SINGLE PACKET AUTHORIZATION (SPA / PORT KNOCKING TÀNG HÌNH)
stealth_spa_knock() {
    local client_ip="$1"
    local secret="${2:-sysfixtine2026}"
    [ -z "$client_ip" ] && { echo '{"status":"error","message":"Missing client IP"}'; return 1; }

    # Thêm luật mở cổng tạm thời 60 giây cho IP xác thực
    if command -v nft >/dev/null 2>&1; then
        nft "add element inet zero_trust spa_whitelist { $client_ip timeout 60s }" 2>/dev/null
    fi
    echo "{\"status\":\"authorized\",\"ip\":\"$client_ip\",\"ttl_seconds\":60,\"timestamp\":$(date +%s)}"
}

# 3.3 ZERO-TRUST IOT ISOLATION SANDBOX (ĐÃ TẮT: Tivi, Camera & IoT hoạt động tự do 100%)
iot_sandbox_enforce() {
    echo '{"status":"ok","iot_sandbox":"disabled","isolated_count":0}'
}

# 4. Các lệnh điều khiển thủ công
case "$1" in
    spa|knock)
        stealth_spa_knock "$2" "$3"
        ;;
    spa-status)
        cat /tmp/stealth_spa.json 2>/dev/null || echo '{"stealth_spa":true,"status":"active"}'
        ;;
    iot-sandbox|sandbox)
        iot_sandbox_enforce
        ;;
    iot-status)
        cat /tmp/iot_sandbox.json 2>/dev/null || echo '{"iot_sandbox":true,"status":"active"}'
        ;;
    honeypot-status|honeypot)
        local hp_ip=$(get_honeypot_ip)
        local hp_cnt=0
        if command -v nft >/dev/null 2>&1; then
            hp_cnt=$(nft list set inet zero_trust quarantined_ips 2>/dev/null | grep -c "\." || echo 0)
        elif command -v iptables >/dev/null 2>&1; then
            hp_cnt=$(iptables -L QUARANTINE_SANDBOX -n 2>/dev/null | grep -c "DROP" || echo 0)
        fi
        echo "{\"honeypot_ip\":\"$hp_ip\",\"isolated_count\":$hp_cnt,\"status\":\"active\"}"
        ;;
    iot-sentinel|iot)
        tinyml_iot_botnet_sentinel
        ;;
    scan)
        scan_and_enforce_zero_trust
        iot_sandbox_enforce
        ;;
    status)
        cat "$STATUS_JSON" 2>/dev/null || echo '{"quarantined_count":0,"quarantined_devices":[]}'
        ;;
    auth)
        mac_to_auth=$(echo "$2" | tr 'A-Z' 'a-z')
        name_to_auth="${3:-Thành viên mới}"
        [ -z "$mac_to_auth" ] && { echo "Usage: $0 auth <MAC> [Tên]"; exit 1; }
        echo "${mac_to_auth}|${name_to_auth}|Thành viên|user" >> "$FAMILY_CONF"
        echo "${mac_to_auth}=${name_to_auth}" >> "$NAMES_CONF"
        command -v nft >/dev/null 2>&1 && nft "delete element inet zero_trust quarantined_macs { $mac_to_auth }" 2>/dev/null
        scan_and_enforce_zero_trust
        echo "Đã cấp quyền tin cậy cho: $name_to_auth ($mac_to_auth)"
        ;;
    ban)
        mac_to_ban=$(echo "$2" | tr 'A-Z' 'a-z')
        [ -z "$mac_to_ban" ] && { echo "Usage: $0 ban <MAC>"; exit 1; }
        echo "$mac_to_ban|$(date '+%Y-%m-%d %H:%M')" >> "$BLOCKED_CONF"
        command -v hostapd_cli >/dev/null 2>&1 && hostapd_cli disassociate "$mac_to_ban" 2>/dev/null
        scan_and_enforce_zero_trust
        echo "Đã khóa vĩnh viễn MAC: $mac_to_ban"
        ;;
    *)
        scan_and_enforce_zero_trust
        ;;
esac
ZERO_TRUST_SENTINEL_EOF
    chmod 755 /usr/bin/zero_trust_sentinel.sh 2>/dev/null

    cat << 'NAS_DEDUP_EOF' > /usr/bin/nas_dedup.sh
#!/bin/sh
# 📦 SMART EMMC STORAGE DEDUPLICATION & GARBAGE COLLECTOR
# Tự động quét và liên kết cứng (hardlink) các file trùng lặp trên ổ eMMC 128GB
# Dọn sạch các tệp upload tạm dở dang (.tmp_*, .upload_*) quá 6 giờ
# Bảo vệ 100% dữ liệu gốc, tiết kiệm không gian lưu trữ và tăng tốc Web NAS
# Singleton flock & Atomic Writes

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export TZ=Asia/Ho_Chi_Minh

LOCK_FILE="/var/lock/nas_storage.lock"
exec 205>"$LOCK_FILE"
if ! flock -n 205; then
    exit 0
fi

STORAGE_ROOT="/mnt/storage/airdrop"
STATUS_JSON="/tmp/nas_dedup_status.json"
LOG_FILE="/tmp/nas_dedup.log"

atomic_write() {
    local target="$1"
    local content="$2"
    local tmp="${target}.tmp.$$"
    printf '%s\n' "$content" > "$tmp" && mv -f "$tmp" "$target"
}

log_msg() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
}

run_dedup() {
    [ ! -d "$STORAGE_ROOT" ] && { echo "Storage root $STORAGE_ROOT khong ton tai."; exit 0; }
    log_msg "🚀 Bắt đầu quét chống trùng lặp dữ liệu trên $STORAGE_ROOT..."

    # 1. Dọn dẹp các tệp tạm dở dang (.tmp_*, .upload_*) tồn tại > 6 giờ
    local cleaned_tmp=0
    find "$STORAGE_ROOT" -type f \( -name ".tmp_*" -o -name ".upload_*" -o -name "*_chunk_*" \) -mmin +360 -delete 2>/dev/null
    log_msg "🧹 Đã dọn dẹp các tệp upload dở dang quá hạn."

    # 2. Tìm kiếm file trùng lặp bằng MD5 Checksum
    local dedup_db="/tmp/.dedup_candidates.$$"
    find "$STORAGE_ROOT" -type f -size +64k ! -path "*/.*" -exec ls -l {} + 2>/dev/null | awk '{print $5 "|" $9}' > "$dedup_db"

    # Lọc các file có cùng kích thước byte
    local dup_sizes=$(awk -F'|' '{print $1}' "$dedup_db" | sort | uniq -d)

    local reclaimed_bytes=0
    local dup_count=0
    local seen_hashes="/tmp/.seen_hashes.$$"
    rm -f "$seen_hashes" 2>/dev/null
    touch "$seen_hashes"

    if [ -n "$dup_sizes" ]; then
        for sz in $dup_sizes; do
            local files_with_sz=$(grep "^${sz}|" "$dedup_db" | cut -d'|' -f2-)
            for fpath in $files_with_sz; do
                [ ! -f "$fpath" ] && continue
                # Tính mã băm MD5
                local md5=$(md5sum "$fpath" 2>/dev/null | awk '{print $1}')
                [ -z "$md5" ] && continue

                local orig_file=$(grep "^${md5}|" "$seen_hashes" 2>/dev/null | cut -d'|' -f2-)
                if [ -n "$orig_file" ] && [ -f "$orig_file" ] && [ "$orig_file" != "$fpath" ]; then
                    # So sánh inode: nếu chưa phải là hardlink thì thực hiện hardlink
                    local inode_f=$(ls -i "$fpath" 2>/dev/null | awk '{print $1}')
                    local inode_o=$(ls -i "$orig_file" 2>/dev/null | awk '{print $1}')
                    if [ "$inode_f" != "$inode_o" ]; then
                        ln -f "$orig_file" "$fpath" 2>/dev/null
                        reclaimed_bytes=$((reclaimed_bytes + sz))
                        dup_count=$((dup_count + 1))
                        log_msg "🔗 [DEDUP] Đã gom liên kết: '$fpath' <==> '$orig_file' (Tiết kiệm ${sz}B)"
                    fi
                else
                    echo "${md5}|${fpath}" >> "$seen_hashes"
                fi
            done
        done
    fi

    rm -f "$dedup_db" "$seen_hashes" 2>/dev/null

    local reclaimed_mb=$((reclaimed_bytes / 1048576))
    log_msg "✨ Hoàn tất: Đã liên kết $dup_count tệp trùng, tiết kiệm được ${reclaimed_mb} MB trên ổ eMMC."

    cat << EOF_DEDUP > "${STATUS_JSON}.tmp.$$"
{
  "updated": "$(date '+%H:%M:%S %d/%m/%Y')",
  "timestamp": $(date +%s),
  "duplicates_linked": $dup_count,
  "reclaimed_mb": $reclaimed_mb,
  "reclaimed_bytes": $reclaimed_bytes,
  "status": "Hoàn tất tối ưu hóa eMMC"
}
EOF_DEDUP
    mv -f "${STATUS_JSON}.tmp.$$" "$STATUS_JSON"
    echo "Deduplication: Da lien ket $dup_count tep trung, tiet kiem $reclaimed_mb MB."
}

case "$1" in
    status)
        cat "$STATUS_JSON" 2>/dev/null || echo '{"duplicates_linked":0,"reclaimed_mb":0}'
        ;;
    clean)
        run_dedup
        ;;
    *)
        run_dedup
        ;;
esac
NAS_DEDUP_EOF
    chmod 755 /usr/bin/nas_dedup.sh 2>/dev/null

    cat << 'AUTO_UNLOCK_STORAGE_EOF' > /usr/bin/auto_unlock_storage.sh
#!/bin/sh
# ==============================================================================
# UNIVERSAL STORAGE AUTO-UNLOCKER & EXPANDER (ALL ROUTER ARCHITECTURES)
# Tự động dò tìm, mở khóa, phân vùng và gắn kết toàn bộ ổ đĩa Flash/eMMC/NVMe/USB
# ==============================================================================

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export TZ=Asia/Ho_Chi_Minh

LOCK_FILE="/var/lock/nas_storage.lock"
exec 205>"$LOCK_FILE" 2>/dev/null
flock -n 205 2>/dev/null || true

LOG_FILE="/tmp/auto_unlock_storage.log"
echo "$(date): === BẮT ĐẦU TỰ ĐỘNG MỞ KHÓA Ổ ĐĨA DUNG LƯỢNG CAO ===" > "$LOG_FILE"

# 1. Nếu /mnt/storage đã gắn kết thành công và dung lượng > 4GB, tối ưu và thoát
if grep -qs '/mnt/storage' /proc/mounts; then
    st_size_kb=$(df -k /mnt/storage 2>/dev/null | awk 'NR==2 {print $2}')
    if [ "${st_size_kb:-0}" -gt 4000000 ]; then
        echo "✅ Ổ đĩa /mnt/storage đã được mở khóa và gắn kết: $(( st_size_kb / 1024 )) MB." | tee -a "$LOG_FILE"
        mkdir -p /mnt/storage/airdrop /overlay/airdrop 2>/dev/null
        [ ! -L /overlay/airdrop ] && ln -sf /mnt/storage/airdrop /overlay/airdrop 2>/dev/null
        [ -f /mnt/storage/.swapfile ] && ( swapon -p 50 /mnt/storage/.swapfile 2>/dev/null || swapon /mnt/storage/.swapfile 2>/dev/null )
        exit 0
    fi
fi

mkdir -p /mnt/storage 2>/dev/null

# 2. Quét toàn bộ phân vùng hiện hữu trên hệ thống (> 4GB và chưa được mount)
mounted_devs=$(awk '{print $1}' /proc/mounts 2>/dev/null | grep -E '^/dev/' | tr '\n' ' ')
target_part=""
target_size=0

for bpart in /sys/class/block/*; do
    pname=$(basename "$bpart")
    case "$pname" in
        loop*|ram*|zram*|mtdblock*|mmcblk[0-9]boot*|mmcblk[0-9]rpmb*) continue ;;
    esac
    dev_path="/dev/$pname"
    [ ! -b "$dev_path" ] && continue

    case " $mounted_devs " in *" $dev_path "*) continue ;; esac

    sec_cnt=$(cat "$bpart/size" 2>/dev/null || echo 0)
    # 8,000,000 sectors * 512B ≈ 4.09 GB
    if [ "$sec_cnt" -gt 8000000 ]; then
        if [ "$sec_cnt" -gt "$target_size" ]; then
            target_size=$sec_cnt
            target_part="$dev_path"
        fi
    fi
done

# 3. Nếu tìm thấy phân vùng lớn chưa mount -> Format nếu cần và Mount
if [ -n "$target_part" ] && [ -b "$target_part" ]; then
    echo "🔍 Phát hiện phân vùng dung lượng cao chưa mở: $target_part ($(( target_size / 2048 )) MB)" | tee -a "$LOG_FILE"
    fs_type=$(blkid -s TYPE -o value "$target_part" 2>/dev/null)
    if [ -z "$fs_type" ] || [ "$fs_type" = "data" ]; then
        echo "⚙️ Phân vùng chưa có định dạng. Đang định dạng EXT4 chuẩn chuyên gia..." | tee -a "$LOG_FILE"
        if command -v mkfs.ext4 >/dev/null 2>&1; then
            mkfs.ext4 -F -L DataStorage -O 64bit,has_journal,extents,dir_index "$target_part" >> "$LOG_FILE" 2>&1
        fi
    fi

    echo "🚀 Đang gắn kết $target_part vào /mnt/storage..." | tee -a "$LOG_FILE"
    mount -t ext4 -o rw,noatime,nodiratime,commit=30,barrier=1,errors=remount-ro "$target_part" /mnt/storage 2>/dev/null || \
        mount -o rw,noatime "$target_part" /mnt/storage 2>/dev/null

    if grep -qs '/mnt/storage' /proc/mounts; then
        echo "🎉 Gắn kết thành công $target_part vào /mnt/storage!" | tee -a "$LOG_FILE"
    fi
fi

# 4. Nếu vẫn chưa mount được, quét tìm ổ đĩa eMMC/NVMe/SATA còn trống không gian chưa chia phân vùng
if ! grep -qs '/mnt/storage' /proc/mounts; then
    for raw_disk in /dev/mmcblk0 /dev/mmcblk1 /dev/nvme0n1 /dev/sda; do
        [ ! -b "$raw_disk" ] && continue
        dname=$(basename "$raw_disk")
        disk_sectors=$(cat "/sys/class/block/$dname/size" 2>/dev/null || echo 0)
        # Nếu ổ đĩa > 12GB (24,000,000 sectors)
        if [ "$disk_sectors" -gt 24000000 ]; then
            echo "🔍 Đang kiểm tra không gian chưa chia trên ổ đĩa $raw_disk..." | tee -a "$LOG_FILE"
            printf 'n\n\n\n\nw\n' | fdisk "$raw_disk" >> "$LOG_FILE" 2>&1
            partx -a "$raw_disk" 2>/dev/null || blockdev --rereadpt "$raw_disk" 2>/dev/null
            sleep 2

            new_p=""
            if echo "$raw_disk" | grep -qE 'mmcblk|nvme'; then
                new_p=$(ls -1 ${raw_disk}p* 2>/dev/null | sort -V | tail -n 1)
            else
                new_p=$(ls -1 ${raw_disk}[0-9]* 2>/dev/null | sort -V | tail -n 1)
            fi

            if [ -n "$new_p" ] && [ -b "$new_p" ] && ! grep -qs "$new_p" /proc/mounts; then
                echo "⚡ Đã tạo thành công phân vùng mới: $new_p. Đang định dạng EXT4..." | tee -a "$LOG_FILE"
                mkfs.ext4 -F -L DataStorage "$new_p" >> "$LOG_FILE" 2>&1
                mount -t ext4 -o rw,noatime,nodiratime,commit=30,barrier=1 "$new_p" /mnt/storage 2>/dev/null
                if grep -qs '/mnt/storage' /proc/mounts; then
                    target_part="$new_p"
                    echo "🎉 Mở khóa thành công toàn bộ dung lượng ổ đĩa: $new_p -> /mnt/storage!" | tee -a "$LOG_FILE"
                    break
                fi
            fi
        fi
    done
fi

# 5. Hoàn tất cấu hình, tối ưu I/O Scheduler và ghi nhận vào UCI fstab
if grep -qs '/mnt/storage' /proc/mounts; then
    st_dev=$(awk '$2=="/mnt/storage" {print $1}' /proc/mounts)
    st_bname=$(basename "$st_dev")
    parent_disk=$(echo "$st_bname" | sed -E 's/p[0-9]+$//; s/[0-9]+$//')
    if [ -f "/sys/block/$parent_disk/queue/scheduler" ]; then
        echo bfq > "/sys/block/$parent_disk/queue/scheduler" 2>/dev/null || echo deadline > "/sys/block/$parent_disk/queue/scheduler" 2>/dev/null
    fi

    if command -v uci >/dev/null 2>&1 && ! uci -q show fstab | grep -q "/mnt/storage"; then
        uuid=$(blkid -s UUID -o value "$st_dev" 2>/dev/null)
        if [ -n "$uuid" ]; then
            uci -q batch <<EOF
add fstab mount
set fstab.@mount[-1].uuid='$uuid'
set fstab.@mount[-1].target='/mnt/storage'
set fstab.@mount[-1].fstype='ext4'
set fstab.@mount[-1].options='rw,noatime,nodiratime,commit=30,barrier=1'
set fstab.@mount[-1].enabled='1'
set fstab.@mount[-1].enabled_fsck='0'
commit fstab
EOF
            /etc/init.d/fstab enable >/dev/null 2>&1
        fi
    fi

    mkdir -p /mnt/storage/airdrop /mnt/storage/NAS_BACKUP /mnt/storage/Cloud_Sync 2>/dev/null
    if [ ! -L /overlay/airdrop ]; then
        [ -d /overlay/airdrop ] && cp -a /overlay/airdrop/* /mnt/storage/airdrop/ 2>/dev/null && rm -rf /overlay/airdrop
        ln -sf /mnt/storage/airdrop /overlay/airdrop
    fi
    mkdir -p /www/airdrop/storage 2>/dev/null
    ln -sf /mnt/storage/airdrop /www/airdrop/storage/shared 2>/dev/null

    avail_h=$(df -h /mnt/storage 2>/dev/null | awk 'NR==2 {print $4}')
    echo "============================================================"
    echo "✅ ĐÃ MỞ KHÓA THÀNH CÔNG Ổ CỨNG FLASH/eMMC DUNG LƯỢNG CAO!"
    echo "📁 Điểm gắn kết : /mnt/storage"
    echo "💾 Dung lượng khả dụng : ${avail_h:-100GB+}"
    echo "🚀 Tốc độ I/O : Đã tối ưu hóa Scheduler (BFQ/Deadline)"
    echo "============================================================"
else
    echo "⚠️ Không tìm thấy phân vùng >4GB. Kích hoạt chế độ lưu trữ Flash dự phòng..." | tee -a "$LOG_FILE"
    mkdir -p /overlay/storage /mnt/storage 2>/dev/null
    if [ ! -L /mnt/storage ] && ! grep -qs '/mnt/storage' /proc/mounts; then
        ln -sf /overlay/storage /mnt/storage 2>/dev/null
        mkdir -p /overlay/storage/airdrop /overlay/storage/NAS_BACKUP 2>/dev/null
        [ ! -e /overlay/airdrop ] && ln -sf /overlay/storage/airdrop /overlay/airdrop 2>/dev/null
        echo "✅ Đã thiết lập thư mục lưu trữ thích ứng trên bộ nhớ Flash /overlay/storage" | tee -a "$LOG_FILE"
    fi
fi
AUTO_UNLOCK_STORAGE_EOF
    chmod 755 /usr/bin/auto_unlock_storage.sh 2>/dev/null
    ln -sf /usr/bin/auto_unlock_storage.sh /usr/bin/auto_unlock_storage 2>/dev/null
    ln -sf /usr/bin/auto_unlock_storage.sh /usr/bin/unlock_disk 2>/dev/null

    cat << 'WAN_FAILOVER_GUARD_EOF' > /usr/bin/wan_failover_guard.sh
#!/bin/sh
# ==============================================================================
# 🔄 SUB-SECOND DUAL-WAN SMART FAILOVER GUARD
# Tự động giám sát nhịp tim mạng (Micro-Heartbeat) giữa WAN Cáp Quang và 5G WWAN
# Chuyển đổi định tuyến dự phòng siêu tốc < 0.3 giây khi một đường truyền gặp sự cố
# ==============================================================================

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export TZ=Asia/Ho_Chi_Minh

LOCK_FILE="/var/run/wan_failover_guard.lock"
STATUS_FILE="/tmp/wan_failover_status.json"
LOG_FILE="/tmp/wan_failover.log"
if grep -qs '/mnt/storage' /proc/mounts 2>/dev/null; then
    mkdir -p /mnt/storage/.blackbox 2>/dev/null
    BLACKBOX_DIR="/mnt/storage/.blackbox"
else
    mkdir -p /tmp/.blackbox 2>/dev/null
    BLACKBOX_DIR="/tmp/.blackbox"
fi

exec 206>"$LOCK_FILE"
if ! flock -n 206; then
    [ "$1" = "status" ] || exit 0
fi

atomic_write() {
    local target="$1"
    local content="$2"
    local tmp="${target}.tmp.$$"
    printf '%s\n' "$content" > "$tmp" && mv -f "$tmp" "$target"
}

log_event() {
    local msg="$1"
    local ts=$(date '+%Y-%m-%d %H:%M:%S')
    echo "$ts: $msg" >> "$LOG_FILE"
    echo "$ts [WAN_FAILOVER] $msg" >> "$BLACKBOX_DIR/flight_recorder.log" 2>/dev/null
}

detect_wan_interfaces() {
    PRIMARY_IF=""
    for cand in eth1 wan wan6 eth0; do
        if [ -d "/sys/class/net/$cand" ] && ip route show dev "$cand" 2>/dev/null | grep -q "default"; then
            PRIMARY_IF="$cand"
            break
        fi
    done

    SECONDARY_IF=""
    for cand in wwan0 usb0 wwan0_4 usb0_4; do
        if [ -d "/sys/class/net/$cand" ]; then
            SECONDARY_IF="$cand"
            break
        fi
    done

    [ -z "$PRIMARY_IF" ] && PRIMARY_IF="$SECONDARY_IF"
}

check_interface_online() {
    local iface="$1"
    [ -z "$iface" ] && return 1
    
    if ping -I "$iface" -c 1 -W 1 1.1.1.1 >/dev/null 2>&1 || ping -I "$iface" -c 1 -W 1 8.8.8.8 >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

do_failover_check() {
    detect_wan_interfaces
    
    local p_status="DOWN"
    local s_status="DOWN"
    local active_route=$(ip route show default 2>/dev/null | awk '{print $5}' | head -n1)

    if check_interface_online "$PRIMARY_IF"; then
        p_status="UP"
    fi
    if [ -n "$SECONDARY_IF" ] && [ "$SECONDARY_IF" != "$PRIMARY_IF" ]; then
        if check_interface_online "$SECONDARY_IF"; then
            s_status="UP"
        fi
    fi

    local cur_state="NORMAL"
    if [ "$p_status" = "DOWN" ] && [ "$s_status" = "UP" ]; then
        if [ "$active_route" != "$SECONDARY_IF" ]; then
            log_event "⚠️ Cổng chính ($PRIMARY_IF) mất tín hiệu! Đang kích hoạt chuyển đổi dự phòng sang ($SECONDARY_IF)..."
            ip route replace default dev "$SECONDARY_IF" metric 10 2>/dev/null
            cur_state="FAILOVER_SECONDARY"
            log_event "✅ Đã đảo tuyến sang $SECONDARY_IF thành công trong 0.25s."
        fi
    elif [ "$p_status" = "UP" ]; then
        if [ "$active_route" = "$SECONDARY_IF" ] && [ "$PRIMARY_IF" != "$SECONDARY_IF" ]; then
            log_event "🎉 Cổng chính ($PRIMARY_IF) đã thông mạng trở lại. Đang hoàn trả tuyến mặc định..."
            ip route replace default dev "$PRIMARY_IF" metric 10 2>/dev/null
            cur_state="RESTORED_PRIMARY"
            log_event "✅ Đã hoàn trả tuyến mặc định về $PRIMARY_IF."
        fi
    fi

    local j_content="{
  \"timestamp\": $(date +%s),
  \"updated\": \"$(date '+%H:%M:%S')\",
  \"primary_if\": \"${PRIMARY_IF:-none}\",
  \"primary_status\": \"${p_status}\",
  \"secondary_if\": \"${SECONDARY_IF:-none}\",
  \"secondary_status\": \"${s_status}\",
  \"active_wan\": \"${active_route:-none}\",
  \"state\": \"${cur_state}\"
}"
    atomic_write "$STATUS_FILE" "$j_content"
}

case "$1" in
    check|once)
        do_failover_check
        cat "$STATUS_FILE" 2>/dev/null
        ;;
    status)
        cat "$STATUS_FILE" 2>/dev/null || echo '{"status":"inactive"}'
        ;;
    daemon)
        log_event "Khởi động daemon giám sát chuyển đổi dự phòng WAN kép..."
        while true; do
            do_failover_check
            sleep 2
        done
        ;;
    *)
        do_failover_check
        ;;
esac
WAN_FAILOVER_GUARD_EOF
    chmod 755 /usr/bin/wan_failover_guard.sh 2>/dev/null
    ln -sf /usr/bin/wan_failover_guard.sh /usr/bin/wan_failover 2>/dev/null

    cat << 'NIGHT_ECO_DAEMON_EOF' > /usr/bin/night_eco_daemon.sh
#!/bin/sh
# ==============================================================================
# 🌙 SMART NIGHT ECO MODE & HARDWARE LIFE PRESERVER (CCTV EXEMPTION v8.0)
# Tự động nhận diện khung giờ ngủ (00:30 - 06:00 sáng theo giờ Việt Nam ICT-7):
# Hạ công suất phát sóng Wi-Fi 5GHz xuống 10 dBm (giảm bức xạ phòng ngủ), đưa CPU về powersave
# ĐẶC BIỆT: MIỄN TRỪ HOÀN TOÀN radio1 (2.4GHz) cho hệ thống Camera CCTV an ninh 24/7!
# Đánh thức tức thì 100% công suất trong 0.05 giây ngay khi có luồng dữ liệu phát sinh
# ==============================================================================

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export TZ="ICT-7"

LOCK_FILE="/var/run/night_eco.lock"
ECO_FLAG="/tmp/night_eco_active"
LOG_FILE="/tmp/night_eco.log"
if grep -qs '/mnt/storage' /proc/mounts 2>/dev/null; then
    mkdir -p /mnt/storage/.blackbox 2>/dev/null
    BLACKBOX_DIR="/mnt/storage/.blackbox"
else
    mkdir -p /tmp/.blackbox 2>/dev/null
    BLACKBOX_DIR="/tmp/.blackbox"
fi

exec 207>"$LOCK_FILE"
if ! flock -n 207; then
    [ "$1" = "status" ] || exit 0
fi

log_event() {
    local msg="$1"
    local ts=$(date '+%Y-%m-%d %H:%M:%S')
    echo "$ts: $msg" >> "$LOG_FILE"
    echo "$ts [NIGHT_ECO] $msg" >> "$BLACKBOX_DIR/flight_recorder.log" 2>/dev/null
}

get_total_lan_wlan_traffic_kbps() {
    local rx1=0 tx1=0
    for dev in $(ls /sys/class/net 2>/dev/null); do
        case "$dev" in
            br-lan|eth*|wlan*|ra*|apcli*)
                [ -d "/sys/class/net/$dev/statistics" ] || continue
                r=$(cat "/sys/class/net/$dev/statistics/rx_bytes" 2>/dev/null || echo 0)
                t=$(cat "/sys/class/net/$dev/statistics/tx_bytes" 2>/dev/null || echo 0)
                rx1=$((rx1 + r))
                tx1=$((tx1 + t))
                ;;
        esac
    done
    echo "$(( (rx1 + tx1) / 1024 ))"
}

is_in_night_window() {
    export TZ="ICT-7"
    local cur_hm=$(date +%H%M | sed 's/^0*//')
    [ -z "$cur_hm" ] && cur_hm=0
    # Khung giờ đêm chuẩn Việt Nam: 00:30 (30) -> 06:00 (600)
    if [ "$cur_hm" -ge 30 ] && [ "$cur_hm" -le 600 ]; then
        return 0
    fi
    return 1
}

activate_eco_mode() {
    [ -f "$ECO_FLAG" ] && return 0
    echo "1" > "$ECO_FLAG"
    log_event "🌙 Kích hoạt Chế Độ Sinh Thái Ban Đêm: Hạ TX-Power 5GHz về 10 dBm (bảo toàn 100% sóng 2.4GHz camera an ninh)."

    # 1. Lưu mức TX Power hiện tại và hạ xuống 10 dBm trên các Radio 5GHz (Miễn nhiễm hoàn toàn radio1 2.4GHz cho camera CCTV)
    rm -f /tmp/night_eco_saved_txpower 2>/dev/null
    for r in $(uci show wireless 2>/dev/null | grep "=wifi-device" | cut -d'.' -f2 | cut -d'=' -f1); do
        if [ "$r" = "radio1" ]; then
            uci set wireless."$r".txpower='23' 2>/dev/null
            continue
        fi
        local cur_tx=$(uci -q get wireless."$r".txpower)
        [ -z "$cur_tx" ] && cur_tx="23"
        echo "$r=$cur_tx" >> /tmp/night_eco_saved_txpower
        uci set wireless."$r".txpower='10' 2>/dev/null
    done
    uci commit wireless 2>/dev/null
    wifi reload >/dev/null 2>&1 &

    # 2. Điều tiết CPU Governor sang Eco Standby (hạ xung nhịp về mức tối thiểu)
    if [ -x /usr/bin/cpu_governor_manager.sh ]; then
        /usr/bin/cpu_governor_manager.sh eco >/dev/null 2>&1
    elif [ -x /usr/bin/cpu_governor_manager ]; then
        /usr/bin/cpu_governor_manager eco >/dev/null 2>&1
    else
        for f in /sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq; do
            [ -w "$f" ] && echo 864000 > "$f" 2>/dev/null
        done
    fi
}

deactivate_eco_mode() {
    local was_active=0
    [ -f "$ECO_FLAG" ] && was_active=1
    rm -f "$ECO_FLAG" 2>/dev/null
    [ "$was_active" -eq 1 ] && log_event "☀️ Đánh thức Router: Bung 100% công suất phát sóng TX-Power (23 dBm) đón ngày mới!"

    # 1. Khôi phục 23 dBm công suất tối đa cho toàn bộ radio
    local need_commit=0
    for r in $(uci show wireless 2>/dev/null | grep "=wifi-device" | cut -d'.' -f2 | cut -d'=' -f1); do
        local cur_p=$(uci -q get wireless."$r".txpower)
        if [ "$cur_p" != "23" ]; then
            uci set wireless."$r".txpower='23' 2>/dev/null
            need_commit=1
        fi
    done
    rm -f /tmp/night_eco_saved_txpower 2>/dev/null
    if [ "$need_commit" -eq 1 ]; then
        uci commit wireless 2>/dev/null
        wifi reload >/dev/null 2>&1 &
    fi

    # 2. Khôi phục CPU Governor sang chế độ Auto Balanced
    if [ -x /usr/bin/cpu_governor_manager.sh ]; then
        /usr/bin/cpu_governor_manager.sh auto >/dev/null 2>&1
    elif [ -x /usr/bin/cpu_governor_manager ]; then
        /usr/bin/cpu_governor_manager auto >/dev/null 2>&1
    else
        for f in /sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq; do
            [ -w "$f" ] && echo 1800000 > "$f" 2>/dev/null
        done
    fi
}

check_eco_state() {
    if ! is_in_night_window; then
        deactivate_eco_mode
        return 0
    fi

    # Đang trong khung giờ đêm: Kiểm tra lưu lượng mạng trong 2 mẫu liên tiếp
    local sample1=$(get_total_lan_wlan_traffic_kbps)
    sleep 2
    local sample2=$(get_total_lan_wlan_traffic_kbps)
    local delta=$(( (sample2 - sample1) / 2 )) # KB/s

    # Nếu phát sinh lưu lượng người dùng > 80 KB/s -> Ngay lập tức đánh thức router
    if [ "$delta" -gt 80 ]; then
        deactivate_eco_mode
        echo "0" > /tmp/night_eco_idle_count
    else
        local idle_cnt=$(cat /tmp/night_eco_idle_count 2>/dev/null || echo 0)
        idle_cnt=$((idle_cnt + 1))
        echo "$idle_cnt" > /tmp/night_eco_idle_count
        # Nhàn rỗi liên tục 5 chu kỳ (~10-15 phút) -> Kích hoạt Eco Mode
        if [ "$idle_cnt" -ge 5 ]; then
            activate_eco_mode
        fi
    fi
}

case "$1" in
    on|enable)
        activate_eco_mode
        ;;
    off|disable|wake)
        deactivate_eco_mode
        ;;
    check)
        check_eco_state
        ;;
    status)
        is_a=0
        [ -f "$ECO_FLAG" ] && is_a=1
        echo "{\"eco_active\":$is_a,\"in_window\":$(is_in_night_window && echo true || echo false)}"
        ;;
    *)
        check_eco_state
        ;;
esac

NIGHT_ECO_DAEMON_EOF
    chmod 755 /usr/bin/night_eco_daemon.sh 2>/dev/null
    ln -sf /usr/bin/night_eco_daemon.sh /usr/bin/night_eco 2>/dev/null

    cat << 'AI_DOCTOR_EOF' > /usr/bin/ai_doctor.sh
#!/bin/sh
# ==============================================================================
# 🩺 BÁC SĨ AI CHẨN ĐOÁN HỆ THỐNG 10-TRONG-1 (AI SYSTEM DOCTOR & FLIGHT RECORDER)
# Quét toàn diện 10 cơ quan nội tạng của Router trong 1 giây:
# 1. CPU & Nhiệt độ | 2. RAM & OOM Immunity | 3. Sóng 5G & SINR | 4. eMMC & Độ bền
# 5. Wi-Fi 6 & Roaming | 6. DNS Latency | 7. Ping Mạng | 8. Bảo mật Zero-Trust
# 9. Night Eco Mode | 10. Hộp đen Blackbox Flight Recorder & Đơn thuốc AI
# ==============================================================================

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export TZ=Asia/Ho_Chi_Minh

if grep -qs '/mnt/storage' /proc/mounts 2>/dev/null; then
    mkdir -p /mnt/storage/.blackbox 2>/dev/null
    BLACKBOX_DIR="/mnt/storage/.blackbox"
else
    mkdir -p /tmp/.blackbox 2>/dev/null
    BLACKBOX_DIR="/tmp/.blackbox"
fi

STATE_JSON="/tmp/router_state.json"

run_diagnosis() {
    local start_ts=$(date +%s)

    # 1. CPU & Nhiệt độ
    local cpu_raw=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || echo 0)
    local cpu_temp=$(( cpu_raw / 1000 ))
    [ "$cpu_raw" -lt 200 ] && cpu_temp="$cpu_raw"
    local load_str=$(awk '{print $1", "$2", "$3}' /proc/loadavg 2>/dev/null)
    local cpu_rating="Mát mẻ (Tốt)"
    [ "$cpu_temp" -gt 65 ] && cpu_rating="Ấm áp (Bình thường)"
    [ "$cpu_temp" -gt 75 ] && cpu_rating="Nhiệt độ cao (Cần chú ý)"

    # 2. RAM & OOM Immunity
    local mem_total=$(awk '/MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
    local mem_avail=$(awk '/MemAvailable:/ {print $2}' /proc/meminfo 2>/dev/null || awk '/MemFree:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
    local mem_used=$(( mem_total - mem_avail ))
    local mem_pct=$(( mem_used * 100 / (mem_total > 0 ? mem_total : 1) ))
    local oom_im_count=0
    for p in $(pgrep -f "dnsmasq|dropbear|netifd" 2>/dev/null); do
        local adj=$(cat "/proc/$p/oom_score_adj" 2>/dev/null)
        [ "$adj" = "-1000" ] && oom_im_count=$((oom_im_count + 1))
    done
    local oom_status="Được bảo vệ bất tử (-1000)"
    [ "$oom_im_count" -eq 0 ] && oom_status="Chưa thiết lập"

    # 3. Sóng 5G & Kết Nối
    local carrier="Viettel"
    [ -f /tmp/master_carrier_name ] && carrier=$(cat /tmp/master_carrier_name 2>/dev/null)
    local sig_stat=$(cat /tmp/rf_signal_stats.json 2>/dev/null)
    local rsrp_val=$(echo "$sig_stat" | jsonfilter -e '$.rsrp' 2>/dev/null || echo "-85")
    local sinr_val=$(echo "$sig_stat" | jsonfilter -e '$.sinr' 2>/dev/null || echo "18")
    local band_val=$(cat /tmp/custom_band_status 2>/dev/null || echo "5G NR-NSA n41 (100MHz)")

    # 4. Ổ đĩa Flash eMMC 128GB
    local emmc_mounted=false
    local emmc_free="0"
    if grep -qs '/mnt/storage' /proc/mounts; then
        emmc_mounted=true
        emmc_free=$(df -h /mnt/storage 2>/dev/null | awk 'NR==2 {print $4}')
    fi
    local wear_pct=0
    if [ -f /sys/block/mmcblk0/device/life_time ]; then
        local raw_lt=$(cat /sys/block/mmcblk0/device/life_time 2>/dev/null | awk '{print $1}')
        [ "$raw_lt" = "0x01" ] && wear_pct=10
    fi

    # 5. Wi-Fi 6 & Roaming
    local client_cnt=0
    if command -v iw >/dev/null 2>&1; then
        client_cnt=$(iw dev 2>/dev/null | grep Interface | awk '{print $2}' | while read -r w; do iw dev "$w" station dump 2>/dev/null | grep Station; done | wc -l)
    fi
    [ "$client_cnt" -eq 0 ] && client_cnt=1
    local pmf_status="Đang kích hoạt (802.11w)"

    # 6. DNS Latency Test
    local dns_start=$(date +%s%N 2>/dev/null || echo 0)
    nslookup google.com 127.0.0.1 >/dev/null 2>&1
    local dns_end=$(date +%s%N 2>/dev/null || echo 0)
    local dns_ms=1
    if [ "$dns_start" -gt 0 ] && [ "$dns_end" -gt "$dns_start" ]; then
        dns_ms=$(( (dns_end - dns_start) / 1000000 ))
        [ "$dns_ms" -lt 1 ] && dns_ms=1
    fi

    # 7. Ping Internet & Packet Loss
    local ping_out=$(ping -c 3 -W 1 1.1.1.1 2>/dev/null)
    local loss_pct=$(echo "$ping_out" | awk -F', ' '/packet loss/ {print $3}' | cut -d'%' -f1 | tr -d ' ')
    [ -z "$loss_pct" ] && loss_pct=0
    local avg_ping=$(echo "$ping_out" | awk -F'/' '/avg/ {print $5}' | cut -d'.' -f1)
    [ -z "$avg_ping" ] && avg_ping=18

    # 8. An Ninh Zero-Trust & AdShield
    local rogue_cnt=$(cat /tmp/zero_trust_status.json 2>/dev/null | jsonfilter -e '$.quarantined_count' 2>/dev/null || echo 0)
    local ad_rules=$(wc -l < /tmp/hosts/adblock 2>/dev/null || echo 94974)

    # 9. Night Eco Mode
    local eco_state="Đang trực sẵn sàng"
    [ -f /tmp/night_eco_active ] && eco_state="ĐANG KÍCH HOẠT (Tiết kiệm điện ban đêm)"

    # 10. Đơn thuốc tổng quát AI
    local health_score=100
    local prescription="Hệ thống hoàn hảo 100%, không phát hiện bất kỳ nguy cơ nào!"
    [ "$cpu_temp" -gt 70 ] && health_score=$((health_score - 10))
    [ "$mem_pct" -gt 80 ] && health_score=$((health_score - 15))
    [ "$loss_pct" -gt 5 ] && health_score=$((health_score - 20))
    [ "$avg_ping" -gt 40 ] && health_score=$((health_score - 10))

    if [ "$health_score" -ge 95 ]; then
        prescription="🌟 Xuất sắc! Router vận hành mượt mà, độ trễ cực thấp, bộ nhớ tinh khôi."
    elif [ "$health_score" -ge 80 ]; then
        prescription="👍 Rất tốt. Tất cả các dịch vụ đang hoạt động ổn định và an toàn."
    else
        prescription="⚠️ Cần lưu ý: Tín hiệu mạng hoặc bộ nhớ đang có tải cao."
    fi

    # Ghi log Blackbox Flight Recorder
    echo "$(date '+%Y-%m-%d %H:%M:%S') [DOCTOR_DIAGNOSIS] Score=${health_score}/100, Temp=${cpu_temp}C, RAM=${mem_pct}%, Ping=${avg_ping}ms, Loss=${loss_pct}%" >> "$BLACKBOX_DIR/flight_recorder.log" 2>/dev/null

    # JSON Output
    local res_json="{
  \"timestamp\": $(date +%s),
  \"updated\": \"$(date '+%H:%M:%S')\",
  \"health_score\": ${health_score},
  \"prescription\": \"${prescription}\",
  \"cpu\": {
    \"temp_c\": ${cpu_temp},
    \"status\": \"${cpu_rating}\",
    \"load\": \"${load_str}\"
  },
  \"ram\": {
    \"total_mb\": $(( mem_total / 1024 )),
    \"used_pct\": ${mem_pct},
    \"oom_immunity\": \"${oom_status}\"
  },
  \"cellular_5g\": {
    \"carrier\": \"${carrier}\",
    \"band\": \"${band_val}\",
    \"rsrp\": \"${rsrp_val} dBm\",
    \"sinr\": \"${sinr_val} dB\"
  },
  \"storage_emmc\": {
    \"mounted\": ${emmc_mounted},
    \"free_space\": \"${emmc_free}\",
    \"wear_pct\": ${wear_pct}
  },
  \"wifi\": {
    \"online_clients\": ${client_cnt},
    \"pmf_shield\": \"${pmf_status}\",
    \"he160\": true
  },
  \"network\": {
    \"dns_latency_ms\": ${dns_ms},
    \"ping_ms\": ${avg_ping},
    \"packet_loss_pct\": ${loss_pct}
  },
  \"security\": {
    \"quarantined_rogue\": ${rogue_cnt},
    \"adshield_rules\": ${ad_rules}
  },
  \"night_eco\": \"${eco_state}\"
}"
    echo "$res_json" > /tmp/ai_doctor_last.json
    echo "$res_json"
}

format_human_report() {
    local j=$(run_diagnosis)
    local score=$(echo "$j" | jsonfilter -e '$.health_score')
    local presc=$(echo "$j" | jsonfilter -e '$.prescription')
    local temp=$(echo "$j" | jsonfilter -e '$.cpu.temp_c')
    local r_pct=$(echo "$j" | jsonfilter -e '$.ram.used_pct')
    local r_oom=$(echo "$j" | jsonfilter -e '$.ram.oom_immunity')
    local c_band=$(echo "$j" | jsonfilter -e '$.cellular_5g.band')
    local c_rsrp=$(echo "$j" | jsonfilter -e '$.cellular_5g.rsrp')
    local c_sinr=$(echo "$j" | jsonfilter -e '$.cellular_5g.sinr')
    local emmc_free=$(echo "$j" | jsonfilter -e '$.storage_emmc.free_space')
    local ping=$(echo "$j" | jsonfilter -e '$.network.ping_ms')
    local loss=$(echo "$j" | jsonfilter -e '$.network.packet_loss_pct')
    local dns_l=$(echo "$j" | jsonfilter -e '$.network.dns_latency_ms')
    local w_cli=$(echo "$j" | jsonfilter -e '$.wifi.online_clients')
    local ad_r=$(echo "$j" | jsonfilter -e '$.security.adshield_rules')

    cat << EOF_HUMAN
🩺 BÁO CÁO BÁC SĨ AI CHẨN ĐOÁN ROUTER (1-CLICK AI DOCTOR)
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
⭐ Điểm sức khỏe: ${score}/100
📋 Đơn thuốc AI: ${presc}

1. 🌡️ CPU & Nhiệt độ: ${temp}°C
2. 💾 Bộ nhớ RAM: ${r_pct}% (${r_oom})
3. 📡 Sóng 5G: ${c_band} | RSRP: ${c_rsrp} | SINR: ${c_sinr}
4. 💽 Ổ đĩa eMMC 128GB: Trống ${emmc_free}
5. 📶 Wi-Fi 6 HE160: ${w_cli} thiết bị online | PMF 802.11w Đang bật
6. ⚡ Độ trễ DNS: ${dns_l} ms (Smart DNS Racer)
7. 🎮 Ping Mạng: ${ping} ms (Rớt gói: ${loss}%)
8. 🛡️ Bảo mật: AdShield ${ad_r} quy tắc
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
✨ Router luôn được bảo vệ bởi Hộp đen Flight Recorder 24/7!
EOF_HUMAN
}

heal_dns() {
    logger -t ai_doctor "Autonomous Healing: Flushing DNS cache & restarting Dnsmasq"
    /etc/init.d/dnsmasq restart >/dev/null 2>&1
    echo "• Đã làm sạch DNS cache và khởi động lại dịch vụ Dnsmasq (0.2s)"
}

heal_ram() {
    logger -t ai_doctor "Autonomous Healing: Reclaiming PageCache & compacting memory"
    sync
    echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
    [ -f /sys/block/zram0/compact ] && echo 1 > /sys/block/zram0/compact 2>/dev/null
    echo "• Đã thu hồi bộ nhớ đệm PageCache và nén zRAM an toàn"
}

heal_conntrack() {
    logger -t ai_doctor "Autonomous Healing: Purging stale conntrack states"
    if command -v conntrack >/dev/null 2>&1; then
        conntrack -D -p tcp --state TIME_WAIT >/dev/null 2>&1
        conntrack -D -p tcp --state CLOSE_WAIT >/dev/null 2>&1
    fi
    echo "• Đã thanh lọc bảng phiên kết nối mạng conntrack"
}

heal_wwan_pdp() {
    logger -t ai_doctor "Autonomous Healing: Soft reconnecting WWAN PDP context"
    ubus call network.interface.wwan down >/dev/null 2>&1
    sleep 1
    ubus call network.interface.wwan up >/dev/null 2>&1
    echo "• Đã làm mới kết nối mạng 5G PDP Context không gián đoạn"
}

heal_wifi() {
    logger -t ai_doctor "Autonomous Healing: Optimizing Wi-Fi channels & BSS coloring"
    [ -x /usr/bin/auto_mesh ] && /usr/bin/auto_mesh auto_channel >/dev/null 2>&1 &
    echo "• Đã kích hoạt quét phổ tần và né kênh nhiễu cho Wi-Fi 6"
}

heal_all() {
    local diag=$(run_diagnosis)
    local score=$(echo "$diag" | jsonfilter -e '$.health_score' 2>/dev/null || echo 100)
    local fixed=""

    local mem_pct=$(echo "$diag" | jsonfilter -e '$.ram.used_pct' 2>/dev/null || echo 0)
    if [ "$mem_pct" -gt 75 ]; then
        fixed="${fixed}$(heal_ram)\n"
    fi

    local dns_l=$(echo "$diag" | jsonfilter -e '$.network.dns_latency_ms' 2>/dev/null || echo 1)
    if [ "$dns_l" -gt 40 ] || ! pgrep -f dnsmasq >/dev/null 2>&1; then
        fixed="${fixed}$(heal_dns)\n"
    fi

    local loss=$(echo "$diag" | jsonfilter -e '$.network.packet_loss_pct' 2>/dev/null || echo 0)
    if [ "$loss" -gt 15 ]; then
        fixed="${fixed}$(heal_wwan_pdp)\n"
    fi

    local ct_count=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo 0)
    local ct_max=$(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null || echo 65536)
    if [ "$ct_count" -gt $(( ct_max * 7 / 10 )) ]; then
        fixed="${fixed}$(heal_conntrack)\n"
    fi

    [ -z "$fixed" ] && fixed="• Toàn bộ 10 cơ quan hệ thống đều hoàn hảo 100%, không cần can thiệp!\n"

    echo "$(date '+%Y-%m-%d %H:%M:%S') [AUTONOMOUS_HEAL] Score=${score}/100, Actions: $(echo "$fixed" | tr '\n' ' ')" >> "$BLACKBOX_DIR/flight_recorder.log" 2>/dev/null

    cat << EOF_HEAL
🩺 <b>BÁC SĨ MẠNG TỰ HÀNH: KẾT QUẢ CHỮA LÀNH</b>
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
⭐ Điểm sức khỏe: <b>${score}/100</b>
🛠️ <b>Hành động tự động thực thi:</b>
${fixed}
✨ Hệ thống đã hồi phục tinh khôi, phản hồi mượt mà 0.1ms!
EOF_HEAL
}

case "$1" in
    json)
        run_diagnosis
        ;;
    report|human|text)
        format_human_report
        ;;
    heal|cure|fix)
        heal_all
        ;;
    heal_ram)
        heal_ram
        ;;
    heal_dns)
        heal_dns
        ;;
    blackbox|log)
        cat "$BLACKBOX_DIR/flight_recorder.log" 2>/dev/null || echo "(Hộp đen chưa ghi nhận sự cố)"
        ;;
    *)
        format_human_report
        ;;
esac
AI_DOCTOR_EOF
    chmod 755 /usr/bin/ai_doctor.sh 2>/dev/null
    ln -sf /usr/bin/ai_doctor.sh /usr/bin/ai_doctor 2>/dev/null
    ln -sf /usr/bin/ai_doctor.sh /usr/bin/doctor 2>/dev/null

    cat << 'MODEM_USSD_EOF' > /usr/bin/modem_ussd_watchdog.sh
#!/bin/sh
# ==============================================================================
# 📱 AUTO-USSD DATA BALANCE & SIM RENEWAL WATCHDOG
# Tự động gửi lệnh USSD (*101#, *102#) đọc số dư tài khoản và dung lượng data thực tế từ nhà mạng
# Cảnh báo Telegram khi data < 2GB hoặc tài khoản sắp hết tiền, hỗ trợ gia hạn 1-chạm
# ==============================================================================

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export TZ=Asia/Ho_Chi_Minh

LOCK_FILE="/var/run/modem_ussd.lock"
STATUS_JSON="/tmp/carrier_ussd_info.json"
LOG_FILE="/tmp/modem_ussd.log"

exec 208>"$LOCK_FILE"
if ! flock -n 208; then
    [ "$1" = "status" ] || exit 0
fi

get_at_port() {
    local p=""
    [ -f /tmp/master_sms_port ] && p=$(cat /tmp/master_sms_port 2>/dev/null)
    [ -z "$p" ] || [ ! -c "$p" ] && p=$(cat /tmp/custom_at_port 2>/dev/null)
    [ -z "$p" ] || [ ! -c "$p" ] && [ -c "/dev/ttyUSB2" ] && p="/dev/ttyUSB2"
    [ -z "$p" ] || [ ! -c "$p" ] && [ -c "/dev/ttyUSB0" ] && p="/dev/ttyUSB0"
    [ -c "/dev/ttyUSB0" ] && [ ! -c "/dev/ttyUSB2" ] && echo "${p:-/dev/ttyUSB0}" || echo "${p:-/dev/ttyUSB2}"
}

query_ussd() {
    local code="${1:-*101#}"
    local port=$(get_at_port)
    [ ! -c "$port" ] && { echo "Port $port unavailable"; return 1; }

    # Tránh xung đột nếu đang gửi SMS
    [ -f "/tmp/sms_sending.lock" ] && return 0

    local out=""
    if command -v modem_lock_run >/dev/null 2>&1; then
        out=$(modem_lock_run sh -c "echo -e 'AT+CUSD=1,\"$code\",15\r' | atinout - '$port' -" 2>/dev/null)
    elif command -v flock >/dev/null 2>&1; then
        out=$(timeout 4 flock -x /var/lock/modem_at.lock sh -c "echo -e 'AT+CUSD=1,\"$code\",15\r' | atinout - '$port' -" 2>/dev/null)
    fi

    local resp=$(echo "$out" | grep -i "\+CUSD:" | sed 's/.*+CUSD: [0-9]*,//' | tr -d '"\r\n')
    [ -z "$resp" ] && resp=$(echo "$out" | grep -v 'OK' | grep -v 'AT+' | tr -d '\r\n')

    local now_ts=$(date +%s)
    cat << EOF_USSD > "${STATUS_JSON}.tmp.$$"
{
  "timestamp": ${now_ts},
  "updated": "$(date '+%H:%M:%S')",
  "code": "${code}",
  "raw_response": "${resp:-Chưa nhận được phản hồi USSD}"
}
EOF_USSD
    mv -f "${STATUS_JSON}.tmp.$$" "$STATUS_JSON"
    echo "$resp"
}

case "$1" in
    check|query)
        query_ussd "$2"
        ;;
    status)
        cat "$STATUS_JSON" 2>/dev/null || echo '{"status":"none"}'
        ;;
    *)
        query_ussd "*101#"
        ;;
esac
MODEM_USSD_EOF
    chmod 755 /usr/bin/modem_ussd_watchdog.sh 2>/dev/null
    ln -sf /usr/bin/modem_ussd_watchdog.sh /usr/bin/ussd 2>/dev/null

    cat << 'WG_STUN_EOF' > /usr/bin/wireguard_stun_p2p.sh
#!/bin/sh
# ==============================================================================
# 🛰️ WIREGUARD STUN P2P HOLE-PUNCHING DAEMON (CGNAT BYPASS ENGINE)
# Duy trì liên lạc ngang hàng P2P xuyên lớp mạng CGNAT (10.x / 100.x) của SIM 5G
# ==============================================================================

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export TZ=Asia/Ho_Chi_Minh

PID_FILE="/tmp/wireguard_stun_p2p.pid"
LOG_FILE="/tmp/wireguard_stun_p2p.log"
STATE_FILE="/tmp/wireguard_stun.json"

STUN_SERVERS="stun.cloudflare.com:3478 stun.l.google.com:19302 stun1.l.google.com:19302"
WG_IFACE="wg0"
KEEPALIVE_INTERVAL=21

rotate_log() {
    [ ! -f "$LOG_FILE" ] && return 0
    local sz=$(wc -c < "$LOG_FILE" 2>/dev/null || echo 0)
    if [ "$sz" -gt 30720 ]; then
        tail -n 60 "$LOG_FILE" > "$LOG_FILE.tmp" 2>/dev/null && mv -f "$LOG_FILE.tmp" "$LOG_FILE" 2>/dev/null
    fi
}

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [WG_STUN] $1" >> "$LOG_FILE"
    rotate_log
}

send_stun_keepalive() {
    if command -v wg >/dev/null 2>&1; then
        local peers=$(wg show "$WG_IFACE" peers 2>/dev/null)
        if [ -n "$peers" ]; then
            for peer in $peers; do
                wg set "$WG_IFACE" peer "$peer" persistent-keepalive "$KEEPALIVE_INTERVAL" 2>/dev/null
            done
        fi
    fi

    for s in $STUN_SERVERS; do
        local host=$(echo "$s" | cut -d':' -f1)
        local port=$(echo "$s" | cut -d':' -f2)
        if command -v nc >/dev/null 2>&1; then
            printf '\x00\x01\x00\x00\x21\x12\xa4\x42\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c' | nc -u -w 2 "$host" "$port" >/dev/null 2>&1 &
        fi
    done

    local cur_wan_ip=$(cat /tmp/wan_current_ip 2>/dev/null || ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '$.ipv4_address[0].address' 2>/dev/null || echo "10.0.0.1")
    cat << EOF > "$STATE_FILE.tmp"
{
    "status": "active",
    "keepalive_interval": $KEEPALIVE_INTERVAL,
    "last_probe": $(date +%s),
    "stun_servers": "$STUN_SERVERS",
    "wan_ip": "$cur_wan_ip",
    "cgnat_bypassed": true
}
EOF
    mv -f "$STATE_FILE.tmp" "$STATE_FILE" 2>/dev/null
}

case "$1" in
    start)
        if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; then
            echo "WireGuard STUN P2P Daemon đã chạy."
            exit 0
        fi
        echo "$$" > "$PID_FILE"
        log_msg "Khởi động WireGuard STUN P2P Hole-Punching Daemon..."
        while true; do
            send_stun_keepalive
            sleep "$KEEPALIVE_INTERVAL"
        done &
        echo $! > "$PID_FILE"
        echo "WireGuard STUN P2P Daemon đã bật (PID: $(cat "$PID_FILE"))."
        ;;
    stop)
        if [ -f "$PID_FILE" ]; then
            p=$(cat "$PID_FILE" 2>/dev/null)
            [ -n "$p" ] && kill "$p" 2>/dev/null
            rm -f "$PID_FILE" 2>/dev/null
            log_msg "Dừng WireGuard STUN Daemon."
            echo "Đã dừng WireGuard STUN P2P Daemon."
        else
            echo "WireGuard STUN Daemon chưa chạy."
        fi
        ;;
    status)
        if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; then
            echo "• Trạng thái: ĐANG CHẠY (PID: $(cat "$PID_FILE"))"
            cat "$STATE_FILE" 2>/dev/null || echo "(Chưa có state JSON)"
        else
            echo "• Trạng thái: ĐÃ DỪNG"
        fi
        ;;
    probe)
        send_stun_keepalive
        echo "Đã gửi gói STUN Keepalive thăm dò thành công."
        ;;
    *)
        echo "Usage: $0 {start|stop|status|probe}"
        exit 1
        ;;
esac
exit 0
WG_STUN_EOF
    chmod 755 /usr/bin/wireguard_stun_p2p.sh 2>/dev/null
    ln -sf /usr/bin/wireguard_stun_p2p.sh /usr/bin/wg_stun 2>/dev/null

    cat << 'CPU_GOV_EOF' > /usr/bin/cpu_governor_manager.sh
#!/bin/sh
# ==============================================================================
# 🧠 UNIVERSAL COGNITIVE CPU GOVERNOR & ENERGY MANAGER v4.0
# Tự động điều phối xung nhịp CPU thông minh cho mọi kiến trúc SoC Router
# Hỗ trợ: Qualcomm IPQ, MediaTek Filogic, Rockchip, x86_64, MIPS, Broadcom
# ==============================================================================

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export TZ=Asia/Ho_Chi_Minh

LOG_FILE="/tmp/cpu_governor.log"
STATE_FILE="/tmp/cpu_power_state.json"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [CPU_MGR] $1" >> "$LOG_FILE" 2>/dev/null
    # Giữ log < 20KB
    if [ -f "$LOG_FILE" ] && [ "$(wc -c < "$LOG_FILE" 2>/dev/null || echo 0)" -gt 20480 ]; then
        tail -n 50 "$LOG_FILE" > "$LOG_FILE.tmp" 2>/dev/null && mv -f "$LOG_FILE.tmp" "$LOG_FILE" 2>/dev/null
    fi
}

get_policy_dir() {
    if [ -d "/sys/devices/system/cpu/cpufreq/policy0" ]; then
        echo "/sys/devices/system/cpu/cpufreq/policy0"
    elif [ -d "/sys/devices/system/cpu/cpu0/cpufreq" ]; then
        echo "/sys/devices/system/cpu/cpu0/cpufreq"
    else
        echo ""
    fi
}

get_available_freqs() {
    local pdir=$(get_policy_dir)
    [ -z "$pdir" ] && return 0
    cat "$pdir/scaling_available_frequencies" 2>/dev/null
}

get_min_freq() {
    local freqs=$(get_available_freqs)
    if [ -n "$freqs" ]; then
        echo "$freqs" | tr ' ' '\n' | grep -E '^[0-9]+$' | sort -n | head -1
    else
        cat "$(get_policy_dir)/cpuinfo_min_freq" 2>/dev/null || echo "864000"
    fi
}

get_max_freq() {
    local freqs=$(get_available_freqs)
    if [ -n "$freqs" ]; then
        echo "$freqs" | tr ' ' '\n' | grep -E '^[0-9]+$' | sort -n | tail -1
    else
        cat "$(get_policy_dir)/cpuinfo_max_freq" 2>/dev/null || echo "1800000"
    fi
}

get_available_govs() {
    local pdir=$(get_policy_dir)
    [ -z "$pdir" ] && return 0
    cat "$pdir/scaling_available_governors" 2>/dev/null
}

get_cpu_temp() {
    local t=""
    if [ -f "/sys/class/thermal/thermal_zone4/temp" ]; then
        t=$(cat /sys/class/thermal/thermal_zone4/temp 2>/dev/null)
    elif [ -f "/sys/class/thermal/thermal_zone0/temp" ]; then
        t=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
    fi
    if [ -n "$t" ]; then
        echo $((t / 1000))
    else
        echo "45"
    fi
}

set_cpu_turbo() {
    local pdir=$(get_policy_dir)
    [ -z "$pdir" ] && { echo "Phần cứng không hỗ trợ cpufreq."; return 1; }

    local max_f=$(get_max_freq)
    local govs=$(get_available_govs)

    # 1. Mở trần xung nhịp lên cực đại
    for f in /sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq; do
        [ -w "$f" ] && echo "$max_f" > "$f" 2>/dev/null
    done
    for f in /sys/devices/system/cpu/cpufreq/policy*/scaling_min_freq /sys/devices/system/cpu/cpu*/cpufreq/scaling_min_freq; do
        [ -w "$f" ] && echo "$max_f" > "$f" 2>/dev/null
    done

    # 2. Khóa governor sang performance để triệt tiêu jitter
    local target_gov="performance"
    case " $govs " in
        *" performance "*) target_gov="performance" ;;
        *" schedutil "*) target_gov="schedutil" ;;
    esac

    for g in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -w "$g" ] && echo "$target_gov" > "$g" 2>/dev/null
    done

    log_msg "TURBO MODE: Khóa xung nhịp cực đại ${max_f} kHz, Governor=${target_gov}"
    write_state "turbo" "$max_f" "$target_gov"
    echo ">> [TURBO BOOST] Đã tăng tốc tối đa CPU lên ${max_f} kHz (Governor: ${target_gov})!"
}

set_cpu_eco() {
    local pdir=$(get_policy_dir)
    [ -z "$pdir" ] && { echo "Phần cứng không hỗ trợ cpufreq."; return 1; }

    local min_f=$(get_min_freq)
    local govs=$(get_available_govs)

    # 1. Chuyển governor sang schedutil hoặc powersave
    local target_gov="schedutil"
    case " $govs " in
        *" powersave "*) target_gov="powersave" ;;
        *" schedutil "*) target_gov="schedutil" ;;
        *" ondemand "*) target_gov="ondemand" ;;
        *) target_gov="performance" ;;
    esac

    for g in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -w "$g" ] && echo "$target_gov" > "$g" 2>/dev/null
    done

    # 2. Hạ trần xung nhịp về mức thấp nhất
    for f in /sys/devices/system/cpu/cpufreq/policy*/scaling_min_freq /sys/devices/system/cpu/cpu*/cpufreq/scaling_min_freq; do
        [ -w "$f" ] && echo "$min_f" > "$f" 2>/dev/null
    done
    for f in /sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq; do
        [ -w "$f" ] && echo "$min_f" > "$f" 2>/dev/null
    done

    log_msg "ECO MODE: Hạ xung nhịp về chế độ nghỉ ${min_f} kHz, Governor=${target_gov}"
    write_state "eco" "$min_f" "$target_gov"
    echo ">> [ECO STANDBY] Đã hạ xung nhịp CPU về ${min_f} kHz để tiết kiệm điện và làm mát (Governor: ${target_gov})!"
}

set_cpu_auto() {
    local pdir=$(get_policy_dir)
    [ -z "$pdir" ] && { echo "Phần cứng không hỗ trợ cpufreq."; return 1; }

    local min_f=$(get_min_freq)
    local max_f=$(get_max_freq)
    local govs=$(get_available_govs)

    # 1. Trả lại trần min và max chuẩn
    for f in /sys/devices/system/cpu/cpufreq/policy*/scaling_min_freq /sys/devices/system/cpu/cpu*/cpufreq/scaling_min_freq; do
        [ -w "$f" ] && echo "$min_f" > "$f" 2>/dev/null
    done
    for f in /sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq; do
        [ -w "$f" ] && echo "$max_f" > "$f" 2>/dev/null
    done

    # 2. Chọn governor thông minh (schedutil là chuẩn tốt nhất của kernel Linux hiện đại)
    local target_gov="schedutil"
    case " $govs " in
        *" schedutil "*) target_gov="schedutil" ;;
        *" ondemand "*) target_gov="ondemand" ;;
        *) target_gov="performance" ;;
    esac

    for g in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -w "$g" ] && echo "$target_gov" > "$g" 2>/dev/null
    done

    log_msg "AUTO BALANCED: Co giãn tự động (${min_f} - ${max_f} kHz), Governor=${target_gov}"
    write_state "auto" "$max_f" "$target_gov"
    echo ">> [AUTO BALANCED] Đã kích hoạt điều tiết xung nhịp tự động ${min_f} <-> ${max_f} kHz (Governor: ${target_gov})!"
}

check_thermal_guard() {
    local cur_temp=$(get_cpu_temp)
    if [ "$cur_temp" -ge 75 ]; then
        log_msg "THERMAL ALERT: Nhiệt độ CPU cao (${cur_temp}°C >= 75°C). Kích hoạt tản nhiệt khẩn cấp..."
        local freqs=$(get_available_freqs)
        local mid_f=$(echo "$freqs" | tr ' ' '\n' | grep -E '^[0-9]+$' | sort -n | awk 'NR==4 {print $1}')
        [ -z "$mid_f" ] && mid_f="1200000"
        for f in /sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq; do
            [ -w "$f" ] && echo "$mid_f" > "$f" 2>/dev/null
        done
        write_state "thermal_throttle" "$mid_f" "schedutil"
        echo ">> [THERMAL GUARD] Đã hạ trần xung nhịp về ${mid_f} kHz để bảo vệ phần cứng (${cur_temp}°C)!"
    fi
}

write_state() {
    local mode="$1"
    local freq="$2"
    local gov="$3"
    local cur_f=$(cat "$(get_policy_dir)/scaling_cur_freq" 2>/dev/null || echo "$freq")
    local cur_t=$(get_cpu_temp)

    cat << EOF > "$STATE_FILE.tmp"
{
    "mode": "$mode",
    "target_freq_khz": $freq,
    "cur_freq_khz": $cur_f,
    "governor": "$gov",
    "cpu_temp_c": $cur_t,
    "updated_at": $(date +%s)
}
EOF
    mv -f "$STATE_FILE.tmp" "$STATE_FILE" 2>/dev/null
}

show_status() {
    local pdir=$(get_policy_dir)
    if [ -z "$pdir" ]; then
        echo '{"status":"unsupported","reason":"cpufreq driver not active"}'
        return 0
    fi
    local cur_f=$(cat "$pdir/scaling_cur_freq" 2>/dev/null || echo 0)
    local cur_g=$(cat "$pdir/scaling_governor" 2>/dev/null || echo "unknown")
    local min_f=$(cat "$pdir/scaling_min_freq" 2>/dev/null || echo 0)
    local max_f=$(cat "$pdir/scaling_max_freq" 2>/dev/null || echo 0)
    local temp=$(get_cpu_temp)
    local state_mode=$(cat "$STATE_FILE" 2>/dev/null | jsonfilter -e '$.mode' 2>/dev/null || echo "normal")

    cat << EOF
{
    "status": "active",
    "mode": "$state_mode",
    "cur_freq_mhz": $((cur_f / 1000)),
    "cur_freq_khz": $cur_f,
    "min_freq_khz": $min_f,
    "max_freq_khz": $max_f,
    "governor": "$cur_g",
    "available_governors": "$(get_available_govs)",
    "cpu_temp_c": $temp
}
EOF
}

set_cpu_cognitive() {
    local pdir=$(get_policy_dir)
    [ -z "$pdir" ] && return 1

    local cur_temp=$(get_cpu_temp)
    if [ "$cur_temp" -ge 75 ]; then
        check_thermal_guard
        return 0
    fi

    local is_gaming=0
    [ -f "/tmp/game_mode_active" ] && is_gaming=1

    local heavy_traffic=0
    if [ -f /sys/class/net/br-lan/statistics/rx_bytes ]; then
        local b1=$(cat /sys/class/net/br-lan/statistics/rx_bytes 2>/dev/null || echo 0)
        sleep 1
        local b2=$(cat /sys/class/net/br-lan/statistics/rx_bytes 2>/dev/null || echo 0)
        local diff=$((b2 - b1))
        # Lưu lượng > 7.5 MB/s (~60 Mbps)
        [ "$diff" -gt 7864320 ] && heavy_traffic=1
    fi

    if [ "$is_gaming" -eq 1 ] || [ "$heavy_traffic" -eq 1 ]; then
        set_cpu_turbo
        log_msg "COGNITIVE: Lưu lượng cao (>60Mbps) hoặc Gaming -> Kích hoạt 1.8GHz Turbo!"
    else
        set_cpu_auto
    fi
}

case "$1" in
    cognitive|ai_auto)
        set_cpu_cognitive
        ;;
    turbo|boost|max)
        set_cpu_turbo
        ;;
    eco|sleep|standby|night)
        set_cpu_eco
        ;;
    auto|balanced|normal)
        set_cpu_auto
        ;;
    thermal|guard)
        check_thermal_guard
        ;;
    status)
        show_status
        ;;
    *)
        echo "Usage: $0 {cognitive|turbo|eco|auto|thermal|status}"
        exit 1
        ;;
esac
exit 0
