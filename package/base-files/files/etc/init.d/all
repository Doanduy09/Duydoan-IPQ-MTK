    if n_sinr_num >= 30 and n_rsrp_num >= -85 then
        score = 100
    elseif n_sinr_num >= 25 and n_rsrp_num >= -90 then
        score = 95
    elseif n_sinr_num >= 20 and n_rsrp_num >= -95 then
        score = 88
    elseif n_sinr_num >= 15 and n_rsrp_num >= -100 then
        score = 80
    elseif n_sinr_num >= 10 then
        score = 70
    elseif n_sinr_num >= 5 then
        score = 60
    else
        score = 45
    end

