        }

        async function addPhoneNodeSubmit() {
            const name = document.getElementById('nasNewPhoneName').value.trim();
            const ip = document.getElementById('nasNewPhoneIp').value.trim();
            const port = document.getElementById('nasNewPhonePort').value.trim() || '8080';
            const folder = document.getElementById('nasNewPhoneFolder').value.trim() || 'DATA NASS';
            const user = document.getElementById('nasNewPhoneUser') ? document.getElementById('nasNewPhoneUser').value.trim() : '';
            const pass = document.getElementById('nasNewPhonePass') ? document.getElementById('nasNewPhonePass').value.trim() : '';

            if (!ip) {
                showToast('❌ Vui lòng nhập địa chỉ IP điện thoại!');
                return;
            }

            showToast('⏳ Đang kiểm tra kết nối WebDAV tới ' + ip + '...');

            try {
                const res = await fetch(`${API}?action=add_phone&name=${encodeURIComponent(name || 'Điện thoại mới')}&ip=${encodeURIComponent(ip)}&port=${encodeURIComponent(port)}&folder=${encodeURIComponent(folder)}&user=${encodeURIComponent(user)}&pass=${encodeURIComponent(pass)}`);
                const d = await res.json();
                showToast(d.message || (d.ok ? '✅ Đã thêm thiết bị vào cụm!' : '❌ Không thể thêm thiết bị!'));
                if (d.ok) {
                    document.getElementById('nasNewPhoneName').value = '';
                    document.getElementById('nasNewPhoneIp').value = '';
                    if (document.getElementById('nasNewPhonePass')) document.getElementById('nasNewPhonePass').value = '';
                    await loadNasClusterData();
                    loadFiles();
                }
            } catch (e) {
                showToast('❌ Lỗi kết nối máy chủ Router');
            }
        }

        async function testPhoneNode(ip, port) {
            showToast(`⏳ Đang kiểm tra phản hồi từ ${ip}:${port || '8080'}...`);
            try {
                const res = await fetch(`${API}?action=test_phone&ip=${encodeURIComponent(ip)}&port=${encodeURIComponent(port || '8080')}`);
                const d = await res.json();
                showToast(d.message || (d.online ? '🟢 Trực tuyến' : '🔴 Mất kết nối'));
            } catch (e) {
                showToast('❌ Lỗi kiểm tra kết nối');
            }
        }

        async function syncPhoneNode(id, name, ip) {
            showToast(`🔄 Đang kích hoạt đồng bộ tệp tin với [${name}]...`);
            try {
                const res = await fetch(`${API}?action=sync_phone&id=${encodeURIComponent(id || '')}&ip=${encodeURIComponent(ip || '')}&name=${encodeURIComponent(name || '')}`);
                const d = await res.json();
                showToast(d.message || (d.ok ? '✅ Đồng bộ hoàn tất' : '❌ Lỗi đồng bộ'));
                loadFiles();
            } catch (e) {
                showToast('❌ Lỗi gửi yêu cầu đồng bộ');
            }
        }

        async function deletePhoneNode(id) {
            if (!confirm(`Bạn có chắc chắn muốn xóa điện thoại này khỏi cụm NAS?`)) return;
            try {
                const res = await fetch(`${API}?action=del_phone&id=${encodeURIComponent(id)}`);
                const d = await res.json();
                showToast(d.message || '✅ Đã xóa điện thoại khỏi cụm!');
                await loadNasClusterData();
                loadFiles();
            } catch (e) {
                showToast('❌ Lỗi xóa thiết bị');
            }
        }

        async function addCloudAccountSubmit() {
            const service = document.getElementById('nasNewCloudService').value;
            const name = document.getElementById('nasNewCloudName').value.trim();
            const email = document.getElementById('nasNewCloudEmail').value.trim();
            const pass = document.getElementById('nasNewCloudPass') ? document.getElementById('nasNewCloudPass').value.trim() : '';
            const subfolder = document.getElementById('nasNewCloudFolder').value.trim();
            const syncMode = document.getElementById('nasNewCloudSyncMode') ? document.getElementById('nasNewCloudSyncMode').value : '2way';

            if (!email) {
                showToast('❌ Vui lòng nhập email tài khoản Cloud!');
                return;
            }

            showToast('⏳ Đang lưu và mã hóa tài khoản Cloud...');

            try {
                const res = await fetch(`${API}?action=add_cloud&service=${encodeURIComponent(service)}&name=${encodeURIComponent(name || 'Tài khoản Cloud')}&email=${encodeURIComponent(email)}&pass=${encodeURIComponent(pass)}&subfolder=${encodeURIComponent(subfolder)}&sync_mode=${encodeURIComponent(syncMode)}`);
                const d = await res.json();
                showToast(d.message || '✅ Đã thêm tài khoản Cloud!');
                if (d.ok) {
                    document.getElementById('nasNewCloudName').value = '';
                    document.getElementById('nasNewCloudEmail').value = '';
                    if (document.getElementById('nasNewCloudPass')) document.getElementById('nasNewCloudPass').value = '';
                    await loadNasClusterData();
                    loadFiles();
                }
            } catch (e) {
                showToast('❌ Lỗi thêm tài khoản Cloud');
            }
        }

        async function syncCloudAccount(id, name) {
            showToast(`🔄 Đang kích hoạt đồng bộ dữ liệu cho [${name}]...`);
            try {
                const res = await fetch(`${API}?action=sync_cloud&id=${encodeURIComponent(id)}`);
                const d = await res.json();
                showToast(d.message || '✅ Đồng bộ hoàn tất!');
                loadFiles();
            } catch (e) {
                showToast('❌ Lỗi đồng bộ tài khoản');
            }
        }

        async function syncGoogleDriveFrontend() {
            const btnTop = document.getElementById('btnTopSyncGDrive');
            const btnAct = document.getElementById('btnSyncGDriveAction');
            const btnModal = document.getElementById('btnModalSyncGDrive');
            const origTop = btnTop ? btnTop.innerHTML : '';
            const origAct = btnAct ? btnAct.innerHTML : '';
            const origModal = btnModal ? btnModal.innerHTML : '';

            if (btnTop) { btnTop.disabled = true; btnTop.innerHTML = '<span>⏳ Đang đồng bộ...</span>'; }
            if (btnAct) { btnAct.disabled = true; btnAct.innerHTML = '<span>⏳ Đang đồng bộ...</span>'; }
            if (btnModal) { btnModal.disabled = true; btnModal.innerHTML = '<span>⏳ Đang đồng bộ...</span>'; }

            showToast('☁️ Đang kích hoạt đồng bộ 2 chiều với Google Drive qua Rclone ARM64...');

            try {
                let id = '';
                if (currentNasData && currentNasData.clouds && currentNasData.clouds.length > 0) {
                    const g = currentNasData.clouds.find(c => c.service === 'gdrive' || (c.email && c.email.includes('gmail.com')));
                    if (g && g.id) id = g.id;
                    else id = currentNasData.clouds[0].id;
                }
                const res = await fetch(`${API}?action=sync_cloud&id=${encodeURIComponent(id || 'cloud_default')}`);
                const d = await res.json();
                showToast(d.message || '✅ Đang tiến hành đồng bộ hai chiều với Google Drive!');
                setTimeout(() => {
                    loadFiles();
                    loadStorageStats();
                    loadNasClusterData();
                }, 3000);
            } catch (e) {
                showToast('❌ Lỗi kết nối đồng bộ Google Drive: ' + e);
            } finally {
                setTimeout(() => {
                    if (btnTop) { btnTop.disabled = false; btnTop.innerHTML = origTop || '<span>☁️ Đồng Bộ Drive</span>'; }
                    if (btnAct) { btnAct.disabled = false; btnAct.innerHTML = origAct || '<span>☁️ Đồng Bộ Google Drive</span>'; }
                    if (btnModal) { btnModal.disabled = false; btnModal.innerHTML = origModal || '<span>🔄 Bấm Đồng Bộ Google Drive Ngay</span>'; }
                }, 2000);
            }
        }

        async function deleteCloudAccount(id) {
            if (!confirm(`Bạn có chắc muốn hủy liên kết tài khoản Cloud này?`)) return;
            try {
                const res = await fetch(`${API}?action=del_cloud&id=${encodeURIComponent(id)}`);
                const d = await res.json();
                showToast(d.message || '✅ Đã xóa tài khoản Cloud!');
                await loadNasClusterData();
                loadFiles();
            } catch (e) {
                showToast('❌ Lỗi xóa tài khoản');
            }
        }

        async function triggerPhoneAutoSetup(ip) {
            let targetIp = (ip && ip.trim()) ? ip.trim() : '';
            if (!targetIp && document.getElementById('nasNewPhoneIp')) {
                targetIp = document.getElementById('nasNewPhoneIp').value.trim();
            }
            if (!targetIp) {
                const rows = document.querySelectorAll('#nasPhoneTableBody tr');
                if (rows.length > 0) {
                    const firstTd = rows[0].querySelector('td:nth-child(2)');
                    if (firstTd) {
                        const m = firstTd.textContent.match(/([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)/);
                        if (m) targetIp = m[1];
                    }
                }
            }
            if (!targetIp) {
                showToast('⚠️ Vui lòng nhập IP điện thoại hoặc bấm nút [⚡ Setup 1-Click] ở dòng máy tương ứng!', 'warning');
                return;
            }
            showToast(`⚡ Đang kết nối ADB không dây tới ${targetIp}:5555...`);
            try {
                const res = await fetch(`${API}?action=auto_setup&ip=${encodeURIComponent(targetIp)}`);
                const d = await res.json();
                showToast(d.message || (d.ok ? '✅ Đã kích hoạt Phone NAS thành công!' : '⚠️ Kích hoạt thất bại!'), d.ok ? 'success' : 'error');
                await loadNasClusterData();
            } catch (e) {
                showToast('❌ Lỗi gửi lệnh kích hoạt Phone NAS');
            }
        }

        async function triggerBackupPhotos() {
            showToast('📸 Đang bắt đầu sao lưu ảnh DCIM sang ổ eMMC 128GB...', 'info');
            try {
                const res = await fetch(`${API}?action=backup_photos`);
                const d = await res.json();
                showToast(d.message || (d.ok ? '✅ Đã sao lưu ảnh thành công!' : '⚠️ Lỗi sao lưu!'), d.ok ? 'success' : 'error');
            } catch (e) {
                showToast('❌ Lỗi kết nối sao lưu ảnh');
            }
        }

        async function triggerPhoneDiskBench(ip) {
            let targetIp = (ip && ip.trim()) ? ip.trim() : '';
            if (!targetIp && document.getElementById('nasNewPhoneIp')) {
                targetIp = document.getElementById('nasNewPhoneIp').value.trim();
            }
            if (!targetIp) {
                const rows = document.querySelectorAll('#nasPhoneTableBody tr');
                if (rows.length > 0) {
                    const firstTd = rows[0].querySelector('td:nth-child(2)');
                    if (firstTd) {
                        const m = firstTd.textContent.match(/([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)/);
                        if (m) targetIp = m[1];
                    }
                }
            }
            if (!targetIp) {
                showToast('⚠️ Vui lòng nhập IP điện thoại hoặc bấm nút [💾 Đo Ổ Cứng] ở dòng máy tương ứng!', 'warning');
                return;
            }
            showToast(`⏳ Đang thẩm định tốc độ & độ bền chip nhớ tại ${targetIp}...`, 'info');
            try {
                const res = await fetch(`${API}?action=phone_disk_benchmark&ip=${encodeURIComponent(targetIp)}`);
                const d = await res.json();
                if (d.refreshing) {
                    showToast('⏳ Đang tiến hành benchmark I/O trên máy... Kết quả sẽ có sau ~5 giây', 'info');
                    setTimeout(() => triggerPhoneDiskBench(targetIp), 5000);
                    return;
                }
                if (d.status === 'success') {
                    const msg = `📊 KẾT QUẢ BENCHMARK PHONE NAS:\n\n` +
                                `📱 Thiết bị: ${d.brand} ${d.model} (${d.ip}) - Android ${d.android}\n` +
                                `💾 Chip nhớ: ${d.chip_mfg} ${d.chip_model} (${d.chip_type})\n` +
                                `⚡ Tốc độ Ghi: ${d.write_speed} (Sequential fsync)\n` +
                                `⚡ Tốc độ Đọc: ${d.read_speed} (Direct I/O)\n` +
                                `🛡️ Độ bền chip: ${d.health_pct} (${d.health_status})\n` +
                                `📦 Dung lượng: Trống ${d.storage_avail} / Tổng ${d.storage_total} (Đã dùng ${d.storage_used_pct})\n` +
                                `🔋 Pin: ${d.battery_level} (${d.battery_temp}) - ${d.charging_status}\n` +
                                `⏰ Thời gian đo: ${d.tested_at}`;
                    alert(msg);
                    showToast('✅ Đã hoàn tất thẩm định ổ cứng Phone NAS!', 'success');
                } else {
                    showToast(d.message || '⚠️ Không thể đo đạc ổ cứng trên điện thoại này!', 'error');
                }
            } catch (e) {
                showToast('❌ Lỗi kết nối khi đo ổ cứng Phone NAS', 'error');
            }
        }

