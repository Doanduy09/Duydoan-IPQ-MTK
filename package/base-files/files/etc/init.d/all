        os.execute(string.format("uci set camera.%s=camera && uci set camera.%s.ip='%s' && uci set camera.%s.name='%s' && uci set camera.%s.label='%s' && uci set camera.%s.username='%s' && uci set camera.%s.password='%s' && uci set camera.%s.path='%s' && uci set camera.%s.port='%s' && uci set camera.%s.duration='%s' && uci commit camera",
            cid, cid, chip, cid, cname:gsub("'", ""), cid, cname:gsub("'", ""), cid, (cuser or "admin"):gsub("'", ""), cid, (cpass or ""):gsub("'", ""), cid, (cpath or "stream0"):gsub("'", ""), cid, (#cport > 0 and cport or "554"), cid, dur
        ))
    end

    os.execute("/usr/bin/cctv_bot_daemon.sh restart >/dev/null 2>&1 &")
    os.execute("/usr/bin/cloud_cam_recorder_daemon.sh restart >/dev/null 2>&1 &")

    print(string.format('{"status":"success","id":%s,"name":%s,"message":"ÄÃ£ lÆ°u thÃ´ng tin %s thÃ nh cÃ´ng!"}',
        json_str(cid), json_str(cname), json_str(cname)
    ))
