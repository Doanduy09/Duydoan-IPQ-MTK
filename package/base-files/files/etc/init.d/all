        var lanIpDefaultLabel = E('span', { id: 'lan-default-hint-text', style: 'font-size: 12px; color: #000000; font-weight: 600;' }, 'Hiện tại: ' + curLanIP);

        var applyLanIpBtn = E('button', {
            class: 'btn cbi-button cbi-button-action',
            style: 'padding: 5px 12px; font-weight: 700; white-space: nowrap;',
            click: function() {
                var newIP = lanIpInput.value.trim();
                if (!newIP) return;
                if (!confirm('Bạn có chắc chắn muốn đổi IP LAN sang ' + newIP + ' không?\nRouter sẽ khởi động lại dịch vụ mạng!')) return;
                applyLanIpBtn.textContent = '⏳ Đang lưu...';
                callSetLanIP(newIP).then(function(r) {
                    if (r && r.success) {
                        lanIpDefaultLabel.textContent = 'Hiện tại: ' + newIP;
                        ui.addNotification(null, E('p', '🎉 ' + r.message), 'info');
                        setTimeout(function() {
                            window.location.href = window.location.protocol + '//' + newIP + window.location.pathname;
                        }, 5000);
                    } else {
                        ui.addNotification(null, E('p', '❌ ' + (r ? r.message : 'Lỗi đổi IP!')), 'error');
                        applyLanIpBtn.textContent = '🚀 Đổi IP LAN';
                    }
                });
            }
        }, '🚀 Đổi IP LAN');

        function showFirmwareConfirmModal(fileInfo) {
            var chkKeep = E('input', { type: 'checkbox', style: 'margin-right: 8px; cursor: pointer;' });
            var chkSkip = E('input', { type: 'checkbox', style: 'margin-right: 8px; cursor: pointer;' });
            var chkList = E('input', { type: 'checkbox', style: 'margin-right: 8px; cursor: pointer;' });
            var chkForce = E('input', { type: 'checkbox', style: 'margin-right: 8px; cursor: pointer;' });

            chkKeep.checked = false;
            chkSkip.checked = false;
            chkList.checked = false;
            chkForce.checked = (fileInfo.test_status !== 0);

            var errorWarningBox = null;
            if (fileInfo.test_status !== 0 || (fileInfo.test_out && fileInfo.test_out.indexOf('invalid sysupgrade file') !== -1)) {
                errorWarningBox = E('div', { style: 'margin-top: 10px; padding: 10px 14px; background: #ffffff; border: 1px solid #ef4444; border-radius: 6px; color: #000000; font-size: 12.5px; line-height: 1.4;' }, [
                    E('div', { style: 'font-weight: 800; margin-bottom: 4px;' }, '⚠️ Kiểm tra file ảnh phần mềm không thành công:'),
                    E('div', { style: 'white-space: pre-wrap; font-family: monospace; font-size: 11.5px; color: #000000;' }, fileInfo.test_out || 'Thiết bị không hỗ trợ định dạng ảnh này hoặc mã phần cứng không trùng khớp.')
                ]);
            }

