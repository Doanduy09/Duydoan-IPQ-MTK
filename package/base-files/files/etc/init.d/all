#!/bin/sh
# ==============================================================================
# MICRO ADSHIELD CYBER-SECURITY & DNS ENGINE (ZERO RAM / ZERO FLASH WEAR)
# Chặn quảng cáo, mã độc, cờ bạc lừa đảo, bảo vệ trẻ em và chống bypass DNS
# Kiến trúc: Dnsmasq Hash Table + Nftables Port 53 Redirection + DoH/DoT Blackhole
# ==============================================================================

HOSTS_DIR="/tmp/hosts"
BLOCK_FILE="${HOSTS_DIR}/adblock"
CONF_DIR="/tmp/dnsmasq.d"
CONF_FILE="${CONF_DIR}/adblock.conf"
STATUS_FILE="/etc/config/adshield_status"
FAMILY_FILE="/etc/config/adshield_family"
CUSTOM_FILE="/etc/config/adshield_custom.conf"
NFT_FILE="/tmp/adshield_nft.conf"
LOCK_FILE="/var/run/adshield.lock"

# 0. Singleton Lock Guard
exec 201>"$LOCK_FILE"
if [ "$1" = "update" ]; then
    if ! flock -n 201 2>/dev/null; then
        echo '{"success":false,"message":"Quá trình cập nhật Micro AdShield đang diễn ra, vui lòng chờ..."}'
        exit 0
    fi
fi

mkdir -p "$HOSTS_DIR" "$CONF_DIR" /etc/config 2>/dev/null
[ ! -f "$CUSTOM_FILE" ] && touch "$CUSTOM_FILE"

create_logchan_command() {
    cat << 'CMDLG' > /usr/bin/logchan
#!/bin/sh
LOGFILE="/tmp/log_chanquangcao"
case "$1" in
    clear|xoa|reset|clr) > "$LOGFILE" && echo "Đã xóa sạch nhật ký." ;;
    last|recent) tail -n 50 "$LOGFILE" 2>/dev/null ;;
    update|capnhat) /usr/bin/adshield update ;;
    status) /usr/bin/adshield status ;;
    *) echo "=== Xem lịch sử Log Chặn Quảng Cáo (Nhấn Ctrl+C để thoát) ==="; tail -f "$LOGFILE" 2>/dev/null ;;
esac
CMDLG
    chmod +x /usr/bin/logchan 2>/dev/null
    ln -sf /usr/bin/logchan /usr/bin/logadg 2>/dev/null
}

# Đảm bảo cấu hình hệ thống: nạp /tmp/dnsmasq.d, bật filter_aaaa, tối ưu cache-size 10000, all-servers và Cron 04:00 AM
ensure_dnsmasq_config() {
    create_logchan_command
    local changed=0
    if ! uci get dhcp.@dnsmasq[0].confdir 2>/dev/null | grep -q '/tmp/dnsmasq.d'; then
        uci add_list dhcp.@dnsmasq[0].confdir='/tmp/dnsmasq.d' 2>/dev/null
        changed=1
    fi
    if [ "$(uci get dhcp.@dnsmasq[0].filter_aaaa 2>/dev/null)" != "1" ]; then
        uci set dhcp.@dnsmasq[0].filter_aaaa='1' 2>/dev/null
        changed=1
    fi
    # Tối ưu hóa Dnsmasq Engine chuẩn chuyên gia: phản hồi tên miền siêu tốc < 1ms (Chuẩn 10.000 domain, tránh xung đột băm)
    local target_cache="10000"
    if [ "$(uci get dhcp.@dnsmasq[0].cachesize 2>/dev/null)" != "$target_cache" ]; then
        uci set dhcp.@dnsmasq[0].cachesize="$target_cache" 2>/dev/null
        changed=1
    fi
    if [ "$(uci get dhcp.@dnsmasq[0].allservers 2>/dev/null)" != "1" ]; then
        uci set dhcp.@dnsmasq[0].allservers='1' 2>/dev/null
        changed=1
    fi
    if [ "$(uci get dhcp.@dnsmasq[0].boguspriv 2>/dev/null)" != "1" ]; then
        uci set dhcp.@dnsmasq[0].boguspriv='1' 2>/dev/null
        changed=1
    fi
    if [ "$(uci get dhcp.@dnsmasq[0].domainneeded 2>/dev/null)" != "1" ]; then
        uci set dhcp.@dnsmasq[0].domainneeded='1' 2>/dev/null
        changed=1
    fi
    if [ "$(uci get dhcp.@dnsmasq[0].min_cache_ttl 2>/dev/null)" != "120" ]; then
        uci set dhcp.@dnsmasq[0].min_cache_ttl='120' 2>/dev/null
        changed=1
    fi
    if [ "$(uci get dhcp.@dnsmasq[0].dnsforwardmax 2>/dev/null)" != "512" ]; then
        uci set dhcp.@dnsmasq[0].dnsforwardmax='512' 2>/dev/null
        changed=1
    fi
    local router_ll=$(ip -6 addr show dev br-lan scope link 2>/dev/null | grep -o 'fe80::[0-9a-f:]*' | head -n 1)
    if [ -n "$router_ll" ]; then
        if ! uci get dhcp.lan.dns 2>/dev/null | grep -q "$router_ll"; then
            uci add_list dhcp.lan.dns="$router_ll" 2>/dev/null
            changed=1
        fi
    fi
    if [ "$changed" = "1" ]; then
        uci commit dhcp 2>/dev/null
        /etc/init.d/odhcpd restart >/dev/null 2>&1
    fi

    # Đảm bảo Cron Job tự động cập nhật lúc 04:00 AM mỗi sáng
    if ! crontab -l 2>/dev/null | grep -q '/usr/bin/adshield update'; then
        (crontab -l 2>/dev/null | grep -v 'adshield update'; echo "0 4 * * * /usr/bin/adshield update >/dev/null 2>&1") | crontab -
    fi
}

## 1. Kích hoạt Nftables Anti-Bypass Firewall (Chống thiết bị dùng DNS riêng 8.8.8.8 / 1.1.1.1, DoT 853 và giải phóng đường tải)
apply_firewall_rules() {
    remove_firewall_rules
    if command -v nft >/dev/null 2>&1; then
        cat << 'EOF_NFT' > "$NFT_FILE"
table inet adshield {
    chain dstnat {
        type nat hook prerouting priority -105; policy accept;
        iifname "br-lan" udp dport 53 redirect to :53
        iifname "br-lan" tcp dport 53 redirect to :53
    }
    chain forward {
        type filter hook forward priority -5; policy accept;
        iifname "br-lan" tcp dport 853 reject
        iifname "br-lan" udp dport 853 reject
        meta l4proto tcp iifname "br-lan" ip daddr 0.0.0.0 reject with tcp reset
        meta l4proto tcp iifname "br-lan" ip daddr 127.0.0.1 reject with tcp reset
        meta l4proto udp iifname "br-lan" ip daddr 0.0.0.0 reject with icmp port-unreachable
        meta l4proto udp iifname "br-lan" ip daddr 127.0.0.1 reject with icmp port-unreachable
    }
}
EOF_NFT
        nft -f "$NFT_FILE" 2>/dev/null
        rm -f /etc/nftables.d/adshield.nft "$NFT_FILE" 2>/dev/null
    elif command -v iptables >/dev/null 2>&1; then
        iptables -t nat -A PREROUTING -i br-lan -p udp --dport 53 -j REDIRECT --to-ports 53 2>/dev/null
        iptables -t nat -A PREROUTING -i br-lan -p tcp --dport 53 -j REDIRECT --to-ports 53 2>/dev/null
        iptables -I FORWARD -i br-lan -p tcp --dport 853 -j REJECT 2>/dev/null
        iptables -I FORWARD -i br-lan -p udp --dport 853 -j REJECT 2>/dev/null
        iptables -I FORWARD -i br-lan -d 0.0.0.0 -p tcp -j REJECT --reject-with tcp-reset 2>/dev/null
        iptables -I FORWARD -i br-lan -d 127.0.0.1 -p tcp -j REJECT --reject-with tcp-reset 2>/dev/null
        iptables -I FORWARD -i br-lan -d 0.0.0.0 -p udp -j REJECT --reject-with icmp-port-unreachable 2>/dev/null
        iptables -I FORWARD -i br-lan -d 127.0.0.1 -p udp -j REJECT --reject-with icmp-port-unreachable 2>/dev/null
    fi
}

remove_firewall_rules() {
    if command -v nft >/dev/null 2>&1; then
        nft delete table inet adshield 2>/dev/null
    fi
    if command -v iptables >/dev/null 2>&1; then
        iptables -t nat -D PREROUTING -i br-lan -p udp --dport 53 -j REDIRECT --to-ports 53 2>/dev/null
        iptables -t nat -D PREROUTING -i br-lan -p tcp --dport 53 -j REDIRECT --to-ports 53 2>/dev/null
        iptables -D FORWARD -i br-lan -p tcp --dport 853 -j REJECT 2>/dev/null
        iptables -D FORWARD -i br-lan -p udp --dport 853 -j REJECT 2>/dev/null
    fi
    rm -f /etc/nftables.d/adshield.nft "$NFT_FILE" 2>/dev/null
}

# 2. Sinh danh sách tên miền chặn vào RAM (/tmp/dnsmasq.d/adblock.conf & /tmp/hosts/adblock)
generate_blocklist() {
    local tmp_conf="/tmp/adshield_conf.tmp"
    local tmp_hosts="/tmp/adshield_hosts.tmp"
    local raw_domains="/tmp/adshield_raw.tmp"
    true > "$raw_domains"

    cat << 'EOF_RAW_DOMAINS' >> "$raw_domains"
# CANARY DOMAINS (TỰ ĐỘNG VÔ HIỆU HÓA DOH TRÊN FIREFOX VÀ APPLE PRIVATE RELAY)
use-application-dns.net
mask.icloud.com
mask-h2.icloud.com
mask-api.fe.apple-dns.net
mask-api.icloud.com
mask.apple-dns.net
apple-dns.net

# DOH BOOTSTRAP ENDPOINTS (ÉP APP VÀ TRÌNH DUYỆT FALLBACK VỀ DNSMASQ CỦA ROUTER)
cloudflare-dns.com
