            click: function() { refreshMeshDashboard(); }
        }, '🔄 Làm Tươi');

        function refreshMeshDashboard() {
            fetch('/cgi-bin/airdrop?action=mesh_status&t=' + Date.now())
                .then(function(r) { return r.json(); })
                .then(function(d) {
                    var roleBadge = (d.role === 'controller' || d.role === 'main') ?
                        '<span style="background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; padding: 3px 10px; border-radius: 6px; font-size: 12px; font-weight: 800;">👑 ROUTER CHÍNH (MASTER)</span>' :
                        '<span style="background: #ffedd5; color: #c2410c; border: 1px solid #fed7aa; padding: 3px 10px; border-radius: 6px; font-size: 12px; font-weight: 800;">📡 ROUTER PHỤ (SLAVE)</span>';

                    var activeBadge = d.mesh_active ?
                        '<span style="background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; padding: 3px 10px; border-radius: 6px; font-size: 12px; font-weight: 800;">🟢 Đang Bật Mesh</span>' :
                        '<span style="background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; padding: 3px 10px; border-radius: 6px; font-size: 12px; font-weight: 800;">⚪ Đã Tắt Mesh (Độc Lập)</span>';

                    var inetBadge = d.has_internet ?
                        '<span style="background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; padding: 3px 10px; border-radius: 6px; font-size: 12px; font-weight: 800;">🌐 Internet OK</span>' :
                        '<span style="background: #fee2e2; color: #b91c1c; border: 1px solid #fca5a5; padding: 3px 10px; border-radius: 6px; font-size: 12px; font-weight: 800;">❌ Mất Internet</span>';

