                        'Bạn có thể tùy chỉnh tên Wi-Fi và mật khẩu riêng cho Router phụ, hoặc để trống để giữ nguyên.'),
                    E('div', { id: 'modal-node-wifi-loading', style: 'text-align:center; padding: 10px;' }, '⏳ Đang đọc cấu hình từ Router phụ...'),
                    E('div', { id: 'modal-node-wifi-fields', style: 'display:none;' }, [
                        E('div', { style: 'margin-bottom: 10px;' }, [
                            E('label', { style: 'font-weight:700; font-size:12.5px; display:block; margin-bottom:4px;' }, '📡 Băng tần 5GHz Cao (Ch 149 - HE80):'),
                            E('div', { style: 'display:flex; gap:8px;' }, [
                                E('input', { type: 'text', id: 'edit-node-s0', placeholder: 'Tên Wi-Fi (VD: TPTLam)', style: 'flex:1; padding:6px 10px; border:1px solid #cbd5e1; border-radius:6px;' }),
