        var nasDomainBadge = E('span', {
            style: 'font-size: 11.5px; font-weight: 700; padding: 3px 10px; border-radius: 9999px; background: #ffffff; color: #000000; border: 1px solid #bae6fd; display: inline-flex; align-items: center; gap: 5px;'
