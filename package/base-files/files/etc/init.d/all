        function handleDropUpload(files) {
            if (!files || !files.length) return;
            Array.from(files).forEach(function(file) {
                var url = '/cgi-bin/custom_file_manager?action=upload&dir=' + encodeURIComponent(currentBrowseDir) + '&name=' + encodeURIComponent(file.name);
                fetch(url, { method: 'POST', body: file }).then(function() { loadDirectory(currentBrowseDir); });
            });
        }

