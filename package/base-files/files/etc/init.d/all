local function json_str(s)
    if not s then return '""' end
    s = tostring(s):gsub('\\', '\\\\'):gsub('"', '\\"'):gsub('\r', '\\r'):gsub('\n', '\\n')
    return '"' .. s .. '"'
end

if action == "gemini_status" then
    local cur_k = fs.readfile("/etc/config/gemini_api.key")
    if cur_k then cur_k = cur_k:gsub("%s+", "") end
    local is_conf = (cur_k and #cur_k >= 20)
    local masked = "ChÆ°a cÃ i Ä‘áº·t"
    if is_conf then
        local len = #cur_k
        if len >= 16 then
            masked = cur_k:sub(1, 8) .. "..." .. cur_k:sub(-5)
        else
            masked = "********"
        end
    end
    print("Content-Type: application/json\r\nCache-Control: no-cache\r\n\r")
    print(string.format('{"status":"success","configured":%s,"masked_key":%s,"key_file":"/etc/config/gemini_api.key","models":"Gemini 3.5 Flash-Lite & Gemini 3.7 / 3.8 Flash"}', is_conf and "true" or "false", json_str(masked)))
    return
end

if action == "gemini_set_key" then
    local new_k = (q.key or ""):gsub("%s+", "")
    print("Content-Type: application/json\r\nCache-Control: no-cache\r\n\r")
    if #new_k < 20 then
        print('{"status":"error","message":"API Key quÃ¡ ngáº¯n hoáº·c khÃ´ng há»£p lá»‡ (tá»‘i thiá»ƒu 20 kÃ½ tá»±)!"}')
        return
    end

    local f = io.open("/etc/config/gemini_api.key", "w")
    if not f then
        print('{"status":"error","message":"KhÃ´ng thá»ƒ ghi tá»‡p /etc/config/gemini_api.key!"}')
        return
    end
    f:write(new_k)
    f:close()
    os.execute("chmod 600 /etc/config/gemini_api.key; sync")

    local test_out = ""
    local p = io.popen(string.format("lua /usr/bin/gemini_engine.lua '%s' 'ping' 2>&1", new_k:gsub("'", "")))
    if p then
        test_out = p:read("*a") or ""
        p:close()
    end

    os.execute("killall telegram_bot_daemon.sh 2>/dev/null; /usr/bin/sysfixtine restart >/dev/null 2>&1 &")

    local is_err = test_out:find("^ERR:") or test_out:find("error") or test_out:find("Error")
    local len = #new_k
    local masked = new_k:sub(1, 8) .. "..." .. new_k:sub(-5)
    local msg = is_err and ("ÄÃ£ lÆ°u Key báº£o máº­t nhÆ°ng Google AI pháº£n há»“i: " .. test_out:sub(1, 100)) or "ÄÃ£ lÆ°u vÃ  kÃ­ch hoáº¡t Gemini API Key thÃ nh cÃ´ng (100% Sáºµn SÃ ng)!"

    print(string.format('{"status":"%s","message":%s,"masked_key":%s,"test_response":%s}',
        is_err and "warning" or "success",
        json_str(msg),
        json_str(masked),
        json_str(test_out:gsub("[\r\n]+", " "))))
    return
end

