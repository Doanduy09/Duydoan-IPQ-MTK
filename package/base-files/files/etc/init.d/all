        let activeRemoteIp = '';

        function openPhoneRemote(ip, name) {
            activeRemoteIp = ip;
            document.getElementById('remotePhoneTitle').innerText = `${name || 'Phone'} (${ip})`;
            document.getElementById('phoneRemoteStatusMsg').innerText = `Đang kết nối ADB không dây tới ${ip}:5555...`;
            const img = document.getElementById('phoneRemoteScreenImg');
            img.src = `${API}?action=phone_screen&ip=${encodeURIComponent(ip)}&t=${Date.now()}`;
            openModal('phoneRemoteModal');
        }

        function refreshPhoneScreen() {
            if (!activeRemoteIp) return;
            const img = document.getElementById('phoneRemoteScreenImg');
            img.src = `${API}?action=phone_screen&ip=${encodeURIComponent(activeRemoteIp)}&t=${Date.now()}`;
            document.getElementById('phoneRemoteStatusMsg').innerText = `Đã cập nhật màn hình lúc ${new Date().toLocaleTimeString()}`;
        }

        async function sendPhoneAction(cmd) {
            if (!activeRemoteIp) return;
            const st = document.getElementById('phoneRemoteStatusMsg');
            st.innerText = `Đang gửi lệnh [${cmd}]...`;
            try {
                const res = await fetch(`${API}?action=phone_action&ip=${encodeURIComponent(activeRemoteIp)}&cmd=${encodeURIComponent(cmd)}`);
                const d = await res.json();
                st.innerText = (d.success ? '✅ ' : '⚠️ ') + (d.message || 'Đã gửi lệnh');
                setTimeout(refreshPhoneScreen, 1200);
            } catch (e) {
                st.innerText = '❌ Lỗi gửi lệnh điều khiển';
            }
        }

        async function loadDiscoveredPhones() {
            const box = document.getElementById('discoveredPhonesContainer');
            if (!box) return;
            try {
                const res = await fetch(`${API}?action=get_discovered_phones`);
                const list = await res.json();
                if (Array.isArray(list) && list.length > 0) {
                    let html = '';
                    list.forEach(dev => {
                        html += `
                            <div style="display:flex; justify-content:space-between; align-items:center; background:rgba(245,158,11,0.15); border:1px solid rgba(245,158,11,0.4); border-radius:8px; padding:10px 14px; margin-bottom:8px;">
                                <div style="font-size:0.8rem; color:#fef08a;">
                                    🔔 <b>Phát hiện thiết bị Wi-Fi mới:</b> <b>${escapeHtml(dev.name || 'Android')}</b> (IP: <code>${escapeHtml(dev.ip)}</code> | MAC: <code>${escapeHtml(dev.mac)}</code>)
                                </div>
                                <button class="btn-cta" style="padding:4px 12px; font-size:0.75rem; background:linear-gradient(135deg, #f59e0b, #d97706);" onclick="adoptDiscoveredPhone('${escapeHtml(dev.mac)}', '${escapeHtml(dev.ip)}', '${escapeHtml(dev.name || 'Phone NAS')}')">
                                    ⚡ Thêm 1-Chạm Vào Cụm NAS
                                </button>
                            </div>
                        `;
                    });
                    box.innerHTML = html;
                    box.style.display = 'block';
                } else {
                    box.style.display = 'none';
                }
            } catch (e) {
                box.style.display = 'none';
            }
        }

        async function adoptDiscoveredPhone(mac, ip, name) {
            showToast(`⏳ Đang cấu hình và gán IP cố định cho ${name}...`, 'info');
            try {
                const res = await fetch(`${API}?action=adopt_phone&mac=${encodeURIComponent(mac)}&ip=${encodeURIComponent(ip)}&name=${encodeURIComponent(name)}`);
                const d = await res.json();
                showToast(d.message || '✅ Đã thêm thiết bị vào cụm NAS!', d.success ? 'success' : 'error');
                await loadNasClusterData();
            } catch (e) {
                showToast('❌ Lỗi thêm thiết bị');
            }
        }

        let gdriveAuthState = '';
        async function openGDriveWebAuthModal() {
            openModal('gdriveWebAuthModal');
            const notice = document.getElementById('gdriveAuthNotice');
            const stepBlock = document.getElementById('gdriveAuthStepBlock');
            notice.innerHTML = '⏳ Đang khởi tạo phiên ủy quyền Google OAuth 2.0 từ Router...';
            notice.style.background = 'rgba(2,132,199,0.15)';
            notice.style.color = '#fff';
            stepBlock.style.display = 'none';

            try {
                const res = await fetch(`${API}?action=start_gdrive_auth`);
                const d = await res.json();
                if (d.success && d.auth_url) {
                    gdriveAuthState = d.state || '';
                    notice.innerHTML = '✅ <b>Đã sẵn sàng!</b> Nhấn nút bên dưới để đăng nhập vào tài khoản Google và cấp quyền.';
                    notice.style.background = 'rgba(16,185,129,0.2)';
                    notice.style.color = '#4ade80';
                    const btn = document.getElementById('gdriveAuthLoginBtn');
                    btn.href = d.auth_url;
                    stepBlock.style.display = 'block';
                } else {
                    notice.innerHTML = '❌ <b>Lỗi:</b> ' + (d.message || 'Không thể tạo phiên xác thực.');
                    notice.style.background = 'rgba(239,68,68,0.2)';
                    notice.style.color = '#f87171';
                }
            } catch (e) {
                notice.innerHTML = '❌ <b>Lỗi mạng:</b> ' + e;
                notice.style.background = 'rgba(239,68,68,0.2)';
                notice.style.color = '#f87171';
            }
        }

        async function finishGDriveWebAuth() {
            const rawUrl = document.getElementById('gdriveAuthResponseUrl').value.trim();
            const email = document.getElementById('gdriveAuthEmail').value.trim() || 'user@gmail.com';
            if (!rawUrl) {
                showToast('⚠️ Vui lòng dán đường link hoặc mã Code nhận được từ Google!', 'warning');
                return;
            }
            const btn = document.getElementById('btnFinishGDriveAuth');
            btn.disabled = true;
            btn.innerText = '⏳ Đang lưu Token và kết nối...';
            try {
                const res = await fetch(`${API}?action=finish_gdrive_auth&code=${encodeURIComponent(rawUrl)}&email=${encodeURIComponent(email)}&state=${encodeURIComponent(gdriveAuthState)}`);
                const d = await res.json();
                btn.disabled = false;
                btn.innerText = '🚀 2. Hoàn Tất Kích Hoạt 1-Chạm';
                if (d.success) {
                    showToast(d.message || '🎉 Kích hoạt Google Drive thành công!', 'success');
                    closeModal('gdriveWebAuthModal');
                    await loadNasClusterData();
                    loadFiles();
                } else {
                    alert('❌ Lỗi: ' + (d.message || 'Không thể hoàn tất cấp quyền Google Drive'));
                }
            } catch (e) {
                btn.disabled = false;
                btn.innerText = '🚀 2. Hoàn Tất Kích Hoạt 1-Chạm';
                showToast('❌ Lỗi kết nối hoàn tất Google Drive: ' + e, 'error');
            }
        }

        // =====================================================================
        // LAPTOP SYNC HUB (AUTO & MANUAL ENGINE)
        // =====================================================================
        let laptopSelectedFiles = [];
        let autoSyncTimerId = null;
        let countdownTimerId = null;
        let nextSyncTimestamp = 0;

        function openLaptopSyncModal() {
            document.getElementById('laptopSyncModal').classList.add('open');
            initAutoSyncTimer();
        }

        function toggleSyncModeUI() {
            const isAuto = document.getElementById('modeAuto').checked;
            document.getElementById('autoIntervalGroup').style.display = isAuto ? 'block' : 'none';
            if (isAuto) {
                startAutoSyncSchedule();
                showToast('🔄 Đã bật chế độ Tự Động Đồng Bộ (Auto-Sync)!');
            } else {
                stopAutoSyncSchedule();
                showToast('⚡ Đã chuyển sang chế độ Đồng Bộ Thủ Công');
            }
        }

        function changeAutoSyncInterval(val) {
            startAutoSyncSchedule();
            showToast(`⏱️ Đã đặt chu kỳ tự động sync: ${val} phút`);
        }

        async function scanDirectoryEntries(dirHandle, pathPrefix) {
            for await (const entry of dirHandle.values()) {
                const rel = pathPrefix ? `${pathPrefix}/${entry.name}` : entry.name;
                if (entry.kind === 'file') {
                    const file = await entry.getFile();
                    file.customRelativePath = rel;
                    laptopSelectedFiles.push(file);
                } else if (entry.kind === 'directory') {
                    await scanDirectoryEntries(entry, rel);
                }
            }
        }

        async function pickLaptopDirectory() {
            if (window.showDirectoryPicker) {
                try {
                    const dirHandle = await window.showDirectoryPicker();
                    laptopSelectedFiles = [];
                    document.getElementById('laptopFolderNameDisplay').value = `📂 ${dirHandle.name} (Đang quét...)`;
                    appendSyncLog(`Đang quét thư mục [${dirHandle.name}] và tất cả thư mục con...`);

                    await scanDirectoryEntries(dirHandle, dirHandle.name);

                    appendSyncLog(`Đã quét xong: ${laptopSelectedFiles.length} tệp tin (giữ nguyên cấu trúc thư mục đầy đủ).`);
                    document.getElementById('laptopFolderNameDisplay').value = `📂 ${dirHandle.name} (${laptopSelectedFiles.length} tệp tin)`;
                    showToast(`📂 Đã nạp ${laptopSelectedFiles.length} tệp từ thư mục [${dirHandle.name}]!`);
                    return;
                } catch (err) {
                    if (err.name !== 'AbortError') console.error(err);
                }
            }
            // Fallback to hidden directory input
            document.getElementById('laptopDirInput').click();
        }

        function handleLaptopDirectoryPicked(files) {
            if (!files || files.length === 0) return;
            laptopSelectedFiles = Array.from(files);
            for (let i = 0; i < laptopSelectedFiles.length; i++) {
                laptopSelectedFiles[i].customRelativePath = laptopSelectedFiles[i].webkitRelativePath || laptopSelectedFiles[i].name;
            }
            const folderName = files[0].webkitRelativePath ? files[0].webkitRelativePath.split('/')[0] : 'Laptop Folder';
            document.getElementById('laptopFolderNameDisplay').value = `📂 ${folderName} (${laptopSelectedFiles.length} tệp tin)`;
            appendSyncLog(`Đã chọn thư mục: [${folderName}] với ${laptopSelectedFiles.length} tệp tin (cấu trúc thư mục đầy đủ).`);
            showToast(`📂 Đã nạp ${laptopSelectedFiles.length} tệp từ [${folderName}]!`);
        }

        async function startLaptopSyncNow() {
            if (!laptopSelectedFiles || laptopSelectedFiles.length === 0) {
                showToast('⚠️ Vui lòng bấm "Chọn Thư Mục" trên laptop trước khi đồng bộ!');
                await pickLaptopDirectory();
                if (!laptopSelectedFiles || laptopSelectedFiles.length === 0) return;
            }

            const targetFolder = document.getElementById('laptopTargetFolder').value || 'Laptop_Sync';
            const pBox = document.getElementById('laptopSyncProgressBox');
            const pFill = document.getElementById('laptopSyncFill');
            const pPercent = document.getElementById('laptopSyncPercent');
            const pCur = document.getElementById('laptopSyncCurrentFile');

            pBox.style.display = 'block';
            appendSyncLog(`Bắt đầu đồng bộ ${laptopSelectedFiles.length} tệp tin lên [${targetFolder}/]...`);

            let successCount = 0;
            const startTime = Date.now();

            for (let i = 0; i < laptopSelectedFiles.length; i++) {
                const file = laptopSelectedFiles[i];
                const pct = Math.round(((i + 1) / laptopSelectedFiles.length) * 100);
                const displayPath = file.customRelativePath || file.webkitRelativePath || file.name;
                pCur.innerText = `[${i+1}/${laptopSelectedFiles.length}] ${displayPath}`;
                pFill.style.width = `${pct}%`;
                pPercent.innerText = `${pct}%`;

                try {
                    await uploadFileToFolder(file, targetFolder);
                    successCount++;
                } catch (err) {
                    appendSyncLog(`❌ Lỗi tải: ${displayPath}`);
                }
            }

            const totalSec = Math.max(1, Math.round((Date.now() - startTime) / 1000));
            appendSyncLog(`✅ ĐÃ HOÀN TẤT ĐỒNG BỘ: ${successCount}/${laptopSelectedFiles.length} tệp tin trong ${totalSec}s.`);
            showToast(`✅ Đã đồng bộ thành công ${successCount} tệp lên Router NAS eMMC!`);

            setTimeout(() => {
                pBox.style.display = 'none';
                loadFiles();
                loadStorageStats();
            }, 2000);
        }

        function uploadFileToFolder(file, folder) {
            return new Promise((resolve, reject) => {
                const xhr = new XMLHttpRequest();
                const formData = new FormData();
                const relPath = file.customRelativePath || file.webkitRelativePath || file.name;
                formData.append('file', file, relPath);
                xhr.open('POST', `${API}?action=upload&folder=${encodeURIComponent(folder)}`);
                xhr.onload = () => resolve();
                xhr.onerror = () => reject();
                xhr.send(formData);
            });
        }

        function initAutoSyncTimer() {
            if (document.getElementById('modeAuto').checked) {
                startAutoSyncSchedule();
            }
        }

        function toggleAutoSyncSchedule() {
            if (autoSyncTimerId) {
                stopAutoSyncSchedule();
                showToast('⏹️ Đã dừng chế độ Tự Động Đồng Bộ');
                appendSyncLog('⏹️ Đã tạm dừng tự động đồng bộ.');
            } else {
                if (!laptopSelectedFiles || laptopSelectedFiles.length === 0) {
                    showToast('⚠️ Vui lòng chọn thư mục laptop cần đồng bộ trước!');
                    pickLaptopDirectory().then(() => {
                        if (laptopSelectedFiles && laptopSelectedFiles.length > 0) {
                            startAutoSyncSchedule();
                            startLaptopSyncNow();
                        }
                    });
                    return;
                }
                document.getElementById('modeAuto').checked = true;
                toggleSyncModeUI();
                startAutoSyncSchedule();
                startLaptopSyncNow();
            }
        }

        function startAutoSyncSchedule() {
            stopAutoSyncSchedule();
            const minutes = parseInt(document.getElementById('laptopSyncInterval').value || '5', 10);
            nextSyncTimestamp = Date.now() + (minutes * 60 * 1000);

            autoSyncTimerId = setInterval(() => {
                if (laptopSelectedFiles.length > 0) {
                    appendSyncLog('⏱️ [Tự động] Đang thực hiện chu kỳ đồng bộ tự động...');
                    startLaptopSyncNow();
                    nextSyncTimestamp = Date.now() + (minutes * 60 * 1000);
                }
            }, minutes * 60 * 1000);

            countdownTimerId = setInterval(updateCountdownDisplay, 1000);
            updateCountdownDisplay();
            updateAutoSyncUIState(true, minutes);
            appendSyncLog(`🔄 Đã kích hoạt Tự Động Đồng Bộ: Chu kỳ lặp lại mỗi ${minutes} phút.`);
        }

        function stopAutoSyncSchedule() {
            if (autoSyncTimerId) clearInterval(autoSyncTimerId);
            if (countdownTimerId) clearInterval(countdownTimerId);
            autoSyncTimerId = null;
            countdownTimerId = null;
            updateAutoSyncUIState(false);
            const countdownEl = document.getElementById('autoSyncCountdown');
            if (countdownEl) countdownEl.innerText = 'Trạng thái: Đã dừng';
        }

        function updateAutoSyncUIState(isActive, minutes = 5) {
            const btn = document.getElementById('btnToggleAutoSyncSchedule');
            const navBtnText = document.getElementById('navLaptopSyncBtnText');
            const navBtn = document.getElementById('btnNavLaptopSync');

            if (isActive) {
                if (btn) {
                    btn.innerHTML = '⏹️ DỪNG TỰ ĐỘNG ĐỒNG BỘ (ĐANG CHẠY)';
                    btn.style.background = 'linear-gradient(135deg, #ef4444 0%, #dc2626 100%)';
                    btn.style.boxShadow = '0 0 15px rgba(239, 68, 68, 0.4)';
                }
                if (navBtn) {
                    navBtn.style.background = 'linear-gradient(135deg, #059669 0%, #10b981 100%)';
                    navBtn.style.borderColor = '#34d399';
                }
            } else {
                if (btn) {
                    btn.innerHTML = '🔄 BẬT TỰ ĐỘNG ĐỒNG BỘ THEO GIỜ/PHÚT (AUTO-SYNC)';
                    btn.style.background = 'linear-gradient(135deg, #10b981 0%, #059669 100%)';
                    btn.style.boxShadow = 'none';
                }
                if (navBtn) {
                    navBtn.style.background = 'linear-gradient(135deg, #0284c7, #0369a1)';
                    navBtn.style.borderColor = '#38bdf8';
                }
                if (navBtnText) navBtnText.innerText = '💻 Đồng Bộ Laptop';
            }
        }

        function updateCountdownDisplay() {
            if (!autoSyncTimerId) return;
            const remaining = Math.max(0, Math.round((nextSyncTimestamp - Date.now()) / 1000));
            const m = Math.floor(remaining / 60);
            const s = remaining % 60;
            const str = `${m < 10 ? '0' : ''}${m}:${s < 10 ? '0' : ''}${s}`;
            const countdownEl = document.getElementById('autoSyncCountdown');
            if (countdownEl) countdownEl.innerText = `🟢 Đang tự động sync • Lần tới: ${str}`;
            const navBtnText = document.getElementById('navLaptopSyncBtnText');
            if (navBtnText) navBtnText.innerText = `🟢 Auto-Sync (${str})`;
        }

        function appendSyncLog(msg) {
            const logBox = document.getElementById('laptopSyncLog');
            if (!logBox) return;
            const timeStr = new Date().toLocaleTimeString('vi-VN');
            const row = document.createElement('div');
            row.textContent = `[${timeStr}] ${msg}`;
            logBox.appendChild(row);
            logBox.scrollTop = logBox.scrollHeight;
        }

        function downloadWindowsSyncBat() {
            window.location.href = `${API}?action=download_sync_bat`;
            showToast('⬇️ Đang tải file Athena_Laptop_Sync.bat về máy tính...');
        }

        function drawSimpleQrCode(canvasId, text) {
            const canvas = document.getElementById(canvasId);
            const ctx = canvas.getContext('2d');
            const size = canvas.width;
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, size, size);

            const grid = 21;
            const cellSize = Math.floor(size / grid);
            const offset = Math.floor((size - (grid * cellSize)) / 2);

            let hash = 0;
            for (let i = 0; i < text.length; i++) {
                hash = ((hash << 5) - hash) + text.charCodeAt(i);
                hash |= 0;
            }

            ctx.fillStyle = '#000000';
            function drawCorner(r, c) {
                ctx.fillRect(offset + c*cellSize, offset + r*cellSize, 7*cellSize, 7*cellSize);
                ctx.fillStyle = '#ffffff';
                ctx.fillRect(offset + (c+1)*cellSize, offset + (r+1)*cellSize, 5*cellSize, 5*cellSize);
                ctx.fillStyle = '#000000';
                ctx.fillRect(offset + (c+2)*cellSize, offset + (r+2)*cellSize, 3*cellSize, 3*cellSize);
            }
            drawCorner(0, 0);
            drawCorner(0, 14);
            drawCorner(14, 0);

            for (let r = 0; r < grid; r++) {
                for (let c = 0; c < grid; c++) {
                    if ((r < 8 && c < 8) || (r < 8 && c >= 13) || (r >= 13 && c < 8)) continue;
                    const val = Math.abs(Math.sin((r * grid + c) * hash + text.length) * 10000);
                    if (val % 2 > 1) {
                        ctx.fillRect(offset + c*cellSize, offset + r*cellSize, cellSize, cellSize);
                    }
                }
            }
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

