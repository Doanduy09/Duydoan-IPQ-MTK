                        /usr/bin/game_booster.sh off
                    else
                        /usr/bin/game_booster.sh status
                    fi
                else
                    printf '{"success":false,"message":"Script game_booster chua cai dat"}\n'
                fi
                ;;
            getRFSignal)
                rf_age=999
                if [ -f /tmp/rf_signal_stats.json ]; then
                    rf_age=$(( $(date +%s) - $(date -r /tmp/rf_signal_stats.json +%s 2>/dev/null || echo 0) ))
                fi
                if [ "$rf_age" -ge 3 ] && [ -x /usr/bin/rf_signal_fetcher.sh ]; then
                    /usr/bin/rf_signal_fetcher.sh >/dev/null 2>&1
                fi
                cat /tmp/rf_signal_stats.json 2>/dev/null || echo '{"status":"ok","score":100,"grade":"Hoàn Hảo","advice":"Sóng 5G hoạt động tốt."}'
                ;;
            healData)
                /usr/bin/sim_post_renew_heal.sh >/dev/null 2>&1 &
                printf '{"success":true,"message":"Đã kích hoạt tiến trình tự động kiểm tra và phục hồi Data!"}\n'
                ;;
            restartWWAN)
                /usr/bin/restart_wwan >/dev/null 2>&1 &
                printf '{"success":true,"message":"Đang khởi động lại card WWAN 5G..."}\n'
