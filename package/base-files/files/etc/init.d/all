-- ACTION: REALTIME HARDWARE STATS & NETWORK CHANNELS (UNIVERSAL MULTI-ARCHITECTURE)
if action == "sys_stats" then
    local ts_ip, funnel_base = get_network_endpoints()
    local lan_ip = os.getenv("SERVER_ADDR") or "192.168.1.1"

    -- 1. Try reading pre-aggregated fast telemetry from RAM tmpfs (0 subshells, ~0.1ms)
    local fast_stats_raw = fs.readfile("/tmp/sys_fast_stats.json")
    local cpu_str = "Universal Router SoC"
    local hw_name = "Linux Software Routing"
    local nss_active = false
    local wifi_desc = "Wi-Fi 6 AX HE160 (2402 Mbps)"
    local ram_total = 898
    local ram_used = 420
    local ram_free = 478
    local ram_pct = 46
    local emmc_total = "Flash"
    local emmc_used = "0 MB"
    local emmc_free = "0 MB"
    local emmc_pct = 1
    local storage_type = "á»” Cá»©ng Trong eMMC"
    local uptime_str = ""
    local flash_health_pct = 75
    local flash_wear_pct = 25
    local flash_health_status = "Ráº¥t Tá»‘t (75% - á»”n Ä‘á»‹nh)"
    local flash_eol = "BÃ¬nh thÆ°á»ng"

    if fast_stats_raw then
        local b_model = fast_stats_raw:match('"board_model":%s*"([^"]+)"') or ""
        local soc = fast_stats_raw:match('"soc_family":%s*"([^"]+)"') or ""
        local arch = fast_stats_raw:match('"cpu_arch":%s*"([^"]+)"') or "arm64"
        if soc ~= "" then
            cpu_str = string.format("%s (%s %s)", b_model ~= "" and b_model or "OpenWrt Router", soc, arch)
        elseif b_model ~= "" then
            cpu_str = b_model
        end
        hw_name = fast_stats_raw:match('"hw_accel_name":%s*"([^"]+)"') or hw_name
        local hw_t = fast_stats_raw:match('"hw_accel_type":%s*"([^"]+)"') or ""
        if hw_t:find("nss") or hw_t:find("wed") or hw_t:find("flow") or hw_t:find("sfe") or hw_t:find("ppe") or hw_t:find("mtk") or hw_t:find("filogic") then
            nss_active = true
        end
        ram_total = tonumber(fast_stats_raw:match('"ram_total_mb":%s*"?(%d+)"?')) or ram_total
        ram_used = tonumber(fast_stats_raw:match('"ram_used_mb":%s*"?(%d+)"?')) or ram_used
        ram_pct = tonumber(fast_stats_raw:match('"ram_pct":%s*"?(%d+)"?')) or ram_pct
        ram_free = (ram_total > ram_used) and (ram_total - ram_used) or ram_free
        uptime_str = fast_stats_raw:match('"uptime":%s*"([^"]+)"') or uptime_str
        storage_type = fast_stats_raw:match('"storage_type":%s*"([^"]+)"') or storage_type
        flash_health_pct = tonumber(fast_stats_raw:match('"flash_health_pct":%s*"?(%d+)"?')) or flash_health_pct
        flash_wear_pct = tonumber(fast_stats_raw:match('"flash_wear_pct":%s*"?(%d+)"?')) or flash_wear_pct
        flash_health_status = fast_stats_raw:match('"flash_health_status":%s*"([^"]+)"') or flash_health_status
        flash_eol = fast_stats_raw:match('"flash_eol":%s*"([^"]+)"') or flash_eol
    else
        -- Fallback: Pure direct /proc & /sys reads
        local mem_info = fs.readfile("/proc/meminfo")
        if mem_info then
            local mt = tonumber(mem_info:match("MemTotal:%s+(%d+)")) or 898000
            local mf = tonumber(mem_info:match("MemFree:%s+(%d+)")) or 300000
            local ma = tonumber(mem_info:match("MemAvailable:%s+(%d+)")) or mf
            ram_total = math.floor(mt / 1024)
            ram_free = math.floor(ma / 1024)
            ram_used = ram_total - ram_free
            ram_pct = math.floor((ram_used / ram_total) * 100)
        end
        local up_raw = fs.readfile("/proc/uptime")
        if up_raw then
            local sec = tonumber(up_raw:match("^(%d+)")) or 0
            local h = math.floor(sec / 3600)
            local m = math.floor((sec % 3600) / 60)
            uptime_str = string.format("%d giá» %d phÃºt", h, m)
        end
    end

    -- Flash & eMMC Life Time Direct Sysfs Check
    local life_raw = fs.readfile("/sys/block/mmcblk0/device/life_time") or fs.readfile("/sys/block/mmcblk1/device/life_time")
    if life_raw then
        local raw_hex = life_raw:match("(0x%x+)")
        if raw_hex == "0x01" then flash_wear_pct = 5; flash_health_pct = 95; flash_health_status = "Xuáº¥t Sáº¯c (95% - Chuáº©n 24/7)"
        elseif raw_hex == "0x02" then flash_wear_pct = 15; flash_health_pct = 85; flash_health_status = "Ráº¥t Tá»‘t (85%)"
        elseif raw_hex == "0x03" then flash_wear_pct = 25; flash_health_pct = 75; flash_health_status = "Tá»‘t (75% - á»”n Ä‘á»‹nh)"
        elseif raw_hex == "0x04" then flash_wear_pct = 35; flash_health_pct = 65; flash_health_status = "KhÃ¡ (65%)"
        elseif raw_hex == "0x05" then flash_wear_pct = 45; flash_health_pct = 55; flash_health_status = "Trung BÃ¬nh (55%)"
        elseif raw_hex == "0x06" or raw_hex == "0x07" then flash_wear_pct = 65; flash_health_pct = 35; flash_health_status = "Cáº§n Theo DÃµi (35%)"
        elseif raw_hex == "0x08" or raw_hex == "0x09" then flash_wear_pct = 80; flash_health_pct = 20; flash_health_status = "Cáº£nh BÃ¡o Hao MÃ²n (20%)"
        elseif raw_hex then flash_wear_pct = 95; flash_health_pct = 5; flash_health_status = "Kháº©n Cáº¥p: Sáº¯p Háº¿t Tuá»•i Thá» (5%)"
        end
        local pre_eol = fs.readfile("/sys/block/mmcblk0/device/pre_eol_info")
        if pre_eol and pre_eol:find("0x02") then flash_eol = "Cáº£nh bÃ¡o (Äáº¡t 80% EOL)" end
        if pre_eol and pre_eol:find("0x03") then flash_eol = "Nguy hiá»ƒm (Gáº§n háº¿t tuá»•i thá»)" end
        storage_type = "eMMC 5.1 Flash"
    elseif fs.stat("/sys/class/ubi/ubi0") then
        local bad_peb = tonumber(fs.readfile("/sys/class/ubi/ubi0/bad_peb_count")) or 0
        local max_ec = tonumber(fs.readfile("/sys/class/ubi/ubi0/max_ec")) or 0
        local wear_calc = math.min(100, math.floor(max_ec / 100))
        flash_wear_pct = wear_calc
        flash_health_pct = 100 - wear_calc
        if bad_peb == 0 then
            flash_health_status = string.format("Xuáº¥t Sáº¯c (100%% - %d chu ká»³, 0 Bad Block)", max_ec)
        else
            flash_health_status = string.format("Tá»‘t (%d%% - %d chu ká»³, %d Bad PEB)", flash_health_pct, max_ec, bad_peb)
        end
        storage_type = "Bá»™ Nhá»› Flash (UBI/NAND)"
    else
        flash_health_pct = 100
        flash_wear_pct = 0
        flash_health_status = "Xuáº¥t Sáº¯c (Flash NAND Chuáº©n)"
        storage_type = "Bá»™ Nhá»› Flash (UBI/NAND)"
    end

    local mounts = fs.readfile("/proc/mounts") or ""
    for m in mounts:gmatch("[^\r\n]+") do
        local dev, mnt = m:match("^(%S+)%s+(%S+)")
        if mnt == "/mnt/storage" then
            if dev and dev:find("mmcblk") then
                storage_type = "Bá»™ Nhá»› Trong eMMC 128GB"
            elseif dev and (dev:find("/dev/sd") or dev:find("/dev/nvme")) then
                storage_type = "á»” Cá»©ng Gáº¯n NgoÃ i (USB)"
            else
                storage_type = "Bá»™ Nhá»› Trong eMMC 128GB"
            end
            break
        end
    end

    -- Statvfs Storage without df subprocess
    local st = fs.statvfs("/mnt/storage") or fs.statvfs("/overlay")
    if st and st.blocks and st.blocks > 0 then
        local bsize = st.bsize or 4096
        local total_b = st.blocks * bsize
        local free_b = (st.bavail or 0) * bsize
        local used_b = (total_b > free_b) and (total_b - free_b) or 0
        emmc_total = format_bytes(total_b)
        emmc_used = format_bytes(used_b)
        emmc_free = format_bytes(free_b)
        emmc_pct = math.floor((used_b / total_b) * 100)
    end

    print("Content-Type: application/json\r\nCache-Control: no-cache\r\n\r")
    print(string.format('{"status":"OK","cpu":"%s","nss_active":%s,"hw_name":"%s","wifi_5g":"%s","ram_total":%d,"ram_used":%d,"ram_free":%d,"ram_pct":%d,"emmc_total":"%s","emmc_used":"%s","emmc_free":"%s","emmc_pct":%d,"storage_type":"%s","flash_health_pct":%d,"flash_wear_pct":%d,"flash_health_status":"%s","flash_eol":"%s","tailscale_ip":"%s","lan_ip":"%s","funnel_url":"%s","uptime":"%s"}',
        cpu_str:gsub('"', '\\"'),
        nss_active and "true" or "false",
        hw_name:gsub('"', '\\"'),
        wifi_desc:gsub('"', '\\"'),
        ram_total, ram_used, ram_free, ram_pct,
        emmc_total, emmc_used, emmc_free, emmc_pct,
        storage_type:gsub('"', '\\"'),
        flash_health_pct, flash_wear_pct,
        flash_health_status:gsub('"', '\\"'),
        flash_eol:gsub('"', '\\"'),
        ts_ip, lan_ip, funnel_base,
        (uptime_str or ""):gsub('"', '\\"'):gsub("[\r\n]+", "")
    ))
    return
end

-- ACTION: BENCHMARK & KIá»‚M TRA Sá»¨C KHá»ŽE á»” Cá»¨NG PHONE NAS (NON-BLOCKING FAST CACHE)
if action == "phone_disk_benchmark" then
    local target_ip = q.ip or ""
    local clean_ip = target_ip:gsub("[^0-9%.]", "")
    local cache_file = "/tmp/phone_storage_" .. clean_ip .. ".json"
    local f = io.open(cache_file, "r")
    if not f then
        local p = io.popen("ls -1t /tmp/phone_storage_*.json 2>/dev/null | head -1")
        if p then
            local fname = p:read("*l")
            p:close()
            if fname and fname ~= "" then f = io.open(fname, "r") end
        end
    end

    local do_refresh = (q.refresh == "1") or (not f)
    if do_refresh then
        if clean_ip ~= "" then
            os.execute("/usr/bin/nas_disk_benchmark.sh " .. clean_ip .. " --quiet </dev/null >/dev/null 2>&1 &")
        else
            os.execute("/usr/bin/nas_disk_benchmark.sh --quiet </dev/null >/dev/null 2>&1 &")
        end
    end

    print("Content-Type: application/json; charset=utf-8\r\n\r\n")
    if f then
        local content = f:read("*a")
        f:close()
        print(content)
    else
        print('{"status":"measuring","message":"Äang tiáº¿n hÃ nh Ä‘o lÆ°á»ng tá»‘c Ä‘á»™ á»• cá»©ng vÃ  tuá»•i thá» chip nhá»›, vui lÃ²ng chá» trong giÃ¢y lÃ¡t..."}')
    end
    return
end

-- ACTION: CHECK TAILSCALE / CLOUDFLARE FUNNEL STATUS
if action == "check_funnel" then
    local ts_ip, funnel_base = get_network_endpoints()
    local domain = funnel_base:gsub("^https?://", ""):gsub(":[0-9]+$", "")
    local is_active = (funnel_base:match("^https://") ~= nil) or (ts_ip ~= "127.0.0.1")

    local p_cd = io.popen("uci -q get nas_phone.settings.public_domain")
    local custom_domain = p_cd and p_cd:read("*l") or ""
    if p_cd then p_cd:close() end

    local p_tok = io.popen("uci -q get nas_phone.settings.cf_token")
    local cf_token = p_tok and p_tok:read("*l") or ""
    if p_tok then p_tok:close() end

    local p_em = io.popen("uci -q get nas_phone.settings.cf_email")
    local cf_email = p_em and p_em:read("*l") or ""
    if p_em then p_em:close() end

    local p_ak = io.popen("uci -q get nas_phone.settings.cf_api_key")
    local cf_key = p_ak and p_ak:read("*l") or ""
    if p_ak then p_ak:close() end

    local is_custom = (custom_domain and #custom_domain > 0)
    local is_cf = (funnel_base:find("trycloudflare.com") ~= nil) or (cf_token and #cf_token > 0)

    print("Content-Type: application/json\r\nCache-Control: no-cache\r\n\r")
    print(string.format('{"active":%s,"funnel_active":%s,"funnel_url":"%s","auth_url":"","tailscale_ip":"%s","domain":"%s","custom_domain":"%s","cf_token":"%s","cf_email":"%s","cf_key":"%s","is_custom":%s,"is_cf":%s}',
        is_active and "true" or "false", is_active and "true" or "false", funnel_base, ts_ip, domain,
        (custom_domain or ""):gsub('"', '\\"'), (cf_token or ""):gsub('"', '\\"'),
        (cf_email or ""):gsub('"', '\\"'), (cf_key or ""):gsub('"', '\\"'),
        is_custom and "true" or "false", is_cf and "true" or "false"))
    return
end

if action == "save_remote_domain" then
    local domain = q.domain or ""
    domain = domain:gsub("[;`$><|&!~'\"]", ""):gsub("^%s+", ""):gsub("%s+$", "")
    os.execute(string.format("uci set nas_phone.settings=settings && uci set nas_phone.settings.public_domain='%s'", domain:gsub("'", "")))

    local cf_email = q.email or ""
    cf_email = cf_email:gsub("[;`$><|&!~'\"]", ""):gsub("^%s+", ""):gsub("%s+$", "")
    if #cf_email > 0 then
        os.execute(string.format("uci set nas_phone.settings.cf_email='%s'", cf_email:gsub("'", "")))
    else
        local pe = io.popen("uci -q get nas_phone.settings.cf_email")
        cf_email = pe and pe:read("*l") or ""
        if pe then pe:close() end
    end

    local cf_key = q.key or ""
    cf_key = cf_key:gsub("[;`$><|&!~'\"]", ""):gsub("^%s+", ""):gsub("%s+$", "")
    if #cf_key > 0 then
        os.execute(string.format("uci set nas_phone.settings.cf_api_key='%s'", cf_key:gsub("'", "")))
    else
        local pk = io.popen("uci -q get nas_phone.settings.cf_api_key")
        cf_key = pk and pk:read("*l") or ""
        if pk then pk:close() end
    end

    -- If domain and API key exist, trigger 1-Click auto provisioning automatically!
    if #domain > 0 and #cf_key > 0 then
        os.execute("uci commit nas_phone")
        local cmd = string.format("/usr/bin/cf_tunnel_autoprovision.sh '%s' '%s' '%s' 2>&1",
            domain:gsub("'", ""), cf_key:gsub("'", ""), cf_email:gsub("'", ""))
        local p = io.popen(cmd)
        local out = p and p:read("*a") or ""
        if p then p:close() end
        local json_res = out:match("({.-})%s*$")
        if json_res then
            print("Content-Type: application/json\r\n\r\n" .. json_res)
            return
        end
    end
    
    if q.token ~= nil then
        local token = q.token:gsub("[;`$><|&!~'\"]", ""):gsub("^%s+", ""):gsub("%s+$", "")
        local ext_tok = token:match("(eyJh[%w%-_]+)")
        if ext_tok then token = ext_tok end
        os.execute(string.format("uci set nas_phone.settings.cf_token='%s'", token:gsub("'", "")))
        os.execute("uci commit nas_phone && /etc/init.d/nas_tunnel restart >/dev/null 2>&1 &")
    else
        if #domain == 0 then
            os.execute("uci set nas_phone.settings.cf_token=''")
            os.execute("uci commit nas_phone && /etc/init.d/nas_tunnel restart >/dev/null 2>&1 &")
        else
            os.execute("uci commit nas_phone")
        end
    end

    local ts_ip, funnel_base = get_network_endpoints()
    print("Content-Type: application/json\r\n\r\n" .. string.format('{"ok":true,"funnel_url":"%s","custom_domain":"%s","message":"âœ… ÄÃ£ lÆ°u cáº¥u hÃ¬nh tÃªn miá»n cÃ´ng khai: %s"}',
        funnel_base, domain:gsub('"', '\\"'), domain ~= "" and domain or funnel_base))
    return
end

