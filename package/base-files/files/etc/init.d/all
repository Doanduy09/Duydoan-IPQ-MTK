local lte_b = raw:match("LTE band:%s*([%w]+)") or "B3"
local lte_bw = raw:match("LTE bw:%s*([%d]+%s*MHz)") or "20 MHz"
local lte_rsrp = raw:match("PCC RxM RSRP:%s*([%-%d]+)") or "-77"
local lte_sinr = raw:match("SINR %(dB%):%s*([%-%d%.]+)") or "16.0"
local lte_rsrq = raw:match("RSRQ %(dB%):%s*([%-%d%.]+)") or "-9.0"
local cell_id = raw:match("Cell ID:%s*([%w]+)") or "--"
local tac = raw:match("TAC:%s*([%w]+)") or "--"
local temp = raw:match("Temperature:%s*([%d]+)") or "--"
local temp_str = (temp ~= "--") and (temp .. " °C") or "--"

local nr_b = raw:match("SCC1 NR5G band:%s*([%w]+)") or "n41"
local nr_bw = raw:match("SCC1 NR5G bw:%s*([%d]+%s*MHz)") or "100 MHz"
local nr_rsrp = raw:match("NR5G RSRP %(dBm%):%s*([%-%d]+)") or "-77"
local nr_rsrq = raw:match("NR5G RSRQ %(dB%):%s*([%-%d%.]+)") or "-11"
local nr_sinr = raw:match("NR5G SINR %(dB%):%s*([%-%d%.]+)") or "34.0"

