        var socialUsers = (gameData && gameData.social_users && Array.isArray(gameData.social_users)) ? gameData.social_users : [];

        function buildQosDeviceBadges(agList, suList, devOptsList) {
            var badges = [];
            if (agList && agList.length > 0) {
                for (var gi = 0; gi < agList.length; gi++) {
                    var gItem = agList[gi];
                    if (!gItem || gItem.ip === '192.168.1.1') continue;
                    var gName = gItem.name || gItem.ip || 'Thiết bị';
                    var gGame = gItem.game ? (' (' + gItem.game + ')') : '';
                    badges.push(E('span', {
                        style: 'display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 6px; font-weight: 800; font-size: 12px; background: #ffffff; color: #000000; border: 1px solid #fecaca; box-shadow: 0 1px 2px rgba(220,38,38,0.1); white-space: nowrap;'
                    }, '🔥 VIP Game: ' + gName + gGame));
                }
            }
            if (suList && suList.length > 0) {
                for (var si = 0; si < suList.length; si++) {
                    var sItem = suList[si];
                    if (!sItem || sItem.ip === '192.168.1.1') continue;
                    var sName = sItem.name || sItem.ip || 'Thiết bị';
                    var sApp = sItem.app ? (' (' + sItem.app + ')') : '';
                    badges.push(E('span', {
                        style: 'display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 6px; font-weight: 800; font-size: 12px; background: #ffffff; color: #000000; border: 1px solid #bfdbfe; white-space: nowrap;'
                    }, '🎬 Stream: ' + sName + sApp));
                }
            }

            if (devOptsList && devOptsList.length > 0) {
                for (var oi = 0; oi < devOptsList.length; oi++) {
                    var oItem = devOptsList[oi];
                    if (!oItem || !oItem.name || oItem.ip === '192.168.1.1') continue;
                    var alreadyActive = false;
                    for (var c = 0; c < agList.length; c++) {
                        if (agList[c].ip === oItem.ip || agList[c].mac === oItem.mac) { alreadyActive = true; break; }
                    }
                    if (alreadyActive) continue;
                    for (var d = 0; d < suList.length; d++) {
                        if (suList[d].ip === oItem.ip || suList[d].mac === oItem.mac) { alreadyActive = true; break; }
                    }
                    if (alreadyActive) continue;

                    badges.push(E('span', {
                        style: 'display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 6px; font-weight: 700; font-size: 11.5px; background: #ffffff; color: #000000; border: 1px solid ' + (oItem.border || '#e2e8f0') + '; white-space: nowrap;',
                        title: (oItem.badge || 'Tối ưu') + ' • ' + (oItem.detail || 'QoS BBR') + ' (' + (oItem.ip || '') + ')'
                    }, [
                        E('span', { style: 'font-weight: 800;' }, oItem.badge || '⚡'),
                        E('span', {}, oItem.name)
                    ]));
                }
            }

            if (badges.length === 0) {
                badges.push(E('span', {
                    id: 'no-gamer-badge',
                    style: 'padding: 2px 8px; border-radius: 6px; font-weight: 600; font-size: 12px; background: #ffffff; color: #000000; border: 1px solid #bbf7d0;'
                }, '🟢 Sẵn sàng kích hoạt tức thì khi vào trận & lướt app'));
            }
            return badges;
        }

        var gamerTags = buildQosDeviceBadges(activeGamers, socialUsers, deviceOpts);

        var gameQosWidget = E('div', { id: 'game-qos-widget-box', style: 'display: flex; flex-direction: column; gap: 6px; width: 100%;' }, [
