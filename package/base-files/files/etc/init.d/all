sync_data_to_flash() {
    for f in data_accumulated.dat custom_location.dat custom_at_port sms_custom_send_epoch custom_ttl.dat; do
        if [ -f "/tmp/$f" ]; then
            if ! cmp -s "/tmp/$f" "/etc/$f"; then
                cp -f "/tmp/$f" "/etc/$f" 2>/dev/null
            fi
        fi
    done
    [ -f "/tmp/wd_reboot_count" ] && ! cmp -s "/tmp/wd_reboot_count" "/etc/wd_reboot_count_flash" && cp -f "/tmp/wd_reboot_count" "/etc/wd_reboot_count_flash" 2>/dev/null
    [ -f "/tmp/wd_renew_date" ] && ! cmp -s "/tmp/wd_renew_date" "/etc/wd_renew_date_flash" && cp -f "/tmp/wd_renew_date" "/etc/wd_renew_date_flash" 2>/dev/null
    sync
}

safe_at_cleanup_core() {
    killall -CONT ModemManager modemmanager 2>/dev/null
    rm -f /tmp/sms_sending.lock 2>/dev/null
    rmdir "$LOCK_DIR" 2>/dev/null
}

PID_FILE="/tmp/combined_core.pid"
if [ -f "$PID_FILE" ]; then
    old_pid=$(cat "$PID_FILE" 2>/dev/null | tr -d ' \r\n')
    if [ -n "$old_pid" ] && [ -d "/proc/$old_pid" ] && [ "$old_pid" != "$$" ]; then
        if grep -q "combined_core" "/proc/$old_pid/cmdline" 2>/dev/null; then
            old_cmd=$(cat "/proc/$old_pid/cmdline" 2>/dev/null)
            case "$old_cmd" in
                *"/tmp/combined_core"*)
                    kill -9 "$old_pid" 2>/dev/null
                    sleep 0.3
                    ;;
                *)
                    exit 0
                    ;;
            esac
        else
            kill -9 "$old_pid" 2>/dev/null
        fi
    fi
fi
echo "$$" > "$PID_FILE"
trap '([ -x /usr/bin/weather_fetcher.sh ] && /usr/bin/weather_fetcher.sh || /tmp/weather_fetcher.sh) >/dev/null 2>&1; ([ -x /usr/bin/fast_stats_fetcher.sh ] && /usr/bin/fast_stats_fetcher.sh || /tmp/fast_stats_fetcher.sh) >/dev/null 2>&1; killall -USR1 jdc_led_sync.sh >/dev/null 2>&1' USR1

acquire_lock_safe() {
    local count=0
    while ! mkdir "$LOCK_DIR" 2>/dev/null; do
        usleep 100000
        count=$((count + 1))
        if [ "$count" -ge 40 ]; then
            rm -rf "$LOCK_DIR" 2>/dev/null
            mkdir "$LOCK_DIR" 2>/dev/null && break
        fi
    done
}

release_lock_safe() {
    rmdir "$LOCK_DIR" 2>/dev/null
}

check_log_size() {
    [ -f "/tmp/system_combined.log" ] && [ $(wc -c < "/tmp/system_combined.log" 2>/dev/null || echo 0) -ge 2097152 ] && true > "/tmp/system_combined.log"
    [ -f "/tmp/network_monitor.log" ] && [ $(wc -c < "/tmp/network_monitor.log" 2>/dev/null || echo 0) -ge 2097152 ] && true > "/tmp/network_monitor.log"
}

find_port() {
    if [ -f "/tmp/custom_at_port" ]; then
        local user_p=$(cat /tmp/custom_at_port 2>/dev/null | tr -d '\r\n[:space:]')
        if [ -n "$user_p" ] && [ -c "$user_p" ]; then
            echo "$user_p"
            return 0
        fi
    fi

    local saved_at_port=$(uci -q get network.wwan_config.port)
    if [ -n "$saved_at_port" ] && [ -c "$saved_at_port" ]; then
        echo "$saved_at_port"
        return 0
    fi

    local usb_list=$(lsusb 2>/dev/null)
    if echo "$usb_list" | grep -iqE "0e8d:7127|fm350"; then
        if [ -c "/dev/ttyUSB3" ]; then echo "/dev/ttyUSB3"; return 0; fi
    elif echo "$usb_list" | grep -iqE "sdxprairie|1e0e:9011|1e0e:9018|sim8200|sim8202|quectel"; then
        if [ -c "/dev/ttyUSB2" ]; then echo "/dev/ttyUSB2"; return 0; fi
    elif echo "$usb_list" | grep -iqE "sierra|em9190|em9191|em9291|em9293|em7565|1199:90d3"; then
        if [ -c "/dev/ttyUSB0" ]; then echo "/dev/ttyUSB0"; return 0; fi
    fi

    for port in /dev/ttyUSB2 /dev/ttyUSB3 /dev/ttyUSB0 /dev/ttyUSB1 /dev/ttyUSB*; do
        [ ! -c "$port" ] && continue
        timeout 2 sh -c "echo -e 'ATI\r' | atinout - $port -" > /tmp/ati_scan.tmp 2>/dev/null
        if grep -qi "OK" /tmp/ati_scan.tmp; then
            echo "$port"
            rm -f /tmp/ati_scan.tmp
            return 0
        fi
    done
    rm -f /tmp/ati_scan.tmp
    echo "/dev/ttyUSB2"
}

get_iccid_from_port() {
    local p="$1"
    local iccid_val=""

    if command -v mmcli >/dev/null 2>&1; then
        local sim_path=$(mmcli -m any 2>/dev/null | grep -i "SIM" | grep -oE '/org/freedesktop/ModemManager[0-9]*/SIM/[0-9]+' | head -n1)
        if [ -n "$sim_path" ]; then
            iccid_val=$(mmcli -i "$sim_path" 2>/dev/null | grep -i "iccid" | grep -oE '[0-9]{18,22}' | head -n1)
        fi
        [ -z "$iccid_val" ] && iccid_val=$(mmcli -m any 2>/dev/null | grep -i "sim identifier" | grep -oE '[0-9]{18,22}' | head -n1)
    fi

    if [ -z "$iccid_val" ] && [ -n "$p" ] && [ -c "$p" ]; then
        local resp=""
        if command -v modem_lock_run >/dev/null 2>&1; then
            resp=$(modem_lock_run sh -c "echo -e 'AT+ICCID\r' | atinout - $p -" 2>/dev/null)
            [ -z "$resp" ] && resp=$(modem_lock_run sh -c "echo -e 'AT!ICCID?\r' | atinout - $p -" 2>/dev/null)
            [ -z "$resp" ] && resp=$(modem_lock_run sh -c "echo -e 'AT+CCID\r' | atinout - $p -" 2>/dev/null)
            [ -z "$resp" ] && resp=$(modem_lock_run sh -c "echo -e 'AT+CRSM=176,12258,0,0,10\r' | atinout - $p -" 2>/dev/null)
        elif command -v atinout >/dev/null 2>&1; then
            resp=$(timeout 3 sh -c "echo -e 'AT+ICCID\r' | atinout - $p -" 2>/dev/null)
            [ -z "$resp" ] && resp=$(timeout 3 sh -c "echo -e 'AT!ICCID?\r' | atinout - $p -" 2>/dev/null)
            [ -z "$resp" ] && resp=$(timeout 3 sh -c "echo -e 'AT+CCID\r' | atinout - $p -" 2>/dev/null)
            [ -z "$resp" ] && resp=$(timeout 3 sh -c "echo -e 'AT+CRSM=176,12258,0,0,10\r' | atinout - $p -" 2>/dev/null)
        fi
        iccid_val=$(echo "$resp" | grep -oE '[0-9]{18,22}' | head -n1)
    fi

    echo "$iccid_val"
}

detect_carrier_from_port() {
    local p="$1"
    local carrier_name="Viettel"
    local imsi_val=""

    # Self-healing: nếu port không phản hồi thì scan lại toàn bộ /dev/ttyUSB*
    if [ -n "$p" ] && [ -c "$p" ]; then
        local ping_test=""
        if command -v atinout >/dev/null 2>&1; then
            ping_test=$(timeout 2 sh -c "echo -e 'AT\r' | atinout - $p -" 2>/dev/null | grep -c "OK")
        fi
        if [ "${ping_test:-0}" -eq 0 ]; then
            for scan_port in /dev/ttyUSB* /dev/ttyACM*; do
                [ -c "$scan_port" ] || continue
                local test_ok=$(timeout 1 sh -c "echo -e 'AT\r' | atinout - $scan_port -" 2>/dev/null | grep -c "OK")
                if [ "${test_ok:-0}" -gt 0 ]; then
                    p="$scan_port"
                    echo "$p" >/tmp/master_sms_port
                    echo "$p" >/tmp/custom_at_port
                    break
                fi
            done
        fi
    fi

    if [ -n "$p" ] && [ -c "$p" ]; then
        if command -v atinout >/dev/null 2>&1; then
            imsi_val=$(timeout 2 sh -c "echo -e 'AT+CIMI\r' | atinout - $p -" 2>/dev/null | grep -oE '[0-9]{15}' | head -1)
        else
            imsi_val=$(timeout 2 sh -c "exec 3<>$p; echo -e 'AT+CIMI\r' >&3; sleep 0.3; cat <&3" 2>/dev/null | grep -oE '[0-9]{15}' | head -1)
        fi
    fi

    if [ -n "$imsi_val" ]; then
        local plmn=$(echo "$imsi_val" | cut -c1-5)
        case "$plmn" in
            45201|45204|45209) carrier_name="Viettel" ;;
            45202|45214)       carrier_name="VinaPhone" ;;
            45205|45207)       carrier_name="MobiFone" ;;
            45203|45211)       carrier_name="Vietnamobile" ;;
            45206|45208|45218) carrier_name="Wintel" ;;
            *)                 carrier_name="Viettel" ;;
        esac
    fi
    echo "$carrier_name"
}

# Trả về APN phù hợp theo nhà mạng
get_apn_for_carrier() {
    local carrier="$1"
    case "$carrier" in
        VinaPhone)    echo "m3-world" ;;
        MobiFone)     echo "m-internet" ;;
        Vietnamobile) echo "internet" ;;
        Wintel)       echo "internet.reddi.com.vn" ;;
        Viettel|*)    echo "v-internet" ;;
    esac
}

# Trả về lệnh USSD kiểm tra data theo nhà mạng
get_ussd_for_carrier() {
    local carrier="$1"
    case "$carrier" in
        VinaPhone)    echo "*888#" ;;
        MobiFone)     echo "*101#" ;;
        Vietnamobile) echo "*102#" ;;
        Wintel)       echo "*103#" ;;
        Viettel|*)    echo "*098#" ;;
    esac
}

# Trả về số SMS và nội dung để hỏi dung lượng data
get_sms_check_for_carrier() {
    local carrier="$1"
    case "$carrier" in
        VinaPhone)    echo "888|KT" ;;
        MobiFone)     echo "999|KT" ;;
        Vietnamobile) echo "1414|KT" ;;
        Wintel)       echo "1800599930|TT" ;;
        Viettel|*)    echo "9220|DL" ;;
    esac
}


schedule_next() {
    export TZ=ICT-7
    local custom_epoch=$(cat /etc/sms_custom_send_epoch /tmp/sms_custom_send_epoch 2>/dev/null | grep -oE '^[0-9]+' | head -1)
    local now_epoch=$(date +%s)
    if [ -n "$custom_epoch" ] && [ "$custom_epoch" -gt "$now_epoch" ]; then
        send_epoch="$custom_epoch"
        wake_epoch=$(( send_epoch - 120 ))
        echo "$wake_epoch" > "$WAKE"
        echo "$send_epoch" > "$NEXT_SEND"
        return 0
    fi
    local tomorrow_base=$(date -d "tomorrow 00:20" +%s 2>/dev/null || date -d "+1 day 00:20" +%s)
    local rand_sec=$(hexdump -n 2 -e '/2 "%u"' /dev/urandom 2>/dev/null || echo 1200)
    local offset=$(( rand_sec % 18600 ))
    send_epoch=$(( tomorrow_base + offset ))
    wake_epoch=$(( send_epoch - 120 ))
    echo "$wake_epoch" > "$WAKE"
    echo "$send_epoch" > "$NEXT_SEND"
}

detect_network_hardware() {
    for i in wwan0_4 usb0_4 wwan0 usb0 eth1 wan $(ubus list 2>/dev/null | grep '^network.interface.' | sed 's/network.interface.//'); do
        case "$i" in
            lan|loopback|wan6|br-lan|tailscale*|wg*|tun*|tap*) continue ;;
        esac

        local status_json=$(ubus call network.interface.$i status 2>/dev/null)
        [ -z "$status_json" ] && continue

        local up=$(echo "$status_json" | jsonfilter -e '@.up' 2>/dev/null)
        [ "$up" = "true" ] || continue

        local dev_name=$(echo "$status_json" | jsonfilter -e '@.l3_device' 2>/dev/null)
        [ -z "$dev_name" ] && dev_name=$(echo "$status_json" | jsonfilter -e '@.device' 2>/dev/null)
        
        case "$dev_name" in
            tailscale*|tun*|tap*) continue ;;
        esac

        local wanip=$(echo "$status_json" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
        if [ -z "$wanip" ]; then
            wanip=$(ubus call network.interface.${i}_4 status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
        fi
        if [ -z "$wanip" ] && [ -n "$dev_name" ]; then
            wanip=$(ip -4 addr show dev "$dev_name" 2>/dev/null | grep -oE 'inet [0-9.]+' | awk '{print $2}' | head -n 1)
        fi

        if [ -n "$dev_name" ] && [ -n "$wanip" ] && [ "$wanip" != "0.0.0.0" ]; then
            local clean_iface=$(echo "$i" | sed 's/_4$//')
            local proto=$(uci -q get network.${clean_iface}.proto)
            [ -z "$proto" ] && proto=$(echo "$status_json" | jsonfilter -e '@.proto' 2>/dev/null)

            local gateway=$(echo "$status_json" | jsonfilter -e '@["route"][0].nexthop' 2>/dev/null)
            [ -z "$gateway" ] && gateway=$(ip route show dev "$dev_name" 2>/dev/null | awk '/default/ {print $3}' | head -n 1)

            IFACE="$clean_iface"
            DEV="$dev_name"

            echo "$IFACE" > /tmp/wd_interface
            echo "${proto:-mbim}" > /tmp/wd_proto
            echo "$DEV" > /tmp/wd_device
            echo "$wanip" > /tmp/wd_wanip
            echo "${gateway:-0.0.0.0}" > /tmp/wd_gateway
            return 0
        fi
    done
    return 1
}

get_next_url() {
    set -- $URL_LIST
    n=$#
    CURRENT_URL=$(eval echo \$$URL_IDX)
    URL_IDX=$((URL_IDX + 1))
    [ "$URL_IDX" -gt "$n" ] && URL_IDX=1
}

check_internet() {
    if [ -z "$DEV" ] || [ ! -d "/sys/class/net/$DEV" ]; then
        detect_network_hardware || return 1
    fi

    # 1. KIEM TRA TRANG THAI CARRIER INTERFACE GOC
    if [ -f "/sys/class/net/$DEV/carrier" ]; then
        local c_state=$(cat "/sys/class/net/$DEV/carrier" 2>/dev/null)
        if [ "$c_state" = "0" ]; then
            return 1
        fi
    fi

    # 2. PING RANG BUOC TRUC TIEP QUA INTERFACE GOC (-I "$DEV")
    local test_ip
    case $(( $(date +%s) % 4 )) in
        0) test_ip="1.1.1.1" ;;
        1) test_ip="8.8.8.8" ;;
        2) test_ip="1.0.0.1" ;;
        3) test_ip="8.8.4.4" ;;
    esac

    if ping -I "$DEV" -c 2 -W 3 "$test_ip" >/dev/null 2>&1; then
        return 0
    fi

    local backup_ip="8.8.8.8"
    [ "$test_ip" = "8.8.8.8" ] && backup_ip="1.1.1.1"
    if ping -I "$DEV" -c 2 -W 3 "$backup_ip" >/dev/null 2>&1; then
        return 0
    fi

    # 3. HTTP 204 RANG BUOC QUA INTERFACE GOC
    if curl -s --interface "$DEV" -m 5 "http://connectivitycheck.gstatic.com/generate_204" >/dev/null 2>&1; then
        return 0
    fi

    if curl -s --interface "$DEV" -m 5 "http://cp.cloudflare.com/generate_204" >/dev/null 2>&1; then
        return 0
    fi

    # 4. TRAFFIC GUARD: KIEM TRA LUU LUONG DATA TRUC TIEP TREN INTERFACE GOC
    local rx1=$(cat "/sys/class/net/$DEV/statistics/rx_packets" 2>/dev/null || echo 0)
    sleep 2
    local rx2=$(cat "/sys/class/net/$DEV/statistics/rx_packets" 2>/dev/null || echo 0)
    if [ "$rx2" -gt "$rx1" ]; then
        return 0
    fi

    return 1
}
check_real_http_status() {
    if [ -z "$DEV" ] || [ ! -d "/sys/class/net/$DEV" ]; then
        detect_network_hardware || return 1
    fi

    local CHECK_TARGET="http://connectivitycheck.gstatic.com/generate_204"
    local RESP_HEADER="/tmp/.http_check_headers.$$"
    local RESP_BODY="/tmp/.http_check_body.$$"
    rm -f "$RESP_HEADER" "$RESP_BODY" 2>/dev/null

    local http_code=$(curl -s --interface "$DEV" -m 6 -w "%{http_code}" -o "$RESP_BODY" -D "$RESP_HEADER" "$CHECK_TARGET" 2>/dev/null)
    
    if [ "$http_code" = "204" ]; then
        rm -f "$RESP_HEADER" "$RESP_BODY" 2>/dev/null
        return 0
    fi

    if [ "$http_code" = "301" ] || [ "$http_code" = "302" ] || [ "$http_code" = "307" ] || [ "$http_code" = "200" ]; then
        if grep -iqE "viettel|canhbao|hetdl|naptien|vas|pack|warning|portal" "$RESP_HEADER" "$RESP_BODY" 2>/dev/null; then
            rm -f "$RESP_HEADER" "$RESP_BODY" 2>/dev/null
            return 2
        fi
    fi

    local check_fb=$(curl -s --interface "$DEV" -m 5 -w "%{http_code}" -o /dev/null "http://cp.cloudflare.com/generate_204" 2>/dev/null)
    if [ "$check_fb" = "204" ]; then
        rm -f "$RESP_HEADER" "$RESP_BODY" 2>/dev/null
        return 0
    fi

    rm -f "$RESP_HEADER" "$RESP_BODY" 2>/dev/null
    return 1
}

reset_wwan_card_hard() {
    local up_sec=$(awk '{print int($1)}' /proc/uptime 2>/dev/null || echo 999)
    if [ "$up_sec" -lt 240 ]; then
        echo "[Watchdog] Router vừa boot (${up_sec}s < 240s) - Bỏ qua Reset Card WWAN để modem quét sóng." > /tmp/master_watchdog_live
        return 0
    fi
    if [ -f /tmp/quectel_dialing ]; then
        echo "[Watchdog] Modem đang quay số, tạm hoãn reset card..." > /tmp/master_watchdog_live
        return 0
    fi

    echo "[Watchdog] ⚠️ Phát hiện nghẽn cảnh báo hết Data! Đang gửi lệnh Reset Card WWAN..." > /tmp/master_watchdog_live
    echo "⚡ RESET CARD WWAN..." > /tmp/wd_net_status

    local port=$(cat /tmp/master_sms_port 2>/dev/null)
    [ -z "$port" ] || [ ! -c "$port" ] && port=$(cat /tmp/custom_at_port 2>/dev/null)
    [ -z "$port" ] || [ ! -c "$port" ] && port=$(find_port)

    touch /tmp/sms_sending.lock
    acquire_lock_safe
    trap 'safe_at_cleanup_core' EXIT INT TERM

    local cur_inf=$(cat /tmp/wd_interface 2>/dev/null || echo "wwan0")
    ifdown "$cur_inf" >/dev/null 2>&1
    sleep 2

    if [ -n "$port" ] && [ -c "$port" ]; then
        local m_type_chk=$(cat /tmp/master_m_type 2>/dev/null)
        if echo "$m_type_chk" | grep -iq "quectel"; then
            if command -v modem_lock_run >/dev/null 2>&1; then
                modem_lock_run sh -c "echo -e 'AT+CFUN=1,1\r' | atinout - '$port' -" >/dev/null 2>&1
            else
                echo -e "AT+CFUN=1,1\r" | atinout - "$port" - >/dev/null 2>&1
            fi
        elif echo "$m_type_chk" | grep -iq "sierra"; then
            if command -v modem_lock_run >/dev/null 2>&1; then
                modem_lock_run sh -c "echo -e 'AT!RESET\r' | atinout - '$port' -" >/dev/null 2>&1
            else
                echo -e "AT!RESET\r" | atinout - "$port" - >/dev/null 2>&1
            fi
        elif echo "$m_type_chk" | grep -iq "fibocom\|fm350"; then
            if command -v modem_lock_run >/dev/null 2>&1; then
                modem_lock_run sh -c "echo -e 'AT+CFUN=15\r' | atinout - '$port' -" >/dev/null 2>&1
                sleep 1
                modem_lock_run sh -c "echo -e 'AT+CFUN=1,1\r' | atinout - '$port' -" >/dev/null 2>&1
            else
                echo -e "AT+CFUN=15\r" | atinout - "$port" - >/dev/null 2>&1
                sleep 1
                echo -e "AT+CFUN=1,1\r" | atinout - "$port" - >/dev/null 2>&1
            fi
        else
            if command -v modem_lock_run >/dev/null 2>&1; then
                modem_lock_run sh -c "echo -e 'AT+CFUN=1,1\r' | atinout - '$port' -" >/dev/null 2>&1
            else
                echo -e "AT+CFUN=1,1\r" | atinout - "$port" - >/dev/null 2>&1
            fi
        fi
    fi

    rm -f /tmp/sms_sending.lock
    release_lock_safe
    trap - EXIT INT TERM

    echo "[Watchdog] Đang chờ Card WWAN tái khởi động..." > /tmp/master_watchdog_live
    sleep 20
    ifup "$cur_inf" >/dev/null 2>&1
    sleep 5
}

verify_and_rescue_after_sms() {
    local sim_status_chk=$(cat /tmp/master_sim_status 2>/dev/null || echo "")
    if [ "$sim_status_chk" != "VALID" ]; then
        return 0
    fi

    echo "[Watchdog] Đã gia hạn SMS. Bắt đầu 180s kiểm tra HTTP chống chặn Data..." > /tmp/master_watchdog_live
    echo "⏳ CHECK DATA HẬU SMS (180s)..." > /tmp/wd_net_status

    local pass_check=0

    # Vòng 1: 180s (18 lần x 10s)
    for step in $(seq 1 18); do
        sleep 10
        detect_network_hardware
        check_real_http_status
        local http_code_ret=$?

        if [ $http_code_ret -eq 0 ]; then
            echo "[Watchdog] ✔️ Mạng HTTP thật thông suốt sau gia hạn SMS!" > /tmp/master_watchdog_live
            echo "✔️ MẠNG ỔN ĐỊNH" > /tmp/wd_net_status
            pass_check=1
            break
        elif [ $http_code_ret -eq 2 ]; then
            echo "[Watchdog] ⚠️ Bị giam tại cổng cảnh báo hết Data (${step}/18)..." > /tmp/master_watchdog_live
            echo "⚠️ CẢNH BÁO HẾT DATA (${step}/18)" > /tmp/wd_net_status
        else
            echo "[Watchdog] ⏳ Chờ mạng phục hồi sau gia hạn SMS (${step}/18)..." > /tmp/master_watchdog_live
            echo "⏳ CHỜ MẠNG THẬT (${step}/18)" > /tmp/wd_net_status
        fi
    done

    if [ $pass_check -eq 1 ]; then
        return 0
    fi

    echo "[Watchdog] Sau 180s vẫn chưa có data thật. Tiến hành Reset Card WWAN 1 lần!" > /tmp/master_watchdog_live
    reset_wwan_card_hard

    # Vòng 2: 180s (18 lần x 10s) sau khi Reset Card
    echo "[Watchdog] Đang thẩm định 180s sau Reset Card..." > /tmp/master_watchdog_live
    local post_reset_pass=0

    for step2 in $(seq 1 18); do
        sleep 10
        detect_network_hardware
        check_real_http_status
        local code_post=$?

        if [ $code_post -eq 0 ]; then
            echo "[Watchdog] ✔️ Card WWAN đã nhận Data thật thành công sau Reset!" > /tmp/master_watchdog_live
            echo "✔️ MẠNG ỔN ĐỊNH" > /tmp/wd_net_status
            post_reset_pass=1
            break
        else
            echo "[Watchdog] ⏳ Đợi mạng hậu Reset Card WWAN (${step2}/18)..." > /tmp/master_watchdog_live
            echo "⏳ CHỜ MẠNG POST-RESET (${step2}/18)" > /tmp/wd_net_status
        fi
    done

    if [ $post_reset_pass -eq 1 ]; then
        return 0
    fi

    echo "[Watchdog] ⚠️ Reset Card hoàn tất, tiếp tục duy trì mạng." > /tmp/master_watchdog_live
}

wait_for_internet_ready() {
    local fail_count=0
    local startup_sec=0
    while true; do
        check_log_size
        if ! detect_network_hardware; then
            echo "⏳ BẮT BUỘC ĐỜI CẤP THÔNG SỐ L3..." > /tmp/wd_net_status
            echo "[Watchdog] Đang chờ Interface & L3 Device (${startup_sec}s)..." > /tmp/master_watchdog_live
            fail_count=0
            sleep 2
            startup_sec=$((startup_sec + 2))
            if [ "$startup_sec" -eq 30 ] || [ "$startup_sec" -eq 60 ]; then
                echo "[Watchdog] Đang kích hoạt kết nối WWAN..." > /tmp/master_watchdog_live
                ubus call network.interface.wwan0 up 2>/dev/null || ifup wwan0 2>/dev/null
            elif [ "$startup_sec" -eq 90 ]; then
                echo "[Watchdog] Cứu hộ phần cứng modem sau 90s..." > /tmp/master_watchdog_live
                for at_p in /dev/ttyUSB0 /dev/ttyUSB2 /dev/ttyUSB1; do
                    [ -c "$at_p" ] && echo -e "AT!RESET\r" | atinout - "$at_p" - 2>/dev/null && break
                done
                command -v usbreset >/dev/null 2>&1 && usbreset 1199:90d3 >/dev/null 2>&1
            elif [ "$startup_sec" -ge 120 ]; then
                echo "[Watchdog] Chuyển tiếp quyền điều khiển cho Smart Modem Watchdog..." > /tmp/master_watchdog_live
                return 1
            fi
        else
            if check_internet; then
                echo "✔️ MẠNG ỔN ĐỊNH" > /tmp/wd_net_status
                echo "[Watchdog] Đã kết nối Internet L3 thành công!" > /tmp/master_watchdog_live
                rm -f /etc/wd_offline_start_ts /etc/wd_2day_reboot_done /tmp/wd_offline_start_ts 2>/dev/null
                echo "0" > /tmp/wd_reboot_count
                echo "0" > /etc/wd_reboot_count_flash
                sync
                return 0
            fi
            fail_count=$((fail_count + 1))
            echo "⏳ CHỜ L3 INTERNET ($fail_count/12)..." > /tmp/wd_net_status
            echo "[Watchdog] Kiểm tra Internet L3 thất bại ($fail_count/12)..." > /tmp/master_watchdog_live
            sleep 2
            startup_sec=$((startup_sec + 2))
        fi

        if [ "$fail_count" -ge 12 ]; then
            if [ -f /tmp/modem_healing.lock ] || pgrep -f "smart_modem_watchdog" >/dev/null 2>&1; then
                echo "[Watchdog] Smart Modem Watchdog đang quản lý tự chữa lành, bỏ qua network restart..." > /tmp/master_watchdog_live
                fail_count=0
                sleep 5
            else
                read -r netrestart_count < /tmp/wd_netrestart_count 2>/dev/null || netrestart_count=0
                if [ "$netrestart_count" -lt 1 ]; then
                    echo "❌ RESTART NETWORK" > /tmp/wd_net_status
                    echo "[Watchdog] Restart network..." > /tmp/master_watchdog_live
                    netrestart_count=$((netrestart_count + 1))
                    echo "$netrestart_count" > /tmp/wd_netrestart_count
                    /etc/init.d/network restart
                    sleep 8
                    fail_count=0
                    IFACE=""
                    DEV=""
                fi
            fi
        fi

        if [ "$startup_sec" -ge 180 ]; then
            echo "[Watchdog] ⚠️ Mất mạng > 180s tại khởi động, tự động phục hồi kết nối modem..." > /tmp/master_watchdog_live
            echo "🔄 PHỤC HỒI MODEM..." > /tmp/wd_net_status
            mmcli -m 0 -e 2>/dev/null
            [ -n "$IFACE" ] && ifup "$IFACE" 2>/dev/null
            startup_sec=0
            fail_count=0
            sleep 5
        fi
    done
}

post_renew_internet_check() {
    echo "[Watchdog] Đang đợi 15s hậu Renew..." > /tmp/master_watchdog_live
    echo "⏳ ĐỜI 15S HẬU RENEW..." > /tmp/wd_net_status
    sleep 15

    detect_network_hardware
    if check_internet; then
        echo "✔️ MẠNG ỔN ĐỊNH" > /tmp/wd_net_status
        return 0
    fi

    local attempt=1
    while [ $attempt -le 10 ]; do
        echo "⏳ CHỜ MẠNG HẬU RENEW ($attempt/10)..." > /tmp/wd_net_status
        sleep 4
        detect_network_hardware
        if check_internet; then
            echo "✔️ MẠNG ỔN ĐỊNH" > /tmp/wd_net_status
            return 0
        fi
        attempt=$((attempt + 1))
    done

    echo "❌ 10 LẦN CHECK HẬU RENEW THẤT BẠI!" > /tmp/wd_net_status
    read -r netrestart_count < /tmp/wd_netrestart_count 2>/dev/null || netrestart_count=0
    
    if [ "$netrestart_count" -lt 1 ]; then
        netrestart_count=$((netrestart_count + 1))
        echo "$netrestart_count" > /tmp/wd_netrestart_count
        /etc/init.d/network restart
        wait_for_internet_ready
        return 0
    else
        return 1
    fi
}

execute_sms_sending_logic() {
    # ==============================================================================
    # QUY TẮC BẢO VỆ TUYỆT ĐỐI CỦA ANH DUY:
    # 1. Toàn bộ lịch gửi SMS ngầm BẮT BUỘC phải ủy quyền cho /usr/bin/daily_vip_renew.sh
    # 2. Tuyệt đối KHÔNG được gửi SMS trực tiếp từ watchdog hay combined_core
    # 3. daily_vip_renew.sh kiểm soát 100%:
    #    - Đúng SIM VIP mặc định theo ICCID (89840480009484443869)
    #    - Khung giờ vàng duy nhất: 00h20 đến 05h30 sáng
    #    - Khởi động lại 100.000 lần cũng TUYỆT ĐỐI không gửi ngầm
    #    - Mỗi ngày tối đa gửi 1 lần duy nhất
    # ==============================================================================
    if [ -x /usr/bin/daily_vip_renew.sh ]; then
        /usr/bin/daily_vip_renew.sh >/dev/null 2>&1
    fi
}

