#!/bin/sh /etc/rc.common
# ==============================================================================
# 🚀 PROCD SERVICE: UNIVERSAL PCIE 5G/LTE MULTI-CARD DIALER WATCHDOG
# Tự động phát hiện và quay số mọi dòng card WWAN PCIe (Qualcomm, Quectel,
# Sierra, Fibocom, Telit, SIMCom, MediaTek, Intel) ngay khi boot.
# ==============================================================================

START=90
STOP=15
USE_PROCD=1
PROG="/usr/bin/modem_autodial.sh"

has_wwan_hardware() {
    # 1. Kiểm tra bus PCIe
    for dev in /sys/bus/pci/devices/*; do
        [ ! -d "$dev" ] && continue
        vendor=$(cat "$dev/vendor" 2>/dev/null | tr '[:upper:]' '[:lower:]')
        case "$vendor" in
            0x17cb|0x2c7c|0x1199|0x2cb7|0x1bc7|0x1eac|0x14c0|0x105b|0x2949|0x0e8d|0x8086)
                return 0
                ;;
        esac
    done

    # 2. Kiểm tra driver PCIe modem đã nạp
    [ -d "/sys/bus/pci/drivers/pcie_mhi" ] && return 0
    [ -d "/sys/bus/pci/drivers/mhi_q" ] && return 0
    [ -d "/sys/bus/pci/drivers/mhi_pci_generic" ] && return 0
    [ -d "/sys/bus/pci/drivers/mtk_t7xx" ] && return 0
    [ -d "/sys/bus/pci/drivers/iosm" ] && return 0

    # 3. Kiểm tra thiết bị mạng & cổng điều khiển
    [ -d "/sys/class/net/rmnet_mhi0" ] && return 0
    [ -d "/sys/class/net/mhi_net0" ] && return 0
    [ -c "/dev/mhi_DUN" ] && return 0
    [ -c "/dev/wwan0mbim0" ] && return 0
    [ -c "/dev/wwan0qmi0" ] && return 0
    [ -c "/dev/wwan0at0" ] && return 0
    [ -c "/dev/cdc-wdm0" ] && return 0

    return 1
}

start_service() {
    if has_wwan_hardware; then
        if [ -x "$PROG" ]; then
            procd_open_instance "pcie_5g_dialer"
            procd_set_param command "$PROG" "--daemon"
            procd_set_param respawn 3600 5 0
            procd_set_param stdout 1
            procd_set_param stderr 1
            procd_close_instance
        fi
    fi
}
